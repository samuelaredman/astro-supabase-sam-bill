---
export const prerender = false;
import { getSupabase, createSupabaseServerClientFromContext } from '../../utils/database';
import { IMAGE_EMOTES, IMAGE_EMOTE_MAP } from '../../utils/reactions';
import Layout from '../../components/Layout.astro';
import CommentThread from '../../components/CommentThread.astro';
import { igdbImage, scoreClass, getVoteCounts } from '../../utils/format';
import type { CommentData } from '../../utils/comments';
import ReportModal from '../../components/ReportModal.astro';
import EditModal from '../../components/EditModal.astro';
import ShareButton from '../../components/ShareButton.astro';
import { setPageCacheHeaders } from '../../utils/cache';
import { getPageUser } from '../../utils/pageAuth';
import { youTubeEmbedUrl, youTubeWatchUrl } from '../../utils/youtube';
import { attachReviewVideos } from '../../utils/reviewVideos';
import ProfileBadge from '../../components/ProfileBadge.astro';
import { readBadgeSlugs } from '../../utils/badges';

const supabase = getSupabase();
const serverClient = createSupabaseServerClientFromContext(Astro);
const user = await getPageUser(Astro, serverClient);
const isLoggedIn = !!user;

// Cache the anonymous render at the CDN edge to cut function invocations under
// crawl load; logged-in (personalized) responses are never shared-cached.
setPageCacheHeaders(Astro.response.headers, isLoggedIn);

const { id } = Astro.params;

const { data: review, error } = await (supabase as any)
  .from('reviews')
  .select(`
    id, score, title, body, play_time_hours,
    contains_spoilers, status, published_at, created_at,
    played_on:platform_played_on ( id, name, slug ),
    games ( id, title, slug, cover_img_url ),
    profiles ( id, username, avatar_url, search_indexable, profile_badges!profile_badges_profile_id_fkey ( badge_slug ) ),
    review_votes ( vote, profile_id ),
    review_reactions ( reaction_type, profile_id )
  `)
  .eq('id', id)
  .eq('status', 'published')
  .single();

if (error || !review) return Astro.redirect('/404');

// Attached video (fail-soft lookup), overlapped with the comments query below.
const videoLookup = attachReviewVideos(supabase, [review]);

const { data: commentsRaw, error: commentsError } = await (supabase as any)
  .from('review_comments')
  .select('id, body, created_at, updated_at, parent_id, profiles ( id, username, avatar_url, profile_badges!profile_badges_profile_id_fkey ( badge_slug ) ), comment_votes ( vote, profile_id ), comment_reactions ( reaction_type, profile_id )')
  .eq('review_id', id)
  .order('created_at', { ascending: true });

if (commentsError) console.error('[reviews/[id]] comments query error:', commentsError);
await videoLookup;
const allComments = commentsRaw ?? [];
const topLevelComments = allComments.filter((c: any) => !c.parent_id);
const directReplyMap: Record<string, any[]> = {};
for (const c of allComments) {
  if (c.parent_id) {
    if (!directReplyMap[c.parent_id]) directReplyMap[c.parent_id] = [];
    directReplyMap[c.parent_id].push(c);
  }
}

let currentProfile: { id: string; username: string; avatar_url: string | null } | null = null;
if (user) {
  const { data: cp } = await (supabase as any)
    .from('profiles').select('id, username, avatar_url').eq('auth_user_id', user.id).single();
  currentProfile = cp;
}
const isOwnProfile = !!(currentProfile && review.profiles?.id === currentProfile.id);

// Shape review_comments into CommentData[] for the shared CommentThread.
// Reviews support 3 levels of nesting (c → r → dr).
function shapeReviewComment(c: any, depth: number): CommentData {
  const cvArr = Array.isArray(c.comment_votes) ? c.comment_votes : (c.comment_votes ? [c.comment_votes] : []);
  const up = cvArr.filter((v: any) => v.vote === 1).length;
  const down = cvArr.filter((v: any) => v.vote === -1).length;
  const myVote = currentProfile ? (cvArr.find((v: any) => v.profile_id === currentProfile!.id)?.vote ?? 0) : 0;
  const isMine = currentProfile?.id === c.profiles?.id;
  const rxArr: { reaction_type: string; profile_id: string }[] =
    Array.isArray(c.comment_reactions) ? c.comment_reactions : [];
  const rxMap: Record<string, { count: number; mine: boolean }> = {};
  for (const r of rxArr) {
    if (!rxMap[r.reaction_type]) rxMap[r.reaction_type] = { count: 0, mine: false };
    rxMap[r.reaction_type].count++;
    if (currentProfile && r.profile_id === currentProfile.id) rxMap[r.reaction_type].mine = true;
  }
  const children = depth < 3 ? (directReplyMap[c.id] ?? []).map((r: any) => shapeReviewComment(r, depth + 1)) : [];
  return {
    id: c.id,
    author: {
      id: c.profiles?.id ?? '',
      username: c.profiles?.username ?? 'unknown',
      avatarUrl: c.profiles?.avatar_url ?? null,
      badges: readBadgeSlugs(c.profiles),
    },
    body: c.body,
    createdAt: c.created_at,
    updatedAt: c.updated_at,
    upvotes: up,
    downvotes: down,
    myVote: myVote as 1 | -1 | 0,
    canEdit: isMine,
    canDelete: isMine,
    canReport: !!currentProfile && !isMine,
    reactions: Object.entries(rxMap)
      .map(([type, info]) => ({ type, count: info.count, mine: info.mine }))
      .sort((a, b) => b.count - a.count),
    replies: children,
  };
}
const threadComments: CommentData[] = topLevelComments.map((c: any) => shapeReviewComment(c, 0));

function timeAgo(dateStr: string): string {
  const diff = Math.floor((Date.now() - new Date(dateStr).getTime()) / 1000);
  if (diff < 60) return `${diff}s ago`;
  if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
  if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
  if (diff < 604800) return `${Math.floor(diff / 86400)}d ago`;
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

function getInitials(username: string): string {
  return username.slice(0, 2).toUpperCase();
}

const { up, down } = getVoteCounts(review.review_votes);
const votesArr = Array.isArray(review.review_votes) ? review.review_votes : review.review_votes ? [review.review_votes] : [];
const myVote = currentProfile ? (votesArr.find((v: any) => v.profile_id === currentProfile.id)?.vote ?? 0) : 0;

const reactionsArr: { reaction_type: string; profile_id: string }[] =
  Array.isArray((review as any).review_reactions) ? (review as any).review_reactions : [];
const reactionCountMap: Record<string, { count: number; active: boolean }> = {};
for (const r of reactionsArr) {
  if (!reactionCountMap[r.reaction_type]) reactionCountMap[r.reaction_type] = { count: 0, active: false };
  reactionCountMap[r.reaction_type].count++;
  if (currentProfile && r.profile_id === currentProfile.id) reactionCountMap[r.reaction_type].active = true;
}
const displayReactions = Object.entries(reactionCountMap).map(([type, info]) => ({
  type,
  display: type,
  isImage: !!IMAGE_EMOTE_MAP[type],
  path: IMAGE_EMOTE_MAP[type] ?? null,
  count: info.count,
  active: info.active,
}));
const coverBig = igdbImage(review.games?.cover_img_url, 't_cover_big');
const coverThumb = igdbImage(review.games?.cover_img_url, 't_thumb');

// Self-referential (not Astro.site) so preview/branch deploys render an image
// pointing at the host actually serving the request — same reasoning as the
// list OG image URL in lists/[id]/index.astro.
const ogImage = new URL(`/og/reviews/${id}.jpg`, Astro.url.origin).toString();

const reviewOgDescription =
  `@${review.profiles?.username}'s review of ${review.games?.title ?? 'this game'} - Chekpoint.gg`;

// ── SEO structured data ──
// Mirror the game page's approach (games/[slug].astro): give Google a real,
// statically-hosted image (the direct IGDB cover, not the serverless OG card)
// so it can pick a result thumbnail. Also makes the page eligible for Google's
// review rich snippet (star rating). `coverBig` is the direct images.igdb.com URL.
const reviewBreadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',  item: 'https://chekpoint.gg' },
    { '@type': 'ListItem', position: 2, name: 'Games', item: 'https://chekpoint.gg/games' },
    ...(review.games?.slug ? [{ '@type': 'ListItem', position: 3, name: review.games.title, item: `https://chekpoint.gg/games/${review.games.slug}` }] : []),
    { '@type': 'ListItem', position: review.games?.slug ? 4 : 3, name: `${review.profiles?.username ?? 'Review'}'s Review`, item: `https://chekpoint.gg/reviews/${review.id}` },
  ],
};

const reviewJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  ...(review.title ? { name: review.title } : {}),
  ...(coverBig ? { image: coverBig } : {}),
  ...(review.published_at ? { datePublished: review.published_at.slice(0, 10) } : {}),
  author: { '@type': 'Person', name: review.profiles?.username ?? 'A reviewer' },
  reviewRating: {
    '@type': 'Rating',
    ratingValue: review.score,
    bestRating: '10',
    worstRating: '1',
  },
  itemReviewed: {
    '@type': 'VideoGame',
    name: review.games?.title ?? 'Unknown game',
    ...(coverBig ? { image: coverBig } : {}),
    ...(review.games?.slug
      ? { url: new URL(`/games/${review.games.slug}`, 'https://chekpoint.gg').toString() }
      : {}),
  },
};

const { data: moreReviews } = await (supabase as any)
  .from('reviews')
  .select('id, title, score, published_at, games ( title, slug, cover_img_url )')
  .eq('profile_id', review.profiles?.id)
  .eq('status', 'published')
  .neq('id', id)
  .order('published_at', { ascending: false })
  .limit(3);
---

<Layout
  title={`${review.title ? `${review.title} — ` : ''}${review.games?.title ?? 'Review'} — Chekpoint`}
  description={reviewOgDescription}
  ogImage={ogImage}
  isLoggedIn={isLoggedIn}
  currentProfile={currentProfile}
  noindex={!review.profiles?.search_indexable}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(reviewJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(reviewBreadcrumbJsonLd)} />
  </Fragment>
  <main class="review-detail">

    <button class="review-back-btn" onclick="history.length > 1 ? history.back() : (window.location.href='/')">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12L6 8L10 4"/></svg>
      Back
    </button>

    <!-- REVIEW CARD -->
    <article class="review-full">
      <div class="review-game-bar">
        <a href={`/games/${review.games?.slug}`} class="game-cover-link">
          {coverThumb
            ? <img src={coverThumb} alt={review.games?.title} class="game-cover-thumb" />
            : <div class="game-cover-placeholder">🎮</div>
          }
        </a>
        <div class="game-bar-info">
          <a href={`/games/${review.games?.slug}`} class="game-bar-title">{review.games?.title ?? 'Unknown Game'}</a>
          <div class="game-bar-meta">
            {review.played_on && <span class="meta-tag">{review.played_on.name}</span>}
            {review.play_time_hours > 0 && <span class="meta-tag">{review.play_time_hours}h played</span>}
            {review.contains_spoilers && <span class="meta-tag spoiler-tag">⚠ spoilers</span>}
          </div>
        </div>
        <div class={`score-hero ${scoreClass(review.score)}`}>{review.score}</div>
      </div>

      <div class="review-author-row">
        <a href={`/reviewers/${review.profiles?.username}`} class="author-link">
          <div class="author-avatar">
            {review.profiles?.avatar_url
              ? <img src={review.profiles.avatar_url} alt={review.profiles.username} />
              : <span>{getInitials(review.profiles?.username ?? '?')}</span>
            }
          </div>
          <span class="author-username">@{review.profiles?.username}</span>
        </a>
        {readBadgeSlugs(review.profiles).map((slug) => <ProfileBadge slug={slug} size="sm" />)}
        <span class="review-timestamp">{timeAgo(review.published_at ?? review.created_at)}</span>
      </div>

      {review.title && <h1 class="review-title">{review.title}</h1>}

      <div class={`review-body-full ${review.contains_spoilers ? 'spoiler-hidden' : ''}`} data-spoiler={review.contains_spoilers ? 'true' : 'false'}>
        {review.contains_spoilers && (
          <div class="spoiler-notice">⚠ Spoilers — click anywhere to reveal</div>
        )}
        <div class="review-text">{review.body}</div>
        {review.youtube_video_id && (
          <div class="rv-video">
            <iframe
              src={youTubeEmbedUrl(review.youtube_video_id).replace('autoplay=1&', '')}
              title={`Video for ${review.games?.title ?? 'this review'}`}
              loading="lazy"
              allow="encrypted-media; picture-in-picture; fullscreen"
              allowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"
            ></iframe>
          </div>
        )}
      </div>

      <div class="review-actions">
        <button class={`vote-btn${myVote === 1 ? ' active-up' : ''}`} data-review-id={review.id} data-vote="1" data-count={up}>▲ {up}</button>
        <button class={`vote-btn${myVote === -1 ? ' active-down' : ''}`} data-review-id={review.id} data-vote="-1" data-count={down}>▼ {down}</button>

        <span class="rv-sep"></span>

        <div class="rv-reaction-wrap" data-review-id={review.id}>
          {displayReactions.map(r => (
            <button
              class={`rv-reaction-btn${r.active ? ' reaction-active' : ''}`}
              data-review-id={review.id}
              data-reaction={r.type}
              data-display={r.display}
              data-reacted={r.active ? 'true' : 'false'}
              data-count={r.count}
              data-logged-in={isLoggedIn ? 'true' : 'false'}
              data-is-image={r.isImage ? 'true' : 'false'}
            >
              {r.isImage
                ? <><img src={r.path!} class="rv-emote-img" alt={r.type} loading="lazy" />{' '}{r.count}</>
                : <>{r.display} {r.count}</>}
            </button>
          ))}
          <button class="rv-reaction-toggle" data-toggle-review-id={review.id} data-logged-in={isLoggedIn ? 'true' : 'false'} title="React">+</button>
        </div>

        <div class="rv-owner-actions">
          <ShareButton url={`/reviews/${review.id}`} label="Share review" variant="icon" imageUrl={`/og/reviews/${review.id}.jpg`} />
          {isLoggedIn && isOwnProfile && (
            <>
              <button
                class="rv-edit-btn"
                data-review-id={review.id}
                data-game-id={review.games?.id ?? ''}
                data-game-title={review.games?.title ?? ''}
                data-score={review.score}
                data-review-title={review.title ?? ''}
                data-body={review.body}
                data-platform-id={review.played_on?.id ?? ''}
                data-hours={review.play_time_hours ?? ''}
                data-spoilers={review.contains_spoilers ? 'true' : 'false'}
                data-youtube-url={review.youtube_video_id ? youTubeWatchUrl(review.youtube_video_id) : ''}
                title="Edit review"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </button>
              <button class="rv-delete-btn" data-review-id={review.id} title="Delete review">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
              </button>
              <span class="rv-delete-confirm" data-review-id={review.id} style="display:none">
                Sure? <button class="rv-delete-yes" data-review-id={review.id}>Yes, delete</button>
                <button class="rv-delete-no" data-review-id={review.id}>Cancel</button>
              </span>
            </>
          )}
        </div>

        {isLoggedIn && (
          <button class="report-trigger" onclick={`openReport('review','${review.id}')`} title="Report this review">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 2h10l-2 4 2 4H3V2z"/><path d="M3 14v-4"/>
            </svg>
            Report
          </button>
        )}
      </div>
    </article>

    <!-- COMMENTS (shared CommentThread) -->
    <section class="comments-section">
      <h2 class="comments-heading">
        Comments
        {allComments.length > 0 && <span class="comment-count">{allComments.length}</span>}
      </h2>
      <CommentThread
        comments={threadComments}
        currentUser={currentProfile ? { id: currentProfile.id, username: currentProfile.username, avatarUrl: currentProfile.avatar_url } : null}
        target={{ type: 'review_comment', id: review.id }}
        canCompose={isLoggedIn}
        showDownvote={true}
        showReport={true}
        maxLength={2000}
        maxDepth={3}
        signinReturnTo={Astro.url.pathname + Astro.url.search}
      />
    </section>

  </main>

  <div slot="sidebar-right">
    <div class="widget">
      <div class="widget-title">About this game</div>
      <a href={`/games/${review.games?.slug}`} style="display:flex;gap:12px;align-items:flex-start;text-decoration:none">
        <div style="flex-shrink:0;width:52px;height:70px;border-radius:8px;overflow:hidden;background:var(--tag-bg);border:1px solid var(--border)">
          {coverBig
            ? <img src={coverBig} alt={review.games?.title} style="width:100%;height:100%;object-fit:cover" />
            : <span style="display:flex;align-items:center;justify-content:center;height:100%;font-size:22px">🎮</span>
          }
        </div>
        <div style="flex:1;min-width:0">
          <div style="font-size:13px;font-weight:500;line-height:1.3;margin-bottom:6px">{review.games?.title}</div>
          <div style="font-size:12px;color:var(--text-tertiary)">View all reviews →</div>
        </div>
      </a>
    </div>

    <div class="widget">
      <div class="widget-title">Reviewer</div>
      <a href={`/reviewers/${review.profiles?.username}`} style="display:flex;gap:12px;align-items:center;text-decoration:none">
        <div class="sidebar-reviewer-avatar">
          {review.profiles?.avatar_url
            ? <img src={review.profiles.avatar_url} alt={review.profiles.username} />
            : <span>{getInitials(review.profiles?.username ?? '?')}</span>
          }
        </div>
        <div>
          <div style="font-size:13px;font-weight:500">@{review.profiles?.username}</div>
          <div style="font-size:12px;color:var(--text-tertiary)">View profile →</div>
        </div>
      </a>
    </div>

    {moreReviews && moreReviews.length > 0 && (
      <div class="widget">
        <div class="widget-title">More from this reviewer</div>
        <div style="display:flex;flex-direction:column;gap:12px">
          {moreReviews.map((r: any) => (
            <a href={`/reviews/${r.id}`} class="more-review-item">
              <div class="more-review-cover">
                {r.games?.cover_img_url
                  ? <img src={igdbImage(r.games.cover_img_url, 't_thumb') ?? ''} alt={r.games.title} />
                  : <span>🎮</span>
                }
              </div>
              <div class="more-review-info">
                <div class="more-review-game">{r.games?.title}</div>
                {r.title && <div class="more-review-title">{r.title}</div>}
              </div>
              <div class={`more-review-score ${scoreClass(r.score)}`}>{r.score}</div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

  <ReportModal />
  <EditModal />

  <script is:inline define:vars={{ ownerUsername: review.profiles?.username ?? '' }}>
    // ── Edit button ──────────────────────────────────────────────────────────
    document.addEventListener('click', function (e) {
      var editBtn = e.target.closest('.rv-edit-btn');
      if (!editBtn) return;
      var d = editBtn.dataset;
      if (typeof openEditModal === 'function') {
        openEditModal({
          reviewId:   d.reviewId,
          gameId:     d.gameId,
          gameTitle:  d.gameTitle,
          score:      d.score,
          title:      d.reviewTitle,
          body:       d.body,
          platformId: d.platformId,
          hours:      d.hours,
          spoilers:   d.spoilers === 'true',
          youtubeUrl: d.youtubeUrl || '',
        });
      }
    });

    // ── Delete flow ──────────────────────────────────────────────────────────
    document.addEventListener('click', async function (e) {
      var deleteBtn = e.target.closest('.rv-delete-btn');
      if (deleteBtn) {
        var id = deleteBtn.dataset.reviewId;
        deleteBtn.style.display = 'none';
        var confirmEl = document.querySelector('.rv-delete-confirm[data-review-id="' + id + '"]');
        if (confirmEl) confirmEl.style.display = '';
        return;
      }

      var cancelBtn = e.target.closest('.rv-delete-no');
      if (cancelBtn) {
        var id = cancelBtn.dataset.reviewId;
        var confirmEl = document.querySelector('.rv-delete-confirm[data-review-id="' + id + '"]');
        if (confirmEl) confirmEl.style.display = 'none';
        var origBtn = document.querySelector('.rv-delete-btn[data-review-id="' + id + '"]');
        if (origBtn) origBtn.style.display = '';
        return;
      }

      var yesBtn = e.target.closest('.rv-delete-yes');
      if (yesBtn) {
        var id = yesBtn.dataset.reviewId;
        yesBtn.disabled = true;
        yesBtn.textContent = 'Deleting…';
        var res = await fetch('/api/reviews/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ review_id: id }),
        });
        if (!res.ok) {
          yesBtn.disabled = false;
          yesBtn.textContent = 'Yes, delete';
          alert('Could not delete review. Please try again.');
          return;
        }
        window.location.href = ownerUsername ? '/reviewers/' + ownerUsername : '/';
      }
    });
  </script>

  <script is:inline define:vars={{ rvImageEmotes: IMAGE_EMOTES, rvImageEmoteMap: IMAGE_EMOTE_MAP }}>
    // ── Emoji picker (shared with ReviewCard if present, otherwise created here) ──
    if (!window.__rcPickerInit) {
      window.__rcPickerInit = true;
      var picker = document.createElement('div');
      picker.id = 'rc-emoji-picker';
      picker.style.cssText = 'display:none;position:fixed;z-index:1000';
      var ph = '<input type="text" id="rc-emote-search" class="rc-emote-search" placeholder="Search emotes..." autocomplete="off">';
      ph += '<div class="rc-emoji-grid rc-emote-grid" id="rc-emote-grid">';
      rvImageEmotes.forEach(function(emote) {
        // src withheld as data-src so the ~11 MB of emotes aren't fetched on
        // page load — hydrated on first picker open. See ReviewCard.astro.
        ph += '<button class="rc-emoji-pick rc-emote-pick" data-emoji="' + emote.key + '" title="' + emote.key + '"><img data-src="' + emote.path + '" class="rc-emote-picker-img" alt="' + emote.key + '"></button>';
      });
      ph += '</div>';
      picker.innerHTML = ph;
      document.body.appendChild(picker);

      var rvEmoteObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            var img = entry.target;
            if (img.dataset.src) { img.src = img.dataset.src; img.removeAttribute('data-src'); }
            rvEmoteObserver.unobserve(img);
          }
        });
      }, { root: picker, rootMargin: '80px 0px', threshold: 0 });
      picker.querySelectorAll('img[data-src]').forEach(function(im) { rvEmoteObserver.observe(im); });

      document.getElementById('rc-emote-search').addEventListener('input', function() {
        var q = this.value.toLowerCase();
        document.querySelectorAll('#rc-emote-grid .rc-emote-pick').forEach(function(btn) {
          btn.style.display = btn.dataset.emoji.toLowerCase().indexOf(q) !== -1 ? '' : 'none';
        });
      });
    }

    function rvEmoteHTML(key, count) {
      var path = rvImageEmoteMap[key];
      return '<img src="' + path + '" class="rv-emote-img" alt="' + key + '"> ' + count;
    }

    function rvApplyReaction(reviewId, reactionType, reacted, count) {
      var isImage = !!rvImageEmoteMap[reactionType];
      var updated = false;
      document.querySelectorAll('.rv-reaction-btn[data-review-id="' + reviewId + '"][data-reaction="' + reactionType + '"]').forEach(function(btn) {
        btn.dataset.reacted = reacted ? 'true' : 'false';
        btn.dataset.count = String(count);
        if (isImage) { btn.innerHTML = rvEmoteHTML(reactionType, count); }
        else { btn.textContent = reactionType + ' ' + count; }
        btn.classList.toggle('reaction-active', reacted);
        btn.style.display = count > 0 ? '' : 'none';
        updated = true;
      });
      if (!updated && count > 0) {
        var wrap = document.querySelector('.rv-reaction-wrap[data-review-id="' + reviewId + '"]');
        if (wrap) {
          var toggleBtn = wrap.querySelector('.rv-reaction-toggle');
          var newBtn = document.createElement('button');
          newBtn.className = 'rv-reaction-btn' + (reacted ? ' reaction-active' : '');
          newBtn.dataset.reviewId = reviewId;
          newBtn.dataset.reaction = reactionType;
          newBtn.dataset.reacted = reacted ? 'true' : 'false';
          newBtn.dataset.count = String(count);
          newBtn.dataset.loggedIn = 'true';
          newBtn.dataset.isImage = isImage ? 'true' : 'false';
          if (isImage) { newBtn.innerHTML = rvEmoteHTML(reactionType, count); }
          else { newBtn.textContent = reactionType + ' ' + count; }
          wrap.insertBefore(newBtn, toggleBtn);
        }
      }
    }

    function rvClosePanel() {
      var p = document.getElementById('rc-emoji-picker');
      if (p) p.style.display = 'none';
    }

    document.addEventListener('click', function(e) {
      // + toggle button
      var toggleBtn = e.target.closest('.rv-reaction-toggle');
      if (toggleBtn) {
        var reviewId = toggleBtn.dataset.toggleReviewId;
        var loggedIn = toggleBtn.dataset.loggedIn === 'true';
        var picker = document.getElementById('rc-emoji-picker');
        if (!picker) return;
        var isOpen = picker.style.display !== 'none' && picker.dataset.activeReviewId === reviewId;
        rvClosePanel();
        if (!isOpen) {
          picker.dataset.activeReviewId = reviewId;
          picker.dataset.activeLoggedIn = loggedIn ? 'true' : 'false';
          picker.style.display = 'block';
          requestAnimationFrame(function() {
            var rect = toggleBtn.getBoundingClientRect();
            var pRect = picker.getBoundingClientRect();
            var top = rect.top - pRect.height - 8;
            if (top < 8) top = rect.bottom + 8;
            var left = rect.left;
            if (left + pRect.width > window.innerWidth - 8) left = window.innerWidth - pRect.width - 8;
            picker.style.top = top + 'px';
            picker.style.left = left + 'px';
            picker.querySelectorAll('.rc-emoji-pick').forEach(function(btn) {
              var inlineBtn = document.querySelector('.rv-reaction-btn[data-review-id="' + reviewId + '"][data-reaction="' + btn.dataset.emoji + '"]');
              btn.classList.toggle('rc-emoji-active', !!(inlineBtn && inlineBtn.dataset.reacted === 'true'));
            });
          });
        }
        return;
      }

      // Pick from picker
      var emojiBtn = e.target.closest('.rc-emoji-pick');
      if (emojiBtn) {
        var picker = document.getElementById('rc-emoji-picker');
        if (!picker) return;
        var reviewId = picker.dataset.activeReviewId;
        var loggedIn = picker.dataset.activeLoggedIn === 'true';
        if (!reviewId) return;
        if (!loggedIn) { window.location.href = '/signin'; return; }
        var emoji = emojiBtn.dataset.emoji;
        var existing = document.querySelector('.rv-reaction-btn[data-review-id="' + reviewId + '"][data-reaction="' + emoji + '"]');
        var reacted = existing ? existing.dataset.reacted === 'true' : false;
        var count = existing ? (parseInt(existing.dataset.count) || 0) : 0;
        var newReacted = !reacted;
        var newCount = newReacted ? count + 1 : Math.max(0, count - 1);
        rvApplyReaction(reviewId, emoji, newReacted, newCount);
        rvClosePanel();
        fetch('/api/reviews/react', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ review_id: reviewId, reaction_type: emoji }),
        }).then(function(res) {
          if (res.status === 401) { window.location.href = '/signin'; return; }
          return res.json();
        }).then(function(data) {
          if (data) rvApplyReaction(reviewId, emoji, data.reacted, data.count);
        }).catch(function() {
          rvApplyReaction(reviewId, emoji, reacted, count);
        });
        return;
      }

      // Inline reaction button click
      var reactionBtn = e.target.closest('.rv-reaction-btn');
      if (reactionBtn) {
        if (reactionBtn.dataset.loggedIn !== 'true') { window.location.href = '/signin'; return; }
        var reviewId = reactionBtn.dataset.reviewId;
        var reaction = reactionBtn.dataset.reaction;
        var reacted = reactionBtn.dataset.reacted === 'true';
        var count = parseInt(reactionBtn.dataset.count) || 0;
        var newReacted = !reacted;
        var newCount = newReacted ? count + 1 : Math.max(0, count - 1);
        rvApplyReaction(reviewId, reaction, newReacted, newCount);
        fetch('/api/reviews/react', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ review_id: reviewId, reaction_type: reaction }),
        }).then(function(res) {
          if (res.status === 401) { window.location.href = '/signin'; return; }
          return res.json();
        }).then(function(data) {
          if (data) rvApplyReaction(reviewId, reaction, data.reacted, data.count);
        }).catch(function() {
          rvApplyReaction(reviewId, reaction, reacted, count);
        });
        return;
      }

      // Outside click: close picker
      if (!e.target.closest('.rv-reaction-wrap') && !e.target.closest('#rc-emoji-picker')) {
        rvClosePanel();
      }
    });
  </script>

  <script is:inline>
    // Spoiler reveal
    var spoilerEl = document.querySelector('.review-body-full[data-spoiler="true"]');
    if (spoilerEl) {
      spoilerEl.addEventListener('click', function () {
        spoilerEl.classList.remove('spoiler-hidden');
      });
    }

    // Review votes — optimistic: repaint immediately, reconcile with the server,
    // revert on failure.
    function paintReviewVote(reviewId, myVote, up, down) {
      document.querySelectorAll('.vote-btn[data-review-id="' + reviewId + '"]').forEach(function (b) {
        var bVote = parseInt(b.dataset.vote);
        var count = bVote === 1 ? up : down;
        b.dataset.count = count;
        b.textContent = (bVote === 1 ? '▲ ' : '▼ ') + count;
        b.classList.toggle('active-up',   bVote === 1  && myVote === 1);
        b.classList.toggle('active-down', bVote === -1 && myVote === -1);
      });
    }
    document.querySelectorAll('.vote-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var reviewId = btn.dataset.reviewId;
        var vote = parseInt(btn.dataset.vote);
        var upBtn   = document.querySelector('.vote-btn[data-review-id="' + reviewId + '"][data-vote="1"]');
        var downBtn = document.querySelector('.vote-btn[data-review-id="' + reviewId + '"][data-vote="-1"]');
        var prevUp   = upBtn   ? (parseInt(upBtn.dataset.count)   || 0) : 0;
        var prevDown = downBtn ? (parseInt(downBtn.dataset.count) || 0) : 0;
        var prevMy = upBtn && upBtn.classList.contains('active-up') ? 1
                   : downBtn && downBtn.classList.contains('active-down') ? -1 : 0;

        var nextMy = prevMy === vote ? 0 : vote;
        var up = prevUp, down = prevDown;
        if (prevMy === 1) up = Math.max(0, up - 1);
        if (prevMy === -1) down = Math.max(0, down - 1);
        if (nextMy === 1) up += 1;
        if (nextMy === -1) down += 1;
        paintReviewVote(reviewId, nextMy, up, down);

        fetch('/api/reviews/vote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ review_id: reviewId, vote }),
        }).then(function (res) {
          if (res.status === 401) { window.location.href = '/signin'; return null; }
          if (!res.ok) { paintReviewVote(reviewId, prevMy, prevUp, prevDown); return null; }
          return res.json();
        }).then(function (data) {
          if (!data) return;
          paintReviewVote(reviewId, data.vote || 0, data.up, data.down);
        }).catch(function () {
          paintReviewVote(reviewId, prevMy, prevUp, prevDown);
        });
      });
    });

  </script>
</Layout>

