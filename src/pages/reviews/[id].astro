---
export const prerender = false;
import { getSupabase, createSupabaseServerClientFromContext } from '../../utils/database';
import Layout from '../../components/Layout.astro';
import ReportModal from '../../components/ReportModal.astro';

const supabase = getSupabase();
const serverClient = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await serverClient.auth.getUser();
const isLoggedIn = !!user;

const { id } = Astro.params;

const { data: review, error } = await (supabase as any)
  .from('reviews')
  .select(`
    id, score, title, body, play_time_hours,
    contains_spoilers, status, published_at, created_at,
    played_on:platform_played_on ( id, name, slug ),
    games ( id, title, slug, cover_img_url ),
    profiles ( id, username, avatar_url ),
    review_votes ( vote, profile_id )
  `)
  .eq('id', id)
  .eq('status', 'published')
  .single();

if (error || !review) return Astro.redirect('/404');

const { data: commentsRaw, error: commentsError } = await (supabase as any)
  .from('review_comments')
  .select('id, body, created_at, parent_id, profiles ( id, username, avatar_url ), comment_votes ( vote, profile_id )')
  .eq('review_id', id)
  .order('created_at', { ascending: true });

if (commentsError) console.error('[reviews/[id]] comments query error:', commentsError);
const allComments = commentsRaw ?? [];
const commentById: Record<string, any> = {};
for (const c of allComments) commentById[c.id] = c;
function getRootId(cid: string): string {
  const c = commentById[cid];
  if (!c || !c.parent_id) return cid;
  return getRootId(c.parent_id);
}
function renderBody(text: string): string {
  const esc = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  return esc.replace(/(^|\s)(@([\w]+))/g, '$1<a class="mention" href="/reviewers/$3">$2</a>');
}
const topLevelComments = allComments.filter((c: any) => !c.parent_id);
const replyMap: Record<string, any[]> = {};
for (const c of allComments) {
  if (c.parent_id) {
    const rootId = getRootId(c.id);
    if (!replyMap[rootId]) replyMap[rootId] = [];
    replyMap[rootId].push(c);
  }
}

let currentProfile: { id: string; username: string; avatar_url: string | null } | null = null;
if (user) {
  const { data: cp } = await (supabase as any)
    .from('profiles').select('id, username, avatar_url').eq('auth_user_id', user.id).single();
  currentProfile = cp;
}

function igdbImage(url: string | null, size = 't_cover_big') {
  if (!url) return null;
  const clean = url.startsWith('//') ? `https:${url}` : url;
  return clean.replace(/t_[a-z_]+/, size);
}

function timeAgo(dateStr: string): string {
  const diff = Math.floor((Date.now() - new Date(dateStr).getTime()) / 1000);
  if (diff < 60) return `${diff}s ago`;
  if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
  if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
  if (diff < 604800) return `${Math.floor(diff / 86400)}d ago`;
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

function scoreColor(score: number): string {
  if (score === 10) return 'score-perfect';
  if (score >= 9) return 'score-great';
  if (score >= 8) return 'score-teal';
  if (score >= 7) return 'score-good';
  if (score >= 5) return 'score-mid';
  if (score >= 3) return 'score-orange';
  return 'score-low';
}

function getInitials(username: string): string {
  return username.slice(0, 2).toUpperCase();
}

function getVoteCounts(votes: any) {
  const arr = Array.isArray(votes) ? votes : votes ? [votes] : [];
  const up = arr.filter((v: any) => v.vote === 1).length;
  const down = arr.filter((v: any) => v.vote === -1).length;
  return { up, down };
}

const { up, down } = getVoteCounts(review.review_votes);
const votesArr = Array.isArray(review.review_votes) ? review.review_votes : review.review_votes ? [review.review_votes] : [];
const myVote = currentProfile ? (votesArr.find((v: any) => v.profile_id === currentProfile.id)?.vote ?? 0) : 0;
const coverBig = igdbImage(review.games?.cover_img_url, 't_cover_big');
const coverThumb = igdbImage(review.games?.cover_img_url, 't_thumb');

const { data: moreReviews } = await (supabase as any)
  .from('reviews')
  .select('id, title, score, published_at, games ( title, slug, cover_img_url )')
  .eq('profile_id', review.profiles?.id)
  .eq('status', 'published')
  .neq('id', id)
  .order('published_at', { ascending: false })
  .limit(3);
---

<Layout
  title={`${review.title} — ${review.games?.title ?? 'Review'} — Chekpoint`}
  isLoggedIn={isLoggedIn}
  currentProfile={currentProfile}
>
  <main class="review-detail">

    <button class="review-back-btn" onclick="history.length > 1 ? history.back() : (window.location.href='/')">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12L6 8L10 4"/></svg>
      Back
    </button>

    <!-- REVIEW CARD -->
    <article class="review-full">
      <div class="review-game-bar">
        <a href={`/games/${review.games?.slug}`} class="game-cover-link">
          {coverThumb
            ? <img src={coverThumb} alt={review.games?.title} class="game-cover-thumb" />
            : <div class="game-cover-placeholder">🎮</div>
          }
        </a>
        <div class="game-bar-info">
          <a href={`/games/${review.games?.slug}`} class="game-bar-title">{review.games?.title ?? 'Unknown Game'}</a>
          <div class="game-bar-meta">
            {review.played_on && <span class="meta-tag">{review.played_on.name}</span>}
            {review.play_time_hours > 0 && <span class="meta-tag">{review.play_time_hours}h played</span>}
            {review.contains_spoilers && <span class="meta-tag spoiler-tag">⚠ spoilers</span>}
          </div>
        </div>
        <div class={`score-hero ${scoreColor(review.score)}`}>{review.score}</div>
      </div>

      <div class="review-author-row">
        <a href={`/reviewers/${review.profiles?.username}`} class="author-link">
          <div class="author-avatar">
            {review.profiles?.avatar_url
              ? <img src={review.profiles.avatar_url} alt={review.profiles.username} />
              : <span>{getInitials(review.profiles?.username ?? '?')}</span>
            }
          </div>
          <span class="author-username">@{review.profiles?.username}</span>
        </a>
        <span class="review-timestamp">{timeAgo(review.published_at ?? review.created_at)}</span>
      </div>

      {review.title && <h1 class="review-title">{review.title}</h1>}

      <div class={`review-body-full ${review.contains_spoilers ? 'spoiler-hidden' : ''}`} data-spoiler={review.contains_spoilers ? 'true' : 'false'}>
        {review.contains_spoilers && (
          <div class="spoiler-notice">⚠ Spoilers — click anywhere to reveal</div>
        )}
        <div class="review-text">{review.body}</div>
      </div>

      <div class="review-actions">
        <button class={`vote-btn${myVote === 1 ? ' active-up' : ''}`} data-review-id={review.id} data-vote="1" data-count={up}>▲ {up}</button>
        <button class={`vote-btn${myVote === -1 ? ' active-down' : ''}`} data-review-id={review.id} data-vote="-1" data-count={down}>▼ {down}</button>
        {isLoggedIn && (
          <button class="report-trigger" onclick={`openReport('review','${review.id}')`} title="Report this review">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 2h10l-2 4 2 4H3V2z"/><path d="M3 14v-4"/>
            </svg>
            Report
          </button>
        )}
      </div>
    </article>

    <!-- COMMENTS -->
    <section class="comments-section">
      <h2 class="comments-heading">
        Comments
        {allComments.length > 0 && <span class="comment-count">{allComments.length}</span>}
      </h2>

      {allComments.length === 0 && (
        <div class="no-comments">No comments yet. {isLoggedIn ? 'Be the first!' : ''}</div>
      )}

      <div class="comment-list" id="commentList">
        {topLevelComments.map((c: any) => {
          const threadReplies = replyMap[c.id] ?? [];
          const cvArr = Array.isArray(c.comment_votes) ? c.comment_votes : c.comment_votes ? [c.comment_votes] : [];
          const cUp = cvArr.filter((v: any) => v.vote === 1).length;
          const cDown = cvArr.filter((v: any) => v.vote === -1).length;
          const cMyVote = currentProfile ? (cvArr.find((v: any) => v.profile_id === currentProfile!.id)?.vote ?? 0) : 0;
          return (
            <div class="comment-thread" data-thread-id={c.id}>
              <div class="comment">
                <a href={`/reviewers/${c.profiles?.username}`} class="comment-avatar">
                  {c.profiles?.avatar_url
                    ? <img src={c.profiles.avatar_url} alt={c.profiles.username} />
                    : <span>{getInitials(c.profiles?.username ?? '?')}</span>
                  }
                </a>
                <div class="comment-body">
                  <div class="comment-meta">
                    <a href={`/reviewers/${c.profiles?.username}`} class="comment-username">@{c.profiles?.username}</a>
                    <span class="comment-time">{timeAgo(c.created_at)}</span>
                  </div>
                  <div class="comment-text" set:html={renderBody(c.body)}></div>
                  <div class="comment-actions">
                    <button class={`cvote-btn${cMyVote === 1 ? ' cvote-up' : ''}`} data-comment-id={c.id} data-vote="1" data-logged-in={isLoggedIn ? 'true' : 'false'}>▲ {cUp}</button>
                    <button class={`cvote-btn${cMyVote === -1 ? ' cvote-down' : ''}`} data-comment-id={c.id} data-vote="-1" data-logged-in={isLoggedIn ? 'true' : 'false'}>▼ {cDown}</button>
                    {isLoggedIn && <button class="comment-reply-btn" data-parent-id={c.id} data-thread-id={c.id} data-reply-to={c.profiles?.username} type="button">↩ Reply</button>}
                    {isLoggedIn && <button class="comment-report-btn" onclick={`openReport('comment','${c.id}')`}>Report</button>}
                  </div>
                </div>
              </div>

              <div class="replies" data-replies-for={c.id}>
                {threadReplies.map((r: any) => {
                  const rArr = Array.isArray(r.comment_votes) ? r.comment_votes : r.comment_votes ? [r.comment_votes] : [];
                  const rUp = rArr.filter((v: any) => v.vote === 1).length;
                  const rDown = rArr.filter((v: any) => v.vote === -1).length;
                  const rMyVote = currentProfile ? (rArr.find((v: any) => v.profile_id === currentProfile!.id)?.vote ?? 0) : 0;
                  return (
                    <div class="comment comment-reply" data-comment-id={r.id}>
                      <a href={`/reviewers/${r.profiles?.username}`} class="comment-avatar comment-avatar-sm">
                        {r.profiles?.avatar_url
                          ? <img src={r.profiles.avatar_url} alt={r.profiles.username} />
                          : <span>{getInitials(r.profiles?.username ?? '?')}</span>
                        }
                      </a>
                      <div class="comment-body">
                        <div class="comment-meta">
                          <a href={`/reviewers/${r.profiles?.username}`} class="comment-username">@{r.profiles?.username}</a>
                          <span class="comment-time">{timeAgo(r.created_at)}</span>
                        </div>
                        <div class="comment-text" set:html={renderBody(r.body)}></div>
                        <div class="comment-actions">
                          <button class={`cvote-btn${rMyVote === 1 ? ' cvote-up' : ''}`} data-comment-id={r.id} data-vote="1" data-logged-in={isLoggedIn ? 'true' : 'false'}>▲ {rUp}</button>
                          <button class={`cvote-btn${rMyVote === -1 ? ' cvote-down' : ''}`} data-comment-id={r.id} data-vote="-1" data-logged-in={isLoggedIn ? 'true' : 'false'}>▼ {rDown}</button>
                          {isLoggedIn && <button class="comment-reply-btn" data-parent-id={r.id} data-thread-id={c.id} data-reply-to={r.profiles?.username} type="button">↩ Reply</button>}
                          {isLoggedIn && <button class="comment-report-btn" onclick={`openReport('comment','${r.id}')`}>Report</button>}
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>

              {isLoggedIn && (
                <div class="reply-form-wrap" id={`reply-form-${c.id}`} style="display:none">
                  <div class="reply-form-inner">
                    <div class="comment-avatar comment-avatar-sm">
                      {currentProfile?.avatar_url
                        ? <img src={currentProfile.avatar_url} alt={currentProfile.username} />
                        : <span>{getInitials(currentProfile?.username ?? '?')}</span>
                      }
                    </div>
                    <div class="reply-input-wrap">
                      <textarea class="reply-body" placeholder="Write a reply…" maxlength="2000" rows="2"></textarea>
                      <div class="reply-form-footer">
                        <span class="reply-char-count"><span class="reply-char-num">0</span> / 2000</span>
                        <button class="reply-cancel-btn" type="button">Cancel</button>
                        <button class="reply-submit-btn" type="button" data-parent-id={c.id} data-review-id={id}>Reply</button>
                      </div>
                    </div>
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </div>

      {isLoggedIn ? (
        <form class="comment-form" id="commentForm">
          <div class="comment-input-row">
            <div class="comment-form-avatar">
              {currentProfile?.avatar_url
                ? <img src={currentProfile.avatar_url} alt={currentProfile.username} />
                : <span>{getInitials(currentProfile?.username ?? '?')}</span>
              }
            </div>
            <div class="comment-input-wrap">
              <textarea
                id="commentBody"
                placeholder="Write a comment…"
                maxlength="2000"
                rows={3}
              ></textarea>
              <div class="comment-form-footer">
                <span class="comment-char-count"><span id="commentCharCount">0</span> / 2000</span>
                <button type="submit" class="comment-submit" id="commentSubmit">Post comment</button>
              </div>
            </div>
          </div>
          <div class="comment-error" id="commentError" style="display:none"></div>
        </form>
      ) : (
        <div class="comment-signin-prompt">
          <a href="/signin">Sign in</a> to leave a comment.
        </div>
      )}
    </section>
  </main>

  <div slot="sidebar-right">
    <div class="widget">
      <div class="widget-title">About this game</div>
      <a href={`/games/${review.games?.slug}`} style="display:flex;gap:12px;align-items:flex-start;text-decoration:none">
        <div style="flex-shrink:0;width:52px;height:70px;border-radius:8px;overflow:hidden;background:var(--tag-bg);border:1px solid var(--border)">
          {coverBig
            ? <img src={coverBig} alt={review.games?.title} style="width:100%;height:100%;object-fit:cover" />
            : <span style="display:flex;align-items:center;justify-content:center;height:100%;font-size:22px">🎮</span>
          }
        </div>
        <div style="flex:1;min-width:0">
          <div style="font-size:13px;font-weight:500;line-height:1.3;margin-bottom:6px">{review.games?.title}</div>
          <div style="font-size:12px;color:var(--text-tertiary)">View all reviews →</div>
        </div>
      </a>
    </div>

    <div class="widget">
      <div class="widget-title">Reviewer</div>
      <a href={`/reviewers/${review.profiles?.username}`} style="display:flex;gap:12px;align-items:center;text-decoration:none">
        <div class="sidebar-reviewer-avatar">
          {review.profiles?.avatar_url
            ? <img src={review.profiles.avatar_url} alt={review.profiles.username} />
            : <span>{getInitials(review.profiles?.username ?? '?')}</span>
          }
        </div>
        <div>
          <div style="font-size:13px;font-weight:500">@{review.profiles?.username}</div>
          <div style="font-size:12px;color:var(--text-tertiary)">View profile →</div>
        </div>
      </a>
    </div>

    {moreReviews && moreReviews.length > 0 && (
      <div class="widget">
        <div class="widget-title">More from this reviewer</div>
        <div style="display:flex;flex-direction:column;gap:12px">
          {moreReviews.map((r: any) => (
            <a href={`/reviews/${r.id}`} class="more-review-item">
              <div class="more-review-cover">
                {r.games?.cover_img_url
                  ? <img src={igdbImage(r.games.cover_img_url, 't_thumb') ?? ''} alt={r.games.title} />
                  : <span>🎮</span>
                }
              </div>
              <div class="more-review-info">
                <div class="more-review-game">{r.games?.title}</div>
                {r.title && <div class="more-review-title">{r.title}</div>}
              </div>
              <div class={`more-review-score ${scoreColor(r.score)}`}>{r.score}</div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

  <ReportModal />

  <script is:inline>
    // Spoiler reveal
    var spoilerEl = document.querySelector('.review-body-full[data-spoiler="true"]');
    if (spoilerEl) {
      spoilerEl.addEventListener('click', function () {
        spoilerEl.classList.remove('spoiler-hidden');
      });
    }

    // Review votes
    document.querySelectorAll('.vote-btn').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        if (btn.disabled) return;
        btn.disabled = true;
        try {
          var reviewId = btn.dataset.reviewId;
          var vote = parseInt(btn.dataset.vote);
          var res = await fetch('/api/reviews/vote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ review_id: reviewId, vote }),
          });
          if (res.status === 401) { window.location.href = '/signin'; return; }
          if (!res.ok) return;
          var data = await res.json();
          document.querySelectorAll('.vote-btn[data-review-id="' + reviewId + '"]').forEach(function (b) {
            var bVote = parseInt(b.dataset.vote);
            b.textContent = (bVote === 1 ? '▲ ' : '▼ ') + (bVote === 1 ? data.up : data.down);
            b.classList.toggle('active-up',   bVote === 1  && data.vote === 1);
            b.classList.toggle('active-down', bVote === -1 && data.vote === -1);
          });
        } finally { btn.disabled = false; }
      });
    });

    // Comment votes (delegated)
    document.addEventListener('click', async function(e) {
      var btn = e.target.closest('.cvote-btn');
      if (!btn) return;
      if (btn.dataset.loggedIn !== 'true') { window.location.href = '/signin'; return; }
      if (btn.disabled) return;
      btn.disabled = true;
      try {
        var commentId = btn.dataset.commentId;
        var vote = parseInt(btn.dataset.vote);
        var res = await fetch('/api/comments/vote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ comment_id: commentId, vote }),
        });
        if (res.status === 401) { window.location.href = '/signin'; return; }
        if (!res.ok) return;
        var data = await res.json();
        document.querySelectorAll('.cvote-btn[data-comment-id="' + commentId + '"]').forEach(function(b) {
          var bVote = parseInt(b.dataset.vote);
          b.textContent = (bVote === 1 ? '▲ ' : '▼ ') + (bVote === 1 ? data.up : data.down);
          b.classList.toggle('cvote-up',   bVote === 1  && data.vote === 1);
          b.classList.toggle('cvote-down', bVote === -1 && data.vote === -1);
        });
      } finally { btn.disabled = false; }
    });

    // ── Reply interactions (delegated) ──────────────────────────────────────
    function renderBody(text) {
      var esc = text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      return esc.replace(/(^|\s)(@([\w]+))/g, function(m, pre, mention, username) {
        return pre + '<a class="mention" href="/reviewers/' + username + '">' + mention + '</a>';
      });
    }

    document.addEventListener('click', async function(e) {
      // Toggle reply form
      var replyBtn = e.target.closest('.comment-reply-btn');
      if (replyBtn) {
        var parentId = replyBtn.dataset.parentId;
        var threadId = replyBtn.dataset.threadId || parentId;
        var replyTo = replyBtn.dataset.replyTo;
        var wrap = document.getElementById('reply-form-' + threadId);
        if (!wrap) return;
        var isOpen = wrap.style.display !== 'none';
        document.querySelectorAll('.reply-form-wrap').forEach(function(w) { w.style.display = 'none'; });
        if (!isOpen) {
          // Point the submit button at the actual parent being replied to
          var sb = wrap.querySelector('.reply-submit-btn');
          if (sb) sb.dataset.parentId = parentId;
          wrap.style.display = 'block';
          var ta = wrap.querySelector('textarea');
          if (ta) {
            ta.value = replyTo ? '@' + replyTo + ' ' : '';
            ta.focus();
            ta.setSelectionRange(ta.value.length, ta.value.length);
            var counter = wrap.querySelector('.reply-char-num');
            if (counter) counter.textContent = ta.value.length;
          }
        }
        return;
      }

      // Cancel reply form
      var cancelBtn = e.target.closest('.reply-cancel-btn');
      if (cancelBtn) {
        var wrap = cancelBtn.closest('.reply-form-wrap');
        wrap.style.display = 'none';
        var ta = wrap.querySelector('textarea');
        if (ta) { ta.value = ''; }
        var counter = wrap.querySelector('.reply-char-num');
        if (counter) counter.textContent = '0';
        return;
      }

      // Submit reply
      var submitBtn = e.target.closest('.reply-submit-btn');
      if (!submitBtn) return;
      var parentId = submitBtn.dataset.parentId;
      var reviewId = submitBtn.dataset.reviewId;
      var wrap = submitBtn.closest('.reply-form-wrap');
      var threadId = wrap.id.replace('reply-form-', '');
      var ta = wrap.querySelector('textarea');
      var body = ta.value.trim();
      if (!body) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Posting…';
      try {
        var res = await fetch('/api/comments/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ review_id: reviewId, parent_id: parentId, body }),
        });
        var data = await res.json();
        if (!res.ok) { alert(data.error || 'Failed to post reply.'); return; }

        var c = data.comment;
        var p = c.profiles;
        var initials = p?.username ? p.username.slice(0, 2).toUpperCase() : '?';
        var avatarHtml = p?.avatar_url
          ? '<img src="' + p.avatar_url + '" alt="" style="display:block;width:26px;height:26px;object-fit:cover;" />'
          : '<span>' + initials + '</span>';

        var replyEl = document.createElement('div');
        replyEl.className = 'comment comment-reply';
        replyEl.dataset.commentId = c.id;
        replyEl.innerHTML =
          '<a href="/reviewers/' + (p?.username ?? '') + '" class="comment-avatar comment-avatar-sm">' + avatarHtml + '</a>' +
          '<div class="comment-body">' +
            '<div class="comment-meta">' +
              '<a href="/reviewers/' + (p?.username ?? '') + '" class="comment-username">@' + (p?.username ?? '') + '</a>' +
              '<span class="comment-time">just now</span>' +
            '</div>' +
            '<div class="comment-text">' + renderBody(c?.body ?? '') + '</div>' +
            '<div class="comment-actions">' +
              '<button class="cvote-btn" data-comment-id="' + c.id + '" data-vote="1" data-logged-in="true">▲ 0</button>' +
              '<button class="cvote-btn" data-comment-id="' + c.id + '" data-vote="-1" data-logged-in="true">▼ 0</button>' +
              '<button class="comment-reply-btn" data-parent-id="' + c.id + '" data-thread-id="' + threadId + '" data-reply-to="' + (p?.username ?? '') + '" type="button">↩ Reply</button>' +
            '</div>' +
          '</div>';

        var repliesContainer = document.querySelector('.replies[data-replies-for="' + threadId + '"]');
        if (repliesContainer) repliesContainer.appendChild(replyEl);

        wrap.style.display = 'none';
        ta.value = '';
        var counter = wrap.querySelector('.reply-char-num');
        if (counter) counter.textContent = '0';

        document.querySelector('.no-comments')?.remove();
      } catch(err) {
        alert('Something went wrong. Please try again.');
        console.error('[reply submit]', err);
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Reply';
      }
    });

    // Reply textarea char count
    document.addEventListener('input', function(e) {
      if (!e.target.classList.contains('reply-body')) return;
      var wrap = e.target.closest('.reply-form-wrap');
      var counter = wrap && wrap.querySelector('.reply-char-num');
      if (counter) counter.textContent = e.target.value.length;
    });
    // ────────────────────────────────────────────────────────────────────────

    // Main comment form
    var commentForm = document.getElementById('commentForm');
    var commentBody = document.getElementById('commentBody');
    var commentSubmit = document.getElementById('commentSubmit');
    var commentError = document.getElementById('commentError');
    var commentList = document.getElementById('commentList');
    var commentCharCount = document.getElementById('commentCharCount');

    if (commentBody && commentCharCount) {
      commentBody.addEventListener('input', function () {
        commentCharCount.textContent = this.value.length;
      });
    }

    if (commentForm) {
      commentForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        commentError.style.display = 'none';
        var body = commentBody.value.trim();
        if (!body) return;

        commentSubmit.disabled = true;
        commentSubmit.textContent = 'Posting…';

        try {
          var reviewId = location.pathname.split('/').pop();
          var res = await fetch('/api/comments/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ review_id: reviewId, body }),
          });

          var data = await res.json();
          if (!res.ok) {
            commentError.textContent = data.error || 'Failed to post comment.';
            commentError.style.display = 'block';
            return;
          }

          var c = data.comment;
          var p = c?.profiles;
          var initials = p?.username ? p.username.slice(0, 2).toUpperCase() : '?';
          var avatarHtml = p?.avatar_url
            ? '<img src="' + p.avatar_url + '" alt="' + (p.username ?? '') + '" style="display:block;width:32px;height:32px;object-fit:cover;" />'
            : '<span>' + initials + '</span>';

          // Build thread wrapper (includes empty replies container + reply form)
          var thread = document.createElement('div');
          thread.className = 'comment-thread';
          thread.dataset.threadId = c.id;
          thread.innerHTML =
            '<div class="comment">' +
              '<a href="/reviewers/' + (p?.username ?? '') + '" class="comment-avatar">' + avatarHtml + '</a>' +
              '<div class="comment-body">' +
                '<div class="comment-meta">' +
                  '<a href="/reviewers/' + (p?.username ?? '') + '" class="comment-username">@' + (p?.username ?? '') + '</a>' +
                  '<span class="comment-time">just now</span>' +
                '</div>' +
                '<div class="comment-text">' + renderBody(c?.body ?? '') + '</div>' +
                '<div class="comment-actions">' +
                  '<button class="cvote-btn" data-comment-id="' + (c?.id ?? '') + '" data-vote="1" data-logged-in="true">▲ 0</button>' +
                  '<button class="cvote-btn" data-comment-id="' + (c?.id ?? '') + '" data-vote="-1" data-logged-in="true">▼ 0</button>' +
                  '<button class="comment-reply-btn" data-parent-id="' + c.id + '" data-thread-id="' + c.id + '" data-reply-to="' + (p?.username ?? '') + '" type="button">↩ Reply</button>' +
                '</div>' +
              '</div>' +
            '</div>' +
            '<div class="replies" data-replies-for="' + c.id + '"></div>' +
            '<div class="reply-form-wrap" id="reply-form-' + c.id + '" style="display:none">' +
              '<div class="reply-form-inner">' +
                '<div class="comment-avatar comment-avatar-sm">' + avatarHtml.replace('32px', '26px') + '</div>' +
                '<div class="reply-input-wrap">' +
                  '<textarea class="reply-body" placeholder="Write a reply…" maxlength="2000" rows="2"></textarea>' +
                  '<div class="reply-form-footer">' +
                    '<span class="reply-char-count"><span class="reply-char-num">0</span> / 2000</span>' +
                    '<button class="reply-cancel-btn" type="button">Cancel</button>' +
                    '<button class="reply-submit-btn" type="button" data-parent-id="' + c.id + '" data-review-id="' + reviewId + '">Reply</button>' +
                  '</div>' +
                '</div>' +
              '</div>' +
            '</div>';

          commentList.appendChild(thread);
          document.querySelector('.no-comments')?.remove();
          commentBody.value = '';
          if (commentCharCount) commentCharCount.textContent = '0';

        } catch (err) {
          commentError.textContent = 'Something went wrong. Please try again.';
          commentError.style.display = 'block';
          console.error('[comment submit]', err);
        } finally {
          commentSubmit.disabled = false;
          commentSubmit.textContent = 'Post comment';
        }
      });
    }
  </script>
</Layout>

