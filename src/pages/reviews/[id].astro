---
export const prerender = false;
import { getSupabase, createSupabaseServerClientFromContext } from '../../utils/database';
import { EMOJI_CATEGORIES, IMAGE_EMOTES, IMAGE_EMOTE_MAP } from '../../utils/reactions';
import Layout from '../../components/Layout.astro';
import ReportModal from '../../components/ReportModal.astro';

const supabase = getSupabase();
const serverClient = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await serverClient.auth.getUser();
const isLoggedIn = !!user;

const { id } = Astro.params;

const { data: review, error } = await (supabase as any)
  .from('reviews')
  .select(`
    id, score, title, body, play_time_hours,
    contains_spoilers, status, published_at, created_at,
    played_on:platform_played_on ( id, name, slug ),
    games ( id, title, slug, cover_img_url ),
    profiles ( id, username, avatar_url ),
    review_votes ( vote, profile_id ),
    review_reactions ( reaction_type, profile_id )
  `)
  .eq('id', id)
  .eq('status', 'published')
  .single();

if (error || !review) return Astro.redirect('/404');

const { data: commentsRaw, error: commentsError } = await (supabase as any)
  .from('review_comments')
  .select('id, body, created_at, updated_at, parent_id, profiles ( id, username, avatar_url ), comment_votes ( vote, profile_id ), comment_reactions ( reaction_type, profile_id )')
  .eq('review_id', id)
  .order('created_at', { ascending: true });

if (commentsError) console.error('[reviews/[id]] comments query error:', commentsError);
const allComments = commentsRaw ?? [];
function renderBody(text: string): string {
  const esc = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const withMentions = esc.replace(/(^|\s)(@([\w]+))/g, '$1<a class="mention" href="/reviewers/$3">$2</a>');
  return withMentions.replace(/:([A-Za-z0-9_]+):/g, (_, key) => {
    const path = IMAGE_EMOTE_MAP[key];
    return path ? `<img src="${path}" class="comment-emote" alt=":${key}:" title=":${key}:">` : `:${key}:`;
  });
}
const topLevelComments = allComments.filter((c: any) => !c.parent_id);
const directReplyMap: Record<string, any[]> = {};
for (const c of allComments) {
  if (c.parent_id) {
    if (!directReplyMap[c.parent_id]) directReplyMap[c.parent_id] = [];
    directReplyMap[c.parent_id].push(c);
  }
}

let currentProfile: { id: string; username: string; avatar_url: string | null } | null = null;
if (user) {
  const { data: cp } = await (supabase as any)
    .from('profiles').select('id, username, avatar_url').eq('auth_user_id', user.id).single();
  currentProfile = cp;
}

function igdbImage(url: string | null, size = 't_cover_big') {
  if (!url) return null;
  const clean = url.startsWith('//') ? `https:${url}` : url;
  return clean.replace(/t_[a-z_]+/, size);
}

function timeAgo(dateStr: string): string {
  const diff = Math.floor((Date.now() - new Date(dateStr).getTime()) / 1000);
  if (diff < 60) return `${diff}s ago`;
  if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
  if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
  if (diff < 604800) return `${Math.floor(diff / 86400)}d ago`;
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

function scoreColor(score: number): string {
  if (score === 10) return 'score-perfect';
  if (score >= 9) return 'score-great';
  if (score >= 8) return 'score-teal';
  if (score >= 7) return 'score-good';
  if (score >= 5) return 'score-mid';
  if (score >= 3) return 'score-orange';
  return 'score-low';
}

function getInitials(username: string): string {
  return username.slice(0, 2).toUpperCase();
}

function getVoteCounts(votes: any) {
  const arr = Array.isArray(votes) ? votes : votes ? [votes] : [];
  const up = arr.filter((v: any) => v.vote === 1).length;
  const down = arr.filter((v: any) => v.vote === -1).length;
  return { up, down };
}

function getCommentReactions(comment: any) {
  const arr: { reaction_type: string; profile_id: string }[] =
    Array.isArray(comment.comment_reactions) ? comment.comment_reactions : [];
  const map: Record<string, { count: number; active: boolean }> = {};
  for (const r of arr) {
    if (!map[r.reaction_type]) map[r.reaction_type] = { count: 0, active: false };
    map[r.reaction_type].count++;
    if (currentProfile && r.profile_id === currentProfile.id) map[r.reaction_type].active = true;
  }
  return Object.entries(map).map(([type, info]) => ({
    type,
    display: type,
    isImage: !!IMAGE_EMOTE_MAP[type],
    path: IMAGE_EMOTE_MAP[type] ?? null,
    count: info.count,
    active: info.active,
  }));
}

const { up, down } = getVoteCounts(review.review_votes);
const votesArr = Array.isArray(review.review_votes) ? review.review_votes : review.review_votes ? [review.review_votes] : [];
const myVote = currentProfile ? (votesArr.find((v: any) => v.profile_id === currentProfile.id)?.vote ?? 0) : 0;

const reactionsArr: { reaction_type: string; profile_id: string }[] =
  Array.isArray((review as any).review_reactions) ? (review as any).review_reactions : [];
const reactionCountMap: Record<string, { count: number; active: boolean }> = {};
for (const r of reactionsArr) {
  if (!reactionCountMap[r.reaction_type]) reactionCountMap[r.reaction_type] = { count: 0, active: false };
  reactionCountMap[r.reaction_type].count++;
  if (currentProfile && r.profile_id === currentProfile.id) reactionCountMap[r.reaction_type].active = true;
}
const displayReactions = Object.entries(reactionCountMap).map(([type, info]) => ({
  type,
  display: type,
  isImage: !!IMAGE_EMOTE_MAP[type],
  path: IMAGE_EMOTE_MAP[type] ?? null,
  count: info.count,
  active: info.active,
}));
const coverBig = igdbImage(review.games?.cover_img_url, 't_cover_big');
const coverThumb = igdbImage(review.games?.cover_img_url, 't_thumb');

const { data: moreReviews } = await (supabase as any)
  .from('reviews')
  .select('id, title, score, published_at, games ( title, slug, cover_img_url )')
  .eq('profile_id', review.profiles?.id)
  .eq('status', 'published')
  .neq('id', id)
  .order('published_at', { ascending: false })
  .limit(3);
---

<Layout
  title={`${review.title} — ${review.games?.title ?? 'Review'} — Chekpoint`}
  isLoggedIn={isLoggedIn}
  currentProfile={currentProfile}
>
  <main class="review-detail">

    <button class="review-back-btn" onclick="history.length > 1 ? history.back() : (window.location.href='/')">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12L6 8L10 4"/></svg>
      Back
    </button>

    <!-- REVIEW CARD -->
    <article class="review-full">
      <div class="review-game-bar">
        <a href={`/games/${review.games?.slug}`} class="game-cover-link">
          {coverThumb
            ? <img src={coverThumb} alt={review.games?.title} class="game-cover-thumb" />
            : <div class="game-cover-placeholder">🎮</div>
          }
        </a>
        <div class="game-bar-info">
          <a href={`/games/${review.games?.slug}`} class="game-bar-title">{review.games?.title ?? 'Unknown Game'}</a>
          <div class="game-bar-meta">
            {review.played_on && <span class="meta-tag">{review.played_on.name}</span>}
            {review.play_time_hours > 0 && <span class="meta-tag">{review.play_time_hours}h played</span>}
            {review.contains_spoilers && <span class="meta-tag spoiler-tag">⚠ spoilers</span>}
          </div>
        </div>
        <div class={`score-hero ${scoreColor(review.score)}`}>{review.score}</div>
      </div>

      <div class="review-author-row">
        <a href={`/reviewers/${review.profiles?.username}`} class="author-link">
          <div class="author-avatar">
            {review.profiles?.avatar_url
              ? <img src={review.profiles.avatar_url} alt={review.profiles.username} />
              : <span>{getInitials(review.profiles?.username ?? '?')}</span>
            }
          </div>
          <span class="author-username">@{review.profiles?.username}</span>
        </a>
        <span class="review-timestamp">{timeAgo(review.published_at ?? review.created_at)}</span>
      </div>

      {review.title && <h1 class="review-title">{review.title}</h1>}

      <div class={`review-body-full ${review.contains_spoilers ? 'spoiler-hidden' : ''}`} data-spoiler={review.contains_spoilers ? 'true' : 'false'}>
        {review.contains_spoilers && (
          <div class="spoiler-notice">⚠ Spoilers — click anywhere to reveal</div>
        )}
        <div class="review-text">{review.body}</div>
      </div>

      <div class="review-actions">
        <button class={`vote-btn${myVote === 1 ? ' active-up' : ''}`} data-review-id={review.id} data-vote="1" data-count={up}>▲ {up}</button>
        <button class={`vote-btn${myVote === -1 ? ' active-down' : ''}`} data-review-id={review.id} data-vote="-1" data-count={down}>▼ {down}</button>

        <span class="rv-sep"></span>

        <div class="rv-reaction-wrap" data-review-id={review.id}>
          {displayReactions.map(r => (
            <button
              class={`rv-reaction-btn${r.active ? ' reaction-active' : ''}`}
              data-review-id={review.id}
              data-reaction={r.type}
              data-display={r.display}
              data-reacted={r.active ? 'true' : 'false'}
              data-count={r.count}
              data-logged-in={isLoggedIn ? 'true' : 'false'}
              data-is-image={r.isImage ? 'true' : 'false'}
            >
              {r.isImage
                ? <><img src={r.path!} class="rv-emote-img" alt={r.type} />{' '}{r.count}</>
                : <>{r.display} {r.count}</>}
            </button>
          ))}
          <button class="rv-reaction-toggle" data-toggle-review-id={review.id} data-logged-in={isLoggedIn ? 'true' : 'false'} title="React">+</button>
        </div>

        {isLoggedIn && (
          <button class="report-trigger" onclick={`openReport('review','${review.id}')`} title="Report this review">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 2h10l-2 4 2 4H3V2z"/><path d="M3 14v-4"/>
            </svg>
            Report
          </button>
        )}
      </div>
    </article>

    <!-- COMMENTS -->
    <section class="comments-section">
      <h2 class="comments-heading">
        Comments
        {allComments.length > 0 && <span class="comment-count">{allComments.length}</span>}
      </h2>

      {allComments.length === 0 && (
        <div class="no-comments">No comments yet. {isLoggedIn ? 'Be the first!' : ''}</div>
      )}

      <div class="comment-list" id="commentList">
        {topLevelComments.map((c: any) => {
          const level1Replies = directReplyMap[c.id] ?? [];
          const cvArr = Array.isArray(c.comment_votes) ? c.comment_votes : c.comment_votes ? [c.comment_votes] : [];
          const cUp = cvArr.filter((v: any) => v.vote === 1).length;
          const cDown = cvArr.filter((v: any) => v.vote === -1).length;
          const cMyVote = currentProfile ? (cvArr.find((v: any) => v.profile_id === currentProfile!.id)?.vote ?? 0) : 0;
          const isOwnC = currentProfile?.id === c.profiles?.id;
          return (
            <div class="comment-thread" data-thread-id={c.id}>
              <div class="comment" data-comment-id={c.id}>
                <a href={`/reviewers/${c.profiles?.username}`} class="comment-avatar">
                  {c.profiles?.avatar_url
                    ? <img src={c.profiles.avatar_url} alt={c.profiles.username} />
                    : <span>{getInitials(c.profiles?.username ?? '?')}</span>
                  }
                </a>
                <div class="comment-body">
                  <div class="comment-meta">
                    <a href={`/reviewers/${c.profiles?.username}`} class="comment-username">@{c.profiles?.username}</a>
                    <span class="comment-time">{timeAgo(c.created_at)}</span>
                    {c.updated_at && <span class="comment-edited">(edited)</span>}
                  </div>
                  <div class="comment-text" data-raw-body={c.body} set:html={renderBody(c.body)}></div>
                  <div class="comment-actions">
                    <button class={`cvote-btn${cMyVote === 1 ? ' cvote-up' : ''}`} data-comment-id={c.id} data-vote="1" data-logged-in={isLoggedIn ? 'true' : 'false'}>▲ {cUp}</button>
                    <button class={`cvote-btn${cMyVote === -1 ? ' cvote-down' : ''}`} data-comment-id={c.id} data-vote="-1" data-logged-in={isLoggedIn ? 'true' : 'false'}>▼ {cDown}</button>
                    {(getCommentReactions(c).length > 0 || isLoggedIn) && (
                      <div class="crx-wrap" data-comment-id={c.id}>
                        {getCommentReactions(c).map((rx: any) => (
                          <button
                            class={`crx-btn${rx.active ? ' crx-active' : ''}`}
                            data-comment-id={c.id}
                            data-reaction={rx.type}
                            data-reacted={rx.active ? 'true' : 'false'}
                            data-count={rx.count}
                            data-logged-in={isLoggedIn ? 'true' : 'false'}
                            data-is-image={rx.isImage ? 'true' : 'false'}
                          >
                            {rx.isImage
                              ? <><img src={rx.path!} class="crx-emote-img" alt={rx.type} />{' '}{rx.count}</>
                              : <>{rx.display} {rx.count}</>}
                          </button>
                        ))}
                        {isLoggedIn && <button class="crx-toggle" data-toggle-comment-id={c.id} data-logged-in="true" title="React">+</button>}
                      </div>
                    )}
                    {isLoggedIn && <button class="comment-reply-btn" data-parent-id={c.id} data-thread-id={c.id} data-reply-to={c.profiles?.username} type="button">↩ Reply</button>}
                    {isLoggedIn && !isOwnC && <button class="comment-report-btn" onclick={`openReport('comment','${c.id}')`}>Report</button>}
                    {isOwnC && <button class="comment-edit-btn" data-comment-id={c.id} type="button" title="Edit comment"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>}
                    {isOwnC && <button class="comment-delete-btn" data-comment-id={c.id} type="button" title="Delete comment"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg></button>}
                  </div>
                </div>
              </div>

              <div class="replies" data-replies-for={c.id}>
                {level1Replies.map((r: any) => {
                  const level2Replies = directReplyMap[r.id] ?? [];
                  const rArr = Array.isArray(r.comment_votes) ? r.comment_votes : r.comment_votes ? [r.comment_votes] : [];
                  const rUp = rArr.filter((v: any) => v.vote === 1).length;
                  const rDown = rArr.filter((v: any) => v.vote === -1).length;
                  const rMyVote = currentProfile ? (rArr.find((v: any) => v.profile_id === currentProfile!.id)?.vote ?? 0) : 0;
                  const isOwnR = currentProfile?.id === r.profiles?.id;
                  return (
                    <Fragment>
                      <div class="comment comment-reply" data-comment-id={r.id}>
                        <a href={`/reviewers/${r.profiles?.username}`} class="comment-avatar comment-avatar-sm">
                          {r.profiles?.avatar_url
                            ? <img src={r.profiles.avatar_url} alt={r.profiles.username} />
                            : <span>{getInitials(r.profiles?.username ?? '?')}</span>
                          }
                        </a>
                        <div class="comment-body">
                          <div class="comment-meta">
                            <a href={`/reviewers/${r.profiles?.username}`} class="comment-username">@{r.profiles?.username}</a>
                            <span class="comment-time">{timeAgo(r.created_at)}</span>
                            {r.updated_at && <span class="comment-edited">(edited)</span>}
                          </div>
                          <div class="comment-text" data-raw-body={r.body} set:html={renderBody(r.body)}></div>
                          <div class="comment-actions">
                            <button class={`cvote-btn${rMyVote === 1 ? ' cvote-up' : ''}`} data-comment-id={r.id} data-vote="1" data-logged-in={isLoggedIn ? 'true' : 'false'}>▲ {rUp}</button>
                            <button class={`cvote-btn${rMyVote === -1 ? ' cvote-down' : ''}`} data-comment-id={r.id} data-vote="-1" data-logged-in={isLoggedIn ? 'true' : 'false'}>▼ {rDown}</button>
                            {(getCommentReactions(r).length > 0 || isLoggedIn) && (
                              <div class="crx-wrap" data-comment-id={r.id}>
                                {getCommentReactions(r).map((rx: any) => (
                                  <button
                                    class={`crx-btn${rx.active ? ' crx-active' : ''}`}
                                    data-comment-id={r.id}
                                    data-reaction={rx.type}
                                    data-reacted={rx.active ? 'true' : 'false'}
                                    data-count={rx.count}
                                    data-logged-in={isLoggedIn ? 'true' : 'false'}
                                    data-is-image={rx.isImage ? 'true' : 'false'}
                                  >
                                    {rx.isImage
                                      ? <><img src={rx.path!} class="crx-emote-img" alt={rx.type} />{' '}{rx.count}</>
                                      : <>{rx.display} {rx.count}</>}
                                  </button>
                                ))}
                                {isLoggedIn && <button class="crx-toggle" data-toggle-comment-id={r.id} data-logged-in="true" title="React">+</button>}
                              </div>
                            )}
                            {isLoggedIn && <button class="comment-reply-btn" data-parent-id={r.id} data-thread-id={c.id} data-reply-to={r.profiles?.username} type="button">↩ Reply</button>}
                            {isLoggedIn && !isOwnR && <button class="comment-report-btn" onclick={`openReport('comment','${r.id}')`}>Report</button>}
                            {isOwnR && <button class="comment-edit-btn" data-comment-id={r.id} type="button" title="Edit comment"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>}
                            {isOwnR && <button class="comment-delete-btn" data-comment-id={r.id} type="button" title="Delete comment"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg></button>}
                          </div>
                        </div>
                      </div>
                      {level2Replies.length > 0 && (
                        <div class="replies replies-deep" data-replies-for={r.id}>
                          {level2Replies.map((dr: any) => {
                            const drArr = Array.isArray(dr.comment_votes) ? dr.comment_votes : dr.comment_votes ? [dr.comment_votes] : [];
                            const drUp = drArr.filter((v: any) => v.vote === 1).length;
                            const drDown = drArr.filter((v: any) => v.vote === -1).length;
                            const drMyVote = currentProfile ? (drArr.find((v: any) => v.profile_id === currentProfile!.id)?.vote ?? 0) : 0;
                            const isOwnDr = currentProfile?.id === dr.profiles?.id;
                            return (
                              <div class="comment comment-reply" data-comment-id={dr.id}>
                                <a href={`/reviewers/${dr.profiles?.username}`} class="comment-avatar comment-avatar-sm">
                                  {dr.profiles?.avatar_url
                                    ? <img src={dr.profiles.avatar_url} alt={dr.profiles.username} />
                                    : <span>{getInitials(dr.profiles?.username ?? '?')}</span>
                                  }
                                </a>
                                <div class="comment-body">
                                  <div class="comment-meta">
                                    <a href={`/reviewers/${dr.profiles?.username}`} class="comment-username">@{dr.profiles?.username}</a>
                                    <span class="comment-time">{timeAgo(dr.created_at)}</span>
                                    {dr.updated_at && <span class="comment-edited">(edited)</span>}
                                  </div>
                                  <div class="comment-text" data-raw-body={dr.body} set:html={renderBody(dr.body)}></div>
                                  <div class="comment-actions">
                                    <button class={`cvote-btn${drMyVote === 1 ? ' cvote-up' : ''}`} data-comment-id={dr.id} data-vote="1" data-logged-in={isLoggedIn ? 'true' : 'false'}>▲ {drUp}</button>
                                    <button class={`cvote-btn${drMyVote === -1 ? ' cvote-down' : ''}`} data-comment-id={dr.id} data-vote="-1" data-logged-in={isLoggedIn ? 'true' : 'false'}>▼ {drDown}</button>
                                    {(getCommentReactions(dr).length > 0 || isLoggedIn) && (
                                      <div class="crx-wrap" data-comment-id={dr.id}>
                                        {getCommentReactions(dr).map((rx: any) => (
                                          <button
                                            class={`crx-btn${rx.active ? ' crx-active' : ''}`}
                                            data-comment-id={dr.id}
                                            data-reaction={rx.type}
                                            data-reacted={rx.active ? 'true' : 'false'}
                                            data-count={rx.count}
                                            data-logged-in={isLoggedIn ? 'true' : 'false'}
                                            data-is-image={rx.isImage ? 'true' : 'false'}
                                          >
                                            {rx.isImage
                                              ? <><img src={rx.path!} class="crx-emote-img" alt={rx.type} />{' '}{rx.count}</>
                                              : <>{rx.display} {rx.count}</>}
                                          </button>
                                        ))}
                                        {isLoggedIn && <button class="crx-toggle" data-toggle-comment-id={dr.id} data-logged-in="true" title="React">+</button>}
                                      </div>
                                    )}
                                    {isLoggedIn && <button class="comment-reply-btn" data-parent-id={dr.id} data-thread-id={c.id} data-reply-to={dr.profiles?.username} type="button">↩ Reply</button>}
                                    {isLoggedIn && !isOwnDr && <button class="comment-report-btn" onclick={`openReport('comment','${dr.id}')`}>Report</button>}
                                    {isOwnDr && <button class="comment-edit-btn" data-comment-id={dr.id} type="button" title="Edit comment"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>}
                                    {isOwnDr && <button class="comment-delete-btn" data-comment-id={dr.id} type="button" title="Delete comment"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg></button>}
                                  </div>
                                </div>
                              </div>
                            );
                          })}
                        </div>
                      )}
                    </Fragment>
                  );
                })}
              </div>

              {isLoggedIn && (
                <div class="reply-form-wrap" id={`reply-form-${c.id}`} style="display:none">
                  <div class="reply-form-inner">
                    <div class="comment-avatar comment-avatar-sm">
                      {currentProfile?.avatar_url
                        ? <img src={currentProfile.avatar_url} alt={currentProfile.username} />
                        : <span>{getInitials(currentProfile?.username ?? '?')}</span>
                      }
                    </div>
                    <div class="reply-input-wrap">
                      <textarea class="reply-body" placeholder="Write a reply…" maxlength="2000" rows="2"></textarea>
                      <div class="reply-form-footer">
                        <span class="reply-char-count"><span class="reply-char-num">0</span> / 2000</span>
                        <button class="reply-cancel-btn" type="button">Cancel</button>
                        <button type="button" class="comment-emote-btn" title="Insert emote">
                          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6"/><path d="M5.5 10c.7.8 4.3.8 5 0"/><circle cx="6" cy="6.5" r=".7" fill="currentColor" stroke="none"/><circle cx="10" cy="6.5" r=".7" fill="currentColor" stroke="none"/></svg>
                        </button>
                        <button class="reply-submit-btn" type="button" data-parent-id={c.id} data-review-id={id}>Reply</button>
                      </div>
                    </div>
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </div>

      {isLoggedIn ? (
        <form class="comment-form" id="commentForm">
          <div class="comment-input-row">
            <div class="comment-form-avatar">
              {currentProfile?.avatar_url
                ? <img src={currentProfile.avatar_url} alt={currentProfile.username} />
                : <span>{getInitials(currentProfile?.username ?? '?')}</span>
              }
            </div>
            <div class="comment-input-wrap">
              <textarea
                id="commentBody"
                placeholder="Write a comment…"
                maxlength="2000"
                rows={3}
              ></textarea>
              <div class="comment-form-footer">
                <span class="comment-char-count"><span id="commentCharCount">0</span> / 2000</span>
                <button type="button" class="comment-emote-btn" title="Insert emote">
                  <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6"/><path d="M5.5 10c.7.8 4.3.8 5 0"/><circle cx="6" cy="6.5" r=".7" fill="currentColor" stroke="none"/><circle cx="10" cy="6.5" r=".7" fill="currentColor" stroke="none"/></svg>
                </button>
                <button type="submit" class="comment-submit" id="commentSubmit">Post comment</button>
              </div>
            </div>
          </div>
          <div class="comment-error" id="commentError" style="display:none"></div>
        </form>
      ) : (
        <div class="comment-signin-prompt">
          <a href="/signin">Sign in</a> to leave a comment.
        </div>
      )}
    </section>
  </main>

  <div slot="sidebar-right">
    <div class="widget">
      <div class="widget-title">About this game</div>
      <a href={`/games/${review.games?.slug}`} style="display:flex;gap:12px;align-items:flex-start;text-decoration:none">
        <div style="flex-shrink:0;width:52px;height:70px;border-radius:8px;overflow:hidden;background:var(--tag-bg);border:1px solid var(--border)">
          {coverBig
            ? <img src={coverBig} alt={review.games?.title} style="width:100%;height:100%;object-fit:cover" />
            : <span style="display:flex;align-items:center;justify-content:center;height:100%;font-size:22px">🎮</span>
          }
        </div>
        <div style="flex:1;min-width:0">
          <div style="font-size:13px;font-weight:500;line-height:1.3;margin-bottom:6px">{review.games?.title}</div>
          <div style="font-size:12px;color:var(--text-tertiary)">View all reviews →</div>
        </div>
      </a>
    </div>

    <div class="widget">
      <div class="widget-title">Reviewer</div>
      <a href={`/reviewers/${review.profiles?.username}`} style="display:flex;gap:12px;align-items:center;text-decoration:none">
        <div class="sidebar-reviewer-avatar">
          {review.profiles?.avatar_url
            ? <img src={review.profiles.avatar_url} alt={review.profiles.username} />
            : <span>{getInitials(review.profiles?.username ?? '?')}</span>
          }
        </div>
        <div>
          <div style="font-size:13px;font-weight:500">@{review.profiles?.username}</div>
          <div style="font-size:12px;color:var(--text-tertiary)">View profile →</div>
        </div>
      </a>
    </div>

    {moreReviews && moreReviews.length > 0 && (
      <div class="widget">
        <div class="widget-title">More from this reviewer</div>
        <div style="display:flex;flex-direction:column;gap:12px">
          {moreReviews.map((r: any) => (
            <a href={`/reviews/${r.id}`} class="more-review-item">
              <div class="more-review-cover">
                {r.games?.cover_img_url
                  ? <img src={igdbImage(r.games.cover_img_url, 't_thumb') ?? ''} alt={r.games.title} />
                  : <span>🎮</span>
                }
              </div>
              <div class="more-review-info">
                <div class="more-review-game">{r.games?.title}</div>
                {r.title && <div class="more-review-title">{r.title}</div>}
              </div>
              <div class={`more-review-score ${scoreColor(r.score)}`}>{r.score}</div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

  <ReportModal />

  <script is:inline define:vars={{ rvEmojiCategories: EMOJI_CATEGORIES, rvImageEmotes: IMAGE_EMOTES, rvImageEmoteMap: IMAGE_EMOTE_MAP }}>
    // ── Emoji picker (shared with ReviewCard if present, otherwise created here) ──
    if (!window.__rcPickerInit) {
      window.__rcPickerInit = true;
      var picker = document.createElement('div');
      picker.id = 'rc-emoji-picker';
      picker.style.cssText = 'display:none;position:fixed;z-index:1000';
      var ph = '<div class="rc-emoji-title">React</div>';
      ph += '<div class="rc-emoji-cat"><div class="rc-emoji-cat-label">Emotes</div><div class="rc-emoji-grid rc-emote-grid">';
      rvImageEmotes.forEach(function(emote) {
        ph += '<button class="rc-emoji-pick rc-emote-pick" data-emoji="' + emote.key + '" title="' + emote.key + '"><img src="' + emote.path + '" class="rc-emote-picker-img" alt="' + emote.key + '"></button>';
      });
      ph += '</div></div>';
      rvEmojiCategories.forEach(function(cat) {
        ph += '<div class="rc-emoji-cat"><div class="rc-emoji-cat-label">' + cat.label + '</div><div class="rc-emoji-grid">';
        cat.emojis.forEach(function(emoji) {
          ph += '<button class="rc-emoji-pick" data-emoji="' + emoji + '">' + emoji + '</button>';
        });
        ph += '</div></div>';
      });
      picker.innerHTML = ph;
      document.body.appendChild(picker);
    }

    function rvEmoteHTML(key, count) {
      var path = rvImageEmoteMap[key];
      return '<img src="' + path + '" class="rv-emote-img" alt="' + key + '"> ' + count;
    }

    function rvApplyReaction(reviewId, reactionType, reacted, count) {
      var isImage = !!rvImageEmoteMap[reactionType];
      var updated = false;
      document.querySelectorAll('.rv-reaction-btn[data-review-id="' + reviewId + '"][data-reaction="' + reactionType + '"]').forEach(function(btn) {
        btn.dataset.reacted = reacted ? 'true' : 'false';
        btn.dataset.count = String(count);
        if (isImage) { btn.innerHTML = rvEmoteHTML(reactionType, count); }
        else { btn.textContent = reactionType + ' ' + count; }
        btn.classList.toggle('reaction-active', reacted);
        btn.style.display = count > 0 ? '' : 'none';
        updated = true;
      });
      if (!updated && count > 0) {
        var wrap = document.querySelector('.rv-reaction-wrap[data-review-id="' + reviewId + '"]');
        if (wrap) {
          var toggleBtn = wrap.querySelector('.rv-reaction-toggle');
          var newBtn = document.createElement('button');
          newBtn.className = 'rv-reaction-btn' + (reacted ? ' reaction-active' : '');
          newBtn.dataset.reviewId = reviewId;
          newBtn.dataset.reaction = reactionType;
          newBtn.dataset.reacted = reacted ? 'true' : 'false';
          newBtn.dataset.count = String(count);
          newBtn.dataset.loggedIn = 'true';
          newBtn.dataset.isImage = isImage ? 'true' : 'false';
          if (isImage) { newBtn.innerHTML = rvEmoteHTML(reactionType, count); }
          else { newBtn.textContent = reactionType + ' ' + count; }
          wrap.insertBefore(newBtn, toggleBtn);
        }
      }
    }

    function crxEmoteHTML(key, count) {
      var path = rvImageEmoteMap[key];
      return '<img src="' + path + '" class="crx-emote-img" alt="' + key + '"> ' + count;
    }

    function crxApplyReaction(commentId, reactionType, reacted, count) {
      var isImage = !!rvImageEmoteMap[reactionType];
      var updated = false;
      document.querySelectorAll('.crx-btn[data-comment-id="' + commentId + '"][data-reaction="' + reactionType + '"]').forEach(function(btn) {
        btn.dataset.reacted = reacted ? 'true' : 'false';
        btn.dataset.count = String(count);
        if (isImage) { btn.innerHTML = crxEmoteHTML(reactionType, count); }
        else { btn.textContent = reactionType + ' ' + count; }
        btn.classList.toggle('crx-active', reacted);
        btn.style.display = count > 0 ? '' : 'none';
        updated = true;
      });
      if (!updated && count > 0) {
        var wrap = document.querySelector('.crx-wrap[data-comment-id="' + commentId + '"]');
        if (wrap) {
          var toggleBtn = wrap.querySelector('.crx-toggle');
          var newBtn = document.createElement('button');
          newBtn.className = 'crx-btn' + (reacted ? ' crx-active' : '');
          newBtn.dataset.commentId = commentId;
          newBtn.dataset.reaction = reactionType;
          newBtn.dataset.reacted = reacted ? 'true' : 'false';
          newBtn.dataset.count = String(count);
          newBtn.dataset.loggedIn = 'true';
          newBtn.dataset.isImage = isImage ? 'true' : 'false';
          if (isImage) { newBtn.innerHTML = crxEmoteHTML(reactionType, count); }
          else { newBtn.textContent = reactionType + ' ' + count; }
          if (toggleBtn) { wrap.insertBefore(newBtn, toggleBtn); }
          else { wrap.appendChild(newBtn); }
        }
      }
    }

    // Share emote map with the second inline script
    window.__emoteMap = rvImageEmoteMap;

    // ── Comment emote picker ──────────────────────────────────────────────────
    if (!window.__cepInit) {
      window.__cepInit = true;
      var cep = document.createElement('div');
      cep.id = 'cep';
      cep.style.cssText = 'display:none;position:fixed;z-index:2000';
      var cepHtml = '<div class="cep-label">Emotes</div><div class="cep-grid">';
      rvImageEmotes.forEach(function(em) {
        cepHtml += '<button class="cep-btn" data-key="' + em.key + '" title=":' + em.key + ':"><img src="' + em.path + '" alt="' + em.key + '"></button>';
      });
      cepHtml += '</div>';
      cep.innerHTML = cepHtml;
      document.body.appendChild(cep);
    }

    function closeCep() {
      var p = document.getElementById('cep');
      if (p) { p.style.display = 'none'; p._ta = null; }
    }

    document.addEventListener('click', function(e) {
      var emoteBtn = e.target.closest('.comment-emote-btn');
      if (emoteBtn) {
        var p = document.getElementById('cep');
        if (!p) return;
        var wrap = emoteBtn.closest('.comment-input-wrap, .reply-input-wrap, .comment-edit-wrap');
        var ta = wrap ? wrap.querySelector('textarea') : null;
        var isOpen = p.style.display !== 'none' && p._ta === ta;
        closeCep();
        if (!isOpen && ta) {
          p._ta = ta;
          p.style.display = 'block';
          requestAnimationFrame(function() {
            var r = emoteBtn.getBoundingClientRect();
            var pr = p.getBoundingClientRect();
            var top = r.top - pr.height - 6;
            if (top < 8) top = r.bottom + 6;
            var left = r.left;
            if (left + pr.width > window.innerWidth - 8) left = window.innerWidth - pr.width - 8;
            p.style.top = top + 'px';
            p.style.left = left + 'px';
          });
        }
        return;
      }

      var cepBtn = e.target.closest('.cep-btn');
      if (cepBtn) {
        var p = document.getElementById('cep');
        var ta = p && p._ta;
        if (!ta) { closeCep(); return; }
        var code = ':' + cepBtn.dataset.key + ':';
        var start = ta.selectionStart;
        ta.value = ta.value.slice(0, start) + code + ta.value.slice(ta.selectionEnd);
        ta.selectionStart = ta.selectionEnd = start + code.length;
        ta.focus();
        ta.dispatchEvent(new Event('input'));
        closeCep();
        return;
      }

      if (!e.target.closest('#cep') && !e.target.closest('.comment-emote-btn')) {
        closeCep();
      }
    });

    function rvClosePanel() {
      var p = document.getElementById('rc-emoji-picker');
      if (p) p.style.display = 'none';
    }

    document.addEventListener('click', function(e) {
      // + toggle button
      var toggleBtn = e.target.closest('.rv-reaction-toggle');
      if (toggleBtn) {
        var reviewId = toggleBtn.dataset.toggleReviewId;
        var loggedIn = toggleBtn.dataset.loggedIn === 'true';
        var picker = document.getElementById('rc-emoji-picker');
        if (!picker) return;
        var isOpen = picker.style.display !== 'none' && picker.dataset.activeReviewId === reviewId;
        rvClosePanel();
        if (!isOpen) {
          picker.dataset.activeReviewId = reviewId;
          picker.dataset.activeLoggedIn = loggedIn ? 'true' : 'false';
          picker.dataset.activeSource = 'rv';
          picker.style.display = 'block';
          requestAnimationFrame(function() {
            var rect = toggleBtn.getBoundingClientRect();
            var pRect = picker.getBoundingClientRect();
            var top = rect.top - pRect.height - 8;
            if (top < 8) top = rect.bottom + 8;
            var left = rect.left;
            if (left + pRect.width > window.innerWidth - 8) left = window.innerWidth - pRect.width - 8;
            picker.style.top = top + 'px';
            picker.style.left = left + 'px';
            picker.querySelectorAll('.rc-emoji-pick').forEach(function(btn) {
              var inlineBtn = document.querySelector('.rv-reaction-btn[data-review-id="' + reviewId + '"][data-reaction="' + btn.dataset.emoji + '"]');
              btn.classList.toggle('rc-emoji-active', !!(inlineBtn && inlineBtn.dataset.reacted === 'true'));
            });
          });
        }
        return;
      }

      // + toggle button for comment reactions
      var crxToggleBtn = e.target.closest('.crx-toggle');
      if (crxToggleBtn) {
        var commentId = crxToggleBtn.dataset.toggleCommentId;
        var loggedIn = crxToggleBtn.dataset.loggedIn === 'true';
        var picker = document.getElementById('rc-emoji-picker');
        if (!picker) return;
        var isOpen = picker.style.display !== 'none' && picker.dataset.activeCommentId === commentId && picker.dataset.activeSource === 'crx';
        rvClosePanel();
        if (!isOpen) {
          picker.dataset.activeCommentId = commentId;
          picker.dataset.activeLoggedIn = loggedIn ? 'true' : 'false';
          picker.dataset.activeSource = 'crx';
          picker.style.display = 'block';
          requestAnimationFrame(function() {
            var rect = crxToggleBtn.getBoundingClientRect();
            var pRect = picker.getBoundingClientRect();
            var top = rect.top - pRect.height - 8;
            if (top < 8) top = rect.bottom + 8;
            var left = rect.left;
            if (left + pRect.width > window.innerWidth - 8) left = window.innerWidth - pRect.width - 8;
            picker.style.top = top + 'px';
            picker.style.left = left + 'px';
            picker.querySelectorAll('.rc-emoji-pick').forEach(function(btn) {
              var inlineBtn = document.querySelector('.crx-btn[data-comment-id="' + commentId + '"][data-reaction="' + btn.dataset.emoji + '"]');
              btn.classList.toggle('rc-emoji-active', !!(inlineBtn && inlineBtn.dataset.reacted === 'true'));
            });
          });
        }
        return;
      }

      // Pick from picker (handles rv and crx sources)
      var emojiBtn = e.target.closest('.rc-emoji-pick');
      if (emojiBtn) {
        var picker = document.getElementById('rc-emoji-picker');
        if (!picker) return;
        var source = picker.dataset.activeSource;
        if (source === 'rv') {
          var reviewId = picker.dataset.activeReviewId;
          var loggedIn = picker.dataset.activeLoggedIn === 'true';
          if (!reviewId) return;
          if (!loggedIn) { window.location.href = '/signin'; return; }
          var emoji = emojiBtn.dataset.emoji;
          var existing = document.querySelector('.rv-reaction-btn[data-review-id="' + reviewId + '"][data-reaction="' + emoji + '"]');
          var reacted = existing ? existing.dataset.reacted === 'true' : false;
          var count = existing ? (parseInt(existing.dataset.count) || 0) : 0;
          var newReacted = !reacted;
          var newCount = newReacted ? count + 1 : Math.max(0, count - 1);
          rvApplyReaction(reviewId, emoji, newReacted, newCount);
          rvClosePanel();
          fetch('/api/reviews/react', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ review_id: reviewId, reaction_type: emoji }),
          }).then(function(res) {
            if (res.status === 401) { window.location.href = '/signin'; return; }
            return res.json();
          }).then(function(data) {
            if (data) rvApplyReaction(reviewId, emoji, data.reacted, data.count);
          }).catch(function() {
            rvApplyReaction(reviewId, emoji, reacted, count);
          });
          return;
        }
        if (source === 'crx') {
          var commentId = picker.dataset.activeCommentId;
          var loggedIn = picker.dataset.activeLoggedIn === 'true';
          if (!commentId) return;
          if (!loggedIn) { window.location.href = '/signin'; return; }
          var emoji = emojiBtn.dataset.emoji;
          var existing = document.querySelector('.crx-btn[data-comment-id="' + commentId + '"][data-reaction="' + emoji + '"]');
          var reacted = existing ? existing.dataset.reacted === 'true' : false;
          var count = existing ? (parseInt(existing.dataset.count) || 0) : 0;
          var newReacted = !reacted;
          var newCount = newReacted ? count + 1 : Math.max(0, count - 1);
          crxApplyReaction(commentId, emoji, newReacted, newCount);
          rvClosePanel();
          fetch('/api/comments/react', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ comment_id: commentId, reaction_type: emoji }),
          }).then(function(res) {
            if (res.status === 401) { window.location.href = '/signin'; return; }
            return res.json();
          }).then(function(data) {
            if (data) crxApplyReaction(commentId, emoji, data.reacted, data.count);
          }).catch(function() {
            crxApplyReaction(commentId, emoji, reacted, count);
          });
          return;
        }
        return;
      }

      // Inline reaction button click
      var reactionBtn = e.target.closest('.rv-reaction-btn');
      if (reactionBtn) {
        if (reactionBtn.dataset.loggedIn !== 'true') { window.location.href = '/signin'; return; }
        var reviewId = reactionBtn.dataset.reviewId;
        var reaction = reactionBtn.dataset.reaction;
        var reacted = reactionBtn.dataset.reacted === 'true';
        var count = parseInt(reactionBtn.dataset.count) || 0;
        var newReacted = !reacted;
        var newCount = newReacted ? count + 1 : Math.max(0, count - 1);
        rvApplyReaction(reviewId, reaction, newReacted, newCount);
        fetch('/api/reviews/react', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ review_id: reviewId, reaction_type: reaction }),
        }).then(function(res) {
          if (res.status === 401) { window.location.href = '/signin'; return; }
          return res.json();
        }).then(function(data) {
          if (data) rvApplyReaction(reviewId, reaction, data.reacted, data.count);
        }).catch(function() {
          rvApplyReaction(reviewId, reaction, reacted, count);
        });
        return;
      }

      // Inline comment reaction button click
      var crxBtn = e.target.closest('.crx-btn');
      if (crxBtn) {
        if (crxBtn.dataset.loggedIn !== 'true') { window.location.href = '/signin'; return; }
        var commentId = crxBtn.dataset.commentId;
        var reaction = crxBtn.dataset.reaction;
        var reacted = crxBtn.dataset.reacted === 'true';
        var count = parseInt(crxBtn.dataset.count) || 0;
        var newReacted = !reacted;
        var newCount = newReacted ? count + 1 : Math.max(0, count - 1);
        crxApplyReaction(commentId, reaction, newReacted, newCount);
        fetch('/api/comments/react', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ comment_id: commentId, reaction_type: reaction }),
        }).then(function(res) {
          if (res.status === 401) { window.location.href = '/signin'; return; }
          return res.json();
        }).then(function(data) {
          if (data) crxApplyReaction(commentId, reaction, data.reacted, data.count);
        }).catch(function() {
          crxApplyReaction(commentId, reaction, reacted, count);
        });
        return;
      }

      // Outside click: close picker
      if (!e.target.closest('.rv-reaction-wrap') && !e.target.closest('#rc-emoji-picker') && !e.target.closest('.crx-wrap')) {
        rvClosePanel();
      }
    });
  </script>

  <script is:inline>
    // Spoiler reveal
    var spoilerEl = document.querySelector('.review-body-full[data-spoiler="true"]');
    if (spoilerEl) {
      spoilerEl.addEventListener('click', function () {
        spoilerEl.classList.remove('spoiler-hidden');
      });
    }

    // Review votes
    document.querySelectorAll('.vote-btn').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        if (btn.disabled) return;
        btn.disabled = true;
        try {
          var reviewId = btn.dataset.reviewId;
          var vote = parseInt(btn.dataset.vote);
          var res = await fetch('/api/reviews/vote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ review_id: reviewId, vote }),
          });
          if (res.status === 401) { window.location.href = '/signin'; return; }
          if (!res.ok) return;
          var data = await res.json();
          document.querySelectorAll('.vote-btn[data-review-id="' + reviewId + '"]').forEach(function (b) {
            var bVote = parseInt(b.dataset.vote);
            b.textContent = (bVote === 1 ? '▲ ' : '▼ ') + (bVote === 1 ? data.up : data.down);
            b.classList.toggle('active-up',   bVote === 1  && data.vote === 1);
            b.classList.toggle('active-down', bVote === -1 && data.vote === -1);
          });
        } finally { btn.disabled = false; }
      });
    });

    // Comment votes (delegated)
    document.addEventListener('click', async function(e) {
      var btn = e.target.closest('.cvote-btn');
      if (!btn) return;
      if (btn.dataset.loggedIn !== 'true') { window.location.href = '/signin'; return; }
      if (btn.disabled) return;
      btn.disabled = true;
      try {
        var commentId = btn.dataset.commentId;
        var vote = parseInt(btn.dataset.vote);
        var res = await fetch('/api/comments/vote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ comment_id: commentId, vote }),
        });
        if (res.status === 401) { window.location.href = '/signin'; return; }
        if (!res.ok) return;
        var data = await res.json();
        document.querySelectorAll('.cvote-btn[data-comment-id="' + commentId + '"]').forEach(function(b) {
          var bVote = parseInt(b.dataset.vote);
          b.textContent = (bVote === 1 ? '▲ ' : '▼ ') + (bVote === 1 ? data.up : data.down);
          b.classList.toggle('cvote-up',   bVote === 1  && data.vote === 1);
          b.classList.toggle('cvote-down', bVote === -1 && data.vote === -1);
        });
      } finally { btn.disabled = false; }
    });

    // ── Comment interactions (delegated) ────────────────────────────────────
    var EMOTE_BTN_HTML = '<button type="button" class="comment-emote-btn" title="Insert emote"><svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6"/><path d="M5.5 10c.7.8 4.3.8 5 0"/><circle cx="6" cy="6.5" r=".7" fill="currentColor" stroke="none"/><circle cx="10" cy="6.5" r=".7" fill="currentColor" stroke="none"/></svg></button>';

    function renderBody(text) {
      var esc = text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      var withMentions = esc.replace(/(^|\s)(@([\w]+))/g, function(m, pre, mention, username) {
        return pre + '<a class="mention" href="/reviewers/' + username + '">' + mention + '</a>';
      });
      var emoteMap = window.__emoteMap || {};
      return withMentions.replace(/:([A-Za-z0-9_]+):/g, function(match, key) {
        var path = emoteMap[key];
        return path ? '<img src="' + path + '" class="comment-emote" alt=":' + key + ':" title=":' + key + ':">' : match;
      });
    }

    document.addEventListener('click', async function(e) {
      // ── Edit button
      var editBtn = e.target.closest('.comment-edit-btn');
      if (editBtn) {
        var commentId = editBtn.dataset.commentId;
        var commentEl = document.querySelector('.comment[data-comment-id="' + commentId + '"]');
        if (!commentEl) return;
        var textEl = commentEl.querySelector('.comment-text');
        var existing = commentEl.querySelector('.comment-edit-wrap');
        if (existing) { existing.remove(); textEl.style.display = ''; return; }
        var rawBody = textEl.dataset.rawBody || textEl.textContent;
        textEl.style.display = 'none';
        var editWrap = document.createElement('div');
        editWrap.className = 'comment-edit-wrap';
        editWrap.innerHTML =
          '<textarea class="comment-edit-body" maxlength="2000" rows="3">' + rawBody.replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</textarea>' +
          '<div class="comment-edit-footer">' +
            '<span class="comment-edit-char"><span class="comment-edit-char-num">' + rawBody.length + '</span> / 2000</span>' +
            '<button class="comment-edit-cancel-btn" type="button">Cancel</button>' +
            EMOTE_BTN_HTML +
            '<button class="comment-edit-save-btn" type="button" data-comment-id="' + commentId + '">Save</button>' +
          '</div>';
        textEl.after(editWrap);
        editWrap.querySelector('textarea').focus();
        return;
      }

      // ── Edit cancel
      var cancelEditBtn = e.target.closest('.comment-edit-cancel-btn');
      if (cancelEditBtn) {
        var editWrap = cancelEditBtn.closest('.comment-edit-wrap');
        var commentEl = editWrap.closest('.comment');
        commentEl.querySelector('.comment-text').style.display = '';
        editWrap.remove();
        return;
      }

      // ── Edit save
      var saveBtn = e.target.closest('.comment-edit-save-btn');
      if (saveBtn) {
        var commentId = saveBtn.dataset.commentId;
        var editWrap = saveBtn.closest('.comment-edit-wrap');
        var ta = editWrap.querySelector('textarea');
        var body = ta.value.trim();
        if (!body) return;
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving…';
        try {
          var res = await fetch('/api/comments/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ comment_id: commentId, body }),
          });
          if (res.status === 401) { window.location.href = '/signin'; return; }
          var data = await res.json();
          if (!res.ok) { alert(data.error || 'Failed to update comment.'); return; }
          var commentEl = document.querySelector('.comment[data-comment-id="' + commentId + '"]');
          var textEl = commentEl.querySelector('.comment-text');
          textEl.innerHTML = renderBody(body);
          textEl.dataset.rawBody = body;
          textEl.style.display = '';
          editWrap.remove();
          var metaEl = commentEl.querySelector('.comment-meta');
          if (!metaEl.querySelector('.comment-edited')) {
            var editedSpan = document.createElement('span');
            editedSpan.className = 'comment-edited';
            editedSpan.textContent = '(edited)';
            metaEl.appendChild(editedSpan);
          }
        } finally {
          if (saveBtn.isConnected) { saveBtn.disabled = false; saveBtn.textContent = 'Save'; }
        }
        return;
      }

      // ── Delete button
      var deleteBtn = e.target.closest('.comment-delete-btn');
      if (deleteBtn) {
        if (!confirm('Delete this comment?')) return;
        var commentId = deleteBtn.dataset.commentId;
        deleteBtn.disabled = true;
        try {
          var res = await fetch('/api/comments/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ comment_id: commentId }),
          });
          if (res.status === 401) { window.location.href = '/signin'; return; }
          var data = await res.json();
          if (!res.ok) { alert(data.error || 'Failed to delete comment.'); return; }
          var commentEl = document.querySelector('.comment[data-comment-id="' + commentId + '"]');
          if (commentEl) {
            var deepReplies = commentEl.parentElement && commentEl.parentElement.querySelector('.replies-deep[data-replies-for="' + commentId + '"]');
            if (deepReplies) deepReplies.remove();
            commentEl.remove();
          }
        } finally {
          if (deleteBtn.isConnected) deleteBtn.disabled = false;
        }
        return;
      }

      // ── Toggle reply form
      var replyBtn = e.target.closest('.comment-reply-btn');
      if (replyBtn) {
        var parentId = replyBtn.dataset.parentId;
        var threadId = replyBtn.dataset.threadId || parentId;
        var replyTo = replyBtn.dataset.replyTo;
        var wrap = document.getElementById('reply-form-' + threadId);
        if (!wrap) return;
        var isOpen = wrap.style.display !== 'none';
        document.querySelectorAll('.reply-form-wrap').forEach(function(w) { w.style.display = 'none'; });
        if (!isOpen) {
          var sb = wrap.querySelector('.reply-submit-btn');
          if (sb) sb.dataset.parentId = parentId;
          wrap.style.display = 'block';
          var ta = wrap.querySelector('textarea');
          if (ta) {
            ta.value = replyTo ? '@' + replyTo + ' ' : '';
            ta.focus();
            ta.setSelectionRange(ta.value.length, ta.value.length);
            var counter = wrap.querySelector('.reply-char-num');
            if (counter) counter.textContent = ta.value.length;
          }
        }
        return;
      }

      // ── Cancel reply form
      var cancelBtn = e.target.closest('.reply-cancel-btn');
      if (cancelBtn) {
        var wrap = cancelBtn.closest('.reply-form-wrap');
        wrap.style.display = 'none';
        var ta = wrap.querySelector('textarea');
        if (ta) { ta.value = ''; }
        var counter = wrap.querySelector('.reply-char-num');
        if (counter) counter.textContent = '0';
        return;
      }

      // ── Submit reply
      var submitBtn = e.target.closest('.reply-submit-btn');
      if (!submitBtn) return;
      var parentId = submitBtn.dataset.parentId;
      var reviewId = submitBtn.dataset.reviewId;
      var wrap = submitBtn.closest('.reply-form-wrap');
      var threadId = wrap.id.replace('reply-form-', '');
      var ta = wrap.querySelector('textarea');
      var body = ta.value.trim();
      if (!body) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Posting…';
      try {
        var res = await fetch('/api/comments/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ review_id: reviewId, parent_id: parentId, body }),
        });
        var data = await res.json();
        if (!res.ok) { alert(data.error || 'Failed to post reply.'); return; }

        var c = data.comment;
        var p = c.profiles;
        var initials = p?.username ? p.username.slice(0, 2).toUpperCase() : '?';
        var avatarHtml = p?.avatar_url
          ? '<img src="' + p.avatar_url + '" alt="" style="display:block;width:26px;height:26px;object-fit:cover;" />'
          : '<span>' + initials + '</span>';

        var replyEl = document.createElement('div');
        replyEl.className = 'comment comment-reply';
        replyEl.dataset.commentId = c.id;
        replyEl.innerHTML =
          '<a href="/reviewers/' + (p?.username ?? '') + '" class="comment-avatar comment-avatar-sm">' + avatarHtml + '</a>' +
          '<div class="comment-body">' +
            '<div class="comment-meta">' +
              '<a href="/reviewers/' + (p?.username ?? '') + '" class="comment-username">@' + (p?.username ?? '') + '</a>' +
              '<span class="comment-time">just now</span>' +
            '</div>' +
            '<div class="comment-text" data-raw-body="' + (c?.body ?? '').replace(/"/g,'&quot;') + '">' + renderBody(c?.body ?? '') + '</div>' +
            '<div class="comment-actions">' +
              '<button class="cvote-btn" data-comment-id="' + c.id + '" data-vote="1" data-logged-in="true">▲ 0</button>' +
              '<button class="cvote-btn" data-comment-id="' + c.id + '" data-vote="-1" data-logged-in="true">▼ 0</button>' +
              '<button class="comment-reply-btn" data-parent-id="' + c.id + '" data-thread-id="' + threadId + '" data-reply-to="' + (p?.username ?? '') + '" type="button">↩ Reply</button>' +
              '<button class="comment-edit-btn" data-comment-id="' + c.id + '" type="button" title="Edit comment"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>' +
              '<button class="comment-delete-btn" data-comment-id="' + c.id + '" type="button" title="Delete comment"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg></button>' +
            '</div>' +
          '</div>';

        var container;
        if (parentId === threadId) {
          container = document.querySelector('.replies[data-replies-for="' + threadId + '"]:not(.replies-deep)');
        } else {
          container = document.querySelector('.replies-deep[data-replies-for="' + parentId + '"]');
          if (!container) {
            container = document.createElement('div');
            container.className = 'replies replies-deep';
            container.dataset.repliesFor = parentId;
            var parentCommentEl = document.querySelector('.comment[data-comment-id="' + parentId + '"]');
            if (parentCommentEl) {
              parentCommentEl.after(container);
            } else {
              container = document.querySelector('.replies[data-replies-for="' + threadId + '"]:not(.replies-deep)');
            }
          }
        }
        if (container) container.appendChild(replyEl);

        wrap.style.display = 'none';
        ta.value = '';
        var counter = wrap.querySelector('.reply-char-num');
        if (counter) counter.textContent = '0';

        document.querySelector('.no-comments')?.remove();
      } catch(err) {
        alert('Something went wrong. Please try again.');
        console.error('[reply submit]', err);
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Reply';
      }
    });

    // Char count for reply and edit textareas
    document.addEventListener('input', function(e) {
      if (e.target.classList.contains('reply-body')) {
        var wrap = e.target.closest('.reply-form-wrap');
        var counter = wrap && wrap.querySelector('.reply-char-num');
        if (counter) counter.textContent = e.target.value.length;
      }
      if (e.target.classList.contains('comment-edit-body')) {
        var wrap = e.target.closest('.comment-edit-wrap');
        var counter = wrap && wrap.querySelector('.comment-edit-char-num');
        if (counter) counter.textContent = e.target.value.length;
      }
    });
    // ────────────────────────────────────────────────────────────────────────

    // Main comment form
    var commentForm = document.getElementById('commentForm');
    var commentBody = document.getElementById('commentBody');
    var commentSubmit = document.getElementById('commentSubmit');
    var commentError = document.getElementById('commentError');
    var commentList = document.getElementById('commentList');
    var commentCharCount = document.getElementById('commentCharCount');

    if (commentBody && commentCharCount) {
      commentBody.addEventListener('input', function () {
        commentCharCount.textContent = this.value.length;
      });
    }

    if (commentForm) {
      commentForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        commentError.style.display = 'none';
        var body = commentBody.value.trim();
        if (!body) return;

        commentSubmit.disabled = true;
        commentSubmit.textContent = 'Posting…';

        try {
          var reviewId = location.pathname.split('/').pop();
          var res = await fetch('/api/comments/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ review_id: reviewId, body }),
          });

          var data = await res.json();
          if (!res.ok) {
            commentError.textContent = data.error || 'Failed to post comment.';
            commentError.style.display = 'block';
            return;
          }

          var c = data.comment;
          var p = c?.profiles;
          var initials = p?.username ? p.username.slice(0, 2).toUpperCase() : '?';
          var avatarHtml = p?.avatar_url
            ? '<img src="' + p.avatar_url + '" alt="' + (p.username ?? '') + '" style="display:block;width:32px;height:32px;object-fit:cover;" />'
            : '<span>' + initials + '</span>';

          // Build thread wrapper (includes empty replies container + reply form)
          var thread = document.createElement('div');
          thread.className = 'comment-thread';
          thread.dataset.threadId = c.id;
          thread.innerHTML =
            '<div class="comment">' +
              '<a href="/reviewers/' + (p?.username ?? '') + '" class="comment-avatar">' + avatarHtml + '</a>' +
              '<div class="comment-body">' +
                '<div class="comment-meta">' +
                  '<a href="/reviewers/' + (p?.username ?? '') + '" class="comment-username">@' + (p?.username ?? '') + '</a>' +
                  '<span class="comment-time">just now</span>' +
                '</div>' +
                '<div class="comment-text">' + renderBody(c?.body ?? '') + '</div>' +
                '<div class="comment-actions">' +
                  '<button class="cvote-btn" data-comment-id="' + (c?.id ?? '') + '" data-vote="1" data-logged-in="true">▲ 0</button>' +
                  '<button class="cvote-btn" data-comment-id="' + (c?.id ?? '') + '" data-vote="-1" data-logged-in="true">▼ 0</button>' +
                  '<button class="comment-reply-btn" data-parent-id="' + c.id + '" data-thread-id="' + c.id + '" data-reply-to="' + (p?.username ?? '') + '" type="button">↩ Reply</button>' +
                '</div>' +
              '</div>' +
            '</div>' +
            '<div class="replies" data-replies-for="' + c.id + '"></div>' +
            '<div class="reply-form-wrap" id="reply-form-' + c.id + '" style="display:none">' +
              '<div class="reply-form-inner">' +
                '<div class="comment-avatar comment-avatar-sm">' + avatarHtml.replace('32px', '26px') + '</div>' +
                '<div class="reply-input-wrap">' +
                  '<textarea class="reply-body" placeholder="Write a reply…" maxlength="2000" rows="2"></textarea>' +
                  '<div class="reply-form-footer">' +
                    '<span class="reply-char-count"><span class="reply-char-num">0</span> / 2000</span>' +
                    '<button class="reply-cancel-btn" type="button">Cancel</button>' +
                    EMOTE_BTN_HTML +
                    '<button class="reply-submit-btn" type="button" data-parent-id="' + c.id + '" data-review-id="' + reviewId + '">Reply</button>' +
                  '</div>' +
                '</div>' +
              '</div>' +
            '</div>';

          commentList.appendChild(thread);
          document.querySelector('.no-comments')?.remove();
          commentBody.value = '';
          if (commentCharCount) commentCharCount.textContent = '0';

        } catch (err) {
          commentError.textContent = 'Something went wrong. Please try again.';
          commentError.style.display = 'block';
          console.error('[comment submit]', err);
        } finally {
          commentSubmit.disabled = false;
          commentSubmit.textContent = 'Post comment';
        }
      });
    }
  </script>
</Layout>

<style is:global>
  .review-detail {
    max-width: 680px;
    padding: 24px 20px 60px;
  }

  .review-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    font-family: inherit;
    color: var(--text-tertiary);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0 0 18px;
    transition: color 0.15s;
    letter-spacing: -0.1px;
  }
  .review-back-btn:hover { color: var(--text-secondary); }

  /* ── REVIEW FULL ── */
  .review-full {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 24px;
    margin-bottom: 20px;
  }

  .review-game-bar {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .game-cover-link { flex-shrink: 0; }

  .game-cover-thumb {
    width: 48px;
    height: 64px;
    border-radius: 8px;
    object-fit: cover;
    border: 1px solid var(--border);
    display: block;
  }

  .game-cover-placeholder {
    width: 48px;
    height: 64px;
    border-radius: 8px;
    background: var(--tag-bg);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
  }

  .game-bar-info {
    flex: 1;
    min-width: 0;
  }

  .game-bar-title {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: var(--text-primary);
    display: block;
    margin-bottom: 6px;
    line-height: 1.3;
  }
  .game-bar-title:hover { text-decoration: underline; }

  .game-bar-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .meta-tag {
    font-size: 11px;
    background: var(--tag-bg);
    color: var(--tag-text);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 2px 8px;
  }

  .spoiler-tag {
    color: #f59e0b;
    border-color: rgba(245, 158, 11, 0.25);
    background: rgba(245, 158, 11, 0.06);
  }

  .score-hero {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'DM Serif Display', serif;
    font-size: 22px;
    font-weight: 700;
  }

  .review-author-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .author-link {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 0;
  }

  .author-avatar {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--tag-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: 600;
    flex-shrink: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    color: var(--text-tertiary);
  }
  .author-avatar img { width: 100%; height: 100%; object-fit: cover; }

  .author-username {
    font-size: 12px;
    font-weight: 400;
    color: var(--text-tertiary);
  }
  .author-link:hover .author-username { color: var(--text-secondary); text-decoration: underline; }

  .review-timestamp {
    font-size: 12px;
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  .review-title {
    font-family: 'DM Serif Display', serif;
    font-size: 22px;
    font-weight: 400;
    line-height: 1.35;
    margin-bottom: 14px;
    color: var(--text-primary);
  }

  .review-body-full {
    margin-bottom: 20px;
  }

  .spoiler-notice {
    display: none;
    font-size: 12px;
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.06);
    border: 1px solid rgba(245, 158, 11, 0.2);
    border-radius: 8px;
    padding: 8px 14px;
    margin-bottom: 12px;
    cursor: pointer;
    user-select: none;
  }

  .review-body-full.spoiler-hidden {
    cursor: pointer;
  }
  .review-body-full.spoiler-hidden .spoiler-notice {
    display: block;
  }
  .review-body-full.spoiler-hidden .review-text {
    filter: blur(6px);
    user-select: none;
    pointer-events: none;
    transition: filter 0.2s;
  }

  .review-text {
    font-size: 15px;
    line-height: 1.75;
    color: var(--text-primary);
    white-space: pre-wrap;
  }

  .review-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
  }

  /* ── COMMENTS ── */
  .comments-section {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 24px;
  }

  .comments-heading {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

