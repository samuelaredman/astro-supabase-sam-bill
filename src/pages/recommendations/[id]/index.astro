---
export const prerender = false;
import { createSupabaseServerClientFromContext, getSupabaseAdmin } from "../../../utils/database";
import Layout from "../../../components/Layout.astro";
import CommentThread from "../../../components/CommentThread.astro";
import RecommendationFeedCard from "../../../components/RecommendationFeedCard.astro";
import ReportModal from "../../../components/ReportModal.astro";
import ShareButton from "../../../components/ShareButton.astro";
import { igdbImage } from "../../../utils/format";
import { REC_SELECT, shapeRec } from "../../../utils/recommendationsFeed";
import { setPageCacheHeaders } from "../../../utils/cache";
import { getPageUser } from "../../../utils/pageAuth";

const supabase = createSupabaseServerClientFromContext(Astro);
const user = await getPageUser(Astro, supabase);
const isLoggedIn = !!user;

// Cache the anonymous render at the CDN edge to cut function invocations under
// crawl load; logged-in (personalized) responses are never shared-cached.
setPageCacheHeaders(Astro.response.headers, isLoggedIn);
const { id } = Astro.params;

const db = getSupabaseAdmin() as any;

const { data: recRow } = await db
  .from("recommendations")
  .select(REC_SELECT)
  .eq("id", id)
  .eq("status", "published")
  .maybeSingle();

// Drafts have no public detail page — the author resumes them via the composer on /drafts.
if (!recRow) return Astro.redirect("/404");

let currentProfile: any = null;
if (user) {
  const { data: cp } = await db.from("profiles").select("id, username, avatar_url").eq("auth_user_id", user.id).maybeSingle();
  currentProfile = cp;
}

const rec = shapeRec(recRow, currentProfile?.id ?? null);

// Only index this recommendation if its author has opted into search indexing.
const { data: recAuthor } = await db
  .from("profiles")
  .select("search_indexable")
  .eq("id", rec.profileId)
  .maybeSingle();
const authorIndexable = !!recAuthor?.search_indexable;

const { data: commentsRaw } = await db
  .from("recommendation_comments")
  .select("id, body, created_at, updated_at, parent_id, profiles ( id, username, avatar_url, profile_badges!profile_badges_profile_id_fkey ( badge_slug ) ), recommendation_comment_votes ( vote, profile_id ), recommendation_comment_reactions ( reaction_type, profile_id )")
  .eq("recommendation_id", id)
  .order("created_at", { ascending: true });

const commentList: any[] = commentsRaw ?? [];

const topLevelComments = commentList.filter((c: any) => !c.parent_id);
const replyMap: Record<string, any[]> = {};
for (const c of commentList) {
  if (c.parent_id) (replyMap[c.parent_id] ||= []).push(c);
}
function getInitials(name: string) { return (name ?? "?").slice(0, 2).toUpperCase(); }

// Shape recommendation_comments into CommentData[] for the shared CommentThread.
// Recs support 2 levels of nesting today (c → rc).
function shapeRecComment(c: any, depth: number): import("../../../utils/comments").CommentData {
  const votesArr = Array.isArray(c.recommendation_comment_votes) ? c.recommendation_comment_votes : [];
  const up = votesArr.filter((v: any) => v.vote === 1).length;
  const down = votesArr.filter((v: any) => v.vote === -1).length;
  const myVote = currentProfile ? (votesArr.find((v: any) => v.profile_id === currentProfile.id)?.vote ?? 0) : 0;
  const isMine = currentProfile?.id === c.profiles?.id;
  const rxArr: { reaction_type: string; profile_id: string }[] =
    Array.isArray(c.recommendation_comment_reactions) ? c.recommendation_comment_reactions : [];
  const rxMap: Record<string, { count: number; mine: boolean }> = {};
  for (const r of rxArr) {
    if (!rxMap[r.reaction_type]) rxMap[r.reaction_type] = { count: 0, mine: false };
    rxMap[r.reaction_type].count++;
    if (currentProfile && r.profile_id === currentProfile.id) rxMap[r.reaction_type].mine = true;
  }
  const children = depth < 2 ? (replyMap[c.id] ?? []).map((r) => shapeRecComment(r, depth + 1)) : [];
  return {
    id: c.id,
    author: {
      id: c.profiles?.id ?? '',
      username: c.profiles?.username ?? 'unknown',
      avatarUrl: c.profiles?.avatar_url ?? null,
    },
    body: c.body,
    createdAt: c.created_at,
    updatedAt: c.updated_at,
    upvotes: up,
    downvotes: down,
    myVote: myVote as 1 | -1 | 0,
    canEdit: isMine,
    canDelete: isMine,
    canReport: !!currentProfile && !isMine,
    reactions: Object.entries(rxMap)
      .map(([type, info]) => ({ type, count: info.count, mine: info.mine }))
      .sort((a, b) => b.count - a.count),
    replies: children,
  };
}
const threadComments = topLevelComments.map((c) => shapeRecComment(c, 0));
const commentCount = commentList.length;
const isOwner = currentProfile?.id === rec.profileId;

// Sidebar: more recommendations from the same author
const { data: moreRecsRaw } = await db
  .from("recommendations")
  .select("id, source_game:games!source_game_id ( title, slug, cover_img_url ), target_game:games!target_game_id ( title, slug, cover_img_url )")
  .eq("profile_id", rec.profileId)
  .eq("status", "published")
  .neq("id", id)
  .order("created_at", { ascending: false })
  .limit(3);
const moreRecs = moreRecsRaw ?? [];
---

<Layout
  title={`${rec.ownerUsername}'s recommendation — Chekpoint`}
  description={`If you liked ${rec.sourceGame?.title}, try ${rec.targetGame?.title}.`}
  isLoggedIn={isLoggedIn}
  currentProfile={currentProfile}
  noindex={!authorIndexable}
>
  <main class="feed rec-detail-main">
    <div class="rec-detail-topbar">
      <button class="rec-detail-back" onclick="history.length > 1 ? history.back() : (window.location.href='/recommendations')">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12L6 8L10 4"/></svg>
        Back
      </button>
      <ShareButton url={`/recommendations/${rec.id}`} imageUrl={`/og/recommendations/${rec.id}.jpg`} />
    </div>

    <div class="rec-detail-post">
      <RecommendationFeedCard
        id={rec.id}
        sourceGame={rec.sourceGame}
        targetGame={rec.targetGame}
        body={rec.body}
        containsSpoilers={rec.containsSpoilers}
        ownerUsername={rec.ownerUsername}
        ownerAvatar={rec.ownerAvatar}
        ownerBadgeSlugs={rec.ownerBadgeSlugs}
        createdAt={rec.createdAt}
        upVotes={rec.upVotes}
        downVotes={rec.downVotes}
        myVote={rec.myVote}
        commentCount={rec.commentCount}
        reactions={rec.reactions}
        isLoggedIn={isLoggedIn}
        currentProfileId={currentProfile?.id ?? null}
        detailView={true}
        isOwner={isOwner}
      />
    </div>

    <!-- ── Comments (shared CommentThread) ── -->
    <div class="list-comments" id="comments">
      <div class="list-comments-title">
        Comments
        {commentCount > 0 && <span class="comments-count">{commentCount}</span>}
      </div>
      <CommentThread
        comments={threadComments}
        currentUser={currentProfile ? { id: currentProfile.id, username: currentProfile.username, avatarUrl: currentProfile.avatar_url } : null}
        target={{ type: 'recommendation_comment', id: rec.id }}
        canCompose={isLoggedIn}
        showDownvote={true}
        showReport={true}
        maxLength={2000}
        maxDepth={2}
        signinReturnTo={Astro.url.pathname + Astro.url.search}
      />
    </div>
  </main>

  <div slot="sidebar-right">
    <div class="widget">
      <div class="widget-title">The games</div>
      {[rec.sourceGame, rec.targetGame].map((g: any, i: number) => g && (
        <a href={`/games/${g.slug}`} class="rec-side-game">
          <div class="rec-side-cover">
            {igdbImage(g.cover_img_url)
              ? <img src={igdbImage(g.cover_img_url) ?? ''} alt={g.title} />
              : <span>🎮</span>}
          </div>
          <div class="rec-side-info">
            <div class="rec-side-role">{i === 0 ? 'If you liked' : 'Try'}</div>
            <div class="rec-side-title">{g.title}</div>
            <div class="rec-side-cta">View game →</div>
          </div>
        </a>
      ))}
    </div>

    <div class="widget">
      <div class="widget-title">Recommended by</div>
      <a href={`/reviewers/${rec.ownerUsername}`} style="display:flex;gap:12px;align-items:center;text-decoration:none">
        <div class="rec-side-avatar">
          {rec.ownerAvatar
            ? <img src={rec.ownerAvatar} alt={rec.ownerUsername} />
            : <span>{getInitials(rec.ownerUsername)}</span>}
        </div>
        <div>
          <div style="font-size:13px;font-weight:500">@{rec.ownerUsername}</div>
          <div style="font-size:12px;color:var(--text-tertiary)">View profile →</div>
        </div>
      </a>
    </div>

    {moreRecs.length > 0 && (
      <div class="widget">
        <div class="widget-title">More from @{rec.ownerUsername}</div>
        <div style="display:flex;flex-direction:column;gap:4px">
          {moreRecs.map((m: any) => (
            <a href={`/recommendations/${m.id}`} class="rec-side-more">
              <div class="rec-side-more-covers">
                <div class="rec-side-more-cover">
                  {igdbImage(m.source_game?.cover_img_url)
                    ? <img src={igdbImage(m.source_game.cover_img_url) ?? ''} alt="" />
                    : <span>🎮</span>}
                </div>
                <span class="rec-side-more-arrow">→</span>
                <div class="rec-side-more-cover">
                  {igdbImage(m.target_game?.cover_img_url)
                    ? <img src={igdbImage(m.target_game.cover_img_url) ?? ''} alt="" />
                    : <span>🎮</span>}
                </div>
              </div>
              <div class="rec-side-more-titles">{m.source_game?.title} → {m.target_game?.title}</div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

  <ReportModal />
</Layout>

<style is:global>
  .rec-detail-main { min-width: 0; padding: 20px 16px 60px; }
  .rec-detail-topbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .rec-detail-back { display: inline-flex; align-items: center; gap: 5px; font-size: 13px; font-family: inherit; color: var(--text-tertiary); background: none; border: none; cursor: pointer; padding: 0; transition: color .15s; }
  .rec-detail-back:hover { color: var(--text-secondary); }
  .rec-detail-post { background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; margin-bottom: 20px; }

  /* ── Sidebar widgets ── */
  .rec-side-game { display: flex; gap: 12px; align-items: flex-start; text-decoration: none; padding: 8px 0; border-bottom: 1px solid var(--border-subtle); }
  .rec-side-game:last-child { border-bottom: none; }
  .rec-side-cover { flex-shrink: 0; width: 46px; height: 62px; border-radius: 7px; overflow: hidden; background: var(--tag-bg); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 18px; }
  .rec-side-cover img { width: 100%; height: 100%; object-fit: cover; }
  .rec-side-info { min-width: 0; }
  .rec-side-role { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--text-tertiary); margin-bottom: 3px; }
  .rec-side-title { font-size: 13px; font-weight: 500; color: var(--text-primary); line-height: 1.3; margin-bottom: 4px; }
  .rec-side-game:hover .rec-side-title { color: var(--accent); }
  .rec-side-cta { font-size: 12px; color: var(--text-tertiary); }
  .rec-side-avatar { width: 40px; height: 40px; border-radius: 50%; overflow: hidden; background: var(--tag-bg); border: 1px solid var(--border); flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700; color: var(--text-secondary); }
  .rec-side-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .rec-side-more { display: flex; align-items: center; gap: 10px; padding: 8px; margin: 0 -8px; border-radius: 8px; text-decoration: none; transition: background .15s; }
  .rec-side-more:hover { background: var(--bg-hover); }
  .rec-side-more-covers { display: flex; align-items: center; gap: 3px; flex-shrink: 0; }
  .rec-side-more-cover { width: 24px; height: 32px; border-radius: 4px; overflow: hidden; background: var(--tag-bg); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 11px; }
  .rec-side-more-cover img { width: 100%; height: 100%; object-fit: cover; }
  .rec-side-more-arrow { color: var(--accent); font-size: 11px; font-weight: 700; }
  .rec-side-more-titles { font-size: 12px; color: var(--text-primary); line-height: 1.3; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }

  .list-comments { background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; padding: 18px; }
  .list-comments-title { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--text-tertiary); margin-bottom: 16px; }
</style>

