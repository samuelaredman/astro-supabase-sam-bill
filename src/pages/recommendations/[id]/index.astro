---
export const prerender = false;
import { createSupabaseServerClientFromContext, getSupabaseAdmin } from "../../../utils/database";
import Layout from "../../../components/Layout.astro";
import RecommendationFeedCard from "../../../components/RecommendationFeedCard.astro";
import ReportModal from "../../../components/ReportModal.astro";
import { timeAgo } from "../../../utils/format";
import { IMAGE_EMOTE_MAP } from "../../../utils/reactions";
import { REC_SELECT, shapeRec } from "../../../utils/recommendationsFeed";

const supabase = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await supabase.auth.getUser();
const isLoggedIn = !!user;
const { id } = Astro.params;

const db = getSupabaseAdmin() as any;

const { data: recRow } = await db
  .from("recommendations")
  .select(REC_SELECT)
  .eq("id", id)
  .maybeSingle();

if (!recRow) return Astro.redirect("/404");

let currentProfile: any = null;
if (user) {
  const { data: cp } = await db.from("profiles").select("id, username, avatar_url").eq("auth_user_id", user.id).maybeSingle();
  currentProfile = cp;
}

const rec = shapeRec(recRow, currentProfile?.id ?? null);

const { data: commentsRaw } = await db
  .from("recommendation_comments")
  .select("id, body, created_at, updated_at, parent_id, profiles ( id, username, avatar_url ), recommendation_comment_votes ( vote, profile_id )")
  .eq("recommendation_id", id)
  .order("created_at", { ascending: true });

const commentList: any[] = commentsRaw ?? [];

function renderBody(text: string): string {
  const esc = text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  const withMentions = esc.replace(/(^|\s)(@([\w]+))/g, '$1<a class="lc-mention" href="/reviewers/$3">$2</a>');
  return withMentions.replace(/:([A-Za-z0-9_]+):/g, (_: string, key: string) => {
    const path = IMAGE_EMOTE_MAP[key];
    return path ? `<img src="${path}" class="lc-emote-inline" alt=":${key}:" title=":${key}:">` : `:${key}:`;
  });
}

function getVotes(comment: any) {
  const arr = Array.isArray(comment.recommendation_comment_votes) ? comment.recommendation_comment_votes : [];
  return {
    net: arr.filter((v: any) => v.vote === 1).length - arr.filter((v: any) => v.vote === -1).length,
    my: currentProfile ? (arr.find((v: any) => v.profile_id === currentProfile.id)?.vote ?? 0) : 0,
  };
}

const topLevelComments = commentList.filter((c: any) => !c.parent_id);
const replyMap: Record<string, any[]> = {};
for (const c of commentList) {
  if (c.parent_id) (replyMap[c.parent_id] ||= []).push(c);
}
function getInitials(name: string) { return (name ?? "?").slice(0, 2).toUpperCase(); }
const commentCount = commentList.length;
const isOwner = currentProfile?.id === rec.profileId;
---

<Layout
  title={`${rec.ownerUsername}'s recommendation — Chekpoint`}
  description={`If you liked ${rec.sourceGame?.title}, try ${rec.targetGame?.title}.`}
  isLoggedIn={isLoggedIn}
  currentProfile={currentProfile}
  variant="two-col"
>
  <main class="feed rec-detail-main">
    <button class="rec-detail-back" onclick="history.length > 1 ? history.back() : (window.location.href='/recommendations')">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12L6 8L10 4"/></svg>
      Back
    </button>

    <div class="rec-detail-post">
      <RecommendationFeedCard
        id={rec.id}
        sourceGame={rec.sourceGame}
        targetGame={rec.targetGame}
        body={rec.body}
        containsSpoilers={rec.containsSpoilers}
        ownerUsername={rec.ownerUsername}
        ownerAvatar={rec.ownerAvatar}
        createdAt={rec.createdAt}
        upVotes={rec.upVotes}
        downVotes={rec.downVotes}
        myVote={rec.myVote}
        commentCount={rec.commentCount}
        reactions={rec.reactions}
        isLoggedIn={isLoggedIn}
        currentProfileId={currentProfile?.id ?? null}
      />
      {isOwner && (
        <div class="rec-detail-owner-actions">
          <button class="rec-detail-delete" data-rec-id={rec.id}>Delete recommendation</button>
        </div>
      )}
    </div>

    <!-- ── Comments ── -->
    <div class="list-comments" id="comments">
      <div class="list-comments-title">{commentCount} {commentCount === 1 ? "Comment" : "Comments"}</div>

      <div class="lc-list" id="lc-list">
        {topLevelComments.length === 0 && <div class="lc-empty" id="lc-empty">No comments yet. Start the conversation.</div>}
        {topLevelComments.map((c: any) => {
          const v = getVotes(c);
          const replies = replyMap[c.id] ?? [];
          return (
            <div class="lc-item" data-comment-id={c.id}>
              <a href={`/reviewers/${c.profiles?.username}`} class="lc-avatar">
                {c.profiles?.avatar_url ? <img src={c.profiles.avatar_url} alt={c.profiles.username} /> : <span>{getInitials(c.profiles?.username)}</span>}
              </a>
              <div class="lc-body">
                <div class="lc-meta">
                  <a href={`/reviewers/${c.profiles?.username}`} class="lc-username">@{c.profiles?.username}</a>
                  <span class="lc-ts">{timeAgo(c.created_at)} ago</span>
                  {c.updated_at && <span class="lc-edited">(edited)</span>}
                </div>
                <div class="lc-text" set:html={renderBody(c.body)} />
                <div class="lc-actions">
                  <button class={`lcv-btn${v.my === 1 ? " lcv-up" : ""}`} data-comment-id={c.id} data-vote="1" data-logged-in={isLoggedIn ? "true" : "false"}>▲ <span class="lcv-net">{v.net}</span></button>
                  <button class={`lcv-btn${v.my === -1 ? " lcv-down" : ""}`} data-comment-id={c.id} data-vote="-1" data-logged-in={isLoggedIn ? "true" : "false"}>▼</button>
                  {isLoggedIn && <button class="lc-reply-btn" data-reply-to={c.id} data-username={c.profiles?.username}>Reply</button>}
                  {currentProfile && c.profiles?.id === currentProfile.id && (
                    <>
                      <button class="lc-edit-btn" data-comment-id={c.id}>Edit</button>
                      <button class="lc-delete-btn" data-comment-id={c.id}>Delete</button>
                    </>
                  )}
                </div>
                {replies.length > 0 && (
                  <div class="lc-replies">
                    {replies.map((rc: any) => {
                      const rv = getVotes(rc);
                      return (
                        <div class="lc-item lc-reply" data-comment-id={rc.id}>
                          <a href={`/reviewers/${rc.profiles?.username}`} class="lc-avatar lc-avatar-sm">
                            {rc.profiles?.avatar_url ? <img src={rc.profiles.avatar_url} alt={rc.profiles.username} /> : <span>{getInitials(rc.profiles?.username)}</span>}
                          </a>
                          <div class="lc-body">
                            <div class="lc-meta">
                              <a href={`/reviewers/${rc.profiles?.username}`} class="lc-username">@{rc.profiles?.username}</a>
                              <span class="lc-ts">{timeAgo(rc.created_at)} ago</span>
                              {rc.updated_at && <span class="lc-edited">(edited)</span>}
                            </div>
                            <div class="lc-text" set:html={renderBody(rc.body)} />
                            <div class="lc-actions">
                              <button class={`lcv-btn${rv.my === 1 ? " lcv-up" : ""}`} data-comment-id={rc.id} data-vote="1" data-logged-in={isLoggedIn ? "true" : "false"}>▲ <span class="lcv-net">{rv.net}</span></button>
                              <button class={`lcv-btn${rv.my === -1 ? " lcv-down" : ""}`} data-comment-id={rc.id} data-vote="-1" data-logged-in={isLoggedIn ? "true" : "false"}>▼</button>
                              {currentProfile && rc.profiles?.id === currentProfile.id && (
                                <>
                                  <button class="lc-edit-btn" data-comment-id={rc.id}>Edit</button>
                                  <button class="lc-delete-btn" data-comment-id={rc.id}>Delete</button>
                                </>
                              )}
                            </div>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>

      {isLoggedIn ? (
        <div class="lc-form">
          <textarea id="lc-input" class="lc-textarea" placeholder="Add a comment..." maxlength="2000"></textarea>
          <div class="lc-error" id="lc-error"></div>
          <button class="lc-submit" id="lc-submit" data-rec-id={rec.id}>Post comment</button>
        </div>
      ) : (
        <div class="lc-signin-prompt">
          <a href="/signin">Sign in</a> to join the conversation.
        </div>
      )}
    </div>
  </main>

  <ReportModal />
</Layout>

<style is:global>
  .rec-detail-main { min-width: 0; padding: 20px 16px 60px; max-width: 720px; }
  .rec-detail-back { display: inline-flex; align-items: center; gap: 5px; font-size: 13px; font-family: inherit; color: var(--text-tertiary); background: none; border: none; cursor: pointer; padding: 0 0 16px; transition: color .15s; }
  .rec-detail-back:hover { color: var(--text-secondary); }
  .rec-detail-post { background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; margin-bottom: 20px; }
  /* Full body on the detail page — override the feed card's line clamp */
  .rec-detail-post .rfc-body { -webkit-line-clamp: unset; }
  .rec-detail-owner-actions { padding: 0 20px 16px 52px; }
  .rec-detail-delete { background: none; border: 1px solid var(--border); color: var(--text-tertiary); font-size: 12px; font-family: inherit; padding: 5px 12px; border-radius: 8px; cursor: pointer; transition: all .15s; }
  .rec-detail-delete:hover { border-color: #f87171; color: #f87171; }

  .list-comments { background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; padding: 18px; }
  .list-comments-title { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--text-tertiary); margin-bottom: 16px; }
  .lc-list { display: flex; flex-direction: column; }
  .lc-item { display: flex; gap: 10px; padding: 12px 0; border-bottom: 1px solid var(--border-subtle); }
  .lc-item:last-child { border-bottom: none; }
  .lc-avatar { width: 28px; height: 28px; border-radius: 50%; overflow: hidden; flex-shrink: 0; background: var(--tag-bg); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; color: var(--text-tertiary); text-decoration: none; }
  .lc-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .lc-avatar-sm { width: 22px; height: 22px; min-width: 22px; font-size: 8px; }
  .lc-body { flex: 1; min-width: 0; }
  .lc-meta { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; flex-wrap: wrap; }
  .lc-username { font-size: 13px; font-weight: 600; color: var(--text-primary); text-decoration: none; }
  .lc-username:hover { color: var(--accent); }
  .lc-ts { font-size: 12px; color: var(--text-tertiary); }
  .lc-edited { font-size: 11px; color: var(--text-tertiary); font-style: italic; }
  .lc-text { font-size: 13px; color: var(--text-primary); line-height: 1.6; opacity: .9; white-space: pre-wrap; word-break: break-word; }
  .lc-empty { padding: 8px 0 16px; text-align: center; font-size: 13px; color: var(--text-tertiary); }
  .lc-mention { color: var(--accent); text-decoration: none; }
  .lc-mention:hover { text-decoration: underline; }
  .lc-emote-inline { width: 16px; height: 16px; object-fit: contain; vertical-align: middle; }

  .lc-replies { margin-left: 20px; border-left: 2px solid var(--border-subtle); padding-left: 10px; margin-top: 4px; }
  .lc-reply { padding: 10px 0 6px; border-bottom: none; }

  .lc-actions { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; margin-top: 5px; }
  .lcv-btn { font-size: 10px; font-weight: 600; padding: 2px 7px; border-radius: 14px; border: 1.5px solid var(--border); color: var(--text-tertiary); background: transparent; cursor: pointer; font-family: inherit; transition: all 0.15s; line-height: 1.4; }
  .lcv-btn:hover:not(.lcv-up):not(.lcv-down) { border-color: var(--text-tertiary); color: var(--text-secondary); background: var(--bg-hover); }
  .lcv-btn:disabled { opacity: 0.5; cursor: default; }
  .lcv-up { border-color: #4ade80; color: #4ade80; background: rgba(74,222,128,.08); }
  .lcv-down { border-color: #f87171; color: #f87171; background: rgba(248,113,113,.08); }
  .lc-reply-btn, .lc-edit-btn, .lc-delete-btn { background: none; border: none; cursor: pointer; font-size: 10px; font-weight: 500; color: var(--text-tertiary); font-family: inherit; padding: 2px 5px; border-radius: 4px; transition: color 0.15s; line-height: 1.4; }
  .lc-reply-btn:hover { color: var(--accent); }
  .lc-edit-btn:hover { color: var(--text-secondary); }
  .lc-delete-btn:hover { color: #f87171; }

  .lc-rf { margin: 6px 0 8px; display: flex; flex-direction: column; gap: 6px; }
  .lc-rf-ta, .lc-edit-ta { width: 100%; padding: 7px 10px; border-radius: 8px; border: 1px solid var(--border); background: var(--bg-hover); color: var(--text-primary); font-size: 12px; font-family: inherit; outline: none; resize: vertical; min-height: 52px; transition: border-color .15s; box-sizing: border-box; }
  .lc-rf-ta:focus, .lc-edit-ta:focus { border-color: var(--accent); }
  .lc-rf-foot, .lc-edit-foot { display: flex; justify-content: flex-end; gap: 6px; align-items: center; }
  .lc-rf-cancel, .lc-edit-cancel { background: none; border: 1px solid var(--border); padding: 4px 10px; border-radius: 14px; font-size: 11px; font-family: inherit; color: var(--text-secondary); cursor: pointer; transition: all .15s; }
  .lc-rf-cancel:hover, .lc-edit-cancel:hover { border-color: var(--text-tertiary); }
  .lc-rf-submit, .lc-edit-save { background: var(--accent); color: #fff; border: none; padding: 4px 12px; border-radius: 14px; font-size: 11px; font-weight: 600; font-family: inherit; cursor: pointer; transition: opacity .15s; }
  .lc-rf-submit:hover, .lc-edit-save:hover { opacity: .85; }
  .lc-rf-submit:disabled, .lc-edit-save:disabled { opacity: .45; cursor: not-allowed; }

  .lc-form { margin-top: 16px; display: flex; flex-direction: column; gap: 10px; }
  .lc-signin-prompt { font-size: 13px; color: var(--text-tertiary); padding: 14px; background: var(--bg-hover); border-radius: 10px; text-align: center; margin-top: 12px; }
  .lc-signin-prompt a { color: var(--accent); text-decoration: none; }
  .lc-textarea { width: 100%; padding: 10px 14px; border-radius: 10px; border: 1px solid var(--border); background: var(--bg-hover); color: var(--text-primary); font-size: 13px; font-family: inherit; outline: none; resize: vertical; min-height: 64px; transition: border-color .15s; box-sizing: border-box; }
  .lc-textarea:focus { border-color: var(--accent); }
  .lc-submit { align-self: flex-end; background: var(--accent); color: #fff; border: none; padding: 7px 18px; border-radius: 20px; font-size: 13px; font-weight: 600; font-family: inherit; cursor: pointer; transition: opacity .15s; }
  .lc-submit:hover { opacity: .85; }
  .lc-submit:disabled { opacity: .45; cursor: not-allowed; }
  .lc-error { font-size: 13px; color: #f87171; display: none; }
</style>

<script is:inline define:vars={{ recId: rec.id, loggedIn: isLoggedIn, myUsername: currentProfile?.username ?? null, myAvatar: currentProfile?.avatar_url ?? null, imageEmoteMap: IMAGE_EMOTE_MAP }}>
  (function () {
    function esc(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
    function renderBody(text) {
      var e = esc(text).replace(/(^|\s)(@([\w]+))/g, '$1<a class="lc-mention" href="/reviewers/$3">$2</a>');
      return e.replace(/:([A-Za-z0-9_]+):/g, function (_, key) {
        var p = imageEmoteMap[key];
        return p ? '<img src="' + p + '" class="lc-emote-inline" alt=":' + key + ':">' : ':' + key + ':';
      });
    }
    function initials(n) { return (n || '?').slice(0, 2).toUpperCase(); }

    // ── Post top-level comment ──
    var submit = document.getElementById('lc-submit');
    if (submit) {
      submit.addEventListener('click', async function () {
        var input = document.getElementById('lc-input');
        var errEl = document.getElementById('lc-error');
        var body = input.value.trim();
        errEl.style.display = 'none';
        if (!body) { errEl.textContent = 'Write something first.'; errEl.style.display = 'block'; return; }
        submit.disabled = true;
        try {
          var res = await fetch('/api/recommendations/comments/create', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ recommendation_id: recId, body: body }),
          });
          var data = await res.json();
          if (!res.ok) { errEl.textContent = data.error || 'Failed to post.'; errEl.style.display = 'block'; submit.disabled = false; return; }
          input.value = '';
          appendComment(data.comment, null);
        } finally { submit.disabled = false; }
      });
    }

    function buildCommentNode(comment, isReply) {
      var wrap = document.createElement('div');
      wrap.className = 'lc-item' + (isReply ? ' lc-reply' : '');
      wrap.dataset.commentId = comment.id;
      var av = comment.profiles || {};
      var avatarInner = av.avatar_url ? '<img src="' + av.avatar_url + '" alt="">' : '<span>' + initials(av.username) + '</span>';
      var ownControls = (myUsername && av.username === myUsername)
        ? '<button class="lc-edit-btn" data-comment-id="' + comment.id + '">Edit</button><button class="lc-delete-btn" data-comment-id="' + comment.id + '">Delete</button>'
        : '';
      var replyBtn = (!isReply && loggedIn) ? '<button class="lc-reply-btn" data-reply-to="' + comment.id + '" data-username="' + (av.username || '') + '">Reply</button>' : '';
      wrap.innerHTML =
        '<a href="/reviewers/' + av.username + '" class="lc-avatar' + (isReply ? ' lc-avatar-sm' : '') + '">' + avatarInner + '</a>' +
        '<div class="lc-body">' +
          '<div class="lc-meta"><a href="/reviewers/' + av.username + '" class="lc-username">@' + av.username + '</a><span class="lc-ts">just now</span></div>' +
          '<div class="lc-text">' + renderBody(comment.body) + '</div>' +
          '<div class="lc-actions">' +
            '<button class="lcv-btn" data-comment-id="' + comment.id + '" data-vote="1" data-logged-in="true">▲ <span class="lcv-net">0</span></button>' +
            '<button class="lcv-btn" data-comment-id="' + comment.id + '" data-vote="-1" data-logged-in="true">▼</button>' +
            replyBtn + ownControls +
          '</div>' +
        '</div>';
      return wrap;
    }

    function appendComment(comment, parentId) {
      var empty = document.getElementById('lc-empty');
      if (empty) empty.remove();
      if (!parentId) {
        document.getElementById('lc-list').appendChild(buildCommentNode(comment, false));
      } else {
        var parent = document.querySelector('.lc-item[data-comment-id="' + parentId + '"]');
        if (!parent) return;
        var body = parent.querySelector('.lc-body');
        var replies = body.querySelector('.lc-replies');
        if (!replies) { replies = document.createElement('div'); replies.className = 'lc-replies'; body.appendChild(replies); }
        replies.appendChild(buildCommentNode(comment, true));
      }
    }

    // ── Delegated actions: vote, reply, edit, delete ──
    document.addEventListener('click', async function (e) {
      // Delete the whole recommendation
      var recDel = e.target.closest('.rec-detail-delete');
      if (recDel) {
        if (!confirm('Delete this recommendation? This cannot be undone.')) return;
        var res = await fetch('/api/recommendations/delete', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ recommendation_id: recDel.dataset.recId }),
        });
        if (res.ok) window.location.href = '/recommendations';
        return;
      }

      // Comment vote
      var voteBtn = e.target.closest('.lcv-btn');
      if (voteBtn) {
        if (voteBtn.dataset.loggedIn !== 'true') { window.location.href = '/signin'; return; }
        var cid = voteBtn.dataset.commentId;
        var vote = parseInt(voteBtn.dataset.vote);
        voteBtn.disabled = true;
        try {
          var r = await fetch('/api/recommendations/comments/vote', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ comment_id: cid, vote: vote }),
          });
          var d = await r.json();
          if (r.ok) {
            var group = document.querySelectorAll('.lcv-btn[data-comment-id="' + cid + '"]');
            group.forEach(function (b) {
              var bv = parseInt(b.dataset.vote);
              b.classList.toggle('lcv-up', bv === 1 && d.vote === 1);
              b.classList.toggle('lcv-down', bv === -1 && d.vote === -1);
              var net = b.querySelector('.lcv-net');
              if (net) net.textContent = String((d.up || 0) - (d.down || 0));
            });
          }
        } finally { voteBtn.disabled = false; }
        return;
      }

      // Reply toggle
      var replyBtn = e.target.closest('.lc-reply-btn');
      if (replyBtn) {
        var pid = replyBtn.dataset.replyTo;
        var item = document.querySelector('.lc-item[data-comment-id="' + pid + '"]');
        if (!item) return;
        var bodyEl = item.querySelector('.lc-body');
        if (bodyEl.querySelector('.lc-rf')) { bodyEl.querySelector('.lc-rf').remove(); return; }
        var rf = document.createElement('div');
        rf.className = 'lc-rf';
        rf.innerHTML = '<textarea class="lc-rf-ta" placeholder="Reply to @' + (replyBtn.dataset.username || '') + '..." maxlength="2000"></textarea>' +
          '<div class="lc-rf-foot"><button class="lc-rf-cancel">Cancel</button><button class="lc-rf-submit" data-parent="' + pid + '">Reply</button></div>';
        bodyEl.insertBefore(rf, bodyEl.querySelector('.lc-replies') || null);
        rf.querySelector('.lc-rf-ta').focus();
        return;
      }
      var rfCancel = e.target.closest('.lc-rf-cancel');
      if (rfCancel) { var rf = rfCancel.closest('.lc-rf'); if (rf) rf.remove(); return; }
      var rfSubmit = e.target.closest('.lc-rf-submit');
      if (rfSubmit) {
        var rf = rfSubmit.closest('.lc-rf');
        var ta = rf.querySelector('.lc-rf-ta');
        var body = ta.value.trim();
        if (!body) return;
        rfSubmit.disabled = true;
        var res = await fetch('/api/recommendations/comments/create', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ recommendation_id: recId, body: body, parent_id: rfSubmit.dataset.parent }),
        });
        var data = await res.json();
        if (res.ok) { appendComment(data.comment, rfSubmit.dataset.parent); rf.remove(); }
        else rfSubmit.disabled = false;
        return;
      }

      // Delete comment
      var delBtn = e.target.closest('.lc-delete-btn');
      if (delBtn) {
        if (!confirm('Delete this comment?')) return;
        var cid = delBtn.dataset.commentId;
        var res = await fetch('/api/recommendations/comments/delete', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ comment_id: cid }),
        });
        if (res.ok) {
          var item = document.querySelector('.lc-item[data-comment-id="' + cid + '"]');
          if (item) item.remove();
        }
        return;
      }

      // Edit comment
      var editBtn = e.target.closest('.lc-edit-btn');
      if (editBtn) {
        var cid = editBtn.dataset.commentId;
        var item = document.querySelector('.lc-item[data-comment-id="' + cid + '"]');
        var textEl = item.querySelector('.lc-text');
        if (item.querySelector('.lc-edit-wrap')) return;
        var current = textEl.textContent;
        var wrap = document.createElement('div');
        wrap.className = 'lc-edit-wrap';
        wrap.innerHTML = '<textarea class="lc-edit-ta" maxlength="2000"></textarea>' +
          '<div class="lc-edit-foot"><button class="lc-edit-cancel">Cancel</button><button class="lc-edit-save" data-comment-id="' + cid + '">Save</button></div>';
        textEl.style.display = 'none';
        textEl.parentNode.insertBefore(wrap, textEl.nextSibling);
        var ta = wrap.querySelector('.lc-edit-ta');
        ta.value = current; ta.focus();
        return;
      }
      var editCancel = e.target.closest('.lc-edit-cancel');
      if (editCancel) {
        var wrap = editCancel.closest('.lc-edit-wrap');
        var textEl = wrap.previousElementSibling;
        if (textEl) textEl.style.display = '';
        wrap.remove();
        return;
      }
      var editSave = e.target.closest('.lc-edit-save');
      if (editSave) {
        var cid = editSave.dataset.commentId;
        var wrap = editSave.closest('.lc-edit-wrap');
        var ta = wrap.querySelector('.lc-edit-ta');
        var body = ta.value.trim();
        if (!body) return;
        editSave.disabled = true;
        var res = await fetch('/api/recommendations/comments/update', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ comment_id: cid, body: body }),
        });
        if (res.ok) {
          var textEl = wrap.previousElementSibling;
          textEl.innerHTML = renderBody(body);
          textEl.style.display = '';
          wrap.remove();
        } else editSave.disabled = false;
        return;
      }
    });
  })();
</script>
