---
export const prerender = false;
import { createSupabaseServerClientFromContext } from '../utils/database';
import Layout from '../components/Layout.astro';

const serverClient = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await serverClient.auth.getUser();
const isLoggedIn = !!user;

let currentProfile: { id: string; username: string; avatar_url: string | null } | null = null;
if (user) {
  const { data: cpData } = await serverClient
    .from('profiles')
    .select('id, username, avatar_url')
    .eq('auth_user_id', user.id)
    .single();
  currentProfile = cpData;
}
---

<Layout
  title="Recommendations — Chekpoint"
  description="Games picked for you based on what you've loved, your favorite genres, and people you follow."
  isLoggedIn={isLoggedIn}
  currentProfile={currentProfile}
  activeNav="recommendations"
>
  <main class="feed">
    <div class="feed-header">
      <div>
        <div class="feed-title">Recommendations</div>
        <div class="feed-subtitle">
          {!currentProfile
            ? 'Sign in to get personalized picks'
            : 'Based on games you loved, your favorite genres, and people you follow'}
        </div>
      </div>
    </div>

    {!currentProfile ? (
      <div class="empty-state">
        <div class="empty-state-title">Sign in to see your recommendations</div>
        <p>We'll pick games based on what you've reviewed highly, your favorite genres, and people you follow.</p>
        <a href="/signin" class="empty-cta">Sign in</a>
      </div>
    ) : (
      <div style="padding: 20px;">
        <div id="recsContent" data-username={currentProfile.username}>
          <div class="recs-loading">Loading recommendations…</div>
        </div>
      </div>
    )}
  </main>
</Layout>

<script>
  import { loadRecommendationsInto } from '../utils/recsRender';

  const container = document.getElementById('recsContent');
  if (container) {
    loadRecommendationsInto(
      container,
      container.dataset.username || '',
      "No recommendations yet — rate a few games 7/10 or higher and we'll start picking things for you."
    );
  }
</script>
