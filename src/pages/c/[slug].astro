---
export const prerender = false;
import { getSupabaseAdmin } from "../../utils/database";

// chekpoint.gg/c/<slug> — a group's custom link (see /api/groups/slug).
// Redirects rather than rendering the group here, so /groups/[id] stays the
// one page to maintain. 302, not 301: a link can be changed or reassigned,
// and browsers cache a 301 indefinitely. The query string (an invite ?code=)
// carries through.
const slug = (Astro.params.slug ?? "").toLowerCase();

const { data: group } = await getSupabaseAdmin()
  .from("groups").select("id").eq("slug", slug).maybeSingle();

if (!group) return Astro.rewrite("/404");

return Astro.redirect(`/groups/${group.id}${Astro.url.search}`, 302);
---
