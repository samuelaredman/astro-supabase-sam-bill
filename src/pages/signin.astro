---
export const prerender = true;
import Layout from '../components/Layout.astro';
---

<Layout title="Sign in — Chekpoint" variant="centered">
  <style>
    :root[data-theme="light"] {
      --input-bg: #ffffff;
      --error: #c0392b;
      --error-bg: #fdf0ee;
      --success: #1a6b3c;
    }
    :root[data-theme="dark"] {
      --input-bg: #222220;
      --error: #f87171;
      --error-bg: #2b0d0d;
      --success: #4ade80;
    }

    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 40px;
      width: 100%;
      max-width: 400px;
    }

    .logo {
      font-family: 'Press Start 2P', monospace;
      font-size: 13px;
      margin-bottom: 28px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .logo-dot {
      width: 6px;
      height: 6px;
      background: #6050c8;
      border-radius: 50%;
      box-shadow: 0 0 10px #6050c8;
    }

    h1 {
      font-size: 22px;
      font-weight: 500;
      letter-spacing: -0.3px;
      margin-bottom: 6px;
    }

    .subtitle {
      font-size: 14px;
      color: var(--text-secondary);
      margin-bottom: 28px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 16px;
    }

    label {
      font-size: 13px;
      font-weight: 500;
      color: var(--text-secondary);
    }

    input {
      background: var(--input-bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 15px;
      font-family: inherit;
      color: var(--text-primary);
      width: 100%;
      transition: border-color 0.15s;
      outline: none;
    }

    input:focus { border-color: var(--text-secondary); }

    .submit-btn {
      width: 100%;
      background: var(--accent);
      color: var(--accent-text);
      border: none;
      border-radius: 10px;
      padding: 12px;
      font-size: 15px;
      font-weight: 500;
      font-family: inherit;
      cursor: pointer;
      margin-top: 8px;
      transition: opacity 0.15s;
    }
    .submit-btn:hover { opacity: 0.85; }
    .submit-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    .error-msg {
      background: var(--error-bg);
      color: var(--error);
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 13px;
      margin-bottom: 16px;
      display: none;
    }
    .error-msg.visible { display: block; }

    /* Resend-confirmation prompt: shown for an unconfirmed email or a failed confirmation link. */
    .resend-box {
      margin: -6px 0 16px;
      font-size: 13px;
      color: var(--text-secondary);
    }
    .resend-box[hidden] { display: none; }
    .resend-btn {
      background: none;
      border: none;
      padding: 0;
      font: inherit;
      font-weight: 500;
      color: var(--text-primary);
      text-decoration: underline;
      text-underline-offset: 2px;
      cursor: pointer;
    }
    .resend-btn:disabled { opacity: 0.5; cursor: default; }
    .resend-status { display: block; margin-top: 6px; }
    .resend-status.ok { color: var(--success); }
    .resend-status.err { color: var(--error); }

    .footer-link {
      text-align: center;
      font-size: 13px;
      color: var(--text-secondary);
      margin-top: 24px;
    }

    .footer-link a {
      color: var(--text-primary);
      font-weight: 500;
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  </style>

  <div class="card">
    <a href="/" class="logo">
      <span class="logo-dot"></span>
      Chekpoint
    </a>

    <h1>Welcome back</h1>
    <p class="subtitle">Sign in to your account to continue.</p>

    <div class="error-msg" id="errorMsg"></div>
    <div class="resend-box" id="resendBox" hidden>
      Didn't get the email? <button type="button" class="resend-btn" id="resendBtn">Resend confirmation email</button>
      <span class="resend-status" id="resendStatus" hidden></span>
    </div>

    <form id="signinForm">
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="you@example.com" required />
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="••••••••" required />
      </div>
      <button type="submit" class="submit-btn" id="submitBtn">Sign in</button>
    </form>

    <p class="footer-link">
      Don't have an account? <a href="/signup">Sign up</a>
    </p>
    <p class="footer-link">
      Forgot your password? <a href="/forgot-password">Reset password</a>
    </p>
  </div>

  <script>
    const form = document.getElementById('signinForm') as HTMLFormElement;
    const errorMsg = document.getElementById('errorMsg') as HTMLDivElement;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
    const resendBox = document.getElementById('resendBox') as HTMLDivElement;
    const resendBtn = document.getElementById('resendBtn') as HTMLButtonElement;
    const resendStatus = document.getElementById('resendStatus') as HTMLSpanElement;

    function showError(text: string) {
      errorMsg.textContent = text;
      errorMsg.classList.add('visible');
    }

    // /auth/confirm sends people here when a confirmation link fails — usually
    // because it expired, or an email security scanner opened it first (which uses
    // it up but DOES confirm the account). Tell them what to do instead of showing
    // a bare sign-in form.
    const params = new URLSearchParams(window.location.search);
    if (params.get('error') === 'confirmation_failed') {
      showError("That confirmation link has expired or was already used. If you've already confirmed your email, just sign in below. Otherwise, enter your email and resend the confirmation.");
      resendBox.hidden = false;
      history.replaceState(null, '', window.location.pathname);
    }

    resendBtn.addEventListener('click', async () => {
      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      resendStatus.hidden = false;
      resendStatus.className = 'resend-status';
      if (!email) {
        resendStatus.textContent = 'Enter your email above first.';
        resendStatus.classList.add('err');
        (document.getElementById('email') as HTMLInputElement).focus();
        return;
      }
      resendBtn.disabled = true;
      resendStatus.textContent = 'Sending…';
      try {
        const res = await fetch('/api/auth/resend-confirmation', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'Could not send the email. Please try again.');
        resendStatus.textContent = 'Sent! Check your inbox (and spam folder) for a new link to ' + email + '.';
        resendStatus.classList.add('ok');
      } catch (err: any) {
        resendStatus.textContent = err?.message || 'Could not send the email. Please try again.';
        resendStatus.classList.add('err');
      } finally {
        resendBtn.disabled = false;
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg.classList.remove('visible');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Signing in...';

      const email = (document.getElementById('email') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;

      const res = await fetch('/api/auth/signin', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });

      const data = await res.json();

      if (!res.ok) {
        showError(data.error ?? 'Something went wrong. Please try again.');
        if (data.code === 'email_not_confirmed') resendBox.hidden = false;
        submitBtn.disabled = false;
        submitBtn.textContent = 'Sign in';
      } else {
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'login', { method: 'email' });
        }
        window.location.href = '/';
      }
    });
  </script>
</Layout>
