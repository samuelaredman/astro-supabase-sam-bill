                    {c.profiles?.avatar_url
                      ? <img src={c.profiles.avatar_url} alt={c.profiles.username} />
                      : <span>{(c.profiles?.username ?? '?').slice(0, 2).toUpperCase()}</span>
                    }
                  </a>
                  <div class="lc-body">
                    <div class="lc-meta">
                      <a href={`/reviewers/${c.profiles?.username}`} class="lc-username">@{c.profiles?.username}</a>
                      <span class="lc-ts">{timeAgo(c.created_at)}</span>
                      {c.updated_at && <span class="lc-edited">(edited)</span>}
                    </div>
                    <div class="lc-text" data-raw-body={c.body} set:html={renderBody(c.body)}></div>
                    <div class="lc-actions">
                      <button class={`lcv-btn${cv.my === 1 ? ' lcv-up' : ''}`} data-comment-id={c.id} data-vote="1" data-logged-in={isLoggedIn ? 'true' : 'false'}>▲ {cv.up}</button>
                      <button class={`lcv-btn${cv.my === -1 ? ' lcv-down' : ''}`} data-comment-id={c.id} data-vote="-1" data-logged-in={isLoggedIn ? 'true' : 'false'}>▼ {cv.down}</button>
                      {(cr.length > 0 || isLoggedIn) && (
                        <div class="lcrx-wrap" data-comment-id={c.id}>
                          {cr.map((rx: any) => (
                            <button
                              class={`lcrx-btn${rx.active ? ' lcrx-active' : ''}`}
                              data-comment-id={c.id}
                              data-reaction={rx.type}
                              data-reacted={rx.active ? 'true' : 'false'}
                              data-count={rx.count}
                              data-logged-in={isLoggedIn ? 'true' : 'false'}
                              data-is-image={rx.isImage ? 'true' : 'false'}
                            >
                              {rx.isImage
                                ? <><img src={rx.path!} class="lcrx-emote-img" alt={rx.type} />{' '}{rx.count}</>
                                : <>{rx.type} {rx.count}</>}
                            </button>
                          ))}
                          {isLoggedIn && <button class="lcrx-toggle" data-toggle-comment-id={c.id} title="React">+</button>}
                        </div>
                      )}
                      {isLoggedIn && <button class="lc-reply-btn" data-parent-id={c.id} data-thread-id={c.id} data-reply-to={c.profiles?.username} type="button">↩ Reply</button>}
                      {isOwn && <button class="lc-edit-btn" data-comment-id={c.id} type="button">Edit</button>}
                      {isOwn && <button class="lc-delete-btn" data-comment-id={c.id} type="button">Delete</button>}
                    </div>
                  </div>
                </div>

                <div class="lc-replies" data-replies-for={c.id}>
                  {level1Replies.map((r: any) => {
                    const level2Replies = directReplyMap[r.id] ?? [];
                    const rv = getLCVotes(r);
                    const rr = getLCReactions(r);
                    const isOwnR = currentProfile?.id === r.profiles?.id;
                    return (
                      <Fragment>
                        <div class="lc-item lc-reply" data-comment-id={r.id}>
                          <a href={`/reviewers/${r.profiles?.username}`} class="lc-avatar lc-avatar-sm">
                            {r.profiles?.avatar_url
                              ? <img src={r.profiles.avatar_url} alt={r.profiles.username} />
                              : <span>{(r.profiles?.username ?? '?').slice(0, 2).toUpperCase()}</span>
                            }
                          </a>
                          <div class="lc-body">
                            <div class="lc-meta">
                              <a href={`/reviewers/${r.profiles?.username}`} class="lc-username">@{r.profiles?.username}</a>
                              <span class="lc-ts">{timeAgo(r.created_at)}</span>
                              {r.updated_at && <span class="lc-edited">(edited)</span>}
                            </div>
                            <div class="lc-text" data-raw-body={r.body} set:html={renderBody(r.body)}></div>
                            <div class="lc-actions">
                              <button class={`lcv-btn${rv.my === 1 ? ' lcv-up' : ''}`} data-comment-id={r.id} data-vote="1" data-logged-in={isLoggedIn ? 'true' : 'false'}>▲ {rv.up}</button>
                              <button class={`lcv-btn${rv.my === -1 ? ' lcv-down' : ''}`} data-comment-id={r.id} data-vote="-1" data-logged-in={isLoggedIn ? 'true' : 'false'}>▼ {rv.down}</button>
                              {(rr.length > 0 || isLoggedIn) && (
                                <div class="lcrx-wrap" data-comment-id={r.id}>
                                  {rr.map((rx: any) => (
                                    <button
                                      class={`lcrx-btn${rx.active ? ' lcrx-active' : ''}`}
                                      data-comment-id={r.id}
                                      data-reaction={rx.type}
                                      data-reacted={rx.active ? 'true' : 'false'}
                                      data-count={rx.count}
                                      data-logged-in={isLoggedIn ? 'true' : 'false'}
                                      data-is-image={rx.isImage ? 'true' : 'false'}
                                    >
                                      {rx.isImage
                                        ? <><img src={rx.path!} class="lcrx-emote-img" alt={rx.type} />{' '}{rx.count}</>
                                        : <>{rx.type} {rx.count}</>}
                                    </button>
                                  ))}
                                  {isLoggedIn && <button class="lcrx-toggle" data-toggle-comment-id={r.id} title="React">+</button>}
                                </div>
                              )}
                              {isLoggedIn && <button class="lc-reply-btn" data-parent-id={r.id} data-thread-id={c.id} data-reply-to={r.profiles?.username} type="button">↩ Reply</button>}
                              {isOwnR && <button class="lc-edit-btn" data-comment-id={r.id} type="button">Edit</button>}
                              {isOwnR && <button class="lc-delete-btn" data-comment-id={r.id} type="button">Delete</button>}
                            </div>
                          </div>
                        </div>
                        {level2Replies.length > 0 && (
                          <div class="lc-replies lc-replies-deep" data-replies-for={r.id}>
                            {level2Replies.map((dr: any) => {
                              const dv = getLCVotes(dr);
                              const drr = getLCReactions(dr);
                              const isOwnDr = currentProfile?.id === dr.profiles?.id;
                              return (
                                <div class="lc-item lc-reply" data-comment-id={dr.id}>
                                  <a href={`/reviewers/${dr.profiles?.username}`} class="lc-avatar lc-avatar-sm">
                                    {dr.profiles?.avatar_url
                                      ? <img src={dr.profiles.avatar_url} alt={dr.profiles.username} />
                                      : <span>{(dr.profiles?.username ?? '?').slice(0, 2).toUpperCase()}</span>
                                    }
                                  </a>
                                  <div class="lc-body">
                                    <div class="lc-meta">
                                      <a href={`/reviewers/${dr.profiles?.username}`} class="lc-username">@{dr.profiles?.username}</a>
                                      <span class="lc-ts">{timeAgo(dr.created_at)}</span>
                                      {dr.updated_at && <span class="lc-edited">(edited)</span>}
                                    </div>
                                    <div class="lc-text" data-raw-body={dr.body} set:html={renderBody(dr.body)}></div>
                                    <div class="lc-actions">
                                      <button class={`lcv-btn${dv.my === 1 ? ' lcv-up' : ''}`} data-comment-id={dr.id} data-vote="1" data-logged-in={isLoggedIn ? 'true' : 'false'}>▲ {dv.up}</button>
                                      <button class={`lcv-btn${dv.my === -1 ? ' lcv-down' : ''}`} data-comment-id={dr.id} data-vote="-1" data-logged-in={isLoggedIn ? 'true' : 'false'}>▼ {dv.down}</button>
                                      {(drr.length > 0 || isLoggedIn) && (
                                        <div class="lcrx-wrap" data-comment-id={dr.id}>
                                          {drr.map((rx: any) => (
                                            <button
                                              class={`lcrx-btn${rx.active ? ' lcrx-active' : ''}`}
                                              data-comment-id={dr.id}
                                              data-reaction={rx.type}
                                              data-reacted={rx.active ? 'true' : 'false'}
                                              data-count={rx.count}
                                              data-logged-in={isLoggedIn ? 'true' : 'false'}
                                              data-is-image={rx.isImage ? 'true' : 'false'}
                                            >
                                              {rx.isImage
                                                ? <><img src={rx.path!} class="lcrx-emote-img" alt={rx.type} />{' '}{rx.count}</>
                                                : <>{rx.type} {rx.count}</>}
                                            </button>
                                          ))}
                                          {isLoggedIn && <button class="lcrx-toggle" data-toggle-comment-id={dr.id} title="React">+</button>}
                                        </div>
                                      )}
                                      {isLoggedIn && <button class="lc-reply-btn" data-parent-id={dr.id} data-thread-id={c.id} data-reply-to={dr.profiles?.username} type="button">↩ Reply</button>}
                                      {isOwnDr && <button class="lc-edit-btn" data-comment-id={dr.id} type="button">Edit</button>}
                                      {isOwnDr && <button class="lc-delete-btn" data-comment-id={dr.id} type="button">Delete</button>}
                                    </div>
                                  </div>
                                </div>
                              );
                            })}
                          </div>
                        )}
                      </Fragment>
                    );
                  })}
                </div>

                {isLoggedIn && (
                  <div class="lc-rf" id={`lc-rf-${c.id}`} style="display:none">
                    <textarea class="lc-rf-ta" placeholder="Write a reply…" maxlength="2000" rows="2"></textarea>
                    <div class="lc-rf-foot">
                      <button class="lc-rf-cancel" type="button">Cancel</button>
                      <button class="lc-rf-submit" type="button" data-parent-id={c.id} data-list-id={id}>Reply</button>
                    </div>
                  </div>
                )}
              </div>
            );
          })}
        </div>

        <div class="lc-form">
          {isLoggedIn
            ? <>
                <textarea class="lc-textarea" id="lc-textarea" placeholder="Write a comment…" maxlength="2000" rows="3"></textarea>
                <p class="lc-error" id="lc-error"></p>
                <button class="lc-submit" id="lc-submit">Post comment</button>
              </>
            : <div class="lc-signin-prompt">
                <a href="/signin">Sign in</a> to leave a comment.
              </div>
          }
        </div>
    </div>
  </div>
</main>
</Layout>

<script is:inline define:vars={{ listId: list.id, imageEmotes: IMAGE_EMOTES, imageEmoteMap: IMAGE_EMOTE_MAP, currentProfileId: currentProfile?.id ?? null }}>

// ── Save button ──────────────────────────────────────────────────────────────
var saveBtn = document.getElementById('lvote-save');
if (saveBtn) {
  saveBtn.addEventListener('click', async function() {
    if (saveBtn.disabled) return;
    var loggedIn = saveBtn.dataset.loggedIn === 'true';
    if (!loggedIn) { window.location.href = '/signin'; return; }
    saveBtn.disabled = true;
    var wasSaved = saveBtn.dataset.saved === 'true';
    try {
      var res = await fetch('/api/lists/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ list_id: listId }),
      });
      if (res.status === 401) { window.location.href = '/signin'; return; }
      var data = await res.json();
      if (!res.ok) return;
      saveBtn.dataset.saved = data.saved ? 'true' : 'false';
      saveBtn.textContent = data.saved ? '★ Saved' : '☆ Save';
      saveBtn.classList.toggle('saved', data.saved);
      var savesCount = document.getElementById('saves-count');
      if (savesCount) savesCount.textContent = data.count;
    } catch(e) {
      saveBtn.dataset.saved = wasSaved ? 'true' : 'false';
    } finally {
      saveBtn.disabled = false;
    }
  });
}

// ── List vote buttons ─────────────────────────────────────────────────────────
document.querySelectorAll('.list-vote-btn:not(.list-save-btn)').forEach(function(btn) {
  btn.addEventListener('click', async function() {
    if (btn.disabled) return;
    var loggedIn = btn.dataset.loggedIn === 'true';
    if (!loggedIn) { window.location.href = '/signin'; return; }
    btn.disabled = true;
    var vote = parseInt(btn.dataset.vote);
    try {
      var res = await fetch('/api/lists/vote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ list_id: listId, vote }),
      });
      if (res.status === 401) { window.location.href = '/signin'; return; }
      if (!res.ok) return;
      var data = await res.json();
      var upBtn = document.getElementById('lvote-up');
      var downBtn = document.getElementById('lvote-down');
      if (upBtn) { upBtn.textContent = '▲ ' + data.up; upBtn.classList.toggle('lv-up', data.vote === 1); }
      if (downBtn) { downBtn.textContent = '▼ ' + data.down; downBtn.classList.toggle('lv-down', data.vote === -1); }
    } finally {
      btn.disabled = false;
    }
  });
});

// ── List-level emoji picker (for list reactions) ──────────────────────────────
var ldpPicker = document.createElement('div');
ldpPicker.id = 'ldp-emoji-picker';
var ldpHtml = '<input type="text" id="ldp-emote-search" class="ldp-emote-search" placeholder="Search emotes..." autocomplete="off">';
ldpHtml += '<div class="ldp-emoji-grid" id="ldp-emote-grid">';
imageEmotes.forEach(function(emote) {
  ldpHtml += '<button class="ldp-emoji-pick" data-emoji="' + emote.key + '" title="' + emote.key + '"><img src="' + emote.path + '" class="ldp-emote-picker-img" alt="' + emote.key + '"></button>';
});
ldpHtml += '</div>';
ldpPicker.innerHTML = ldpHtml;
document.body.appendChild(ldpPicker);

document.getElementById('ldp-emote-search').addEventListener('input', function() {
  var q = this.value.toLowerCase();
  document.querySelectorAll('#ldp-emote-grid .ldp-emoji-pick').forEach(function(btn) {
    btn.style.display = btn.dataset.emoji.toLowerCase().indexOf(q) !== -1 ? '' : 'none';
  });
});

function applyDetailReaction(reactionType, reacted, count) {
  var isImage = !!imageEmoteMap[reactionType];
  var existing = document.querySelector('.list-reaction-btn[data-reaction="' + reactionType + '"]');
  if (existing) {
    existing.dataset.reacted = reacted ? 'true' : 'false';
    existing.dataset.count = String(count);
    if (isImage) {
      existing.innerHTML = '<img src="' + imageEmoteMap[reactionType] + '" class="list-emote-img" alt="' + reactionType + '"> ' + count;
    } else {
      existing.textContent = reactionType + ' ' + count;
    }
    existing.classList.toggle('lr-active', reacted);
    if (count === 0) existing.remove();
  } else if (count > 0) {
    var wrap = document.getElementById('list-reaction-wrap');
    var toggle = document.getElementById('list-react-toggle');
    if (wrap && toggle) {
      var newBtn = document.createElement('button');
      newBtn.className = 'list-reaction-btn' + (reacted ? ' lr-active' : '');
      newBtn.dataset.reaction = reactionType;
      newBtn.dataset.reacted = reacted ? 'true' : 'false';
      newBtn.dataset.count = String(count);
      newBtn.dataset.loggedIn = 'true';
      newBtn.dataset.isImage = isImage ? 'true' : 'false';
      if (isImage) {
        newBtn.innerHTML = '<img src="' + imageEmoteMap[reactionType] + '" class="list-emote-img" alt="' + reactionType + '"> ' + count;
      } else {
        newBtn.textContent = reactionType + ' ' + count;
      }
      wrap.insertBefore(newBtn, toggle);
    }
  }
}

// ── Comment-level emoji picker ─────────────────────────────────────────────────
var ldpcPicker = document.createElement('div');
ldpcPicker.id = 'ldpc-emoji-picker';
var ldpcHtml = '<input type="text" class="ldpc-search" placeholder="Search emotes..." autocomplete="off">';
ldpcHtml += '<div class="ldpc-grid">';
imageEmotes.forEach(function(emote) {
  ldpcHtml += '<button class="ldpc-pick" data-emoji="' + emote.key + '" title="' + emote.key + '"><img src="' + emote.path + '" alt="' + emote.key + '"></button>';
});
ldpcHtml += '</div>';
ldpcPicker.innerHTML = ldpcHtml;
document.body.appendChild(ldpcPicker);

ldpcPicker.querySelector('.ldpc-search').addEventListener('input', function() {
  var q = this.value.toLowerCase();
  ldpcPicker.querySelectorAll('.ldpc-pick').forEach(function(btn) {
    btn.style.display = btn.dataset.emoji.toLowerCase().indexOf(q) !== -1 ? '' : 'none';
  });
});

function lcrxApply(commentId, reactionType, reacted, count) {
  var isImage = !!imageEmoteMap[reactionType];
  var wrap = document.querySelector('.lcrx-wrap[data-comment-id="' + commentId + '"]');
  if (!wrap) return;
  var existing = wrap.querySelector('.lcrx-btn[data-reaction="' + reactionType + '"]');
  if (existing) {
    existing.dataset.reacted = reacted ? 'true' : 'false';
    existing.dataset.count = String(count);
    if (isImage) {
      existing.innerHTML = '<img src="' + imageEmoteMap[reactionType] + '" class="lcrx-emote-img" alt="' + reactionType + '"> ' + count;
    } else {
      existing.textContent = reactionType + ' ' + count;
    }
    existing.classList.toggle('lcrx-active', reacted);
    if (count === 0) existing.remove();
  } else if (count > 0) {
    var toggle = wrap.querySelector('.lcrx-toggle');
    var newBtn = document.createElement('button');
    newBtn.className = 'lcrx-btn' + (reacted ? ' lcrx-active' : '');
    newBtn.dataset.commentId = commentId;
    newBtn.dataset.reaction = reactionType;
    newBtn.dataset.reacted = reacted ? 'true' : 'false';
    newBtn.dataset.count = String(count);
    newBtn.dataset.loggedIn = 'true';
    newBtn.dataset.isImage = isImage ? 'true' : 'false';
    if (isImage) {
      newBtn.innerHTML = '<img src="' + imageEmoteMap[reactionType] + '" class="lcrx-emote-img" alt="' + reactionType + '"> ' + count;
    } else {
      newBtn.textContent = reactionType + ' ' + count;
    }
    if (toggle) { wrap.insertBefore(newBtn, toggle); } else { wrap.appendChild(newBtn); }
  }
}

function renderBody(text) {
  var esc = text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  var withMentions = esc.replace(/(^|\s)(@([\w]+))/g, function(m, pre, mention, username) {
    return pre + '<a class="lc-mention" href="/reviewers/' + username + '">' + mention + '</a>';
  });
  return withMentions.replace(/:([A-Za-z0-9_]+):/g, function(match, key) {
    var path = imageEmoteMap[key];
    return path ? '<img src="' + path + '" class="lc-emote-inline" alt=":' + key + ':" title=":' + key + ':">' : match;
  });
}

// ── Delegated click handler ───────────────────────────────────────────────────
document.addEventListener('click', function(e) {

  // ── List reaction inline btn
  var reactionBtn = e.target.closest('.list-reaction-btn');
  if (reactionBtn) {
    var loggedIn = reactionBtn.dataset.loggedIn === 'true';
    if (!loggedIn) { window.location.href = '/signin'; return; }
    var reaction = reactionBtn.dataset.reaction;
    var reacted = reactionBtn.dataset.reacted === 'true';
    var count = parseInt(reactionBtn.dataset.count) || 0;
    applyDetailReaction(reaction, !reacted, reacted ? Math.max(0, count - 1) : count + 1);
    fetch('/api/lists/react', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ list_id: listId, reaction_type: reaction }),
    }).then(function(r) { return r.json(); })
      .then(function(d) { if (d) applyDetailReaction(reaction, d.reacted, d.count); })
      .catch(function() { applyDetailReaction(reaction, reacted, count); });
    return;
  }

  // ── List react toggle
  var toggleBtn = e.target.closest('#list-react-toggle');
  if (toggleBtn) {
    var loggedIn = toggleBtn.dataset.loggedIn === 'true';
    if (!loggedIn) { window.location.href = '/signin'; return; }
    var picker = document.getElementById('ldp-emoji-picker');
    var isOpen = picker.style.display !== 'none';
    picker.style.display = isOpen ? 'none' : 'block';
    if (!isOpen) {
      requestAnimationFrame(function() {
        var rect = toggleBtn.getBoundingClientRect();
        var pRect = picker.getBoundingClientRect();
        var top = rect.top - pRect.height - 8;
        if (top < 8) top = rect.bottom + 8;
        var left = rect.left;
        if (left + pRect.width > window.innerWidth - 8) left = window.innerWidth - pRect.width - 8;
        picker.style.top = top + 'px';
        picker.style.left = left + 'px';
        picker.querySelectorAll('.ldp-emoji-pick').forEach(function(btn) {
          var inlineBtn = document.querySelector('.list-reaction-btn[data-reaction="' + btn.dataset.emoji + '"]');
          btn.classList.toggle('ldp-emoji-active', !!(inlineBtn && inlineBtn.dataset.reacted === 'true'));
        });
      });
    }
    return;
  }

  // ── List emoji pick
  var emojiBtn = e.target.closest('.ldp-emoji-pick');
  if (emojiBtn) {
    var picker = document.getElementById('ldp-emoji-picker');
    picker.style.display = 'none';
    var emoji = emojiBtn.dataset.emoji;
    var existing = document.querySelector('.list-reaction-btn[data-reaction="' + emoji + '"]');
    var reacted = existing ? existing.dataset.reacted === 'true' : false;
    var count = existing ? (parseInt(existing.dataset.count) || 0) : 0;
    applyDetailReaction(emoji, !reacted, reacted ? Math.max(0, count - 1) : count + 1);
    fetch('/api/lists/react', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ list_id: listId, reaction_type: emoji }),
    }).then(function(r) { return r.json(); })
      .then(function(d) { if (d) applyDetailReaction(emoji, d.reacted, d.count); })
      .catch(function() { applyDetailReaction(emoji, reacted, count); });
    return;
  }

  // ── Comment vote
  var cvBtn = e.target.closest('.lcv-btn');
  if (cvBtn) {
    if (cvBtn.dataset.loggedIn !== 'true') { window.location.href = '/signin'; return; }
    if (cvBtn.disabled) return;
    cvBtn.disabled = true;
    var commentId = cvBtn.dataset.commentId;
    var vote = parseInt(cvBtn.dataset.vote);
    fetch('/api/lists/comments/vote', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ comment_id: commentId, vote }),
    }).then(function(r) {
      if (r.status === 401) { window.location.href = '/signin'; return r.json(); }
      return r.json();
    }).then(function(data) {
      if (!data) return;
      document.querySelectorAll('.lcv-btn[data-comment-id="' + commentId + '"]').forEach(function(b) {
        var bv = parseInt(b.dataset.vote);
        b.textContent = (bv === 1 ? '▲ ' : '▼ ') + (bv === 1 ? data.up : data.down);
        b.classList.toggle('lcv-up',   bv === 1  && data.vote === 1);
        b.classList.toggle('lcv-down', bv === -1 && data.vote === -1);
      });
    }).finally(function() { cvBtn.disabled = false; });
    return;
  }

  // ── Comment inline reaction
  var crxBtn = e.target.closest('.lcrx-btn');
  if (crxBtn) {
    if (crxBtn.dataset.loggedIn !== 'true') { window.location.href = '/signin'; return; }
    var commentId = crxBtn.dataset.commentId;
    var reaction = crxBtn.dataset.reaction;
    var reacted = crxBtn.dataset.reacted === 'true';
    var count = parseInt(crxBtn.dataset.count) || 0;
    lcrxApply(commentId, reaction, !reacted, reacted ? Math.max(0, count - 1) : count + 1);
    fetch('/api/lists/comments/react', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ comment_id: commentId, reaction_type: reaction }),
    }).then(function(r) { return r.json(); })
      .then(function(d) { if (d) lcrxApply(commentId, reaction, d.reacted, d.count); })
      .catch(function() { lcrxApply(commentId, reaction, reacted, count); });
    return;
  }

  // ── Comment reaction toggle (+)
  var crxToggle = e.target.closest('.lcrx-toggle');
  if (crxToggle) {
    var commentId = crxToggle.dataset.toggleCommentId;
    var picker = document.getElementById('ldpc-emoji-picker');
    var isOpen = picker.style.display !== 'none' && picker.dataset.activeCommentId === commentId;
    picker.style.display = 'none';
    if (!isOpen) {
      picker.dataset.activeCommentId = commentId;
      picker.style.display = 'block';
      requestAnimationFrame(function() {
        var rect = crxToggle.getBoundingClientRect();
        var pRect = picker.getBoundingClientRect();
        var top = rect.top - pRect.height - 8;
        if (top < 8) top = rect.bottom + 8;
        var left = rect.left;
        if (left + pRect.width > window.innerWidth - 8) left = window.innerWidth - pRect.width - 8;
        picker.style.top = top + 'px';
        picker.style.left = left + 'px';
        picker.querySelectorAll('.ldpc-pick').forEach(function(btn) {
          var inlineBtn = document.querySelector('.lcrx-btn[data-comment-id="' + commentId + '"][data-reaction="' + btn.dataset.emoji + '"]');
          btn.classList.toggle('ldpc-active', !!(inlineBtn && inlineBtn.dataset.reacted === 'true'));
        });
      });
    }
    return;
  }

  // ── Comment emoji picker pick
  var ldpcBtn = e.target.closest('.ldpc-pick');
  if (ldpcBtn) {
    var picker = document.getElementById('ldpc-emoji-picker');
    var commentId = picker && picker.dataset.activeCommentId;
    if (!commentId) return;
    picker.style.display = 'none';
    var emoji = ldpcBtn.dataset.emoji;
    var existing = document.querySelector('.lcrx-btn[data-comment-id="' + commentId + '"][data-reaction="' + emoji + '"]');
    var reacted = existing ? existing.dataset.reacted === 'true' : false;
    var count = existing ? (parseInt(existing.dataset.count) || 0) : 0;
    lcrxApply(commentId, emoji, !reacted, reacted ? Math.max(0, count - 1) : count + 1);
    fetch('/api/lists/comments/react', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ comment_id: commentId, reaction_type: emoji }),
    }).then(function(r) { return r.json(); })
      .then(function(d) { if (d) lcrxApply(commentId, emoji, d.reacted, d.count); })
      .catch(function() { lcrxApply(commentId, emoji, reacted, count); });
    return;
  }

  // ── Reply btn: open reply form
  var replyBtn = e.target.closest('.lc-reply-btn');
  if (replyBtn) {
    var parentId = replyBtn.dataset.parentId;
    var threadId = replyBtn.dataset.threadId || parentId;
    var replyTo = replyBtn.dataset.replyTo;
    var form = document.getElementById('lc-rf-' + threadId);
    if (!form) return;
    var isOpen = form.style.display !== 'none';
    document.querySelectorAll('.lc-rf').forEach(function(f) { f.style.display = 'none'; });
    if (!isOpen) {
      var sb = form.querySelector('.lc-rf-submit');
      if (sb) sb.dataset.parentId = parentId;
      form.style.display = 'flex';
      form.style.flexDirection = 'column';
      var ta = form.querySelector('.lc-rf-ta');
      if (ta) {
        ta.value = replyTo ? '@' + replyTo + ' ' : '';
        ta.focus();
        ta.setSelectionRange(ta.value.length, ta.value.length);
      }
    }
    return;
  }

  // ── Reply form cancel
  var rfCancel = e.target.closest('.lc-rf-cancel');
  if (rfCancel) {
    var form = rfCancel.closest('.lc-rf');
    form.style.display = 'none';
    var ta = form.querySelector('.lc-rf-ta');
    if (ta) ta.value = '';
    return;
  }

  // ── Reply form submit
  var rfSubmit = e.target.closest('.lc-rf-submit');
  if (rfSubmit) {
    var parentId = rfSubmit.dataset.parentId;
    var rfListId = rfSubmit.dataset.listId;
    var form = rfSubmit.closest('.lc-rf');
    var threadId = form.id.replace('lc-rf-', '');
    var ta = form.querySelector('.lc-rf-ta');
    var body = ta.value.trim();
    if (!body) return;
    rfSubmit.disabled = true;
    rfSubmit.textContent = 'Posting…';
    fetch('/api/lists/comments/create', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ list_id: rfListId, body, parent_id: parentId }),
    }).then(function(r) {
      if (r.status === 401) { window.location.href = '/signin'; throw new Error('unauth'); }
      return r.json();
    }).then(function(data) {
      if (!data || data.error) { alert(data?.error || 'Failed to post reply.'); return; }
      var c = data.comment;
      var p = c.profiles;
      var initials = p?.username ? p.username.slice(0,2).toUpperCase() : '?';
      var avatarHtml = p?.avatar_url
        ? '<img src="' + p.avatar_url + '" alt="" style="width:100%;height:100%;object-fit:cover">'
        : '<span>' + initials + '</span>';
      var isOwn = currentProfileId === p?.id;
      var replyEl = document.createElement('div');
      replyEl.className = 'lc-item lc-reply';
      replyEl.dataset.commentId = c.id;
      replyEl.innerHTML =
        '<a href="/reviewers/' + (p?.username ?? '') + '" class="lc-avatar lc-avatar-sm">' + avatarHtml + '</a>' +
        '<div class="lc-body">' +
          '<div class="lc-meta">' +
            '<a href="/reviewers/' + (p?.username ?? '') + '" class="lc-username">@' + (p?.username ?? '') + '</a>' +
            '<span class="lc-ts">just now</span>' +
          '</div>' +
          '<div class="lc-text" data-raw-body="' + (c.body ?? '').replace(/"/g,'&quot;') + '">' + renderBody(c.body ?? '') + '</div>' +
          '<div class="lc-actions">' +
            '<button class="lcv-btn" data-comment-id="' + c.id + '" data-vote="1" data-logged-in="true">▲ 0</button>' +
            '<button class="lcv-btn" data-comment-id="' + c.id + '" data-vote="-1" data-logged-in="true">▼ 0</button>' +
            '<div class="lcrx-wrap" data-comment-id="' + c.id + '">' +
              '<button class="lcrx-toggle" data-toggle-comment-id="' + c.id + '" title="React">+</button>' +
            '</div>' +
            '<button class="lc-reply-btn" data-parent-id="' + c.id + '" data-thread-id="' + threadId + '" data-reply-to="' + (p?.username ?? '') + '" type="button">↩ Reply</button>' +
            (isOwn ? '<button class="lc-edit-btn" data-comment-id="' + c.id + '" type="button">Edit</button><button class="lc-delete-btn" data-comment-id="' + c.id + '" type="button">Delete</button>' : '') +
          '</div>' +
        '</div>';

      var container;
      if (parentId === threadId) {
        container = document.querySelector('.lc-replies[data-replies-for="' + threadId + '"]:not(.lc-replies-deep)');
      } else {
        container = document.querySelector('.lc-replies-deep[data-replies-for="' + parentId + '"]');
        if (!container) {
          container = document.createElement('div');
          container.className = 'lc-replies lc-replies-deep';
          container.dataset.repliesFor = parentId;
          var parentEl = document.querySelector('.lc-item[data-comment-id="' + parentId + '"]');
          if (parentEl) { parentEl.after(container); }
          else { container = document.querySelector('.lc-replies[data-replies-for="' + threadId + '"]:not(.lc-replies-deep)'); }
        }
      }
      if (container) container.appendChild(replyEl);
      form.style.display = 'none';
      ta.value = '';
      updateCommentCount(1);
    }).catch(function(err) {
      if (err.message !== 'unauth') alert('Something went wrong. Please try again.');
    }).finally(function() {
      rfSubmit.disabled = false;
      rfSubmit.textContent = 'Reply';
    });
    return;
  }

  // ── Edit btn
  var editBtn = e.target.closest('.lc-edit-btn');
  if (editBtn) {
    var commentId = editBtn.dataset.commentId;
    var commentEl = document.querySelector('.lc-item[data-comment-id="' + commentId + '"]');
    if (!commentEl) return;
    var textEl = commentEl.querySelector('.lc-text');
    var existing = commentEl.querySelector('.lc-edit-wrap');
    if (existing) { existing.remove(); textEl.style.display = ''; return; }
    var rawBody = textEl.dataset.rawBody || textEl.textContent;
    textEl.style.display = 'none';
    var editWrap = document.createElement('div');
    editWrap.className = 'lc-edit-wrap';
    editWrap.innerHTML =
      '<textarea class="lc-edit-ta" maxlength="2000" rows="3">' + rawBody.replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</textarea>' +
      '<div class="lc-edit-foot">' +
        '<button class="lc-edit-cancel" type="button">Cancel</button>' +
        '<button class="lc-edit-save" type="button" data-comment-id="' + commentId + '">Save</button>' +
      '</div>';
    textEl.after(editWrap);
    editWrap.querySelector('textarea').focus();
    return;
  }

  // ── Edit cancel
  var editCancel = e.target.closest('.lc-edit-cancel');
  if (editCancel) {
    var wrap = editCancel.closest('.lc-edit-wrap');
    var commentEl = wrap.closest('.lc-item');
    commentEl.querySelector('.lc-text').style.display = '';
    wrap.remove();
    return;
  }

  // ── Edit save
  var editSave = e.target.closest('.lc-edit-save');
  if (editSave) {
    var commentId = editSave.dataset.commentId;
    var wrap = editSave.closest('.lc-edit-wrap');
    var ta = wrap.querySelector('textarea');
    var body = ta.value.trim();
    if (!body) return;
    editSave.disabled = true;
    editSave.textContent = 'Saving…';
    fetch('/api/lists/comments/update', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ comment_id: commentId, body }),
    }).then(function(r) {
      if (r.status === 401) { window.location.href = '/signin'; throw new Error('unauth'); }
      return r.json();
    }).then(function(data) {
      if (!data || data.error) { alert(data?.error || 'Failed to update comment.'); return; }
      var commentEl = document.querySelector('.lc-item[data-comment-id="' + commentId + '"]');
      var textEl = commentEl.querySelector('.lc-text');
      textEl.innerHTML = renderBody(body);
      textEl.dataset.rawBody = body;
      textEl.style.display = '';
      wrap.remove();
      var meta = commentEl.querySelector('.lc-meta');
      if (!meta.querySelector('.lc-edited')) {
        var span = document.createElement('span');
        span.className = 'lc-edited';
        span.textContent = '(edited)';
        meta.appendChild(span);
      }
    }).catch(function(err) {
      if (err.message !== 'unauth') alert('Something went wrong.');
    }).finally(function() {
      if (editSave.isConnected) { editSave.disabled = false; editSave.textContent = 'Save'; }
    });
    return;
  }

  // ── Delete btn
  var deleteBtn = e.target.closest('.lc-delete-btn');
  if (deleteBtn) {
    if (!confirm('Delete this comment?')) return;
    var commentId = deleteBtn.dataset.commentId;
    deleteBtn.disabled = true;
    fetch('/api/lists/comments/delete', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ comment_id: commentId }),
    }).then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.error) { alert(data.error); return; }
        var commentEl = document.querySelector('.lc-item[data-comment-id="' + commentId + '"]');
        if (commentEl) {
          var deepReplies = commentEl.parentElement && commentEl.parentElement.querySelector('.lc-replies-deep[data-replies-for="' + commentId + '"]');
          if (deepReplies) deepReplies.remove();
          commentEl.remove();
        }
        updateCommentCount(-1);
        if (!document.querySelector('.lc-item')) {
          document.getElementById('lc-list').innerHTML = '<div class="lc-empty" id="lc-empty">No comments yet. Be the first!</div>';
        }
      })
      .catch(function() { alert('Failed to delete comment.'); })
      .finally(function() { if (deleteBtn.isConnected) deleteBtn.disabled = false; });
    return;
  }

  // ── Outside click: close pickers
  if (!e.target.closest('.list-reaction-wrap') && !e.target.closest('#ldp-emoji-picker')) {
    var p = document.getElementById('ldp-emoji-picker');
    if (p) p.style.display = 'none';
  }
  if (!e.target.closest('.lcrx-wrap') && !e.target.closest('#ldpc-emoji-picker')) {
    var p = document.getElementById('ldpc-emoji-picker');
    if (p) { p.style.display = 'none'; }
  }
});

function updateCommentCount(delta) {
  var heading = document.querySelector('.list-comments-title');
  if (!heading) return;
  var match = heading.textContent.match(/\d+/);
  var newCount = match ? Math.max(0, parseInt(match[0]) + delta) : Math.max(0, delta);
  heading.textContent = 'Comments (' + newCount + ')';
}

// ── Top-level comment submit ──────────────────────────────────────────────────
var lcSubmit = document.getElementById('lc-submit');
if (lcSubmit) {
  lcSubmit.addEventListener('click', async function() {
    var ta = document.getElementById('lc-textarea');
    var errEl = document.getElementById('lc-error');
    var body = ta.value.trim();
    if (!body) return;
    errEl.style.display = 'none';
    lcSubmit.disabled = true;
    lcSubmit.textContent = 'Posting…';
    try {
      var res = await fetch('/api/lists/comments/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ list_id: listId, body }),
      });
      if (res.status === 401) { window.location.href = '/signin'; return; }
      var data = await res.json();
      if (!res.ok) {
        errEl.textContent = data.error || 'Failed to post comment.';
        errEl.style.display = 'block';
        return;
      }
      ta.value = '';
      var emptyEl = document.getElementById('lc-empty');
      if (emptyEl) emptyEl.remove();
      var c = data.comment;
      var p = c.profiles;
      var initials = (p?.username ?? '?').slice(0, 2).toUpperCase();
      var avatarHtml = p?.avatar_url
        ? '<img src="' + p.avatar_url + '" alt="' + (p.username ?? '') + '" style="width:100%;height:100%;object-fit:cover">'
        : '<span>' + initials + '</span>';
      var isOwn = currentProfileId === p?.id;
      var thread = document.createElement('div');
      thread.className = 'lct';
      thread.dataset.threadId = c.id;
      thread.innerHTML =
        '<div class="lc-item" data-comment-id="' + c.id + '">' +
          '<a href="/reviewers/' + (p?.username ?? '') + '" class="lc-avatar">' + avatarHtml + '</a>' +
          '<div class="lc-body">' +
            '<div class="lc-meta">' +
              '<a href="/reviewers/' + (p?.username ?? '') + '" class="lc-username">@' + (p?.username ?? '') + '</a>' +
              '<span class="lc-ts">just now</span>' +
            '</div>' +
            '<div class="lc-text" data-raw-body="' + (c.body ?? '').replace(/"/g,'&quot;') + '">' + renderBody(c.body ?? '') + '</div>' +
            '<div class="lc-actions">' +
              '<button class="lcv-btn" data-comment-id="' + c.id + '" data-vote="1" data-logged-in="true">▲ 0</button>' +
              '<button class="lcv-btn" data-comment-id="' + c.id + '" data-vote="-1" data-logged-in="true">▼ 0</button>' +
              '<div class="lcrx-wrap" data-comment-id="' + c.id + '">' +
                '<button class="lcrx-toggle" data-toggle-comment-id="' + c.id + '" title="React">+</button>' +
              '</div>' +
              '<button class="lc-reply-btn" data-parent-id="' + c.id + '" data-thread-id="' + c.id + '" data-reply-to="' + (p?.username ?? '') + '" type="button">↩ Reply</button>' +
              (isOwn ? '<button class="lc-edit-btn" data-comment-id="' + c.id + '" type="button">Edit</button><button class="lc-delete-btn" data-comment-id="' + c.id + '" type="button">Delete</button>' : '') +
            '</div>' +
          '</div>' +
        '</div>' +
        '<div class="lc-replies" data-replies-for="' + c.id + '"></div>' +
        '<div class="lc-rf" id="lc-rf-' + c.id + '" style="display:none">' +
          '<textarea class="lc-rf-ta" placeholder="Write a reply…" maxlength="2000" rows="2"></textarea>' +
          '<div class="lc-rf-foot">' +
            '<button class="lc-rf-cancel" type="button">Cancel</button>' +
            '<button class="lc-rf-submit" type="button" data-parent-id="' + c.id + '" data-list-id="' + listId + '">Reply</button>' +
          '</div>' +
        '</div>';
      document.getElementById('lc-list').appendChild(thread);
      updateCommentCount(1);
    } finally {
      lcSubmit.disabled = false;
      lcSubmit.textContent = 'Post comment';
    }
  });
}
</script>

<script is:inline define:vars={{ _listId: list.id, _defaultView: list.default_view ?? 'grid' }}>
(function() {
  var gridBtn = document.getElementById('view-grid');
  var listBtn = document.getElementById('view-list');
  var el = document.getElementById('entry-list');
  if (!gridBtn || !listBtn || !el) return;

  var storageKey = 'chk-list-view-' + _listId;
  var view = localStorage.getItem(storageKey) || _defaultView;

  if (view === 'list') {
    el.classList.add('list-view');
    listBtn.classList.add('active');
    gridBtn.classList.remove('active');
  }

  gridBtn.addEventListener('click', function() {
    el.classList.remove('list-view');
    gridBtn.classList.add('active');
    listBtn.classList.remove('active');
    localStorage.setItem(storageKey, 'grid');
  });

  listBtn.addEventListener('click', function() {
    el.classList.add('list-view');
    listBtn.classList.add('active');
    gridBtn.classList.remove('active');
    localStorage.setItem(storageKey, 'list');
  });
})();
</script>

<script is:inline>
(function() {
  var searchInput = document.getElementById('entry-search');
  var entryListEl = document.getElementById('entry-list');
  var emptyFiltered = document.getElementById('entry-empty-filtered');
  if (!entryListEl) return;

  var items = Array.prototype.slice.call(entryListEl.querySelectorAll('.entry-item'));

  function initMsFilter(rootId, onChange) {
    var root = document.getElementById(rootId);
    if (!root) return null;
    var btn = root.querySelector('.ms-filter-btn');
    var panel = root.querySelector('.ms-filter-panel');
    var labelEl = root.querySelector('.ms-filter-label');
    var defaultLabel = root.getAttribute('data-default-label') || '';
    var noun = root.getAttribute('data-noun') || 'item';
    var checkboxes = Array.prototype.slice.call(root.querySelectorAll('input[type="checkbox"]'));

    function selected() {
      return checkboxes.filter(function(c) { return c.checked; }).map(function(c) { return c.value; });
    }

    function updateLabel() {
      var checked = checkboxes.filter(function(c) { return c.checked; });
      if (checked.length === 0) {
        labelEl.textContent = defaultLabel;
        btn.classList.remove('has-selection');
      } else if (checked.length === 1) {
        labelEl.textContent = checked[0].parentElement.querySelector('span').textContent;
        btn.classList.add('has-selection');
      } else {
        labelEl.textContent = checked.length + ' ' + noun + 's';
        btn.classList.add('has-selection');
      }
    }

    function close() {
      panel.hidden = true;
      root.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
    }

    function open() {
      Array.prototype.slice.call(document.querySelectorAll('.ms-filter.open')).forEach(function(other) {
        if (other !== root) {
          other.classList.remove('open');
          other.querySelector('.ms-filter-panel').hidden = true;
          other.querySelector('.ms-filter-btn').setAttribute('aria-expanded', 'false');
        }
      });
      panel.hidden = false;
      root.classList.add('open');
      btn.setAttribute('aria-expanded', 'true');
    }

    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      if (panel.hidden) open(); else close();
    });

    checkboxes.forEach(function(c) {
      c.addEventListener('change', function() {
        updateLabel();
        onChange();
      });
    });

    document.addEventListener('click', function(e) {
      if (!root.contains(e.target)) close();
    });

    return { getSelected: selected };
  }

  function initOrderFilter(rootId, onChange) {
    var root = document.getElementById(rootId);
    if (!root) return null;
    var btn = root.querySelector('.ms-filter-btn');
    var panel = root.querySelector('.ms-filter-panel');
    var labelEl = root.querySelector('.ms-filter-label');
    var radios = Array.prototype.slice.call(root.querySelectorAll('input[type="radio"]'));

    function getSort() {
      var checked = radios.filter(function(r) { return r.checked; })[0];
      return checked ? checked.value : 'default';
    }

    function updateLabel() {
      var sortRadio = radios.filter(function(r) { return r.checked; })[0];
      var sortLabel = sortRadio ? sortRadio.parentElement.querySelector('span').textContent : 'List order';
      labelEl.textContent = sortLabel;
      var isDefault = !sortRadio || sortRadio.value === 'default';
      btn.classList.toggle('has-selection', !isDefault);
    }

    function close() {
      panel.hidden = true;
      root.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
    }

    function open() {
      Array.prototype.slice.call(document.querySelectorAll('.ms-filter.open')).forEach(function(other) {
        if (other !== root) {
          other.classList.remove('open');
          other.querySelector('.ms-filter-panel').hidden = true;
          other.querySelector('.ms-filter-btn').setAttribute('aria-expanded', 'false');
        }
      });
      panel.hidden = false;
      root.classList.add('open');
      btn.setAttribute('aria-expanded', 'true');
    }

    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      if (panel.hidden) open(); else close();
    });

    radios.forEach(function(input) {
      input.addEventListener('change', function() {
        updateLabel();
        onChange();
      });
    });

    document.addEventListener('click', function(e) {
      if (!root.contains(e.target)) close();
    });

    return { getSort: getSort };
  }

  function initProgressFilters(rootId, onChange) {
    var root = document.getElementById(rootId);
    if (!root) return { getSelectedStatus: function() { return []; } };
    var chips = Array.prototype.slice.call(root.querySelectorAll('.lst-filter-chip'));
    var OPPOSITES = { owned: 'unowned', unowned: 'owned', played: 'unplayed', unplayed: 'played' };

    chips.forEach(function(chip) {
      chip.addEventListener('click', function() {
        var status = chip.dataset.status;
        var opposite = root.querySelector('.lst-filter-chip[data-status="' + OPPOSITES[status] + '"]');
        chip.classList.toggle('active');
        if (chip.classList.contains('active') && opposite) opposite.classList.remove('active');
        onChange();
      });
    });

    function getSelectedStatus() {
      return chips.filter(function(c) { return c.classList.contains('active'); }).map(function(c) { return c.dataset.status; });
    }

    return { getSelectedStatus: getSelectedStatus };
  }

  function numOrNull(v) {
    return v === '' || v === null || v === undefined ? null : parseFloat(v);
  }

  function cmpNumeric(av, bv, ascending) {
    if (av === null && bv === null) return 0;
    if (av === null) return 1;
    if (bv === null) return -1;
    return ascending ? av - bv : bv - av;
  }

  var orderFilterCtl = initOrderFilter('order-filter', applyFilterSort);
  var progressFilterCtl = initProgressFilters('lst-progress-filters', applyFilterSort);
  var genreFilterCtl = initMsFilter('genre-filter', applyFilterSort);
  var yearFilterCtl = initMsFilter('year-filter', applyFilterSort);
  var devFilterCtl = initMsFilter('dev-filter', applyFilterSort);

  function applyFilterSort() {
    var q = ((searchInput && searchInput.value) || '').trim().toLowerCase();
    var sortBy = orderFilterCtl ? orderFilterCtl.getSort() : 'default';
    var statusFilters = progressFilterCtl.getSelectedStatus();
    var genreFilters = genreFilterCtl ? genreFilterCtl.getSelected() : [];
    var yearFilters = yearFilterCtl ? yearFilterCtl.getSelected() : [];
    var devFilters = devFilterCtl ? devFilterCtl.getSelected() : [];

    var sorted = items.slice().sort(function(a, b) {
      var idxA = parseInt(a.dataset.idx, 10);
      var idxB = parseInt(b.dataset.idx, 10);
      switch (sortBy) {
        case 'alpha':
          return a.dataset.title.localeCompare(b.dataset.title) || idxA - idxB;
        case 'score-desc':
          return cmpNumeric(numOrNull(a.dataset.score), numOrNull(b.dataset.score), false) || idxA - idxB;
        case 'score-asc':
          return cmpNumeric(numOrNull(a.dataset.score), numOrNull(b.dataset.score), true) || idxA - idxB;
        case 'hours-desc':
          return cmpNumeric(numOrNull(a.dataset.hours), numOrNull(b.dataset.hours), false) || idxA - idxB;
        case 'hours-asc':
          return cmpNumeric(numOrNull(a.dataset.hours), numOrNull(b.dataset.hours), true) || idxA - idxB;
        case 'added-desc':
          return cmpNumeric(numOrNull(a.dataset.added), numOrNull(b.dataset.added), false) || idxA - idxB;
        default:
          return idxA - idxB;
      }
    });

    sorted.forEach(function(item, i) { item.style.order = i; });

    var visibleCount = 0;
    items.forEach(function(item) {
      var matches = !q || item.dataset.title.indexOf(q) !== -1;
      if (matches && statusFilters.length) {
        var owned = item.dataset.owned === '1';
        var played = item.dataset.played === '1';
        matches = statusFilters.some(function(v) {
          if (v === 'owned') return owned;
          if (v === 'unowned') return !owned;
          if (v === 'played') return played;
          if (v === 'unplayed') return !played;
          return false;
        });
      }
      if (matches && genreFilters.length) {
        var genres = (item.dataset.genres || '').split('|');
        matches = genreFilters.some(function(g) { return genres.indexOf(g) !== -1; });
      }
      if (matches && yearFilters.length) {
        var yr = parseInt(item.dataset.year, 10);
        matches = !isNaN(yr) && yearFilters.some(function(v) {
          // "d:2000" matches the whole decade, "y:2007" matches that exact year
          if (v.charAt(0) === 'd') return Math.floor(yr / 10) * 10 === parseInt(v.slice(2), 10);
          return yr === parseInt(v.slice(2), 10);
        });
      }
      if (matches && devFilters.length) {
        var devs = (item.dataset.dev || '').split('|');
        matches = devFilters.some(function(d) { return devs.indexOf(d) !== -1; });
      }
      item.style.display = matches ? '' : 'none';
      if (matches) visibleCount++;
    });

    entryListEl.style.display = visibleCount === 0 ? 'none' : '';
    if (emptyFiltered) emptyFiltered.style.display = visibleCount === 0 ? '' : 'none';
  }

  if (searchInput) searchInput.addEventListener('input', applyFilterSort);
})();
</script>
