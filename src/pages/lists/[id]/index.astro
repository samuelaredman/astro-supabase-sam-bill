                      <span class="ms-filter-label">All genres</span>
                      <svg class="ms-filter-caret" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M2 3.5L5 6.5L8 3.5"/></svg>
                    </button>
                    <div class="ms-filter-panel" id="genre-filter-panel" hidden>
                      {allGenreNames.map((name) => (
                        <label class="ms-filter-option">
                          <input type="checkbox" value={name} />
                          <span>{name}</span>
                        </label>
                      ))}
                    </div>
                  </div>
                )}
                {yearFilterOptions.length > 0 && (
                  <div class="ms-filter" id="year-filter" data-default-label="All years" data-noun="year">
                    <button type="button" class="entry-sort ms-filter-btn" id="year-filter-btn" aria-haspopup="true" aria-expanded="false">
                      <span class="ms-filter-label">All years</span>
                      <svg class="ms-filter-caret" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M2 3.5L5 6.5L8 3.5"/></svg>
                    </button>
                    <div class="ms-filter-panel" id="year-filter-panel" hidden>
                      {yearFilterOptions.map((opt) => (
                        <label class={`ms-filter-option${opt.indent ? ' ms-filter-option--nested' : ''}`}>
                          <input type="checkbox" value={opt.value} />
                          <span>{opt.label}</span>
                        </label>
                      ))}
                    </div>
                  </div>
