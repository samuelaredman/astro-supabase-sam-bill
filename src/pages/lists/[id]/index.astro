---
export const prerender = false;
import { createSupabaseServerClientFromContext, getSupabaseAdmin } from "../../../utils/database";
import Layout from "../../../components/Layout.astro";
import { igdbImage, timeAgo } from "../../../utils/format";

const supabase = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await supabase.auth.getUser();
const isLoggedIn = !!user;
const { id } = Astro.params;

const db = getSupabaseAdmin() as any;

const { data: list } = await db
  .from("lists")
  .select("id, title, description, is_ranked, visibility, created_at, updated_at, profiles ( id, username, avatar_url )")
  .eq("id", id)
  .maybeSingle();

if (!list) return Astro.redirect("/404");

let currentProfile: any = null;
if (user) {
  const { data: cp } = await db.from("profiles").select("id, username, avatar_url").eq("auth_user_id", user.id).maybeSingle();
  currentProfile = cp;
}

// Private list: only visible to owner
if (list.visibility === "private") {
  if (!currentProfile || currentProfile.id !== list.profiles?.id) return Astro.redirect("/404");
}

const { data: entries } = await db
  .from("list_entries")
  .select("id, position, notes, added_at, games ( id, title, slug, cover_img_url, date_released )")
  .eq("list_id", id)
  .order("position", { ascending: true, nullsFirst: false })
  .order("added_at", { ascending: true });

const entryList = entries ?? [];

const { data: saveRow } = currentProfile
  ? await db.from("list_saves").select("id").eq("list_id", id).eq("profile_id", currentProfile.id).maybeSingle()
  : { data: null };
const isSaved = !!saveRow;

const { count: saveCount } = await db
  .from("list_saves")
  .select("*", { count: "exact", head: true })
  .eq("list_id", id);

const isOwner = currentProfile?.id === list.profiles?.id;

// Cover collage: first 4 covers
const collageSrcs = entryList
  .slice(0, 4)
  .map((e: any) => igdbImage(e.games?.cover_img_url, "t_cover_big"))
  .filter(Boolean) as string[];

function getInitials(name: string) { return (name ?? "?").slice(0, 2).toUpperCase(); }
---

<Layout
  title={`${list.title} — Chekpoint`}
  description={list.description ?? undefined}
  isLoggedIn={isLoggedIn}
  currentProfile={currentProfile}
>
<style is:global>
  .list-page { max-width: 680px; padding: 24px 20px 80px; }

  .list-back-btn { display: inline-flex; align-items: center; gap: 5px; font-size: 13px; font-family: inherit; color: var(--text-tertiary); background: none; border: none; cursor: pointer; padding: 0 0 20px; transition: color .15s; }
  .list-back-btn:hover { color: var(--text-secondary); }

  .list-header { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; margin-bottom: 20px; }

  .list-collage { display: grid; height: 180px; background: linear-gradient(135deg, #1a1030 0%, #0d1a2e 100%); position: relative; overflow: hidden; }
  [data-theme="light"] .list-collage { background: linear-gradient(135deg, #e8e4f8 0%, #dce8f5 100%); }
  .list-collage.collage-1 { grid-template-columns: 1fr; }
  .list-collage.collage-2 { grid-template-columns: 1fr 1fr; }
  .list-collage.collage-3 { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; }
  .list-collage.collage-3 .collage-img:first-child { grid-row: 1 / 3; }
  .list-collage.collage-4 { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; }
  .collage-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .collage-empty-icon { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 48px; opacity: .3; }
  .list-collage-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.6) 0%, transparent 60%); }

  .list-meta { padding: 20px 24px; }
  .list-badges { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }
  .list-badge { font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 10px; background: var(--tag-bg); color: var(--tag-text); text-transform: uppercase; letter-spacing: .06em; }
  .list-badge-ranked { background: rgba(96,80,200,.12); color: var(--accent); }
  .list-title { font-family: 'DM Serif Display', serif; font-size: 24px; font-weight: 400; line-height: 1.25; margin-bottom: 8px; }
  .list-description { font-size: 14px; color: var(--text-secondary); line-height: 1.65; margin-bottom: 16px; }
  .list-owner-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .owner-avatar { width: 22px; height: 22px; border-radius: 50%; background: var(--tag-bg); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 8px; font-weight: 700; overflow: hidden; flex-shrink: 0; color: var(--text-tertiary); }
  .owner-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .owner-link { font-size: 13px; color: var(--text-secondary); text-decoration: none; }
  .owner-link:hover { color: var(--text-primary); text-decoration: underline; }
  .list-stat { font-size: 13px; color: var(--text-tertiary); }
  .list-dot { color: var(--border); font-size: 12px; }
  .list-actions { display: flex; gap: 8px; margin-left: auto; }
  .btn-save { display: inline-flex; align-items: center; gap: 6px; padding: 7px 16px; border-radius: 20px; border: 1px solid var(--border); background: var(--tag-bg); color: var(--text-secondary); font-size: 13px; font-family: inherit; font-weight: 500; cursor: pointer; transition: all .15s; }
  .btn-save:hover { border-color: var(--accent); color: var(--accent); }
  .btn-save.saved { background: rgba(96,80,200,.1); border-color: var(--accent); color: var(--accent); }
  .btn-edit { display: inline-flex; align-items: center; gap: 6px; padding: 7px 16px; border-radius: 20px; border: 1px solid var(--border); background: var(--tag-bg); color: var(--text-secondary); font-size: 13px; font-family: inherit; font-weight: 500; cursor: pointer; text-decoration: none; transition: all .15s; }
  .btn-edit:hover { border-color: var(--text-tertiary); color: var(--text-primary); }

  .entry-list { display: flex; flex-direction: column; gap: 2px; }
  .entry-item { display: flex; align-items: flex-start; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--border-subtle); }
  .entry-item:last-child { border-bottom: none; }
  .entry-rank { width: 28px; flex-shrink: 0; font-family: 'DM Serif Display', serif; font-size: 18px; color: var(--text-tertiary); text-align: right; padding-top: 6px; line-height: 1; }
  .entry-cover { width: 48px; height: 64px; border-radius: 8px; object-fit: cover; flex-shrink: 0; border: 1px solid var(--border); background: var(--tag-bg); display: block; }
  .entry-cover-placeholder { width: 48px; height: 64px; border-radius: 8px; background: var(--tag-bg); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
  .entry-info { flex: 1; min-width: 0; padding-top: 4px; }
  .entry-game-link { font-size: 15px; font-weight: 600; color: var(--text-primary); text-decoration: none; display: block; margin-bottom: 4px; line-height: 1.3; }
  .entry-game-link:hover { text-decoration: underline; }
  .entry-year { font-size: 12px; color: var(--text-tertiary); margin-bottom: 6px; }
  .entry-notes { font-size: 13px; color: var(--text-secondary); line-height: 1.55; font-style: italic; }

  .empty-state { text-align: center; padding: 48px 20px; color: var(--text-tertiary); font-size: 14px; }
  .empty-state-title { font-size: 16px; font-weight: 600; color: var(--text-secondary); margin-bottom: 8px; }

  @media (max-width: 600px) {
    .list-meta { padding: 16px; }
    .list-title { font-size: 20px; }
  }
</style>

<main class="list-page">
  <button class="list-back-btn" onclick="history.length > 1 ? history.back() : (window.location.href='/')">
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12L6 8L10 4"/></svg>
    Back
  </button>

  <div class="list-header">
    <div class={`list-collage collage-${Math.max(1, Math.min(4, collageSrcs.length))}`}>
      {collageSrcs.length === 0 && <div class="collage-empty-icon">📋</div>}
      {collageSrcs.map((src) => (
        <img class="collage-img" src={src} alt="" loading="lazy" />
      ))}
      {collageSrcs.length > 0 && <div class="list-collage-overlay"></div>}
    </div>

    <div class="list-meta">
      <div class="list-badges">
        {list.is_ranked && <span class="list-badge list-badge-ranked">Ranked</span>}
        <span class="list-badge">{entryList.length} {entryList.length === 1 ? "game" : "games"}</span>
        {list.visibility === "private" && <span class="list-badge">Private</span>}
      </div>

      <h1 class="list-title">{list.title}</h1>
      {list.description && <p class="list-description">{list.description}</p>}

      <div class="list-owner-row">
        <a href={`/reviewers/${list.profiles?.username}`} class="owner-link" style="display:flex;align-items:center;gap:6px">
          <div class="owner-avatar">
            {list.profiles?.avatar_url
              ? <img src={list.profiles.avatar_url} alt={list.profiles.username} />
              : <span>{getInitials(list.profiles?.username ?? "?")}</span>
            }
          </div>
          @{list.profiles?.username}
        </a>
        <span class="list-dot">·</span>
        <span class="list-stat">Updated {timeAgo(list.updated_at ?? list.created_at)} ago</span>
        {(saveCount ?? 0) > 0 && (
          <>
            <span class="list-dot">·</span>
            <span class="list-stat">{saveCount} save{saveCount !== 1 ? "s" : ""}</span>
          </>
        )}
        <div class="list-actions">
          {isOwner
            ? <a href={`/lists/${list.id}/edit`} class="btn-edit">Edit list</a>
            : isLoggedIn
              ? <button
                  class={`btn-save${isSaved ? " saved" : ""}`}
                  id="save-btn"
                  data-list-id={list.id}
                  data-saved={isSaved ? "true" : "false"}
                >
                  {isSaved ? "Saved" : "Save list"}
                </button>
              : null
          }
        </div>
      </div>
    </div>
  </div>

  {entryList.length === 0
    ? <div class="empty-state">
        <div class="empty-state-title">No games yet</div>
        {isOwner && <p>Add some games to get started.</p>}
      </div>
    : <div class="entry-list">
        {entryList.map((entry: any, i: number) => {
          const cover = igdbImage(entry.games?.cover_img_url, "t_cover_big");
          const year = entry.games?.date_released ? new Date(entry.games.date_released).getFullYear() : null;
          return (
            <div class="entry-item">
              {list.is_ranked && (
                <div class="entry-rank">{entry.position ?? i + 1}</div>
              )}
              {cover
                ? <img class="entry-cover" src={cover} alt={entry.games?.title} loading="lazy" />
                : <div class="entry-cover-placeholder">🎮</div>
              }
              <div class="entry-info">
                <a href={`/games/${entry.games?.slug}`} class="entry-game-link">{entry.games?.title}</a>
                {year && <div class="entry-year">{year}</div>}
                {entry.notes && <div class="entry-notes">{entry.notes}</div>}
              </div>
            </div>
          );
        })}
      </div>
  }
</main>
</Layout>

<script is:inline define:vars={{ listId: list.id, initialSaved: isSaved, initialCount: saveCount ?? 0 }}>
  var saveBtn = document.getElementById('save-btn');
  if (saveBtn) {
    saveBtn.addEventListener('click', async function() {
      if (saveBtn.disabled) return;
      saveBtn.disabled = true;
      var wasSaved = saveBtn.dataset.saved === 'true';
      try {
        var res = await fetch('/api/lists/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ list_id: listId }),
        });
        if (res.status === 401) { window.location.href = '/signin'; return; }
        var data = await res.json();
        if (!res.ok) return;
        saveBtn.dataset.saved = data.saved ? 'true' : 'false';
        saveBtn.textContent = data.saved ? 'Saved' : 'Save list';
        saveBtn.classList.toggle('saved', data.saved);
      } catch(e) {
        saveBtn.dataset.saved = wasSaved ? 'true' : 'false';
      } finally {
        saveBtn.disabled = false;
      }
    });
  }
</script>
