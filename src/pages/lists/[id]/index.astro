---
export const prerender = false;
import { createSupabaseServerClientFromContext, getSupabaseAdmin } from "../../../utils/database";
import Layout from "../../../components/Layout.astro";
import { igdbImage, timeAgo, scoreClass } from "../../../utils/format";
import { IMAGE_EMOTES, IMAGE_EMOTE_MAP } from "../../../utils/reactions";

const supabase = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await supabase.auth.getUser();
const isLoggedIn = !!user;

// Cache the anonymous render at the CDN edge to cut function invocations under
// crawl load; logged-in (personalized) responses are never shared-cached.
if (!isLoggedIn) {
  Astro.response.headers.set('Netlify-CDN-Cache-Control', 'public, max-age=300, stale-while-revalidate=600');
  Astro.response.headers.set('Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}
Astro.response.headers.set('Netlify-Vary', 'cookie=sb-bzlwwtatoiyzwirerify-auth-token');

const { id } = Astro.params;

const db = getSupabaseAdmin() as any;

const { data: list } = await db
  .from("lists")
  .select("id, title, description, is_ranked, visibility, default_view, cover_image_url, created_at, updated_at, profiles ( id, username, avatar_url, search_indexable )")
  .eq("id", id)
  .maybeSingle();

if (!list) return Astro.redirect("/404");

let currentProfile: any = null;
if (user) {
  const { data: cp } = await db.from("profiles").select("id, username, avatar_url").eq("auth_user_id", user.id).maybeSingle();
  currentProfile = cp;
}

// Private list: only visible to owner
if (list.visibility === "private") {
  if (!currentProfile || currentProfile.id !== list.profiles?.id) return Astro.redirect("/404");
}

const [
  { data: entries },
  { data: saveRow },
  { count: saveCount },
  { data: votesRaw },
  { data: reactionsRaw },
  { data: commentsRaw },
] = await Promise.all([
  db.from("list_entries")
    .select("id, position, notes, added_at, games ( id, title, slug, cover_img_url, date_released )")
    .eq("list_id", id)
    .order("position", { ascending: true, nullsFirst: false })
    .order("added_at", { ascending: true }),
  currentProfile
    ? db.from("list_saves").select("id").eq("list_id", id).eq("profile_id", currentProfile.id).maybeSingle()
    : Promise.resolve({ data: null }),
  db.from("list_saves").select("*", { count: "exact", head: true }).eq("list_id", id),
  db.from("list_votes").select("vote, profile_id").eq("list_id", id),
  db.from("list_reactions").select("reaction_type, profile_id").eq("list_id", id),
  db.from("list_comments")
    .select("id, body, created_at, updated_at, parent_id, profiles ( id, username, avatar_url ), list_comment_votes ( vote, profile_id ), list_comment_reactions ( reaction_type, profile_id )")
    .eq("list_id", id)
    .order("created_at", { ascending: true }),
]);

const entryList = entries ?? [];
const isSaved = !!saveRow;
const isOwner = currentProfile?.id === list.profiles?.id;

// Fetch the list owner's published reviews for games in this list
const _gameIds = entryList.map((e: any) => e.games?.id).filter(Boolean);
const reviewByGameId: Record<string, { id: string; score: number; play_time_hours: number | null; platform_played_on: string | null }> = {};
if (_gameIds.length > 0 && list.profiles?.id) {
  const { data: _reviewRows } = await db
    .from('reviews')
    .select('id, game_id, score, play_time_hours, platform_played_on')
    .eq('profile_id', list.profiles.id)
    .eq('status', 'published')
    .in('game_id', _gameIds);
  for (const r of _reviewRows ?? []) {
    reviewByGameId[r.game_id] = { id: r.id, score: r.score, play_time_hours: r.play_time_hours, platform_played_on: r.platform_played_on ?? null };
  }
}

// Fetch the current viewer's own owned/played status for games in this list
// (not the list owner's — the filter and progress bars are about the person looking at the list)
const statusByGameId: Record<string, { owned: boolean; played: boolean }> = {};
const viewerReviewedGameIds = new Set<string>();
if (_gameIds.length > 0 && currentProfile?.id) {
  const [{ data: _statusRows }, { data: _viewerReviewRows }] = await Promise.all([
    db.from('user_game_status')
      .select('game_id, status, is_owned, steam_playtime_minutes')
      .eq('profile_id', currentProfile.id)
      .in('game_id', _gameIds),
    db.from('reviews')
      .select('game_id')
      .eq('profile_id', currentProfile.id)
      .eq('status', 'published')
      .in('game_id', _gameIds),
  ]);
  for (const r of _viewerReviewRows ?? []) viewerReviewedGameIds.add(r.game_id);
  const PLAYED_STATUSES = new Set(['completed', 'hundred_percent', 'dropped']);
  for (const s of (_statusRows ?? []) as any[]) {
    statusByGameId[s.game_id] = {
      owned: s.is_owned ?? false,
      // A logged review, tracked playtime, or a completed/100%/dropped status all count as "played".
      played: (s.steam_playtime_minutes ?? 0) > 0
        || viewerReviewedGameIds.has(s.game_id)
        || PLAYED_STATUSES.has(s.status),
    };
  }
}

// % of the list the current viewer owns / has played, for the sidebar progress bars
const ownedCount = entryList.reduce((n: number, e: any) => {
  const gid = e.games?.id;
  return n + (gid && statusByGameId[gid]?.owned ? 1 : 0);
}, 0);
const playedCount = entryList.reduce((n: number, e: any) => {
  const gid = e.games?.id;
  if (!gid) return n;
  const played = (statusByGameId[gid]?.played ?? false) || viewerReviewedGameIds.has(gid);
  return n + (played ? 1 : 0);
}, 0);
const ownedPct = entryList.length ? Math.round((ownedCount / entryList.length) * 100) : 0;
const playedPct = entryList.length ? Math.round((playedCount / entryList.length) * 100) : 0;

// Fetch genres and game companies in parallel
const [{ data: genreRows }, { data: companyRows }] = await Promise.all([
  _gameIds.length > 0
    ? db.from('game_genres').select('game_id, genres ( name )').in('game_id', _gameIds)
    : Promise.resolve({ data: [] }),
  _gameIds.length > 0
    ? db.from('game_companies').select('game_id, role, developers ( name )').in('game_id', _gameIds)
    : Promise.resolve({ data: [] }),
]);

// Genres
const genreCount: Record<string, number> = {};
const genreNamesByGameId: Record<string, string[]> = {};
for (const row of (genreRows ?? []) as any[]) {
  if (!row.genres?.name) continue;
  genreCount[row.genres.name] = (genreCount[row.genres.name] ?? 0) + 1;
  (genreNamesByGameId[row.game_id] ??= []).push(row.genres.name);
}
const topGenres = Object.entries(genreCount).sort((a, b) => b[1] - a[1]).slice(0, 4).map(([name, count]) => ({ name, count }));
const allGenreNames = Object.keys(genreCount).sort((a, b) => a.localeCompare(b));

// Developers & publishers
const devCount: Record<string, number> = {};
const pubCount: Record<string, number> = {};
const devNamesByGameId: Record<string, string[]> = {};
const pubNamesByGameId: Record<string, string[]> = {};
for (const row of (companyRows ?? []) as any[]) {
  const name = row.developers?.name;
  if (!name) continue;
  if (row.role === 'developer') {
    devCount[name] = (devCount[name] ?? 0) + 1;
    (devNamesByGameId[row.game_id] ??= []).push(name);
  } else if (row.role === 'publisher') {
    pubCount[name] = (pubCount[name] ?? 0) + 1;
    (pubNamesByGameId[row.game_id] ??= []).push(name);
  }
}
const topDevs = Object.entries(devCount).sort((a, b) => b[1] - a[1]).slice(0, 3).map(([name, count]) => ({ name, count }));
const topPubs = Object.entries(pubCount).sort((a, b) => b[1] - a[1]).slice(0, 3).map(([name, count]) => ({ name, count }));
const allDevNames = Object.keys(devCount).sort((a, b) => a.localeCompare(b));

// Computed stats
const reviewedEntries = Object.values(reviewByGameId);
const reviewedCount = reviewedEntries.length;
const totalHours = reviewedEntries.reduce((sum, r) => sum + (r.play_time_hours ?? 0), 0);
const avgScore = reviewedCount > 0
  ? reviewedEntries.reduce((sum, r) => sum + r.score, 0) / reviewedCount
  : null;
const releaseYears = (entryList as any[])
  .map((e) => e.games?.date_released ? new Date(e.games.date_released).getFullYear() : null)
  .filter((y): y is number => y !== null);
const minYear = releaseYears.length > 0 ? Math.min(...releaseYears) : null;
const maxYear = releaseYears.length > 0 ? Math.max(...releaseYears) : null;
const allReleaseYears = [...new Set(releaseYears)].sort((a, b) => b - a);
const uniqueDecades = new Set(releaseYears.map((y) => Math.floor(y / 10) * 10));
const useDecadeFilter = entryList.length >= 10 && uniqueDecades.size > 1;
// value prefix distinguishes a whole-decade selection ("d:2000") from a single year ("y:2007")
// so both can be selected at once and matched independently.
const yearFilterOptions: { value: string; label: string; indent?: boolean }[] = useDecadeFilter
  ? [...uniqueDecades].sort((a, b) => b - a).flatMap((d) => [
      { value: `d:${d}`, label: `${d}–${d + 9}` },
      ...allReleaseYears
        .filter((y) => Math.floor(y / 10) * 10 === d)
        .map((y) => ({ value: `y:${y}`, label: String(y), indent: true })),
    ])
  : allReleaseYears.map((y) => ({ value: `y:${y}`, label: String(y) }));

// Most played platform (from the owner's reviews)
const platformIds = [...new Set(reviewedEntries.map(r => r.platform_played_on).filter((p): p is string => !!p))];
const platformNameById: Record<string, string> = {};
if (platformIds.length > 0) {
  const { data: platRows } = await db.from('platforms').select('id, name').in('id', platformIds);
  for (const p of (platRows ?? []) as any[]) platformNameById[p.id] = p.name;
}
const platformCount: Record<string, number> = {};
for (const r of reviewedEntries) {
  if (r.platform_played_on && platformNameById[r.platform_played_on]) {
    const pname = platformNameById[r.platform_played_on];
    platformCount[pname] = (platformCount[pname] ?? 0) + 1;
  }
}
const topPlatforms = Object.entries(platformCount).sort((a, b) => b[1] - a[1]).slice(0, 3).map(([name, count]) => ({ name, count }));

const hasStats = topGenres.length > 0 || topDevs.length > 0 || topPubs.length > 0 || topPlatforms.length > 0 || totalHours > 0 || avgScore !== null || minYear !== null;

// Votes
const votesArr: { vote: number; profile_id: string }[] = votesRaw ?? [];
const upVotes = votesArr.filter(v => v.vote === 1).length;
const downVotes = votesArr.filter(v => v.vote === -1).length;
const netVotes = upVotes - downVotes;
const myVote = currentProfile
  ? (votesArr.find(v => v.profile_id === currentProfile.id)?.vote ?? 0)
  : 0;

// Reactions
const reactionsArr: { reaction_type: string; profile_id: string }[] = reactionsRaw ?? [];
const reactionCountMap: Record<string, { count: number; active: boolean }> = {};
for (const r of reactionsArr) {
  if (!reactionCountMap[r.reaction_type]) reactionCountMap[r.reaction_type] = { count: 0, active: false };
  reactionCountMap[r.reaction_type].count++;
  if (currentProfile && r.profile_id === currentProfile.id) reactionCountMap[r.reaction_type].active = true;
}
const displayReactions = Object.entries(reactionCountMap).map(([type, info]) => ({
  type,
  isImage: !!IMAGE_EMOTE_MAP[type],
  path: IMAGE_EMOTE_MAP[type] ?? null,
  count: info.count,
  active: info.active,
}));

// Comments
const commentList: any[] = commentsRaw ?? [];

function renderBody(text: string): string {
  const esc = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const withMentions = esc.replace(/(^|\s)(@([\w]+))/g, '$1<a class="lc-mention" href="/reviewers/$3">$2</a>');
  return withMentions.replace(/:([A-Za-z0-9_]+):/g, (_, key) => {
    const path = IMAGE_EMOTE_MAP[key];
    return path ? `<img src="${path}" class="lc-emote-inline" alt=":${key}:" title=":${key}:">` : `:${key}:`;
  });
}

function getLCVotes(comment: any) {
  const arr = Array.isArray(comment.list_comment_votes) ? comment.list_comment_votes : [];
  return {
    up: arr.filter((v: any) => v.vote === 1).length,
    down: arr.filter((v: any) => v.vote === -1).length,
    my: currentProfile ? (arr.find((v: any) => v.profile_id === currentProfile!.id)?.vote ?? 0) : 0,
  };
}

function getLCReactions(comment: any) {
  const arr: { reaction_type: string; profile_id: string }[] =
    Array.isArray(comment.list_comment_reactions) ? comment.list_comment_reactions : [];
  const map: Record<string, { count: number; active: boolean }> = {};
  for (const r of arr) {
    if (!map[r.reaction_type]) map[r.reaction_type] = { count: 0, active: false };
    map[r.reaction_type].count++;
    if (currentProfile && r.profile_id === currentProfile.id) map[r.reaction_type].active = true;
  }
  return Object.entries(map).map(([type, info]) => ({
    type,
    isImage: !!IMAGE_EMOTE_MAP[type],
    path: IMAGE_EMOTE_MAP[type] ?? null,
    count: info.count,
    active: info.active,
  }));
}

const topLevelComments = commentList.filter((c: any) => !c.parent_id);
const directReplyMap: Record<string, any[]> = {};
for (const c of commentList) {
  if (c.parent_id) {
    if (!directReplyMap[c.parent_id]) directReplyMap[c.parent_id] = [];
    directReplyMap[c.parent_id].push(c);
  }
}

// Cover: custom upload takes priority, otherwise a collage of the first 4 game covers
const collageSrcs = list.cover_image_url
  ? [list.cover_image_url]
  : entryList
      .slice(0, 4)
      .map((e: any) => igdbImage(e.games?.cover_img_url, "t_cover_big"))
      .filter(Boolean) as string[];

function getInitials(name: string) { return (name ?? "?").slice(0, 2).toUpperCase(); }

// Unlike Supabase auth redirects (which must match an exact allowlisted domain,
// so they use Astro.site), this URL is purely self-referential — it should point
// at whatever host is actually serving this request, so preview/branch deploys
// generate a working image URL instead of one pointing at production.
const ogImage = list.visibility !== "private"
  ? new URL(`/og/lists/${list.id}.jpg`, Astro.url.origin).toString()
  : undefined;
---

<Layout
  title={`${list.title} — Chekpoint`}
  description={list.description ?? undefined}
  ogImage={ogImage}
  isLoggedIn={isLoggedIn}
  currentProfile={currentProfile}
  noindex={!list.profiles?.search_indexable}
>
<style is:global>
  .list-page { min-width: 0; padding: 24px 20px 80px; }

  .list-back-btn { display: inline-flex; align-items: center; gap: 5px; font-size: 13px; font-family: inherit; color: var(--text-tertiary); background: none; border: none; cursor: pointer; padding: 0 0 20px; transition: color .15s; }
  .list-back-btn:hover { color: var(--text-secondary); }

  /* ── Header card (sidebar, under thumbnail) ── */
  .list-header {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 18px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    position: relative;
    overflow: hidden;
  }
  .list-header::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 260px 140px at 0% 0%, rgba(96,80,200,.10), transparent 70%);
    pointer-events: none;
  }
  .list-header::after {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(to right, var(--accent), transparent 70%);
    opacity: .7;
  }
  .list-header > * { position: relative; z-index: 1; }
  .list-badges { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .list-badge { font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 10px; background: var(--tag-bg); color: var(--tag-text); text-transform: uppercase; letter-spacing: .06em; }
  .list-badge-ranked { background: rgba(96,80,200,.12); color: var(--accent); }
  .list-title { font-family: 'DM Serif Display', serif; font-size: 22px; font-weight: 400; line-height: 1.25; }
  .list-description { font-size: 13px; color: var(--text-secondary); line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .list-owner-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .owner-avatar { width: 20px; height: 20px; border-radius: 50%; background: var(--tag-bg); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 8px; font-weight: 700; overflow: hidden; flex-shrink: 0; color: var(--text-tertiary); }
  .owner-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .owner-link { font-size: 13px; color: var(--text-secondary); text-decoration: none; }
  .owner-link:hover { color: var(--text-primary); text-decoration: underline; }
  .list-stat { font-size: 13px; color: var(--text-tertiary); }
  .list-dot { color: var(--border); font-size: 12px; }
  .btn-edit { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 7px 16px; border-radius: 20px; border: 1px solid var(--border); background: var(--tag-bg); color: var(--text-secondary); font-size: 13px; font-family: inherit; font-weight: 500; cursor: pointer; text-decoration: none; transition: all .15s; align-self: flex-start; }
  .btn-edit:hover { border-color: var(--text-tertiary); color: var(--text-primary); }

  /* ── Two-column body ── */
  .list-body { display: grid; grid-template-columns: 1fr 320px; gap: 20px; align-items: start; }

  /* Fixed column counts per breakpoint rather than auto-fill, which packed 6
     covers at desktop width and varied with the container.
     minmax(0, 1fr) — not a bare 1fr — because 1fr means minmax(auto, 1fr) and
     the auto floor lets a track refuse to shrink below its content, pushing the
     grid past its container. The 0 floor guarantees it always fits. */
  .entry-list { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; padding: 4px 0; }
  .entry-item { display: flex; flex-direction: column; }
  .entry-cover-wrap {
    position: relative; width: 100%; aspect-ratio: 3/4;
    border-radius: 8px; overflow: hidden;
    background: var(--tag-bg); border: 1px solid var(--border);
    box-shadow: 0 2px 8px rgba(0,0,0,.15);
    transition: transform .15s, box-shadow .15s;
    display: flex; align-items: center; justify-content: center; font-size: 24px;
  }
  .entry-item:hover .entry-cover-wrap { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,.3); }
  .entry-cover { width: 100%; height: 100%; object-fit: cover; display: block; }
  .entry-cover-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 24px; }
  .entry-rank { position: absolute; bottom: 5px; left: 5px; font-family: 'DM Serif Display', serif; font-size: 13px; font-weight: 700; background: rgba(0,0,0,.72); color: #fff; border-radius: 4px; padding: 1px 6px; line-height: 1.5; z-index: 1; }
  .entry-item:nth-child(1) .entry-rank, .entry-item:nth-child(1) .entry-rank-inline { color: #F5C842; }
  .entry-item:nth-child(2) .entry-rank, .entry-item:nth-child(2) .entry-rank-inline { color: #B8BCC8; }
  .entry-item:nth-child(3) .entry-rank, .entry-item:nth-child(3) .entry-rank-inline { color: #C87941; }
  .entry-info { margin-top: 6px; }
  .entry-game-link { font-size: 12px; font-weight: 500; color: var(--text-secondary); text-decoration: none; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.35; }
  .entry-game-link:hover { color: var(--text-primary); }
  .entry-notes { font-size: 11px; color: var(--text-tertiary); line-height: 1.35; font-style: italic; margin-top: 3px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .entry-review-link { font-size: 11px; color: var(--accent); text-decoration: none; font-weight: 500; margin-top: 4px; display: inline-block; opacity: .85; }
  .entry-review-link:hover { opacity: 1; text-decoration: underline; }
  .entry-list.list-view .entry-review-link { font-size: 11px; margin-top: 2px; }
  .entry-score-badge { position: absolute; bottom: 4px; right: 4px; min-width: 22px; height: 20px; padding: 0 5px; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; font-family: 'DM Serif Display', serif; z-index: 1; }
  .entry-score-badge.score-perfect { background: rgba(255,255,255,.95); color: #09090a; border: 1px solid rgba(255,255,255,.9); }
  .entry-score-badge.score-great   { background: rgba(11,32,22,.85);   color: #4ade80; border: 1px solid rgba(74,222,128,.4); }
  .entry-score-badge.score-teal    { background: rgba(11,30,28,.85);   color: #2dd4bf; border: 1px solid rgba(45,212,191,.4); }
  .entry-score-badge.score-good    { background: rgba(11,24,40,.85);   color: #60a5fa; border: 1px solid rgba(96,165,250,.4); }
  .entry-score-badge.score-mid     { background: rgba(26,20,0,.85);    color: #fbbf24; border: 1px solid rgba(251,191,36,.4); }
  .entry-score-badge.score-orange  { background: rgba(31,16,8,.85);    color: #fb923c; border: 1px solid rgba(251,146,60,.4); }
  .entry-score-badge.score-low     { background: rgba(32,8,8,.85);     color: #f87171; border: 1px solid rgba(248,113,113,.4); }
  .entry-hours-badge { position: absolute; top: 4px; left: 4px; font-size: 10px; font-weight: 600; background: rgba(0,0,0,.65); color: rgba(255,255,255,.85); border-radius: 3px; padding: 2px 5px; line-height: 1.3; z-index: 1; }

  /* ── List controls: search, sort, view toggle ── */
  .list-controls { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
  .list-controls-left { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0; flex-wrap: wrap; }
  .entry-search-wrap { position: relative; flex: 1 1 180px; min-width: 140px; max-width: 240px; }
  .entry-search-wrap svg { position: absolute; left: 9px; top: 50%; transform: translateY(-50%); color: var(--text-tertiary); pointer-events: none; }
  .entry-search { width: 100%; padding: 6px 10px 6px 28px; border-radius: 8px; border: 1px solid var(--border); background: var(--bg-card); color: var(--text-primary); font-size: 13px; font-family: inherit; }
  .entry-search:focus { outline: none; border-color: var(--accent); }
  .entry-sort { flex: 1 1 130px; min-width: 110px; max-width: 200px; padding: 6px 10px; border-radius: 8px; border: 1px solid var(--border); background: var(--bg-card); color: var(--text-secondary); font-size: 13px; font-family: inherit; cursor: pointer; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; }
  .entry-sort:focus { outline: none; border-color: var(--accent); }
  .entry-empty-filtered { display: none; text-align: center; padding: 32px 20px; color: var(--text-tertiary); font-size: 13px; }

  /* ── Multi-select filter dropdowns ── */
  .ms-filter { position: relative; flex: 1 1 130px; min-width: 110px; max-width: 200px; }
  .ms-filter-btn { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 6px; flex: none; max-width: none; }
  .ms-filter-btn.has-selection { border-color: var(--accent); color: var(--text-primary); }
  .ms-filter-caret { flex-shrink: 0; color: var(--text-tertiary); transition: transform .15s ease; }
  .ms-filter.open .ms-filter-caret { transform: rotate(180deg); }
  .ms-filter-panel { position: absolute; top: calc(100% + 4px); left: 0; z-index: 20; min-width: 100%; max-height: 260px; overflow-y: auto; background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px; box-shadow: 0 8px 24px rgba(0,0,0,.25); padding: 4px; }
  .ms-filter-option { display: flex; align-items: center; gap: 7px; padding: 6px 8px; border-radius: 6px; font-size: 13px; color: var(--text-secondary); white-space: nowrap; cursor: pointer; }
  .ms-filter-option:hover { background: var(--bg-hover); color: var(--text-primary); }
  .ms-filter-option--nested { padding-left: 22px; font-size: 12px; color: var(--text-tertiary); }
  .ms-filter-option input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    width: 14px;
    height: 14px;
    margin: 0;
    flex-shrink: 0;
    border-radius: 4px;
    border: 1.5px solid var(--border);
    background: transparent;
    cursor: pointer;
    position: relative;
    transition: background .15s ease, border-color .15s ease;
  }
  .ms-filter-option:hover input[type="checkbox"] { border-color: var(--text-tertiary); }
  .ms-filter-option input[type="checkbox"]:checked {
    background: var(--accent);
    border-color: var(--accent);
  }
  .ms-filter-option input[type="checkbox"]:checked::after {
    content: '';
    position: absolute;
    left: 4px;
    top: 1px;
    width: 3px;
    height: 7px;
    border: solid #fff;
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }
  .ms-filter-option input[type="radio"] {
    appearance: none;
    -webkit-appearance: none;
    width: 14px;
    height: 14px;
    margin: 0;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1.5px solid var(--border);
    background: transparent;
    cursor: pointer;
    position: relative;
    transition: border-color .15s ease;
  }
  .ms-filter-option:hover input[type="radio"] { border-color: var(--text-tertiary); }
  .ms-filter-option input[type="radio"]:checked { border-color: var(--accent); }
  .ms-filter-option input[type="radio"]:checked::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .ms-filter-section-label { padding: 6px 8px 2px; font-size: 10px; font-weight: 700; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: .06em; }

  /* ── View toggle ── */
  .view-toggle-row { display: flex; gap: 4px; flex-shrink: 0; }
  .view-toggle-btn { padding: 5px 8px; border-radius: 7px; border: 1px solid var(--border); background: transparent; color: var(--text-tertiary); cursor: pointer; transition: background .15s, color .15s, border-color .15s; line-height: 0; }
  .view-toggle-btn:hover { color: var(--text-secondary); }
  .view-toggle-btn.active { background: var(--bg-hover); color: var(--text-primary); border-color: var(--text-secondary); }

  /* ── List-view overrides ── */
  .entry-rank-inline { display: none; width: 26px; text-align: right; font-family: 'DM Serif Display', serif; font-size: 16px; color: var(--text-tertiary); flex-shrink: 0; align-self: flex-start; padding-top: 14px; line-height: 1; }
  .entry-list.list-view { display: flex; flex-direction: column; background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; padding: 0 20px; gap: 0; }
  .entry-list.list-view .entry-item { flex-direction: row; align-items: flex-start; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--border-subtle); }
  .entry-list.list-view .entry-item:last-child { border-bottom: none; }
  .entry-list.list-view .entry-item:hover .entry-cover-wrap { transform: none; box-shadow: 0 2px 8px rgba(0,0,0,.12); }
  .entry-list.list-view .entry-cover-wrap { width: 68px; height: 91px; aspect-ratio: unset; border-radius: 7px; flex-shrink: 0; }
  .entry-list.list-view .entry-info { flex: 1; min-width: 0; margin-top: 0; padding-top: 2px; }
  .entry-list.list-view .entry-game-link { font-size: 14px; font-weight: 600; color: var(--text-primary); -webkit-line-clamp: unset; }
  .entry-list.list-view .entry-notes { display: block; -webkit-line-clamp: unset; overflow: visible; font-size: 13px; margin-top: 4px; }
  .entry-list.list-view .entry-rank { display: none; }
  .entry-list.list-view .entry-rank-inline { display: block; }

  .empty-state { text-align: center; padding: 48px 20px; color: var(--text-tertiary); font-size: 14px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; }
  .empty-state-title { font-size: 16px; font-weight: 600; color: var(--text-secondary); margin-bottom: 8px; }

  /* ── Sidebar ── */
  .list-sidebar {
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: sticky;
    top: 20px;
    /* 20px top gap + 20px bottom gap, minus whatever the fixed site footer
       (Footer.astro) currently measures itself at — otherwise the last
       item in the sidebar ends up permanently hidden under the footer. */
    max-height: calc(100vh - 40px - var(--site-footer-h, 90px));
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .list-sidebar > * { flex-shrink: 0; }

  /* ── Cover mosaic in sidebar ── */
  .list-mosaic {
    width: 100%;
    aspect-ratio: 4/3;
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    gap: 2px;
    background: linear-gradient(135deg, #1a1030 0%, #0d1a2e 100%);
    position: relative;
    border: 1px solid var(--border);
  }
  [data-theme="light"] .list-mosaic { background: linear-gradient(135deg, #e8e4f8 0%, #dce8f5 100%); }
  .mosaic-img { flex: 1; min-width: 0; height: 100%; object-fit: cover; display: block; }
  .mosaic-empty-icon { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 40px; opacity: .3; }

  /* ── Sidebar stats strip ── */
  .sidebar-stats {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 12px 16px;
    display: flex;
    gap: 0;
  }
  .sidebar-stat { flex: 1; text-align: center; }
  .sidebar-stat + .sidebar-stat { border-left: 1px solid var(--border-subtle); }
  .sidebar-stat-value { font-size: 18px; font-weight: 700; color: var(--text-primary); line-height: 1.2; }
  .sidebar-stat-value.stat-positive { color: #4ade80; }
  .sidebar-stat-value.stat-negative { color: #f87171; }
  .sidebar-stat-label { font-size: 12px; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: .06em; margin-top: 2px; }

  /* ── Vote / react bar ── */
  .list-interact {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .list-vote-btn {
    font-size: 12px;
    font-weight: 600;
    padding: 5px 14px;
    border-radius: 20px;
    border: 1.5px solid var(--border);
    color: var(--text-tertiary);
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s;
  }
  .list-vote-btn:hover:not(.lv-up):not(.lv-down) { border-color: var(--text-tertiary); color: var(--text-secondary); background: var(--bg-hover); }
  .list-vote-btn:disabled { opacity: 0.5; cursor: default; }
  .lv-up { border-color: #4ade80; color: #4ade80; background: rgba(74,222,128,.08); }
  .lv-down { border-color: #f87171; color: #f87171; background: rgba(248,113,113,.08); }
  .list-save-btn.saved { border-color: var(--accent); color: var(--accent); background: rgba(96,80,200,.08); }
  .list-sep { width: 1px; height: 16px; background: var(--border); margin: 0 2px; flex-shrink: 0; }

  /* ── Owned / played progress ── */
  .lst-progress { display: flex; flex-direction: column; gap: 10px; padding: 2px 4px; }
  .lst-progress-row { display: flex; flex-direction: column; gap: 5px; }
  .lst-progress-label { display: flex; justify-content: space-between; align-items: baseline; font-size: 11px; font-weight: 600; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: .05em; }
  .lst-progress-label span:last-child { font-size: 12px; font-weight: 700; color: var(--text-secondary); text-transform: none; letter-spacing: normal; }
  .lst-progress-track { height: 5px; border-radius: 3px; background: var(--border-subtle); overflow: hidden; }
  .lst-progress-fill { height: 100%; border-radius: 3px; transition: width .3s ease; }
  .lst-progress-fill.lst-progress-owned { background: var(--accent); }
  .lst-progress-fill.lst-progress-played { background: #4ade80; }
  .lst-progress-filters { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 4px; }
  .lst-filter-chip {
    font-size: 11px; font-weight: 600; padding: 6px 8px; border-radius: 8px;
    border: 1.5px solid var(--border); color: var(--text-tertiary); background: transparent;
    cursor: pointer; font-family: inherit; transition: all 0.15s; text-align: center;
  }
  .lst-filter-chip:hover { border-color: var(--text-tertiary); color: var(--text-secondary); background: var(--bg-hover); }
  .lst-filter-chip.active { border-color: var(--accent); color: var(--accent); background: rgba(96,80,200,.1); }

  /* ── List stats card ── */
  .list-stats-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .lst-numbers {
    display: flex;
    gap: 0;
  }
  .lst-num { position: relative; flex: 1; text-align: center; }
  .lst-num + .lst-num::before {
    content: '';
    position: absolute;
    left: 0;
    top: 15%;
    bottom: 15%;
    width: 1px;
    background: var(--border-subtle);
  }
  .lst-val {
    font-size: 22px;
    font-weight: 700;
    font-family: 'DM Serif Display', serif;
    color: var(--text-primary);
    line-height: 1.1;
  }
  .lst-val.score-perfect { color: #F5C842; }
  .lst-val.score-great   { color: #4ade80; }
  .lst-val.score-teal    { color: #2dd4bf; }
  .lst-val.score-good    { color: #60a5fa; }
  .lst-val.score-mid     { color: #fbbf24; }
  .lst-val.score-orange  { color: #fb923c; }
  .lst-val.score-low     { color: #f87171; }
  .lst-lab {
    font-size: 11px;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: .06em;
    margin-top: 3px;
  }
  .lst-divider {
    height: 1px;
    background: var(--border-subtle);
    margin: 0 -16px;
  }
  .lst-genres {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .lst-genre-chip {
    font-size: 11px;
    font-weight: 500;
    padding: 3px 8px;
    border-radius: 8px;
    background: var(--bg-hover);
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    max-width: 180px;
    min-width: 0;
    overflow: hidden;
    gap: 4px;
  }
  .lst-genre-n {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-tertiary);
  }
  .lst-chip-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    flex-shrink: 1;
  }
  .lst-detail {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .lst-detail-collapse { }
  .lst-detail-collapse .lst-detail { margin-top: 10px; }
  .lst-detail-summary {
    cursor: pointer;
    font-size: 11px;
    font-weight: 700;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: .06em;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 6px;
    user-select: none;
  }
  .lst-detail-summary::-webkit-details-marker { display: none; }
  .lst-detail-summary::before {
    content: '▸';
    display: inline-block;
    font-size: 10px;
    transition: transform .15s;
    color: var(--text-tertiary);
  }
  .lst-detail-collapse[open] .lst-detail-summary::before { transform: rotate(90deg); }
  .lst-detail-summary:hover { color: var(--text-secondary); }
  .lst-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .lst-row-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: .06em;
    flex-shrink: 0;
    width: 78px;
    line-height: 22px;
  }
  .lst-year {
    font-size: 13px;
    color: var(--text-secondary);
    font-weight: 500;
  }
  .lst-year-sub {
    font-size: 12px;
    color: var(--text-tertiary);
    margin-left: 4px;
  }

  .list-reaction-wrap { display: inline-flex; align-items: center; gap: 4px; flex-wrap: wrap; }
  .list-reaction-btn {
    font-size: 12px;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 20px;
    border: 1.5px solid var(--border);
    color: var(--text-tertiary);
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
  }
  .list-reaction-btn:hover:not(.lr-active) { border-color: var(--text-tertiary); color: var(--text-secondary); background: var(--bg-hover); }
  .lr-active { border-color: var(--accent); color: var(--accent); background: rgba(99,102,241,.08); }
  .list-react-toggle {
    background: none;
    border: 1.5px solid var(--border);
    cursor: pointer;
    color: var(--text-secondary);
    font-size: 15px;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 6px;
    font-family: inherit;
    transition: all 0.15s;
  }
  .list-react-toggle:hover { color: var(--text-primary); background: var(--bg-hover); border-color: var(--text-tertiary); }
  .list-emote-img { width: 18px; height: 18px; object-fit: contain; vertical-align: middle; }

  /* ── Comments ── */
  .list-comments {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px;
  }
  .list-comments-title { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--text-tertiary); margin-bottom: 16px; }
  .lc-list { display: flex; flex-direction: column; gap: 0; }
  .lc-item { display: flex; gap: 10px; padding: 12px 0; border-bottom: 1px solid var(--border-subtle); }
  .lc-item:last-child { border-bottom: none; }
  .lc-avatar {
    width: 28px; height: 28px; border-radius: 50%; overflow: hidden; flex-shrink: 0;
    background: var(--tag-bg); border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-size: 10px; font-weight: 700; color: var(--text-tertiary); text-decoration: none;
  }
  .lc-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .lc-body { flex: 1; min-width: 0; }
  .lc-meta { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; flex-wrap: wrap; }
  .lc-username { font-size: 13px; font-weight: 600; color: var(--text-primary); text-decoration: none; }
  .lc-username:hover { color: var(--accent); }
  .lc-ts { font-size: 12px; color: var(--text-tertiary); }
  .lc-text { font-size: 13px; color: var(--text-primary); line-height: 1.6; opacity: .85; white-space: pre-wrap; word-break: break-word; }
  .lc-delete { background: none; border: none; cursor: pointer; color: var(--text-tertiary); font-size: 11px; padding: 2px 6px; border-radius: 4px; font-family: inherit; margin-left: auto; transition: color .15s; }
  .lc-delete:hover { color: #f87171; }
  .lc-empty { padding: 16px 0; text-align: center; font-size: 13px; color: var(--text-tertiary); }

  /* ── Comment form ── */
  .lc-form { margin-top: 16px; display: flex; flex-direction: column; gap: 10px; }
  .lc-signin-prompt { font-size: 13px; color: var(--text-tertiary); padding: 14px; background: var(--bg-hover); border-radius: 10px; text-align: center; }
  .lc-signin-prompt a { color: var(--accent); text-decoration: none; }
  .lc-textarea {
    width: 100%; padding: 10px 14px; border-radius: 10px; border: 1px solid var(--border);
    background: var(--bg); color: var(--text-primary); font-size: 13px;
    font-family: inherit; outline: none; resize: vertical; min-height: 64px;
    transition: border-color .15s; box-sizing: border-box;
  }
  .lc-textarea:focus { border-color: var(--accent); }
  .lc-submit {
    align-self: flex-end; background: var(--accent); color: #fff; border: none;
    padding: 7px 18px; border-radius: 20px; font-size: 13px; font-weight: 600;
    font-family: inherit; cursor: pointer; transition: opacity .15s;
  }
  .lc-submit:hover { opacity: .85; }
  .lc-submit:disabled { opacity: .45; cursor: not-allowed; }
  .lc-error { font-size: 13px; color: #f87171; display: none; }

  /* ── Threaded comments ── */
  .lct { display: flex; flex-direction: column; gap: 0; }
  .lc-replies { margin-left: 20px; border-left: 2px solid var(--border-subtle); padding-left: 10px; }
  .lc-replies-deep { margin-left: 16px; }
  .lc-reply { padding: 10px 0 6px; border-bottom: none; }
  .lc-avatar-sm { width: 22px !important; height: 22px !important; min-width: 22px !important; font-size: 8px !important; }
  .lc-avatar-sm img { width: 22px !important; height: 22px !important; }
  .lc-edited { font-size: 11px; color: var(--text-tertiary); font-style: italic; }
  .lc-mention { color: var(--accent); text-decoration: none; }
  .lc-mention:hover { text-decoration: underline; }
  .lc-emote-inline { width: 16px; height: 16px; object-fit: contain; vertical-align: middle; }

  /* ── Comment actions row ── */
  .lc-actions {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
    margin-top: 5px;
  }
  .lcv-btn {
    font-size: 10px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 14px;
    border: 1.5px solid var(--border);
    color: var(--text-tertiary);
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s;
    line-height: 1.4;
  }
  .lcv-btn:hover:not(.lcv-up):not(.lcv-down) { border-color: var(--text-tertiary); color: var(--text-secondary); background: var(--bg-hover); }
  .lcv-btn:disabled { opacity: 0.5; cursor: default; }
  .lcv-up   { border-color: #4ade80; color: #4ade80; background: rgba(74,222,128,.08); }
  .lcv-down { border-color: #f87171; color: #f87171; background: rgba(248,113,113,.08); }

  .lcrx-wrap { display: inline-flex; align-items: center; gap: 3px; flex-wrap: wrap; }
  .lcrx-btn {
    font-size: 10px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 14px;
    border: 1.5px solid var(--border);
    color: var(--text-tertiary);
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    white-space: nowrap;
    line-height: 1.4;
  }
  .lcrx-btn:hover:not(.lcrx-active) { border-color: var(--text-tertiary); color: var(--text-secondary); background: var(--bg-hover); }
  .lcrx-active { border-color: var(--accent); color: var(--accent); background: rgba(99,102,241,.08); }
  .lcrx-toggle {
    background: none;
    border: 1.5px solid var(--border);
    cursor: pointer;
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 5px;
    font-family: inherit;
    transition: all 0.15s;
    line-height: 1.5;
  }
  .lcrx-toggle:hover { color: var(--text-primary); background: var(--bg-hover); border-color: var(--text-tertiary); }
  .lcrx-emote-img { width: 14px; height: 14px; object-fit: contain; vertical-align: middle; }

  .lc-reply-btn, .lc-edit-btn, .lc-delete-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 10px;
    font-weight: 500;
    color: var(--text-tertiary);
    font-family: inherit;
    padding: 2px 5px;
    border-radius: 4px;
    transition: color 0.15s;
    line-height: 1.4;
  }
  .lc-reply-btn:hover { color: var(--accent); }
  .lc-edit-btn:hover  { color: var(--text-secondary); }
  .lc-delete-btn:hover { color: #f87171; }

  /* ── Reply form ── */
  .lc-rf {
    margin: 6px 0 8px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .lc-rf-ta {
    width: 100%;
    padding: 7px 10px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text-primary);
    font-size: 12px;
    font-family: inherit;
    outline: none;
    resize: vertical;
    min-height: 52px;
    transition: border-color .15s;
    box-sizing: border-box;
  }
  .lc-rf-ta:focus { border-color: var(--accent); }
  .lc-rf-foot { display: flex; justify-content: flex-end; gap: 6px; align-items: center; }
  .lc-rf-cancel {
    background: none; border: 1px solid var(--border); padding: 4px 10px;
    border-radius: 14px; font-size: 11px; font-family: inherit; color: var(--text-secondary);
    cursor: pointer; transition: all .15s;
  }
  .lc-rf-cancel:hover { border-color: var(--text-tertiary); }
  .lc-rf-submit {
    background: var(--accent); color: #fff; border: none; padding: 4px 12px;
    border-radius: 14px; font-size: 11px; font-weight: 600; font-family: inherit;
    cursor: pointer; transition: opacity .15s;
  }
  .lc-rf-submit:hover { opacity: .85; }
  .lc-rf-submit:disabled { opacity: .45; cursor: not-allowed; }

  /* ── Comment edit inline ── */
  .lc-edit-wrap { margin-top: 6px; }
  .lc-edit-ta {
    width: 100%; padding: 7px 10px; border-radius: 8px; border: 1px solid var(--border);
    background: var(--bg); color: var(--text-primary); font-size: 12px;
    font-family: inherit; outline: none; resize: vertical; min-height: 52px;
    transition: border-color .15s; box-sizing: border-box;
  }
  .lc-edit-ta:focus { border-color: var(--accent); }
  .lc-edit-foot { display: flex; justify-content: flex-end; gap: 6px; margin-top: 4px; }
  .lc-edit-cancel {
    background: none; border: 1px solid var(--border); padding: 4px 10px;
    border-radius: 14px; font-size: 11px; font-family: inherit; color: var(--text-secondary);
    cursor: pointer; transition: all .15s;
  }
  .lc-edit-cancel:hover { border-color: var(--text-tertiary); }
  .lc-edit-save {
    background: var(--accent); color: #fff; border: none; padding: 4px 12px;
    border-radius: 14px; font-size: 11px; font-weight: 600; font-family: inherit;
    cursor: pointer; transition: opacity .15s;
  }
  .lc-edit-save:hover { opacity: .85; }
  .lc-edit-save:disabled { opacity: .45; cursor: not-allowed; }

  /* ── Comment emoji picker ── */
  #ldpc-emoji-picker {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px;
    padding: 10px 12px; box-shadow: 0 4px 24px rgba(0,0,0,.2);
    max-height: 280px; overflow-y: auto; min-width: 220px; max-width: 280px;
    scrollbar-width: thin; position: fixed; z-index: 1000; display: none;
  }
  .ldpc-search {
    width: 100%; box-sizing: border-box; margin-bottom: 8px; padding: 5px 8px;
    border-radius: 6px; border: 1px solid var(--border); background: var(--bg-hover);
    color: var(--text-primary); font-size: 12px; outline: none;
  }
  .ldpc-search:focus { border-color: var(--accent); }
  .ldpc-grid { display: flex; flex-wrap: wrap; gap: 2px; }
  .ldpc-pick {
    width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;
    background: none; border: none; cursor: pointer; border-radius: 6px;
    transition: background 0.1s, transform 0.1s; padding: 2px;
  }
  .ldpc-pick:hover { background: var(--bg-hover); transform: scale(1.2); }
  .ldpc-pick.ldpc-active { background: rgba(96,80,200,.12); outline: 1.5px solid var(--accent); }
  .ldpc-pick img { width: 24px; height: 24px; object-fit: contain; display: block; }

  /* ── Emoji picker for detail page ── */
  #ldp-emoji-picker {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px;
    padding: 10px 12px; box-shadow: 0 4px 24px rgba(0,0,0,.2);
    max-height: 320px; overflow-y: auto; min-width: 260px; max-width: 320px;
    scrollbar-width: thin; position: fixed; z-index: 1000; display: none;
  }
  .ldp-emote-search {
    width: 100%; box-sizing: border-box; margin-bottom: 8px; padding: 5px 8px;
    border-radius: 6px; border: 1px solid var(--border); background: var(--bg-hover);
    color: var(--text-primary); font-size: 12px; outline: none;
  }
  .ldp-emote-search:focus { border-color: var(--accent); }
  .ldp-emoji-grid { display: flex; flex-wrap: wrap; gap: 2px; }
  .ldp-emoji-pick {
    width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;
    background: none; border: none; cursor: pointer; border-radius: 6px;
    transition: background 0.1s, transform 0.1s; padding: 2px;
  }
  .ldp-emoji-pick:hover { background: var(--bg-hover); transform: scale(1.2); }
  .ldp-emoji-pick.ldp-emoji-active { background: rgba(96,80,200,.12); outline: 1.5px solid var(--accent); }
  .ldp-emote-picker-img { width: 28px; height: 28px; object-fit: contain; display: block; }

  /* Breakpoints run largest-to-smallest so the narrowest match wins.
     Above 1100px the left column sits next to the 320px sidebar and fits 5. */
  @media (max-width: 1100px) {
    .entry-list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  @media (max-width: 760px) {
    .list-body { grid-template-columns: 1fr; }
    .list-sidebar { order: -1; position: static; max-height: none; overflow-y: visible; }
    .list-mosaic { aspect-ratio: 16/7; }
    .entry-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* Small phones (SE / mini): 3 covers per row get too cramped to read. */
  @media (max-width: 380px) {
    .entry-list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  }
</style>

<main class="list-page">
  <button class="list-back-btn" onclick="history.length > 1 ? history.back() : (window.location.href='/')">
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12L6 8L10 4"/></svg>
    Back
  </button>

  <!-- Two-column body -->
  <div class="list-body">
    <!-- Left: game entries -->
    <div>
      {entryList.length === 0
        ? <div class="empty-state">
            <div class="empty-state-title">No games yet</div>
            {isOwner && <p>Add some games to get started.</p>}
