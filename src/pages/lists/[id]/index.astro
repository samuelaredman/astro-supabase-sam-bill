                  </button>
                  <div class="ms-filter-panel" id="order-filter-panel" hidden>
                    <div class="ms-filter-section-label">Sort by</div>
                    <label class="ms-filter-option"><input type="radio" name="entry-sort-radio" value="default" checked /><span>List order</span></label>
                    <label class="ms-filter-option"><input type="radio" name="entry-sort-radio" value="score-desc" /><span>Highest rated</span></label>
                    <label class="ms-filter-option"><input type="radio" name="entry-sort-radio" value="score-asc" /><span>Lowest rated</span></label>
                    <label class="ms-filter-option"><input type="radio" name="entry-sort-radio" value="hours-desc" /><span>Most played</span></label>
                    <label class="ms-filter-option"><input type="radio" name="entry-sort-radio" value="hours-asc" /><span>Least played</span></label>
                    <label class="ms-filter-option"><input type="radio" name="entry-sort-radio" value="added-desc" /><span>Recently added</span></label>
                    <label class="ms-filter-option"><input type="radio" name="entry-sort-radio" value="alpha" /><span>A–Z</span></label>
                  </div>
                </div>
                {allGenreNames.length > 0 && (
                  <div class="ms-filter" id="genre-filter" data-default-label="All genres" data-noun="genre">
