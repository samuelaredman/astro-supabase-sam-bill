            <div class="entry-list" id="entry-list">
              {entryList.map((entry: any, i: number) => {
                const cover = igdbImage(entry.games?.cover_img_url, "t_cover_big");
                const gameReview = entry.games?.id ? reviewByGameId[entry.games.id] : null;
                const entryGenres = entry.games?.id ? (genreNamesByGameId[entry.games.id] ?? []) : [];
                const entryDevs = entry.games?.id ? (devNamesByGameId[entry.games.id] ?? []) : [];
                const entryYear = entry.games?.date_released ? new Date(entry.games.date_released).getFullYear() : "";
                const entryStatus = entry.games?.id ? statusByGameId[entry.games.id] : null;
                const isOwned = entryStatus?.owned ?? false;
                const isPlayed = (entryStatus?.played ?? false) || (entry.games?.id ? viewerReviewedGameIds.has(entry.games.id) : false);
                return (
