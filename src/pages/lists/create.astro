---
export const prerender = false;
import { createSupabaseServerClientFromContext } from "../../utils/database";
import Layout from "../../components/Layout.astro";

const supabase = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await supabase.auth.getUser();
if (!user) return Astro.redirect("/signin");
---

<Layout title="Create List — Chekpoint" variant="fullwidth">
<style is:global>
  *, *::before, *::after { box-sizing: border-box; }

  .cl-shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--bg-page, #0e0e0e);
  }

  /* ── top bar ── */
  .cl-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    height: 56px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-card);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .cl-back {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 8px;
    transition: color .15s, background .15s;
  }
  .cl-back:hover { color: var(--text-primary); background: var(--bg-hover); }
  .cl-logo {
    font-family: 'Press Start 2P', monospace;
    font-size: 11px;
    color: var(--text-primary);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .cl-logo-dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    display: inline-block;
  }
  .cl-topbar-right { width: 100px; } /* balances the back button */

  /* ── body ── */
  .cl-body {
    flex: 1;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 48px 20px 80px;
  }

  /* ── card ── */
  .cl-card {
    width: 100%;
    max-width: 560px;
  }
  .cl-heading {
    font-family: 'DM Serif Display', serif;
    font-size: 30px;
    font-weight: 400;
    margin: 0 0 6px;
    color: var(--text-primary);
  }
  .cl-sub {
    font-size: 14px;
    color: var(--text-tertiary);
    margin: 0 0 36px;
  }

  /* ── form ── */
  .cl-section { margin-bottom: 28px; }
  .cl-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .09em;
    color: var(--text-secondary);
    margin-bottom: 8px;
  }
  .cl-input {
    width: 100%;
    padding: 11px 14px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text-primary);
    font-size: 15px;
    font-family: inherit;
    outline: none;
    transition: border-color .15s;
  }
  .cl-input:focus { border-color: var(--accent); }
  textarea.cl-input { resize: vertical; min-height: 88px; line-height: 1.5; }

  /* type toggle */
  .cl-toggle-row { display: flex; align-items: center; gap: 12px; }
  .cl-toggle {
    position: relative;
    width: 42px;
    height: 24px;
    flex-shrink: 0;
  }
  .cl-toggle input { opacity: 0; width: 0; height: 0; position: absolute; }
  .cl-track {
    position: absolute;
    inset: 0;
    border-radius: 12px;
    background: var(--border);
    cursor: pointer;
    transition: background .2s;
  }
  .cl-toggle input:checked + .cl-track { background: var(--accent); }
  .cl-track::after {
    content: '';
    position: absolute;
    left: 4px; top: 4px;
    width: 16px; height: 16px;
    border-radius: 50%;
    background: #fff;
    transition: transform .2s;
  }
  .cl-toggle input:checked + .cl-track::after { transform: translateX(18px); }
  .cl-toggle-text { font-size: 14px; color: var(--text-secondary); }

  /* visibility cards */
  .cl-vis { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .cl-vis-opt {
    border: 2px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    cursor: pointer;
    transition: border-color .15s, background .15s;
  }
  .cl-vis-opt.selected {
    border-color: var(--accent);
    background: rgba(96,80,200,.07);
  }
  .cl-vis-opt input { display: none; }
  .cl-vis-icon { font-size: 20px; margin-bottom: 6px; }
  .cl-vis-name { font-size: 14px; font-weight: 600; color: var(--text-primary); margin-bottom: 3px; }
  .cl-vis-desc { font-size: 12px; color: var(--text-tertiary); line-height: 1.4; }

  /* divider */
  .cl-divider { border: none; border-top: 1px solid var(--border); margin: 32px 0; }

  /* share toggle */
  .cl-share-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--bg-card);
  }
  .cl-share-text { flex: 1; }
  .cl-share-title { font-size: 14px; font-weight: 600; color: var(--text-primary); margin-bottom: 3px; }
  .cl-share-desc { font-size: 12px; color: var(--text-tertiary); line-height: 1.4; }

  /* actions */
  .cl-actions { display: flex; gap: 10px; margin-top: 36px; }
  .cl-btn-primary {
    background: var(--accent);
    color: #fff;
    border: none;
    padding: 12px 32px;
    border-radius: 24px;
    font-size: 14px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: opacity .15s;
  }
  .cl-btn-primary:hover { opacity: .87; }
  .cl-btn-primary:disabled { opacity: .45; cursor: not-allowed; }
  .cl-btn-ghost {
    background: var(--tag-bg);
    color: var(--text-secondary);
    border: none;
    padding: 12px 22px;
    border-radius: 24px;
    font-size: 14px;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: background .15s;
  }
  .cl-btn-ghost:hover { background: var(--bg-hover); }
  .cl-error { color: #f87171; font-size: 13px; margin-top: 14px; display: none; }
</style>

<div class="cl-shell">
  <!-- top bar -->
  <header class="cl-topbar">
    <a href="javascript:history.back()" class="cl-back">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 3L5 8L10 13"/>
      </svg>
      Back
    </a>
    <a href="/" class="cl-logo"><span class="cl-logo-dot"></span>Chekpoint</a>
    <div class="cl-topbar-right"></div>
  </header>

  <!-- form body -->
  <main class="cl-body">
    <div class="cl-card">
      <h1 class="cl-heading">New List</h1>
      <p class="cl-sub">Rank your favourites, build a theme, or just keep track.</p>

      <form id="create-form">
        <div class="cl-section">
          <label class="cl-label" for="title">List Name</label>
          <input id="title" name="title" class="cl-input" type="text" placeholder="e.g. Top 10 Mario Games" maxlength="100" required autofocus />
        </div>

        <div class="cl-section">
          <label class="cl-label" for="description">Description <span style="font-weight:400;opacity:.6">(optional)</span></label>
          <textarea id="description" name="description" class="cl-input" placeholder="What's this list about?" maxlength="500"></textarea>
        </div>

        <div class="cl-section">
          <label class="cl-label">Type</label>
          <div class="cl-toggle-row">
            <label class="cl-toggle">
              <input type="checkbox" id="is_ranked" name="is_ranked" />
              <span class="cl-track"></span>
            </label>
            <span class="cl-toggle-text" id="ranked-label">Unranked — order doesn't matter</span>
          </div>
        </div>

        <div class="cl-section">
          <label class="cl-label">Visibility</label>
          <div class="cl-vis">
            <label class="cl-vis-opt selected" id="opt-public">
              <input type="radio" name="visibility" value="public" checked />
              <div class="cl-vis-icon">🌐</div>
              <div class="cl-vis-name">Public</div>
              <div class="cl-vis-desc">Anyone can view this list</div>
            </label>
            <label class="cl-vis-opt" id="opt-private">
              <input type="radio" name="visibility" value="private" />
              <div class="cl-vis-icon">🔒</div>
              <div class="cl-vis-name">Private</div>
              <div class="cl-vis-desc">Only visible to you</div>
            </label>
          </div>
        </div>

        <hr class="cl-divider" />

        <div id="share-feed-group">
          <label class="cl-label">Feed</label>
          <div class="cl-share-row">
            <div class="cl-share-text">
              <div class="cl-share-title">Share to front page feed</div>
              <div class="cl-share-desc">Your list will appear in the Recent Lists section on the home page</div>
            </div>
            <label class="cl-toggle" style="margin-top:2px">
              <input type="checkbox" id="share_to_feed" name="share_to_feed" checked />
              <span class="cl-track"></span>
            </label>
          </div>
        </div>

        <p class="cl-error" id="form-error"></p>

        <div class="cl-actions">
          <button type="submit" class="cl-btn-primary" id="submit-btn">Create List</button>
          <a href="javascript:history.back()" class="cl-btn-ghost">Cancel</a>
        </div>
      </form>
    </div>
  </main>
</div>
</Layout>

<script>
document.getElementById('is_ranked')!.addEventListener('change', function(e) {
  const checked = (e.target as HTMLInputElement).checked;
  document.getElementById('ranked-label')!.textContent = checked
    ? 'Ranked — you set the order'
    : 'Unranked — order doesn\'t matter';
});

document.querySelectorAll('.cl-vis-opt').forEach(opt => {
  opt.addEventListener('click', () => {
    document.querySelectorAll('.cl-vis-opt').forEach(o => o.classList.remove('selected'));
    opt.classList.add('selected');
    const isPrivate = (opt.querySelector('input') as HTMLInputElement).value === 'private';
    const shareGroup = document.getElementById('share-feed-group') as HTMLElement;
    shareGroup.style.display = isPrivate ? 'none' : 'block';
    if (isPrivate) (document.getElementById('share_to_feed') as HTMLInputElement).checked = false;
    else (document.getElementById('share_to_feed') as HTMLInputElement).checked = true;
  });
});

document.getElementById('create-form')!.addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const errEl = document.getElementById('form-error') as HTMLElement;
  errEl.style.display = 'none';
  btn.disabled = true;
  btn.textContent = 'Creating…';

  const title = (document.getElementById('title') as HTMLInputElement).value;
  const description = (document.getElementById('description') as HTMLTextAreaElement).value;
  const is_ranked = (document.getElementById('is_ranked') as HTMLInputElement).checked;
  const visibility = (document.querySelector('input[name="visibility"]:checked') as HTMLInputElement).value;
  const shared_to_feed = (document.getElementById('share_to_feed') as HTMLInputElement).checked;

  const res = await fetch('/api/lists/create', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ title, description, is_ranked, visibility, shared_to_feed }),
  });
  const data = await res.json();
  if (!res.ok) {
    errEl.textContent = data.error ?? 'Something went wrong.';
    errEl.style.display = 'block';
    btn.disabled = false;
    btn.textContent = 'Create List';
    return;
  }
  window.location.href = `/lists/${data.list_id}/edit`;
});
</script>
