---
// Temporary one-off page for the Phantom Blade Zero giveaway.
// Edit the markdown-ish copy inside <section> below to update the message.
// This page is intentionally not wired to the DB — delete the file (and the
// entry box in src/pages/index.astro) once the giveaway ends.
export const prerender = true;
import Layout from '../components/Layout.astro';
---

<Layout
  title="Giveaway: Phantom Blade Zero (3 copies) — Chekpoint.gg"
  description="We're giving away 3 copies of Phantom Blade Zero to the Chekpoint community."
  variant="centered"
>
  <div class="giveaway-page">
    <a href="/" class="back-link">← Back to home</a>

    <header class="giveaway-hero">
      <div class="giveaway-tag">GIVEAWAY</div>
      <h1>We're giving away 3 copies of Phantom Blade Zero</h1>
      <p class="giveaway-lead">
        A thank-you to the Chekpoint community. Three winners, three keys —
        enter below for a chance to grab one.
      </p>
    </header>

    <section class="giveaway-body">
      <h2>How to enter</h2>
      <p>
        [Edit this section with the entry rules — e.g. "Follow us on X, drop a
        review of any action game, and comment on this page before November 15th."]
      </p>

      <h2>How winners are picked</h2>
      <p>
        [Edit this section with how/when winners are chosen and contacted.]
      </p>

      <h2>Fine print</h2>
      <p>
        [Edit this section with eligibility, platforms, region, deadlines.]
      </p>
    </section>
  </div>
</Layout>

<style>
  .giveaway-page {
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    padding: 24px 20px 60px;
  }
  .back-link {
    display: inline-block;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    margin-bottom: 20px;
  }
  .back-link:hover { color: var(--accent); }

  .giveaway-hero {
    background: linear-gradient(135deg, #6050c8 0%, #a855f7 60%, #ec4899 100%);
    border-radius: 18px;
    padding: 28px 24px;
    color: #fff;
    box-shadow: 0 10px 30px rgba(96, 80, 200, 0.3);
    margin-bottom: 28px;
  }
  .giveaway-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.35);
    margin-bottom: 14px;
  }
  .giveaway-hero h1 {
    font-family: 'DM Serif Display', serif;
    font-size: 32px;
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 10px;
  }
  .giveaway-lead {
    font-size: 15px;
    line-height: 1.5;
    opacity: 0.92;
    margin: 0;
  }

  .giveaway-body h2 {
    font-family: 'DM Serif Display', serif;
    font-size: 20px;
    font-weight: 400;
    margin: 24px 0 8px;
    color: var(--text-primary);
  }
  .giveaway-body h2:first-child { margin-top: 0; }
  .giveaway-body p {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 0 12px;
  }
</style>
