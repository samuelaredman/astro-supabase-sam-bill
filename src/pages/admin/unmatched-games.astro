---
export const prerender = false;
import Layout from "../../components/Layout.astro";
import { resolveSiteAdminProfile } from "../../utils/api";
import { getSupabaseAdmin } from "../../utils/database";

const profile = await resolveSiteAdminProfile(Astro);
if (!profile) return Astro.redirect('/404');

const db = getSupabaseAdmin() as any;
const { data: titles } = await db
  .from('steam_unmatched_titles')
  .select('id, title, occurrences, last_seen_at')
  .eq('dismissed', false)
  .order('occurrences', { ascending: false })
  .order('last_seen_at', { ascending: false })
  .limit(200);

const rows = titles ?? [];
---

<Layout title="Unmatched Steam Titles — Admin" isLoggedIn={true} currentProfile={profile} variant="two-col">
  <main class="feed admin-main">
    <div class="feed-header">
      <div>
        <div class="feed-title">Unmatched Steam titles</div>
        <div class="feed-subtitle">
          Titles that never matched a game in our DB across syncs, sorted by how many times we've seen them.
        </div>
      </div>
    </div>

    <div class="admin-content">
      <a href="/admin" class="admin-back-link">&larr; Admin</a>
      <p class="admin-sub">
        Search IGDB and import the correct match, or dismiss non-game entries (tools, soundtracks,
        test servers) so they stop cluttering this list.
      </p>

      {rows.length === 0 && <p class="admin-empty">Nothing unmatched right now.</p>}

      <div class="unmatched-list" id="unmatchedList">
        {rows.map((row: any) => (
          <div class="unmatched-row" data-unmatched-id={row.id} data-title={row.title}>
            <div class="unmatched-info">
              <div class="unmatched-title">{row.title}</div>
              <div class="unmatched-meta">
                seen {row.occurrences}&times; · last {new Date(row.last_seen_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </div>
            </div>
            <div class="unmatched-actions">
              <button class="admin-btn admin-btn-primary" onclick={`searchIgdb('${row.id}')`}>Find on IGDB</button>
              <button class="admin-btn admin-btn-ghost" onclick={`dismissTitle('${row.id}')`}>Dismiss</button>
            </div>
            <div class="unmatched-candidates" id={`candidates-${row.id}`} style="display:none"></div>
          </div>
        ))}
      </div>
    </div>
  </main>
</Layout>

<script>
declare global {
  interface Window {
    searchIgdb: (unmatchedId: string) => Promise<void>;
    importCandidate: (unmatchedId: string, igdbId: number) => Promise<void>;
    dismissTitle: (unmatchedId: string) => Promise<void>;
  }
}

function getRow(unmatchedId: string): HTMLElement | null {
  return document.querySelector(`.unmatched-row[data-unmatched-id="${unmatchedId}"]`);
}

async function searchIgdb(unmatchedId: string) {
  const row = getRow(unmatchedId);
  const box = document.getElementById(`candidates-${unmatchedId}`);
  if (!row || !box) return;
  const title = row.dataset.title ?? '';

  box.style.display = 'block';
  box.innerHTML = '<div class="unmatched-candidates-loading">Searching IGDB...</div>';

  try {
    const res = await fetch('/api/admin/unmatched-games/search', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ title }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error ?? 'Search failed');

    if (!data.length) {
      box.innerHTML = '<div class="unmatched-candidates-loading">No IGDB results.</div>';
      return;
    }

    box.innerHTML = data.map((c: any) => `
      <div class="candidate-card">
        ${c.cover_img_url ? `<img src="${c.cover_img_url}" class="candidate-cover" alt="" />` : '<div class="candidate-cover candidate-cover-empty"></div>'}
        <div class="candidate-info">
          <div class="candidate-title">${c.title}${c.year ? ` (${c.year})` : ''}</div>
          <div class="candidate-category">${c.category_label}</div>
        </div>
        <button class="admin-btn admin-btn-primary admin-btn-small" data-igdb-id="${c.igdb_id}">Import</button>
      </div>
    `).join('');

    box.querySelectorAll('button[data-igdb-id]').forEach(btn => {
      btn.addEventListener('click', () => {
        const igdbId = Number((btn as HTMLElement).dataset.igdbId);
        importCandidate(unmatchedId, igdbId);
      });
    });
  } catch (e: any) {
    box.innerHTML = `<div class="unmatched-candidates-loading">${e.message ?? 'Something went wrong.'}</div>`;
  }
}
window.searchIgdb = searchIgdb;

async function importCandidate(unmatchedId: string, igdbId: number) {
  const row = getRow(unmatchedId);
  if (!row) return;
  try {
    const res = await fetch('/api/admin/unmatched-games/import', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ unmatched_id: unmatchedId, igdb_id: igdbId }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error ?? 'Import failed');
    row.remove();
  } catch (e: any) {
    alert(e.message ?? 'Import failed.');
  }
}
window.importCandidate = importCandidate;

async function dismissTitle(unmatchedId: string) {
  const row = getRow(unmatchedId);
  if (!row) return;
  try {
    const res = await fetch('/api/admin/unmatched-games/dismiss', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ unmatched_id: unmatchedId }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error ?? 'Dismiss failed');
    row.remove();
  } catch (e: any) {
    alert(e.message ?? 'Dismiss failed.');
  }
}
window.dismissTitle = dismissTitle;
</script>

<style>
  .admin-main { min-width: 0; }
  .admin-content { padding: 20px; }
  .admin-back-link { font-size: 13px; color: var(--text-secondary); text-decoration: none; margin-bottom: 12px; display: inline-block; }
  .admin-back-link:hover { color: var(--accent); }
  .admin-sub { color: var(--text-secondary); font-size: 14px; margin-bottom: 24px; max-width: 640px; line-height: 1.5; }
  .admin-empty { color: var(--text-secondary); font-size: 14px; }

  .unmatched-list { display: flex; flex-direction: column; gap: 10px; }
  .unmatched-row {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-card);
    padding: 14px 16px;
  }
  .unmatched-info { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .unmatched-title { font-weight: 600; font-size: 15px; }
  .unmatched-meta { font-size: 12px; color: var(--text-tertiary); white-space: nowrap; }
  .unmatched-actions { display: flex; gap: 8px; margin-top: 10px; }

  .admin-btn {
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-primary);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
  }
  .admin-btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .admin-btn-primary:hover { opacity: 0.9; }
  .admin-btn-ghost:hover { border-color: var(--accent); color: var(--accent); }
  .admin-btn-small { padding: 4px 10px; font-size: 12px; }

  .unmatched-candidates { margin-top: 12px; display: flex; flex-direction: column; gap: 8px; }
  .unmatched-candidates-loading { font-size: 13px; color: var(--text-secondary); }
  .candidate-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px;
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
  }
  .candidate-cover { width: 36px; height: 48px; object-fit: cover; border-radius: 4px; flex-shrink: 0; }
  .candidate-cover-empty { background: var(--bg-hover); }
  .candidate-info { flex: 1; min-width: 0; }
  .candidate-title { font-size: 13px; font-weight: 600; }
  .candidate-category { font-size: 12px; color: var(--text-tertiary); }
</style>
