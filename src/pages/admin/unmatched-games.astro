---
export const prerender = false;
import Layout from "../../components/Layout.astro";
import { resolveSiteAdminProfile } from "../../utils/api";
import { getSupabaseAdmin } from "../../utils/database";
import "../../styles/admin.css";

const profile = await resolveSiteAdminProfile(Astro);
if (!profile) return Astro.redirect('/404');

const db = getSupabaseAdmin() as any;
const { data: titles } = await db
  .from('steam_unmatched_titles')
  .select('id, title, occurrences, last_seen_at')
  .eq('dismissed', false)
  .order('occurrences', { ascending: false })
  .order('last_seen_at', { ascending: false })
  .limit(200);

const rows = titles ?? [];
---

<Layout title="Unmatched Steam Titles — Admin" isLoggedIn={true} currentProfile={profile} activeNav="admin" variant="two-col">
  <main class="feed admin-main">
    <div class="admin-content">
      <a href="/admin" class="admin-back-link">← Admin</a>

      <header class="admin-page-header">
        <div>
          <h1 class="admin-page-title">Unmatched Steam titles</h1>
          <p class="admin-page-subtitle">
            Titles that never matched a game in our DB across syncs, sorted by how many times we've seen them.
            Search IGDB and import the correct match, or dismiss non-game entries (tools, soundtracks, test servers).
          </p>
        </div>
        <span class="admin-chip admin-chip-warn">{rows.length} pending</span>
      </header>

      {rows.length === 0 && <p class="admin-empty">Nothing unmatched right now. ✓</p>}

      <div class="admin-list" id="unmatchedList">
        {rows.map((row: any) => (
          <article class="admin-row unmatched-row" data-unmatched-id={row.id} data-title={row.title}>
            <div class="admin-row-head">
              <div class="admin-row-title">{row.title}</div>
              <div class="admin-row-meta">
                seen {row.occurrences}× · last {new Date(row.last_seen_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </div>
            </div>
            <div class="admin-row-actions">
              <button class="admin-btn admin-btn-primary" onclick={`searchIgdb('${row.id}')`}>Find on IGDB</button>
              <button class="admin-btn admin-btn-ghost" onclick={`dismissTitle('${row.id}')`}>Dismiss</button>
            </div>
            <div class="unmatched-candidates" id={`candidates-${row.id}`} style="display:none"></div>
          </article>
        ))}
      </div>
    </div>
  </main>
</Layout>

<script>
declare global {
  interface Window {
    searchIgdb: (unmatchedId: string) => Promise<void>;
    importCandidate: (unmatchedId: string, igdbId: number) => Promise<void>;
    dismissTitle: (unmatchedId: string) => Promise<void>;
  }
}

function getRow(unmatchedId: string): HTMLElement | null {
  return document.querySelector(`.unmatched-row[data-unmatched-id="${unmatchedId}"]`);
}

async function searchIgdb(unmatchedId: string) {
  const row = getRow(unmatchedId);
  const box = document.getElementById(`candidates-${unmatchedId}`);
  if (!row || !box) return;
  const title = row.dataset.title ?? '';

  box.style.display = 'block';
  box.innerHTML = '<div class="unmatched-candidates-loading">Searching IGDB...</div>';

  try {
    const res = await fetch('/api/admin/unmatched-games/search', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ title }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error ?? 'Search failed');

    if (!data.length) {
      box.innerHTML = '<div class="unmatched-candidates-loading">No IGDB results.</div>';
      return;
    }

    box.innerHTML = data.map((c: any) => `
      <div class="candidate-card">
        ${c.cover_img_url ? `<img src="${c.cover_img_url}" class="candidate-cover" alt="" />` : '<div class="candidate-cover candidate-cover-empty"></div>'}
        <div class="candidate-info">
          <div class="candidate-title">${c.title}${c.year ? ` (${c.year})` : ''}</div>
          <div class="candidate-category">${c.category_label}</div>
        </div>
        <button class="admin-btn admin-btn-primary admin-btn-sm" data-igdb-id="${c.igdb_id}">Import</button>
      </div>
    `).join('');

    box.querySelectorAll('button[data-igdb-id]').forEach(btn => {
      btn.addEventListener('click', () => {
        const igdbId = Number((btn as HTMLElement).dataset.igdbId);
        importCandidate(unmatchedId, igdbId);
      });
    });
  } catch (e: any) {
    box.innerHTML = `<div class="unmatched-candidates-loading">${e.message ?? 'Something went wrong.'}</div>`;
  }
}
window.searchIgdb = searchIgdb;

async function importCandidate(unmatchedId: string, igdbId: number) {
  const row = getRow(unmatchedId);
  if (!row) return;
  try {
    const res = await fetch('/api/admin/unmatched-games/import', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ unmatched_id: unmatchedId, igdb_id: igdbId }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error ?? 'Import failed');
    row.remove();
  } catch (e: any) {
    alert(e.message ?? 'Import failed.');
  }
}
window.importCandidate = importCandidate;

async function dismissTitle(unmatchedId: string) {
  const row = getRow(unmatchedId);
  if (!row) return;
  try {
    const res = await fetch('/api/admin/unmatched-games/dismiss', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ unmatched_id: unmatchedId }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error ?? 'Dismiss failed');
    row.remove();
  } catch (e: any) {
    alert(e.message ?? 'Dismiss failed.');
  }
}
window.dismissTitle = dismissTitle;
</script>

<style>
  /* Page-local only — primitives are in src/styles/admin.css. */
  .unmatched-candidates {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px dashed var(--border);
  }
  .unmatched-candidates-loading { font-size: 13px; color: var(--text-secondary); padding: 6px 2px; }
  .candidate-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border: 1px solid var(--border-subtle, var(--border));
    border-radius: 10px;
    background: var(--bg-hover);
  }
  .candidate-cover {
    width: 40px; height: 54px;
    object-fit: cover;
    border-radius: 5px;
    flex-shrink: 0;
  }
  .candidate-cover-empty { background: var(--tag-bg, var(--bg-hover)); border: 1px solid var(--border); }
  .candidate-info { flex: 1; min-width: 0; }
  .candidate-title { font-size: 14px; font-weight: 600; color: var(--text-primary); }
  .candidate-category { font-size: 12px; color: var(--text-tertiary); margin-top: 2px; }
</style>
