---
export const prerender = false;
import Layout from "../../components/Layout.astro";
import { resolveSiteAdminProfile } from "../../utils/api";
import { getSupabaseAdmin } from "../../utils/database";
import "../../styles/admin.css";

const profile = await resolveSiteAdminProfile(Astro);
if (!profile) return Astro.redirect('/404');

const db = getSupabaseAdmin() as any;

const [{ count: unmatchedCount }, { count: pendingReportsCount }, { count: userCount }, { count: creatorCount }] = await Promise.all([
  db.from('steam_unmatched_titles').select('*', { count: 'exact', head: true }).eq('dismissed', false),
  db.from('reports').select('*', { count: 'exact', head: true }).eq('status', 'pending'),
  db.from('profiles').select('*', { count: 'exact', head: true }),
  db.from('profile_badges').select('*', { count: 'exact', head: true }).eq('badge_slug', 'chekpoint-creator'),
]);

const tools: Array<{
  href: string;
  name: string;
  desc: string;
  countLabel: string;
  countTone?: 'accent' | 'warn' | 'neutral';
}> = [
  {
    href: '/admin/activity',
    name: 'Activity',
    desc: 'Daily signups, reviews, comments, recs, and reports — last 30 days vs the prior 30.',
    countLabel: 'live trend',
    countTone: 'neutral',
  },
  {
    href: '/admin/reports',
    name: 'Reports',
    desc: 'User reports on reviews, comments, profiles, and recommendations awaiting moderation.',
    countLabel: `${pendingReportsCount ?? 0} pending`,
    countTone: (pendingReportsCount ?? 0) > 0 ? 'warn' : 'neutral',
  },
  {
    href: '/admin/users',
    name: 'Users',
    desc: 'Search profiles by username. View activity, assign badges, moderate content, ban.',
    countLabel: `${userCount ?? 0} total`,
    countTone: 'accent',
  },
  {
    href: '/admin/creators',
    name: 'Creators',
    desc: 'Partnered Chekpoint Creators, newest first — with YouTube sub counts and the date each was added.',
    countLabel: `${creatorCount ?? 0} total`,
    countTone: 'accent',
  },
  {
    href: '/admin/unmatched-games',
    name: 'Unmatched Steam titles',
    desc: "Steam library titles that didn't match a game in our DB. Review and import the real matches.",
    countLabel: `${unmatchedCount ?? 0} pending`,
    countTone: (unmatchedCount ?? 0) > 0 ? 'warn' : 'neutral',
  },
];
---

<Layout title="Admin — Chekpoint" isLoggedIn={true} currentProfile={profile} activeNav="admin" variant="two-col">
  <main class="feed admin-main">
    <div class="admin-content">
      <header class="admin-page-header">
        <div>
          <h1 class="admin-page-title">Admin</h1>
          <p class="admin-page-subtitle">Site-admin tools. Only visible to Sam and Bill.</p>
        </div>
      </header>

      <div class="admin-tool-grid">
        {tools.map((t) => (
          <a href={t.href} class="admin-tool-card">
            <div class="admin-tool-head">
              <div class="admin-tool-name">{t.name}</div>
              <span class={`admin-chip admin-chip-${t.countTone ?? 'accent'}`}>{t.countLabel}</span>
            </div>
            <div class="admin-tool-desc">{t.desc}</div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
