---
export const prerender = false;
import Layout from "../../components/Layout.astro";
import { resolveSiteAdminProfile } from "../../utils/api";
import { getSupabaseAdmin } from "../../utils/database";

const profile = await resolveSiteAdminProfile(Astro);
if (!profile) return Astro.redirect('/404');

const db = getSupabaseAdmin() as any;

const [{ count: unmatchedCount }, { count: pendingReportsCount }] = await Promise.all([
  db.from('steam_unmatched_titles').select('*', { count: 'exact', head: true }).eq('dismissed', false),
  db.from('reports').select('*', { count: 'exact', head: true }).eq('status', 'pending'),
]);
---

<Layout title="Admin — Chekpoint" isLoggedIn={true} currentProfile={profile} variant="two-col">
  <main class="feed admin-main">
    <h1 class="admin-title">Admin</h1>
    <p class="admin-sub">Site-admin tools. Only visible to Sam and Bill.</p>

    <div class="admin-tool-grid">
      <a href="/admin/unmatched-games" class="admin-tool-card">
        <div class="admin-tool-name">Unmatched Steam titles</div>
        <div class="admin-tool-desc">Steam library titles that didn't match a game in our DB. Review and import genuine gaps.</div>
        <div class="admin-tool-count">{unmatchedCount ?? 0} pending</div>
      </a>

      <a href="/admin/reports" class="admin-tool-card">
        <div class="admin-tool-name">Reports</div>
        <div class="admin-tool-desc">User reports on reviews, comments, and profiles awaiting moderation.</div>
        <div class="admin-tool-count">{pendingReportsCount ?? 0} pending</div>
      </a>
    </div>
  </main>
</Layout>

<style>
  .admin-main { min-width: 0; }
  .admin-title { font-size: 24px; font-weight: 700; margin-bottom: 4px; }
  .admin-sub { color: var(--text-secondary); font-size: 14px; margin-bottom: 24px; }
  .admin-tool-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
  .admin-tool-card {
    display: block;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-card);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .admin-tool-card:hover { border-color: var(--accent); background: var(--bg-hover); }
  .admin-tool-name { font-weight: 600; font-size: 16px; margin-bottom: 6px; }
  .admin-tool-desc { font-size: 13px; color: var(--text-secondary); line-height: 1.4; margin-bottom: 12px; }
  .admin-tool-count { font-size: 13px; font-weight: 600; color: var(--accent); }
</style>
