---
export const prerender = false;
import Layout from "../../components/Layout.astro";
import { resolveSiteAdminProfile } from "../../utils/api";
import { getSupabaseAdmin } from "../../utils/database";
import "../../styles/admin.css";

const profile = await resolveSiteAdminProfile(Astro);
if (!profile) return Astro.redirect('/404');

const db = getSupabaseAdmin() as any;

// Pull 60 days so we can compare the last 30 vs the prior 30.
const { data: raw, error } = await db.rpc('admin_daily_activity', { days: 60 });
if (error) {
  console.error('[admin/activity] rpc error:', JSON.stringify(error));
}

// 14-day retention cohorts over the trailing 90 days.
const { data: retentionRaw, error: retError } = await db.rpc('admin_user_retention', { window_days: 90 });
if (retError) {
  console.error('[admin/activity] retention rpc error:', JSON.stringify(retError));
}

type RetentionRow = { cohort_week: string; cohort_size: number; retained_14d: number; retained_pct: number };
const retentionRows: RetentionRow[] = ((retentionRaw as any[]) ?? []).map((r) => ({
  cohort_week: r.cohort_week,
  cohort_size: Number(r.cohort_size ?? 0),
  retained_14d: Number(r.retained_14d ?? 0),
  retained_pct: Number(r.retained_pct ?? 0),
}));

// Marketing campaigns (date windows) with their signups' retention, plus an
// organic baseline row (campaign_id null) over the same 90 days.
const { data: campaignRaw, error: campError } = await db.rpc('admin_campaign_cohorts', { organic_days: 90 });
if (campError) {
  console.error('[admin/activity] campaign rpc error:', JSON.stringify(campError));
}

type CampaignRow = {
  campaign_id: string | null;
  name: string;
  kind: string;
  starts_on: string;
  ends_on: string | null;
  signups: number;
  returned_1d: number;
  matured: number;
  retained_14d: number;
};
const campaignRows: CampaignRow[] = ((campaignRaw as any[]) ?? []).map((r) => ({
  campaign_id: r.campaign_id ?? null,
  name: r.name,
  kind: r.kind,
  starts_on: r.starts_on,
  ends_on: r.ends_on ?? null,
  signups: Number(r.signups ?? 0),
  returned_1d: Number(r.returned_1d ?? 0),
  matured: Number(r.matured ?? 0),
  retained_14d: Number(r.retained_14d ?? 0),
}));
const campaigns = campaignRows.filter((c) => c.campaign_id);

function pct(part: number, whole: number): string {
  return whole === 0 ? '—' : `${Math.round((1000 * part) / whole) / 10}%`;
}
// The day a cohort's last signups have had 14 days to come back.
function maturesOn(c: CampaignRow): string {
  const last = c.ends_on ?? new Date().toISOString().slice(0, 10);
  const d = new Date(last + 'T00:00:00Z');
  d.setUTCDate(d.getUTCDate() + 15);
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
}

const retentionTotal = retentionRows.reduce((a, r) => a + r.cohort_size, 0);
const retentionReturned = retentionRows.reduce((a, r) => a + r.retained_14d, 0);
const retentionPct = retentionTotal === 0 ? 0 : Math.round((1000 * retentionReturned) / retentionTotal) / 10;

type DayRow = {
  day: string;
  signups: number;
  reviews: number;
  comments: number;
  recommendations: number;
  reports: number;
};

const rows: DayRow[] = ((raw as any[]) ?? []).map((r) => ({
  day: r.day,
  signups: Number(r.signups ?? 0),
  reviews: Number(r.reviews ?? 0),
  comments: Number(r.comments ?? 0),
  recommendations: Number(r.recommendations ?? 0),
  reports: Number(r.reports ?? 0),
}));

type Metric = 'signups' | 'reviews' | 'comments' | 'recommendations' | 'reports';
const METRICS: { key: Metric; label: string }[] = [
  { key: 'signups', label: 'Signups' },
  { key: 'reviews', label: 'Reviews' },
  { key: 'comments', label: 'Comments' },
  { key: 'recommendations', label: 'Recs' },
  { key: 'reports', label: 'Reports' },
];

function windowSum(rows: DayRow[], metric: Metric, startIdx: number, endIdx: number): number {
  let s = 0;
  for (let i = startIdx; i < endIdx; i++) s += rows[i]?.[metric] ?? 0;
  return s;
}

// Last 30 = indices [rows.length - 30, rows.length)
// Prior 30 = indices [rows.length - 60, rows.length - 30)
// Last 7 = indices [rows.length - 7, rows.length)
const n = rows.length;
const last30Start = Math.max(0, n - 30);
const prior30Start = Math.max(0, n - 60);
const prior30End = last30Start;
const last7Start = Math.max(0, n - 7);

type Summary = { label: string; metric: Metric; last7: number; last30: number; delta30: number };
const summary: Summary[] = METRICS.map(({ key, label }) => {
  const last30 = windowSum(rows, key, last30Start, n);
  const prior30 = windowSum(rows, key, prior30Start, prior30End);
  return {
    label,
    metric: key,
    last7: windowSum(rows, key, last7Start, n),
    last30,
    delta30: last30 - prior30,
  };
});

// Last 30 days of day rows for the chart + table.
const last30Rows = rows.slice(last30Start);

// ── Multi-line chart setup ────────────────────────────────────────────────
// Shared Y axis across all metrics so volumes are directly comparable.
const chartMax = Math.max(
  1,
  ...last30Rows.flatMap((r) => [r.signups, r.reviews, r.comments, r.recommendations, r.reports])
);

// SVG viewBox: 800 x 240, with padding for axis labels.
const CHART_W = 800;
const CHART_H = 240;
const PAD_L = 32;
const PAD_R = 12;
const PAD_T = 12;
const PAD_B = 32;
const PLOT_W = CHART_W - PAD_L - PAD_R;
const PLOT_H = CHART_H - PAD_T - PAD_B;
const nPoints = last30Rows.length;
const xStep = nPoints > 1 ? PLOT_W / (nPoints - 1) : 0;

function xAt(i: number): number { return PAD_L + i * xStep; }
function yAt(v: number): number { return PAD_T + PLOT_H - (v / chartMax) * PLOT_H; }

const SERIES: { key: Metric; label: string; color: string }[] = [
  { key: 'signups',         label: 'Signups',  color: '#6050c8' }, // --accent
  { key: 'reviews',         label: 'Reviews',  color: '#27ae60' },
  { key: 'comments',        label: 'Comments', color: '#3498db' },
  { key: 'recommendations', label: 'Recs',     color: '#e67e22' },
  { key: 'reports',         label: 'Reports',  color: '#c0392b' },
];

const seriesPaths = SERIES.map((s) => {
  const d = last30Rows
    .map((r, i) => `${i === 0 ? 'M' : 'L'}${xAt(i).toFixed(1)},${yAt(r[s.key]).toFixed(1)}`)
    .join(' ');
  return { ...s, d };
});

// Y-axis gridlines (0, 25%, 50%, 75%, 100% of max).
const yTicks = [0, 0.25, 0.5, 0.75, 1].map((f) => ({
  y: PAD_T + PLOT_H - f * PLOT_H,
  label: Math.round(chartMax * f).toString(),
}));

// X-axis labels: every ~5th day to avoid crowding.
const xTickStep = Math.max(1, Math.ceil(nPoints / 6));
const xTicks = last30Rows
  .map((r, i) => ({ i, label: fmtDay(r.day).replace(/^\w+ /, '') }))
  .filter(({ i }) => i % xTickStep === 0 || i === nPoints - 1);

// Column hover zones — each covers half the gap on either side of its data point,
// so hovering anywhere above that column pops the day's full stats tooltip.
const hoverZones = last30Rows.map((_r, i) => {
  const left  = i === 0            ? PAD_L : (xAt(i - 1) + xAt(i)) / 2;
  const right = i === nPoints - 1  ? CHART_W - PAD_R : (xAt(i) + xAt(i + 1)) / 2;
  return { i, x: left, width: right - left, cx: xAt(i) };
});

// Campaign shading — one band per campaign over the chart days it covers.
const today = new Date().toISOString().slice(0, 10);
function campaignsOn(day: string): string[] {
  return campaigns
    .filter((c) => day >= c.starts_on && day <= (c.ends_on ?? today))
    .map((c) => c.name);
}
const campaignBands = campaigns
  .map((c) => {
    const idxs = last30Rows
      .map((r, i) => (r.day >= c.starts_on && r.day <= (c.ends_on ?? today) ? i : -1))
      .filter((i) => i >= 0);
    if (idxs.length === 0) return null;
    const first = idxs[0];
    const last = idxs[idxs.length - 1];
    const x1 = Math.max(PAD_L, xAt(first) - xStep / 2);
    const x2 = Math.min(CHART_W - PAD_R, xAt(last) + xStep / 2);
    // Label inside the band, anchored to whichever edge keeps it on the chart.
    const rightHalf = x1 > PAD_L + PLOT_W / 2;
    const label = c.name.length > 26 ? c.name.slice(0, 25) + '…' : c.name;
    return {
      name: label,
      x: x1,
      width: Math.max(4, x2 - x1),
      labelX: rightHalf ? x2 - 4 : x1 + 4,
      anchor: rightHalf ? 'end' : 'start',
    };
  })
  .filter((b) => b !== null);

// Data for the client-side hover script — one record per day.
const chartData = last30Rows.map((r) => ({
  day: r.day,
  campaigns: campaignsOn(r.day),
  signups: r.signups,
  reviews: r.reviews,
  comments: r.comments,
  recommendations: r.recommendations,
  reports: r.reports,
}));
const chartSeries = SERIES;

function fmtDay(s: string): string {
  const d = new Date(s + 'T00:00:00');
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}
function fmtWeekday(s: string): string {
  return new Date(s + 'T00:00:00').toLocaleDateString('en-US', { weekday: 'short' });
}
---

<Layout title="Activity — Admin" isLoggedIn={true} currentProfile={profile} activeNav="admin" variant="two-col">
  <main class="feed admin-main">
    <div class="admin-content">
      <a href="/admin" class="admin-back-link">← Admin</a>

      <header class="admin-page-header">
        <div>
          <h1 class="admin-page-title">Activity</h1>
          <p class="admin-page-subtitle">Daily signups and content over the last 30 days, compared with the prior 30.</p>
        </div>
      </header>

      {rows.length === 0 && <p class="admin-empty">No data yet — did the admin_daily_activity migration apply?</p>}

      {rows.length > 0 && (
        <>
          <section class="admin-stat-row">
            {summary.map((s) => {
              const sign = s.delta30 === 0 ? '' : s.delta30 > 0 ? '+' : '';
              const trend = s.delta30 === 0 ? 'flat' : s.delta30 > 0 ? 'up' : 'down';
              return (
                <div class="admin-stat">
                  <div class="admin-stat-label">{s.label}</div>
                  <div class="admin-stat-num">{s.last30}</div>
                  <div class="admin-stat-sub">
                    <span class="admin-stat-sub-main">{s.last7} last 7d</span>
                    <span class={`admin-stat-delta admin-stat-delta-${trend}`}>{sign}{s.delta30} vs prior 30</span>
                  </div>
                </div>
              );
            })}
          </section>

          <section class="admin-section chart-section">
            <h3 class="admin-section-title">Daily activity <span class="section-sub">last 30 days</span></h3>
            <div class="chart-wrap">
              <div class="chart-legend">
                {SERIES.map((s) => (
                  <span class="legend-item">
                    <span class="legend-swatch" style={`background:${s.color}`}></span>
                    {s.label}
                  </span>
                ))}
              </div>
              <div class="chart-plot">
                <svg class="line-chart" viewBox={`0 0 ${CHART_W} ${CHART_H}`} role="img" aria-label="Daily activity trend chart">
                  {/* Campaign bands (behind everything) */}
                  {campaignBands.map((b) => (
                    <g class="campaign-band">
                      <rect x={b.x} y={PAD_T} width={b.width} height={PLOT_H} />
                      <text x={b.labelX} y={PAD_T + 11} text-anchor={b.anchor}>{b.name}</text>
                    </g>
                  ))}
                  {/* Gridlines + y labels */}
                  {yTicks.map((t) => (
                    <g>
                      <line x1={PAD_L} x2={CHART_W - PAD_R} y1={t.y} y2={t.y} class="grid-line" />
                      <text x={PAD_L - 6} y={t.y + 3} class="axis-label axis-label-y">{t.label}</text>
                    </g>
                  ))}
                  {/* X labels */}
                  {xTicks.map((t) => (
                    <text x={xAt(t.i)} y={CHART_H - PAD_B + 16} class="axis-label axis-label-x">{t.label}</text>
                  ))}
                  {/* Vertical crosshair guide (shown on hover) */}
                  <line class="hover-guide" x1="0" x2="0" y1={PAD_T} y2={PAD_T + PLOT_H} />
                  {/* Series lines (drawn after grid so they sit on top) */}
                  {seriesPaths.map((s) => (
                    <path d={s.d} fill="none" stroke={s.color} stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" />
                  ))}
                  {/* Point markers */}
                  {seriesPaths.map((s) => (
                    <g data-series={s.key}>
                      {last30Rows.map((r, i) => (
                        <circle
                          cx={xAt(i)}
                          cy={yAt(r[s.key])}
                          r="2.2"
                          fill={s.color}
                          data-day-idx={i}
                        />
                      ))}
                    </g>
                  ))}
                  {/* Column hover zones (invisible, pointer target) */}
                  {hoverZones.map((z) => (
                    <rect
                      class="hover-zone"
                      x={z.x}
                      y={PAD_T}
                      width={z.width}
                      height={PLOT_H}
                      data-idx={z.i}
                      data-cx={z.cx}
                    />
                  ))}
                </svg>
                <div class="chart-tooltip" role="tooltip"></div>
              </div>
              <script is:inline define:vars={{ chartData, chartSeries }}>
                (function () {
                  var wrap = document.querySelector('.chart-plot');
                  if (!wrap) return;
                  var svg = wrap.querySelector('.line-chart');
                  var tooltip = wrap.querySelector('.chart-tooltip');
                  var guide = svg.querySelector('.hover-guide');
                  var zones = svg.querySelectorAll('.hover-zone');

                  function fmtDay(day) {
                    var d = new Date(day + 'T00:00:00');
                    return d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
                  }

                  function highlight(idx) {
                    svg.querySelectorAll('circle[data-day-idx]').forEach(function (c) {
                      if (parseInt(c.getAttribute('data-day-idx'), 10) === idx) {
                        c.setAttribute('r', '4');
                      } else {
                        c.setAttribute('r', '2.2');
                      }
                    });
                  }
                  function clearHighlight() {
                    svg.querySelectorAll('circle[data-day-idx]').forEach(function (c) { c.setAttribute('r', '2.2'); });
                  }

                  function showAt(idx, rect) {
                    var row = chartData[idx];
                    if (!row) return;
                    var rows = chartSeries.map(function (s) {
                      return '<div class="tt-row">'
                        + '<span class="tt-dot" style="background:' + s.color + '"></span>'
                        + '<span class="tt-label">' + s.label + '</span>'
                        + '<span class="tt-val">' + row[s.key] + '</span>'
                        + '</div>';
                    }).join('');
                    var camp = row.campaigns.length
                      ? '<div class="tt-campaign">' + row.campaigns.map(function (n) {
                          return n.replace(/[&<>"]/g, function (ch) { return '&#' + ch.charCodeAt(0) + ';'; });
                        }).join(', ') + '</div>'
                      : '';
                    tooltip.innerHTML = '<div class="tt-day">' + fmtDay(row.day) + '</div>' + camp + rows;
                    tooltip.style.display = 'block';

                    var wrapRect = wrap.getBoundingClientRect();
                    var zoneRect = rect.getBoundingClientRect();
                    var columnCenter = zoneRect.left - wrapRect.left + zoneRect.width / 2;
                    var ttW = tooltip.offsetWidth;
                    var ttH = tooltip.offsetHeight;
                    // Prefer right side; flip to left if it'd overflow.
                    var left = columnCenter + 12;
                    if (left + ttW + 8 > wrap.clientWidth) left = columnCenter - ttW - 12;
                    if (left < 4) left = 4;
                    tooltip.style.left = left + 'px';
                    tooltip.style.top = Math.max(4, Math.min(wrap.clientHeight - ttH - 4, 16)) + 'px';

                    // Move the SVG guide line to the data point's x.
                    var cx = rect.getAttribute('data-cx');
                    guide.setAttribute('x1', cx);
                    guide.setAttribute('x2', cx);
                    guide.classList.add('on');

                    highlight(idx);
                  }

                  function hide() {
                    tooltip.style.display = 'none';
                    guide.classList.remove('on');
                    clearHighlight();
                  }

                  zones.forEach(function (rect) {
                    var idx = parseInt(rect.getAttribute('data-idx'), 10);
                    rect.addEventListener('mouseenter', function () { showAt(idx, rect); });
                    rect.addEventListener('mousemove', function () { showAt(idx, rect); });
                  });
                  svg.addEventListener('mouseleave', hide);
                })();
              </script>
            </div>
          </section>

          <section class="admin-section" id="campaigns">
            <h3 class="admin-section-title">Campaigns <span class="section-sub">vs organic signups, last 90 days</span></h3>
            <p class="admin-section-note">Users are grouped by the day they signed up (UTC). "Came back" = posted a review, comment, or rec at least a day after signing up, so posting to enter a giveaway on day one doesn't count. 14-day retention only counts users who signed up at least 14 days ago.</p>
            {campError && <p class="admin-empty">Couldn't load campaigns — have the marketing_campaigns / admin_campaign_cohorts migrations been applied?</p>}
            <div class="admin-table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Campaign</th>
                    <th>Dates</th>
                    <th class="num">Signups</th>
                    <th class="num">Came back</th>
                    <th class="num">14-day</th>
                    <th>&nbsp;</th>
                  </tr>
                </thead>
                <tbody>
                  {campaignRows.map((c) => (
                    <tr class={c.campaign_id ? '' : 'campaign-organic'}>
                      <td>
                        {c.name}
                        {c.campaign_id && <span class="admin-chip admin-chip-neutral campaign-kind">{c.kind}</span>}
                      </td>
                      <td class="campaign-dates">
                        {c.campaign_id
                          ? `${fmtDay(c.starts_on)} – ${c.ends_on ? fmtDay(c.ends_on) : 'ongoing'}`
                          : 'Outside all campaigns'}
                      </td>
                      <td class={`num${c.signups === 0 ? ' zero' : ''}`}>{c.signups}</td>
                      <td class="num">
                        {c.returned_1d} <span class="campaign-pct">{pct(c.returned_1d, c.signups)}</span>
                      </td>
                      <td class="num">
                        {c.matured === 0
                          ? <span class="campaign-pending">{c.signups === 0 ? '—' : `from ${maturesOn(c)}`}</span>
                          : <>{c.retained_14d}/{c.matured} <span class="campaign-pct">{pct(c.retained_14d, c.matured)}</span></>}
                      </td>
                      <td class="num">
                        {c.campaign_id && (
                          <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" data-campaign-delete={c.campaign_id} data-campaign-name={c.name}>Delete</button>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <details class="campaign-add">
              <summary class="admin-btn admin-btn-sm">+ Add campaign</summary>
              <form id="campaignForm" class="campaign-form">
                <label>Name<input class="admin-input" name="name" maxlength="80" required placeholder="Phantom Blade Zero giveaway" /></label>
                <label>Type
                  <select class="admin-input" name="kind">
                    <option value="giveaway">Giveaway</option>
                    <option value="creator">Creator</option>
                    <option value="ad">Ad</option>
                    <option value="social">Social</option>
                    <option value="other">Other</option>
                  </select>
                </label>
                <label>Starts<input class="admin-input" type="date" name="starts_on" required /></label>
                <label><span>Ends <span class="campaign-optional">· blank = ongoing</span></span><input class="admin-input" type="date" name="ends_on" /></label>
                <label class="campaign-notes">Notes<input class="admin-input" name="notes" maxlength="500" placeholder="Optional — who ran it, where it was posted" /></label>
                <div class="campaign-form-actions">
                  <button type="submit" class="admin-btn admin-btn-primary admin-btn-sm">Save campaign</button>
                  <span class="campaign-form-error" role="alert"></span>
                </div>
              </form>
            </details>
          </section>

          <section class="admin-section">
            <h3 class="admin-section-title">14-day retention <span class="section-sub">last 90 days</span></h3>
            <p class="admin-section-note">Share of new users who posted a review, comment, or rec at least 14 days after signing up. Only cohorts that have fully aged (signup ≥ 14 days ago) are counted.</p>
            {retentionRows.length === 0 ? (
              <p class="admin-empty">No matured cohorts yet.</p>
            ) : (
              <>
                <div class="retention-headline">
                  <div class="retention-headline-pct">{retentionPct}%</div>
                  <div class="retention-headline-sub">{retentionReturned} of {retentionTotal} new users came back after 2 weeks</div>
                </div>
                <div class="admin-table-wrap">
                  <table class="admin-table">
                    <thead>
                      <tr>
                        <th>Signup week</th>
                        <th class="num">Cohort</th>
                        <th class="num">Retained</th>
                        <th class="num">%</th>
                        <th>&nbsp;</th>
                      </tr>
                    </thead>
                    <tbody>
                      {retentionRows.map((r) => (
                        <tr>
                          <td>{fmtDay(r.cohort_week)}</td>
                          <td class={`num${r.cohort_size === 0 ? ' zero' : ''}`}>{r.cohort_size}</td>
                          <td class={`num${r.retained_14d === 0 ? ' zero' : ''}`}>{r.retained_14d}</td>
                          <td class="num">{r.retained_pct}%</td>
                          <td>
                            <div class="retention-bar">
                              <div class="retention-bar-fill" style={`width:${Math.min(100, r.retained_pct)}%`}></div>
                            </div>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </>
            )}
          </section>

          <section class="admin-section">
            <h3 class="admin-section-title">Daily breakdown</h3>
            <div class="admin-table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Day</th>
                    <th class="num">Signups</th>
                    <th class="num">Reviews</th>
                    <th class="num">Comments</th>
                    <th class="num">Recs</th>
                    <th class="num">Reports</th>
                  </tr>
                </thead>
                <tbody>
                  {last30Rows.slice().reverse().map((r) => (
                    <tr>
                      <td>{fmtWeekday(r.day)} {fmtDay(r.day)}</td>
                      <td class={`num${r.signups === 0 ? ' zero' : ''}`}>{r.signups}</td>
                      <td class={`num${r.reviews === 0 ? ' zero' : ''}`}>{r.reviews}</td>
                      <td class={`num${r.comments === 0 ? ' zero' : ''}`}>{r.comments}</td>
                      <td class={`num${r.recommendations === 0 ? ' zero' : ''}`}>{r.recommendations}</td>
                      <td class={`num${r.reports === 0 ? ' zero' : ''}`}>{r.reports}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        </>
      )}
    </div>
  </main>
</Layout>

<script>
async function post(url: string, body: unknown) {
  const res = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.error ?? 'Something went wrong.');
  return data;
}

function reloadToCampaigns() {
  window.location.hash = 'campaigns';
  window.location.reload();
}

const form = document.getElementById('campaignForm') as HTMLFormElement | null;
form?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const errEl = form.querySelector('.campaign-form-error') as HTMLElement;
  const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const fd = new FormData(form);
  errEl.textContent = '';
  btn.disabled = true;
  try {
    await post('/api/admin/campaigns/create', {
      name: fd.get('name'),
      kind: fd.get('kind'),
      starts_on: fd.get('starts_on'),
      ends_on: fd.get('ends_on') || null,
      notes: fd.get('notes'),
    });
    reloadToCampaigns();
  } catch (err: any) {
    errEl.textContent = err.message;
    btn.disabled = false;
  }
});

document.getElementById('campaigns')?.addEventListener('click', async (e) => {
  const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-campaign-delete]');
  if (!btn) return;
  if (!window.confirm(`Delete "${btn.dataset.campaignName}"? Its signups will count as organic.`)) return;
  btn.disabled = true;
  try {
    await post('/api/admin/campaigns/delete', { id: btn.dataset.campaignDelete });
    reloadToCampaigns();
  } catch (err: any) {
    btn.disabled = false;
    alert(err.message);
  }
});
</script>

