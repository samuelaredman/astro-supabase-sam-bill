---
export const prerender = false;
import Layout from "../../../components/Layout.astro";
import { resolveSiteAdminProfile } from "../../../utils/api";
import { getSupabaseAdmin } from "../../../utils/database";
import "../../../styles/admin.css";

const profile = await resolveSiteAdminProfile(Astro);
if (!profile) return Astro.redirect('/404');

const url = new URL(Astro.request.url);
const q = (url.searchParams.get('q') ?? '').trim();

const db = getSupabaseAdmin() as any;

interface Result {
  id: string;
  username: string;
  avatar_url: string | null;
  review_count: number;
  reports_against: number;
}

let results: Result[] = [];
let searched = false;

if (q.length >= 2) {
  searched = true;
  const { data: profiles } = await db
    .from('profiles')
    .select('id, username, avatar_url')
    .ilike('username', `%${q}%`)
    .order('username', { ascending: true })
    .limit(50);

  const profileRows = (profiles ?? []) as any[];
  const ids = profileRows.map((p) => p.id);

  if (ids.length) {
    const [reviewStatsRes, reportsRes] = await Promise.all([
      db.from('profile_review_stats').select('profile_id, review_count').in('profile_id', ids),
      db.from('reports').select('target_id', { count: 'exact', head: false }).eq('target_type', 'profile').eq('status', 'pending').in('target_id', ids),
    ]);
    const reviewMap = new Map<string, number>(((reviewStatsRes.data as any[]) ?? []).map((r) => [r.profile_id, r.review_count ?? 0]));
    const reportCounts = new Map<string, number>();
    for (const row of ((reportsRes.data as any[]) ?? [])) {
      reportCounts.set(row.target_id, (reportCounts.get(row.target_id) ?? 0) + 1);
    }

    results = profileRows.map((p) => ({
      id: p.id,
      username: p.username,
      avatar_url: p.avatar_url,
      review_count: reviewMap.get(p.id) ?? 0,
      reports_against: reportCounts.get(p.id) ?? 0,
    }));
  }
}

function getInitials(username: string): string {
  return username.slice(0, 2).toUpperCase();
}
---

<Layout title="Users — Admin" isLoggedIn={true} currentProfile={profile} activeNav="admin" variant="two-col">
  <main class="feed admin-main">
    <div class="admin-content">
      <a href="/admin" class="admin-back-link">← Admin</a>

      <header class="admin-page-header">
        <div>
          <h1 class="admin-page-title">Users</h1>
          <p class="admin-page-subtitle">Search profiles by username. Click a result to open their moderation view — badges, bans, reports.</p>
        </div>
      </header>

      <form method="get" action="/admin/users" class="user-search-form">
        <input type="text" name="q" value={q} placeholder="Search usernames…" class="admin-input user-search-input" autofocus required minlength="2" />
        <button type="submit" class="admin-btn admin-btn-primary">Search</button>
      </form>

      {searched && results.length === 0 && <p class="admin-empty">No users matching "{q}".</p>}
      {!searched && <p class="admin-empty">Type at least 2 characters to search.</p>}

      {results.length > 0 && (
        <ul class="user-result-list">
          {results.map((u) => (
            <li class="user-result">
              <a href={`/admin/users/${encodeURIComponent(u.username)}`} class="user-result-link">
                <div class="user-result-avatar">
                  {u.avatar_url
                    ? <img src={u.avatar_url} alt={u.username} />
                    : <span>{getInitials(u.username)}</span>
                  }
                </div>
                <div class="user-result-info">
                  <div class="user-result-name">{u.username}</div>
                  <div class="user-result-meta">
                    <span>{u.review_count} {u.review_count === 1 ? 'review' : 'reviews'}</span>
                    {u.reports_against > 0 && (
                      <span class="admin-chip admin-chip-danger">⚠ {u.reports_against} pending {u.reports_against === 1 ? 'report' : 'reports'}</span>
                    )}
                  </div>
                </div>
                <span class="user-result-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </main>
</Layout>

<style>
  .user-search-form {
    display: flex;
    gap: 10px;
    margin: 0 0 16px;
  }
  .user-search-input { flex: 1; }

  .user-result-list {
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .user-result { margin: 0; }
  .user-result-link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-card);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, background 0.15s, transform 0.08s;
  }
  .user-result-link:hover {
    border-color: var(--accent);
    background: var(--bg-hover);
    transform: translateY(-1px);
  }
  .user-result-avatar {
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--bg-hover);
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 600;
    overflow: hidden;
    flex-shrink: 0;
  }
  .user-result-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .user-result-info { min-width: 0; flex: 1; }
  .user-result-name { font-weight: 600; font-size: 15px; }
  .user-result-meta {
    font-size: 12.5px;
    color: var(--text-secondary);
    margin-top: 4px;
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
  .user-result-arrow {
    color: var(--text-tertiary);
    font-size: 18px;
    transition: color 0.15s, transform 0.15s;
  }
  .user-result-link:hover .user-result-arrow {
    color: var(--accent);
    transform: translateX(2px);
  }
</style>
