---
export const prerender = false;
import Layout from "../../../components/Layout.astro";
import ProfileBadge from "../../../components/ProfileBadge.astro";
import { resolveSiteAdminProfile } from "../../../utils/api";
import { getSupabaseAdmin } from "../../../utils/database";
import { listBadges } from "../../../utils/badges";
import "../../../styles/admin.css";

const adminProfile = await resolveSiteAdminProfile(Astro);
if (!adminProfile) return Astro.redirect('/404');

const username = Astro.params.username ?? '';
if (!username) return Astro.redirect('/admin/users');

const db = getSupabaseAdmin() as any;

const { data: profile } = await db
  .from('profiles')
  .select('id, auth_user_id, username, avatar_url, banner_url, favorite_game_id, onboarding_completed_at, steam_id, steam_username')
  .eq('username', username)
  .maybeSingle();

if (!profile) return Astro.redirect('/admin/users?q=' + encodeURIComponent(username));

// Auth metadata (email, created_at, last_sign_in_at, banned_until). Non-fatal if it fails.
let authUser: {
  email: string | null;
  created_at: string | null;
  last_sign_in_at: string | null;
  email_confirmed_at: string | null;
  banned_until: string | null;
} = {
  email: null, created_at: null, last_sign_in_at: null, email_confirmed_at: null, banned_until: null,
};
try {
  const { data } = await db.auth.admin.getUserById(profile.auth_user_id);
  if (data?.user) {
    authUser = {
      email: data.user.email ?? null,
      created_at: data.user.created_at ?? null,
      last_sign_in_at: data.user.last_sign_in_at ?? null,
      email_confirmed_at: data.user.email_confirmed_at ?? null,
      // supabase-js types don't expose banned_until, but auth.admin returns it.
      banned_until: (data.user as any).banned_until ?? null,
    };
  }
} catch (e) {
  console.error('[admin/users/[username]] auth.getUserById error:', e);
}

const isBanned = authUser.banned_until ? new Date(authUser.banned_until) > new Date() : false;

const pid = profile.id;

// Current badges on this user. profile_badges is service-role-write only;
// toggle via POST /api/admin/users/badges and reload.
const { data: userBadgeRows } = await db
  .from('profile_badges')
  .select('badge_slug')
  .eq('profile_id', pid);
const currentBadgeSlugs = new Set<string>(((userBadgeRows as any[]) ?? []).map((r) => r.badge_slug));
const allBadges = listBadges();

// Fetch content + follows + reports in parallel. Content lists use a cap of 500
// so we can filter them JS-side to flagged items only without silently truncating.
const [
  reviewsAllRes, commentsAllRes, recsAllRes,
  followersRes, followingRes,
  reportsFiledRes,
] = await Promise.all([
  db.from('reviews')
    .select('id, title, body, status, score, created_at, games(title, slug)')
    .eq('profile_id', pid).order('created_at', { ascending: false }).limit(500),
  db.from('review_comments')
    .select('id, body, review_id, created_at')
    .eq('profile_id', pid).order('created_at', { ascending: false }).limit(500),
  db.from('recommendations')
    .select('id, body, status, created_at, source_game:games!source_game_id(title, slug), target_game:games!target_game_id(title)')
    .eq('profile_id', pid).order('created_at', { ascending: false }).limit(500),
  db.from('follows').select('*', { count: 'exact', head: true }).eq('following_id', pid),
  db.from('follows').select('*', { count: 'exact', head: true }).eq('follower_id', pid),
  db.from('reports')
    .select('id, target_type, target_id, reason, notes, status, created_at')
    .eq('reporter_id', pid).order('created_at', { ascending: false }).limit(20),
]);

const reviewsAll = (reviewsAllRes.data as any[]) ?? [];
const commentsAll = (commentsAllRes.data as any[]) ?? [];
const recsAll = (recsAllRes.data as any[]) ?? [];
const followerCount = followersRes.count ?? 0;
const followingCount = followingRes.count ?? 0;
const reportsFiled = (reportsFiledRes.data as any[]) ?? [];

const reviewIds = reviewsAll.map((r) => r.id as string);
const commentIds = commentsAll.map((c) => c.id as string);
const recIds = recsAll.map((r) => r.id as string);

// Reports against this user and their content.
const [profileReportsRes, reviewReportsRes, commentReportsRes, recReportsRes] = await Promise.all([
  db.from('reports').select('id, reason, notes, created_at, reporter:profiles!reporter_id(username)')
    .eq('target_type', 'profile').eq('target_id', pid).eq('status', 'pending').order('created_at', { ascending: false }),
  reviewIds.length
    ? db.from('reports').select('id, target_id, reason, notes, created_at, reporter:profiles!reporter_id(username)')
      .eq('target_type', 'review').eq('status', 'pending').in('target_id', reviewIds).order('created_at', { ascending: false })
    : Promise.resolve({ data: [] as any[] }),
  commentIds.length
    ? db.from('reports').select('id, target_id, reason, notes, created_at, reporter:profiles!reporter_id(username)')
      .eq('target_type', 'comment').eq('status', 'pending').in('target_id', commentIds).order('created_at', { ascending: false })
    : Promise.resolve({ data: [] as any[] }),
  recIds.length
    ? db.from('reports').select('id, target_id, reason, notes, created_at, reporter:profiles!reporter_id(username)')
      .eq('target_type', 'recommendation').eq('status', 'pending').in('target_id', recIds).order('created_at', { ascending: false })
    : Promise.resolve({ data: [] as any[] }),
]);

const profileReports = (profileReportsRes.data as any[]) ?? [];
const reviewReports = (reviewReportsRes.data as any[]) ?? [];
const commentReports = (commentReportsRes.data as any[]) ?? [];
const recReports = (recReportsRes.data as any[]) ?? [];

const totalReportsAgainst = profileReports.length + reviewReports.length + commentReports.length + recReports.length;

// Flag-only filtering: a post is interesting to a moderator if it's a draft,
// a deleted review, or has at least one pending report against it. Everything
// else is noise.
const reviewReportCounts = new Map<string, number>();
for (const r of reviewReports) reviewReportCounts.set(r.target_id, (reviewReportCounts.get(r.target_id) ?? 0) + 1);
const commentReportCounts = new Map<string, number>();
for (const r of commentReports) commentReportCounts.set(r.target_id, (commentReportCounts.get(r.target_id) ?? 0) + 1);
const recReportCounts = new Map<string, number>();
for (const r of recReports) recReportCounts.set(r.target_id, (recReportCounts.get(r.target_id) ?? 0) + 1);

const flaggedReviews = reviewsAll
  .filter((r) => r.status !== 'published' || reviewReportCounts.has(r.id))
  .map((r) => ({ ...r, report_count: reviewReportCounts.get(r.id) ?? 0 }));
const flaggedComments = commentsAll
  .filter((c) => commentReportCounts.has(c.id))
  .map((c) => ({ ...c, report_count: commentReportCounts.get(c.id) ?? 0 }));
const flaggedRecs = recsAll
  .filter((r) => r.status !== 'published' || recReportCounts.has(r.id))
  .map((r) => ({ ...r, report_count: recReportCounts.get(r.id) ?? 0 }));

function fmtDate(s: string | null): string {
  if (!s) return '—';
  return new Date(s).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
function truncate(s: string | null | undefined, n: number): string {
  if (!s) return '';
  return s.length > n ? s.slice(0, n) + '…' : s;
}
function getInitials(u: string): string { return u.slice(0, 2).toUpperCase(); }
---

<Layout title={`${profile.username} — Admin`} isLoggedIn={true} currentProfile={adminProfile} activeNav="admin" variant="two-col">
  <main class="feed admin-main">
    <div class="admin-content">
      <a href="/admin/users" class="admin-back-link">← Users</a>

      {isBanned && (
        <div class="ban-banner" role="status" aria-live="polite">
          <span class="ban-banner-icon" aria-hidden="true">⛔</span>
          <div class="ban-banner-text">
            <strong>Banned</strong>
            <span class="ban-banner-sub">
              {authUser.banned_until && `until ${fmtDate(authUser.banned_until)}`} — can't sign in, existing session expires within an hour
            </span>
          </div>
        </div>
      )}

      <section class="user-header">
        <div class="user-header-avatar">
          {profile.avatar_url
            ? <img src={profile.avatar_url} alt={profile.username} />
            : <span>{getInitials(profile.username)}</span>
          }
        </div>
        <div class="user-header-info">
          <h2 class="user-header-name">
            {profile.username}
            {Array.from(currentBadgeSlugs).map((slug) => <ProfileBadge slug={slug} size="md" />)}
            <a href={`/reviewers/${profile.username}`} class="user-public-link" target="_blank" rel="noopener">view public profile ↗</a>
          </h2>
          <div class="user-admin-actions">
            <button
              id="banToggleBtn"
              class={`admin-btn ${isBanned ? '' : 'admin-btn-danger'}`}
              data-profile-id={pid}
              data-banned={isBanned ? 'true' : 'false'}
              type="button"
            >
              {isBanned ? 'Unban user' : 'Ban user'}
            </button>
          </div>
          <div class="badge-assign">
            <div class="badge-assign-label">Badges</div>
            <div class="badge-assign-list">
              {allBadges.map((b) => {
                const on = currentBadgeSlugs.has(b.slug);
                return (
                  <label class={`badge-toggle${on ? ' badge-toggle--on' : ''}`}>
                    <input
                      type="checkbox"
                      class="badge-toggle-input"
                      data-profile-id={pid}
                      data-badge-slug={b.slug}
                      checked={on}
                    />
                    <span class="badge-toggle-icon" aria-hidden="true" style={`color:${b.color}`}>{b.icon}</span>
                    <span class="badge-toggle-text">
                      <span class="badge-toggle-name">{b.label}</span>
                      <span class="badge-toggle-desc">{b.description}</span>
                    </span>
                  </label>
                );
              })}
            </div>
          </div>
          <dl class="user-meta-grid">
            <div><dt>Email</dt><dd>{authUser.email ?? '—'} {authUser.email && !authUser.email_confirmed_at && <span class="warn">(unconfirmed)</span>}</dd></div>
            <div><dt>Joined</dt><dd>{fmtDate(authUser.created_at)}</dd></div>
            <div><dt>Last sign in</dt><dd>{fmtDate(authUser.last_sign_in_at)}</dd></div>
            <div><dt>Onboarded</dt><dd>{profile.onboarding_completed_at ? fmtDate(profile.onboarding_completed_at) : '—'}</dd></div>
            <div><dt>Steam</dt><dd>{profile.steam_username ?? profile.steam_id ?? '—'}</dd></div>
            <div><dt>Profile ID</dt><dd class="mono">{profile.id}</dd></div>
          </dl>
        </div>
      </section>

      <section class="admin-stat-row admin-stat-row--compact">
        <div class="admin-stat"><div class="admin-stat-label">Reviews</div><div class="admin-stat-num">{reviewsAll.length === 500 ? '500+' : reviewsAll.length}</div></div>
        <div class="admin-stat"><div class="admin-stat-label">Comments</div><div class="admin-stat-num">{commentsAll.length === 500 ? '500+' : commentsAll.length}</div></div>
        <div class="admin-stat"><div class="admin-stat-label">Recs</div><div class="admin-stat-num">{recsAll.length === 500 ? '500+' : recsAll.length}</div></div>
        <div class="admin-stat"><div class="admin-stat-label">Followers</div><div class="admin-stat-num">{followerCount}</div></div>
        <div class="admin-stat"><div class="admin-stat-label">Following</div><div class="admin-stat-num">{followingCount}</div></div>
        <div class={`admin-stat${totalReportsAgainst > 0 ? ' admin-stat-flag' : ''}`}><div class="admin-stat-label">Reports against</div><div class="admin-stat-num">{totalReportsAgainst}</div></div>
        <div class="admin-stat"><div class="admin-stat-label">Reports filed</div><div class="admin-stat-num">{reportsFiled.length === 20 ? '20+' : reportsFiled.length}</div></div>
      </section>

      {totalReportsAgainst > 0 && (
        <section class="admin-section">
          <h3 class="admin-section-title">Pending reports against this user</h3>
          <ul class="moderation-list">
            {profileReports.map((r: any) => (
              <li class="moderation-item" data-target-type="profile" data-target-id={pid}>
                <div class="moderation-head">
                  <span class="report-type-badge">profile</span>
                  <span class="report-reason-badge">{r.reason}</span>
                  <span class="moderation-reporter">by {r.reporter?.username ?? 'unknown'}</span>
                  <span class="moderation-date">{fmtDate(r.created_at)}</span>
                </div>
                {r.notes && <div class="moderation-note">Note: {r.notes}</div>}
                <div class="moderation-actions">
                  <button class="admin-btn" data-action="resolve-report" type="button">Resolve</button>
                  <button class="admin-btn" data-action="dismiss-report" type="button">Dismiss</button>
                </div>
              </li>
            ))}
            {reviewReports.map((r: any) => (
              <li class="moderation-item" data-target-type="review" data-target-id={r.target_id}>
                <div class="moderation-head">
                  <span class="report-type-badge">review</span>
                  <span class="report-reason-badge">{r.reason}</span>
                  <span class="moderation-reporter">by {r.reporter?.username ?? 'unknown'}</span>
                  <span class="moderation-date">{fmtDate(r.created_at)}</span>
                  <a href={`/reviews/${r.target_id}`} target="_blank" rel="noopener" class="moderation-link">view ↗</a>
                </div>
                {r.notes && <div class="moderation-note">Note: {r.notes}</div>}
                <div class="moderation-actions">
                  <button class="admin-btn admin-btn-danger" data-action="delete-content" type="button">Delete review</button>
                  <button class="admin-btn" data-action="resolve-report" type="button">Resolve</button>
                  <button class="admin-btn" data-action="dismiss-report" type="button">Dismiss</button>
                </div>
              </li>
            ))}
            {commentReports.map((r: any) => (
              <li class="moderation-item" data-target-type="comment" data-target-id={r.target_id}>
                <div class="moderation-head">
                  <span class="report-type-badge">comment</span>
                  <span class="report-reason-badge">{r.reason}</span>
                  <span class="moderation-reporter">by {r.reporter?.username ?? 'unknown'}</span>
                  <span class="moderation-date">{fmtDate(r.created_at)}</span>
                </div>
                {r.notes && <div class="moderation-note">Note: {r.notes}</div>}
                <div class="moderation-actions">
                  <button class="admin-btn admin-btn-danger" data-action="delete-content" type="button">Delete comment</button>
                  <button class="admin-btn" data-action="resolve-report" type="button">Resolve</button>
                  <button class="admin-btn" data-action="dismiss-report" type="button">Dismiss</button>
                </div>
              </li>
            ))}
            {recReports.map((r: any) => (
              <li class="moderation-item" data-target-type="recommendation" data-target-id={r.target_id}>
                <div class="moderation-head">
                  <span class="report-type-badge">rec</span>
                  <span class="report-reason-badge">{r.reason}</span>
                  <span class="moderation-reporter">by {r.reporter?.username ?? 'unknown'}</span>
                  <span class="moderation-date">{fmtDate(r.created_at)}</span>
                </div>
                {r.notes && <div class="moderation-note">Note: {r.notes}</div>}
                <div class="moderation-actions">
                  <button class="admin-btn admin-btn-danger" data-action="delete-content" type="button">Delete rec</button>
                  <button class="admin-btn" data-action="resolve-report" type="button">Resolve</button>
                  <button class="admin-btn" data-action="dismiss-report" type="button">Dismiss</button>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="admin-section">
        <h3 class="admin-section-title">Flagged reviews <span class="section-sub">drafts, deleted, or reported</span></h3>
        {flaggedReviews.length === 0 && <p class="admin-empty">Nothing flagged.</p>}
        <ul class="moderation-list">
          {flaggedReviews.map((rev: any) => (
            <li class="moderation-item" data-target-type="review" data-target-id={rev.id}>
              <div class="moderation-head">
                <span class="score-badge">{rev.score ?? '—'}</span>
                <span class="moderation-title">{rev.games?.title ?? '(no game)'}{rev.title ? ` — ${rev.title}` : ''}</span>
                <span class="status-badge" data-status={rev.status}>{rev.status}</span>
                {rev.report_count > 0 && <span class="report-count-badge">⚠ {rev.report_count} {rev.report_count === 1 ? 'report' : 'reports'}</span>}
                <span class="moderation-date">{fmtDate(rev.created_at)}</span>
                <a href={`/reviews/${rev.id}`} target="_blank" rel="noopener" class="moderation-link">view ↗</a>
              </div>
              <div class="moderation-body">{truncate(rev.body, 220)}</div>
              {rev.status !== 'deleted' && (
                <div class="moderation-actions">
                  <button class="admin-btn admin-btn-danger" data-action="delete-content" type="button">Delete</button>
                </div>
              )}
            </li>
          ))}
        </ul>
      </section>

      <section class="admin-section">
        <h3 class="admin-section-title">Flagged comments <span class="section-sub">reported</span></h3>
        {flaggedComments.length === 0 && <p class="admin-empty">Nothing flagged.</p>}
        <ul class="moderation-list">
          {flaggedComments.map((c: any) => (
            <li class="moderation-item" data-target-type="comment" data-target-id={c.id}>
              <div class="moderation-head">
                <span class="moderation-title">Comment on review</span>
                {c.report_count > 0 && <span class="report-count-badge">⚠ {c.report_count} {c.report_count === 1 ? 'report' : 'reports'}</span>}
                <span class="moderation-date">{fmtDate(c.created_at)}</span>
                <a href={`/reviews/${c.review_id}`} target="_blank" rel="noopener" class="moderation-link">view ↗</a>
              </div>
              <div class="moderation-body">{truncate(c.body, 220)}</div>
              <div class="moderation-actions">
                <button class="admin-btn admin-btn-danger" data-action="delete-content" type="button">Delete</button>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="admin-section">
        <h3 class="admin-section-title">Flagged recommendations <span class="section-sub">drafts or reported</span></h3>
        {flaggedRecs.length === 0 && <p class="admin-empty">Nothing flagged.</p>}
        <ul class="moderation-list">
          {flaggedRecs.map((rec: any) => (
            <li class="moderation-item" data-target-type="recommendation" data-target-id={rec.id}>
              <div class="moderation-head">
                <span class="moderation-title">{rec.source_game?.title ?? '?'} → {rec.target_game?.title ?? '?'}</span>
                {rec.status && rec.status !== 'published' && <span class="status-badge" data-status={rec.status}>{rec.status}</span>}
                {rec.report_count > 0 && <span class="report-count-badge">⚠ {rec.report_count} {rec.report_count === 1 ? 'report' : 'reports'}</span>}
                <span class="moderation-date">{fmtDate(rec.created_at)}</span>
              </div>
              <div class="moderation-body">{truncate(rec.body, 220)}</div>
              <div class="moderation-actions">
                <button class="admin-btn admin-btn-danger" data-action="delete-content" type="button">Delete</button>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="admin-section">
        <h3 class="admin-section-title">Reports filed by this user</h3>
        {reportsFiled.length === 0 && <p class="admin-empty">None.</p>}
        <ul class="moderation-list">
          {reportsFiled.map((r: any) => (
            <li class="moderation-item">
              <div class="moderation-head">
                <span class="report-type-badge">{r.target_type}</span>
                <span class="report-reason-badge">{r.reason}</span>
                <span class="status-badge" data-status={r.status}>{r.status}</span>
                <span class="moderation-date">{fmtDate(r.created_at)}</span>
              </div>
              {r.notes && <div class="moderation-note">Note: {r.notes}</div>}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </main>
</Layout>

<script>
async function act(endpoint: string, targetType: string, targetId: string, item: HTMLElement, confirmMessage?: string) {
  if (confirmMessage && !window.confirm(confirmMessage)) return;
  const buttons = item.querySelectorAll<HTMLButtonElement>('button[data-action]');
  buttons.forEach((b) => (b.disabled = true));
  try {
    const res = await fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ target_type: targetType, target_id: targetId }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error ?? 'Failed');
    item.remove();
  } catch (e: any) {
    buttons.forEach((b) => (b.disabled = false));
    alert(e.message ?? 'Something went wrong.');
  }
}

document.querySelector('.admin-content')?.addEventListener('click', (e) => {
  const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-action]');
  if (!btn) return;
  const item = btn.closest<HTMLElement>('.moderation-item');
  if (!item) return;
  const targetType = item.dataset.targetType;
  const targetId = item.dataset.targetId;
  if (!targetType || !targetId) return;
  const action = btn.dataset.action;

  if (action === 'delete-content') {
    act('/api/admin/reports/delete-target', targetType, targetId, item, 'Delete this content? This cannot be undone (reviews are hidden; comments and recommendations are permanently removed).');
  } else if (action === 'resolve-report') {
    act('/api/admin/reports/resolve', targetType, targetId, item);
  } else if (action === 'dismiss-report') {
    act('/api/admin/reports/dismiss', targetType, targetId, item);
  }
});

// Badge toggles — fire-and-forget, reload on success so the header chip
// stays in sync without us having to render it client-side.
document.querySelectorAll<HTMLInputElement>('.badge-toggle-input').forEach((input) => {
  input.addEventListener('change', async () => {
    const profileId = input.dataset.profileId;
    const badgeSlug = input.dataset.badgeSlug;
    if (!profileId || !badgeSlug) return;
    const assigned = input.checked;
    input.disabled = true;
    try {
      const res = await fetch('/api/admin/users/badges', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ profile_id: profileId, badge_slug: badgeSlug, assigned }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? 'Failed');
      window.location.reload();
    } catch (e: any) {
      input.checked = !assigned;
      input.disabled = false;
      alert(e.message ?? 'Something went wrong.');
    }
  });
});

// Ban / unban toggle
const banBtn = document.getElementById('banToggleBtn') as HTMLButtonElement | null;
if (banBtn) {
  banBtn.addEventListener('click', async () => {
    const profileId = banBtn.dataset.profileId;
    const currentlyBanned = banBtn.dataset.banned === 'true';
    if (!profileId) return;
    const confirmMsg = currentlyBanned
      ? 'Unban this user? They will be able to sign in again.'
      : 'Ban this user? They will be unable to sign in; existing session fails within an hour. Content is NOT auto-deleted.';
    if (!window.confirm(confirmMsg)) return;
    banBtn.disabled = true;
    try {
      const res = await fetch('/api/admin/users/ban', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ profile_id: profileId, banned: !currentlyBanned }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? 'Failed');
      // Reload so the banner + button state come straight from the auth record.
      window.location.reload();
    } catch (e: any) {
      banBtn.disabled = false;
      alert(e.message ?? 'Something went wrong.');
    }
  });
}
</script>

<style>
  /* Page-local only — primitives in src/styles/admin.css. */

