---
export const prerender = false;
import Layout from "../../../components/Layout.astro";
import { resolveSiteAdminProfile } from "../../../utils/api";
import { getSupabaseAdmin } from "../../../utils/database";

const adminProfile = await resolveSiteAdminProfile(Astro);
if (!adminProfile) return Astro.redirect('/404');

const username = Astro.params.username ?? '';
if (!username) return Astro.redirect('/admin/users');

const db = getSupabaseAdmin() as any;

const { data: profile } = await db
  .from('profiles')
  .select('id, auth_user_id, username, avatar_url, banner_url, favorite_game_id, onboarding_completed_at, steam_id, steam_username')
  .eq('username', username)
  .maybeSingle();

if (!profile) return Astro.redirect('/admin/users?q=' + encodeURIComponent(username));

// Auth metadata (email, created_at, last_sign_in_at). Non-fatal if it fails.
let authUser: { email: string | null; created_at: string | null; last_sign_in_at: string | null; email_confirmed_at: string | null } = {
  email: null, created_at: null, last_sign_in_at: null, email_confirmed_at: null,
};
try {
  const { data } = await db.auth.admin.getUserById(profile.auth_user_id);
  if (data?.user) {
    authUser = {
      email: data.user.email ?? null,
      created_at: data.user.created_at ?? null,
      last_sign_in_at: data.user.last_sign_in_at ?? null,
      email_confirmed_at: data.user.email_confirmed_at ?? null,
    };
  }
} catch (e) {
  console.error('[admin/users/[username]] auth.getUserById error:', e);
}

const pid = profile.id;

// Content IDs we need for the "reports against this user's content" join.
const [reviewIdsRes, commentIdsRes, recIdsRes] = await Promise.all([
  db.from('reviews').select('id').eq('profile_id', pid),
  db.from('review_comments').select('id').eq('profile_id', pid),
  db.from('recommendations').select('id').eq('profile_id', pid),
]);
const reviewIds = ((reviewIdsRes.data as any[]) ?? []).map((r) => r.id);
const commentIds = ((commentIdsRes.data as any[]) ?? []).map((r) => r.id);
const recIds = ((recIdsRes.data as any[]) ?? []).map((r) => r.id);

// Everything else loaded in parallel.
const [
  reviewsRes, commentsRes, recsRes,
  followersRes, followingRes,
  profileReportsRes, reviewReportsRes, commentReportsRes, recReportsRes,
  reportsFiledRes,
] = await Promise.all([
  db.from('reviews')
    .select('id, title, body, status, score, created_at, games(title, slug)')
    .eq('profile_id', pid).order('created_at', { ascending: false }).limit(15),
  db.from('review_comments')
    .select('id, body, review_id, created_at')
    .eq('profile_id', pid).order('created_at', { ascending: false }).limit(15),
  db.from('recommendations')
    .select('id, body, created_at, source_game:games!source_game_id(title, slug), target_game:games!target_game_id(title)')
    .eq('profile_id', pid).order('created_at', { ascending: false }).limit(15),
  db.from('follows').select('*', { count: 'exact', head: true }).eq('following_id', pid),
  db.from('follows').select('*', { count: 'exact', head: true }).eq('follower_id', pid),
  db.from('reports').select('id, reason, notes, created_at, reporter:profiles!reporter_id(username)')
    .eq('target_type', 'profile').eq('target_id', pid).eq('status', 'pending').order('created_at', { ascending: false }),
  reviewIds.length
    ? db.from('reports').select('id, target_id, reason, notes, created_at, reporter:profiles!reporter_id(username)')
      .eq('target_type', 'review').eq('status', 'pending').in('target_id', reviewIds).order('created_at', { ascending: false })
    : Promise.resolve({ data: [] as any[] }),
  commentIds.length
    ? db.from('reports').select('id, target_id, reason, notes, created_at, reporter:profiles!reporter_id(username)')
      .eq('target_type', 'comment').eq('status', 'pending').in('target_id', commentIds).order('created_at', { ascending: false })
    : Promise.resolve({ data: [] as any[] }),
  recIds.length
    ? db.from('reports').select('id, target_id, reason, notes, created_at, reporter:profiles!reporter_id(username)')
      .eq('target_type', 'recommendation').eq('status', 'pending').in('target_id', recIds).order('created_at', { ascending: false })
    : Promise.resolve({ data: [] as any[] }),
  db.from('reports')
    .select('id, target_type, target_id, reason, notes, status, created_at')
    .eq('reporter_id', pid).order('created_at', { ascending: false }).limit(20),
]);

const reviews = (reviewsRes.data as any[]) ?? [];
const comments = (commentsRes.data as any[]) ?? [];
const recs = (recsRes.data as any[]) ?? [];
const followerCount = followersRes.count ?? 0;
const followingCount = followingRes.count ?? 0;
const profileReports = (profileReportsRes.data as any[]) ?? [];
const reviewReports = (reviewReportsRes.data as any[]) ?? [];
const commentReports = (commentReportsRes.data as any[]) ?? [];
const recReports = (recReportsRes.data as any[]) ?? [];
const reportsFiled = (reportsFiledRes.data as any[]) ?? [];

const totalReportsAgainst = profileReports.length + reviewReports.length + commentReports.length + recReports.length;

function fmtDate(s: string | null): string {
  if (!s) return '—';
  return new Date(s).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
function truncate(s: string | null | undefined, n: number): string {
  if (!s) return '';
  return s.length > n ? s.slice(0, n) + '…' : s;
}
function getInitials(u: string): string { return u.slice(0, 2).toUpperCase(); }
---

<Layout title={`${profile.username} — Admin`} isLoggedIn={true} currentProfile={adminProfile} activeNav="admin" variant="two-col">
  <main class="feed admin-main">
    <div class="feed-header">
      <div>
        <div class="feed-title">{profile.username}</div>
        <div class="feed-subtitle">Admin view</div>
      </div>
    </div>

    <div class="admin-content">
      <a href="/admin/users" class="admin-back-link">&larr; Users</a>

      <section class="user-header">
        <div class="user-header-avatar">
          {profile.avatar_url
            ? <img src={profile.avatar_url} alt={profile.username} />
            : <span>{getInitials(profile.username)}</span>
          }
        </div>
        <div class="user-header-info">
          <h2 class="user-header-name">
            {profile.username}
            <a href={`/reviewers/${profile.username}`} class="user-public-link" target="_blank" rel="noopener">view public profile ↗</a>
          </h2>
          <dl class="user-meta-grid">
            <div><dt>Email</dt><dd>{authUser.email ?? '—'} {authUser.email && !authUser.email_confirmed_at && <span class="warn">(unconfirmed)</span>}</dd></div>
            <div><dt>Joined</dt><dd>{fmtDate(authUser.created_at)}</dd></div>
            <div><dt>Last sign in</dt><dd>{fmtDate(authUser.last_sign_in_at)}</dd></div>
            <div><dt>Onboarded</dt><dd>{profile.onboarding_completed_at ? fmtDate(profile.onboarding_completed_at) : '—'}</dd></div>
            <div><dt>Steam</dt><dd>{profile.steam_username ?? profile.steam_id ?? '—'}</dd></div>
            <div><dt>Profile ID</dt><dd class="mono">{profile.id}</dd></div>
          </dl>
        </div>
      </section>

      <section class="stat-row">
        <div class="stat"><div class="stat-num">{reviews.length === 15 ? '15+' : reviews.length}</div><div class="stat-label">Reviews</div></div>
        <div class="stat"><div class="stat-num">{comments.length === 15 ? '15+' : comments.length}</div><div class="stat-label">Comments</div></div>
        <div class="stat"><div class="stat-num">{recs.length === 15 ? '15+' : recs.length}</div><div class="stat-label">Recs</div></div>
        <div class="stat"><div class="stat-num">{followerCount}</div><div class="stat-label">Followers</div></div>
        <div class="stat"><div class="stat-num">{followingCount}</div><div class="stat-label">Following</div></div>
        <div class={`stat${totalReportsAgainst > 0 ? ' stat-flag' : ''}`}><div class="stat-num">{totalReportsAgainst}</div><div class="stat-label">Reports against</div></div>
        <div class="stat"><div class="stat-num">{reportsFiled.length === 20 ? '20+' : reportsFiled.length}</div><div class="stat-label">Reports filed</div></div>
      </section>

      {totalReportsAgainst > 0 && (
        <section class="admin-section">
          <h3 class="admin-section-title">Pending reports against this user</h3>
          <ul class="moderation-list">
            {profileReports.map((r: any) => (
              <li class="moderation-item" data-target-type="profile" data-target-id={pid}>
                <div class="moderation-head">
                  <span class="report-type-badge">profile</span>
                  <span class="report-reason-badge">{r.reason}</span>
                  <span class="moderation-reporter">by {r.reporter?.username ?? 'unknown'}</span>
                  <span class="moderation-date">{fmtDate(r.created_at)}</span>
                </div>
                {r.notes && <div class="moderation-note">Note: {r.notes}</div>}
                <div class="moderation-actions">
                  <button class="admin-btn" data-action="resolve-report" type="button">Resolve</button>
                  <button class="admin-btn" data-action="dismiss-report" type="button">Dismiss</button>
                </div>
              </li>
            ))}
            {reviewReports.map((r: any) => (
              <li class="moderation-item" data-target-type="review" data-target-id={r.target_id}>
                <div class="moderation-head">
                  <span class="report-type-badge">review</span>
                  <span class="report-reason-badge">{r.reason}</span>
                  <span class="moderation-reporter">by {r.reporter?.username ?? 'unknown'}</span>
                  <span class="moderation-date">{fmtDate(r.created_at)}</span>
                  <a href={`/reviews/${r.target_id}`} target="_blank" rel="noopener" class="moderation-link">view ↗</a>
                </div>
                {r.notes && <div class="moderation-note">Note: {r.notes}</div>}
                <div class="moderation-actions">
                  <button class="admin-btn admin-btn-danger" data-action="delete-content" type="button">Delete review</button>
                  <button class="admin-btn" data-action="resolve-report" type="button">Resolve</button>
                  <button class="admin-btn" data-action="dismiss-report" type="button">Dismiss</button>
                </div>
              </li>
            ))}
            {commentReports.map((r: any) => (
              <li class="moderation-item" data-target-type="comment" data-target-id={r.target_id}>
                <div class="moderation-head">
                  <span class="report-type-badge">comment</span>
                  <span class="report-reason-badge">{r.reason}</span>
                  <span class="moderation-reporter">by {r.reporter?.username ?? 'unknown'}</span>
                  <span class="moderation-date">{fmtDate(r.created_at)}</span>
                </div>
                {r.notes && <div class="moderation-note">Note: {r.notes}</div>}
                <div class="moderation-actions">
                  <button class="admin-btn admin-btn-danger" data-action="delete-content" type="button">Delete comment</button>
                  <button class="admin-btn" data-action="resolve-report" type="button">Resolve</button>
                  <button class="admin-btn" data-action="dismiss-report" type="button">Dismiss</button>
                </div>
              </li>
            ))}
            {recReports.map((r: any) => (
              <li class="moderation-item" data-target-type="recommendation" data-target-id={r.target_id}>
                <div class="moderation-head">
                  <span class="report-type-badge">rec</span>
                  <span class="report-reason-badge">{r.reason}</span>
                  <span class="moderation-reporter">by {r.reporter?.username ?? 'unknown'}</span>
                  <span class="moderation-date">{fmtDate(r.created_at)}</span>
                </div>
                {r.notes && <div class="moderation-note">Note: {r.notes}</div>}
                <div class="moderation-actions">
                  <button class="admin-btn admin-btn-danger" data-action="delete-content" type="button">Delete rec</button>
                  <button class="admin-btn" data-action="resolve-report" type="button">Resolve</button>
                  <button class="admin-btn" data-action="dismiss-report" type="button">Dismiss</button>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="admin-section">
        <h3 class="admin-section-title">Recent reviews</h3>
        {reviews.length === 0 && <p class="admin-empty">None.</p>}
        <ul class="moderation-list">
          {reviews.map((rev: any) => (
            <li class="moderation-item" data-target-type="review" data-target-id={rev.id}>
              <div class="moderation-head">
                <span class="score-badge">{rev.score ?? '—'}</span>
                <span class="moderation-title">{rev.games?.title ?? '(no game)'}{rev.title ? ` — ${rev.title}` : ''}</span>
                <span class="status-badge" data-status={rev.status}>{rev.status}</span>
                <span class="moderation-date">{fmtDate(rev.created_at)}</span>
                <a href={`/reviews/${rev.id}`} target="_blank" rel="noopener" class="moderation-link">view ↗</a>
              </div>
              <div class="moderation-body">{truncate(rev.body, 220)}</div>
              {rev.status !== 'deleted' && (
                <div class="moderation-actions">
                  <button class="admin-btn admin-btn-danger" data-action="delete-content" type="button">Delete</button>
                </div>
              )}
            </li>
          ))}
        </ul>
      </section>

      <section class="admin-section">
        <h3 class="admin-section-title">Recent comments</h3>
        {comments.length === 0 && <p class="admin-empty">None.</p>}
        <ul class="moderation-list">
          {comments.map((c: any) => (
            <li class="moderation-item" data-target-type="comment" data-target-id={c.id}>
              <div class="moderation-head">
                <span class="moderation-title">Comment on review</span>
                <span class="moderation-date">{fmtDate(c.created_at)}</span>
                <a href={`/reviews/${c.review_id}`} target="_blank" rel="noopener" class="moderation-link">view ↗</a>
              </div>
              <div class="moderation-body">{truncate(c.body, 220)}</div>
              <div class="moderation-actions">
                <button class="admin-btn admin-btn-danger" data-action="delete-content" type="button">Delete</button>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="admin-section">
        <h3 class="admin-section-title">Recent recommendations</h3>
        {recs.length === 0 && <p class="admin-empty">None.</p>}
        <ul class="moderation-list">
          {recs.map((rec: any) => (
            <li class="moderation-item" data-target-type="recommendation" data-target-id={rec.id}>
              <div class="moderation-head">
                <span class="moderation-title">{rec.source_game?.title ?? '?'} → {rec.target_game?.title ?? '?'}</span>
                <span class="moderation-date">{fmtDate(rec.created_at)}</span>
              </div>
              <div class="moderation-body">{truncate(rec.body, 220)}</div>
              <div class="moderation-actions">
                <button class="admin-btn admin-btn-danger" data-action="delete-content" type="button">Delete</button>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="admin-section">
        <h3 class="admin-section-title">Reports filed by this user</h3>
        {reportsFiled.length === 0 && <p class="admin-empty">None.</p>}
        <ul class="moderation-list">
          {reportsFiled.map((r: any) => (
            <li class="moderation-item">
              <div class="moderation-head">
                <span class="report-type-badge">{r.target_type}</span>
                <span class="report-reason-badge">{r.reason}</span>
                <span class="status-badge" data-status={r.status}>{r.status}</span>
                <span class="moderation-date">{fmtDate(r.created_at)}</span>
              </div>
              {r.notes && <div class="moderation-note">Note: {r.notes}</div>}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </main>
</Layout>

<script>
async function act(endpoint: string, targetType: string, targetId: string, item: HTMLElement, confirmMessage?: string) {
  if (confirmMessage && !window.confirm(confirmMessage)) return;
  const buttons = item.querySelectorAll<HTMLButtonElement>('button[data-action]');
  buttons.forEach((b) => (b.disabled = true));
  try {
    const res = await fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ target_type: targetType, target_id: targetId }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error ?? 'Failed');
    item.remove();
  } catch (e: any) {
    buttons.forEach((b) => (b.disabled = false));
    alert(e.message ?? 'Something went wrong.');
  }
}

document.querySelector('.admin-content')?.addEventListener('click', (e) => {
  const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-action]');
  if (!btn) return;
  const item = btn.closest<HTMLElement>('.moderation-item');
  if (!item) return;
  const targetType = item.dataset.targetType;
  const targetId = item.dataset.targetId;
  if (!targetType || !targetId) return;
  const action = btn.dataset.action;

  if (action === 'delete-content') {
    act('/api/admin/reports/delete-target', targetType, targetId, item, 'Delete this content? This cannot be undone (reviews are hidden; comments and recommendations are permanently removed).');
  } else if (action === 'resolve-report') {
    act('/api/admin/reports/resolve', targetType, targetId, item);
  } else if (action === 'dismiss-report') {
    act('/api/admin/reports/dismiss', targetType, targetId, item);
  }
});
</script>

<style>
  .admin-main { min-width: 0; }
  .admin-content { padding: 20px; max-width: 900px; }
  .admin-back-link { font-size: 13px; color: var(--text-secondary); text-decoration: none; margin-bottom: 12px; display: inline-block; }
  .admin-back-link:hover { color: var(--accent); }
  .admin-empty { color: var(--text-secondary); font-size: 13px; }

  .user-header { display: flex; gap: 16px; align-items: flex-start; padding: 16px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; margin-top: 8px; }
  .user-header-avatar {
    width: 72px; height: 72px; border-radius: 50%;
    background: var(--bg-hover);
    display: flex; align-items: center; justify-content: center;
    font-size: 24px; font-weight: 600;
    overflow: hidden; flex-shrink: 0;
  }
  .user-header-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .user-header-info { flex: 1; min-width: 0; }
  .user-header-name { font-size: 20px; font-weight: 700; margin: 0 0 10px; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .user-public-link { font-size: 12px; font-weight: 500; color: var(--accent); text-decoration: none; }
  .user-public-link:hover { text-decoration: underline; }
  .user-meta-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 6px 24px; margin: 0; font-size: 13px; }
  .user-meta-grid div { display: flex; gap: 8px; }
  .user-meta-grid dt { color: var(--text-tertiary); min-width: 90px; }
  .user-meta-grid dd { margin: 0; color: var(--text-primary); word-break: break-all; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; }
  .warn { color: #c0392b; font-size: 11px; margin-left: 4px; }

  .stat-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 8px; margin-top: 16px; }
  .stat { padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--bg-card); text-align: center; }
  .stat-flag { border-color: #c0392b; }
  .stat-flag .stat-num { color: #c0392b; }
  .stat-num { font-size: 20px; font-weight: 700; }
  .stat-label { font-size: 11px; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.03em; }

  .admin-section { margin-top: 24px; }
  .admin-section-title { font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; color: var(--text-secondary); margin: 0 0 8px; }

  .moderation-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .moderation-item { border: 1px solid var(--border); border-radius: 10px; background: var(--bg-card); padding: 12px 14px; }
  .moderation-head { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; font-size: 12px; }
  .moderation-title { font-weight: 600; color: var(--text-primary); font-size: 13px; }
  .moderation-date { color: var(--text-tertiary); margin-left: auto; }
  .moderation-link { color: var(--accent); text-decoration: none; }
  .moderation-link:hover { text-decoration: underline; }
  .moderation-reporter { color: var(--text-secondary); }
  .moderation-note { font-size: 12px; color: var(--text-secondary); margin-top: 6px; font-style: italic; }
  .moderation-body { font-size: 13px; color: var(--text-primary); margin-top: 6px; line-height: 1.4; }
  .moderation-actions { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap; }

  .report-type-badge, .report-reason-badge, .status-badge, .score-badge {
    font-size: 10px; font-weight: 600; text-transform: uppercase;
    padding: 2px 8px; border-radius: 6px;
    background: var(--bg-hover); color: var(--text-secondary);
  }
  .score-badge { background: var(--accent); color: #fff; }
  .status-badge[data-status="published"] { background: #27ae60; color: #fff; }
  .status-badge[data-status="draft"] { background: #95a5a6; color: #fff; }
  .status-badge[data-status="deleted"] { background: #7f8c8d; color: #fff; }
  .status-badge[data-status="resolved"] { background: #27ae60; color: #fff; }
  .status-badge[data-status="dismissed"] { background: #95a5a6; color: #fff; }
  .status-badge[data-status="pending"] { background: #e67e22; color: #fff; }

  .admin-btn {
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-primary);
    border-radius: 8px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
  }
  .admin-btn:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
  .admin-btn:disabled { opacity: 0.5; cursor: wait; }
  .admin-btn-danger { border-color: #c0392b; color: #c0392b; }
  .admin-btn-danger:hover:not(:disabled) { background: #c0392b; color: #fff; border-color: #c0392b; }
</style>
