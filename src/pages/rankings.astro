---
export const prerender = false;
import { getSupabase } from '../utils/database';
import Layout from '../components/Layout.astro';
import { igdbImage, scoreClass } from '../utils/format';
import { createSupabaseServerClientFromContext } from '../utils/database';

const supabase = getSupabase();
const serverClient = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await serverClient.auth.getUser();
const isLoggedIn = !!user;

let currentProfile = null;
if (user) {
  const { data: cp } = await serverClient.from('profiles').select('id, username, avatar_url').eq('auth_user_id', user.id).single();
  currentProfile = cp;
}

const { data: scoreRows } = await (supabase as any)
  .from('reviews').select('game_id, score').eq('status', 'published');

const gameMap: Record<string, { scores: number[] }> = {};
for (const r of scoreRows ?? []) {
  if (!gameMap[r.game_id]) gameMap[r.game_id] = { scores: [] };
  gameMap[r.game_id].scores.push(r.score);
}

const allScores = (scoreRows ?? []).map((r: any) => r.score);
const globalMean = allScores.length > 0
  ? allScores.reduce((a: number, b: number) => a + b, 0) / allScores.length
  : 7;

const C = 5;
const MIN_REVIEWS = 2;

const ranked = Object.entries(gameMap)
  .filter(([, d]) => d.scores.length >= MIN_REVIEWS)
  .map(([gameId, d]) => {
    const n = d.scores.length;
    const rawAvg = d.scores.reduce((a, b) => a + b, 0) / n;
    const bayesian = (C * globalMean + d.scores.reduce((a, b) => a + b, 0)) / (C + n);
    return { gameId, reviewCount: n, rawAvg, bayesian };
  })
  .sort((a, b) => b.bayesian - a.bayesian)
  .slice(0, 100);

let rankedGames: any[] = [];
if (ranked.length > 0) {
  const { data: gameRows } = await (supabase as any)
    .from('games')
    .select('id, title, slug, cover_img_url, date_released')
    .in('id', ranked.map(r => r.gameId));

  const gameById: Record<string, any> = {};
  for (const g of gameRows ?? []) gameById[g.id] = g;

  rankedGames = ranked
    .map(r => ({ ...r, game: gameById[r.gameId] }))
    .filter(r => r.game);
}
---

<Layout
  title="Rankings — Chekpoint"
  description="All-time highest rated games on Chekpoint, ranked by community score."
  isLoggedIn={isLoggedIn}
  currentProfile={currentProfile}
  activeNav="rankings"
>
  <main class="feed">
    <div class="feed-header">
      <div>
        <div class="feed-title">Rankings</div>
        <div class="feed-subtitle">
          {rankedGames.length > 0
            ? `Top ${rankedGames.length} games by community score`
            : 'Not enough reviews yet to rank games'}
        </div>
      </div>
    </div>

    {rankedGames.length === 0 ? (
      <div class="empty-state">
        <div class="empty-state-title">Nothing to rank yet</div>
        <p>Once games have at least {MIN_REVIEWS} reviews, they'll appear here.</p>
        <button class="empty-cta" id="startReviewingBtn">Start reviewing</button>
      </div>
    ) : (
      <div class="ranking-list">
        {rankedGames.map(({ game, reviewCount, rawAvg }, i) => {
          const year = game.date_released ? new Date(game.date_released).getFullYear() : null;
          const coverUrl = igdbImage(game.cover_img_url, 't_cover_big');
          const medals = ['🥇', '🥈', '🥉'];
          const podiumClasses = ['rank-gold', 'rank-silver', 'rank-bronze'];
          const card = (
            <a href={`/games/${game.slug}`} class="ranking-card" style={coverUrl ? `--card-cover:url('${coverUrl}')` : ''}>
              <span class="rank-num">{i < 3 ? medals[i] : i + 1}</span>
              <div class="rank-cover">
                {coverUrl
                  ? <img src={coverUrl} alt={game.title} loading="lazy" />
                  : <span class="rank-cover-placeholder">🎮</span>
                }
              </div>
              <div class="rank-info">
                <div class="rank-title">{game.title}</div>
                <div class="rank-meta">
                  {year && <span>{year}</span>}
                  <span>{reviewCount} review{reviewCount !== 1 ? 's' : ''}</span>
                </div>
              </div>
              <div class={`score-badge ${scoreClass(rawAvg)} rank-score-badge`}>{rawAvg.toFixed(1)}</div>
            </a>
          );
          return i < 3 ? (
            <div class={`podium-frame ${podiumClasses[i]}`}>{card}</div>
          ) : card;
        })}
      </div>
    )}
  </main>

  <div slot="sidebar-right">
    <div class="widget">
      <div class="widget-title">How rankings work</div>
      <p style="font-size:13px;color:var(--text-secondary);line-height:1.65;margin:0 0 10px">
        Games are ranked by a Bayesian average — a game with 3 great reviews ranks lower than one with 30 great reviews. This prevents low-review-count outliers from topping the chart.
      </p>
      <p style="font-size:13px;color:var(--text-secondary);line-height:1.65;margin:0">
        Minimum {MIN_REVIEWS} reviews to appear.
      </p>
    </div>
    {rankedGames.length > 0 && (
      <div class="widget" style="margin-top:4px">
        <div class="widget-title">Stats</div>
        <div class="stat-row">
          <span class="stat-label">Games ranked</span>
          <span class="stat-value">{rankedGames.length}</span>
        </div>
        <div class="stat-row">
          <span class="stat-label">Total reviews</span>
          <span class="stat-value">{(scoreRows ?? []).length}</span>
        </div>
        <div class="stat-row">
          <span class="stat-label">Community avg</span>
          <span class="stat-value">{globalMean.toFixed(1)}</span>
        </div>
      </div>
    )}
  </div>
</Layout>

<style>
  .ranking-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 16px 20px;
  }

  .podium-frame {
    border-radius: 15px;
    padding: 2px;
  }
  .rank-gold   { background: linear-gradient(145deg, #7c4f00, #c8920a, #ffd700, #fff5a0, #ffd700, #c8920a, #7c4f00); }
  .rank-silver { background: linear-gradient(145deg, #4a4a4a, #8a8a8a, #c8c8c8, #f0f0f0, #c8c8c8, #8a8a8a, #4a4a4a); }
  .rank-bronze { background: linear-gradient(145deg, #4a2200, #8b4513, #cd7f32, #e8b06a, #cd7f32, #8b4513, #4a2200); }
  .podium-frame .ranking-card  { border: none; border-radius: 13px; }
  .rank-gold   .ranking-card { box-shadow: 0 0 20px rgba(255,215,0,0.25),   0 6px 24px rgba(0,0,0,0.4); }
  .rank-silver .ranking-card { box-shadow: 0 0 20px rgba(192,192,192,0.2),  0 6px 24px rgba(0,0,0,0.4); }
  .rank-bronze .ranking-card { box-shadow: 0 0 20px rgba(205,127,50,0.2),   0 6px 24px rgba(0,0,0,0.4); }
  .rank-gold   .ranking-card::after { background: rgba(80, 55, 0, 0.65); }
  .rank-silver .ranking-card::after { background: rgba(45, 45, 55, 0.65); }
  .rank-bronze .ranking-card::after { background: rgba(70, 35, 5, 0.65); }

  .ranking-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 14px;
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.15s, box-shadow 0.15s;
    background: var(--bg-card);
  }
  .ranking-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }

  /* Blurred cover bg */
  .ranking-card::before {
    content: '';
    position: absolute;
    inset: -20px;
    background-image: var(--card-cover);
    background-size: cover;
    background-position: center;
    filter: blur(28px) saturate(1.8);
    opacity: 0.55;
    z-index: 0;
  }
  /* Overlay for legibility */
  .ranking-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(13,13,15,0.72);
    z-index: 1;
  }
  [data-theme="light"] .ranking-card::after {
    background: rgba(255,255,255,0.76);
  }
  .ranking-card > * { position: relative; z-index: 2; }

  .rank-num {
    font-family: 'DM Serif Display', serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--text-tertiary);
    width: 28px;
    flex-shrink: 0;
    text-align: center;
    line-height: 1;
  }

  .rank-cover {
    width: 60px;
    height: 80px;
    border-radius: 8px;
    flex-shrink: 0;
    overflow: hidden;
    background: var(--tag-bg);
    border: 1px solid var(--border);
    box-shadow: 0 4px 14px rgba(0,0,0,0.35);
  }
  .rank-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .rank-cover-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
  }

  .rank-info { flex: 1; min-width: 0; }
  .rank-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    margin-bottom: 6px;
    letter-spacing: -0.1px;
  }
  .rank-meta {
    display: flex;
    gap: 6px;
    font-size: 12px;
    color: var(--text-tertiary);
  }
  .rank-meta span + span::before { content: '·'; margin-right: 6px; }

  .rank-score-badge {
    width: 46px;
    height: 46px;
    border-radius: 10px;
    font-size: 16px;
    flex-shrink: 0;
  }

  .empty-cta {
    display: inline-block;
    background: var(--accent);
    color: var(--accent-text);
    padding: 10px 24px;
    border-radius: 22px;
    font-size: 14px;
    font-weight: 500;
    transition: opacity 0.15s;
    margin-top: 16px;
  }
  .empty-cta:hover { opacity: 0.85; }
  .empty-cta[type="button"], button.empty-cta { border: none; cursor: pointer; font-family: inherit; }

  /* Sign-in prompt */
  .signin-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.65); z-index: 150; backdrop-filter: blur(2px); }
  .signin-overlay.open { display: block; }
  .signin-prompt { display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 360px; max-width: calc(100vw - 32px); background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; z-index: 160; padding: 32px 28px; text-align: center; }
  .signin-prompt.open { display: block; }
  .signin-prompt-title { font-size: 17px; font-weight: 600; color: var(--text-primary); margin-bottom: 8px; }
  .signin-prompt-sub { font-size: 14px; color: var(--text-secondary); margin: 0 0 24px; line-height: 1.5; }
  .signin-prompt-btns { display: flex; flex-direction: column; gap: 10px; }
  .signin-prompt-primary { display: block; padding: 11px 20px; background: var(--accent); color: var(--accent-text); text-decoration: none; border-radius: 10px; font-size: 14px; font-weight: 600; }
  .signin-prompt-secondary { display: block; padding: 11px 20px; background: transparent; color: var(--text-secondary); text-decoration: none; border-radius: 10px; font-size: 14px; font-weight: 500; border: 1px solid var(--border); }
  .signin-prompt-dismiss { margin-top: 12px; background: none; border: none; font-size: 13px; color: var(--text-tertiary); cursor: pointer; font-family: inherit; }
  .signin-prompt-dismiss:hover { color: var(--text-secondary); }
</style>

<!-- Sign-in prompt modal -->
<div class="signin-overlay" id="signinOverlay"></div>
<div class="signin-prompt" id="signinPrompt">
  <div class="signin-prompt-title">Sign in to write a review</div>
  <p class="signin-prompt-sub">Join Chekpoint to share your take and help rank games.</p>
  <div class="signin-prompt-btns">
    <a href="/signin" class="signin-prompt-primary">Sign in</a>
    <a href="/signup" class="signin-prompt-secondary">Create account</a>
  </div>
  <button class="signin-prompt-dismiss" id="signinDismiss">Maybe later</button>
</div>

<script is:inline define:vars={{ isLoggedIn }}>
  var startBtn = document.getElementById('startReviewingBtn');
  if (startBtn) {
    startBtn.addEventListener('click', function() {
      if (!isLoggedIn) {
        document.getElementById('signinOverlay').classList.add('open');
        document.getElementById('signinPrompt').classList.add('open');
      } else {
        window.location.href = '/?compose=1';
      }
    });
  }
  function closeSignin() {
    document.getElementById('signinOverlay').classList.remove('open');
    document.getElementById('signinPrompt').classList.remove('open');
  }
  var dismissBtn = document.getElementById('signinDismiss');
  if (dismissBtn) dismissBtn.addEventListener('click', closeSignin);
  var overlay = document.getElementById('signinOverlay');
  if (overlay) overlay.addEventListener('click', closeSignin);
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeSignin(); });
</script>
