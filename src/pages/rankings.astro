---
export const prerender = false;
import { getSupabase } from '../utils/database';
import Layout from '../components/Layout.astro';
import { createSupabaseServerClientFromContext } from '../utils/database';

const supabase = getSupabase();
const serverClient = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await serverClient.auth.getUser();
const isLoggedIn = !!user;

let currentProfile = null;
if (user) {
  const { data: cp } = await serverClient.from('profiles').select('id, username, avatar_url').eq('auth_user_id', user.id).single();
  currentProfile = cp;
}

const { data: scoreRows } = await (supabase as any)
  .from('reviews').select('game_id, score').eq('status', 'published');

const gameMap: Record<string, { scores: number[] }> = {};
for (const r of scoreRows ?? []) {
  if (!gameMap[r.game_id]) gameMap[r.game_id] = { scores: [] };
  gameMap[r.game_id].scores.push(r.score);
}

const allScores = (scoreRows ?? []).map((r: any) => r.score);
const globalMean = allScores.length > 0
  ? allScores.reduce((a: number, b: number) => a + b, 0) / allScores.length
  : 7;

const C = 5;
const MIN_REVIEWS = 2;

const ranked = Object.entries(gameMap)
  .filter(([, d]) => d.scores.length >= MIN_REVIEWS)
  .map(([gameId, d]) => {
    const n = d.scores.length;
    const rawAvg = d.scores.reduce((a, b) => a + b, 0) / n;
    const bayesian = (C * globalMean + d.scores.reduce((a, b) => a + b, 0)) / (C + n);
    return { gameId, reviewCount: n, rawAvg, bayesian };
  })
  .sort((a, b) => b.bayesian - a.bayesian)
  .slice(0, 100);

let rankedGames: any[] = [];
if (ranked.length > 0) {
  const { data: gameRows } = await (supabase as any)
    .from('games')
    .select('id, title, slug, cover_img_url, date_released')
    .in('id', ranked.map(r => r.gameId));

  const gameById: Record<string, any> = {};
  for (const g of gameRows ?? []) gameById[g.id] = g;

  rankedGames = ranked
    .map(r => ({ ...r, game: gameById[r.gameId] }))
    .filter(r => r.game);
}

function igdbImage(url: string | null, size = 't_cover_big') {
  if (!url) return null;
  const clean = url.startsWith('//') ? `https:${url}` : url;
  return clean.replace(/t_[a-z_]+/, size);
}

function scoreColor(score: number): string {
  if (score === 10) return 'score-perfect';
  if (score >= 9) return 'score-great';
  if (score >= 8) return 'score-teal';
  if (score >= 7) return 'score-good';
  if (score >= 5) return 'score-mid';
  if (score >= 3) return 'score-orange';
  return 'score-low';
}

// ── WREATH SVG BUILDER ────────────────────────────────────────────────────────
// Proper olive/laurel leaf: wider, rounded, more natural than the previous
// grass-blade shape. Each leaf is an ellipse-like bezier with a midrib.
// Leaves are placed along an arc from bottom-left to bottom-right.
//
// Leaf path: origin at stem base (bottom-centre of leaf).
// Width ~10px, length ~28px, slightly asymmetric for realism.
const LEAF = "M0 0 C-5 -4,-7 -14,-6 -20 C-5 -26,-2 -29,0 -30 C2 -29,5 -26,6 -20 C7 -14,5 -4,0 0 Z";
const MIDRIB = "M0 0 Q0 -15 0 -30";

// Leaf positions for the LEFT branch.
// Format: [cx, cy, rotation°]
// Rotation 0 = leaf points straight up.
// Positive rotation = tip leans toward centre (inward).
// The array goes from innermost (near centre-bottom) outward.
// Mirror about x=240 for right branch (negate rotation).
const LEFT_LEAVES: [number, number, number][] = [
  [238, 58,   2],
  [214, 52,   8],
  [190, 44,  16],
  [164, 36,  24],
  [138, 28,  32],
  [112, 22,  40],
  [ 86, 18,  50],
  [ 62, 16,  60],
  [ 38, 18,  72],
  [ 18, 24,  84],
];

// Per-tier leaf colours: [primary fill, highlight, vein stroke]
const WREATH_COLORS = {
  gold:   { fill: '#c8920a', hi: '#ffd700', vein: '#7c4f00', stem: '#a07010' },
  silver: { fill: '#909090', hi: '#e0e0e0', vein: '#505050', stem: '#707070' },
  bronze: { fill: '#a0601a', hi: '#cd7f32', vein: '#603010', stem: '#804820' },
};

function buildWreathSvg(tier: 'gold' | 'silver' | 'bronze'): string {
  const c = WREATH_COLORS[tier];
  const W = 480, H = 80;
  const cx = W / 2;

  // Build left-branch leaves
  let leftLeaves = '';
  LEFT_LEAVES.forEach(([x, y, r], idx) => {
    // Alternate two shades for depth
    const fill = idx % 2 === 0 ? c.fill : c.hi;
    leftLeaves += `
      <g transform="translate(${x},${y}) rotate(${r})">
        <path d="${LEAF}" fill="${fill}" opacity="0.95"/>
        <path d="${MIDRIB}" stroke="${c.vein}" stroke-width="0.7" fill="none" opacity="0.6"/>
      </g>`;
  });

  // Mirror for right branch
  let rightLeaves = '';
  LEFT_LEAVES.forEach(([x, y, r], idx) => {
    const fill = idx % 2 === 0 ? c.fill : c.hi;
    rightLeaves += `
      <g transform="translate(${W - x},${y}) rotate(${-r})">
        <path d="${LEAF}" fill="${fill}" opacity="0.95"/>
        <path d="${MIDRIB}" stroke="${c.vein}" stroke-width="0.7" fill="none" opacity="0.6"/>
      </g>`;
  });

  // Curved stems from bottom-corners meeting at centre-bottom
  const stems = `
    <path d="M10 72 C80 40 160 25 ${cx} 58" stroke="${c.stem}" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.8"/>
    <path d="M${W - 10} 72 C${W - 80} 40 ${W - 160} 25 ${cx} 58" stroke="${c.stem}" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.8"/>`;

  // Central ribbon knot
  const knot = `
    <ellipse cx="${cx}" cy="60" rx="9" ry="6" fill="${c.vein}" opacity="0.9"/>
    <ellipse cx="${cx}" cy="60" rx="5" ry="3.5" fill="${c.hi}" opacity="0.75"/>`;

  return `<svg class="laurel-wreath" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none"
    aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    ${stems}
    ${leftLeaves}
    ${rightLeaves}
    ${knot}
  </svg>`;
}

const wreathGold   = buildWreathSvg('gold');
const wreathSilver = buildWreathSvg('silver');
const wreathBronze = buildWreathSvg('bronze');
---

<Layout
  title="Rankings — Chekpoint"
  description="All-time highest rated games on Chekpoint, ranked by community score."
  isLoggedIn={isLoggedIn}
  currentProfile={currentProfile}
  activeNav="rankings"
>
  <main class="feed">
    <div class="feed-header">
      <div>
        <div class="feed-title">Rankings</div>
        <div class="feed-subtitle">
          {rankedGames.length > 0
            ? `Top ${rankedGames.length} games by community score`
            : 'Not enough reviews yet to rank games'}
        </div>
      </div>
    </div>

    {rankedGames.length === 0 ? (
      <div class="empty-state">
        <div class="empty-state-title">Nothing to rank yet</div>
        <p>Once games have at least {MIN_REVIEWS} reviews, they'll appear here.</p>
        <a href="/" class="empty-cta">Start reviewing</a>
      </div>
    ) : (
      <div class="ranking-list">
        {rankedGames.map(({ game, reviewCount, rawAvg }, i) => {
          const year = game.date_released ? new Date(game.date_released).getFullYear() : null;
          const coverUrl = igdbImage(game.cover_img_url, 't_cover_big');
          const medals = ['🥇', '🥈', '🥉'];
          const podiumClasses = ['rank-gold', 'rank-silver', 'rank-bronze'];
          const wreaths = [wreathGold, wreathSilver, wreathBronze];

          const card = (
            <a href={`/games/${game.slug}`} class="ranking-card" style={coverUrl ? `--card-cover:url('${coverUrl}')` : ''}>
              <span class="rank-num">{i < 3 ? medals[i] : i + 1}</span>
              <div class="rank-cover">
                {coverUrl
                  ? <img src={coverUrl} alt={game.title} loading="lazy" />
                  : <span class="rank-cover-placeholder">🎮</span>
                }
              </div>
              <div class="rank-info">
                <div class="rank-title">{game.title}</div>
                <div class="rank-meta">
                  {year && <span>{year}</span>}
                  <span>{reviewCount} review{reviewCount !== 1 ? 's' : ''}</span>
                </div>
              </div>
              <div class={`score-badge ${scoreColor(rawAvg)} rank-score-badge`}>{rawAvg.toFixed(1)}</div>
            </a>
          );

          return i < 3 ? (
            <div class={`podium-frame ${podiumClasses[i]}`}>
              {card}
              <Fragment set:html={wreaths[i]} />
            </div>
          ) : card;
        })}
      </div>
    )}
  </main>

  <div slot="sidebar-right">
    <div class="widget">
      <div class="widget-title">How rankings work</div>
      <p style="font-size:13px;color:var(--text-secondary);line-height:1.65;margin:0 0 10px">
        Games are ranked by a Bayesian average — a game with 3 great reviews ranks lower than one with 30 great reviews. This prevents low-review-count outliers from topping the chart.
      </p>
      <p style="font-size:13px;color:var(--text-secondary);line-height:1.65;margin:0">
        Minimum {MIN_REVIEWS} reviews to appear.
      </p>
    </div>
    {rankedGames.length > 0 && (
      <div class="widget" style="margin-top:4px">
        <div class="widget-title">Stats</div>
        <div class="stat-row">
          <span class="stat-label">Games ranked</span>
          <span class="stat-value">{rankedGames.length}</span>
        </div>
        <div class="stat-row">
          <span class="stat-label">Total reviews</span>
          <span class="stat-value">{(scoreRows ?? []).length}</span>
        </div>
        <div class="stat-row">
          <span class="stat-label">Community avg</span>
          <span class="stat-value">{globalMean.toFixed(1)}</span>
        </div>
      </div>
    )}
  </div>
</Layout>

<style>
  .ranking-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 16px 20px;
  }

  /* ── PODIUM FRAME ── */
  .podium-frame {
    position: relative;
    border-radius: 15px;
    padding: 2px; /* thickness of the metallic border */
  }
  .rank-gold   { background: linear-gradient(145deg, #7c4f00, #c8920a, #ffd700, #fff5a0, #ffd700, #c8920a, #7c4f00); }
  .rank-silver { background: linear-gradient(145deg, #4a4a4a, #8a8a8a, #c8c8c8, #f0f0f0, #c8c8c8, #8a8a8a, #4a4a4a); }
  .rank-bronze { background: linear-gradient(145deg, #4a2200, #8b4513, #cd7f32, #e8b06a, #cd7f32, #8b4513, #4a2200); }

  /* Inner card sits inside the frame — no border of its own */
  .podium-frame .ranking-card {
    border: none;
    border-radius: 13px;
    /* Extra bottom padding so wreath sits below the card text */
    padding-bottom: 56px;
  }

  /* Glow per tier */
  .rank-gold   .ranking-card { box-shadow: 0 0 24px rgba(255,215,0,0.28), 0 6px 24px rgba(0,0,0,0.4); }
  .rank-silver .ranking-card { box-shadow: 0 0 20px rgba(192,192,192,0.22), 0 6px 24px rgba(0,0,0,0.4); }
  .rank-bronze .ranking-card { box-shadow: 0 0 20px rgba(205,127,50,0.22), 0 6px 24px rgba(0,0,0,0.4); }

  /* ── LAUREL WREATH SVG ──
     Positioned at the bottom of the frame, outside the card's overflow:hidden
     so the leaves can overlap the card edge naturally. */
  .laurel-wreath {
    position: absolute;
    bottom: 2px;          /* flush with inner edge of 2px frame */
    left: -4px;
    width: calc(100% + 8px);
    height: 80px;
    pointer-events: none;
    z-index: 10;
    overflow: visible;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.55));
  }

  /* ── RANKING CARD ── */
  .ranking-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 14px;
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.15s, box-shadow 0.15s;
    background: var(--bg-card);
  }
  .ranking-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }

  /* Blurred cover bg */
  .ranking-card::before {
    content: '';
    position: absolute;
    inset: -20px;
    background-image: var(--card-cover);
    background-size: cover;
    background-position: center;
    filter: blur(28px) saturate(1.8);
    opacity: 0.55;
    z-index: 0;
  }
  /* Dark overlay so text stays readable */
  .ranking-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(13,13,15,0.72);
    z-index: 1;
  }
  [data-theme="light"] .ranking-card::after {
    background: rgba(255,255,255,0.76);
  }
  .ranking-card > * { position: relative; z-index: 2; }

  /* Rank number */
  .rank-num {
    font-family: 'DM Serif Display', serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--text-tertiary);
    width: 28px;
    flex-shrink: 0;
    text-align: center;
    line-height: 1;
  }
  .podium-frame .rank-num { font-size: 22px; }

  /* Cover art */
  .rank-cover {
    width: 60px;
    height: 80px;
    border-radius: 8px;
    flex-shrink: 0;
    overflow: hidden;
    background: var(--tag-bg);
    border: 1px solid var(--border);
    box-shadow: 0 4px 14px rgba(0,0,0,0.35);
  }
  .rank-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .rank-cover-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
  }

  /* Game info */
  .rank-info { flex: 1; min-width: 0; }
  .rank-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    margin-bottom: 6px;
    letter-spacing: -0.1px;
  }
  .rank-meta {
    display: flex;
    gap: 6px;
    font-size: 12px;
    color: var(--text-tertiary);
  }
  .rank-meta span + span::before { content: '·'; margin-right: 6px; }

  /* Score badge */
  .rank-score-badge {
    width: 46px;
    height: 46px;
    border-radius: 10px;
    font-size: 16px;
    flex-shrink: 0;
  }

  /* Empty state */
  .empty-cta {
    display: inline-block;
    background: var(--accent);
    color: var(--accent-text);
    padding: 10px 24px;
    border-radius: 22px;
    font-size: 14px;
    font-weight: 500;
    transition: opacity 0.15s;
    margin-top: 16px;
  }
  .empty-cta:hover { opacity: 0.85; }
</style>
