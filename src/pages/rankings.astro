---
export const prerender = false;
import { getSupabase } from '../utils/database';
import Layout from '../components/Layout.astro';
import { createSupabaseServerClientFromContext } from '../utils/database';

const supabase = getSupabase();
const serverClient = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await serverClient.auth.getUser();
const isLoggedIn = !!user;

let currentProfile = null;
if (user) {
  const { data: cp } = await serverClient.from('profiles').select('id, username, avatar_url').eq('auth_user_id', user.id).single();
  currentProfile = cp;
}

// Fetch all published scores + game IDs in one query
const { data: scoreRows } = await (supabase as any)
  .from('reviews').select('game_id, score').eq('status', 'published');

// Aggregate per game
const gameMap: Record<string, { scores: number[] }> = {};
for (const r of scoreRows ?? []) {
  if (!gameMap[r.game_id]) gameMap[r.game_id] = { scores: [] };
  gameMap[r.game_id].scores.push(r.score);
}

// Global stats for Bayesian average
const allScores = (scoreRows ?? []).map((r: any) => r.score);
const globalMean = allScores.length > 0
  ? allScores.reduce((a: number, b: number) => a + b, 0) / allScores.length
  : 7;

// Bayesian average: pulls games with few reviews toward the global mean.
// C = confidence weight — games need this many reviews before their score
// fully dominates over the global mean. Low enough to work with small datasets,
// high enough to prevent single-review outliers from topping the chart.
const C = 5;

const MIN_REVIEWS = 2;

const ranked = Object.entries(gameMap)
  .filter(([, d]) => d.scores.length >= MIN_REVIEWS)
  .map(([gameId, d]) => {
    const n = d.scores.length;
    const rawAvg = d.scores.reduce((a, b) => a + b, 0) / n;
    const bayesian = (C * globalMean + d.scores.reduce((a, b) => a + b, 0)) / (C + n);
    return { gameId, reviewCount: n, rawAvg, bayesian };
  })
  .sort((a, b) => b.bayesian - a.bayesian)
  .slice(0, 100);

// Fetch game info for ranked entries
let rankedGames: any[] = [];
if (ranked.length > 0) {
  const { data: gameRows } = await (supabase as any)
    .from('games')
    .select('id, title, slug, cover_img_url, date_released')
    .in('id', ranked.map(r => r.gameId));

  const gameById: Record<string, any> = {};
  for (const g of gameRows ?? []) gameById[g.id] = g;

  rankedGames = ranked
    .map(r => ({ ...r, game: gameById[r.gameId] }))
    .filter(r => r.game);
}

function igdbImage(url: string | null, size = 't_cover_big') {
  if (!url) return null;
  const clean = url.startsWith('//') ? `https:${url}` : url;
  return clean.replace(/t_[a-z_]+/, size);
}

function scoreColor(score: number): string {
  if (score === 10) return 'score-perfect';
  if (score >= 9) return 'score-great';
  if (score >= 8) return 'score-teal';
  if (score >= 7) return 'score-good';
  if (score >= 5) return 'score-mid';
  if (score >= 3) return 'score-orange';
  return 'score-low';
}
---

<Layout
  title="Rankings — Chekpoint"
  description="All-time highest rated games on Chekpoint, ranked by community score."
  isLoggedIn={isLoggedIn}
  currentProfile={currentProfile}
  activeNav="rankings"
>
  <main class="feed">
    <div class="feed-header">
      <div>
        <div class="feed-title">Rankings</div>
        <div class="feed-subtitle">
          {rankedGames.length > 0
            ? `Top ${rankedGames.length} games by community score`
            : 'Not enough reviews yet to rank games'}
        </div>
      </div>
    </div>

    {rankedGames.length === 0 ? (
      <div class="empty-state">
        <div class="empty-state-title">Nothing to rank yet</div>
        <p>Once games have at least {MIN_REVIEWS} reviews, they'll appear here.</p>
        <a href="/" class="empty-cta">Start reviewing</a>
      </div>
    ) : (
      <div class="ranking-list">
        {rankedGames.map(({ game, reviewCount, rawAvg }, i) => {
          const year = game.date_released ? new Date(game.date_released).getFullYear() : null;
          const coverUrl = igdbImage(game.cover_img_url, 't_cover_big');
          const medals = ['🥇', '🥈', '🥉'];
          const podiumClass = ['rank-gold', 'rank-silver', 'rank-bronze'][i];
          const card = (
            <a href={`/games/${game.slug}`} class="ranking-card" style={coverUrl ? `--card-cover:url('${coverUrl}')` : ''}>
              <span class="rank-num">{i < 3 ? medals[i] : i + 1}</span>
              <div class="rank-cover">
                {coverUrl
                  ? <img src={coverUrl} alt={game.title} loading="lazy" />
                  : <span class="rank-cover-placeholder">🎮</span>
                }
              </div>
              <div class="rank-info">
                <div class="rank-title">{game.title}</div>
                <div class="rank-meta">
                  {year && <span>{year}</span>}
                  <span>{reviewCount} review{reviewCount !== 1 ? 's' : ''}</span>
                </div>
              </div>
              <div class={`score-badge ${scoreColor(rawAvg)} rank-score-badge`}>{rawAvg.toFixed(1)}</div>
            </a>
          );
          // Leaf path: elongated Greek bay-laurel shape, 36px tall, 9px wide, pointed both ends
          // Base at (0,5), tip at (0,-31). Midrib: M0 5 Q0 -13 0 -31
          const lf = "M0 5 C-4 3,-5 -8,-5 -14 C-5 -23,-2 -29,0 -31 C2 -29,5 -23,5 -14 C5 -8,4 3,0 5Z";
          const mr = "M0 5 Q0 -13 0 -31"; // midrib
          // Leaf colors — two alternating shades for depth
          const lc = ["#2d7525","#3a8c30"]; // dark / medium green

          // Bottom-arc wreath: arc stems from both sides meeting at center-bottom
          // Leaf positions [x, y, rotation°] for LEFT half (mirrored for right)
          // Rotation 0° = leaf points up; positive = tip tilts right (inward toward center)
          const leftLeaves: [number,number,number,number][] = [
            [28,  58, 28, 0],
            [64,  47, 22, 1],
            [102, 39, 16, 0],
            [141, 33, 11, 1],
            [180, 29,  7, 0],
            [214, 27,  3, 1],
            [238, 26,  0, 0],
          ];

          const wreathSvg = (
            <svg class="laurel-wreath" viewBox="0 0 480 68" preserveAspectRatio="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
              {/* Curved stems */}
              <path d="M14 65 C110 30 370 30 466 65" stroke="#3d6828" stroke-width="2.2" fill="none" stroke-linecap="round"/>
              {/* Left-branch leaves */}
              {leftLeaves.map(([x, y, r, ci], idx) => (
                <g transform={`translate(${x},${y}) rotate(${r})`}>
                  <path d={lf} fill={lc[ci]}/>
                  <path d={mr} stroke="#1c4a14" stroke-width="0.55" fill="none" opacity="0.7"/>
                </g>
              ))}
              {/* Right-branch leaves (mirror of left about x=240) */}
              {leftLeaves.map(([x, y, r, ci], idx) => (
                <g transform={`translate(${480-x},${y}) rotate(${-r})`}>
                  <path d={lf} fill={lc[ci]}/>
                  <path d={mr} stroke="#1c4a14" stroke-width="0.55" fill="none" opacity="0.7"/>
                </g>
              ))}
              {/* Central ribbon knot */}
              <ellipse cx="240" cy="30" rx="7" ry="5" fill="#8a6200" opacity="0.9"/>
              <ellipse cx="240" cy="30" rx="4" ry="3" fill="#c89010" opacity="0.8"/>
            </svg>
          );

          return i < 3 ? (
            <div class={`podium-frame ${podiumClass}`}>
              {card}
              {wreathSvg}
            </div>
          ) : card;
        })}
      </div>
    )}
  </main>

  <div slot="sidebar-right">
    <div class="widget">
      <div class="widget-title">How rankings work</div>
      <p style="font-size:13px;color:var(--text-secondary);line-height:1.65;margin:0 0 10px">
        Games are ranked by a Bayesian average — a game with 3 great reviews ranks lower than one with 30 great reviews. This prevents low-review-count outliers from topping the chart.
      </p>
      <p style="font-size:13px;color:var(--text-secondary);line-height:1.65;margin:0">
        Minimum {MIN_REVIEWS} reviews to appear.
      </p>
    </div>
    {rankedGames.length > 0 && (
      <div class="widget" style="margin-top:4px">
        <div class="widget-title">Stats</div>
        <div class="stat-row">
          <span class="stat-label">Games ranked</span>
          <span class="stat-value">{rankedGames.length}</span>
        </div>
        <div class="stat-row">
          <span class="stat-label">Total reviews</span>
          <span class="stat-value">{(scoreRows ?? []).length}</span>
        </div>
        <div class="stat-row">
          <span class="stat-label">Community avg</span>
          <span class="stat-value">{globalMean.toFixed(1)}</span>
        </div>
      </div>
    )}
  </div>
</Layout>

<style>
  .ranking-list { display: flex; flex-direction: column; gap: 14px; padding: 16px 20px; }

  /* ── Podium wrapper: gradient border + laurel leaves ── */
  .podium-frame {
    position: relative;
    border-radius: 15px;
    padding: 2px;
  }
  /* Gradient metallic border */
  .rank-gold   { background: linear-gradient(145deg, #7c4f00, #c8920a, #ffd700, #fff5a0, #ffd700, #c8920a, #7c4f00); }
  .rank-silver { background: linear-gradient(145deg, #4a4a4a, #8a8a8a, #c8c8c8, #f0f0f0, #c8c8c8, #8a8a8a, #4a4a4a); }
  .rank-bronze { background: linear-gradient(145deg, #4a2200, #8b4513, #cd7f32, #e8b06a, #cd7f32, #8b4513, #4a2200); }

  /* Remove inner card's border so the frame border shows */
  .podium-frame .ranking-card { border: none; }

  /* Bottom arc wreath — sibling of .ranking-card so card's overflow:hidden doesn't clip it */
  .laurel-wreath {
    position: absolute;
    bottom: 2px;        /* inside the 2px frame border */
    left: -6px;
    width: calc(100% + 12px);
    height: 68px;
    pointer-events: none;
    z-index: 10;
    overflow: visible;
    filter: drop-shadow(0 2px 3px rgba(0,0,0,0.5));
  }
  /* Extra bottom padding so wreath sits below main content */
  .podium-frame .ranking-card { padding-bottom: 52px; border-radius: 13px; }

  /* Extra glow on the card itself for each podium tier */
  .rank-gold   .ranking-card { box-shadow: 0 0 20px rgba(255,215,0,0.25), 0 6px 24px rgba(0,0,0,0.4); }
  .rank-silver .ranking-card { box-shadow: 0 0 20px rgba(192,192,192,0.2), 0 6px 24px rgba(0,0,0,0.4); }
  .rank-bronze .ranking-card { box-shadow: 0 0 20px rgba(205,127,50,0.2), 0 6px 24px rgba(0,0,0,0.4); }


  .ranking-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 14px;
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .ranking-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }
  /* Blurred cover via ::before, overlay via ::after — avoids child selector conflicts */
  .ranking-card::before {
    content: '';
    position: absolute;
    inset: -20px;
    background-image: var(--card-cover);
    background-size: cover;
    background-position: center;
    filter: blur(28px) saturate(1.8);
    opacity: 0.6;
    z-index: 0;
  }
  .ranking-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(var(--bg-card-rgb), 0.74);
    z-index: 1;
  }
  .ranking-card > * { position: relative; z-index: 2; }

  .rank-num {
    font-family: 'DM Serif Display', serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--text-tertiary);
    width: 28px;
    flex-shrink: 0;
    text-align: center;
    line-height: 1;
  }
  .podium-frame .rank-num { font-size: 22px; }

  .rank-cover {
    width: 60px;
    height: 80px;
    border-radius: 8px;
    flex-shrink: 0;
    overflow: hidden;
    background: var(--tag-bg);
    border: 1px solid var(--border);
    box-shadow: 0 4px 14px rgba(0,0,0,0.35);
  }
  .rank-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .rank-cover-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 24px; }

  .rank-info { flex: 1; min-width: 0; }
  .rank-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    margin-bottom: 6px;
    letter-spacing: -0.1px;
  }
  .rank-meta {
    display: flex;
    gap: 6px;
    font-size: 12px;
    color: var(--text-tertiary);
  }
  .rank-meta span + span::before { content: '·'; margin-right: 6px; }

  .rank-score-badge {
    width: 46px;
    height: 46px;
    border-radius: 10px;
    font-size: 16px;
    flex-shrink: 0;
  }

  .empty-cta {
    display: inline-block;
    background: var(--accent);
    color: var(--accent-text);
    padding: 10px 24px;
    border-radius: 22px;
    font-size: 14px;
    font-weight: 500;
    transition: opacity 0.15s;
    margin-top: 16px;
  }
  .empty-cta:hover { opacity: 0.85; }
</style>
