---
import { getSupabase, createSupabaseServerClientFromContext, getSupabaseAdmin } from "../utils/database";
import Layout from "../components/Layout.astro";
import ReportModal from "../components/ReportModal.astro";
import EditModal from "../components/EditModal.astro";
import ReviewCard from "../components/ReviewCard.astro";
import ListCard from "../components/ListCard.astro";
import ListFeedCard from "../components/ListFeedCard.astro";
import RecommendationFeedCard from "../components/RecommendationFeedCard.astro";
import RecommendationComposer from "../components/RecommendationComposer.astro";
import GettingStarted from "../components/GettingStarted.astro";
import { igdbImage, timeAgo, scoreClass } from '../utils/format';
import { GAME_CATEGORY_OR_FILTER } from '../utils/games';
import { REC_SELECT, shapeRec } from '../utils/recommendationsFeed';

const supabase = getSupabase();
const serverClient = createSupabaseServerClientFromContext(Astro);

const { data: { user } } = await serverClient.auth.getUser();
const isLoggedIn = !!user;

if (!isLoggedIn) {
  Astro.response.headers.set('Netlify-CDN-Cache-Control', 'public, max-age=300, stale-while-revalidate=600');
  Astro.response.headers.set('Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}
Astro.response.headers.set('Netlify-Vary', 'cookie=sb-bzlwwtatoiyzwirerify-auth-token');

const PST_OFFSET_MS = 8 * 60 * 60 * 1000
function getPstDayStart(daysAgo = 0): Date {
  const pstNow = new Date(Date.now() - PST_OFFSET_MS)
  return new Date(Date.UTC(
    pstNow.getUTCFullYear(), pstNow.getUTCMonth(), pstNow.getUTCDate() - daysAgo,
    8, 0, 0, 0
  ))
}
const todayPstStart = getPstDayStart(0)
const yesterdayPstStart = getPstDayStart(1)
const oneWeekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString()

const REVIEW_FIELDS = `
  id, score, title, body, play_time_hours,
  contains_spoilers, status, published_at, created_at,
  played_on:platform_played_on ( id, name, slug ),
  games ( id, title, slug, cover_img_url ),
  profiles ( id, username, avatar_url ),
  review_votes( vote, profile_id ),
  review_reactions( reaction_type, profile_id ),
  review_comments( id )
`
const db = supabase as any
const [
  profileRes,
  platformsRes,
  rawReviewsRes,
  todayRawRes,
  weekReviewsRes,
  reviewCountRes,
  recommendationCountRes,
  gameCountRes,
  profileCountRes,
  genresRes,
] = await Promise.all([
  user
    ? db.from('profiles').select('id, username, avatar_url, bio, favorite_game_id').eq('auth_user_id', user.id).single()
    : Promise.resolve({ data: null }),
  db.from('platforms').select('id, name, slug').order('name', { ascending: true }),
  db.from('reviews').select(REVIEW_FIELDS).eq('status', 'published').order('published_at', { ascending: false }).limit(20),
  db.from('reviews').select('game_id, published_at, games(id, title, slug, cover_img_url)').eq('status', 'published').gte('published_at', yesterdayPstStart.toISOString()).limit(200),
  db.from('reviews').select('game_id, score, games(id, title, slug, cover_img_url)').eq('status', 'published').gte('published_at', oneWeekAgo).limit(500),
  db.from('reviews').select('*', { count: 'exact', head: true }).eq('status', 'published'),
  db.from('recommendations').select('*', { count: 'exact', head: true }).eq('status', 'published'),
  db.from('games').select('*', { count: 'exact', head: true }).or(GAME_CATEGORY_OR_FILTER),
  db.from('profiles').select('*', { count: 'exact', head: true }),
  db.from('genres').select('id, name, slug').order('name'),
])

const currentProfile = profileRes.data ?? null
const { data: platforms } = platformsRes

// ── Lists shared to feed ──
const adminDb = getSupabaseAdmin() as any;

async function fetchSharedListFeedItems(profileIdFilter: string[] | null, limit: number) {
  if (profileIdFilter && profileIdFilter.length === 0) return [];

  let listsQuery = adminDb
    .from('lists')
    .select('id, title, description, is_ranked, visibility, cover_image_url, created_at, profiles(id, username, avatar_url)')
    .eq('visibility', 'public')
    .eq('shared_to_feed', true)
    .order('created_at', { ascending: false })
    .limit(limit);
  if (profileIdFilter) listsQuery = listsQuery.in('profile_id', profileIdFilter);

  const { data: listsRaw, error: listsError } = await listsQuery;
  if (listsError) console.error('[index] lists query error:', JSON.stringify(listsError));

  const listIds = (listsRaw ?? []).map((l: any) => l.id);
  const [
    { data: listEntries },
    { data: listEntryCounts },
    { data: listVotesRaw },
    { data: listCommentsRaw },
    { data: listReactionsRaw },
  ] = listIds.length > 0
    ? await Promise.all([
        adminDb.from('list_entries').select('list_id, games(cover_img_url)').in('list_id', listIds).order('position', { ascending: true, nullsFirst: false }).order('added_at', { ascending: true }),
        adminDb.from('list_entries').select('list_id').in('list_id', listIds),
        adminDb.from('list_votes').select('list_id, vote, profile_id').in('list_id', listIds),
        adminDb.from('list_comments').select('list_id').in('list_id', listIds),
        adminDb.from('list_reactions').select('list_id, reaction_type, profile_id').in('list_id', listIds),
      ])
    : [{ data: [] }, { data: [] }, { data: [] }, { data: [] }, { data: [] }];

  const listCoversByListId: Record<string, string[]> = {};
  for (const e of listEntries ?? []) {
    const cover = igdbImage(e.games?.cover_img_url, 't_cover_big');
    if (cover) {
      if (!listCoversByListId[e.list_id]) listCoversByListId[e.list_id] = [];
      if (listCoversByListId[e.list_id].length < 10) listCoversByListId[e.list_id].push(cover);
    }
  }
  const listCountByListId: Record<string, number> = {};
  for (const e of listEntryCounts ?? []) {
    listCountByListId[e.list_id] = (listCountByListId[e.list_id] ?? 0) + 1;
  }

  // Aggregate votes, comments, reactions by list_id
  const listUpByListId: Record<string, number> = {};
  const listDownByListId: Record<string, number> = {};
  const listMyVoteByListId: Record<string, number> = {};
  for (const v of listVotesRaw ?? []) {
    if (v.vote === 1) listUpByListId[v.list_id] = (listUpByListId[v.list_id] ?? 0) + 1;
    else listDownByListId[v.list_id] = (listDownByListId[v.list_id] ?? 0) + 1;
    if (currentProfile && v.profile_id === currentProfile.id) listMyVoteByListId[v.list_id] = v.vote;
  }
  const listCommentCountByListId: Record<string, number> = {};
  for (const c of listCommentsRaw ?? []) {
    listCommentCountByListId[c.list_id] = (listCommentCountByListId[c.list_id] ?? 0) + 1;
  }
  const listReactionsByListId: Record<string, { reaction_type: string; profile_id: string }[]> = {};
  for (const r of listReactionsRaw ?? []) {
    if (!listReactionsByListId[r.list_id]) listReactionsByListId[r.list_id] = [];
    listReactionsByListId[r.list_id].push({ reaction_type: r.reaction_type, profile_id: r.profile_id });
  }

  return (listsRaw ?? []).map((l: any) => ({
    ...l,
    _isListItem: true,
    ownerId: l.profiles?.id ?? null,
    ownerUsername: l.profiles?.username,
    ownerAvatar: l.profiles?.avatar_url,
    coverUrls: listCoversByListId[l.id] ?? [],
    entryCount: listCountByListId[l.id] ?? 0,
    upVotes: listUpByListId[l.id] ?? 0,
    downVotes: listDownByListId[l.id] ?? 0,
    myVote: listMyVoteByListId[l.id] ?? 0,
    commentCount: listCommentCountByListId[l.id] ?? 0,
    reactions: listReactionsByListId[l.id] ?? [],
  }));
}

const recentLists = await fetchSharedListFeedItems(null, 2);

// ── Recent recommendations (site-wide) — merged into the feed and shown in the sidebar ──
const { data: recentRecsRaw, error: recsError } = await adminDb
  .from('recommendations')
  .select(REC_SELECT)
  .eq('status', 'published')
  .order('created_at', { ascending: false })
  .limit(20);
if (recsError) console.error('[index] recommendations query error:', JSON.stringify(recsError));
const recentRecs = (recentRecsRaw ?? []).map((r: any) => shapeRec(r, currentProfile?.id ?? null));

type Platform = { id: string; name: string; slug: string; };
type Review = {
  id: string; score: number; title: string; body: string;
  play_time_hours: number; contains_spoilers: boolean; status: string;
  published_at: string; created_at: string; played_on: Platform | null;
  games: { id: string; title: string; slug: string; cover_img_url: string | null } | null;
  profiles: { id: string; username: string; avatar_url: string | null } | null;
  review_votes: { vote: number; profile_id: string }[] | { vote: number; profile_id: string } | null;
}
const reviews = (rawReviewsRes.data ?? []) as Review[]

// Merge reviews, shared lists, and recommendations into a single chronological feed
const feedItems: any[] = [
  ...reviews.map(r => ({ ...r, _isListItem: false, _date: r.published_at || r.created_at })),
  ...recentLists.map((l: any) => ({ ...l, _date: l.created_at })),
  ...recentRecs,
].sort((a, b) => new Date(b._date).getTime() - new Date(a._date).getTime());

type DayMap = Record<string, { title: string; slug: string; cover: string | null; count: number }>
const todayMap: DayMap = {}
const yesterdayMap: DayMap = {}
for (const r of todayRawRes.data ?? []) {
  const g = (r as any).games
  if (!g) continue
  const publishedAt = new Date((r as any).published_at)
  const map = publishedAt >= todayPstStart ? todayMap : yesterdayMap
  if (!map[g.id]) map[g.id] = { title: g.title, slug: g.slug, cover: g.cover_img_url, count: 0 }
  map[g.id].count++
}
const mostReviewedToday = Object.values(todayMap).sort((a, b) => b.count - a.count)[0] ?? null
const mostReviewedYesterday = Object.values(yesterdayMap).sort((a, b) => b.count - a.count)[0] ?? null
const featuredGame = mostReviewedToday ?? mostReviewedYesterday
const featuredLabel = mostReviewedToday ? 'Most Reviewed Today' : 'Most Reviewed Yesterday'
const featuredPeriod = mostReviewedToday ? 'today' : 'yesterday'

const trendingMap: Record<string, { title: string; slug: string; cover: string | null; count: number }> = {}
const weekGameMap: Record<string, { title: string; slug: string; cover: string | null; scores: number[] }> = {}
for (const r of weekReviewsRes.data ?? []) {
  const g = (r as any).games
  if (!g) continue
  if (!trendingMap[g.id]) trendingMap[g.id] = { title: g.title, slug: g.slug, cover: g.cover_img_url, count: 0 }
  trendingMap[g.id].count++
  if (!weekGameMap[g.id]) weekGameMap[g.id] = { title: g.title, slug: g.slug, cover: g.cover_img_url, scores: [] }
  if (r.score != null) weekGameMap[g.id].scores.push(r.score)
}
const trending = Object.values(trendingMap).sort((a, b) => b.count - a.count).slice(0, 5)
const topRated = Object.entries(weekGameMap)
  .map(([id, g]) => {
    if (g.scores.length < 2) return null
    const avg = g.scores.reduce((a, b) => a + b, 0) / g.scores.length
    return { id, ...g, avg_score: avg, review_count: g.scores.length }
  })
  .filter(Boolean)
  .sort((a: any, b: any) => b.avg_score - a.avg_score)
  .slice(0, 12)

const totalReviews = reviewCountRes.count ?? 0
const totalRecommendations = recommendationCountRes.count ?? 0
const totalGames = gameCountRes.count ?? 0
const totalReviewers = profileCountRes.count ?? 0

const { data: genres } = genresRes

let followingReviews: any[] = []
let followingRecs: any[] = []
let followingLists: any[] = []
let lastReview: any = null
if (user && currentProfile) {
  const [lastReviewRes, followRowsRes] = await Promise.all([
    db.from('reviews')
      .select('id, score, published_at, created_at, title, games ( id, title, slug, cover_img_url )')
      .eq('profile_id', currentProfile.id)
      .eq('status', 'published')
      .order('published_at', { ascending: false })
      .limit(1)
      .maybeSingle(),
    db.from('follows').select('following_id').eq('follower_id', currentProfile.id),
  ])
  lastReview = lastReviewRes.data ?? null
  const followingIds = (followRowsRes.data ?? []).map((r: any) => r.following_id)
  if (followingIds.length > 0) {
    const [{ data: fRevs }, { data: fRecsRaw }, fLists] = await Promise.all([
      db.from('reviews')
        .select(REVIEW_FIELDS)
        .eq('status', 'published')
        .in('profile_id', followingIds)
        .order('published_at', { ascending: false })
        .limit(20),
      adminDb.from('recommendations')
        .select(REC_SELECT)
        .eq('status', 'published')
        .in('profile_id', followingIds)
        .order('created_at', { ascending: false })
        .limit(20),
      fetchSharedListFeedItems(followingIds, 2),
    ])
    followingReviews = (fRevs ?? []) as any[]
    followingRecs = (fRecsRaw ?? []).map((r: any) => shapeRec(r, currentProfile.id))
    followingLists = fLists
  }
}

// Merge followed reviewers' reviews, recommendations, and shared lists into one chronological feed
const followingItems: any[] = [
  ...followingReviews.map((r: any) => ({ ...r, _isListItem: false, _date: r.published_at || r.created_at })),
  ...followingRecs,
  ...followingLists.map((l: any) => ({ ...l, _date: l.created_at })),
].sort((a, b) => new Date(b._date).getTime() - new Date(a._date).getTime())

// ── Hot Takes tab: published reviews scoring ≥2.5 away from their game's
// consensus average, ordered most-recent-first. Only computed for logged-in
// users (the pill row is logged-in only). ──
const HT_MIN_DEVIATION = 2.5
let hotTakes: any[] = []
if (isLoggedIn) {
  const HT_FIELDS = `
    id, score, title, body, play_time_hours,
    contains_spoilers, status, published_at, created_at,
    game_id,
    played_on:platform_played_on ( id, name, slug ),
    games ( id, title, slug, cover_img_url ),
    profiles ( id, username, avatar_url ),
    review_votes( vote, profile_id ),
    review_reactions( reaction_type, profile_id ),
    review_comments( id )
  `
  const { data: htRaw } = await db
    .from('reviews')
    .select(HT_FIELDS)
    .eq('status', 'published')
    .order('published_at', { ascending: false })
    .limit(500)
  const htReviews: any[] = htRaw ?? []

  const htScores: Record<string, number[]> = {}
  for (const r of htReviews) {
    if (r.game_id == null || r.score == null) continue
    ;(htScores[r.game_id] ||= []).push(r.score)
  }
  const htAvg: Record<string, number> = {}
  for (const [id, s] of Object.entries(htScores)) {
    if (s.length >= 2) htAvg[id] = s.reduce((a, b) => a + b, 0) / s.length
  }

  hotTakes = htReviews
    .filter(r => r.game_id != null && htAvg[r.game_id] !== undefined)
    .map(r => ({
      ...r,
      _htAvg: htAvg[r.game_id],
      _htDeviation: r.score - htAvg[r.game_id],
      _htAbs: Math.abs(r.score - htAvg[r.game_id]),
      _htCount: htScores[r.game_id].length,
    }))
    .filter(h => h._htAbs >= HT_MIN_DEVIATION)
    .sort((a, b) =>
      new Date(b.published_at || b.created_at).getTime() -
      new Date(a.published_at || a.created_at).getTime()
    )
    .slice(0, 30)
}
function htFmt(n: number): string { return n.toFixed(1) }

function formatCount(n: number): string {
  if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k'
  return String(n)
}

const lastRecentReview = reviews.length > 0 ? reviews[reviews.length - 1] : null
const lastFollowingReview = followingReviews.length > 0 ? followingReviews[followingReviews.length - 1] : null
const initialRecentCursor = lastRecentReview?.published_at ?? lastRecentReview?.created_at ?? null
const initialFollowingCursor = lastFollowingReview?.published_at ?? lastFollowingReview?.created_at ?? null
const initialRecentDone = reviews.length < 20
const initialFollowingDone = followingReviews.length < 20

const ogImage = new URL('/og/home.jpg', Astro.url.origin).toString()
---

<Layout
  title="Chekpoint — Game Reviews"
  description="Community-driven video game reviews from players. Read honest reviews and recommendations. Discover your next game to play on Chekpoint."
  ogImage={ogImage}
  isLoggedIn={isLoggedIn}
  currentProfile={currentProfile}
  activeNav="home">

  <main class="feed">

    {!isLoggedIn && (
      <div class="welcome-banner" id="welcomeBanner">
        <div class="welcome-banner-body">
          <div class="welcome-banner-text">
            <strong>Welcome to Chekpoint</strong> — a community-driven game review site where real players score, review, and discuss the games they've played.
            <a href="/signup" class="welcome-banner-cta">Create a free account →</a>
          </div>
          <button class="welcome-banner-dismiss" id="dismissWelcome" aria-label="Dismiss">✕</button>
        </div>
      </div>
    )}


    <div class="feed-header">
      <div>
        <div class="feed-title">Recent Posts</div>
        <div class="feed-subtitle">{reviews.length > 0 ? `${reviews.length} reviews` : 'Be the first to review a game'}</div>
      </div>
      <div class="post-menu-wrap">
        <button class="new-review-btn" id="postMenuBtn">+ Post</button>
        <div class="post-menu-dropdown" id="postMenuDropdown" style="display:none">
          <button id="postMenuReview">Write a review</button>
          <button id="postMenuList">Create a list</button>
          <button id="postMenuRec">Make a recommendation</button>
        </div>
      </div>
    </div>

    {featuredGame && (
      <div class="hero">
        {igdbImage((featuredGame as any).cover, 't_1080p') && (
          <div class="hero-bg" style={`background-image: url('${igdbImage((featuredGame as any).cover, 't_1080p')}')`}></div>
        )}
        <div class="hero-overlay"></div>
        <div class="hero-content">
          {igdbImage((featuredGame as any).cover)
            ? <img class="hero-cover" src={igdbImage((featuredGame as any).cover) ?? ''} alt={(featuredGame as any).title} />
            : <div class="hero-cover-placeholder">🎮</div>
          }
          <div class="hero-info">
            <div class="hero-label">{featuredLabel}</div>
            <div class="hero-title">{(featuredGame as any).title}</div>
            <div class="hero-score">
              <span class="hero-score-num">{(featuredGame as any).count}</span>
              <span class="hero-score-label">{(featuredGame as any).count === 1 ? 'review' : 'reviews'} {featuredPeriod}</span>
            </div>
            <a href={`/games/${(featuredGame as any).slug}`} class="hero-cta">Read reviews →</a>
          </div>
        </div>
      </div>
    )}

    {topRated.length > 0 && (
      <div class="section-block">
        <div class="section-block-header">
          <span class="section-block-title">Top Rated This Week</span>
          <a href="/search?sort=highest" class="section-block-link">See all →</a>
        </div>
        <div class="top-rated-scroll">
          {topRated.map((game: any) => (
            <a href={`/games/${game.slug}`} class="top-rated-card">
              <div class="top-rated-cover-wrap">
                {igdbImage(game.cover)
                  ? <img class="top-rated-cover" src={igdbImage(game.cover) ?? ''} alt={game.title} loading="lazy" />
                  : <div class="top-rated-cover-placeholder">🎮</div>
                }
                <div class={`top-rated-badge ${scoreClass(game.avg_score)}`}>
                  {game.avg_score.toFixed(1)}
                </div>
              </div>
              <div class="top-rated-info">
                <div class="top-rated-title">{game.title}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="feed-tabs">
      {isLoggedIn && (
        <>
          <button class="feed-tab active" data-tab="recent">Recent</button>
          <button class="feed-tab" data-tab="following">Following</button>
          <button class="feed-tab" data-tab="hot-takes">Hot Takes</button>
          <span class="feed-tab-sep"></span>
        </>
      )}
      <button class="feed-tab" data-tab="reviews">Reviews</button>
      <button class="feed-tab" data-tab="lists">Lists</button>
      <button class="feed-tab" data-tab="recs">Recs</button>
    </div>

    <div id="tab-recent">
      {feedItems.length === 0 ? (
        <div class="empty-state">
          <div class="empty-state-title">No reviews yet</div>
          <p>Be the first to review a game.</p>
        </div>
      ) : (
        feedItems.map((item: any) => (
          <div data-feed-type={item._isRecommendation ? 'rec' : item._isListItem ? 'list' : 'review'}>
            {item._isRecommendation ? (
              <RecommendationFeedCard
                id={item.id}
                sourceGame={item.sourceGame}
                targetGame={item.targetGame}
                body={item.body}
                containsSpoilers={item.containsSpoilers}
                ownerUsername={item.ownerUsername}
                ownerAvatar={item.ownerAvatar}
                createdAt={item.createdAt}
                upVotes={item.upVotes}
                downVotes={item.downVotes}
                myVote={item.myVote}
                commentCount={item.commentCount}
                reactions={item.reactions}
                isLoggedIn={isLoggedIn}
                currentProfileId={currentProfile?.id ?? null}
                profileId={item.profileId}
              />
            ) : item._isListItem ? (
              <ListFeedCard
                id={item.id}
                title={item.title}
                description={item.description ?? null}
                isRanked={item.is_ranked}
                entryCount={item.entryCount}
                coverUrls={item.coverUrls}
                coverImageUrl={item.cover_image_url}
                ownerId={item.ownerId}
                ownerUsername={item.ownerUsername}
                ownerAvatar={item.ownerAvatar ?? null}
                createdAt={item.created_at}
                upVotes={item.upVotes}
                downVotes={item.downVotes}
                myVote={item.myVote}
                commentCount={item.commentCount}
                reactions={item.reactions}
                isLoggedIn={isLoggedIn}
                currentProfileId={currentProfile?.id ?? null}
              />
            ) : (
              <ReviewCard
                review={item}
                isLoggedIn={isLoggedIn}
                showReviewer={true}
                showGame={true}
                currentProfileId={currentProfile?.id ?? null}
                isOwnProfile={!!(currentProfile && item.profiles?.id === currentProfile.id)}
              />
            )}
          </div>
        ))
      )}
      <div id="sentinel-recent" style="height:1px;margin:0"></div>
      <div id="loader-recent" style="display:none;padding:20px;text-align:center;font-size:13px;color:var(--text-tertiary)">Loading more…</div>
      <div id="end-recent" style="display:none;padding:16px 20px;text-align:center;font-size:13px;color:var(--text-tertiary)">You're all caught up ✓</div>
    </div>

    {isLoggedIn && (
      <div id="tab-following" style="display:none">
        {followingItems.length === 0 ? (
          <div class="empty-state">
            <div class="empty-state-title">Nothing here yet</div>
            <p>Follow reviewers to see their latest reviews here.</p>
            <a href="/search?tab=reviewers" class="empty-cta" style="display:inline-block;background:var(--accent);color:var(--accent-text);padding:10px 24px;border-radius:22px;font-size:14px;font-weight:500;margin-top:16px">Find reviewers</a>
          </div>
        ) : (
          followingItems.map((item: any) => (
            item._isRecommendation ? (
              <RecommendationFeedCard
                id={item.id}
                sourceGame={item.sourceGame}
                targetGame={item.targetGame}
                body={item.body}
                containsSpoilers={item.containsSpoilers}
                ownerUsername={item.ownerUsername}
                ownerAvatar={item.ownerAvatar}
                createdAt={item.createdAt}
                upVotes={item.upVotes}
                downVotes={item.downVotes}
                myVote={item.myVote}
                commentCount={item.commentCount}
                reactions={item.reactions}
                isLoggedIn={isLoggedIn}
                currentProfileId={currentProfile?.id ?? null}
                profileId={item.profileId}
              />
            ) : item._isListItem ? (
              <ListFeedCard
                id={item.id}
                title={item.title}
                description={item.description ?? null}
                isRanked={item.is_ranked}
                entryCount={item.entryCount}
                coverUrls={item.coverUrls}
                coverImageUrl={item.cover_image_url}
                ownerId={item.ownerId}
                ownerUsername={item.ownerUsername}
                ownerAvatar={item.ownerAvatar ?? null}
                createdAt={item.created_at}
                upVotes={item.upVotes}
                downVotes={item.downVotes}
                myVote={item.myVote}
                commentCount={item.commentCount}
                reactions={item.reactions}
                isLoggedIn={isLoggedIn}
                currentProfileId={currentProfile?.id ?? null}
              />
            ) : (
              <ReviewCard
                review={item}
                isLoggedIn={isLoggedIn}
                showReviewer={true}
                showGame={true}
                currentProfileId={currentProfile?.id ?? null}
                isOwnProfile={!!(currentProfile && item.profiles?.id === currentProfile.id)}
                />
            )
          ))
        )}
        <div id="sentinel-following" style="height:1px;margin:0"></div>
        <div id="loader-following" style="display:none;padding:20px;text-align:center;font-size:13px;color:var(--text-tertiary)">Loading more…</div>
        <div id="end-following" style="display:none;padding:16px 20px;text-align:center;font-size:13px;color:var(--text-tertiary)">You're all caught up ✓</div>
        <div style="padding:16px 20px;text-align:center">
          <a href="/following" style="font-size:13px;color:var(--text-tertiary)">View full feed →</a>
        </div>
      </div>
    )}

    {isLoggedIn && (
      <div id="tab-hot-takes" style="display:none">
        {hotTakes.length === 0 ? (
          <div class="empty-state">
            <div class="empty-state-title">Everybody agrees… for now.</div>
            <p>No reviews yet diverge far enough from the consensus to qualify. Post a spicy take and you might end up here.</p>
          </div>
        ) : (
          hotTakes.map((item: any) => (
            <div class="ht-item">
              <div class={`ht-badge ${item._htDeviation > 0 ? 'ht-badge-up' : 'ht-badge-down'}`}>
                <div class="ht-badge-delta">
                  {item._htDeviation > 0 ? '▲' : '▼'} {htFmt(item._htAbs)} pts
                </div>
                <div class="ht-badge-avg">
                  avg <strong>{htFmt(item._htAvg)}</strong> across {item._htCount} reviews
                </div>
              </div>
              <ReviewCard
                review={item}
                isLoggedIn={isLoggedIn}
                showReviewer={true}
                showGame={true}
                currentProfileId={currentProfile?.id ?? null}
                isOwnProfile={!!(currentProfile && item.profiles?.id === currentProfile.id)}
              />
            </div>
          ))
        )}
      </div>
    )}
  </main>

  <div id="composerOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:150"></div>

  <div id="composer" style="display:none;position:fixed;top:80px;left:50%;transform:translateX(-50%);width:520px;max-width:calc(100vw - 32px);background:var(--bg-card);border:1px solid var(--border);border-radius:16px;z-index:160;padding:24px;max-height:calc(100dvh - 100px);overflow-y:auto">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
      <div id="composerTitle" style="font-size:17px;font-weight:500;letter-spacing:-0.2px">Write a review</div>
      <button id="cancelComposer" style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--text-tertiary);line-height:1;padding:4px">×</button>
    </div>

    <div id="reviewResult" style="display:none;text-align:center;padding:8px 0 20px;animation:resultFadeIn 0.3s ease">
      <div id="resultCover" style="display:none;margin-bottom:14px">
        <img id="resultCoverImg" src="" alt="" style="width:64px;height:88px;object-fit:cover;border-radius:8px;border:1px solid var(--border)" />
      </div>
      <div id="resultGameTitle" style="font-size:15px;font-weight:500;color:var(--text-primary);margin-bottom:20px"></div>
      <div id="resultScoreRow" style="display:flex;align-items:center;justify-content:center;gap:0;margin-bottom:24px">
        <div style="text-align:center;padding:0 28px">
          <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-tertiary);margin-bottom:8px">Your score</div>
          <div id="resultScoreNumWrap" style="position:relative;display:inline-block">
            <div id="resultUserScore" style="font-family:'DM Serif Display',serif;font-size:52px;line-height:1;color:var(--text-primary)"></div>
          </div>
          <div style="font-size:12px;color:var(--text-tertiary);margin-top:5px">out of 10</div>
        </div>
        <div id="resultDivider" style="width:1px;height:72px;background:var(--border);flex-shrink:0"></div>
        <div id="resultCommunityCol" style="text-align:center;padding:0 28px">
          <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-tertiary);margin-bottom:8px">Community avg</div>
          <div id="resultCommunityScore" style="font-family:'DM Serif Display',serif;font-size:52px;line-height:1;color:var(--text-secondary)"></div>
          <div id="resultReviewCount" style="font-size:12px;color:var(--text-tertiary);margin-top:5px"></div>
        </div>
      </div>
      <div id="resultFirstMsg" style="display:none;font-size:14px;color:var(--text-secondary);margin-bottom:24px;line-height:1.6;padding:0 8px"></div>
      <div style="display:flex;gap:8px;justify-content:center">
        <button id="resultClose" style="padding:10px 20px;border:1px solid var(--border);border-radius:10px;background:transparent;color:var(--text-secondary);font-size:14px;font-weight:500;font-family:inherit;cursor:pointer;transition:opacity 0.15s">Close</button>
        <a id="resultGameLink" href="#" style="padding:10px 20px;border-radius:10px;background:var(--accent);color:var(--accent-text);font-size:14px;font-weight:500;text-decoration:none;transition:opacity 0.15s">See all reviews →</a>
      </div>
    </div>

    <div id="composerFormContent">
    <div class="composer-field">
      <label class="composer-label">Game</label>
      <div class="autocomplete-wrap">
        <input type="text" id="gameSearch" class="composer-input" placeholder="Search for a game..." autocomplete="off" />
        <div class="autocomplete-results" id="gameResults"></div>
      </div>
      <input type="hidden" id="gameId" />
    </div>
    <div class="composer-field" style="margin-top:12px">
      <label class="composer-label">Score</label>
      <div style="display:flex;align-items:center;gap:8px">
        <input type="number" id="scoreVal" class="composer-input" placeholder="0.0" min="0.1" max="10" step="0.1" style="width:90px" />
        <span style="font-size:15px;color:var(--text-tertiary);font-family:'DM Serif Display',serif">/ 10</span>
      </div>
    </div>
    <div class="composer-field" style="margin-top:12px">
      <label class="composer-label">Title</label>
      <input type="text" id="reviewTitle" class="composer-input" placeholder="Sum it up in a line..." maxlength="120" />
    </div>
    <div class="composer-field" style="margin-top:12px">
      <label class="composer-label">Review</label>
      <textarea id="reviewBody" class="composer-textarea" placeholder="Write your review..." rows="4" maxlength="5000"></textarea>
      <div style="text-align:right;font-size:11px;color:var(--text-tertiary);margin-top:4px" id="charCount">0 / 5000</div>
    </div>
    <div class="composer-row" style="margin-top:12px">
      <div class="composer-field" style="flex:1">
        <label class="composer-label">Platform played on</label>
        <select id="platformSelect" class="composer-select">
          <option value="">Select platform...</option>
          {(platforms ?? []).map((p: any) => (
            <option value={p.id}>{p.name}</option>
          ))}
        </select>
      </div>
      <div class="composer-field" style="width:120px">
        <label class="composer-label">Hours played</label>
        <input type="number" id="hoursPlayed" class="composer-input" placeholder="0" min="0" max="9999" />
      </div>
    </div>
    <div class="composer-actions" style="margin-top:14px">
      <label class="spoiler-toggle">
        <input type="checkbox" id="spoilerCheck" />
        <span>Contains spoilers</span>
      </label>
      <div style="display:flex;gap:8px;margin-left:auto">
        <button class="composer-draft" id="saveDraftReview" type="button">Save draft</button>
        <button class="composer-submit" id="submitReview">Post review</button>
      </div>
    </div>
    <div class="composer-error" id="composerError"></div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var banner = document.getElementById('welcomeBanner');
      if (!banner) return;
      if (localStorage.getItem('ck_welcome_dismissed')) { banner.style.display = 'none'; return; }
      document.getElementById('dismissWelcome').addEventListener('click', function () {
        localStorage.setItem('ck_welcome_dismissed', '1');
        banner.style.display = 'none';
      });
    })();
  </script>

  <script is:inline define:vars={{ isLoggedIn }}>
    function openComposer() {
      document.getElementById('composer').style.display = 'block'
      document.getElementById('composerOverlay').style.display = 'block'
      document.getElementById('gameSearch').focus()
      if (window.__lockScroll) window.__lockScroll()
    }
    function closeComposer() {
      document.getElementById('composer').style.display = 'none'
      document.getElementById('composerOverlay').style.display = 'none'
      if (window.__unlockScroll) window.__unlockScroll()
      resetComposer()
    }
    function resetComposer() {
      document.getElementById('gameSearch').value = ''
      document.getElementById('gameId').value = ''
      document.getElementById('reviewTitle').value = ''
      document.getElementById('reviewBody').value = ''
      document.getElementById('hoursPlayed').value = ''
      document.getElementById('scoreVal').value = ''
      document.getElementById('platformSelect').value = ''
      document.getElementById('spoilerCheck').checked = false
      document.getElementById('composerError').textContent = ''
      document.getElementById('charCount').textContent = '0 / 5000'
      document.getElementById('charCount').style.color = 'var(--text-tertiary)'
      document.getElementById('gameResults').classList.remove('open')
    }
    var postMenuBtn = document.getElementById('postMenuBtn')
    var postMenuDropdown = document.getElementById('postMenuDropdown')
    function closePostMenu() { postMenuDropdown.style.display = 'none' }
    postMenuBtn.addEventListener('click', (e) => {
      e.stopPropagation()
      if (!isLoggedIn) { window.location.href = '/signin'; return; }
      postMenuDropdown.style.display = postMenuDropdown.style.display === 'none' ? 'block' : 'none'
    })
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.post-menu-wrap')) closePostMenu()
    })
    document.getElementById('postMenuReview').addEventListener('click', () => {
      closePostMenu()
      openComposer()
    })
    document.getElementById('postMenuRec').addEventListener('click', () => {
      closePostMenu()
      window.openRecComposer()
    })
    document.getElementById('postMenuList').addEventListener('click', async (e) => {
      closePostMenu()
      var btn = e.currentTarget
      var label = btn.textContent
      btn.disabled = true
      btn.textContent = 'Creating…'
      try {
        var res = await fetch('/api/lists/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title: 'Untitled List', visibility: 'public', shared_to_feed: false }),
        })
        var data = await res.json()
        if (res.ok && data.list_id) {
          window.location.href = '/lists/' + data.list_id + '/edit'
        } else {
          btn.disabled = false
          btn.textContent = label
        }
      } catch (e) {
        btn.disabled = false
        btn.textContent = label
      }
    })
    var typeFilterMap = { reviews: 'review', lists: 'list', recs: 'rec' };
    document.querySelectorAll('.feed-tab').forEach(function(btn) {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.feed-tab').forEach(function(b) { b.classList.remove('active') });
        btn.classList.add('active');
        var tab = btn.dataset.tab;
        var isTypeFilter = !!typeFilterMap[tab];
        // Show/hide content sections
        ;['recent', 'following', 'hot-takes'].forEach(function(name) {
          var el = document.getElementById('tab-' + name);
          if (el) el.style.display = (tab === name || (isTypeFilter && name === 'recent')) ? '' : 'none';
        });
        // Apply/clear type filter class on the recent tab
        var recentEl = document.getElementById('tab-recent');
        if (recentEl) {
          recentEl.classList.remove('filter-reviews', 'filter-lists', 'filter-recs');
          if (isTypeFilter) recentEl.classList.add('filter-' + tab);
        }
      });
    })
    document.getElementById('cancelComposer').addEventListener('click', closeComposer)
    if (isLoggedIn && new URLSearchParams(window.location.search).get('compose') === '1') {
      history.replaceState(null, '', '/')
      openComposer()
    }
    document.getElementById('reviewBody').addEventListener('input', function() {
      const count = this.value.length
      const el = document.getElementById('charCount')
      el.textContent = count + ' / 5000'
      el.style.color = count > 4500 ? (count >= 5000 ? '#c0392b' : '#e67e22') : 'var(--text-tertiary)'
    })
    document.querySelectorAll('.review-body[data-spoiler="true"]').forEach(el => {
      el.addEventListener('click', () => el.classList.remove('spoiler-hidden'))
    })
    let searchTimeout
    document.getElementById('gameSearch').addEventListener('input', (e) => {
      clearTimeout(searchTimeout)
      const q = e.target.value.trim()
      if (q.length < 2) { document.getElementById('gameResults').classList.remove('open'); return; }
      searchTimeout = setTimeout(() => searchGames(q), 150)
    })
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.autocomplete-wrap')) {
        document.getElementById('gameResults').classList.remove('open')
      }
    })
    async function searchGames(q) {
      const res = await fetch('/api/games/search?q=' + encodeURIComponent(q))
      const games = await res.json()
      const results = document.getElementById('gameResults')
      results.innerHTML = ''
      if (!games.length) {
        results.innerHTML = '<div class="autocomplete-item" style="color:var(--text-tertiary)">No games found</div>'
      } else {
        games.forEach(game => {
          const item = document.createElement('div')
          item.className = 'autocomplete-item'
          item.innerHTML = '<div><div class="autocomplete-item-title">' + game.title + '</div>'
            + (game.source === 'igdb' ? '<div style="font-size:11px;color:var(--text-tertiary);margin-top:2px">Add to Chekpoint</div>' : '')
            + '</div>'
          item.addEventListener('click', () => {
            document.getElementById('gameSearch').value = game.title
            results.classList.remove('open')
            if (game.source === 'igdb') {
              document.getElementById('gameId').value = ''
              document.getElementById('composerError').textContent = 'Importing game...'
              fetch('/api/games/import', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ igdb_id: game.igdb_id }),
              })
                .then(async r => {
                  const data = await r.json()
                  if (!r.ok) {
                    document.getElementById('composerError').textContent = data.error ?? 'Failed to import game, try again.'
                    return
                  }
                  document.getElementById('gameId').value = data.id
                  document.getElementById('composerError').textContent = ''
                  fetchGamePlatforms(data.id)
                })
                .catch(() => { document.getElementById('composerError').textContent = 'Failed to import game, try again.' })
            } else {
              document.getElementById('gameId').value = game.id
              fetchGamePlatforms(game.id)
            }
          })
          results.appendChild(item)
        })
      }
      results.classList.add('open')
    }
    async function fetchGamePlatforms(gameId) {
      const select = document.getElementById('platformSelect')
      select.innerHTML = '<option value="">Loading...</option>'
      const res = await fetch('/api/games/platforms?id=' + gameId)
      const platforms = await res.json()
      if (platforms.length === 0) {
        select.innerHTML = '<option value="">Any platform</option>'
      } else {
        select.innerHTML = '<option value="">Select platform...</option>' +
          platforms.map(p => `<option value="${p.id}">${p.name}</option>`).join('')
      }
    }
    // ── Save draft: needs a game + review text; score/title/hours can come later. ──
    document.getElementById('saveDraftReview').addEventListener('click', async () => {
      const gameId = document.getElementById('gameId').value
      const scoreRaw = document.getElementById('scoreVal').value
      const title = document.getElementById('reviewTitle').value.trim()
      const body = document.getElementById('reviewBody').value.trim()
      const platformId = document.getElementById('platformSelect').value
      const hours = document.getElementById('hoursPlayed').value
      const spoilers = document.getElementById('spoilerCheck').checked
      const errorEl = document.getElementById('composerError')
      errorEl.textContent = ''
      if (!gameId) { errorEl.textContent = 'Please select a game.'; return; }
      if (!body) { errorEl.textContent = 'Write something before saving a draft.'; return; }
      if (scoreRaw && (parseFloat(scoreRaw) < 0.1 || parseFloat(scoreRaw) > 10)) { errorEl.textContent = 'Score must be between 0.1 and 10.'; return; }
      const dBtn = document.getElementById('saveDraftReview')
      dBtn.disabled = true
      dBtn.textContent = 'Saving...'
      try {
        const res = await fetch('/api/reviews/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            game_id: gameId,
            score: scoreRaw ? parseFloat(scoreRaw) : null,
            title: title || null,
            body,
            platform_played_on: platformId || null,
            play_time_hours: hours ? parseInt(hours) : null,
            contains_spoilers: spoilers,
            status: 'draft',
          }),
        })
        const data = await res.json()
        if (!res.ok) { errorEl.textContent = data.error ?? 'Could not save draft.'; dBtn.disabled = false; dBtn.textContent = 'Save draft'; return; }
        dBtn.textContent = 'Draft saved ✓'
        setTimeout(() => { window.location.href = '/drafts'; }, 700)
      } catch (e) {
        errorEl.textContent = 'Something went wrong.'
        dBtn.disabled = false
        dBtn.textContent = 'Save draft'
      }
    })

    document.getElementById('submitReview').addEventListener('click', async () => {
      const gameId = document.getElementById('gameId').value
      const score = document.getElementById('scoreVal').value
      const title = document.getElementById('reviewTitle').value.trim()
      const body = document.getElementById('reviewBody').value.trim()
      const platformId = document.getElementById('platformSelect').value
      const hours = document.getElementById('hoursPlayed').value
      const spoilers = document.getElementById('spoilerCheck').checked
      const errorEl = document.getElementById('composerError')
      errorEl.textContent = ''
      if (!gameId) { errorEl.textContent = 'Please select a game.'; return; }
      if (!score || parseFloat(score) < 0.1 || parseFloat(score) > 10) { errorEl.textContent = 'Please enter a score between 0.1 and 10.'; return; }
      if (!title) { errorEl.textContent = 'Please add a title.'; return; }
      if (!body) { errorEl.textContent = 'Please write a review.'; return; }
      if (body.length > 5000) { errorEl.textContent = 'Review must be at most 5000 characters.'; return; }
      if (!hours || parseInt(hours) < 1 || parseInt(hours) > 25000) { errorEl.textContent = 'You must have at least 1 hour played to submit a review.'; return; }
      const btn = document.getElementById('submitReview')
      btn.disabled = true
      btn.textContent = 'Posting...'
      const res = await fetch('/api/reviews/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          game_id: gameId,
          score: parseFloat(score),
          title, body,
          platform_played_on: platformId || null,
          play_time_hours: hours ? parseInt(hours) : null,
          contains_spoilers: spoilers,
        }),
      })
      const data = await res.json()
      if (!res.ok) {
        errorEl.textContent = data.error ?? 'Something went wrong.'
        btn.disabled = false
        btn.textContent = 'Post review'
      } else {
        if (typeof gtag === 'function') {
          gtag('event', 'review_posted', { game_title: document.getElementById('gameSearch').value, score: parseFloat(score) });
        }
        const userScore = parseFloat(score)
        const gameTitle = document.getElementById('gameSearch').value
        const { gameSlug, gameCover, communityAvg, reviewCount } = data
        document.getElementById('resultGameTitle').textContent = gameTitle
        const scoreEl = document.getElementById('resultUserScore')
        scoreEl.textContent = userScore.toFixed(1)
        if (gameSlug) document.getElementById('resultGameLink').href = '/games/' + gameSlug
        const scoreColorMap = {
          'score-perfect':'var(--score-perfect)','score-great':'var(--score-great)',
          'score-teal':'var(--score-teal)','score-good':'var(--score-good)',
          'score-mid':'var(--score-mid)','score-orange':'var(--score-orange)','score-low':'var(--score-low)',
        }
        function clientScoreClass(s) {
          if (s === 10) return 'score-perfect'; if (s >= 9) return 'score-great';
          if (s >= 8) return 'score-teal'; if (s >= 7) return 'score-good';
          if (s >= 5) return 'score-mid'; if (s >= 3) return 'score-orange'; return 'score-low';
        }
        scoreEl.style.color = scoreColorMap[clientScoreClass(userScore)]
        if (userScore === 10) { scoreEl.classList.add('score-perfect-pop') }
        else if (userScore >= 9) { scoreEl.classList.add('score-stellar') }
        else if (userScore <= 3) { scoreEl.classList.add('score-crumble') }
        if (gameCover) {
          const img = document.getElementById('resultCoverImg')
          img.src = gameCover.startsWith('//') ? 'https:' + gameCover : gameCover
          img.src = img.src.replace(/t_[a-z0-9_]+/, 't_cover_big')
          img.alt = gameTitle
          document.getElementById('resultCover').style.display = 'block'
        }
        if (reviewCount > 1) {
          document.getElementById('resultCommunityScore').textContent = communityAvg.toFixed(1)
          document.getElementById('resultReviewCount').textContent = 'from ' + reviewCount + ' review' + (reviewCount !== 1 ? 's' : '')
        } else {
          document.getElementById('resultScoreRow').style.justifyContent = 'center'
          document.getElementById('resultDivider').style.display = 'none'
          document.getElementById('resultCommunityCol').style.display = 'none'
          document.getElementById('resultFirstMsg').style.display = 'block'
          const firstReviewerSuffixes = [
            { text: 'Nice.', weight: 1 },
            { text: 'Achievement unlocked.', weight: 1 },
            { text: 'Save point established.', weight: 1 },
            { text: 'Pioneer behavior.', weight: 1 },
            { text: 'You set the benchmark.', weight: 1 },
            { text: 'Someone had to go first.', weight: 1 },
            { text: 'History is written by the first reviewer. Probably.', weight: 1 },
            { text: 'Is anyone out there?', weight: 1 },
            { text: 'The record shows it.', weight: 1 },
            { text: 'It is written.', weight: 1 },
            { text: 'Here I am. Here I remain.', weight: 1 },
            { text: 'The reviews must flow.', weight: 1 },
            { text: 'Never tell me the odds.', weight: 1 },
            { text: 'Stay a while and listen.', weight: 1 },
            { text: 'Gorp gorp gorp.', weight: 1 },
            { text: 'So it begins.', weight: 1 },
          ]
          function pickWeighted(items) {
            const total = items.reduce((sum, m) => sum + m.weight, 0)
            let r = Math.random() * total
            for (const m of items) { r -= m.weight; if (r <= 0) return m.text }
            return items[items.length - 1].text
          }
          document.getElementById('resultFirstMsg').textContent = 'You\'re the first person to review ' + gameTitle + ' on Chekpoint. ' + pickWeighted(firstReviewerSuffixes)
        }
        document.getElementById('composerTitle').style.display = 'none'
        document.getElementById('composerFormContent').style.display = 'none'
        document.getElementById('reviewResult').style.display = 'block'
        fetch(window.location.href).catch(() => {})
        document.getElementById('resultClose').addEventListener('click', () => { closeComposer(); window.location.reload() })
        document.getElementById('resultGameLink').addEventListener('click', () => { if (window.__unlockScroll) window.__unlockScroll() })
      }
    })
  </script>

  <script is:inline define:vars={{ isLoggedIn, currentProfileId: currentProfile?.id ?? null, initialRecentCursor, initialFollowingCursor, initialRecentDone, initialFollowingDone }}>
  (function () {
    // ── Image emote map — keep in sync with src/data/reactions.ts ─────────────
    // Add new emote keys here whenever you add them to IMAGE_EMOTES in reactions.ts
    var IMAGE_EMOTE_MAP = {
      '5Head':true,'catJam':true,'Clap':true,'COPIUM':true,
      'ddHuh':true,'DonoWall':true,'EZ':true,'gachiBASS':true,
      'gachiHyper':true,'GIGACHAD':true,'KEKW':true,'LULW':true,
      'MLADY':true,'monkaW':true,'MonkaS':true,'NODDERS':true,
      'NOPERS':true,'OMEGALUL':true,'OOOO':true,'PartyKirby':true,
      'peepoClap':true,'peepoLeave':true,'PeepoNoob':true,
      'pepeD':true,'PepeHands':true,'pepeJAM':true,
      'PepeLaugh':true,'Pepega':true,'PepegaCredit':true,
      'POGGERS':true,'Sadge':true,'pressF':true,'POLICE':true,
      'AYAYA':true,'pikaOMG':true,'Prayge':true,'ThisIsFine':true,
      'jjkStress':true,'LOLL':true,'ppDrool':true,
      'PenguinR':true,'clubPls':true,
    };

    // Renders image emotes as <img>, regular emoji as escaped text
    function renderReactionDisplay(type) {
      if (IMAGE_EMOTE_MAP[type]) {
        return '<img src="/emotes/' + type + '.webp" alt="' + esc(type) + '" '
             + 'style="width:18px;height:18px;object-fit:contain;vertical-align:middle;margin-right:2px">';
      }
      return esc(type);
    }

    // ── Helpers ────────────────────────────────────────────────────────────────
    function esc(s) {
      return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
    function timeAgo(dateStr) {
      var diff = Math.floor((Date.now() - new Date(dateStr).getTime()) / 1000);
      if (diff < 60)     return diff + 's';
      if (diff < 3600)   return Math.floor(diff / 60) + 'm';
      if (diff < 86400)  return Math.floor(diff / 3600) + 'h';
      if (diff < 604800) return Math.floor(diff / 86400) + 'd';
      return Math.floor(diff / 604800) + 'w';
    }
    function scoreClass(score) {
      if (score === 10) return 'score-perfect';
      if (score >= 9)   return 'score-great';
      if (score >= 8)   return 'score-teal';
      if (score >= 7)   return 'score-good';
      if (score >= 5)   return 'score-mid';
      if (score >= 3)   return 'score-orange';
      return 'score-low';
    }
    function igdbThumb(url) {
      if (!url) return null;
      var clean = url.startsWith('//') ? 'https:' + url : url;
      return clean.replace(/t_[a-z0-9_]+/, 't_thumb');
    }
    function initials(u) { return (u || '?').slice(0, 2).toUpperCase(); }

    // ── Build card HTML matching ReviewCard.astro exactly ──────────────────────
    function buildCard(r) {
      var g   = r.games    || {};
      var p   = r.profiles || {};
      var ts  = r.published_at || r.created_at;
      var thumb = igdbThumb(g.cover_img_url);
      var isOwn = !!(currentProfileId && p.id === currentProfileId);
      var li    = isLoggedIn ? 'true' : 'false';

      var votesArr = Array.isArray(r.review_votes) ? r.review_votes : (r.review_votes ? [r.review_votes] : []);
      var up   = votesArr.filter(function(v){ return v.vote ===  1; }).length;
      var down = votesArr.filter(function(v){ return v.vote === -1; }).length;
      var myV  = currentProfileId ? ((votesArr.find(function(v){ return v.profile_id === currentProfileId; }) || {}).vote || 0) : 0;

      var rxArr = Array.isArray(r.review_reactions) ? r.review_reactions : [];
      var rxCountMap = {};
      rxArr.forEach(function(rx) {
        if (!rxCountMap[rx.reaction_type]) rxCountMap[rx.reaction_type] = { count: 0, active: false };
        rxCountMap[rx.reaction_type].count++;
        if (currentProfileId && rx.profile_id === currentProfileId) rxCountMap[rx.reaction_type].active = true;
      });
      var rxDefs = Object.keys(rxCountMap).map(function(type) {
        return { type: type, display: type, count: rxCountMap[type].count, active: rxCountMap[type].active };
      });
      var commentCount = Array.isArray(r.review_comments) ? r.review_comments.length : 0;

      var h = '<div data-feed-type="review"><article class="rc" data-score="' + esc(r.score) + '" data-date="' + esc(ts) + '" data-upvotes="' + up + '">';

      if (!isOwn) {
        h += '<div class="rc-menu-wrap">'
           + '<button class="rc-menu-btn" data-menu-id="' + esc(r.id) + '" aria-label="More options">⋯</button>'
           + '<div class="rc-menu-dropdown" id="rcd-' + esc(r.id) + '" style="display:none">'
           + '<button class="rc-menu-report" data-report-review-id="' + esc(r.id) + '" data-is-logged-in="' + li + '">Report</button>'
           + '</div></div>';
      }

      if (isLoggedIn && isOwn) {
        h += '<div class="rc-owner-actions">'
           + '<button class="rc-edit-btn" data-review-id="' + esc(r.id) + '" data-game-id="' + esc(g.id||'') + '" data-game-title="' + esc(g.title||'') + '" data-score="' + esc(r.score) + '" data-review-title="' + esc(r.title||'') + '" data-body="' + esc(r.body) + '" data-platform-id="' + esc((r.played_on||{}).id||'') + '" data-hours="' + esc(r.play_time_hours||'') + '" data-spoilers="' + (r.contains_spoilers?'true':'false') + '" title="Edit review">'
           + '<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>'
           + '</button>'
           + '<button class="rc-delete-btn" data-review-id="' + esc(r.id) + '" title="Delete review">'
           + '<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>'
           + '</button>'
           + '<span class="rc-delete-confirm" data-review-id="' + esc(r.id) + '" style="display:none">Sure? '
           + '<button class="rc-delete-yes" data-review-id="' + esc(r.id) + '">Yes, delete</button> '
           + '<button class="rc-delete-no" data-review-id="' + esc(r.id) + '">Cancel</button></span>'
           + '</div>';
      }

      h += '<div class="rc-reviewer">'
         + '<a href="/reviewers/' + esc(p.username) + '" class="rc-avatar">'
         + (p.avatar_url ? '<img src="' + esc(p.avatar_url) + '" alt="' + esc(p.username) + '" />' : '<span>' + esc(initials(p.username)) + '</span>')
         + '</a>'
         + '<a href="/reviewers/' + esc(p.username) + '" class="rc-reviewer-name">@' + esc(p.username) + '</a>'
         + '<span class="rc-dot">·</span>'
         + '<span class="rc-ts">' + esc(timeAgo(ts)) + '</span>'
         + '</div>';

      h += '<div class="rc-main">'
         + '<a href="/games/' + esc(g.slug) + '" class="rc-cover">'
         + (thumb ? '<img src="' + esc(thumb) + '" alt="' + esc(g.title||'') + '" loading="lazy" />' : '<span>🎮</span>')
         + '</a>'
         + '<div class="rc-content">'
         + '<div class="rc-game-row">'
         + '<a href="/games/' + esc(g.slug) + '" class="rc-game-link">' + esc(g.title || 'Unknown Game') + '</a>'
         + '<div class="score-badge ' + scoreClass(r.score) + '">' + esc(r.score) + '</div>'
         + '</div>';

      if (r.contains_spoilers) h += '<div class="rc-spoiler-pill">⚠ spoilers</div>';
      if (r.title) h += '<div class="rc-title">' + esc(r.title) + '</div>';

      h += '<div class="rc-body' + (r.contains_spoilers ? ' spoiler-hidden' : '') + '"'
         + ' data-spoiler="' + (r.contains_spoilers ? 'true' : 'false') + '"'
         + ' data-href="/reviews/' + esc(r.id) + '"'
         + ' id="rcb-' + esc(r.id) + '">'
         + esc(r.body)
         + '</div>';

      h += '<div class="rc-footer"><div class="rc-chips">';
      if (r.played_on) h += '<span class="rc-chip">' + esc(r.played_on.name) + '</span>';
      if ((r.play_time_hours || 0) > 0) h += '<span class="rc-chip">' + esc(r.play_time_hours) + 'h</span>';
      h += '</div>'
         + '<a href="/reviews/' + esc(r.id) + '" class="rc-comment-bubble">'
         + '<svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 10a2 2 0 0 1-2 2H5l-3 3V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v6z"/></svg>'
         + commentCount
         + '</a></div>';

      h += '<div class="rc-votes">'
         + '<button class="vote-btn' + (myV === 1 ? ' active-up' : '') + '" data-review-id="' + esc(r.id) + '" data-vote="1" data-count="' + up + '">▲ ' + up + '</button>'
         + '<button class="vote-btn' + (myV === -1 ? ' active-down' : '') + '" data-review-id="' + esc(r.id) + '" data-vote="-1" data-count="' + down + '">▼ ' + down + '</button>'
         + '<span class="rc-votes-sep"></span>'
         + '<div class="rc-reaction-wrap" data-review-id="' + esc(r.id) + '">';

      // ── FIX: use renderReactionDisplay() so image emotes render as <img> ──
      rxDefs.forEach(function(rx) {
        h += '<button class="rc-reaction-btn rc-reaction-inline' + (rx.active ? ' reaction-active' : '') + '"'
           + ' data-review-id="' + esc(r.id) + '" data-reaction="' + esc(rx.type) + '" data-display="' + esc(rx.display) + '"'
           + ' data-reacted="' + (rx.active ? 'true' : 'false') + '" data-count="' + rx.count + '" data-logged-in="' + li + '">'
           + renderReactionDisplay(rx.type) + ' ' + rx.count
           + '</button>';
      });

      h += '<button class="rc-reaction-toggle" data-toggle-review-id="' + esc(r.id) + '" data-logged-in="' + li + '" title="React">+</button>'
         + '</div>'
         + '<span class="rc-vote-ts">' + esc(timeAgo(ts)) + '</span>'
         + '</div>'
         + '</div></div>'
         + '</article></div>';

      return h;
    }

    // ── Per-tab state ──────────────────────────────────────────────────────────
    var state = {
      recent:    { cursor: initialRecentCursor,    loading: false, done: initialRecentDone },
      following: { cursor: initialFollowingCursor, loading: false, done: initialFollowingDone }
    };

    async function loadMore(tab) {
      var s = state[tab];
      if (s.loading || s.done) return;
      s.loading = true;
      var sentinel = document.getElementById('sentinel-' + tab);
      var loader   = document.getElementById('loader-' + tab);
      var endEl    = document.getElementById('end-' + tab);
      if (loader) loader.style.display = 'block';
      try {
        var url = '/api/reviews/feed?tab=' + tab + '&limit=20';
        if (s.cursor) url += '&cursor=' + encodeURIComponent(s.cursor);
        var res = await fetch(url);
        if (!res.ok) throw new Error('HTTP ' + res.status);
        var reviews = await res.json();
        if (!Array.isArray(reviews) || reviews.length === 0) {
          s.done = true;
          if (endEl) endEl.style.display = 'block';
          if (sentinel) sentinel.remove();
          return;
        }
        var tmp = document.createElement('div');
        reviews.forEach(function(review) {
          tmp.innerHTML = buildCard(review);
          if (tmp.firstChild && sentinel && sentinel.parentNode) {
            sentinel.parentNode.insertBefore(tmp.firstChild, sentinel);
          }
        });
        var last = reviews[reviews.length - 1];
        s.cursor = last.published_at || last.created_at;
        if (reviews.length < 20) {
          s.done = true;
          if (endEl) endEl.style.display = 'block';
          if (sentinel) sentinel.remove();
        }
      } catch (e) {
        console.error('[feed] loadMore error:', e);
      } finally {
        s.loading = false;
        if (loader) loader.style.display = 'none';
      }
    }

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (!entry.isIntersecting) return;
        var tab = entry.target.id === 'sentinel-recent' ? 'recent' : 'following';
        loadMore(tab);
      });
    }, { rootMargin: '300px' });

    var sentinelRecent    = document.getElementById('sentinel-recent');
    var sentinelFollowing = document.getElementById('sentinel-following');
    if (sentinelRecent    && !initialRecentDone)    observer.observe(sentinelRecent);
    if (sentinelFollowing && !initialFollowingDone) observer.observe(sentinelFollowing);
    if (initialRecentDone    && document.getElementById('end-recent'))    document.getElementById('end-recent').style.display = 'block';
    if (initialFollowingDone && document.getElementById('end-following')) document.getElementById('end-following').style.display = 'block';
  })();
  </script>

  <ReportModal />
  <EditModal />
  <RecommendationComposer />

  <div slot="sidebar-right">
    {isLoggedIn && currentProfile && (
      <GettingStarted
        variant="sidebar"
        hasAvatar={!!currentProfile.avatar_url}
        hasBio={!!currentProfile.bio}
        hasFavorite={!!currentProfile.favorite_game_id}
        hasReview={!!lastReview}
      />
    )}

    {isLoggedIn && lastReview && (
      <div class="widget">
        <div class="widget-title">Your last review</div>
        <a href={`/games/${lastReview.games?.slug}`} style="display:flex;gap:12px;align-items:flex-start;text-decoration:none">
          <div style="flex-shrink:0;width:52px;height:70px;border-radius:8px;overflow:hidden;background:var(--tag-bg);border:1px solid var(--border)">
            {lastReview.games?.cover_img_url
              ? <img src={igdbImage(lastReview.games.cover_img_url) ?? ''} alt={lastReview.games.title} style="width:100%;height:100%;object-fit:cover" />
              : <span style="display:flex;align-items:center;justify-content:center;height:100%;font-size:22px">🎮</span>
            }
          </div>
          <div style="flex:1;min-width:0">
            <div style="font-size:13px;font-weight:500;line-height:1.3;margin-bottom:6px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical">{lastReview.games?.title}</div>
            <div class={`score-badge ${scoreClass(lastReview.score)}`} style="width:32px;height:32px;border-radius:7px;display:inline-flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;font-family:'DM Serif Display',serif;margin-bottom:6px">{lastReview.score}</div>
            {lastReview.title && <div style="font-size:12px;color:var(--text-secondary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{lastReview.title}</div>}
            <div style="font-size:11px;color:var(--text-tertiary);margin-top:3px">{timeAgo(lastReview.published_at ?? lastReview.created_at)} ago</div>
          </div>
        </a>
      </div>
    )}

    <div class="widget" style="margin-top:4px">
      <div class="widget-title">Trending this week</div>
      {trending.length === 0 ? (
        <div style="font-size:13px;color:var(--text-tertiary)">No activity yet this week.</div>
      ) : (
        trending.map((game, i) => (
          <a href={`/games/${game.slug}`} class="trending-item" style="display:flex">
            <span class="trending-rank" style="padding-top:4px">{i + 1}</span>
            <div class="trending-cover">
              {game.cover
                ? <img src={igdbImage(game.cover, 't_cover_big') ?? ''} alt={game.title} />
                : <span style="font-size:20px;display:flex;align-items:center;justify-content:center;height:100%">🎮</span>
              }
            </div>
            <div class="trending-info">
              <div class="trending-game">{game.title}</div>
              <div class="trending-count">{game.count} review{game.count !== 1 ? 's' : ''} this week</div>
            </div>
          </a>
        ))
      )}
    </div>

    {recentLists.length > 0 && (
      <div class="widget" style="margin-top:4px" id="ck-widget-lists">
        <div class="widget-title">Recent Lists</div>
        <div style="display:flex;flex-direction:column;gap:10px">
          {recentLists.map((list: any) => (
            <ListCard
              id={list.id}
              title={list.title}
              isRanked={list.is_ranked}
              visibility={list.visibility}
              entryCount={list.entryCount}
              coverUrls={list.coverUrls}
              coverImageUrl={list.cover_image_url}
              ownerUsername={list.ownerUsername}
              ownerAvatar={list.ownerAvatar}
              showOwner={true}
              compact={true}
            />
          ))}
        </div>
      </div>
    )}

    {recentRecs.length > 0 && (
      <div class="widget" style="margin-top:4px" id="ck-widget-recs">
        <div class="widget-title">Recent recommendations</div>
        <div style="display:flex;flex-direction:column;gap:4px">
          {recentRecs.slice(0, 3).map((rec: any) => (
            <a href={`/recommendations/${rec.id}`} class="rec-panel-item">
              <div class="rec-panel-covers">
                <div class="rec-panel-cover">
                  {igdbImage(rec.sourceGame?.cover_img_url)
                    ? <img src={igdbImage(rec.sourceGame.cover_img_url) ?? ''} alt={rec.sourceGame?.title} loading="lazy" />
                    : <span>🎮</span>}
                </div>
                <span class="rec-panel-arrow">→</span>
                <div class="rec-panel-cover">
                  {igdbImage(rec.targetGame?.cover_img_url)
                    ? <img src={igdbImage(rec.targetGame.cover_img_url) ?? ''} alt={rec.targetGame?.title} loading="lazy" />
                    : <span>🎮</span>}
                </div>
              </div>
              <div class="rec-panel-text">
                <span class="rec-panel-titles">{rec.sourceGame?.title} → {rec.targetGame?.title}</span>
                <span class="rec-panel-by">by @{rec.ownerUsername}</span>
              </div>
            </a>
          ))}
        </div>
        <a href="/recommendations" class="rec-panel-seeall">See all recommendations →</a>
      </div>
    )}

    <div class="widget" style="margin-top:4px">
      <div class="widget-title">Site stats</div>
      <div class="stat-row">
        <span class="stat-label">Total reviews</span>
        <span class="stat-value">{formatCount(totalReviews)}</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Total recommendations</span>
        <span class="stat-value">{formatCount(totalRecommendations)}</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Games tracked</span>
        <span class="stat-value">{formatCount(totalGames)}</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Reviewers</span>
        <span class="stat-value">{formatCount(totalReviewers)}</span>
      </div>
    </div>

    <nav class="side-foot">
      <div class="side-foot-links">
        <a href="/about">About</a>
        <a href="/terms">Terms</a>
        <a href="/privacy">Privacy</a>
        <a href="/contact">Contact</a>
      </div>
      <div class="side-foot-copy">&copy; {new Date().getFullYear()} Chekpoint. All rights reserved.</div>
      <a href="https://www.igdb.com" target="_blank" rel="noopener noreferrer" class="side-foot-igdb">Powered by IGDB</a>
    </nav>
  </div>

</Layout>

<style>
  /* ── Right-sidebar footer links (replaces the old global site footer) ── */
  .side-foot { margin-top: 16px; padding: 0 4px; display: flex; flex-direction: column; gap: 8px; }
  .side-foot-links { display: flex; flex-wrap: wrap; gap: 14px; }
  .side-foot a { font-size: 12px; color: var(--text-tertiary); text-decoration: none; transition: color 0.15s; }
  .side-foot a:hover { color: var(--text-secondary); }
  .side-foot-copy { font-size: 12px; color: var(--text-tertiary); line-height: 1.5; }

  .welcome-banner { background: var(--accent-subtle); border-bottom: 1px solid var(--border); }
  .welcome-banner-body { display: flex; align-items: center; gap: 12px; padding: 12px 20px; }
  .welcome-banner-text { flex: 1; font-size: 13px; line-height: 1.5; color: var(--text-secondary); }
  .welcome-banner-text strong { color: var(--text-primary); }
  .welcome-banner-cta { display: inline-block; margin-left: 10px; color: var(--accent); font-weight: 500; white-space: nowrap; }
  .welcome-banner-cta:hover { text-decoration: underline; }
  .welcome-banner-dismiss { flex-shrink: 0; background: none; border: none; color: var(--text-tertiary); font-size: 14px; cursor: pointer; padding: 4px 6px; border-radius: 4px; line-height: 1; transition: color 0.15s; }
  .welcome-banner-dismiss:hover { color: var(--text-primary); }

  /* ── "+ Post" dropdown in the feed header ── */
  .post-menu-wrap { position: relative; }
  .post-menu-dropdown {
    position: absolute; right: 0; top: calc(100% + 6px);
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.12); min-width: 190px; z-index: 20; overflow: hidden;
  }
  .post-menu-dropdown button {
    display: block; width: 100%; text-align: left; padding: 10px 14px;
    font-size: 13px; font-family: inherit; color: var(--text-secondary);
    background: none; border: none; cursor: pointer; transition: background 0.1s, color 0.1s;
  }
  .post-menu-dropdown button:hover { background: var(--bg-hover); color: var(--text-primary); }
  .post-menu-dropdown button + button { border-top: 1px solid var(--border-subtle); }

  /* ── Hot Takes tab: deviation badge sits flush above each ReviewCard ── */
  .ht-item { border-bottom: 1px solid var(--border-subtle); }
  .ht-item:last-child { border-bottom: none; }
  .ht-badge { display: flex; align-items: center; gap: 10px; padding: 8px 20px 0; }
  .ht-badge-delta { font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 20px; letter-spacing: 0.02em; flex-shrink: 0; }
  .ht-badge-avg { font-size: 11px; color: var(--text-tertiary); }
  .ht-badge-avg strong { color: var(--text-secondary); font-weight: 600; }
  .ht-badge-down .ht-badge-delta { background: rgba(248, 113, 113, 0.12); color: #f87171; border: 1px solid rgba(248, 113, 113, 0.25); }
  .ht-badge-up .ht-badge-delta { background: rgba(52, 211, 153, 0.12); color: #34d399; border: 1px solid rgba(52, 211, 153, 0.2); }

  /* ── Sidebar "Recent recommendations" panel ── */
