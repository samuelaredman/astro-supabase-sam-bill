---
import { getSupabase, createSupabaseServerClientFromContext } from "../utils/database";
import Layout from "../components/Layout.astro";
import ReportModal from "../components/ReportModal.astro";
import EditModal from "../components/EditModal.astro";
import ReviewCard from "../components/ReviewCard.astro";

const supabase = getSupabase();
const serverClient = createSupabaseServerClientFromContext(Astro);

// ── Stage 1: auth (must come first) ─────────────────────────────────────────
const { data: { user } } = await serverClient.auth.getUser();
const isLoggedIn = !!user;

const oneDayAgo = new Date(Date.now() - 24 * 60 * 60 * 1000).toISOString()
const oneWeekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString()

// ── Stage 2: all independent queries fire in parallel ────────────────────────
const REVIEW_FIELDS = `
  id, score, title, body, play_time_hours,
  contains_spoilers, status, published_at, created_at,
  played_on:platform_played_on ( id, name, slug ),
  games ( id, title, slug, cover_img_url ),
  profiles ( id, username, avatar_url ),
  review_votes( vote ),
  review_reactions( reaction_type, profile_id ),
  review_comments( id )
`
const db = supabase as any
const [
  profileRes,
  platformsRes,
  rawReviewsRes,
  todayRawRes,
  // weekReviews powers both "Trending this week" AND "Top rated" — one query, two uses
  weekReviewsRes,
  reviewCountRes,
  gameCountRes,
  profileCountRes,
  genresRes,
] = await Promise.all([
  user
    ? db.from('profiles').select('id, username, avatar_url').eq('auth_user_id', user.id).single()
    : Promise.resolve({ data: null }),
  db.from('platforms').select('id, name, slug').order('name', { ascending: true }),
  db.from('reviews').select(REVIEW_FIELDS).eq('status', 'published').order('published_at', { ascending: false }).limit(20),
  db.from('reviews').select('game_id, games(id, title, slug, cover_img_url)').eq('status', 'published').gte('published_at', oneDayAgo).limit(100),
  db.from('reviews').select('game_id, score, games(id, title, slug, cover_img_url)').eq('status', 'published').gte('published_at', oneWeekAgo).limit(500),
  db.from('reviews').select('*', { count: 'exact', head: true }).eq('status', 'published'),
  db.from('games').select('*', { count: 'exact', head: true }),
  db.from('profiles').select('*', { count: 'exact', head: true }),
  db.from('genres').select('id, name').order('name'),
])

// Unpack results
const currentProfile = profileRes.data ?? null
const { data: platforms } = platformsRes

type Platform = { id: string; name: string; slug: string; };
type Review = {
  id: string; score: number; title: string; body: string;
  play_time_hours: number; contains_spoilers: boolean; status: string;
  published_at: string; created_at: string; played_on: Platform | null;
  games: { id: string; title: string; slug: string; cover_img_url: string | null } | null;
  profiles: { id: string; username: string; avatar_url: string | null } | null;
  review_votes: { vote: number }[] | { vote: number } | null;
}
const reviews = (rawReviewsRes.data ?? []) as Review[]

// mostReviewedToday
const todayMap: Record<string, { title: string; slug: string; cover: string | null; count: number }> = {}
for (const r of todayRawRes.data ?? []) {
  const g = (r as any).games
  if (!g) continue
  if (!todayMap[g.id]) todayMap[g.id] = { title: g.title, slug: g.slug, cover: g.cover_img_url, count: 0 }
  todayMap[g.id].count++
}
const mostReviewedToday = Object.values(todayMap).sort((a, b) => b.count - a.count)[0] ?? null
const featuredGame = mostReviewedToday

// Trending + topRated derived from the same week dataset (no second query)
const trendingMap: Record<string, { title: string; slug: string; cover: string | null; count: number }> = {}
const weekGameMap: Record<string, { title: string; slug: string; cover: string | null; scores: number[] }> = {}
for (const r of weekReviewsRes.data ?? []) {
  const g = (r as any).games
  if (!g) continue
  if (!trendingMap[g.id]) trendingMap[g.id] = { title: g.title, slug: g.slug, cover: g.cover_img_url, count: 0 }
  trendingMap[g.id].count++
  if (!weekGameMap[g.id]) weekGameMap[g.id] = { title: g.title, slug: g.slug, cover: g.cover_img_url, scores: [] }
  if (r.score != null) weekGameMap[g.id].scores.push(r.score)
}
const trending = Object.values(trendingMap).sort((a, b) => b.count - a.count).slice(0, 5)
const topRated = Object.entries(weekGameMap)
  .map(([id, g]) => {
    if (g.scores.length < 2) return null
    const avg = g.scores.reduce((a, b) => a + b, 0) / g.scores.length
    return { id, ...g, avg_score: avg, review_count: g.scores.length }
  })
  .filter(Boolean)
  .sort((a: any, b: any) => b.avg_score - a.avg_score)
  .slice(0, 12)

// Site stats
const totalReviews = reviewCountRes.count ?? 0
const totalGames = gameCountRes.count ?? 0
const totalReviewers = profileCountRes.count ?? 0

const { data: genres } = genresRes

// ── Stage 3: user-specific queries (depends on profile) ──────────────────────
let followingReviews: any[] = []
let lastReview: any = null
if (user && currentProfile) {
  // lastReview and follows are independent of each other — run in parallel
  const [lastReviewRes, followRowsRes] = await Promise.all([
    db.from('reviews')
      .select('id, score, published_at, created_at, title, games ( id, title, slug, cover_img_url )')
      .eq('profile_id', currentProfile.id)
      .eq('status', 'published')
      .order('published_at', { ascending: false })
      .limit(1)
      .maybeSingle(),
    db.from('follows').select('following_id').eq('follower_id', currentProfile.id),
  ])
  lastReview = lastReviewRes.data ?? null
  const followingIds = (followRowsRes.data ?? []).map((r: any) => r.following_id)
  if (followingIds.length > 0) {
    const { data: fRevs } = await db
      .from('reviews')
      .select(REVIEW_FIELDS)
      .eq('status', 'published')
      .in('profile_id', followingIds)
      .order('published_at', { ascending: false })
      .limit(20)
    followingReviews = (fRevs ?? []) as any[]
  }
}

const featuredGenres = ['Action','Adventure','Role-playing (RPG)','Shooter','Platform','Puzzle','Strategy','Indie','Fighting','Racing']

function igdbImage(url: string | null, size = 't_cover_big') {
  if (!url) return null
  const clean = url.startsWith('//') ? `https:${url}` : url
  return clean.replace(/t_[a-z_]+/, size)
}

function timeAgo(dateStr: string): string {
  const diff = Math.floor((Date.now() - new Date(dateStr).getTime()) / 1000)
  if (diff < 60) return `${diff}s`
  if (diff < 3600) return `${Math.floor(diff / 60)}m`
  if (diff < 86400) return `${Math.floor(diff / 3600)}h`
  return `${Math.floor(diff / 86400)}d`
}

function scoreColor(score: number): string {
  if (score === 10) return 'score-perfect'
  if (score >= 9) return 'score-great'
  if (score >= 8) return 'score-teal'
  if (score >= 7) return 'score-good'
  if (score >= 5) return 'score-mid'
  if (score >= 3) return 'score-orange'
  return 'score-low'
}

function formatCount(n: number): string {
  if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k'
  return String(n)
}
---

<Layout
  title="Chekpoint — Game Reviews"
  description="Discover what gamers really think. Read honest community reviews, hot takes, and scores for thousands of games on Chekpoint."
  isLoggedIn={isLoggedIn}
  currentProfile={currentProfile}
  activeNav="home">

  <main class="feed">
    <div class="feed-header">
      <div>
        <div class="feed-title">Recent Reviews</div>
        <div class="feed-subtitle">{reviews.length > 0 ? `${reviews.length} reviews` : 'Be the first to review a game'}</div>
      </div>
      <button class="new-review-btn" id="openComposer">+ Write a review</button>
    </div>

    {featuredGame && (
      <div class="hero">
        {igdbImage((featuredGame as any).cover, 't_1080p') && (
          <div class="hero-bg" style={`background-image: url('${igdbImage((featuredGame as any).cover, 't_1080p')}')`}></div>
        )}
        <div class="hero-overlay"></div>
        <div class="hero-content">
          {igdbImage((featuredGame as any).cover)
            ? <img class="hero-cover" src={igdbImage((featuredGame as any).cover) ?? ''} alt={(featuredGame as any).title} />
            : <div class="hero-cover-placeholder">🎮</div>
          }
          <div class="hero-info">
            <div class="hero-label">Most Reviewed Today</div>
            <div class="hero-title">{(featuredGame as any).title}</div>
            <div class="hero-score">
              <span class="hero-score-num">{(featuredGame as any).count}</span>
              <span class="hero-score-label">{(featuredGame as any).count === 1 ? 'review' : 'reviews'} today</span>
            </div>
            <a href={`/games/${(featuredGame as any).slug}`} class="hero-cta">Read reviews →</a>
          </div>
        </div>
      </div>
    )}

    {topRated.length > 0 && (
      <div class="section-block">
        <div class="section-block-header">
          <span class="section-block-title">Top Rated This Week</span>
          <a href="/search?sort=highest" class="section-block-link">See all →</a>
        </div>
        <div class="top-rated-scroll">
          {topRated.map((game: any) => (
            <a href={`/games/${game.slug}`} class="top-rated-card">
              <div class="top-rated-cover-wrap">
                {igdbImage(game.cover)
                  ? <img class="top-rated-cover" src={igdbImage(game.cover) ?? ''} alt={game.title} loading="lazy" />
                  : <div class="top-rated-cover-placeholder">🎮</div>
                }
                <div class={`top-rated-badge ${scoreColor(game.avg_score)}`}>
                  {game.avg_score.toFixed(1)}
                </div>
              </div>
              <div class="top-rated-info">
                <div class="top-rated-title">{game.title}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    {(genres ?? []).length > 0 && (
      <div class="genre-section">
        {(genres ?? [])
          .filter((g: any) => featuredGenres.some(n => g.name.toLowerCase().includes(n.toLowerCase())))
          .slice(0, 10)
          .map((g: any) => (
            <a href={`/search?tab=games&genre=${g.id}`} class="genre-chip">{g.name}</a>
          ))
        }
      </div>
    )}

    {isLoggedIn && (
      <div class="feed-tabs">
        <button class="feed-tab active" data-tab="recent">Recent</button>
        <button class="feed-tab" data-tab="following">Following</button>
      </div>
    )}

    <div id="tab-recent">
      {reviews.length === 0 ? (
        <div class="empty-state">
          <div class="empty-state-title">No reviews yet</div>
          <p>Be the first to review a game.</p>
        </div>
      ) : (
        reviews.map((review: any) => (
          <ReviewCard
            review={review}
            isLoggedIn={isLoggedIn}
            showReviewer={true}
            showGame={true}
            currentProfileId={currentProfile?.id ?? null}
          />
        ))
      )}
    </div>

    {isLoggedIn && (
      <div id="tab-following" style="display:none">
        {followingReviews.length === 0 ? (
          <div class="empty-state">
            <div class="empty-state-title">
              {followingReviews.length === 0 ? "Nothing here yet" : "Your feed is empty"}
            </div>
            <p>Follow reviewers to see their latest reviews here.</p>
            <a href="/search?tab=reviewers" class="empty-cta" style="display:inline-block;background:var(--accent);color:var(--accent-text);padding:10px 24px;border-radius:22px;font-size:14px;font-weight:500;margin-top:16px">Find reviewers</a>
          </div>
        ) : (
          followingReviews.map((review: any) => (
            <ReviewCard
              review={review}
              isLoggedIn={isLoggedIn}
              showReviewer={true}
              showGame={true}
              currentProfileId={currentProfile?.id ?? null}
              />
          ))
        )}
        <div style="padding:16px 20px;text-align:center">
          <a href="/following" style="font-size:13px;color:var(--text-tertiary)">View full feed →</a>
        </div>
      </div>
    )}
  </main>

  <!-- Composer overlay -->
  <div id="composerOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:150"></div>

  <!-- Composer modal -->
  <div id="composer" style="display:none;position:fixed;top:80px;left:50%;transform:translateX(-50%);width:520px;max-width:calc(100vw - 32px);background:var(--bg-card);border:1px solid var(--border);border-radius:16px;z-index:160;padding:24px;max-height:calc(100dvh - 100px);overflow-y:auto">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
      <div style="font-size:17px;font-weight:500;letter-spacing:-0.2px">Write a review</div>
      <button id="cancelComposer" style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--text-tertiary);line-height:1;padding:4px">×</button>
    </div>

    <!-- ── Post-review reveal card (hidden until submit succeeds) ── -->
    <div id="reviewResult" style="display:none;text-align:center;padding:8px 0 20px;animation:resultFadeIn 0.3s ease">
      <div id="resultCover" style="display:none;margin-bottom:14px">
        <img id="resultCoverImg" src="" alt="" style="width:64px;height:88px;object-fit:cover;border-radius:8px;border:1px solid var(--border)" />
      </div>
      <div id="resultGameTitle" style="font-size:15px;font-weight:500;color:var(--text-primary);margin-bottom:20px"></div>

      <!-- Score comparison row -->
      <div id="resultScoreRow" style="display:flex;align-items:center;justify-content:center;gap:0;margin-bottom:24px">
        <div style="text-align:center;padding:0 28px">
          <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-tertiary);margin-bottom:8px">Your score</div>
          <div id="resultUserScore" style="font-family:'DM Serif Display',serif;font-size:52px;line-height:1;color:var(--text-primary)"></div>
          <div style="font-size:12px;color:var(--text-tertiary);margin-top:5px">out of 10</div>
        </div>
        <div id="resultDivider" style="width:1px;height:72px;background:var(--border);flex-shrink:0"></div>
        <div id="resultCommunityCol" style="text-align:center;padding:0 28px">
          <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-tertiary);margin-bottom:8px">Community avg</div>
          <div id="resultCommunityScore" style="font-family:'DM Serif Display',serif;font-size:52px;line-height:1;color:var(--text-secondary)"></div>
          <div id="resultReviewCount" style="font-size:12px;color:var(--text-tertiary);margin-top:5px"></div>
        </div>
      </div>

      <!-- First-reviewer message (replaces score row when no prior reviews) -->
      <div id="resultFirstMsg" style="display:none;font-size:14px;color:var(--text-secondary);margin-bottom:24px;line-height:1.6;padding:0 8px"></div>

      <div style="display:flex;gap:8px;justify-content:center">
        <button id="resultClose" style="padding:10px 20px;border:1px solid var(--border);border-radius:10px;background:transparent;color:var(--text-secondary);font-size:14px;font-weight:500;font-family:inherit;cursor:pointer;transition:opacity 0.15s">Close</button>
        <a id="resultGameLink" href="#" style="padding:10px 20px;border-radius:10px;background:var(--accent);color:var(--accent-text);font-size:14px;font-weight:500;text-decoration:none;transition:opacity 0.15s">See all reviews →</a>
      </div>
    </div>

    <!-- ── Composer form (hidden after submit succeeds) ── -->
    <div id="composerFormContent">
    <div class="composer-field">
      <label class="composer-label">Game</label>
      <div class="autocomplete-wrap">
        <input type="text" id="gameSearch" class="composer-input" placeholder="Search for a game..." autocomplete="off" />
        <div class="autocomplete-results" id="gameResults"></div>
      </div>
      <input type="hidden" id="gameId" />
    </div>
    <div class="composer-field" style="margin-top:12px">
      <label class="composer-label">Score</label>
      <div style="display:flex;align-items:center;gap:8px">
        <input type="number" id="scoreVal" class="composer-input" placeholder="0.0" min="0.1" max="10" step="0.1" style="width:90px" />
        <span style="font-size:15px;color:var(--text-tertiary);font-family:'DM Serif Display',serif">/ 10</span>
      </div>
    </div>
    <div class="composer-field" style="margin-top:12px">
      <label class="composer-label">Title</label>
      <input type="text" id="reviewTitle" class="composer-input" placeholder="Sum it up in a line..." maxlength="120" />
    </div>
    <div class="composer-field" style="margin-top:12px">
      <label class="composer-label">Review</label>
      <textarea id="reviewBody" class="composer-textarea" placeholder="Write your review..." rows="4" maxlength="5000"></textarea>
      <div style="text-align:right;font-size:11px;color:var(--text-tertiary);margin-top:4px" id="charCount">0 / 5000</div>
    </div>
    <div class="composer-row" style="margin-top:12px">
      <div class="composer-field" style="flex:1">
        <label class="composer-label">Platform played on</label>
        <select id="platformSelect" class="composer-select">
          <option value="">Select platform...</option>
          {(platforms ?? []).map((p: any) => (
            <option value={p.id}>{p.name}</option>
          ))}
        </select>
      </div>
      <div class="composer-field" style="width:120px">
        <label class="composer-label">Hours played</label>
        <input type="number" id="hoursPlayed" class="composer-input" placeholder="0" min="0" max="9999" />
      </div>
    </div>
    <div class="composer-actions" style="margin-top:14px">
      <label class="spoiler-toggle">
        <input type="checkbox" id="spoilerCheck" />
        <span>Contains spoilers</span>
      </label>
      <div style="display:flex;gap:8px;margin-left:auto">
        <button class="composer-submit" id="submitReview">Post review</button>
      </div>
    </div>
    <div class="composer-error" id="composerError"></div>
    </div><!-- /composerFormContent -->
  </div>

  <script is:inline define:vars={{ isLoggedIn }}>
    function openComposer() {
      document.getElementById('composer').style.display = 'block'
      document.getElementById('composerOverlay').style.display = 'block'
      document.getElementById('gameSearch').focus()
      if (window.__lockScroll) window.__lockScroll()
    }

    function closeComposer() {
      document.getElementById('composer').style.display = 'none'
      document.getElementById('composerOverlay').style.display = 'none'
      if (window.__unlockScroll) window.__unlockScroll()
      resetComposer()
    }

    function resetComposer() {
      document.getElementById('gameSearch').value = ''
      document.getElementById('gameId').value = ''
      document.getElementById('reviewTitle').value = ''
      document.getElementById('reviewBody').value = ''
      document.getElementById('hoursPlayed').value = ''
      document.getElementById('scoreVal').value = ''
      document.getElementById('platformSelect').value = ''
      document.getElementById('spoilerCheck').checked = false
      document.getElementById('composerError').textContent = ''
      document.getElementById('charCount').textContent = '0 / 5000'
      document.getElementById('charCount').style.color = 'var(--text-tertiary)'
      document.getElementById('gameResults').classList.remove('open')
    }

    document.getElementById('openComposer').addEventListener('click', () => {
      if (!isLoggedIn) { window.location.href = '/signin'; return; }
      openComposer()
    })

    document.querySelectorAll('.feed-tab').forEach(function(btn) {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.feed-tab').forEach(function(b) { b.classList.remove('active') })
        btn.classList.add('active')
        var tab = btn.dataset.tab
        document.getElementById('tab-recent').style.display = tab === 'recent' ? '' : 'none'
        var followingEl = document.getElementById('tab-following')
        if (followingEl) followingEl.style.display = tab === 'following' ? '' : 'none'
      })
    })

    document.getElementById('cancelComposer').addEventListener('click', closeComposer)
    document.getElementById('composerOverlay').addEventListener('click', closeComposer)

    document.getElementById('reviewBody').addEventListener('input', function() {
      const count = this.value.length
      const el = document.getElementById('charCount')
      el.textContent = count + ' / 5000'
      el.style.color = count > 4500 ? (count >= 5000 ? '#c0392b' : '#e67e22') : 'var(--text-tertiary)'
    })

    document.querySelectorAll('.review-body[data-spoiler="true"]').forEach(el => {
      el.addEventListener('click', () => el.classList.remove('spoiler-hidden'))
    })

    let searchTimeout
    document.getElementById('gameSearch').addEventListener('input', (e) => {
      clearTimeout(searchTimeout)
      const q = e.target.value.trim()
      if (q.length < 2) { document.getElementById('gameResults').classList.remove('open'); return; }
      searchTimeout = setTimeout(() => searchGames(q), 300)
    })

    document.addEventListener('click', (e) => {
      if (!e.target.closest('.autocomplete-wrap')) {
        document.getElementById('gameResults').classList.remove('open')
      }
    })

    async function searchGames(q) {
      const res = await fetch('/api/games/search?q=' + encodeURIComponent(q))
      const games = await res.json()
      const results = document.getElementById('gameResults')
      results.innerHTML = ''
      if (!games.length) {
        results.innerHTML = '<div class="autocomplete-item" style="color:var(--text-tertiary)">No games found</div>'
      } else {
        games.forEach(game => {
          const item = document.createElement('div')
          item.className = 'autocomplete-item'
          item.innerHTML = '<div><div class="autocomplete-item-title">' + game.title + '</div>'
            + (game.source === 'igdb' ? '<div style="font-size:11px;color:var(--text-tertiary);margin-top:2px">Add to Chekpoint</div>' : '')
            + '</div>'
          item.addEventListener('click', () => {
            document.getElementById('gameSearch').value = game.title
            results.classList.remove('open')
            if (game.source === 'igdb') {
              document.getElementById('gameId').value = ''
              document.getElementById('composerError').textContent = 'Importing game...'
              fetch('/api/games/import', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ igdb_id: game.igdb_id }),
              })
                .then(async r => {
                  const data = await r.json()
                  if (!r.ok) {
                    document.getElementById('composerError').textContent =
                      data.error ?? 'Failed to import game, try again.'
                    return
                  }
                  document.getElementById('gameId').value = data.id
                  document.getElementById('composerError').textContent = ''
                  fetchGamePlatforms(data.id)
                })
                .catch(() => {
                  document.getElementById('composerError').textContent = 'Failed to import game, try again.'
                })
            } else {
              document.getElementById('gameId').value = game.id
              fetchGamePlatforms(game.id)
            }
          })
          results.appendChild(item)
        })
      }
      results.classList.add('open')
    }

    async function fetchGamePlatforms(gameId) {
      const select = document.getElementById('platformSelect')
      select.innerHTML = '<option value="">Loading...</option>'
      const res = await fetch('/api/games/platforms?id=' + gameId)
      const platforms = await res.json()
      if (platforms.length === 0) {
        select.innerHTML = '<option value="">Any platform</option>'
      } else {
        select.innerHTML = '<option value="">Select platform...</option>' +
          platforms.map(p => `<option value="${p.id}">${p.name}</option>`).join('')
      }
    }

    document.getElementById('submitReview').addEventListener('click', async () => {
      const gameId = document.getElementById('gameId').value
      const score = document.getElementById('scoreVal').value
      const title = document.getElementById('reviewTitle').value.trim()
      const body = document.getElementById('reviewBody').value.trim()
      const platformId = document.getElementById('platformSelect').value
      const hours = document.getElementById('hoursPlayed').value
      const spoilers = document.getElementById('spoilerCheck').checked
      const errorEl = document.getElementById('composerError')

      errorEl.textContent = ''
      if (!gameId) { errorEl.textContent = 'Please select a game.'; return; }
      if (!score || parseFloat(score) < 0.1 || parseFloat(score) > 10) { errorEl.textContent = 'Please enter a score between 0.1 and 10.'; return; }
      if (!title) { errorEl.textContent = 'Please add a title.'; return; }
      if (!body) { errorEl.textContent = 'Please write a review.'; return; }
      if (body.length > 5000) { errorEl.textContent = 'Review must be at most 5000 characters.'; return; }
      if (!hours || parseInt(hours) < 1 || parseInt(hours) > 25000) { errorEl.textContent = 'You must have at least 1 hour played to submit a review.'; return; }

      const btn = document.getElementById('submitReview')
      btn.disabled = true
      btn.textContent = 'Posting...'

      const res = await fetch('/api/reviews/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          game_id: gameId,
          score: parseFloat(score),
          title,
          body,
          platform_played_on: platformId || null,
          play_time_hours: hours ? parseInt(hours) : null,
          contains_spoilers: spoilers,
        }),
      })

      const data = await res.json()
      if (!res.ok) {
        errorEl.textContent = data.error ?? 'Something went wrong.'
        btn.disabled = false
        btn.textContent = 'Post review'
      } else {
        if (typeof gtag === 'function') {
          gtag('event', 'review_posted', {
            game_title: document.getElementById('gameSearch').value,
            score: parseFloat(score),
          });
        }

        // ── Show post-review reveal card ──
        const userScore = parseFloat(score)
        const gameTitle = document.getElementById('gameSearch').value
        const { gameSlug, gameCover, communityAvg, reviewCount } = data

        // Populate card
        document.getElementById('resultGameTitle').textContent = gameTitle
        document.getElementById('resultUserScore').textContent = userScore.toFixed(1)
        if (gameSlug) document.getElementById('resultGameLink').href = '/games/' + gameSlug

        if (gameCover) {
          const img = document.getElementById('resultCoverImg')
          img.src = gameCover.startsWith('//') ? 'https:' + gameCover : gameCover
          img.src = img.src.replace(/t_[a-z0-9_]+/, 't_cover_big')
          img.alt = gameTitle
          document.getElementById('resultCover').style.display = 'block'
        }

        if (reviewCount > 1) {
          // Show comparison
          document.getElementById('resultCommunityScore').textContent = communityAvg.toFixed(1)
          document.getElementById('resultReviewCount').textContent =
            'from ' + reviewCount + ' review' + (reviewCount !== 1 ? 's' : '')
        } else {
          // First reviewer — hide comparison, show message
          document.getElementById('resultScoreRow').style.justifyContent = 'center'
          document.getElementById('resultDivider').style.display = 'none'
          document.getElementById('resultCommunityCol').style.display = 'none'
          document.getElementById('resultFirstMsg').style.display = 'block'
          // Weighted random picker — increase a weight to make that line appear more often. Set weight to 0 to "retire" line without deleting it, for stats or future reuse.
        const firstReviewerSuffixes = [
          { text: 'Nice.',                                              weight: 1 },
          { text: 'Achievement unlocked.',                              weight: 1 },
          { text: 'Save point established.',                            weight: 1 },
          { text: 'Pioneer behavior.',                                  weight: 1 },
          { text: 'You set the benchmark.',                             weight: 1 },
          { text: 'Someone had to go first.',                           weight: 1 },
          { text: 'History is written by the first reviewer. Probably.',weight: 1 },
          { text: 'Is anyone out there?',                               weight: 1 },
          { text: 'The record shows it.',                               weight: 1 },
          { text: 'It is written.',                                     weight: 1 },
          { text: 'Here I am. Here I remain.',                          weight: 1 },
          { text: 'The reviews must flow.',                             weight: 1 },
          { text: 'Never tell me the odds.',                            weight: 1 },
          { text: 'Stay a while and listen.',                           weight: 1 },
          { text: 'Gorp gorp gorp.',                                    weight: 1 },
          { text: 'So it begins.',                                    weight: 1 },
        ]
        function pickWeighted(items) {
          const total = items.reduce((sum, m) => sum + m.weight, 0)
          let r = Math.random() * total
          for (const m of items) { r -= m.weight; if (r <= 0) return m.text }
          return items[items.length - 1].text
        }
        const suffix = pickWeighted(firstReviewerSuffixes)
        document.getElementById('resultFirstMsg').textContent =
            'You\'re the first person to review ' + gameTitle + ' on Chekpoint. ' + suffix
        }

        // Swap form for result card
        document.getElementById('composerFormContent').style.display = 'none'
        document.getElementById('reviewResult').style.display = 'block'

        // Wire up close button — reload feed on dismiss
        document.getElementById('resultClose').addEventListener('click', () => {
          closeComposer()
          window.location.reload()
        })
        // Navigating to game page also counts as a clean exit
        document.getElementById('resultGameLink').addEventListener('click', () => {
          if (window.__unlockScroll) window.__unlockScroll()
        })
      }
    })


  </script>

  <ReportModal />
  <EditModal />

  <div slot="sidebar-right">
    {isLoggedIn && lastReview && (
      <div class="widget">
        <div class="widget-title">Your last review</div>
        <a href={`/games/${lastReview.games?.slug}`} style="display:flex;gap:12px;align-items:flex-start;text-decoration:none">
          <div style="flex-shrink:0;width:52px;height:70px;border-radius:8px;overflow:hidden;background:var(--tag-bg);border:1px solid var(--border)">
            {lastReview.games?.cover_img_url
              ? <img src={igdbImage(lastReview.games.cover_img_url) ?? ''} alt={lastReview.games.title} style="width:100%;height:100%;object-fit:cover" />
              : <span style="display:flex;align-items:center;justify-content:center;height:100%;font-size:22px">🎮</span>
            }
          </div>
          <div style="flex:1;min-width:0">
            <div style="font-size:13px;font-weight:500;line-height:1.3;margin-bottom:6px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical">{lastReview.games?.title}</div>
            <div class={`score-badge ${scoreColor(lastReview.score)}`} style="width:32px;height:32px;border-radius:7px;display:inline-flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;font-family:'DM Serif Display',serif;margin-bottom:6px">{lastReview.score}</div>
            {lastReview.title && <div style="font-size:12px;color:var(--text-secondary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{lastReview.title}</div>}
            <div style="font-size:11px;color:var(--text-tertiary);margin-top:3px">{timeAgo(lastReview.published_at ?? lastReview.created_at)} ago</div>
          </div>
        </a>
      </div>
    )}

    <div class="widget" style="margin-top:4px">
      <div class="widget-title">Trending this week</div>
      {trending.length === 0 ? (
        <div style="font-size:13px;color:var(--text-tertiary)">No activity yet this week.</div>
      ) : (
        trending.map((game, i) => (
          <a href={`/games/${game.slug}`} class="trending-item" style="display:flex">
            <span class="trending-rank" style="padding-top:4px">{i + 1}</span>
            <div class="trending-cover">
              {game.cover
                ? <img src={igdbImage(game.cover, 't_cover_big') ?? ''} alt={game.title} />
                : <span style="font-size:20px;display:flex;align-items:center;justify-content:center;height:100%">🎮</span>
              }
            </div>
            <div class="trending-info">
              <div class="trending-game">{game.title}</div>
              <div class="trending-count">{game.count} review{game.count !== 1 ? 's' : ''} this week</div>
            </div>
          </a>
        ))
      )}
    </div>

    <div class="widget" style="margin-top:4px">
      <div class="widget-title">Site stats</div>
      <div class="stat-row">
        <span class="stat-label">Total reviews</span>
        <span class="stat-value">{formatCount(totalReviews)}</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Games tracked</span>
        <span class="stat-value">{formatCount(totalGames)}</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Reviewers</span>
        <span class="stat-value">{formatCount(totalReviewers)}</span>
      </div>
    </div>
  </div>

</Layout>

