---
export const prerender = false;
import { createSupabaseServerClientFromContext } from '../utils/database';
import Layout from '../components/Layout.astro';

const serverClient = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await serverClient.auth.getUser();
const isLoggedIn = !!user;

let currentProfile: { id: string; username: string; avatar_url: string | null } | null = null;
let followingProfiles: any[] = [];

if (user) {
  const { data: cpData } = await serverClient
    .from('profiles')
    .select('id, username, avatar_url')
    .eq('auth_user_id', user.id)
    .single();
  currentProfile = cpData;

  if (currentProfile) {
    const { data: followRows } = await serverClient
      .from('follows')
      .select('following_id')
      .eq('follower_id', currentProfile.id);

    const followingIds = (followRows ?? []).map((r: any) => r.following_id);

    if (followingIds.length > 0) {
      const { data: fProfiles } = await serverClient
        .from('profiles')
        .select('id, username, avatar_url')
        .in('id', followingIds);
      followingProfiles = (fProfiles ?? []) as any[];
    }
  }
}

---

<Layout
  title="Following — Chekpoint"
  isLoggedIn={isLoggedIn}
  currentProfile={currentProfile}
  activeNav="following"
>
  <main class="feed">
    <div class="feed-header">
      <div>
        <div class="feed-title">Following</div>
        <div class="feed-subtitle">
          {!isLoggedIn
            ? 'Sign in to see who you follow'
            : followingProfiles.length > 0
            ? `${followingProfiles.length} reviewer${followingProfiles.length !== 1 ? 's' : ''}`
            : "You aren't following anyone yet"
          }
        </div>
      </div>
    </div>

    {!isLoggedIn ? (
      <div class="empty-state">
        <div class="empty-state-title">Sign in to see who you follow</div>
        <a href="/signin" class="empty-cta">Sign in</a>
      </div>
    ) : followingProfiles.length === 0 ? (
      <div class="empty-state">
        <div class="empty-state-title">You aren't following anyone yet</div>
        <p>Find reviewers and follow them to build your feed.</p>
        <a href="/search?tab=reviewers" class="empty-cta">Find reviewers</a>
      </div>
    ) : (
      <div class="following-list">
        {followingProfiles.map((profile: any) => (
          <div class="following-row">
            <a href={`/reviewers/${profile.username}`} class="following-user">
              {profile.avatar_url
                ? <img class="following-avatar" src={profile.avatar_url} alt={profile.username} />
                : <div class="following-avatar-placeholder">{profile.username[0].toUpperCase()}</div>
              }
              <span class="following-username">{profile.username}</span>
            </a>
            <button
              class="follow-btn following"
              data-reviewer-id={profile.id}
              data-following="true"
            >Following</button>
          </div>
        ))}
      </div>
    )}
  </main>

  <div slot="sidebar-right">
    {isLoggedIn && (
      <div class="widget">
        <div class="widget-title">Discover reviewers</div>
        <p style="font-size:13px;color:var(--text-secondary);line-height:1.6;margin-bottom:12px">
          Find reviewers with similar tastes and follow them to build your feed.
        </p>
        <a href="/search?tab=reviewers" style="display:inline-block;background:var(--accent);color:var(--accent-text);padding:8px 18px;border-radius:20px;font-size:13px;font-weight:500">
          Browse reviewers
        </a>
      </div>
    )}
  </div>
</Layout>

<script>
  document.querySelectorAll('.follow-btn').forEach(function(btn: any) {
    btn.addEventListener('mouseenter', function() {
      if (btn.dataset.following === 'true') btn.textContent = 'Unfollow'
    })
    btn.addEventListener('mouseleave', function() {
      if (btn.dataset.following === 'true') btn.textContent = 'Following'
    })
    btn.addEventListener('click', async function() {
      var reviewerId = btn.dataset.reviewerId
      var currentlyFollowing = btn.dataset.following === 'true'
      btn.disabled = true
      var res = await fetch('/api/follows/toggle', {
        method: currentlyFollowing ? 'DELETE' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ following_id: reviewerId }),
      })
      if (res.ok) {
        var nowFollowing = !currentlyFollowing
        btn.dataset.following = nowFollowing ? 'true' : 'false'
        btn.textContent = nowFollowing ? 'Following' : '+ Follow'
        btn.className = 'follow-btn ' + (nowFollowing ? 'following' : 'not-following')
        if (!nowFollowing) {
          var row = btn.closest('.following-row')
          if (row) row.remove()
          var list = document.querySelector('.following-list')
          if (list && !list.querySelector('.following-row')) {
            list.innerHTML = '<div class="empty-state"><div class="empty-state-title">You aren\'t following anyone yet</div><p>Find reviewers and follow them to build your feed.</p></div>'
          }
        }
      }
      btn.disabled = false
    })
  })
</script>

<style>
  .following-list { padding: 8px 0; }
  .following-row { display: flex; align-items: center; justify-content: space-between; padding: 10px 20px; border-bottom: 1px solid var(--border-subtle); transition: background 0.15s; }
  .following-row:last-child { border-bottom: none; }
  .following-row:hover { background: var(--bg-hover); }
  .following-user { display: flex; align-items: center; gap: 12px; text-decoration: none; flex: 1; min-width: 0; }
  .following-avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 1px solid var(--border); }
  .following-avatar-placeholder { width: 40px; height: 40px; border-radius: 50%; background: var(--tag-bg); border: 1px solid var(--border); flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 600; color: var(--text-secondary); }
  .following-username { font-size: 14px; font-weight: 500; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .follow-btn { padding: 7px 16px; border-radius: 20px; font-size: 13px; font-weight: 500; font-family: inherit; cursor: pointer; transition: all 0.15s; }
  .follow-btn.not-following { background: var(--accent); color: var(--accent-text); border: none; }
  .follow-btn.not-following:hover { opacity: 0.88; }
  .follow-btn.following { background: var(--tag-bg); color: var(--text-secondary); border: 1px solid var(--border); }
  .follow-btn.following:hover { border-color: #c0392b; color: #c0392b; }
  .follow-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .empty-cta {
    display: inline-block;
    background: var(--accent);
    color: var(--accent-text);
    padding: 10px 24px;
    border-radius: 22px;
    font-size: 14px;
    font-weight: 500;
    transition: opacity 0.15s;
    margin-top: 16px;
  }
  .empty-cta:hover { opacity: 0.85; }
</style>
