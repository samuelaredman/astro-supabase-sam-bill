---
export const prerender = false;
import { getSupabase, createSupabaseServerClient } from '../utils/database';
import Layout from '../components/Layout.astro';
import ReportModal from '../components/ReportModal.astro';

const supabase = getSupabase();
const serverClient = createSupabaseServerClient(Astro.request, new Response());
const { data: { session } } = await serverClient.auth.getSession();
const isLoggedIn = !!session;

const sortBy = Astro.url.searchParams.get('sort') || 'recent';

let currentProfile: { id: string; username: string; avatar_url: string | null } | null = null;
let followingReviews: any[] = [];
let followingCount = 0;

if (session?.user) {
  const { data: cpData } = await (supabase as any)
    .from('profiles')
    .select('id, username, avatar_url')
    .eq('auth_user_id', session.user.id)
    .single();
  currentProfile = cpData;

  if (currentProfile) {
    const { data: followRows } = await (supabase as any)
      .from('follows')
      .select('following_id')
      .eq('follower_id', currentProfile.id);

    const followingIds = (followRows ?? []).map((r: any) => r.following_id);
    followingCount = followingIds.length;

    if (followingIds.length > 0) {
      let query = (supabase as any)
        .from('reviews')
        .select(`
          id, score, title, body, play_time_hours,
          contains_spoilers, status, published_at, created_at,
          played_on:platform_played_on ( id, name, slug ),
          games ( id, title, slug, cover_img_url ),
          profiles ( id, username, avatar_url ),
          review_votes( vote )
        `)
        .eq('status', 'published')
        .in('profile_id', followingIds)
        .limit(50);

      query = query.order('published_at', { ascending: false });

      const { data: fRevs } = await query;
      followingReviews = (fRevs ?? []) as any[];

      if (sortBy === 'highest') {
        followingReviews.sort((a: any, b: any) => b.score - a.score);
      } else if (sortBy === 'lowest') {
        followingReviews.sort((a: any, b: any) => a.score - b.score);
      } else if (sortBy === 'top') {
        followingReviews.sort((a: any, b: any) => {
          const aVotes = Array.isArray(a.review_votes) ? a.review_votes : [];
          const bVotes = Array.isArray(b.review_votes) ? b.review_votes : [];
          const aUp = aVotes.filter((v: any) => v.vote === 1).length;
          const bUp = bVotes.filter((v: any) => v.vote === 1).length;
          return bUp - aUp;
        });
      }
    }
  }
}

let lastReview: any = null;
if (currentProfile) {
  const { data: lr } = await (supabase as any)
    .from('reviews')
    .select(`
      id, score, published_at, created_at, title,
      games ( id, title, slug, cover_img_url )
    `)
    .eq('profile_id', currentProfile.id)
    .eq('status', 'published')
    .order('published_at', { ascending: false })
    .limit(1)
    .single();
  lastReview = lr ?? null;
}

function igdbImage(url: string | null, size = 't_cover_big') {
  if (!url) return null;
  const clean = url.startsWith('//') ? `https:${url}` : url;
  return clean.replace(/t_[a-z_]+/, size);
}

function timeAgo(dateStr: string): string {
  const diff = Math.floor((Date.now() - new Date(dateStr).getTime()) / 1000);
  if (diff < 60) return `${diff}s`;
  if (diff < 3600) return `${Math.floor(diff / 60)}m`;
  if (diff < 86400) return `${Math.floor(diff / 3600)}h`;
  if (diff < 604800) return `${Math.floor(diff / 86400)}d`;
  return `${Math.floor(diff / 604800)}w`;
}

function scoreColor(score: number): string {
  if (score === 10) return 'score-perfect';
  if (score >= 9) return 'score-great';
  if (score >= 8) return 'score-teal';
  if (score >= 7) return 'score-good';
  if (score >= 5) return 'score-mid';
  if (score >= 3) return 'score-orange';
  return 'score-low';
}

function getInitials(username: string): string {
  return username.slice(0, 2).toUpperCase();
}

function getVoteCounts(votes: any) {
  const arr = Array.isArray(votes) ? votes : votes ? [votes] : [];
  const up = arr.filter((v: any) => v.vote === 1).length;
  const down = arr.filter((v: any) => v.vote === -1).length;
  return { up, down };
}
---

<Layout
  title="Following — Chekpoint"
  isLoggedIn={isLoggedIn}
  currentProfile={currentProfile}
  activeNav="following"
>
  <main class="feed">
    <div class="feed-header">
      <div>
        <div class="feed-title">Following</div>
        <div class="feed-subtitle">
          {!isLoggedIn
            ? 'Sign in to see your feed'
            : followingReviews.length > 0
            ? `${followingReviews.length} review${followingReviews.length !== 1 ? 's' : ''} from ${followingCount} reviewer${followingCount !== 1 ? 's' : ''} you follow`
            : followingCount > 0
            ? 'No reviews from people you follow yet'
            : "You aren't following anyone yet"
          }
        </div>
      </div>
    </div>

    {!isLoggedIn ? (
      <div class="empty-state">
        <div class="empty-state-title">Sign in to see your feed</div>
        <p>Follow reviewers to see their latest reviews here.</p>
        <a href="/signin" class="empty-cta">Sign in</a>
      </div>
    ) : followingCount === 0 ? (
      <div class="empty-state">
        <div class="empty-state-title">Your feed is empty</div>
        <p>You're not following anyone yet. Find reviewers and follow them to see their reviews here.</p>
        <a href="/search?tab=reviewers" class="empty-cta">Find reviewers</a>
      </div>
    ) : followingReviews.length === 0 ? (
      <div class="empty-state">
        <div class="empty-state-title">Nothing here yet</div>
        <p>The {followingCount} reviewer{followingCount !== 1 ? 's' : ''} you follow haven't posted any reviews yet.</p>
        <a href="/search?tab=reviewers" class="empty-cta">Find more reviewers</a>
      </div>
    ) : (
      <>
        <div class="sort-bar">
          <a href="/following?sort=recent" class={`sort-btn ${sortBy === 'recent' ? 'active' : ''}`}>Recent</a>
          <a href="/following?sort=top" class={`sort-btn ${sortBy === 'top' ? 'active' : ''}`}>Top voted</a>
          <a href="/following?sort=highest" class={`sort-btn ${sortBy === 'highest' ? 'active' : ''}`}>Highest score</a>
          <a href="/following?sort=lowest" class={`sort-btn ${sortBy === 'lowest' ? 'active' : ''}`}>Lowest score</a>
        </div>

        {followingReviews.map((review: any) => {
          const { up, down } = getVoteCounts(review.review_votes);
          return (
            <article class="review-card">
              <div class="card-top">
                <a href={`/reviewers/${review.profiles?.username}`} style="flex-shrink:0">
                  <div class="avatar">
                    {review.profiles?.avatar_url
                      ? <img src={review.profiles.avatar_url} alt={review.profiles?.username} />
                      : <span>{getInitials(review.profiles?.username ?? '?')}</span>
                    }
                  </div>
                </a>
                <div class="card-body">
                  <div class="card-meta">
                    <a href={`/reviewers/${review.profiles?.username}`} class="username">@{review.profiles?.username}</a>
                    <span class="meta-dot">·</span>
                    <span class="timestamp">{timeAgo(review.published_at ?? review.created_at)}</span>
                  </div>
                  <div class="game-row">
                    <a href={`/games/${review.games?.slug}`} class="game-cover-sm">
                      {review.games?.cover_img_url
                        ? <img src={igdbImage(review.games.cover_img_url, 't_thumb') ?? ''} alt={review.games?.title} />
                        : '🎮'
                      }
                    </a>
                    <a href={`/games/${review.games?.slug}`} class="game-title-text">{review.games?.title ?? 'Unknown Game'}</a>
                    <div class={`score-badge ${scoreColor(review.score)}`}>{review.score}</div>
                  </div>
                  {review.contains_spoilers && <div class="spoiler-pill">⚠ spoilers</div>}
                  {review.title && <div class="review-title">{review.title}</div>}
                  <div
                    class={`review-body ${review.contains_spoilers ? 'spoiler-hidden' : ''}`}
                    data-spoiler={review.contains_spoilers ? 'true' : 'false'}
                  >
                    {review.body}
                  </div>
                  <div class="card-footer">
                    {review.played_on && <span class="footer-tag">{review.played_on.name}</span>}
                    {review.play_time_hours > 0 && <span class="footer-tag">{review.play_time_hours}h played</span>}
                    <a href={`/reviews/${review.id}`} class="read-more">Read more →</a>
                  </div>
                  <div class="vote-row">
                    <button class="vote-btn" data-review-id={review.id} data-vote="1" data-count={up}>▲ {up}</button>
                    <button class="vote-btn" data-review-id={review.id} data-vote="-1" data-count={down}>▼ {down}</button>
                    {isLoggedIn && (
                      <button class="report-trigger" onclick={`openReport('review','${review.id}')`} title="Report">
                        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2h10l-2 4 2 4H3V2z"/><path d="M3 14v-4"/></svg>
                      </button>
                    )}
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </>
    )}
  </main>

  <div slot="sidebar-right">
    {isLoggedIn && lastReview && (
      <div class="widget">
        <div class="widget-title">Your last review</div>
        <a href={`/games/${lastReview.games?.slug}`} style="display:flex;gap:12px;align-items:flex-start;text-decoration:none">
          <div style="flex-shrink:0;width:52px;height:70px;border-radius:8px;overflow:hidden;background:var(--tag-bg);border:1px solid var(--border)">
            {lastReview.games?.cover_img_url
              ? <img src={igdbImage(lastReview.games.cover_img_url) ?? ''} alt={lastReview.games.title} style="width:100%;height:100%;object-fit:cover" />
              : <span style="display:flex;align-items:center;justify-content:center;height:100%;font-size:22px">🎮</span>
            }
          </div>
          <div style="flex:1;min-width:0">
            <div style="font-size:13px;font-weight:500;line-height:1.3;margin-bottom:6px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical">{lastReview.games?.title}</div>
            <div class={`score-badge ${scoreColor(lastReview.score)}`} style="width:32px;height:32px;border-radius:7px;display:inline-flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;font-family:'DM Serif Display',serif;margin-bottom:6px">{lastReview.score}</div>
            {lastReview.title && <div style="font-size:12px;color:var(--text-secondary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{lastReview.title}</div>}
            <div style="font-size:11px;color:var(--text-tertiary);margin-top:3px">{timeAgo(lastReview.published_at ?? lastReview.created_at)} ago</div>
          </div>
        </a>
      </div>
    )}
    {isLoggedIn && followingCount > 0 && (
      <div class="widget">
        <div class="widget-title">Your feed</div>
        <div class="stat-row">
          <span class="stat-label">Following</span>
          <span class="stat-value">{followingCount}</span>
        </div>
        <div class="stat-row">
          <span class="stat-label">Reviews in feed</span>
          <span class="stat-value">{followingReviews.length}</span>
        </div>
      </div>
    )}
    {isLoggedIn && (
      <div class="widget">
        <div class="widget-title">Discover reviewers</div>
        <p style="font-size:13px;color:var(--text-secondary);line-height:1.6;margin-bottom:12px">
          Find reviewers with similar tastes and follow them to build your feed.
        </p>
        <a href="/search?tab=reviewers" style="display:inline-block;background:var(--accent);color:var(--accent-text);padding:8px 18px;border-radius:20px;font-size:13px;font-weight:500">
          Browse reviewers
        </a>
      </div>
    )}
  </div>

  <script is:inline>
    document.querySelectorAll('.review-body[data-spoiler="true"]').forEach(el => {
      el.addEventListener('click', () => el.classList.remove('spoiler-hidden'));
    });

    document.querySelectorAll('.vote-btn').forEach(function(btn) {
      btn.addEventListener('click', async function() {
        const reviewId = btn.dataset.reviewId;
        const vote = parseInt(btn.dataset.vote);
        const res = await fetch('/api/reviews/vote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ review_id: reviewId, vote }),
        });
        if (res.status === 401) { window.location.href = '/signin'; return; }
        if (!res.ok) return;
        const data = await res.json();
        const pair = document.querySelectorAll('.vote-btn[data-review-id="' + reviewId + '"]');
        pair.forEach(function(b) {
          const bVote = parseInt(b.dataset.vote);
          let count = parseInt(b.dataset.count) || 0;
          if (data.vote === null) {
            b.classList.remove('active-up', 'active-down');
            if (bVote === vote) count = Math.max(0, count - 1);
          } else if (data.vote === bVote) {
            b.classList.add(bVote === 1 ? 'active-up' : 'active-down');
            b.classList.remove(bVote === 1 ? 'active-down' : 'active-up');
            count = count + 1;
          } else {
            b.classList.remove('active-up', 'active-down');
            if (data.vote !== null) count = Math.max(0, count - 1);
          }
          b.dataset.count = count;
          b.textContent = (bVote === 1 ? '▲ ' : '▼ ') + count;
        });
      });
    });
  </script>

  <ReportModal />
</Layout>

<style>
  .sort-bar {
    display: flex;
    gap: 6px;
    padding: 12px 20px;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-card);
    position: sticky;
    top: 73px;
    z-index: 9;
  }
  .sort-btn {
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    font-family: inherit;
    color: var(--text-secondary);
    background: var(--tag-bg);
    border: 1px solid var(--border);
    cursor: pointer;
    transition: all 0.15s;
    text-decoration: none;
    display: inline-block;
  }
  .sort-btn:hover { color: var(--text-primary); background: var(--bg-hover); }
  .sort-btn.active { background: var(--accent); color: var(--accent-text); border-color: var(--accent); }

  .empty-cta {
    display: inline-block;
    background: var(--accent);
    color: var(--accent-text);
    padding: 10px 24px;
    border-radius: 22px;
    font-size: 14px;
    font-weight: 500;
    transition: opacity 0.15s;
    margin-top: 16px;
  }
  .empty-cta:hover { opacity: 0.85; }

  .username { font-size: 14px; font-weight: 500; }
  .username:hover { text-decoration: underline; }
  .meta-dot { color: var(--text-tertiary); font-size: 12px; }
  .report-trigger {
    margin-left: auto;
    display: flex;
    align-items: center;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-tertiary);
    padding: 4px 6px;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
  }
  .report-trigger:hover { color: #f87171; background: rgba(248, 113, 113, 0.08); }
</style>
