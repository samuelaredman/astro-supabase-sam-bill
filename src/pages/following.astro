---
export const prerender = false;
import { getSupabase, createSupabaseServerClient } from '../utils/database';

const supabase = getSupabase();
const serverClient = createSupabaseServerClient(Astro.request, new Response());
const { data: { session } } = await serverClient.auth.getSession();
const isLoggedIn = !!session;

const sortBy = Astro.url.searchParams.get('sort') || 'recent';

let currentProfile: { id: string; username: string; avatar_url: string | null } | null = null;
let followingReviews: any[] = [];
let followingCount = 0;

if (session?.user) {
  const { data: cpData } = await (supabase as any)
    .from('profiles')
    .select('id, username, avatar_url')
    .eq('auth_user_id', session.user.id)
    .single();
  currentProfile = cpData;

  if (currentProfile) {
    const { data: followRows } = await (supabase as any)
      .from('follows')
      .select('following_id')
      .eq('follower_id', currentProfile.id);

    const followingIds = (followRows ?? []).map((r: any) => r.following_id);
    followingCount = followingIds.length;

    if (followingIds.length > 0) {
      let query = (supabase as any)
        .from('reviews')
        .select(`
          id, score, title, body, play_time_hours,
          contains_spoilers, status, published_at, created_at,
          played_on:platform_played_on ( id, name, slug ),
          games ( id, title, slug, cover_img_url ),
          profiles ( id, username, avatar_url ),
          review_votes( vote )
        `)
        .eq('status', 'published')
        .in('profile_id', followingIds)
        .limit(50);

      if (sortBy === 'recent') {
        query = query.order('published_at', { ascending: false });
      } else {
        // for vote/score sorts we fetch all and sort client-side below
        query = query.order('published_at', { ascending: false });
      }

      const { data: fRevs } = await query;
      followingReviews = (fRevs ?? []) as any[];

      // sort by score or votes server results
      if (sortBy === 'highest') {
        followingReviews.sort((a: any, b: any) => b.score - a.score);
      } else if (sortBy === 'lowest') {
        followingReviews.sort((a: any, b: any) => a.score - b.score);
      } else if (sortBy === 'top') {
        followingReviews.sort((a: any, b: any) => {
          const aVotes = Array.isArray(a.review_votes) ? a.review_votes : [];
          const bVotes = Array.isArray(b.review_votes) ? b.review_votes : [];
          const aUp = aVotes.filter((v: any) => v.vote === 1).length;
          const bUp = bVotes.filter((v: any) => v.vote === 1).length;
          return bUp - aUp;
        });
      }
    }
  }
}

// last game the current user reviewed
let lastReview: any = null
if (currentProfile) {
  const { data: lr } = await (supabase as any)
    .from('reviews')
    .select(`
      id, score, published_at, created_at, title,
      games ( id, title, slug, cover_img_url )
    `)
    .eq('profile_id', currentProfile.id)
    .eq('status', 'published')
    .order('published_at', { ascending: false })
    .limit(1)
    .single()
  lastReview = lr ?? null
}

function igdbImage(url: string | null, size = 't_cover_big') {
  if (!url) return null;
  const clean = url.startsWith('//') ? `https:${url}` : url;
  return clean.replace(/t_[a-z_]+/, size);
}

function timeAgo(dateStr: string): string {
  const diff = Math.floor((Date.now() - new Date(dateStr).getTime()) / 1000);
  if (diff < 60) return `${diff}s`;
  if (diff < 3600) return `${Math.floor(diff / 60)}m`;
  if (diff < 86400) return `${Math.floor(diff / 3600)}h`;
  if (diff < 604800) return `${Math.floor(diff / 86400)}d`;
  return `${Math.floor(diff / 604800)}w`;
}

function scoreColor(score: number): string {
  if (score >= 9) return 'score-great';
  if (score >= 7) return 'score-good';
  if (score >= 5) return 'score-mid';
  return 'score-low';
}

function getInitials(username: string): string {
  return username.slice(0, 2).toUpperCase();
}

function getVoteCounts(votes: any) {
  const arr = Array.isArray(votes) ? votes : votes ? [votes] : [];
  const up = arr.filter((v: any) => v.vote === 1).length;
  const down = arr.filter((v: any) => v.vote === -1).length;
  return { up, down };
}
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Following — Chekpoint</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet" />
  <style>
    :root[data-theme="light"] {
      --bg: #f9f8f6; --bg-card: #ffffff; --bg-hover: #f4f3f0; --bg-sidebar: #ffffff;
      --border: #e8e6e1; --border-subtle: #f0ede8;
      --text-primary: #141412; --text-secondary: #6b6860; --text-tertiary: #a09d98;
      --accent: #141412; --accent-text: #ffffff; --logo-color: #141412;
      --tag-bg: #f0ede8; --tag-text: #6b6860;
      --shadow: 0 1px 3px rgba(0,0,0,0.06); --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
      --score-perfect: #ffffff; --score-perfect-bg: #1a1a2e;
      --score-great: #1a6b3c; --score-great-bg: #eaf5ee;
      --score-good: #1a4a6b; --score-good-bg: #eaf0f5;
      --score-mid: #6b5a00; --score-mid-bg: #fffbeb;
      --score-orange: #92400e; --score-orange-bg: #fff7ed;
      --score-low: #6b1a1a; --score-low-bg: #f5eaea;
    }
    :root[data-theme="dark"] {
      --bg: #0f0f0e; --bg-card: #1a1a18; --bg-hover: #222220; --bg-sidebar: #141412;
      --border: #2a2a27; --border-subtle: #222220;
      --text-primary: #f0ede8; --text-secondary: #908d87; --text-tertiary: #5a5855;
      --accent: #f0ede8; --accent-text: #141412; --logo-color: #f0ede8;
      --tag-bg: #2a2a27; --tag-text: #908d87;
      --shadow: 0 1px 3px rgba(0,0,0,0.3); --shadow-md: 0 4px 12px rgba(0,0,0,0.4);
      --score-great: #4ade80; --score-great-bg: #0d2b1a;
      --score-good: #60a5fa; --score-good-bg: #0d1e2b;
      --score-mid: #fbbf24; --score-mid-bg: #2b1f0d;
      --score-low: #f87171; --score-low-bg: #2b0d0d;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text-primary); min-height: 100vh; -webkit-font-smoothing: antialiased; }
    a { color: inherit; text-decoration: none; }

    .layout { display: grid; grid-template-columns: 240px 1fr 280px; max-width: 1140px; margin: 0 auto; min-height: 100vh; }
    @media (max-width: 1000px) { .layout { grid-template-columns: 200px 1fr; } .sidebar-right { display: none; } }
    @media (max-width: 680px) { .layout { grid-template-columns: 1fr; } .sidebar-left { display: none; } }

    /* SIDEBAR LEFT */
    .sidebar-left { position: sticky; top: 0; height: 100vh; padding: 28px 20px; display: flex; flex-direction: column; gap: 6px; border-right: 1px solid var(--border); background: var(--bg-sidebar); }
    .logo { font-family: 'Press Start 2P', monospace; font-size: 13px; color: var(--logo-color); padding: 8px 12px; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
    .logo-dot { width: 8px; height: 8px; background: var(--text-primary); border-radius: 50%; flex-shrink: 0; }
    .nav-item { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 10px; font-size: 15px; color: var(--text-secondary); transition: background 0.15s, color 0.15s; }
    .nav-item:hover, .nav-item.active { background: var(--bg-hover); color: var(--text-primary); }
    .nav-item.active { font-weight: 500; }
    .nav-icon { width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .nav-divider { height: 1px; background: var(--border); margin: 10px 0; }
    .sidebar-bottom { margin-top: auto; }
    .theme-toggle { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 10px; cursor: pointer; font-size: 15px; color: var(--text-secondary); background: none; border: none; font-family: inherit; width: 100%; text-align: left; transition: background 0.15s, color 0.15s; }
    .theme-toggle:hover { background: var(--bg-hover); color: var(--text-primary); }
    .sidebar-avatar { width: 24px; height: 24px; border-radius: 50%; background: var(--tag-bg); border: 1px solid var(--border); flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 9px; font-weight: 500; color: var(--text-secondary); overflow: hidden; }
    .sidebar-avatar img { width: 100%; height: 100%; object-fit: cover; }

    /* FEED */
    .feed { border-right: 1px solid var(--border); min-height: 100vh; }
    .feed-header { position: sticky; top: 0; background: var(--bg-card); border-bottom: 1px solid var(--border); padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; z-index: 10; backdrop-filter: blur(8px); }
    .feed-title { font-size: 17px; font-weight: 500; letter-spacing: -0.2px; }
    .feed-subtitle { font-size: 13px; color: var(--text-tertiary); margin-top: 1px; }

    /* SORT TABS */
    .sort-bar { display: flex; gap: 6px; padding: 12px 20px; border-bottom: 1px solid var(--border-subtle); background: var(--bg-card); position: sticky; top: 73px; z-index: 9; }
    .sort-btn { padding: 6px 14px; border-radius: 20px; font-size: 13px; font-weight: 500; font-family: inherit; color: var(--text-secondary); background: var(--tag-bg); border: 1px solid var(--border); cursor: pointer; transition: all 0.15s; text-decoration: none; display: inline-block; }
    .sort-btn:hover { color: var(--text-primary); background: var(--bg-hover); }
    .sort-btn.active { background: var(--accent); color: var(--accent-text); border-color: var(--accent); }

    /* REVIEW CARDS */
    .review-card { padding: 18px 20px; border-bottom: 1px solid var(--border-subtle); transition: background 0.15s; }
    .review-card:hover { background: var(--bg-hover); }
    .card-top { display: flex; gap: 12px; align-items: flex-start; }
    .avatar { width: 38px; height: 38px; border-radius: 50%; background: var(--tag-bg); border: 1px solid var(--border); flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 500; color: var(--text-secondary); overflow: hidden; }
    .avatar img { width: 100%; height: 100%; object-fit: cover; }
    .card-body { flex: 1; min-width: 0; }
    .card-meta { display: flex; align-items: center; gap: 6px; margin-bottom: 8px; flex-wrap: wrap; }
    .username { font-size: 14px; font-weight: 500; }
    .username:hover { text-decoration: underline; }
    .meta-dot { color: var(--text-tertiary); font-size: 12px; }
    .timestamp { font-size: 13px; color: var(--text-tertiary); }
    .game-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
    .game-cover-sm { width: 32px; height: 32px; border-radius: 6px; background: var(--tag-bg); border: 1px solid var(--border); flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 14px; overflow: hidden; }
    .game-cover-sm img { width: 100%; height: 100%; object-fit: cover; }
    .game-title-text { font-size: 14px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0; }
    .game-title-text:hover { text-decoration: underline; }
    .score-badge { flex-shrink: 0; width: 34px; height: 34px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 600; font-family: 'DM Serif Display', serif; }
    .score-perfect { color: var(--score-perfect); background: var(--score-perfect-bg); box-shadow: 0 0 14px rgba(167,139,250,.25); }
    .score-great { color: var(--score-great); background: var(--score-great-bg); }
    .score-teal { color: var(--score-teal); background: var(--score-teal-bg); }
    .score-good { color: var(--score-good); background: var(--score-good-bg); }
    .score-mid { color: var(--score-mid); background: var(--score-mid-bg); }
    .score-orange { color: var(--score-orange); background: var(--score-orange-bg); }
    .score-low { color: var(--score-low); background: var(--score-low-bg); }
    .review-title { font-family: 'DM Serif Display', serif; font-size: 16px; line-height: 1.35; margin-bottom: 5px; letter-spacing: -0.2px; }
    .review-body { font-size: 14px; line-height: 1.6; color: var(--text-secondary); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .spoiler-pill { display: inline-flex; align-items: center; gap: 4px; background: var(--tag-bg); color: var(--tag-text); font-size: 11px; font-weight: 500; padding: 2px 8px; border-radius: 20px; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px; }
    .review-body.spoiler-hidden { filter: blur(4px); user-select: none; cursor: pointer; }
    .card-footer { display: flex; align-items: center; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
    .footer-tag { background: var(--tag-bg); color: var(--tag-text); font-size: 12px; padding: 3px 9px; border-radius: 6px; }
    .read-more { margin-left: auto; font-size: 13px; color: var(--text-tertiary); transition: color 0.15s; }
    .review-card:hover .read-more { color: var(--text-primary); }
    .vote-row { display: flex; align-items: center; gap: 6px; margin-top: 10px; }
    .vote-btn { display: flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 20px; border: 1px solid var(--border); background: none; font-size: 12px; font-family: inherit; color: var(--text-tertiary); cursor: pointer; transition: all 0.15s; }
    .vote-btn:hover { border-color: var(--text-secondary); color: var(--text-primary); }
    .vote-btn.active-up { background: var(--score-great-bg); color: var(--score-great); border-color: var(--score-great); }
    .vote-btn.active-down { background: var(--score-low-bg); color: var(--score-low); border-color: var(--score-low); }

    /* EMPTY / LOGGED OUT */
    .empty-state { padding: 80px 20px; text-align: center; color: var(--text-tertiary); }
    .empty-title { font-family: 'DM Serif Display', serif; font-size: 24px; color: var(--text-secondary); margin-bottom: 10px; }
    .empty-sub { font-size: 14px; line-height: 1.6; margin-bottom: 20px; }
    .empty-cta { display: inline-block; background: var(--accent); color: var(--accent-text); padding: 10px 24px; border-radius: 22px; font-size: 14px; font-weight: 500; transition: opacity 0.15s; }
    .empty-cta:hover { opacity: 0.85; }

    /* SIDEBAR RIGHT */
    .sidebar-right { padding: 28px 20px; display: flex; flex-direction: column; gap: 20px; }
    .widget { background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; padding: 16px; box-shadow: var(--shadow); }
    .widget-title { font-size: 14px; font-weight: 500; margin-bottom: 14px; }
    .stat-row { display: flex; justify-content: space-between; align-items: center; padding: 7px 0; border-bottom: 1px solid var(--border-subtle); }
    .stat-row:last-child { border-bottom: none; }
    .stat-label { font-size: 13px; color: var(--text-secondary); }
    .stat-value { font-size: 14px; font-weight: 600; }
  </style>
</head>
<body>
<div class="layout">

  <aside class="sidebar-left">
    <div class="logo"><span class="logo-dot"></span>Chekpoint</div>
    <a href="/" class="nav-item">
      <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7L9 2L16 7V16H11V11H7V16H2V7Z"/></svg></span>
      Home
    </a>
    <a href="/following" class="nav-item active">
      <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 14c0-2.21-1.79-4-4-4s-4 1.79-4 4"/><circle cx="9" cy="6" r="3"/><path d="M16 14c0-1.86-1.28-3.41-3-3.83"/><path d="M15 4a3 3 0 010 4"/></svg></span>
      Following
    </a>
    <a href="/search" class="nav-item">
      <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="5"/><path d="M13 13l3 3"/></svg></span>
      Search
    </a>
    <div class="sidebar-bottom">
      <div class="nav-divider"></div>
      {isLoggedIn ? (
        <a href={currentProfile ? `/reviewers/${currentProfile.username}` : '/signin'} class="nav-item">
          <div class="sidebar-avatar">
            {currentProfile?.avatar_url
              ? <img src={currentProfile.avatar_url} alt={currentProfile.username} />
              : <span>{getInitials(currentProfile?.username ?? '?')}</span>
            }
          </div>
          Profile
        </a>
      ) : (
        <a href="/signin" class="nav-item">
          <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11v4M9 3v4M5 7h8M3 15h12"/></svg></span>
          Sign in / Sign up
        </a>
      )}
      <div class="nav-divider"></div>
      <button class="theme-toggle" id="themeToggle">
        <span class="nav-icon" id="themeIcon">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="9" r="3.5"/><path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.22 3.22l1.42 1.42M13.36 13.36l1.42 1.42M13.36 4.64l1.42-1.42M3.22 14.78l1.42-1.42"/></svg>
        </span>
        <span id="themeLabel">Light mode</span>
      </button>
    </div>
  </aside>

  <main class="feed">
    <div class="feed-header">
      <div>
        <div class="feed-title">Following</div>
        <div class="feed-subtitle">
          {!isLoggedIn
            ? 'Sign in to see your feed'
            : followingReviews.length > 0
            ? `${followingReviews.length} review${followingReviews.length !== 1 ? 's' : ''} from ${followingCount} reviewer${followingCount !== 1 ? 's' : ''} you follow`
            : followingCount > 0
            ? 'No reviews from people you follow yet'
            : 'You aren\'t following anyone yet'
          }
        </div>
      </div>
    </div>

    {!isLoggedIn ? (
      <div class="empty-state">
        <div class="empty-title">Sign in to see your feed</div>
        <p class="empty-sub">Follow reviewers to see their latest reviews here.</p>
        <a href="/signin" class="empty-cta">Sign in</a>
      </div>
    ) : followingCount === 0 ? (
      <div class="empty-state">
        <div class="empty-title">Your feed is empty</div>
        <p class="empty-sub">You're not following anyone yet. Find reviewers and follow them to see their reviews here.</p>
        <a href="/search?tab=reviewers" class="empty-cta">Find reviewers</a>
      </div>
    ) : followingReviews.length === 0 ? (
      <div class="empty-state">
        <div class="empty-title">Nothing here yet</div>
        <p class="empty-sub">The {followingCount} reviewer{followingCount !== 1 ? 's' : ''} you follow haven't posted any reviews yet.</p>
        <a href="/search?tab=reviewers" class="empty-cta">Find more reviewers</a>
      </div>
    ) : (
      <>
        <!-- SORT BAR -->
        <div class="sort-bar">
          <a href="/following?sort=recent" class={`sort-btn ${sortBy === 'recent' ? 'active' : ''}`}>Recent</a>
          <a href="/following?sort=top" class={`sort-btn ${sortBy === 'top' ? 'active' : ''}`}>Top voted</a>
          <a href="/following?sort=highest" class={`sort-btn ${sortBy === 'highest' ? 'active' : ''}`}>Highest score</a>
          <a href="/following?sort=lowest" class={`sort-btn ${sortBy === 'lowest' ? 'active' : ''}`}>Lowest score</a>
        </div>

        <!-- REVIEW FEED -->
        {followingReviews.map((review: any) => {
          const { up, down } = getVoteCounts(review.review_votes);
          return (
            <article class="review-card">
              <div class="card-top">
                <a href={`/reviewers/${review.profiles?.username}`} style="flex-shrink:0">
                  <div class="avatar">
                    {review.profiles?.avatar_url
                      ? <img src={review.profiles.avatar_url} alt={review.profiles?.username} />
                      : <span>{getInitials(review.profiles?.username ?? '?')}</span>
                    }
                  </div>
                </a>
                <div class="card-body">
                  <div class="card-meta">
                    <a href={`/reviewers/${review.profiles?.username}`} class="username">@{review.profiles?.username}</a>
                    <span class="meta-dot">·</span>
                    <span class="timestamp">{timeAgo(review.published_at ?? review.created_at)}</span>
                  </div>
                  <div class="game-row">
                    <a href={`/games/${review.games?.slug}`} class="game-cover-sm">
                      {review.games?.cover_img_url
                        ? <img src={igdbImage(review.games.cover_img_url, 't_thumb') ?? ''} alt={review.games?.title} />
                        : '🎮'
                      }
                    </a>
                    <a href={`/games/${review.games?.slug}`} class="game-title-text">{review.games?.title ?? 'Unknown Game'}</a>
                    <div class={`score-badge ${scoreColor(review.score)}`}>{review.score}</div>
                  </div>
                  {review.contains_spoilers && <div class="spoiler-pill">⚠ spoilers</div>}
                  {review.title && <div class="review-title">{review.title}</div>}
                  <div
                    class={`review-body ${review.contains_spoilers ? 'spoiler-hidden' : ''}`}
                    data-spoiler={review.contains_spoilers ? 'true' : 'false'}
                  >
                    {review.body}
                  </div>
                  <div class="card-footer">
                    {review.played_on && <span class="footer-tag">{review.played_on.name}</span>}
                    {review.play_time_hours > 0 && <span class="footer-tag">{review.play_time_hours}h played</span>}
                    <a href={`/reviews/${review.id}`} class="read-more">Read more →</a>
                  </div>
                  <div class="vote-row">
                    <button class="vote-btn" data-review-id={review.id} data-vote="1" data-count={up}>▲ {up}</button>
                    <button class="vote-btn" data-review-id={review.id} data-vote="-1" data-count={down}>▼ {down}</button>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </>
    )}
  </main>

  <aside class="sidebar-right">
    {isLoggedIn && lastReview && (
      <div class="widget">
        <div class="widget-title">Your last review</div>
        <a href={`/games/${lastReview.games?.slug}`} style="display:flex;gap:12px;align-items:flex-start;text-decoration:none">
          <div style="flex-shrink:0;width:52px;height:70px;border-radius:8px;overflow:hidden;background:var(--tag-bg);border:1px solid var(--border)">
            {lastReview.games?.cover_img_url
              ? <img src={igdbImage(lastReview.games.cover_img_url) ?? ''} alt={lastReview.games.title} style="width:100%;height:100%;object-fit:cover" />
              : <span style="display:flex;align-items:center;justify-content:center;height:100%;font-size:22px">🎮</span>
            }
          </div>
          <div style="flex:1;min-width:0">
            <div style="font-size:13px;font-weight:500;line-height:1.3;margin-bottom:6px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical">{lastReview.games?.title}</div>
            <div class={`score-badge ${scoreColor(lastReview.score)}`} style="width:32px;height:32px;border-radius:7px;display:inline-flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;font-family:'DM Serif Display',serif;margin-bottom:6px">{lastReview.score}</div>
            {lastReview.title && <div style="font-size:12px;color:var(--text-secondary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{lastReview.title}</div>}
            <div style="font-size:11px;color:var(--text-tertiary);margin-top:3px">{timeAgo(lastReview.published_at ?? lastReview.created_at)} ago</div>
          </div>
        </a>
      </div>
    )}
    {isLoggedIn && followingCount > 0 && (
      <div class="widget">
        <div class="widget-title">Your feed</div>
        <div class="stat-row">
          <span class="stat-label">Following</span>
          <span class="stat-value">{followingCount}</span>
        </div>
        <div class="stat-row">
          <span class="stat-label">Reviews in feed</span>
          <span class="stat-value">{followingReviews.length}</span>
        </div>
      </div>
    )}
    {isLoggedIn && (
      <div class="widget">
        <div class="widget-title">Discover reviewers</div>
        <p style="font-size:13px;color:var(--text-secondary);line-height:1.6;margin-bottom:12px">
          Find reviewers with similar tastes and follow them to build your feed.
        </p>
        <a href="/search?tab=reviewers" style="display:inline-block;background:var(--accent);color:var(--accent-text);padding:8px 18px;border-radius:20px;font-size:13px;font-weight:500">
          Browse reviewers
        </a>
      </div>
    )}
  </aside>

</div>

<script is:inline>
  // Theme
  function updateThemeUI(theme) {
    const label = document.getElementById('themeLabel');
    const icon = document.getElementById('themeIcon');
    if (!label || !icon) return;
    if (theme === 'dark') {
      label.textContent = 'Dark mode';
      icon.innerHTML = '<svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 10.5A7 7 0 016.5 3a7 7 0 100 12 7 7 0 008.5-4.5z"/></svg>';
    } else {
      label.textContent = 'Light mode';
      icon.innerHTML = '<svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="9" r="3.5"/><path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.22 3.22l1.42 1.42M13.36 13.36l1.42 1.42M13.36 4.64l1.42-1.42M3.22 14.78l1.42-1.42"/></svg>';
    }
  }

  const saved = localStorage.getItem('theme') ||
    (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  document.documentElement.setAttribute('data-theme', saved);
  updateThemeUI(saved);

  document.getElementById('themeToggle').addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    updateThemeUI(next);
  });

  // Spoiler reveal
  document.querySelectorAll('.review-body[data-spoiler="true"]').forEach(el => {
    el.addEventListener('click', () => el.classList.remove('spoiler-hidden'));
  });

  // Voting
  document.querySelectorAll('.vote-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const reviewId = btn.dataset.reviewId;
      const vote = parseInt(btn.dataset.vote);
      const res = await fetch('/api/reviews/vote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ review_id: reviewId, vote }),
      });
      if (res.status === 401) { window.location.href = '/signin'; return; }
      if (!res.ok) return;
      const data = await res.json();
      const pair = document.querySelectorAll(`.vote-btn[data-review-id="${reviewId}"]`);
      pair.forEach(b => {
        const bVote = parseInt(b.dataset.vote);
        let count = parseInt(b.dataset.count) || 0;
        if (data.vote === null) {
          b.classList.remove('active-up', 'active-down');
          if (bVote === vote) count = Math.max(0, count - 1);
        } else if (data.vote === bVote) {
          b.classList.add(bVote === 1 ? 'active-up' : 'active-down');
          b.classList.remove(bVote === 1 ? 'active-down' : 'active-up');
          count = count + 1;
        } else {
          b.classList.remove('active-up', 'active-down');
          if (data.vote !== null) count = Math.max(0, count - 1);
        }
        b.dataset.count = count;
        b.textContent = (bVote === 1 ? '▲ ' : '▼ ') + count;
      });
    });
  });
</script>
</body>
</html>
