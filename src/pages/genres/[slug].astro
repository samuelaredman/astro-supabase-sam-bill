---
export const prerender = false;
import { getSupabase, getSupabaseAdmin } from '../../utils/database'
import { igdbFetch } from '../../utils/igdb'
import { igdbImage, timeAgo } from '../../utils/format'
import { isAllowedGameCategory } from '../../utils/games'
import DetailNav from '../../components/DetailNav.astro'
import { setPageCacheHeaders } from '../../utils/cache';
import { getPageUser } from '../../utils/pageAuth';
import { hubStatsFor, avgScore, reviewCount, pooled, type HubStatRow } from '../../utils/hubStats'
import { fetchAll } from '../../utils/fetchAll'

const supabase = getSupabase()
const _genreUser = await getPageUser(Astro);
const isLoggedIn = !!_genreUser;

let currentProfile: { id: string; username: string; avatar_url: string | null } | null = null;
if (_genreUser) {
  const { data: cp } = await (supabase as any)
    .from('profiles').select('id, username, avatar_url').eq('auth_user_id', _genreUser.id).single();
  currentProfile = cp ?? null;
}

const { slug = '' } = Astro.params;

const { data: genre } = await supabase
  .from('genres')
  .select('id, name, slug, igdb_id')
  .eq('slug', slug)
  .single()

if (!genre) return Astro.redirect('/404')

// Authoritative indexability gate: does ANY game in this genre have a published
// review? Runs against the full genre↔game↔review relationship (not the capped
// display list below), so it stays in lockstep with the sitemap's inclusion rule.
// Uses the admin client — under RLS the anon client silently drops rows from the
// nested reviews inner-join, which would wrongly noindex a hub that has reviews.
const { data: reviewedInGenre } = await (getSupabaseAdmin() as any)
  .from('game_genres')
  .select('game_id, games!inner(reviews!inner(id))')
  .eq('genre_id', genre.id)
  .eq('games.reviews.status', 'published')
  .limit(1)
const hasReviewedGame = (reviewedInGenre?.length ?? 0) > 0

// fetch all games in this genre and, in parallel, the review count + score sum
// of its reviewed games — aggregated in Postgres (hub_game_review_stats), so no
// list of game ids has to travel in the request URL
const [gameGenres, hubStatRows] = await Promise.all([
  // Paged: a broad genre (Adventure, RPG) can hold several thousand games, and
  // PostgREST truncates a single response at 1000 rows regardless of `.limit()`.
  // Truncation here used to make recent-year counts look near-empty.
  fetchAll<{ games: any }>((from, to) => supabase
    .from('game_genres')
    .select(`games(id, title, slug, cover_img_url, date_released, igdb_category)`)
    .eq('genre_id', genre.id)
    .order('game_id')
    .range(from, to)),
  // Server-only RPC (service role). Paged: a big hub can pass 1000 reviewed games.
  fetchAll<HubStatRow>((from, to) => (getSupabaseAdmin() as any)
    .rpc('hub_game_review_stats', { p_genre_id: genre.id }).order('game_id').range(from, to)),
])

const allGames = gameGenres
  .map((gg: any) => gg.games)
  .filter(Boolean)
  .filter((g: any) => isAllowedGameCategory(g.igdb_category, g.title))
  .sort((a: any, b: any) =>
    new Date(b.date_released ?? 0).getTime() - new Date(a.date_released ?? 0).getTime()
  )

const gameIds = allGames.map((g: any) => g.id)

const reviewStats = hubStatsFor(hubStatRows, gameIds)

function gameAvgScore(gameId: string): string | null {
  return avgScore(reviewStats, gameId)
}

function gameReviewCount(gameId: string): number {
  return reviewCount(reviewStats, gameId)
}

// overall stats
const overallTotals = pooled(reviewStats)
const overallAvg = overallTotals.count > 0
  ? (overallTotals.sum / overallTotals.count).toFixed(1)
  : null
const totalReviews = overallTotals.count

// top rated games — all games sorted by avg score (min 3 reviews)
const topRated = allGames
  .filter((g: any) => gameReviewCount(g.id) >= 3)
  .sort((a: any, b: any) => {
    const aScore = parseFloat(gameAvgScore(a.id) ?? '0')
    const bScore = parseFloat(gameAvgScore(b.id) ?? '0')
    return bScore - aScore
  })
  .slice(0, 25)

// group by year, top 25 per year sorted by score
const byYear: Record<number, any[]> = {}
for (const g of allGames) {
  const year = g.date_released ? new Date(g.date_released).getFullYear() : 0
  if (!byYear[year]) byYear[year] = []
  byYear[year].push(g)
}

const byYearSorted: Record<number, any[]> = {}
for (const [year, games] of Object.entries(byYear)) {
  byYearSorted[parseInt(year)] = (games as any[])
    .sort((a: any, b: any) => {
      const aScore = parseFloat(gameAvgScore(a.id) ?? '0')
      const bScore = parseFloat(gameAvgScore(b.id) ?? '0')
      return bScore - aScore
    })
    .slice(0, 25)
}

const years = Object.keys(byYearSorted)
  .map(Number)
  .filter(y => y > 0)
  .sort((a, b) => b - a)

// related genres
const { data: coGenreRows } = await supabase
  .from('game_genres')
  .select('genre_id')
  .in('game_id', gameIds.length > 0 ? gameIds.slice(0, 200) : ['00000000-0000-0000-0000-000000000000'])
  .neq('genre_id', genre.id)

const coGenreCounts: Record<string, number> = {}
for (const row of coGenreRows ?? []) {
  coGenreCounts[row.genre_id] = (coGenreCounts[row.genre_id] ?? 0) + 1
}

const topCoGenreIds = Object.entries(coGenreCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
  .map(([id]) => id)

let relatedGenres: any[] = []
if (topCoGenreIds.length > 0) {
  const { data: relGenreRows } = await supabase
    .from('genres')
    .select('id, name, slug')
    .in('id', topCoGenreIds)
  relatedGenres = relGenreRows ?? []
}

// genre descriptions
const genreDescriptions: Record<string, string> = {
  'role-playing-rpg': 'Role-playing games let players assume the roles of characters in a fictional world, typically featuring character progression, stat systems, and story-driven gameplay. From classic JRPGs to open-world western RPGs, the genre spans a vast range of styles united by player agency and character development.',
  'shooter': 'Shooter games center on ranged combat, typically from a first or third-person perspective. The genre ranges from arcade-style run-and-guns to tactical military simulations, with player skill and precision at the core of the experience.',
  'adventure': 'Adventure games prioritize exploration, story, and puzzle-solving over reflexes. They range from classic point-and-click mysteries to sprawling open-world narratives, often featuring rich worlds and compelling characters.',
  'platform': 'Platformers challenge players to navigate environments by jumping between platforms and avoiding obstacles. From Mario to Celeste, the genre has evolved from simple side-scrollers to complex precision challenges with deep movement systems.',
  'strategy': 'Strategy games challenge players to think tactically or plan long-term, whether in real time or turn-based. The genre includes everything from city builders to grand strategy simulations covering centuries of history.',
  'fighting': 'Fighting games pit players against each other in direct combat, rewarding mastery of complex move sets and frame-perfect timing. The genre has a rich competitive scene and a history stretching back to the early days of arcades.',
  'indie': 'Indie games are developed outside the major publisher system, often by small teams or solo developers. The label has become associated with creative risk-taking, unique aesthetics, and games that push against mainstream conventions.',
  'puzzle': 'Puzzle games challenge logic, spatial reasoning, or pattern recognition. From simple block-matching to mind-bending physics simulations, the genre rewards patience and lateral thinking over reaction time.',
  'arcade': 'Arcade games prioritize immediate, pick-up-and-play fun with simple controls and escalating difficulty. Rooted in the coin-op era, the style lives on in score-chasing games designed for short sessions with high replayability.',
  'sport': 'Sports games simulate or draw inspiration from real-world athletic competitions. From realistic simulations of football and basketball to stylized takes on skateboarding and golf, the genre covers a wide spectrum of athletic experiences.',
}

const genreDescription = genre.slug ? (genreDescriptions[genre.slug] ?? null) : null

// mosaic banner from top-rated covers
const mosaicCovers = allGames
  .filter((g: any) => g.cover_img_url)
  .sort((a: any, b: any) =>
    parseFloat(gameAvgScore(b.id) ?? '-1') - parseFloat(gameAvgScore(a.id) ?? '-1')
  )
  .slice(0, 20)
  .map((g: any) => igdbImage(g.cover_img_url, 't_cover_big'))
  .filter(Boolean) as string[]
const mosaicTiles: string[] = mosaicCovers.length > 0
  ? [...mosaicCovers, ...mosaicCovers, ...mosaicCovers].slice(0, 24)
  : []
const hasMosaic = mosaicTiles.length >= 6

// per-year game counts + avg scores for pills
const yearGameCountsMap: Record<number, number> = {}
const yearAvgScoresMap: Record<number, number | null> = {}
for (const year of years) {
  const gamesInYear = byYear[year] ?? []
  yearGameCountsMap[year] = gamesInYear.length
  const yearTotals = pooled(reviewStats, gamesInYear.map((g: any) => g.id))
  yearAvgScoresMap[year] = yearTotals.count > 0
    ? Math.round((yearTotals.sum / yearTotals.count) * 10) / 10
    : null
}
const yearGameCountsJson = JSON.stringify(yearGameCountsMap)
const yearAvgScoresJson  = JSON.stringify(yearAvgScoresMap)

function scoreClass(score: number): string {
  if (score === 10) return 'perfect'
  if (score >= 9)   return 'great'
  if (score >= 8)   return 'teal'
  if (score >= 7)   return 'good'
  if (score >= 5)   return 'mid'
  if (score >= 3)   return 'orange'
  return 'low'
}

function releaseYear(dateStr: string | null): string | null {
  if (!dateStr) return null
  return String(new Date(dateStr).getFullYear())
}

const overallScoreClass = overallAvg ? scoreClass(parseFloat(overallAvg)) : null

function serializeGames(games: any[]) {
  return games.map((g: any) => {
    const avg   = gameAvgScore(g.id)
    const count = gameReviewCount(g.id)
    const sc    = avg ? scoreClass(parseFloat(avg)) : null
    return {
      title:   g.title,
      slug:    g.slug,
      cover:   igdbImage(g.cover_img_url),
      score:   avg,
      badge:   sc ? `badge-${sc}` : null,
      reviews: count > 0 ? `${count} ${count === 1 ? 'review' : 'reviews'}` : null,
      year:    releaseYear(g.date_released),
    }
  })
}

const topRatedJson    = JSON.stringify(serializeGames(topRated))
const byYearJson      = JSON.stringify(
  years.reduce((acc: any, year: number) => {
    acc[year] = serializeGames(byYearSorted[year] ?? [])
    return acc
  }, {})
)
const yearsJson = JSON.stringify(years)

// Stats tab data
const reviewedGameCount = allGames.filter((g: any) => gameReviewCount(g.id) > 0).length

const gameAvgScoresList: number[] = allGames
  .filter((g: any) => gameReviewCount(g.id) > 0)
  .map((g: any) => reviewStats[g.id].sum / reviewStats[g.id].count)

const gameScoreDist = Array.from({ length: 10 }, (_, i) => {
  if (i === 9) return gameAvgScoresList.filter(avg => avg >= 9.5).length
  return gameAvgScoresList.filter(avg => avg >= i + 0.5 && avg < i + 1.5).length
})

const reviewsByYearMap: Record<number, number> = {}
for (const g of allGames) {
  const year = g.date_released ? new Date(g.date_released).getFullYear() : 0
  if (!year) continue
  const rc = gameReviewCount(g.id)
  if (rc > 0) reviewsByYearMap[year] = (reviewsByYearMap[year] ?? 0) + rc
}
const reviewsByYearData = Object.entries(reviewsByYearMap)
  .map(([year, count]) => ({ year: parseInt(year), count }))
  .sort((a, b) => a.year - b.year)

const topReviewedGames = allGames
  .filter((g: any) => gameReviewCount(g.id) > 0)
  .sort((a: any, b: any) => gameReviewCount(b.id) - gameReviewCount(a.id))
  .slice(0, 5)
  .map((g: any) => {
    const avg   = gameAvgScore(g.id)
    const count = gameReviewCount(g.id)
    const sc    = avg ? scoreClass(parseFloat(avg)) : null
    return { title: g.title, slug: g.slug, cover: igdbImage(g.cover_img_url), reviews: count, avg, badge: sc ? `badge-${sc}` : null }
  })

const genreStatsJson = JSON.stringify({
  totalReviews, reviewedGameCount,
  gameAvg: overallAvg ? parseFloat(overallAvg) : null,
  gameCount: allGames.length,
  gameScoreDist, reviewsByYearData, topReviewedGames,
})

// Recent reviews
const { data: recentReviewRows } = await supabase
  .from('reviews')
  .select(`id, score, title, body, created_at, game_id, games(id, title, slug, cover_img_url), profiles(id, username, avatar_url)`)
  .in('game_id', gameIds.length > 0 ? gameIds.slice(0, 200) : ['00000000-0000-0000-0000-000000000000'])
  .eq('status', 'published')
  .order('created_at', { ascending: false })
  .limit(30)

const recentReviews = recentReviewRows ?? []
const activeTab = Astro.url.searchParams.get('tab') || 'overview'

function getInitials(username: string): string {
  return username.slice(0, 2).toUpperCase()
}

// accent colour — genres use purple (same as profile page)
const accentLight = '#4a3a8a'
const accentDark  = '#6050c8'
const accentRgb   = '96,80,200'

setPageCacheHeaders(Astro.response.headers, isLoggedIn);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <script is:inline>
    (function() {
      var t = localStorage.getItem('theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', t);
      var m = document.getElementById('meta-theme-color');
      if (m) m.content = t === 'dark' ? '#0f0f0e' : '#f9f8f6';
    })();
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" id="meta-theme-color" content="#f9f8f6" />
  <title>{genre.name} Games — Chekpoint</title>
  <meta name="description" content={genreDescription?.slice(0, 160) ?? `Browse the best ${genre.name} games and reviews on Chekpoint.`} />
  {!hasReviewedGame && <meta name="robots" content="noindex, nofollow" />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&family=DM+Serif+Display&family=Press+Start+2P&display=swap" rel="stylesheet" />
  <!-- inject accent vars before paint, matching platform page pattern -->
  <script is:inline define:vars={{ accentLight, accentDark, accentRgb }}>
    (function() {
      var t = document.documentElement.getAttribute('data-theme') || 'dark';
      document.documentElement.style.setProperty('--game-accent', t === 'light' ? accentLight : accentDark);
      document.documentElement.style.setProperty('--accent-rgb', accentRgb);
    })();
  </script>
  <style is:global>
    /* ── THEME TOKENS ── identical structure to platforms/[slug].astro ── */
    :root[data-theme="light"] {
      --bg:#f5f4f2;--bg-card:#ffffff;--bg-hover:#f4f3f0;
      --border:#e8e6e1;--border-subtle:#f0ede8;
      --text-primary:#141412;--text-secondary:#6b6860;--text-tertiary:#a09d98;
      --tag-bg:#f0ede8;--tag-text:#6b6860;
      --shadow:0 1px 3px rgba(0,0,0,.06);--shadow-md:0 4px 16px rgba(0,0,0,.1);
      --score-great:#1a6b3c;--score-great-bg:#eaf5ee;
      --score-good:#1a4a6b; --score-good-bg:#eaf0f5;
      --score-mid:#6b5a1a;  --score-mid-bg:#f5f0ea;
      --score-low:#6b1a1a;  --score-low-bg:#f5eaea;
      --game-accent:#4a3a8a;
      --hero-overlay:linear-gradient(to bottom,rgba(245,244,242,.05)0%,rgba(245,244,242,.2)40%,rgba(245,244,242,.85)75%,rgba(245,244,242,1)100%);
      --hero-side:linear-gradient(to right,rgba(245,244,242,.4)0%,transparent 40%);
    }
    :root[data-theme="dark"] {
      --bg:#09090a;--bg-card:#131314;--bg-hover:#1c1c1e;
      --border:#222224;--border-subtle:#191919;
      --text-primary:#f0ede8;--text-secondary:#908d87;--text-tertiary:#484644;
      --tag-bg:#1c1c1e;--tag-text:#6a6866;
      --shadow:0 1px 3px rgba(0,0,0,.5);--shadow-md:0 4px 16px rgba(0,0,0,.7);
      --score-great:#4ade80;--score-great-bg:#112e1c;
      --score-teal:#2dd4bf; --score-teal-bg:#082d2a;
      --score-good:#60a5fa; --score-good-bg:#0e2240;
      --score-mid:#fbbf24;  --score-mid-bg:#271e00;
      --score-orange:#fb923c;--score-orange-bg:#2c160a;
      --score-low:#f87171;  --score-low-bg:#300e0e;
      --score-perfect:#ffffff;--score-perfect-bg:#22223a;
      --game-accent:#6050c8;
      --hero-overlay:linear-gradient(to bottom,rgba(9,9,10,.05)0%,rgba(9,9,10,.2)40%,rgba(9,9,10,.8)75%,rgba(9,9,10,1)100%);
      --hero-side:linear-gradient(to right,rgba(9,9,10,.5)0%,transparent 40%);
    }

    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text-primary);min-height:100vh;-webkit-font-smoothing:antialiased}
    a{color:inherit;text-decoration:none}

    /* ── NAV ── */

    /* ── HERO MOSAIC ── */
    .hero{position:relative;width:100%;height:400px;overflow:hidden;background:#04040a}
    .hero-mosaic{position:absolute;inset:-40px;display:none;flex-wrap:wrap;filter:blur(28px) saturate(1.6) brightness(.5);transform:scale(1.15)}
    .hero-mosaic.visible{display:flex}
    .hero-mosaic-tile{flex:1 1 90px;min-width:90px;min-height:180px;background-size:cover;background-position:center}
    .hero-side-fade{position:absolute;inset:0;background:var(--hero-side)}
    .hero-overlay{position:absolute;inset:0;background:var(--hero-overlay)}

    /* ── PAGE & HEADER ── */
    .page{max-width:980px;margin:0 auto;padding:0 28px 100px}

    .genre-header{display:flex;gap:24px;align-items:flex-end;margin-bottom:28px;position:relative;z-index:2}
    .genre-header.has-banner{margin-top:-100px}
    .genre-header.no-banner{margin-top:32px}

    .genre-icon-wrap{flex-shrink:0;width:140px;height:140px;border-radius:22px;background:var(--bg-card);border:1px solid rgba(var(--accent-rgb),.3);box-shadow:0 14px 48px rgba(0,0,0,.8),0 0 36px rgba(var(--accent-rgb),.18);display:flex;align-items:center;justify-content:center;font-size:60px}
    .genre-info{flex:1;min-width:0;padding-bottom:4px}
    .genre-eyebrow{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.12em;color:var(--game-accent);margin-bottom:6px}
    .genre-name{font-family:'Cinzel',serif;font-size:34px;line-height:1.1;letter-spacing:.04em;font-weight:600;text-shadow:0 2px 24px rgba(0,0,0,.6);margin-bottom:10px}
    .genre-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .genre-meta-item{font-size:13px;color:var(--text-secondary)}
    .genre-meta-sep{color:var(--text-tertiary);font-size:10px}

    /* ── STAT CARDS ── */
    .stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:28px}
    .stat-card{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:20px 18px 16px}
    .stat-card.score-card-great{border-bottom:2px solid var(--score-great)}
    .stat-card.score-card-good {border-bottom:2px solid var(--score-good)}
    .stat-card.score-card-mid  {border-bottom:2px solid var(--score-mid)}
    .stat-card.score-card-low  {border-bottom:2px solid var(--score-low)}
    .stat-num{font-family:'Century Schoolbook','New Century Schoolbook',Georgia,serif;font-size:32px;font-weight:400;line-height:1;letter-spacing:-1px;margin-bottom:5px;color:var(--text-primary)}
    .stat-num.great{color:var(--score-great)}
    .stat-num.good {color:var(--score-good)}
    .stat-num.mid  {color:var(--score-mid)}
    .stat-num.low  {color:var(--score-low)}
    .stat-label{font-size:10px;font-weight:500;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:.08em}
    .stat-sub{font-size:10px;color:var(--text-tertiary);margin-top:2px}

    /* ── ABOUT GRID ── */
    .about-grid{display:grid;grid-template-columns:1fr 260px;gap:24px;margin-bottom:40px}
    @media(max-width:720px){.about-grid{grid-template-columns:1fr}}
    .description{font-size:14px;line-height:1.8;color:var(--text-secondary)}
    .description.collapsed{display:-webkit-box;-webkit-line-clamp:5;-webkit-box-orient:vertical;overflow:hidden}
    .read-more-btn{background:none;border:none;font-family:inherit;font-size:12px;color:var(--game-accent);cursor:pointer;padding:8px 0 0;display:block}
    .details-card{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:4px 18px;height:fit-content}
    .detail-row{display:flex;gap:12px;padding:11px 0;border-bottom:1px solid var(--border-subtle);font-size:12px}
    .detail-row:last-child{border-bottom:none}
    .detail-label{flex-shrink:0;width:80px;color:var(--text-tertiary);padding-top:2px;text-transform:uppercase;letter-spacing:.06em;font-size:10px;font-weight:500}
    .detail-value{color:var(--text-secondary);line-height:1.5}

    /* ── RELATED GENRES ── */
    .related-genres{display:flex;flex-wrap:wrap;gap:8px}
    .genre-chip{background:var(--tag-bg);color:var(--text-secondary);border:1px solid var(--border);border-radius:20px;padding:5px 14px;font-size:12px;font-weight:500;transition:all .15s}
    .genre-chip:hover{border-color:var(--game-accent);color:var(--game-accent)}

    /* ── SECTIONS ── */
    .section{margin-bottom:48px}
    .section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
    .section-title{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.12em;color:var(--text-tertiary)}
    .section-count{font-size:12px;color:var(--text-tertiary)}

    /* ── YEAR PILL STRIP — identical to platform page ── */
    .pill-strip-wrap{position:relative;display:flex;align-items:center;gap:6px;margin-bottom:14px}
    .strip-arrow{background:var(--bg-card);border:1px solid var(--border);border-radius:8px;width:28px;height:28px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .15s;color:var(--text-secondary);flex-shrink:0}
    .strip-arrow:hover{border-color:var(--game-accent);color:var(--game-accent)}
    .strip-arrow:disabled{opacity:.2;cursor:default;pointer-events:none}
    .year-pill-strip{display:flex;gap:2px;overflow-x:auto;padding-bottom:4px;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;flex:1;min-width:0}
    .year-pill-strip::-webkit-scrollbar{display:none}
    .year-pill{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:999px;border:1px solid transparent;background:transparent;cursor:pointer;white-space:nowrap;scroll-snap-align:start;transition:background .15s,color .15s;font-family:inherit;color:var(--text-secondary);flex-shrink:0}
    .year-pill:hover{background:var(--bg-hover);color:var(--text-primary)}
    .year-pill.active{background:var(--game-accent);color:#fff}
    .year-pill-dot{width:5px;height:5px;border-radius:50%;flex-shrink:0;display:inline-block;opacity:.65}
    .year-pill.active .year-pill-dot{opacity:1}
    .year-pill-label{font-size:12px;font-weight:600;color:inherit;display:inline-block}
    .year-pill-count{font-size:11px;color:inherit;opacity:.55;display:inline-block}
    .year-pill.active .year-pill-count{opacity:.85}

    .year-panel-header{display:flex;align-items:center;gap:12px;margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid var(--border)}
    .year-panel-label{font-family:'DM Serif Display',serif;font-size:22px;letter-spacing:-.3px;color:var(--text-primary)}
    .year-panel-count{font-size:12px;color:var(--text-tertiary)}

    /* ── PAGINATED GAME ROW — identical to platform page ── */
    .game-row{display:grid;grid-template-columns:repeat(10,1fr);gap:8px}
    @media(max-width:900px){.game-row{grid-template-columns:repeat(8,1fr)}}
    @media(max-width:700px){.game-row{grid-template-columns:repeat(5,1fr)}}
    @media(max-width:460px){.game-row{grid-template-columns:repeat(4,1fr);gap:6px}}
    .row-nav{display:flex;align-items:center;gap:8px;margin-top:14px}
    .row-nav-info{font-size:12px;color:var(--text-tertiary)}
    .row-arrow{background:var(--bg-card);border:1px solid var(--border);border-radius:8px;width:32px;height:32px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .15s;color:var(--text-secondary);flex-shrink:0}
    .row-arrow:hover{border-color:var(--game-accent);color:var(--game-accent)}
    .row-arrow:disabled{opacity:.25;cursor:default;pointer-events:none}

    /* ── GAME CARDS — compact style matching the game page's similar-card ── */
    .game-card{background:var(--bg-card);border:1px solid var(--border);border-radius:10px;overflow:hidden;transition:transform .15s,border-color .15s;display:block;text-decoration:none;position:relative}
    .game-card:hover{transform:translateY(-3px);border-color:rgba(var(--accent-rgb),.35)}
    .game-cover{aspect-ratio:3/4;background:var(--tag-bg);overflow:hidden;position:relative;width:100%;display:flex;align-items:center;justify-content:center;font-size:24px}
    .game-cover img{width:100%;height:100%;object-fit:cover;display:block}
    .game-cover-placeholder{width:100%;height:100%;position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:24px}
    .game-score-badge{position:absolute;bottom:5px;right:5px;min-width:26px;height:20px;padding:0 5px;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;font-family:'DM Serif Display',serif;backdrop-filter:blur(6px)}
    .badge-perfect{color:#09090a;background:#ffffff;border:1px solid rgba(255,255,255,.8);box-shadow:0 0 10px rgba(255,255,255,.9),0 0 24px rgba(255,255,255,.6),0 0 48px rgba(255,255,255,.3)}
    [data-theme="light"] .badge-perfect{color:#ffffff;background:#1a1a2e;border:1px solid rgba(30,26,60,.3);box-shadow:0 0 8px rgba(30,26,60,.4)}
    .badge-great  {color:var(--score-great);  background:var(--score-great-bg);  border:1px solid rgba(74,222,128,.3)}
    .badge-teal   {color:var(--score-teal);   background:var(--score-teal-bg);   border:1px solid rgba(45,212,191,.3)}
    .badge-good   {color:var(--score-good);   background:var(--score-good-bg);   border:1px solid rgba(96,165,250,.3)}
    .badge-mid    {color:var(--score-mid);    background:var(--score-mid-bg);    border:1px solid rgba(251,191,36,.3)}
    .badge-orange {color:var(--score-orange); background:var(--score-orange-bg); border:1px solid rgba(251,146,60,.3)}
    .badge-low    {color:var(--score-low);    background:var(--score-low-bg);    border:1px solid rgba(248,113,113,.3)}
    .rank-badge{position:absolute;top:5px;left:5px;background:rgba(0,0,0,.6);color:#fff;font-size:10px;font-weight:700;padding:2px 5px;border-radius:4px;line-height:1.4;letter-spacing:.01em;backdrop-filter:blur(4px)}
    .game-info{padding:6px 8px 8px}
    .game-title-text{font-size:10px;font-weight:500;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;color:var(--text-secondary)}
    .game-review-count{display:none}

    /* ── TABS ── */
    .tab-nav{display:flex;gap:4px;margin-bottom:28px;background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:4px;overflow-x:auto;scrollbar-width:none}
    .tab-nav::-webkit-scrollbar{display:none}
    .tab-link{padding:8px 18px;border-radius:7px;font-size:13px;font-weight:600;color:var(--text-secondary);text-decoration:none;transition:all .15s;white-space:nowrap;display:flex;align-items:center;gap:6px}
    .tab-link:hover{color:var(--text-primary);background:var(--bg-hover)}
    .tab-link.active{background:var(--game-accent);color:#fff}
    .tab-count{font-size:11px;font-weight:700;background:rgba(255,255,255,.15);border-radius:10px;padding:1px 6px;line-height:1.5}
    .tab-link:not(.active) .tab-count{background:var(--bg-hover);color:var(--text-tertiary)}
    .tab-panel{display:none}
    .tab-panel.active{display:block}

    /* ── SCORE HERO ── */
    .score-hero{display:flex;align-items:flex-start;gap:24px;padding:20px 24px;background:var(--bg-card);border:1px solid var(--border);border-radius:16px;margin-bottom:16px;position:relative;overflow:hidden}
    .score-hero::before{content:'';position:absolute;inset:0;background:rgba(var(--accent-rgb),.06);pointer-events:none}
    .score-hero::after{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(to right,transparent,var(--game-accent),transparent);opacity:.6}
    [data-theme="light"] .score-hero{background:#14121e;border-color:rgba(var(--accent-rgb),.3);--score-perfect:#ffffff;--score-great:#4ade80;--score-teal:#2dd4bf;--score-good:#60a5fa;--score-mid:#fbbf24;--score-orange:#fb923c;--score-low:#f87171}
    [data-theme="light"] .score-hero .score-label{color:rgba(255,255,255,.42)}
    [data-theme="light"] .score-hero .review-count-label{color:rgba(255,255,255,.55)}
    [data-theme="light"] .score-hero .score-divider{background:rgba(255,255,255,.1)}
    [data-theme="light"] .score-hero .dist-label{color:rgba(255,255,255,.32)}
    .avg-score-num{font-family:'Century Schoolbook','New Century Schoolbook',Georgia,serif;font-size:72px;line-height:1;font-weight:700;position:relative;z-index:1;letter-spacing:-3px;padding-top:8px}
    .avg-score-num.score-perfect-color{color:#fff;text-shadow:0 0 20px rgba(255,255,255,.7),0 0 40px rgba(255,255,255,.3)}
    .avg-score-num.score-great-color{color:var(--score-great)}
    .avg-score-num.score-teal-color{color:var(--score-teal)}
    .avg-score-num.score-good-color{color:var(--score-good)}
    .avg-score-num.score-mid-color{color:var(--score-mid)}
    .avg-score-num.score-orange-color{color:var(--score-orange)}
    .avg-score-num.score-low-color{color:var(--score-low)}
    .avg-score-num.score-none-color{color:rgba(255,255,255,.3);font-size:48px;padding-top:16px}
    .score-divider{width:1px;height:56px;background:var(--border);flex-shrink:0;margin-top:8px}
    .score-meta{flex:1;position:relative;z-index:1;min-width:0}
    .score-label{font-size:11px;font-weight:500;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:.1em;margin-bottom:3px}
    .review-count-label{font-size:13px;color:var(--text-secondary);margin-bottom:12px}
    .score-dist{display:flex;gap:4px;align-items:flex-end;height:56px;margin-top:8px}
    .dist-bar-wrap{display:flex;flex-direction:column;align-items:center;gap:3px;flex:1}
    .dist-bar{width:100%;border-radius:4px 4px 0 0;min-height:4px;transition:opacity .15s,transform .15s}
    .dist-bar-wrap:hover .dist-bar{opacity:1!important;transform:scaleY(1.06);transform-origin:bottom}
    .dist-label{font-size:9px;color:var(--text-tertiary);font-weight:500;margin-top:2px}

    /* SCORE TREND — line chart of avg per release year */
    .trend-card{background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:18px 22px 14px;margin-bottom:16px}
    .trend-header{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:10px}
    .trend-title{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.12em;color:var(--text-tertiary)}
    .trend-sub{font-size:11px;color:var(--text-tertiary)}
    .trend-svg{display:block;width:100%;height:100px;overflow:visible}
    .trend-grid{stroke:var(--border-subtle);stroke-width:1;stroke-dasharray:2 4}
    .trend-area{fill:var(--game-accent);opacity:.08}
    .trend-line{fill:none;stroke:var(--game-accent);stroke-width:2;stroke-linecap:round;stroke-linejoin:round;opacity:.75}
    .trend-dot{stroke:var(--bg-card);stroke-width:1.5;cursor:pointer}
    .trend-dot-perfect{fill:#fff}
    .trend-dot-great{fill:var(--score-great)}
    .trend-dot-teal{fill:var(--score-teal)}
    .trend-dot-good{fill:var(--score-good)}
    .trend-dot-mid{fill:var(--score-mid)}
    .trend-dot-orange{fill:var(--score-orange)}
    .trend-dot-low{fill:var(--score-low)}
    .trend-xaxis{position:relative;height:14px;margin-top:4px}
    .trend-xlabel{position:absolute;top:0;transform:translateX(-50%);font-size:10px;color:var(--text-tertiary);white-space:nowrap}

    /* ── REVIEWS ── */
    .reviews-toolbar{display:flex;align-items:center;gap:6px;margin-bottom:20px}
    .sort-tab{background:var(--tag-bg);color:var(--text-tertiary);border:1px solid var(--border);border-radius:20px;padding:5px 14px;font-size:11px;font-weight:500;font-family:inherit;cursor:pointer;transition:all .15s;letter-spacing:.04em;text-transform:uppercase}
    .sort-tab.active{background:var(--game-accent);color:white;border-color:transparent}
    .review-card{padding:22px 0;border-bottom:1px solid var(--border-subtle)}
    .review-card:last-child{border-bottom:none}
    .review-top{display:flex;align-items:center;gap:10px;margin-bottom:10px}
    .avatar{width:34px;height:34px;border-radius:50%;background:var(--bg-hover);border:1px solid var(--border);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;color:var(--text-tertiary);overflow:hidden}
    .avatar img{width:100%;height:100%;object-fit:cover}
    .reviewer-info{flex:1;min-width:0}
    .reviewer-name{font-size:13px;font-weight:500;transition:color .15s}
    .reviewer-name:hover{color:var(--text-secondary)}
    .reviewer-meta{font-size:11px;color:var(--text-tertiary);display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-top:2px}
    .score-badge{flex-shrink:0;width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;font-family:'Century Schoolbook',Georgia,serif}
    .score-perfect{color:#09090a!important;background:#ffffff!important;border:1px solid rgba(255,255,255,.8)!important;box-shadow:0 0 10px rgba(255,255,255,.7),0 0 20px rgba(255,255,255,.3)}
    [data-theme="light"] .score-perfect{color:#ffffff!important;background:#1a1a2e!important;border:1px solid rgba(30,26,60,.3)!important;box-shadow:0 0 8px rgba(30,26,60,.4)}
    .score-great  {color:var(--score-great);  background:var(--score-great-bg);  border:1px solid rgba(74,222,128,.25)}
    .score-teal   {color:var(--score-teal);   background:var(--score-teal-bg);   border:1px solid rgba(45,212,191,.25)}
    .score-good   {color:var(--score-good);   background:var(--score-good-bg);   border:1px solid rgba(96,165,250,.25)}
    .score-mid    {color:var(--score-mid);    background:var(--score-mid-bg);    border:1px solid rgba(251,191,36,.25)}
    .score-orange {color:var(--score-orange); background:var(--score-orange-bg); border:1px solid rgba(251,146,60,.25)}
    .score-low    {color:var(--score-low);    background:var(--score-low-bg);    border:1px solid rgba(248,113,113,.25)}
    .review-game-link{display:flex;align-items:center;gap:8px;margin-bottom:10px;padding:7px 10px;background:var(--tag-bg);border-radius:8px;transition:opacity .15s}
    .review-game-link:hover{opacity:.7}
    .review-game-cover{width:26px;height:34px;border-radius:4px;object-fit:cover;flex-shrink:0;border:1px solid var(--border)}
    .review-game-title{font-size:12px;font-weight:500;color:var(--text-secondary)}
    .review-title{font-family:'DM Serif Display',serif;font-size:18px;line-height:1.3;margin-bottom:8px;letter-spacing:-.2px}
    .review-body{font-size:14px;line-height:1.75;color:var(--text-secondary)}
    .review-body.collapsed{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
    .review-footer{display:flex;align-items:center;gap:8px;margin-top:12px}
    .expand-btn{font-size:11px;color:var(--game-accent);margin-left:auto;cursor:pointer;background:none;border:none;font-family:inherit;transition:opacity .15s;padding:0;font-weight:500}
    .expand-btn:hover{opacity:.7}

    .empty-state{padding:60px 0;text-align:center;color:var(--text-tertiary)}
    .empty-title{font-family:'DM Serif Display',serif;font-size:20px;color:var(--text-secondary);margin-bottom:8px}

    /* ── MOBILE ── */
    @media(max-width:600px){
      .genre-header{flex-direction:column;align-items:flex-start}
      .genre-header.has-banner{margin-top:-60px}
      .genre-header.no-banner{margin-top:20px}
      .genre-name{font-size:26px}
      .hero{height:260px}
      .score-hero{flex-direction:column;gap:12px;padding:16px 18px}
      .score-divider{display:none}
      .avg-score-num{font-size:56px;padding-top:0}
    }
    @media(max-width:768px){
      body{padding-bottom:calc(56px + env(safe-area-inset-bottom,0px))}
    }
  </style>
</head>

<body>
  <DetailNav isLoggedIn={isLoggedIn} currentProfile={currentProfile} />

  {hasMosaic && (
    <div class="hero">
      <div class="hero-mosaic visible">
        {mosaicTiles.map((url: string) => (
          <div class="hero-mosaic-tile" style={`background-image:url('${url}')`}></div>
        ))}
      </div>
      <div class="hero-side-fade"></div>
      <div class="hero-overlay"></div>
    </div>
  )}

  <div class="page">

    <div class={`genre-header ${hasMosaic ? 'has-banner' : 'no-banner'}`}>
      <div class="genre-icon-wrap">
        {genre.slug === 'role-playing-rpg' && '⚔️'}
        {genre.slug === 'shooter'          && '🔫'}
        {genre.slug === 'adventure'        && '🗺️'}
        {genre.slug === 'platform'         && '🕹️'}
        {genre.slug === 'strategy'         && '♟️'}
        {genre.slug === 'fighting'         && '🥊'}
        {genre.slug === 'puzzle'           && '🧩'}
        {genre.slug === 'sport'            && '⚽'}
        {genre.slug === 'indie'            && '✨'}
        {genre.slug === 'arcade'           && '🕹️'}
        {!['role-playing-rpg','shooter','adventure','platform','strategy','fighting','puzzle','sport','indie','arcade'].includes(genre.slug ?? '') && '🎮'}
      </div>
      <div class="genre-info">
        <div class="genre-eyebrow">Genre</div>
        <h1 class="genre-name">{genre.name}</h1>
        <div class="genre-meta">
          <span class="genre-meta-item">{allGames.length.toLocaleString()} games</span>
          {totalReviews > 0 && (
            <>
              <span class="genre-meta-sep">•</span>
              <span class="genre-meta-item">{totalReviews.toLocaleString()} reviews</span>
            </>
          )}
          {overallAvg && (
            <>
              <span class="genre-meta-sep">•</span>
              <span class="genre-meta-item" style={`color:var(--score-${overallScoreClass})`}>{overallAvg} avg</span>
            </>
          )}
        </div>
      </div>
    </div>

    <div class="score-hero">
      <div class={`avg-score-num ${overallScoreClass ? `score-${overallScoreClass}-color` : 'score-none-color'}`}>
        {overallAvg ?? '—'}
      </div>
      <div class="score-divider"></div>
      <div class="score-meta">
        <div class="score-label">Average game score</div>
        <div class="review-count-label">
          {totalReviews > 0
            ? `${totalReviews.toLocaleString()} ${totalReviews === 1 ? 'review' : 'reviews'} across ${allGames.length.toLocaleString()} games`
            : `${allGames.length.toLocaleString()} games · no reviews yet`}
        </div>
        {gameScoreDist.some((v: number) => v > 0) && (
          <div class="score-dist">
            {gameScoreDist.map((count: number, i: number) => {
              const score = i + 1
              const max = Math.max(...gameScoreDist, 1)
              // sqrt scaling so small buckets stay visible when one bucket dominates
              const h = count > 0 ? Math.max(25, Math.sqrt(count / max) * 100) : 6
              const tier = score === 10 ? 'perfect' : score >= 9 ? 'great' : score >= 8 ? 'teal' : score >= 7 ? 'good' : score >= 5 ? 'mid' : score >= 3 ? 'orange' : 'low'
              return (
                <div class="dist-bar-wrap" title={`${count} game${count === 1 ? '' : 's'} averaging ${score}`}>
                  <div class="dist-bar" style={`height:${h}%;background:var(--score-${tier});opacity:${count > 0 ? 0.85 : 0.15}`}></div>
                  <div class="dist-label">{score}</div>
                </div>
              )
            })}
          </div>
        )}
      </div>
    </div>

    {(() => {
      const points = Object.entries(yearAvgScoresMap)
        .map(([y, s]) => ({ year: Number(y), score: s as number | null }))
        .filter(p => p.score !== null)
        .sort((a, b) => a.year - b.year)
      if (points.length < 2) return null
      const minY = points[0].year, maxY = points[points.length - 1].year
      const w = 1000, h = 100, padX = 10, padT = 10, padB = 20
      const xAt = (y: number) => padX + ((y - minY) / Math.max(1, maxY - minY)) * (w - 2*padX)
      const yAt = (s: number) => padT + (1 - (s - 1) / 9) * (h - padT - padB)
      const linePath = points.map((p, i) => `${i === 0 ? 'M' : 'L'}${xAt(p.year).toFixed(1)},${yAt(p.score!).toFixed(1)}`).join(' ')
      const areaPath = `${linePath} L${xAt(maxY).toFixed(1)},${h - padB} L${xAt(minY).toFixed(1)},${h - padB} Z`
      const tier = (s: number) => s === 10 ? 'perfect' : s >= 9 ? 'great' : s >= 8 ? 'teal' : s >= 7 ? 'good' : s >= 5 ? 'mid' : s >= 3 ? 'orange' : 'low'
      const labelStep = Math.max(1, Math.floor(points.length / 6))
      const labelPoints = points.filter((_, i) => i % labelStep === 0 || i === points.length - 1)
      return (
        <div class="trend-card">
          <div class="trend-header">
            <span class="trend-title">Score trend</span>
            <span class="trend-sub">{minY} – {maxY}</span>
          </div>
          <svg class="trend-svg" viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="none">
            {[2, 5, 8].map(s => <line x1={padX} y1={yAt(s)} x2={w - padX} y2={yAt(s)} class="trend-grid" />)}
            <path d={areaPath} class="trend-area" />
            <path d={linePath} class="trend-line" />
            {points.map(p => (
              <circle cx={xAt(p.year)} cy={yAt(p.score!)} r="3.5" class={`trend-dot trend-dot-${tier(p.score!)}`}>
                <title>{p.year}: {p.score!.toFixed(1)}</title>
              </circle>
            ))}
          </svg>
          <div class="trend-xaxis">
            {labelPoints.map(p => (
              <span class="trend-xlabel" style={`left:${((p.year - minY) / Math.max(1, maxY - minY)) * 100}%`}>{p.year}</span>
            ))}
          </div>
        </div>
      )
    })()}


    <!-- TAB NAV -->
    <nav class="tab-nav">
      <a href={`/genres/${genre.slug}?tab=overview`} class={`tab-link ${activeTab === 'overview' ? 'active' : ''}`}>
        Overview
      </a>
      <a href={`/genres/${genre.slug}?tab=reviews`} class={`tab-link ${activeTab === 'reviews' ? 'active' : ''}`}>
        Reviews
        {recentReviews.length > 0 && <span class="tab-count">{recentReviews.length}</span>}
      </a>
      <a href={`/genres/${genre.slug}?tab=stats`} class={`tab-link ${activeTab === 'stats' ? 'active' : ''}`}>
        Stats
      </a>
    </nav>

    <!-- ── OVERVIEW TAB ── -->
    <div class={`tab-panel ${activeTab === 'overview' ? 'active' : ''}`}>

      {(genreDescription || relatedGenres.length > 0) && (
        <div class="about-grid">
          <div>
            {genreDescription && (
              <>
                <p class="description collapsed" id="desc">{genreDescription}</p>
                <button class="read-more-btn" id="readMoreBtn" onclick="toggleDesc()">Read more →</button>
              </>
            )}
          </div>
          <div class="details-card">
            <div class="detail-row">
              <span class="detail-label">Games</span>
              <span class="detail-value">{allGames.length.toLocaleString()} on Chekpoint</span>
            </div>
            {totalReviews > 0 && (
              <div class="detail-row">
                <span class="detail-label">Reviews</span>
                <span class="detail-value">{totalReviews.toLocaleString()} total</span>
              </div>
            )}
            {topRated.length > 0 && (
              <div class="detail-row">
                <span class="detail-label">Top game</span>
                <span class="detail-value">{topRated[0].title}</span>
              </div>
            )}
            {years.length > 0 && (
              <div class="detail-row">
                <span class="detail-label">Active</span>
                <span class="detail-value">{years[years.length - 1]} – {years[0]}</span>
              </div>
            )}
          </div>
        </div>
      )}

      {topRated.length > 0 && (
        <div class="section">
          <div class="section-header">
            <span class="section-title">Top Rated</span>
            <span class="section-count">{topRated.length} games</span>
          </div>
          <div class="game-row" id="topRatedRow"></div>
          <div class="row-nav">
            <button class="row-arrow" id="topPrev" onclick="pageRow('top',-1)">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12L6 8l4-4"/></svg>
            </button>
            <button class="row-arrow" id="topNext" onclick="pageRow('top',1)">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 12l4-4-4-4"/></svg>
            </button>
            <span class="row-nav-info" id="topInfo"></span>
          </div>
        </div>
      )}

      {years.length > 0 && (
        <div class="section">
          <div class="section-header">
            <span class="section-title">Games by Year</span>
            <span class="section-count" id="yearPanelCount"></span>
          </div>
          <div class="pill-strip-wrap">
            <button class="strip-arrow" id="yearStripPrev" onclick="scrollYearStrip(-1)" disabled>
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12L6 8l4-4"/></svg>
            </button>
            <div class="year-pill-strip" id="yearPillStrip"></div>
            <button class="strip-arrow" id="yearStripNext" onclick="scrollYearStrip(1)">
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 12l4-4-4-4"/></svg>
            </button>
          </div>
          <div class="year-panel-header">
            <span class="year-panel-label" id="yearPanelLabel"></span>
            <span class="year-panel-count" id="yearPanelTotal"></span>
          </div>
          <div class="game-row" id="yearGamesRow"></div>
          <div class="row-nav">
            <button class="row-arrow" id="yearPrev" onclick="pageRow('year',-1)">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12L6 8l4-4"/></svg>
            </button>
            <button class="row-arrow" id="yearNext" onclick="pageRow('year',1)">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 12l4-4-4-4"/></svg>
            </button>
            <span class="row-nav-info" id="yearInfo"></span>
          </div>
        </div>
      )}

      {relatedGenres.length > 0 && (
        <div class="section">
          <div class="section-header">
            <span class="section-title">Related Genres</span>
          </div>
          <div class="related-genres">
            {relatedGenres.map((g: any) => (
              <a href={`/genres/${g.slug}`} class="genre-chip">{g.name}</a>
            ))}
          </div>
        </div>
      )}

      {allGames.length === 0 && (
        <div class="empty-state">
          <div class="empty-title">No games yet</div>
          <p>We don't have any {genre.name} games in our database yet.</p>
        </div>
      )}
    </div>

    <!-- ── REVIEWS TAB ── -->
    <div class={`tab-panel ${activeTab === 'reviews' ? 'active' : ''}`}>
      <div class="section-header" style="margin-bottom:20px">
        <span class="section-title">Recent Reviews</span>
        <span class="section-count">{recentReviews.length} {recentReviews.length === 1 ? 'review' : 'reviews'}</span>
      </div>

      {recentReviews.length === 0 ? (
        <div class="empty-state">
          <div class="empty-title">No reviews yet</div>
          <p>Be the first to review a {genre.name} game.</p>
        </div>
      ) : (
        <>
          <div class="reviews-toolbar">
            <button class="sort-tab active" onclick="sortGenreReviews('recent',this)">Recent</button>
            <button class="sort-tab" onclick="sortGenreReviews('highest',this)">Highest</button>
            <button class="sort-tab" onclick="sortGenreReviews('lowest',this)">Lowest</button>
          </div>
          <div id="genreReviewsList">
            {recentReviews.map((review: any) => (
              <div class="review-card" data-score={review.score} data-date={review.created_at}>
                {review.games && (
                  <a href={`/games/${review.games.slug}`} class="review-game-link">
                    {review.games.cover_img_url
                      ? <img class="review-game-cover" src={igdbImage(review.games.cover_img_url, 't_cover_small') ?? ''} alt="" />
                      : <div style="width:26px;height:34px;border-radius:4px;background:var(--tag-bg);flex-shrink:0"></div>
                    }
                    <span class="review-game-title">{review.games.title}</span>
                  </a>
                )}
                <div class="review-top">
                  <div class="avatar">
                    {review.profiles?.avatar_url
                      ? <img src={review.profiles.avatar_url} alt={review.profiles.username} />
                      : getInitials(review.profiles?.username ?? '??')
                    }
                  </div>
                  <div class="reviewer-info">
                    <a href={`/reviewers/${review.profiles?.username}`} class="reviewer-name">
                      @{review.profiles?.username ?? 'unknown'}
                    </a>
                    <div class="reviewer-meta"><span>{timeAgo(review.created_at)}</span></div>
                  </div>
                  <div class={`score-badge score-${scoreClass(review.score)}`}>{review.score}</div>
                </div>
                {review.title && <div class="review-title">{review.title}</div>}
                {review.body && (
                  <>
                    <div class="review-body collapsed" id={`grb-${review.id}`}>{review.body}</div>
                    <div class="review-footer">
                      <button class="expand-btn" onclick={`toggleGenreReview('${review.id}',this)`}>Read more →</button>
                    </div>
                  </>
                )}
              </div>
            ))}
          </div>
        </>
      )}
    </div>

    <!-- ── STATS TAB ── -->
    <div class={`tab-panel ${activeTab === 'stats' ? 'active' : ''}`}>
      {totalReviews === 0 ? (
        <div class="empty-state">
          <div class="empty-title">No stats yet</div>
          <p>Stats will appear once games are reviewed.</p>
        </div>
      ) : (
        <div id="genreStatsContent"></div>
      )}
    </div>

  </div>

  <!-- ── SCRIPTS — identical pattern to platform page ── -->
  <script is:inline define:vars={{ topRatedJson, byYearJson, yearsJson, yearGameCountsJson, yearAvgScoresJson, genreStatsJson, activeTab, accentLight, accentDark, accentRgb }}>

    var topRated     = JSON.parse(topRatedJson);
    var byYear       = JSON.parse(byYearJson);
    var years        = JSON.parse(yearsJson);

    var scoreBorderColors = {
      'badge-perfect': '#ffffff',
      'badge-great':   '#4ade80',
      'badge-teal':    '#2dd4bf',
      'badge-good':    '#60a5fa',
      'badge-mid':     '#fbbf24',
      'badge-orange':  '#fb923c',
      'badge-low':     '#f87171',
    };

    // ── CARD RENDERER — same as platform page ──
    function makeCard(g, showRank, rank) {
      var cv = g.cover
        ? '<img src="' + g.cover + '" alt="" loading="lazy"/>'
        : '<div class="game-cover-placeholder">🎮</div>';
      var bd = g.score
        ? '<div class="game-score-badge ' + g.badge + '">' + g.score + '</div>'
        : '';
      var rk = (showRank && rank)
        ? '<div class="rank-badge">#' + rank + '</div>'
        : '';
      var borderBottom = (g.badge && scoreBorderColors[g.badge])
        ? 'border-bottom:2px solid ' + scoreBorderColors[g.badge] + ';'
        : '';
      return '<a href="/games/' + g.slug + '" class="game-card" style="' + borderBottom + '">'
        + '<div class="game-cover">' + cv + rk + '</div>'
        + bd
        + '<div class="game-info">'
        + '<div class="game-title-text">' + g.title + '</div>'
        + (g.reviews ? '<div class="game-review-count">' + g.reviews + '</div>' : '')
        + '</div></a>';
    }

    // ── PAGINATED ROWS — same as platform page ──
    var rows = {};

    function initRow(key, data, rowId, prevId, nextId, infoId, showRank) {
      rows[key] = { data: data, page: 0, pageSize: 10, rowId: rowId, prevId: prevId, nextId: nextId, infoId: infoId, showRank: showRank || false };
      renderRow(key);
    }

    function renderRow(key) {
      var r     = rows[key];
      var start = r.page * r.pageSize;
      var slice = r.data.slice(start, start + r.pageSize);
      var el    = document.getElementById(r.rowId);
      if (el) el.innerHTML = slice.map(function(g, i) {
        return makeCard(g, r.showRank, r.showRank ? (start + i + 1) : null);
      }).join('');
      var tot  = Math.ceil(r.data.length / r.pageSize);
      var prev = document.getElementById(r.prevId);
      var next = document.getElementById(r.nextId);
      var info = document.getElementById(r.infoId);
      if (prev) prev.disabled = r.page === 0;
      if (next) next.disabled = r.page >= tot - 1;
      if (info) info.textContent = (r.page + 1) + ' / ' + tot;
    }

    function pageRow(key, dir) {
      var r   = rows[key];
      if (!r) return;
      var tot = Math.ceil(r.data.length / r.pageSize);
      r.page  = Math.max(0, Math.min(tot - 1, r.page + dir));
      renderRow(key);
    }
    window.pageRow = pageRow;

    function scrollYearStrip(dir) {
      var strip = document.getElementById('yearPillStrip');
      if (!strip) return;
      strip.scrollBy({ left: dir * 200, behavior: 'smooth' });
    }
    window.scrollYearStrip = scrollYearStrip;

    function updateStripArrows() {
      var strip = document.getElementById('yearPillStrip');
      var prev = document.getElementById('yearStripPrev');
      var next = document.getElementById('yearStripNext');
      if (!strip || !prev || !next) return;
      prev.disabled = strip.scrollLeft <= 0;
      next.disabled = strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 1;
    }

    if (topRated.length > 0)     initRow('top', topRated,     'topRatedRow',    'topPrev', 'topNext', 'topInfo', true);

    // ── YEAR PILL STRIP — pills oldest→newest so strip scrolls both directions ──
    if (years.length > 0) {
      var activeYear     = years[0]; // default: most recent
      var yearGameCounts = JSON.parse(yearGameCountsJson);
      var yearAvgScores  = JSON.parse(yearAvgScoresJson);
      var yearPills      = {};

      var strip = document.getElementById('yearPillStrip');
      if (strip) {
        years.forEach(function(y) {
          var avg = yearAvgScores[y];
          var dot = avg != null
            ? (avg >= 8 ? '#22c55e' : avg >= 6 ? '#3b82f6' : avg >= 4 ? '#f59e0b' : '#ef4444')
            : '#71717a';

          var pill = document.createElement('button');
          pill.className = 'year-pill';

          var dotEl   = document.createElement('span');
          dotEl.className = 'year-pill-dot';
          dotEl.style.background = dot;

          var labelEl = document.createElement('span');
          labelEl.className = 'year-pill-label';
          labelEl.textContent = String(y);

          var countEl = document.createElement('span');
          countEl.className = 'year-pill-count';
          countEl.textContent = String(yearGameCounts[y] || 0);

          pill.appendChild(dotEl);
          pill.appendChild(labelEl);
          pill.appendChild(countEl);

          pill.addEventListener('click', function() { selectYear(y); });
          yearPills[y] = pill;
          strip.appendChild(pill);
        });
        strip.addEventListener('scroll', updateStripArrows);
        updateStripArrows();
      }

      function selectYear(y) {
        activeYear = y;
        Object.keys(yearPills).forEach(function(yr) {
          yearPills[yr].classList.toggle('active', parseInt(yr) === y);
        });
        // Use rAF so offsetLeft is measured after layout is complete
        requestAnimationFrame(function() {
          if (strip && yearPills[y]) {
            var pill   = yearPills[y];
            var target = pill.offsetLeft - (strip.clientWidth / 2) + (pill.offsetWidth / 2);
            strip.scrollTo({ left: Math.max(0, target), behavior: 'smooth' });
          }
        });
        var games      = byYear[y] || [];
        var totalCount = yearGameCounts[y] || games.length;
        var lbl = document.getElementById('yearPanelLabel');
        var tot = document.getElementById('yearPanelTotal');
        var cnt = document.getElementById('yearPanelCount');
        if (lbl) lbl.textContent = String(y);
        if (tot) tot.textContent = totalCount + ' games';
        if (cnt) cnt.textContent = totalCount + ' games';
        rows['year'] = { data: games, page: 0, pageSize: 10, rowId: 'yearGamesRow', prevId: 'yearPrev', nextId: 'yearNext', infoId: 'yearInfo', showRank: false };
        renderRow('year');
      }

      // Delay initial selection so DOM is fully painted before measuring
      setTimeout(function() { selectYear(activeYear); }, 50);
    }

    // ── HELPERS ──
    function toggleDesc() {
      var d = document.getElementById('desc');
      var b = document.getElementById('readMoreBtn');
      if (!d || !b) return;
      d.classList.toggle('collapsed');
      b.textContent = d.classList.contains('collapsed') ? 'Read more →' : 'Read less ↑';
    }
    window.toggleDesc = toggleDesc;

    function sortGenreReviews(type, btn) {
      document.querySelectorAll('.sort-tab').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var list = document.getElementById('genreReviewsList');
      if (!list) return;
      var cards = Array.from(list.querySelectorAll('.review-card'));
      cards.sort(function(a, b) {
        if (type === 'highest') return parseFloat(b.dataset.score) - parseFloat(a.dataset.score);
        if (type === 'lowest')  return parseFloat(a.dataset.score) - parseFloat(b.dataset.score);
        return new Date(b.dataset.date).getTime() - new Date(a.dataset.date).getTime();
      });
      cards.forEach(function(card) { list.appendChild(card); });
    }
    window.sortGenreReviews = sortGenreReviews;

    function toggleGenreReview(id, btn) {
      var b = document.getElementById('grb-' + id);
      if (!b) return;
      b.classList.toggle('collapsed');
      btn.textContent = b.classList.contains('collapsed') ? 'Read more →' : 'Read less ↑';
    }
    window.toggleGenreReview = toggleGenreReview;

    // ── STATS TAB — same buildStats pattern as platform page ──
    var gs = JSON.parse(genreStatsJson);

    function buildGenreStats() {
      var el = document.getElementById('genreStatsContent');
      if (!el) return;
      var html = '';

      if (gs.gameAvg) {
        var sColor = gs.gameAvg >= 9 ? '#4ade80' : gs.gameAvg >= 7 ? '#60a5fa' : gs.gameAvg >= 5 ? '#fbbf24' : '#f87171';
        html += '<div style="background:var(--bg-card);border:1px solid ' + sColor + '44;border-radius:12px;padding:16px 20px;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:8px">';
        html += '<div style="position:absolute;inset:0;background:linear-gradient(to right,' + sColor + '10 0%,transparent 55%);pointer-events:none"></div>';
        html += '<div style="position:relative"><div style="font-size:11px;font-weight:700;color:' + sColor + ';text-transform:uppercase;letter-spacing:.1em;margin-bottom:3px;opacity:.85">Avg game score</div>';
        html += '<div style="font-size:11px;color:var(--text-tertiary)">across all reviewed games</div></div>';
        html += '<div style="font-family:\'DM Serif Display\',serif;font-size:52px;letter-spacing:-2px;line-height:1;color:' + sColor + ';position:relative;flex-shrink:0">' + gs.gameAvg.toFixed(1) + '</div></div>';
      }

      html += '<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:10px">';
      var mini = [
        { lbl: 'Total reviews',   val: gs.totalReviews.toLocaleString(),     sub: 'across all games',                color: '#6050c8' },
        { lbl: 'Reviewed games',  val: gs.reviewedGameCount.toLocaleString(), sub: 'of ' + gs.gameCount.toLocaleString() + ' total', color: '#60a5fa' },
        { lbl: 'Avg score',       val: gs.gameAvg ? gs.gameAvg.toFixed(1) : '—', sub: 'per-game average',           color: gs.gameAvg ? (gs.gameAvg >= 9 ? '#4ade80' : gs.gameAvg >= 7 ? '#60a5fa' : gs.gameAvg >= 5 ? '#fbbf24' : '#f87171') : '#484644' },
      ];
      mini.forEach(function(sc) {
        html += '<div style="background:var(--bg-card);border:1px solid ' + sc.color + '33;border-radius:12px;padding:12px 14px;position:relative;overflow:hidden">';
        html += '<div style="position:absolute;inset:0;background:linear-gradient(135deg,' + sc.color + '0d 0%,transparent 70%);pointer-events:none"></div>';
        html += '<div style="font-size:10px;font-weight:700;color:' + sc.color + ';text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px;opacity:.85;position:relative">' + sc.lbl + '</div>';
        html += '<div style="font-family:\'DM Serif Display\',serif;font-size:32px;letter-spacing:-.5px;line-height:1;color:' + sc.color + ';position:relative;margin-bottom:3px">' + sc.val + '</div>';
        html += '<div style="font-size:10px;color:var(--text-tertiary);position:relative">' + sc.sub + '</div></div>';
      });
      html += '</div>';

      var hasDist = gs.gameScoreDist && gs.gameScoreDist.some(function(v) { return v > 0; });
      var hasYear = gs.reviewsByYearData && gs.reviewsByYearData.length > 0;
      if (hasDist || hasYear) {
        var cols = (hasDist && hasYear) ? '3fr 2fr' : '1fr';
        html += '<div style="display:grid;grid-template-columns:' + cols + ';gap:8px;margin-bottom:10px">';
        if (hasDist) {
          var maxDist  = Math.max.apply(null, gs.gameScoreDist.concat([1]));
          var barColors = ['#f87171','#f87171','#fb923c','#fb923c','#fbbf24','#fbbf24','#60a5fa','#2dd4bf','#4ade80','#4ade80'];
          html += '<div style="background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:12px 14px">';
          html += '<div style="font-size:9px;font-weight:700;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:.12em;margin-bottom:10px">Score distribution — per-game avg</div>';
          html += '<div style="display:flex;gap:4px;align-items:flex-end;height:60px">';
          gs.gameScoreDist.forEach(function(count, i) {
            var h = Math.max(4, (count / maxDist) * 52);
            html += '<div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:3px" title="~' + (i+1) + '/10: ' + count + ' games">';
            html += '<div style="width:100%;border-radius:4px 4px 0 0;height:' + h + 'px;background:' + barColors[i] + ';opacity:.7;min-height:4px"></div>';
            html += '<div style="font-size:9px;color:var(--text-tertiary);font-weight:500">' + (i+1) + '</div></div>';
          });
          html += '</div></div>';
        }
        if (hasYear) {
          var maxYear = Math.max.apply(null, gs.reviewsByYearData.map(function(d) { return d.count; }).concat([1]));
          html += '<div style="background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:12px 14px">';
          html += '<div style="font-size:9px;font-weight:700;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:.12em;margin-bottom:10px">Reviews by release year</div>';
          html += '<div style="display:flex;gap:3px;align-items:flex-end;height:60px;overflow:hidden">';
          gs.reviewsByYearData.forEach(function(d) {
            var h = Math.max(4, (d.count / maxYear) * 52);
            html += '<div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;min-width:0" title="' + d.year + ': ' + d.count + ' reviews">';
            html += '<div style="width:100%;border-radius:4px 4px 0 0;height:' + h + 'px;background:#6050c8;opacity:.7;min-height:4px"></div>';
            html += '<div style="font-size:8px;color:var(--text-tertiary);font-weight:500">' + (d.year % 100) + '</div></div>';
          });
          html += '</div></div>';
        }
        html += '</div>';
      }

      if (gs.topReviewedGames && gs.topReviewedGames.length > 0) {
        html += '<div style="background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:12px 14px;margin-bottom:10px">';
        html += '<div style="font-size:9px;font-weight:700;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:.12em;margin-bottom:10px">Most reviewed games</div>';
        gs.topReviewedGames.forEach(function(g, i) {
          html += '<a href="/games/' + g.slug + '" style="display:flex;align-items:center;gap:10px;padding:10px 0;' + (i > 0 ? 'border-top:1px solid var(--border-subtle);' : '') + 'text-decoration:none;transition:opacity .15s" onmouseover="this.style.opacity=\'.75\'" onmouseout="this.style.opacity=\'1\'">';
          if (g.cover) {
            html += '<img src="' + g.cover + '" alt="" style="width:32px;height:42px;border-radius:5px;object-fit:cover;flex-shrink:0;border:1px solid var(--border)" loading="lazy">';
          } else {
            html += '<div style="width:32px;height:42px;border-radius:5px;background:var(--tag-bg);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0">🎮</div>';
          }
          html += '<div style="flex:1;min-width:0"><div style="font-size:13px;font-weight:500;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">' + g.title + '</div>';
          html += '<div style="font-size:11px;color:var(--text-tertiary);margin-top:2px">' + g.reviews + ' ' + (g.reviews === 1 ? 'review' : 'reviews') + '</div></div>';
          if (g.avg) {
            var avgColor = parseFloat(g.avg) >= 9 ? '#4ade80' : parseFloat(g.avg) >= 7 ? '#60a5fa' : parseFloat(g.avg) >= 5 ? '#fbbf24' : '#f87171';
            html += '<div style="width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;font-family:\'Century Schoolbook\',Georgia,serif;color:' + avgColor + ';background:' + avgColor + '1a;border:1px solid ' + avgColor + '33;flex-shrink:0">' + g.avg + '</div>';
          }
          html += '</a>';
        });
        html += '</div>';
      }

      el.innerHTML = html;
    }

    if (activeTab === 'stats') buildGenreStats();

    // ── THEME — same as platform page ──
    function toggleTheme() {
      var h = document.documentElement;
      var n = h.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      h.setAttribute('data-theme', n);
      localStorage.setItem('theme', n);
      h.style.setProperty('--game-accent', n === 'light' ? accentLight : accentDark);
      h.style.setProperty('--accent-rgb', accentRgb);
      updateIcon(n);
      if (activeTab === 'stats') {
        var el = document.getElementById('genreStatsContent');
        if (el) { el.innerHTML = ''; buildGenreStats(); }
      }
    }
    function updateIcon(t) {
      var i = document.getElementById('themeIcon');
      if (!i) return;
      i.innerHTML = t === 'dark'
        ? '<path d="M15 10.5A7 7 0 016.5 3a7 7 0 100 12 7 7 0 008.5-4.5z"/>'
        : '<circle cx="9" cy="9" r="3.5"/><path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.22 3.22l1.42 1.42M13.36 13.36l1.42 1.42M13.36 4.64l1.42-1.42M3.22 14.78l1.42-1.42"/>';
    }
    window.toggleTheme = function() {
      toggleTheme();
      var m = document.getElementById('meta-theme-color');
      var n = document.documentElement.getAttribute('data-theme');
      if (m) m.content = n === 'dark' ? '#0f0f0e' : '#f9f8f6';
    };

    var saved = document.documentElement.getAttribute('data-theme') || 'dark';
    updateIcon(saved);

  </script>

</body>
</html>
