---
export const prerender = false;
import { createSupabaseServerClientFromContext, getSupabaseAdmin } from "../utils/database";
import Layout from "../components/Layout.astro";
import { IMAGE_EMOTE_MAP } from "../utils/reactions";

// User client — only for session check
const serverClient = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await serverClient.auth.getUser();

if (!user) return Astro.redirect('/signin');

// Admin client — bypasses RLS for all DB operations
const db = getSupabaseAdmin() as any;

const { data: profile } = await db
  .from('profiles').select('id, username, avatar_url').eq('auth_user_id', user.id).single();

if (!profile) return Astro.redirect('/signin');

// Fetch last 50 notifications with joined data
const { data: rawNotifs } = await db
  .from('notifications')
  .select(`
    id, type, read, created_at, reaction_type,
    reviews ( id, title, score, games ( id, title, slug, cover_img_url ) ),
    actor:actor_profile_id ( id, username, avatar_url ),
    games ( id, title, slug, cover_img_url ),
    groups ( id, name ),
    lists ( id, title, cover_image_url ),
    comment:comment_id ( id, body, review_id ),
    recommendation:recommendation_id ( id, source_game:games!source_game_id ( title ), target_game:games!target_game_id ( title ) ),
    forum:forum_post_id ( id, title )
  `)
  .eq('profile_id', profile.id)
  .order('created_at', { ascending: false })
  .limit(50);

// Cross-reference group_join_request notifications against live rows in group_join_requests.
// If the underlying request was already processed (deleted), filter the notification out
// so stale Accept/Reject buttons never render.
const rawNotifList = rawNotifs ?? [];
const joinRequestNotifs = rawNotifList.filter((n: any) => n.type === 'group_join_request');
const liveRequestKeys = new Set<string>();

if (joinRequestNotifs.length > 0) {
  const groupIds = [...new Set(joinRequestNotifs.map((n: any) => n.groups?.id).filter(Boolean))] as string[];
  const { data: liveReqs } = await db
    .from('group_join_requests')
    .select('group_id, profile_id')
    .in('group_id', groupIds);
  for (const r of liveReqs ?? []) {
    liveRequestKeys.add(`${r.group_id}:${r.profile_id}`);
  }
}

// Cross-reference group_invite notifications against live pending invites for this user
const inviteNotifs = rawNotifList.filter((n: any) => n.type === 'group_invite');
const liveInviteGroupIds = new Set<string>();

if (inviteNotifs.length > 0) {
  const inviteGroupIds = [...new Set(inviteNotifs.map((n: any) => n.groups?.id).filter(Boolean))] as string[];
  const { data: liveInvites } = await db
    .from('group_invites')
    .select('group_id')
    .eq('invited_profile_id', profile.id)
    .eq('status', 'pending')
    .in('group_id', inviteGroupIds);
  for (const inv of liveInvites ?? []) liveInviteGroupIds.add(inv.group_id);
}

const notifications = rawNotifList.filter((n: any) => {
  if (n.type === 'group_join_request') return liveRequestKeys.has(`${n.groups?.id}:${n.actor?.id}`);
  if (n.type === 'group_invite') return liveInviteGroupIds.has(n.groups?.id);
  return true;
});

// Whether any notification is still unread (used to show the "Mark all as read" button)
const hasUnread = notifications.some((n: any) => !n.read);
// Count unread BEFORE mark-as-read runs — this is what the badge should display
const unreadCount = notifications.filter((n: any) => !n.read).length;

// For new_follower notifications, check which actors the current user already follows back
const newFollowerActorIds = notifications
  .filter((n: any) => n.type === 'new_follower' && n.actor?.id)
  .map((n: any) => n.actor.id);

const followingBackIds = new Set<string>();
if (newFollowerActorIds.length > 0) {
  const { data: followBacks } = await db
    .from('follows').select('following_id')
    .eq('follower_id', profile.id)
    .in('following_id', newFollowerActorIds);
  for (const f of followBacks ?? []) followingBackIds.add(f.following_id);
}

// Mark all unread as read now that the user is viewing the page
await db.from('notifications')
  .update({ read: true })
  .eq('profile_id', profile.id)
  .eq('read', false);

// Never serve a cached version — mark-as-read must always execute
Astro.response.headers.set('Cache-Control', 'no-store');

function timeAgo(dateStr: string): string {
  const diff = Math.floor((Date.now() - new Date(dateStr).getTime()) / 1000);
  if (diff < 60) return `${diff}s ago`;
  if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
  if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
  if (diff < 604800) return `${Math.floor(diff / 86400)}d ago`;
  return `${Math.floor(diff / 604800)}w ago`;
}

function igdbThumb(url: string | null | undefined) {
  if (!url) return null;
  const clean = url.startsWith('//') ? `https:${url}` : url;
  return clean.replace(/t_[a-z0-9_]+/, 't_thumb');
}

function getInitials(u: string) { return u.slice(0, 2).toUpperCase(); }
---

<Layout
  title="Notifications — Chekpoint"
  isLoggedIn={true}
  currentProfile={profile}
  activeNav="notifications"
  variant="two-col"
>
  <main class="feed notif-main">
    <div class="notif-header">
      <h1 class="notif-title">Notifications</h1>
      {unreadCount > 0 && (
        <span class="notif-count">{unreadCount}</span>
      )}
      {hasUnread && (
        <button id="mark-all-read" class="notif-mark-all" type="button">
          Mark all as read
        </button>
      )}
    </div>

    {notifications.length === 0 ? (
      <div class="notif-empty">
        <div class="notif-empty-icon">🔔</div>
        <div class="notif-empty-title">Nothing yet</div>
        <p class="notif-empty-body">
          Add games to your watchlist or turn on notifications for reviewers you follow —
          you'll hear about it here when they post.
        </p>
      </div>
    ) : (
      <div class="notif-list">
        {notifications.map((n: any) => {
          const game = n.reviews?.games ?? n.games;
          const actor = n.actor;
          const review = n.reviews;
          const group = n.groups;
          const list = n.lists;
          const comment = n.comment;
          const forumPost = n.forum;
          const isForumComment = n.type === 'forum_comment';
          const isForumReply = n.type === 'forum_reply';
          const isForum = isForumComment || isForumReply;
          const thumb = igdbThumb(game?.cover_img_url);
          const isWatchlist = n.type === 'watchlist_review';
          const isGroupInvite = n.type === 'group_invite';
          const isGroupJoinRequest = n.type === 'group_join_request';
          const isGroupJoinAccepted = n.type === 'group_join_accepted';
          const isGroupJoinRejected = n.type === 'group_join_rejected';
          const isNewFollower = n.type === 'new_follower';
          const isUpvote = n.type === 'review_upvote';
          const isDownvote = n.type === 'review_downvote';
          const isCommentUpvote = n.type === 'comment_upvote';
          const isCommentDownvote = n.type === 'comment_downvote';
          const isReaction = n.type === 'review_reaction';
          const isCommentReaction = n.type === 'comment_reaction';
          // ── Recommendation notification types ──
          const rec = n.recommendation;
          const recPair = rec ? `${rec.source_game?.title ?? 'a game'} → ${rec.target_game?.title ?? 'another'}` : 'a recommendation';
          const isFollowRec = n.type === 'follow_recommendation';
          const isRecUpvote = n.type === 'recommendation_upvote';
          const isRecDownvote = n.type === 'recommendation_downvote';
          const isRecReaction = n.type === 'recommendation_reaction';
          const isRecComment = n.type === 'recommendation_comment';
          const isRecCommentUpvote = n.type === 'recommendation_comment_upvote';
          const isRecCommentDownvote = n.type === 'recommendation_comment_downvote';
          const isRecCommentReaction = n.type === 'recommendation_comment_reaction';
          const isRec = isFollowRec || isRecUpvote || isRecDownvote || isRecReaction || isRecComment || isRecCommentUpvote || isRecCommentDownvote || isRecCommentReaction;
          const recReactionPath = (isRecReaction || isRecCommentReaction) && n.reaction_type ? IMAGE_EMOTE_MAP[n.reaction_type] : null;
          // ── List notification types ──
          const isListComment = n.type === 'list_comment';
          const isListReaction = n.type === 'list_reaction';
          const isListUpvote = n.type === 'list_upvote';
          const isListDownvote = n.type === 'list_downvote';
          const isListCommentReaction = n.type === 'list_comment_reaction';
          const isListCommentUpvote = n.type === 'list_comment_upvote';
          const isListCommentDownvote = n.type === 'list_comment_downvote';
          const isListVote = isListUpvote || isListDownvote;
          const isListCommentVote = isListCommentUpvote || isListCommentDownvote;
          const isListType = isListComment || isListReaction || isListVote || isListCommentReaction || isListCommentVote;
          const isVote = isUpvote || isDownvote || isCommentUpvote || isCommentDownvote;
          const alreadyFollowingBack = isNewFollower && actor?.id && followingBackIds.has(actor.id);
          const reactionEmotePath = isReaction && n.reaction_type ? IMAGE_EMOTE_MAP[n.reaction_type] : null;
          const commentReactionPath = isCommentReaction && n.reaction_type ? IMAGE_EMOTE_MAP[n.reaction_type] : null;
          const listReactionEmotePath = (isListReaction || isListCommentReaction) && n.reaction_type ? IMAGE_EMOTE_MAP[n.reaction_type] : null;

          const commentReviewId = comment?.review_id ?? review?.id;
          const href = isNewFollower
            ? `/reviewers/${actor?.username ?? ''}`
            : isForum
              ? (forumPost?.id ? `/updates/${forumPost.id}` : '#')
            : isRec
              ? (rec?.id ? `/recommendations/${rec.id}` : '#')
              : isGroupInvite || isGroupJoinRequest || isGroupJoinAccepted || isGroupJoinRejected
                ? (group?.id ? `/groups/${group.id}` : '#')
                : (isCommentUpvote || isCommentDownvote)
                  ? (commentReviewId ? `/reviews/${commentReviewId}` : '#')
                  : isListType
                    ? (list?.id ? `/lists/${list.id}` : '#')
                    : review ? `/reviews/${review.id}` : (game ? `/games/${game.slug}` : '#');

          return (
            <a href={href} class={`notif-item${n.read ? '' : ' unread'}${isNewFollower ? ' notif-item-follower' : ''}`}>
              {/* Cover thumbnail / actor avatar / group icon */}
              <div class="notif-cover">
                {isNewFollower || isGroupJoinRequest || isRec || isForum ? (
                  actor?.avatar_url
                    ? <img src={actor.avatar_url} alt={actor.username} class="notif-actor-avatar" />
                    : <span class="notif-actor-initials">{getInitials(actor?.username ?? '?')}</span>
                ) : isGroupInvite || isGroupJoinAccepted || isGroupJoinRejected ? (
                  <span>👥</span>
                ) : isListType ? (
                  list?.cover_image_url
                    ? <img src={list.cover_image_url} alt={list.title} />
                    : <span>📋</span>
                ) : thumb ? (
                  <img src={thumb} alt={game?.title ?? ''} />
                ) : (
                  <span>🎮</span>
                )}
              </div>

              {/* Text */}
              <div class="notif-body">
                <div class="notif-text">
                  {isNewFollower ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> started following you
                    </>
                  ) : isForumComment ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> commented on your update
                      {forumPost && <> <strong>{forumPost.title}</strong></>}
                    </>
                  ) : isForumReply ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> replied to your comment
                      {forumPost && <> on <strong>{forumPost.title}</strong></>}
                    </>
                  ) : isFollowRec ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> you follow posted a recommendation
                      {' '}<strong>{recPair}</strong>
                    </>
                  ) : isRecUpvote ? (
                    <><strong>@{actor?.username ?? 'Someone'}</strong> upvoted your recommendation <strong>{recPair}</strong></>
                  ) : isRecDownvote ? (
                    <><strong>@{actor?.username ?? 'Someone'}</strong> downvoted your recommendation <strong>{recPair}</strong></>
                  ) : isRecComment ? (
                    <><strong>@{actor?.username ?? 'Someone'}</strong> commented on your recommendation <strong>{recPair}</strong></>
                  ) : isRecCommentUpvote ? (
                    <><strong>@{actor?.username ?? 'Someone'}</strong> upvoted your comment on a recommendation</>
                  ) : isRecCommentDownvote ? (
                    <><strong>@{actor?.username ?? 'Someone'}</strong> downvoted your comment on a recommendation</>
                  ) : isRecReaction ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> reacted{' '}
                      {recReactionPath
                        ? <img src={recReactionPath} class="notif-emote" alt={`:${n.reaction_type}:`} title={`:${n.reaction_type}:`} />
                        : n.reaction_type ? <span class="notif-reaction-code">:{n.reaction_type}:</span> : null}
                      {' '}to your recommendation <strong>{recPair}</strong>
                    </>
                  ) : isRecCommentReaction ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> reacted{' '}
                      {recReactionPath
                        ? <img src={recReactionPath} class="notif-emote" alt={`:${n.reaction_type}:`} title={`:${n.reaction_type}:`} />
                        : n.reaction_type ? <span class="notif-reaction-code">:{n.reaction_type}:</span> : null}
                      {' '}to your comment on a recommendation
                    </>
                  ) : isUpvote ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> upvoted your review
                      {game && <> of <strong>{game.title}</strong></>}
                    </>
                  ) : isDownvote ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> downvoted your review
                      {game && <> of <strong>{game.title}</strong></>}
                    </>
                  ) : isCommentUpvote ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> upvoted your comment
                      {game && <> on <strong>{game.title}</strong></>}
                    </>
                  ) : isCommentDownvote ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> downvoted your comment
                      {game && <> on <strong>{game.title}</strong></>}
                    </>
                  ) : isGroupInvite ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> invited you to join
                      {' '}<strong>{group?.name ?? 'a group'}</strong>
                    </>
                  ) : isGroupJoinRequest ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> requested to join
                      {' '}<strong>{group?.name ?? 'your group'}</strong>
                    </>
                  ) : isGroupJoinAccepted ? (
                    <>
                      Your request to join <strong>{group?.name ?? 'a group'}</strong> was accepted
                    </>
                  ) : isGroupJoinRejected ? (
                    <>
                      Your request to join <strong>{group?.name ?? 'a group'}</strong> was not accepted
                    </>
                  ) : isReaction ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> reacted{' '}
                      {reactionEmotePath
                        ? <img src={reactionEmotePath} class="notif-emote" alt={`:${n.reaction_type}:`} title={`:${n.reaction_type}:`} />
                        : n.reaction_type
                          ? <span class="notif-reaction-code">:{n.reaction_type}:</span>
                          : null}
                      {' '}to your review{game && <> of <strong>{game.title}</strong></>}
                    </>
                  ) : isCommentReaction ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> reacted{' '}
                      {commentReactionPath
                        ? <img src={commentReactionPath} class="notif-emote" alt={`:${n.reaction_type}:`} title={`:${n.reaction_type}:`} />
                        : n.reaction_type
                          ? <span class="notif-reaction-code">:{n.reaction_type}:</span>
                          : null}
                      {' '}to your comment{game && <> on <strong>{game.title}</strong></>}
                    </>
                  ) : isListComment ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> commented on your list
                      {list && <> <strong>{list.title}</strong></>}
                    </>
                  ) : isListReaction ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> reacted{' '}
                      {listReactionEmotePath
                        ? <img src={listReactionEmotePath} class="notif-emote" alt={`:${n.reaction_type}:`} title={`:${n.reaction_type}:`} />
                        : n.reaction_type
                          ? <span class="notif-reaction-code">:{n.reaction_type}:</span>
                          : null}
                      {' '}to your list{list && <> <strong>{list.title}</strong></>}
                    </>
                  ) : isListUpvote ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> upvoted your list
                      {list && <> <strong>{list.title}</strong></>}
                    </>
                  ) : isListDownvote ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> downvoted your list
                      {list && <> <strong>{list.title}</strong></>}
                    </>
                  ) : isListCommentReaction ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> reacted{' '}
                      {listReactionEmotePath
                        ? <img src={listReactionEmotePath} class="notif-emote" alt={`:${n.reaction_type}:`} title={`:${n.reaction_type}:`} />
                        : n.reaction_type
                          ? <span class="notif-reaction-code">:{n.reaction_type}:</span>
                          : null}
                      {' '}to your comment{list && <> on <strong>{list.title}</strong></>}
                    </>
                  ) : isListCommentUpvote ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> upvoted your comment
                      {list && <> on <strong>{list.title}</strong></>}
                    </>
                  ) : isListCommentDownvote ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> downvoted your comment
                      {list && <> on <strong>{list.title}</strong></>}
                    </>
                  ) : isWatchlist ? (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> reviewed
                      {' '}<strong>{game?.title ?? 'a game'}</strong> on your watchlist
                      {review?.score != null && (
                        <span class="notif-score"> — scored it {review.score}</span>
                      )}
                    </>
                  ) : (
                    <>
                      <strong>@{actor?.username ?? 'Someone'}</strong> you follow posted a new review
                      {game && <> of <strong>{game.title}</strong></>}
                      {review?.score != null && (
                        <span class="notif-score"> — {review.score}/10</span>
                      )}
                    </>
                  )}
                </div>
                <div class="notif-meta">
                  <span class={`notif-type-badge ${isNewFollower ? 'badge-new-follower' : (isUpvote || isListUpvote || isRecUpvote) ? 'badge-upvote' : (isDownvote || isListDownvote || isRecDownvote) ? 'badge-downvote' : (isCommentUpvote || isListCommentUpvote || isRecCommentUpvote) ? 'badge-upvote' : (isCommentDownvote || isListCommentDownvote || isRecCommentDownvote) ? 'badge-downvote' : (isGroupInvite || isGroupJoinRequest || isGroupJoinAccepted || isGroupJoinRejected) ? 'badge-group' : isWatchlist ? 'badge-watchlist' : (isReaction || isCommentReaction || isListReaction || isListCommentReaction || isRecReaction || isRecCommentReaction) ? 'badge-reaction' : (isListComment || isRecComment || isForum) ? 'badge-list' : 'badge-follow'}`}>
                    {isNewFollower ? 'New Follower' : isUpvote ? 'Upvote' : isDownvote ? 'Downvote' : isCommentUpvote ? 'Comment Upvote' : isCommentDownvote ? 'Comment Downvote' : isGroupInvite ? 'Group Invite' : isGroupJoinRequest ? 'Join Request' : isGroupJoinAccepted ? 'Joined!' : isGroupJoinRejected ? 'Not Accepted' : isWatchlist ? 'Watchlist' : isForumComment ? 'Update Comment' : isForumReply ? 'Update Reply' : isReaction ? 'Reaction' : isCommentReaction ? 'Comment Reaction' : isFollowRec ? 'Recommendation' : isRecUpvote ? 'Upvote' : isRecDownvote ? 'Downvote' : isRecReaction ? 'Reaction' : isRecComment ? 'Rec Comment' : isRecCommentUpvote ? 'Comment Upvote' : isRecCommentDownvote ? 'Comment Downvote' : isRecCommentReaction ? 'Comment Reaction' : isListComment ? 'List Comment' : isListReaction ? 'List Reaction' : isListUpvote ? 'List Upvote' : isListDownvote ? 'List Downvote' : isListCommentReaction ? 'List Comment Reaction' : isListCommentUpvote ? 'List Comment Upvote' : isListCommentDownvote ? 'List Comment Downvote' : 'Following'}
                  </span>
                  <span class="notif-time">{timeAgo(n.created_at)}</span>
                </div>
              </div>

              {isNewFollower && (
                <button
                  class={`follow-back-btn${alreadyFollowingBack ? ' following' : ''}`}
                  data-profile-id={actor?.id}
                  disabled={alreadyFollowingBack}
                  onclick="event.preventDefault();event.stopPropagation();"
                >
                  {alreadyFollowingBack ? 'Following' : 'Follow Back'}
                </button>
              )}

              {isGroupJoinRequest && (
                <div class="join-request-actions" onclick="event.preventDefault();event.stopPropagation();">
                  <button
                    class="join-accept-btn"
                    data-group-id={group?.id}
                    data-requester-id={actor?.id}
                    onclick="event.preventDefault();event.stopPropagation();handleJoinRequest(this,'accept')"
                  >Accept</button>
                  <button
                    class="join-reject-btn"
                    data-group-id={group?.id}
                    data-requester-id={actor?.id}
                    onclick="event.preventDefault();event.stopPropagation();handleJoinRequest(this,'reject')"
                  >Reject</button>
                </div>
              )}

              {isGroupInvite && (
                <div class="join-request-actions" onclick="event.preventDefault();event.stopPropagation();">
                  <button
                    class="join-accept-btn"
                    data-group-id={group?.id}
                    onclick="event.preventDefault();event.stopPropagation();handleGroupInvite(this,'accept')"
                  >Accept</button>
                  <button
                    class="join-reject-btn"
                    data-group-id={group?.id}
                    onclick="event.preventDefault();event.stopPropagation();handleGroupInvite(this,'decline')"
                  >Decline</button>
                </div>
              )}

              <button
                class="notif-delete-btn"
                data-notif-id={n.id}
                onclick="event.preventDefault();event.stopPropagation();deleteNotif(this)"
                title="Dismiss"
              >×</button>

              {!n.read && <div class="notif-dot"></div>}
            </a>
          );
        })}
      </div>
    )}
  </main>
</Layout>

<script>
  const markAllBtn = document.getElementById('mark-all-read');
  if (markAllBtn) {
    markAllBtn.addEventListener('click', async () => {
      markAllBtn.setAttribute('disabled', 'true');
      markAllBtn.textContent = 'Marking…';
      try {
        await fetch('/api/notifications/mark-read', { method: 'POST' });
      } catch (e) {
        // Best effort — the page already marks notifications read on view.
      }
      // Clear unread styling on the current page
      document.querySelectorAll('.notif-item.unread')
        .forEach((el) => el.classList.remove('unread'));
      document.querySelectorAll('.notif-dot')
        .forEach((el) => el.remove());
      markAllBtn.textContent = 'All read';
    });
  }

  function refreshNotifBadge(count: number) {
    const badge = document.getElementById('notifBadge') as HTMLElement | null;
    const dot = document.getElementById('mobileNotifDot') as HTMLElement | null;
    if (count > 0) {
      if (badge) { badge.textContent = count > 9 ? '9+' : String(count); badge.style.display = 'flex'; }
      if (dot) dot.style.display = 'block';
    } else {
      if (badge) badge.style.display = 'none';
      if (dot) dot.style.display = 'none';
    }
  }

  document.querySelectorAll('.follow-back-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const button = btn as HTMLButtonElement;
      const profileId = button.dataset.profileId;
      if (!profileId || button.disabled) return;
      button.disabled = true;
      button.textContent = 'Following…';
      try {
        const res = await fetch('/api/follows/toggle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ following_id: profileId }),
        });
        if (res.ok) {
          button.textContent = 'Following';
          button.classList.add('following');
          // Refresh the bell badge
          const countRes = await fetch('/api/notifications/count');
          const data = await countRes.json();
          refreshNotifBadge(data.unread ?? 0);
        } else {
          button.disabled = false;
          button.textContent = 'Follow Back';
        }
      } catch {
        button.disabled = false;
        button.textContent = 'Follow Back';
      }
    });
  });

  async function handleJoinRequest(btn: HTMLElement, action: string) {
    const groupId = (btn as HTMLElement).dataset.groupId;
    const requesterId = (btn as HTMLElement).dataset.requesterId;
    const actionsDiv = btn.closest('.join-request-actions') as HTMLElement | null;
    if (!groupId || !requesterId || !actionsDiv) return;

    actionsDiv.querySelectorAll('button').forEach((b) => { (b as HTMLButtonElement).disabled = true; });

    try {
      const res = await fetch('/api/groups/join-request/respond', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ group_id: groupId, requester_profile_id: requesterId, action }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Something went wrong');
      actionsDiv.innerHTML = `<span style="font-size:12px;color:var(--text-tertiary);font-style:italic">${action === 'accept' ? '✓ Accepted' : '✗ Rejected'}</span>`;
      // Remove the entire notification row after a brief moment — request is resolved
      const notifItem = btn.closest('.notif-item') as HTMLElement | null;
      if (notifItem) {
        setTimeout(() => {
          notifItem.style.transition = 'opacity 0.3s';
          notifItem.style.opacity = '0';
          setTimeout(() => notifItem.remove(), 320);
        }, 1000);
      }
    } catch (e) {
      actionsDiv.querySelectorAll('button').forEach((b) => { (b as HTMLButtonElement).disabled = false; });
      alert((e instanceof Error ? e.message : null) || 'Could not process request. Try from the group page.');
    }
  }
  (window as any).handleJoinRequest = handleJoinRequest;

  async function handleGroupInvite(btn: HTMLElement, action: string) {
    const groupId = (btn as HTMLElement).dataset.groupId;
    const actionsDiv = btn.closest('.join-request-actions') as HTMLElement | null;
    if (!groupId || !actionsDiv) return;

    actionsDiv.querySelectorAll('button').forEach((b) => { (b as HTMLButtonElement).disabled = true; });

    try {
      const res = await fetch('/api/groups/invite/respond', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ group_id: groupId, action }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Something went wrong');
      actionsDiv.innerHTML = `<span style="font-size:12px;color:var(--text-tertiary);font-style:italic">${action === 'accept' ? '✓ Joined!' : '✗ Declined'}</span>`;
      const notifItem = btn.closest('.notif-item') as HTMLElement | null;
      if (notifItem) {
        setTimeout(() => {
          notifItem.style.transition = 'opacity 0.3s';
          notifItem.style.opacity = '0';
          setTimeout(() => notifItem.remove(), 320);
        }, 1200);
      }
      if (action === 'accept') {
        // Redirect to the group after a brief pause
        setTimeout(() => {
          window.location.href = `/groups/${groupId}`;
        }, 1600);
      }
    } catch (e) {
      actionsDiv.querySelectorAll('button').forEach((b) => { (b as HTMLButtonElement).disabled = false; });
      alert((e instanceof Error ? e.message : null) || 'Could not process invite. Try from the group page.');
    }
  }
  (window as any).handleGroupInvite = handleGroupInvite;

  async function deleteNotif(btn: HTMLElement) {
    const notifId = (btn as HTMLElement).dataset.notifId;
    if (!notifId) return;
    const notifItem = btn.closest('.notif-item') as HTMLElement | null;
    // Optimistically remove from DOM
    if (notifItem) {
      notifItem.style.transition = 'opacity 0.2s';
      notifItem.style.opacity = '0';
      setTimeout(() => notifItem.remove(), 220);
    }
    try {
      await fetch('/api/notifications/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ notification_id: notifId }),
      });
    } catch (e) {
      // Best-effort — if it fails the item is already gone from the DOM
    }
  }
  (window as any).deleteNotif = deleteNotif;
</script>

