---
export const prerender = false;
import { createSupabaseServerClientFromContext } from "../utils/database";
import Layout from "../components/Layout.astro";

const serverClient = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await serverClient.auth.getUser();

if (!user) return Astro.redirect('/signin');

const { data: profile } = await serverClient
  .from('profiles')
  .select('id, username, avatar_url')
  .eq('auth_user_id', user.id)
  .single();

if (!profile) return Astro.redirect('/signin');

function getInitials(u: string) { return u.slice(0, 2).toUpperCase(); }
---

<Layout
  title="Settings — Chekpoint"
  isLoggedIn={true}
  currentProfile={profile}
  activeNav="settings"
  variant="two-col"
>
  <main class="settings-main">

    <div class="settings-header">
      <h1 class="settings-title">Settings</h1>
    </div>

    <!-- Account -->
    <section class="settings-section">
      <div class="settings-section-label">Account</div>
      <div class="settings-account-card">
        <div class="settings-avatar">
          {profile.avatar_url
            ? <img src={profile.avatar_url} alt={profile.username} />
            : <span>{getInitials(profile.username)}</span>
          }
        </div>
        <div class="settings-account-info">
          <div class="settings-username">@{profile.username}</div>
          <div class="settings-email">{user.email}</div>
        </div>
        <a href={`/reviewers/${profile.username}`} class="settings-view-profile">
          View profile →
        </a>
      </div>
    </section>

    <!-- Session -->
    <section class="settings-section">
      <div class="settings-section-label">Session</div>
      <div class="settings-row">
        <div class="settings-row-text">
          <div class="settings-row-label">Sign out</div>
          <div class="settings-row-sub">You'll need to sign back in to post or interact.</div>
        </div>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="settings-signout-btn">Sign out</button>
        </form>
      </div>
    </section>

  </main>
</Layout>

<style>
  .settings-main {
    min-width: 0;
    padding: 24px 24px 64px;
    max-width: 640px;
  }

  .settings-header {
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .settings-title {
    font-family: 'DM Serif Display', serif;
    font-size: 26px;
    font-weight: 400;
    color: var(--text-primary);
    margin: 0;
  }

  /* ── Sections ── */
  .settings-section {
    margin-bottom: 32px;
  }
  .settings-section-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    margin-bottom: 12px;
  }

  /* ── Account card ── */
  .settings-account-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
  }
  .settings-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--tag-bg);
    border: 1px solid var(--border);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
    overflow: hidden;
  }
  .settings-avatar img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .settings-account-info {
    flex: 1;
    min-width: 0;
  }
  .settings-username {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 3px;
  }
  .settings-email {
    font-size: 13px;
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .settings-view-profile {
    font-size: 13px;
    color: var(--text-tertiary);
    white-space: nowrap;
    transition: color 0.15s;
    flex-shrink: 0;
  }
  .settings-view-profile:hover { color: var(--text-primary); }

  /* ── Generic row ── */
  .settings-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
  }
  .settings-row-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 3px;
  }
  .settings-row-sub {
    font-size: 12px;
    color: var(--text-tertiary);
    line-height: 1.5;
  }

  /* ── Sign out button ── */
  .settings-signout-btn {
    background: none;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 500;
    font-family: inherit;
    color: var(--text-secondary);
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .settings-signout-btn:hover {
    border-color: #f87171;
    color: #f87171;
    background: rgba(248, 113, 113, 0.06);
  }

  @media (max-width: 768px) {
    .settings-main { padding: 16px 16px 80px; }
    .settings-account-card { flex-wrap: wrap; }
    .settings-view-profile { width: 100%; margin-top: 4px; }
  }
</style>
