---
export const prerender = false;
import { createSupabaseServerClientFromContext, getSupabaseAdmin } from "../utils/database";
import Layout from "../components/Layout.astro";
import { LIBRARY_SCRAPER_SOURCE } from "../utils/backloggd/libraryScraperSource";
import { getPageUser } from "../utils/pageAuth";

// Drag-to-bookmarks-bar bookmarklet: the library scraper as a javascript: URI.
// encodeURIComponent so it's safe inside a double-quoted href with no eval().
const backloggdLibraryBookmarklet = `javascript:${encodeURIComponent(LIBRARY_SCRAPER_SOURCE)}`;

const serverClient = createSupabaseServerClientFromContext(Astro);
const user = await getPageUser(Astro, serverClient);

if (!user) return Astro.redirect('/signin');

const db = getSupabaseAdmin() as any;
const { data: profile } = await db
  .from('profiles')
  .select('id, username, avatar_url, want_to_play_privacy, dropped_privacy, search_indexable, steam_id, steam_username, steam_synced_at, psn_account_id, psn_online_id, psn_synced_at, psn_trophies_synced_at, xbox_xuid, xbox_gamertag, xbox_synced_at, xbox_achievements_synced_at, username_changed_at, username_locked')
  .eq('auth_user_id', user.id)
  .single();

const steamStatus = Astro.url.searchParams.get('steam'); // 'connected' | 'error' | 'cancelled' | null
const psnStatus = Astro.url.searchParams.get('psn');     // 'connected' | 'expired' | null
const xboxStatus = Astro.url.searchParams.get('xbox');   // 'connected' | 'expired' | 'duplicate' | 'error' | null

if (!profile) return Astro.redirect('/signin');

const { data: adminRow } = await db
  .from('site_admins')
  .select('profile_id')
  .eq('profile_id', profile.id)
  .maybeSingle();
const isSiteAdmin = !!adminRow;

// Username-change availability (policy enforced server-side in
// /api/profile/change-username — this is just for the button/copy state).
const USERNAME_COOLDOWN_MS = 30 * 24 * 60 * 60 * 1000;
const USERNAME_SETTLING_MS = 48 * 60 * 60 * 1000;
const uChangedAt = profile.username_changed_at ? new Date(profile.username_changed_at).getTime() : null;
const uInSettling = uChangedAt !== null && Date.now() - uChangedAt < USERNAME_SETTLING_MS;
const uCooldownLeftMs = uChangedAt === null || uInSettling
  ? 0
  : Math.max(0, USERNAME_COOLDOWN_MS - (Date.now() - uChangedAt));
const usernameLocked = !!profile.username_locked;
const canChangeUsername = !usernameLocked && uCooldownLeftMs === 0;
const usernameCooldownDaysLeft = Math.ceil(uCooldownLeftMs / (24 * 60 * 60 * 1000));

function getInitials(u: string) { return u.slice(0, 2).toUpperCase(); }
---

<Layout
  title="Settings — Chekpoint"
  isLoggedIn={true}
  currentProfile={profile}
  activeNav="settings"
  variant="two-col"
>
  <main class="feed settings-main">

    <div class="settings-header">
      <h1 class="settings-title">Settings</h1>
    </div>

    <!-- Account -->
    <section class="settings-section" id="account">
      <div class="settings-section-label">Account</div>
      <div class="settings-account-card">
        <div class="settings-avatar">
          {profile.avatar_url
            ? <img src={profile.avatar_url} alt={profile.username} />
            : <span>{getInitials(profile.username)}</span>
          }
        </div>
        <div class="settings-account-info">
          <div class="settings-username">@{profile.username}</div>
          <div class="settings-email">{user.email}</div>
        </div>
        <a href={`/reviewers/${profile.username}`} class="settings-view-profile">
          View profile →
        </a>
      </div>
    </section>

    <!-- Username -->
    <section class="settings-section" id="username">
      <div class="settings-section-label">Username</div>
      <div class="settings-row" style="flex-direction:column;align-items:stretch;gap:12px">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:16px">
          <div class="settings-row-text">
            <div class="settings-row-label">Change username</div>
            <div class="settings-row-sub">
              {usernameLocked
                ? 'Username changes are disabled for this account. Contact support.'
                : !canChangeUsername
                  ? `You can change it again in ${usernameCooldownDaysLeft} day${usernameCooldownDaysLeft === 1 ? '' : 's'}.`
                  : uInSettling
                    ? 'You can still adjust it during the short window after your last change.'
                    : 'You can change it once every 30 days. 3–20 letters, numbers or underscores.'}
            </div>
          </div>
          <button type="button" class="settings-ghost-btn" id="unToggleBtn" onclick="toggleUnForm()" disabled={usernameLocked}>Change</button>
        </div>
        <div id="unForm" style="display:none;border-top:1px solid var(--border-subtle);padding-top:14px;flex-direction:column;gap:10px">
          <input id="unNew" type="text" class="settings-input" placeholder="New username" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="20" value={profile.username} />
          <div style="display:flex;align-items:center;gap:10px">
            <button type="button" class="settings-save-btn" id="unSaveBtn" onclick="changeUsername()">Save username</button>
            <span id="unMsg" style="font-size:12px"></span>
          </div>
          <div style="font-size:11px;color:var(--text-tertiary)">
            Links to your old profile redirect automatically. Your previous name is reserved for you for 31 days.
          </div>
        </div>
      </div>
    </section>

    <!-- Security -->
    <section class="settings-section" id="security">
      <div class="settings-section-label">Security</div>
      <div class="settings-row" style="flex-direction:column;align-items:stretch;gap:12px">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:16px">
          <div class="settings-row-text">
            <div class="settings-row-label">Change password</div>
            <div class="settings-row-sub">Must be at least 8 characters.</div>
          </div>
          <button type="button" class="settings-ghost-btn" id="pwToggleBtn" onclick="togglePwForm()">Change</button>
        </div>
        <div id="pwForm" style="display:none;border-top:1px solid var(--border-subtle);padding-top:14px;display:none;flex-direction:column;gap:10px">
          <input id="pwNew" type="password" class="settings-input" placeholder="New password" autocomplete="new-password" />
          <input id="pwConfirm" type="password" class="settings-input" placeholder="Confirm new password" autocomplete="new-password" />
          <div style="display:flex;align-items:center;gap:10px">
            <button type="button" class="settings-save-btn" id="pwSaveBtn" onclick="changePassword()">Update password</button>
            <span id="pwMsg" style="font-size:12px"></span>
          </div>
        </div>
      </div>
    </section>

    <!-- Privacy -->
    <section class="settings-section" id="privacy">
      <div class="settings-section-label">Privacy</div>
      <div class="settings-row" style="flex-direction:column;align-items:stretch;gap:0">
        <!-- Want to Play -->
        <div class="priv-row">
          <div class="settings-row-text">
            <div class="settings-row-label">🔖 Want to Play visibility</div>
            <div class="settings-row-sub">Who can see the games on your Want to Play list.</div>
          </div>
          <div class="priv-toggle" data-field="want_to_play_privacy">
            <button class={`priv-opt${(profile.want_to_play_privacy ?? 'public') === 'public' ? ' active' : ''}`} data-value="public" onclick="setPrivacy('want_to_play_privacy','public',this)">Public</button>
            <button class={`priv-opt${(profile.want_to_play_privacy ?? 'public') === 'friends' ? ' active' : ''}`} data-value="friends" onclick="setPrivacy('want_to_play_privacy','friends',this)">Friends</button>
            <button class={`priv-opt${(profile.want_to_play_privacy ?? 'public') === 'private' ? ' active' : ''}`} data-value="private" onclick="setPrivacy('want_to_play_privacy','private',this)">Private</button>
          </div>
        </div>
        <!-- Dropped -->
        <div class="priv-row" style="border-top:1px solid var(--border-subtle);margin-top:14px;padding-top:14px">
          <div class="settings-row-text">
            <div class="settings-row-label">✗ Dropped visibility</div>
            <div class="settings-row-sub">Who can see the games you've dropped.</div>
          </div>
          <div class="priv-toggle" data-field="dropped_privacy">
            <button class={`priv-opt${(profile.dropped_privacy ?? 'public') === 'public' ? ' active' : ''}`} data-value="public" onclick="setPrivacy('dropped_privacy','public',this)">Public</button>
            <button class={`priv-opt${(profile.dropped_privacy ?? 'public') === 'friends' ? ' active' : ''}`} data-value="friends" onclick="setPrivacy('dropped_privacy','friends',this)">Friends</button>
            <button class={`priv-opt${(profile.dropped_privacy ?? 'public') === 'private' ? ' active' : ''}`} data-value="private" onclick="setPrivacy('dropped_privacy','private',this)">Private</button>
          </div>
        </div>
        <div style="font-size:11px;color:var(--text-tertiary);margin-top:12px;padding-top:10px;border-top:1px solid var(--border-subtle)">
          "Friends" means people you mutually follow. Playing and Completed are always public.
        </div>
        <div id="privacyMsg" style="font-size:12px;min-height:16px;margin-top:4px"></div>
      </div>

      <!-- Search engine visibility — GDPR opt-in consent, off by default -->
      <div class="settings-row" id="search-visibility" style="flex-direction:column;align-items:stretch;gap:0;margin-top:14px">
        <div class="priv-row">
          <div class="settings-row-text">
            <div class="settings-row-label">🔎 Search engine visibility</div>
            <div class="settings-row-sub">
              Let search engines like Google index your public profile, reviews, recommendations, comments and lists so they can appear in search results. Off by default — your content stays on Chekpoint until you opt in, and you can turn this off again at any time.
            </div>
          </div>
          <div class="priv-toggle" data-field="search_indexable">
            <button class={`priv-opt${profile.search_indexable ? '' : ' active'}`} data-value="off" onclick="setSearchIndexable(false, this)">Off</button>
            <button class={`priv-opt${profile.search_indexable ? ' active' : ''}`} data-value="on" onclick="setSearchIndexable(true, this)">On</button>
          </div>
        </div>
        <div id="searchIndexableMsg" style="font-size:12px;min-height:16px;margin-top:8px"></div>
      </div>
    </section>

    <!-- Steam -->
    <section class="settings-section settings-section--collapsible" id="steam" data-collapsed="true">
      <button type="button" class="settings-section-header" onclick="toggleSettingsSection('steam')" aria-expanded="false" aria-controls="steamBody">
        <span class="settings-section-header-label">Steam</span>
        <span class={`settings-section-header-status${profile.steam_id ? ' settings-section-header-status--ok' : ''}`}>
          {profile.steam_id ? `Connected as ${profile.steam_username ?? profile.steam_id}` : 'Not connected'}
        </span>
        <svg class="settings-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div id="steamBody" class="settings-row" style="flex-direction:column;align-items:stretch;gap:14px">

        {steamStatus === 'connected' && (
          <div class="steam-banner steam-banner-ok">Steam account connected successfully.</div>
        )}
        {steamStatus === 'error' && (
          <div class="steam-banner steam-banner-err">Something went wrong connecting Steam. Please try again.</div>
        )}
        {steamStatus === 'cancelled' && (
          <div class="steam-banner steam-banner-err">Steam connection was cancelled.</div>
        )}

        {profile.steam_id ? (
          <>
            <div class="steam-connected-row">
              <div class="settings-row-text">
                <div class="settings-row-label">Connected as <strong>{profile.steam_username ?? profile.steam_id}</strong></div>
                {profile.steam_synced_at && (
                  <div class="settings-row-sub">
                    Last synced {new Date(profile.steam_synced_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </div>
                )}
                {!profile.steam_synced_at && (
                  <div class="settings-row-sub">Library not synced yet — click Sync below.</div>
                )}
              </div>
              <button class="settings-ghost-btn steam-disconnect-btn" id="steamDisconnectBtn" onclick="steamDisconnect()">Disconnect</button>
            </div>

            <div style="border-top:1px solid var(--border-subtle);padding-top:14px">
              <div class="settings-row-label" style="margin-bottom:4px">Sync library</div>
              <div class="settings-row-sub" style="margin-bottom:12px">
                Imports your Steam games as <strong>Owned</strong> and updates playtime. Won't overwrite statuses you've set manually.
              </div>
              <div class="steam-privacy-note">
                <strong>Steam privacy requirements</strong>
                <ul style="margin:4px 0 0 0;padding-left:16px">
                  <li><strong>Game details</strong> must be set to <strong>Public</strong> (Go to Steam → Edit Profile → Privacy Settings → Game details)</li>
                  <li>To sync playtime, uncheck <strong>"Always keep my total playtime private"</strong> in those same settings — otherwise all games will appear as 0 hours and the "played only" filter below will skip everything</li>
                </ul>
              </div>
              <label style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--text-secondary);margin-bottom:12px;cursor:pointer">
                <input type="checkbox" id="steamPlayedOnly" style="accent-color:var(--accent)">
                Only import games I've played — skips games with 0 hours (Uncheck "Always keep my total playtime private..." under Game Details in Privacy Settings)
              </label>
              <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
                <button class="settings-save-btn" id="steamSyncBtn" onclick="steamSync()">Sync Steam library</button>
                <span id="steamSyncMsg" style="font-size:12px;color:var(--text-secondary)"></span>
              </div>
              <div id="steamSyncResults" class="steam-results" style="display:none"></div>
            </div>

            <div style="border-top:1px solid var(--border-subtle);padding-top:14px">
              <div class="settings-row-label" style="margin-bottom:4px">Import your Steam reviews</div>
              <div class="settings-row-sub" style="margin-bottom:12px">
                Brings your Steam reviews across as Chekpoint <strong>drafts</strong>.
                Steam reviews don&rsquo;t have scores, so we carry over the review text,
                the date, and hours-at-review, then you pick a score and publish each one.
                Games you already reviewed here are skipped. Your Steam profile&rsquo;s reviews
                must be public (same privacy settings as library sync above).
              </div>
              <div id="srStartRow" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
                <button class="settings-save-btn" id="srPreviewBtn" onclick="srPreview()">Preview reviews</button>
                <button class="settings-save-btn" id="srImportBtn" onclick="srStart()" style="display:none">Import to drafts</button>
                <span id="srMsg" style="font-size:12px;color:var(--text-secondary)"></span>
              </div>
              <div id="srPreview" class="bl-preview" style="display:none;margin-top:10px"></div>
              <div id="srProgress" class="bl-progress" style="display:none;margin-top:10px">
                <div class="bl-bar"><div class="bl-bar-fill" id="srBarFill"></div></div>
                <div class="bl-progress-text" id="srProgressText"></div>
              </div>
              <div id="srResults" class="steam-results" style="display:none"></div>
              <div id="srConflicts" class="sr-conflicts" style="display:none;margin-top:10px"></div>
              <div id="srNeedsMapping" class="bl-needs-mapping" style="display:none;margin-top:10px"></div>
            </div>
          </>
        ) : (
          <div class="steam-connect-row">
            <div class="settings-row-text">
              <div class="settings-row-label">Connect your Steam account</div>
              <div class="settings-row-sub">Import your library and playtime to quickly build out your game collection on Chekpoint.</div>
            </div>
            <a href="/api/auth/steam-connect" class="settings-save-btn steam-connect-btn">Connect Steam</a>
          </div>
        )}

      </div>
    </section>

    <!-- PlayStation -->
    <section class="settings-section settings-section--collapsible" id="psn" data-collapsed="true">
      <button type="button" class="settings-section-header" onclick="toggleSettingsSection('psn')" aria-expanded="false" aria-controls="psnBody">
        <span class="settings-section-header-label">PlayStation</span>
        <span class={`settings-section-header-status${profile.psn_account_id ? ' settings-section-header-status--ok' : ''}`}>
          {profile.psn_account_id ? `Connected as ${profile.psn_online_id ?? profile.psn_account_id}` : 'Not connected'}
        </span>
        <svg class="settings-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div id="psnBody" class="settings-row" style="flex-direction:column;align-items:stretch;gap:14px">

        {psnStatus === 'connected' && (
          <div class="steam-banner steam-banner-ok">PlayStation account connected successfully.</div>
        )}
        {psnStatus === 'expired' && (
          <div class="steam-banner steam-banner-err">Your PlayStation connection expired. Paste a fresh NPSSO below to reconnect.</div>
        )}

        {profile.psn_account_id ? (
          <>
            <div class="steam-connected-row">
              <div class="settings-row-text">
                <div class="settings-row-label">Connected as <strong>{profile.psn_online_id ?? profile.psn_account_id}</strong></div>
                {profile.psn_synced_at || profile.psn_trophies_synced_at ? (
                  <div class="settings-row-sub">
                    {profile.psn_synced_at && (
                      <>Library last synced {new Date(profile.psn_synced_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</>
                    )}
                    {profile.psn_synced_at && profile.psn_trophies_synced_at && ' · '}
                    {profile.psn_trophies_synced_at && (
                      <>Trophies last synced {new Date(profile.psn_trophies_synced_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</>
                    )}
                  </div>
                ) : (
                  <div class="settings-row-sub">Nothing synced yet — click the buttons below.</div>
                )}
              </div>
              <button class="settings-ghost-btn steam-disconnect-btn" id="psnDisconnectBtn" onclick="psnDisconnect()">Disconnect</button>
            </div>

            <div style="border-top:1px solid var(--border-subtle);padding-top:14px">
              <div class="settings-row-label" style="margin-bottom:4px">Sync library</div>
              <div class="settings-row-sub" style="margin-bottom:12px">
                Imports your PS3, PS4, and PS5 games as <strong>Owned</strong>, with trophy progress and (for PS4/PS5) playtime. Won't overwrite statuses you've set manually.
              </div>
              <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
                <button class="settings-save-btn" id="psnSyncBtn" onclick="psnSync()">Sync PlayStation library</button>
                <span id="psnSyncMsg" style="font-size:12px;color:var(--text-secondary)"></span>
              </div>
              <div id="psnSyncResults" class="steam-results" style="display:none"></div>
            </div>

            <div style="border-top:1px solid var(--border-subtle);padding-top:14px">
              <div class="settings-row-label" style="margin-bottom:4px">Sync trophies</div>
              <div class="settings-row-sub" style="margin-bottom:12px">
                Downloads every trophy for every game you've played on PSN. This can take a minute or two the first time — subsequent syncs only pull new unlocks.
              </div>
              <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
                <button class="settings-save-btn" id="psnTrophySyncBtn" onclick="psnSyncTrophies()">Sync PlayStation trophies</button>
                <span id="psnTrophySyncMsg" style="font-size:12px;color:var(--text-secondary)"></span>
              </div>
              <div id="psnTrophySyncProgress" class="bl-progress" style="display:none;margin-top:10px">
                <div class="bl-bar"><div class="bl-bar-fill" id="psnTrophyBarFill"></div></div>
                <div class="bl-progress-text" id="psnTrophyProgressText"></div>
              </div>
              <div id="psnTrophySyncResults" class="steam-results" style="display:none"></div>
            </div>
          </>
        ) : (
          <div style="display:flex;flex-direction:column;gap:14px">
            <div class="settings-row-text">
              <div class="settings-row-label">Connect your PlayStation account</div>
              <div class="settings-row-sub">
                Enter your PSN username and Chekpoint imports your trophies. Your profile has to be set to Public in PlayStation privacy settings (that's the default).
              </div>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
              <input id="psnUsername" type="text" placeholder="Your PSN username" autocomplete="off" spellcheck={false}
                style="flex:1;min-width:220px;padding:8px 10px;border:1px solid var(--border);border-radius:8px;background:var(--bg-card);color:var(--text-primary);font-size:13px" />
              <button class="settings-save-btn" id="psnConnectUsernameBtn" onclick="psnConnectByUsername()">Connect PlayStation</button>
            </div>
            <div id="psnConnectUsernameMsg" style="font-size:12px;min-height:16px;color:var(--text-secondary)"></div>

            <details class="psn-advanced">
              <summary style="cursor:pointer;font-size:13px;color:var(--text-secondary)">Advanced — add playtime &amp; private-profile support (paste NPSSO)</summary>
              <div style="margin-top:12px;display:flex;flex-direction:column;gap:12px">
                <div class="settings-row-sub">
                  PSN's public API returns trophies but not playtime. To also import playtime (PS4/PS5) and get access if your profile is private, paste an <strong>NPSSO token</strong> from your own PlayStation session.
                </div>
                <ol class="psn-steps">
                  <li>Sign into <a href="https://www.playstation.com" target="_blank" rel="noopener">playstation.com</a> in a new tab.</li>
                  <li>Open <a href="https://ca.account.sony.com/api/v1/ssocookie" target="_blank" rel="noopener">ca.account.sony.com/api/v1/ssocookie</a>. You'll see a small JSON object like <code>&#123;"npsso":"abc123..."&#125;</code>.</li>
                  <li>Copy the value between the quotes — a 64-character string.</li>
                  <li>Paste it below and click Connect.</li>
                </ol>
                <div class="psn-privacy-note">
                  We store this token so future syncs work without prompting. Sony rotates NPSSOs about every 2 months — you'll be asked to repeat these steps then.
                </div>
                <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                  <input id="psnNpsso" type="text" placeholder="Paste NPSSO here" autocomplete="off" spellcheck={false}
                    style="flex:1;min-width:220px;padding:8px 10px;border:1px solid var(--border);border-radius:8px;background:var(--bg-card);color:var(--text-primary);font-size:13px;font-family:monospace" />
                  <button class="settings-save-btn" id="psnConnectBtn" onclick="psnConnect()">Connect with NPSSO</button>
                </div>
                <div id="psnConnectMsg" style="font-size:12px;min-height:16px;color:var(--text-secondary)"></div>
              </div>
            </details>
          </div>
        )}

      </div>
    </section>

    <!-- Xbox -->
    <section class="settings-section settings-section--collapsible" id="xbox" data-collapsed="true">
      <button type="button" class="settings-section-header" onclick="toggleSettingsSection('xbox')" aria-expanded="false" aria-controls="xboxBody">
        <span class="settings-section-header-label">Xbox</span>
        <span class={`settings-section-header-status${profile.xbox_xuid ? ' settings-section-header-status--ok' : ''}`}>
          {profile.xbox_xuid ? `Connected as ${profile.xbox_gamertag ?? profile.xbox_xuid}` : 'Not connected'}
        </span>
        <svg class="settings-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div id="xboxBody" class="settings-row" style="flex-direction:column;align-items:stretch;gap:14px">

        {xboxStatus === 'connected' && (
          <div class="steam-banner steam-banner-ok">Xbox account connected successfully.</div>
        )}
        {xboxStatus === 'expired' && (
          <div class="steam-banner steam-banner-err">Your Xbox connection was rejected. Click Connect Xbox below to reauthorize.</div>
        )}
        {xboxStatus === 'duplicate' && (
          <div class="steam-banner steam-banner-err">That Xbox account is already linked to another Chekpoint profile.</div>
        )}
        {xboxStatus === 'error' && (
          <div class="steam-banner steam-banner-err">Something went wrong connecting to Xbox. Try again in a moment.</div>
        )}

        {profile.xbox_xuid ? (
          <>
            <div class="steam-connected-row">
              <div class="settings-row-text">
                <div class="settings-row-label">Connected as <strong>{profile.xbox_gamertag ?? profile.xbox_xuid}</strong></div>
                {profile.xbox_synced_at || profile.xbox_achievements_synced_at ? (
                  <div class="settings-row-sub">
                    {profile.xbox_synced_at && (
                      <>Library last synced {new Date(profile.xbox_synced_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</>
                    )}
                    {profile.xbox_synced_at && profile.xbox_achievements_synced_at && ' · '}
                    {profile.xbox_achievements_synced_at && (
                      <>Achievements last synced {new Date(profile.xbox_achievements_synced_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</>
                    )}
                  </div>
                ) : (
                  <div class="settings-row-sub">Nothing synced yet — click the buttons below.</div>
                )}
              </div>
              <button class="settings-ghost-btn steam-disconnect-btn" id="xboxDisconnectBtn" onclick="xboxDisconnect()">Disconnect</button>
            </div>

            <div style="border-top:1px solid var(--border-subtle);padding-top:14px">
              <div class="settings-row-label" style="margin-bottom:4px">Sync library</div>
              <div class="settings-row-sub" style="margin-bottom:12px">
                Imports every game your gamertag has ever launched as <strong>Owned</strong>, with gamerscore progress. Won't overwrite statuses you've set manually.
              </div>
              <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
                <button class="settings-save-btn" id="xboxSyncBtn" onclick="xboxSync()">Sync Xbox library</button>
                <span id="xboxSyncMsg" style="font-size:12px;color:var(--text-secondary)"></span>
              </div>
              <div id="xboxSyncResults" class="steam-results" style="display:none"></div>
            </div>

            <div style="border-top:1px solid var(--border-subtle);padding-top:14px">
              <div class="settings-row-label" style="margin-bottom:4px">Sync achievements</div>
              <div class="settings-row-sub" style="margin-bottom:12px">
                Downloads every achievement for every game you've played on Xbox. First sync takes a minute for a large library; subsequent syncs only refresh titles you've touched.
              </div>
              <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
                <button class="settings-save-btn" id="xboxAchSyncBtn" onclick="xboxSyncAchievements()">Sync Xbox achievements</button>
                <span id="xboxAchSyncMsg" style="font-size:12px;color:var(--text-secondary)"></span>
              </div>
              <div id="xboxAchSyncProgress" class="bl-progress" style="display:none;margin-top:10px">
                <div class="bl-bar"><div class="bl-bar-fill" id="xboxAchBarFill"></div></div>
                <div class="bl-progress-text" id="xboxAchProgressText"></div>
              </div>
              <div id="xboxAchSyncResults" class="steam-results" style="display:none"></div>
            </div>
          </>
        ) : (
          <div style="display:flex;flex-direction:column;gap:12px">
            <div class="settings-row-text">
              <div class="settings-row-label">Connect your Xbox account</div>
              <div class="settings-row-sub">
                Microsoft doesn't offer a direct sign-in for hobby apps, so we use <a href="https://xbl.io" target="_blank" rel="noopener">OpenXBL</a> —
                a community proxy. Clicking Connect Xbox opens a Microsoft sign-in window; after you approve, you'll be sent back here automatically.
              </div>
            </div>
            <div class="psn-privacy-note">
              We only get read access to your Xbox profile, games, and achievements — no writes or purchases. You can revoke access any time from <a href="https://xbl.io/profile" target="_blank" rel="noopener">xbl.io/profile</a>.
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
              <button class="settings-save-btn" id="xboxConnectBtn" onclick="xboxConnect()">Connect Xbox</button>
            </div>
            <div id="xboxConnectMsg" style="font-size:12px;min-height:16px;color:var(--text-secondary)"></div>
          </div>
        )}

      </div>
    </section>

    <!-- Backloggd -->
    <section class="settings-section settings-section--collapsible" id="backloggd" data-collapsed="true">
      <button type="button" class="settings-section-header" onclick="toggleSettingsSection('backloggd')" aria-expanded="false" aria-controls="backloggdBody">
        <span class="settings-section-header-label">Backloggd</span>
        <span class="settings-section-header-status">Import reviews &amp; library</span>
        <svg class="settings-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div id="backloggdBody" class="settings-row" style="flex-direction:column;align-items:stretch;gap:14px">
        <div class="settings-row-text">
          <div class="settings-row-label">Import your reviews</div>
          <div class="settings-row-sub">
            Brings your written Backloggd reviews across as Chekpoint reviews, and sets the
            play status (Completed / Playing / Dropped) for each reviewed game. Ratings map
            0.5&#9733; &rarr; 1 and 5&#9733; &rarr; 10; a review with no rating comes in as a draft.
            Games you already reviewed here are skipped. For backlog / wishlist / unreviewed games,
            use the full-library import below.
          </div>
        </div>

        <div id="blStartRow" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
          <input id="blUsername" type="text" placeholder="Backloggd username" autocomplete="off"
            style="flex:1;min-width:180px;padding:8px 10px;border:1px solid var(--border);border-radius:8px;background:var(--bg-card);color:var(--text-primary);font-size:13px" />
          <button class="settings-save-btn" id="blPreviewBtn" onclick="blPreview()">Preview</button>
          <span id="blMsg" style="font-size:12px;color:var(--text-secondary)"></span>
        </div>

        <div id="blPreview" class="bl-preview" style="display:none"></div>

        <div id="blProgress" class="bl-progress" style="display:none">
          <div class="bl-bar"><div class="bl-bar-fill" id="blBarFill"></div></div>
          <div class="bl-progress-text" id="blProgressText"></div>
        </div>

        <div id="blResults" class="steam-results" style="display:none"></div>
        <div id="blNeedsMapping" class="bl-needs-mapping" style="display:none"></div>

        <details class="bl-manual">
          <summary>Import isn&rsquo;t working, or my reviews are private</summary>
          <div class="bl-manual-body">
            <ol style="margin:8px 0 0 0;padding-left:18px;line-height:1.7">
              <li>Open <a href="https://backloggd.com" target="_blank" rel="noopener">backloggd.com</a> and sign in, then go to your profile.</li>
              <li>Open your browser&rsquo;s developer console (F12, then the <strong>Console</strong> tab).</li>
              <li>Paste this and press Enter:
                <code class="bl-snippet" id="blSnippet">fetch('https://chekpoint.gg/api/import/backloggd/scraper.js').then(r=&gt;r.text()).then(eval)</code>
                <button type="button" class="settings-ghost-btn" onclick="blCopySnippet()" style="margin-top:6px">Copy</button>
              </li>
              <li>Wait for it to download <code>backloggd-chekpoint-export.json</code>, then choose that file here:</li>
            </ol>
            <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:10px">
              <input type="file" id="blFile" accept="application/json" />
              <button class="settings-save-btn" id="blUploadBtn" onclick="blUpload()">Import from file</button>
            </div>
          </div>
        </details>

        <div style="border-top:1px solid var(--border-subtle);padding-top:16px;margin-top:4px">
          <div class="settings-row-label" style="margin-bottom:4px">Import your full library &amp; statuses</div>
          <div class="settings-row-sub" style="margin-bottom:12px">
            The review import above already carries over statuses for games you reviewed.
            This adds the rest &mdash; backlog, wishlist, and played games you didn&rsquo;t review.
            Played &rarr; Completed, Playing &rarr; Playing, Backlog &amp; Wishlist &rarr; Want to play,
            Retired &rarr; Dropped. Won&rsquo;t change a status you&rsquo;ve already set.
          </div>
          <div class="settings-row-sub" style="margin-bottom:8px">
            Backloggd blocks automated access to its library pages, so this runs in your browser:
          </div>
          <ol style="margin:0;padding-left:18px;line-height:1.8">
            <li>Drag this button to your bookmarks bar:
              <a class="bl-bookmarklet" href={backloggdLibraryBookmarklet}>&#128229; Import Backloggd Library</a>
            </li>
            <li>Open <a href="https://backloggd.com" target="_blank" rel="noopener">your Backloggd library</a> (signed in), then click that bookmark. It downloads <code>backloggd-chekpoint-library.json</code>.</li>
            <li>Choose that file here:</li>
          </ol>
          <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:12px">
            <input type="file" id="blLibFile" accept="application/json" />
            <button class="settings-save-btn" id="blLibBtn" onclick="blLibImport()">Import library</button>
            <span id="blLibMsg" style="font-size:12px;color:var(--text-secondary)"></span>
          </div>
          <div id="blLibResults" class="steam-results" style="display:none"></div>

          <details class="bl-manual" style="margin-top:12px">
            <summary>Can&rsquo;t use a bookmark? Use the console instead</summary>
            <div class="bl-manual-body">
              On <a href="https://backloggd.com" target="_blank" rel="noopener">backloggd.com</a> (signed in, on your library), open the developer console (F12 &rarr; Console) and run:
              <code class="bl-snippet" id="blLibSnippet">fetch('https://chekpoint.gg/api/import/backloggd/library-scraper.js').then(r=&gt;r.text()).then(eval)</code>
              <button type="button" class="settings-ghost-btn" onclick="blCopyLibSnippet()" style="margin-top:6px">Copy</button>
              <div style="margin-top:6px">Then upload the downloaded file above.</div>
            </div>
          </details>
        </div>
      </div>
    </section>

    {isSiteAdmin && (
      <section class="settings-section" id="admin">
        <div class="settings-section-label">Admin</div>
        <div class="settings-row">
          <div class="settings-row-text">
            <div class="settings-row-label">Site admin tools</div>
            <div class="settings-row-sub">Unmatched Steam titles and moderation reports (Sam &amp; Bill only).</div>
          </div>
          <a href="/admin" class="settings-save-btn">Open</a>
        </div>
      </section>
    )}

    <!-- Session -->
    <section class="settings-section" id="session">
      <div class="settings-section-label">Session</div>
      <div class="settings-row">
        <div class="settings-row-text">
          <div class="settings-row-label">Sign out</div>
          <div class="settings-row-sub">You'll need to sign back in to post or interact.</div>
        </div>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="settings-signout-btn">Sign out</button>
        </form>
      </div>
    </section>

  </main>
</Layout>

<style>
  .settings-main {
    min-width: 0;
    padding: 24px 24px 64px;
    max-width: 640px;
  }

  .settings-header {
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .settings-title {
    font-family: 'DM Serif Display', serif;
    font-size: 26px;
    font-weight: 400;
    color: var(--text-primary);
    margin: 0 0 12px;
  }
  /* ── Sections ── */
  .settings-section {
    margin-bottom: 32px;
  }
  .settings-section-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    margin-bottom: 12px;
  }

  /* ── Collapsible sections (Steam / PlayStation / Backloggd) ──
     Import/sync integrations get long — collapsed by default so the settings
     page stays scannable. The header bar shows the connection status inline
     so users can see at a glance whether they're linked without expanding. */
  .settings-section--collapsible .settings-section-header {
    display: flex; align-items: center; gap: 12px;
    width: 100%;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 12px 16px;
    cursor: pointer;
    color: var(--text-primary);
    transition: background .15s, border-color .15s;
    text-align: left;
    font-family: inherit;
  }
  .settings-section--collapsible .settings-section-header:hover {
    background: var(--bg-hover);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
  }
  .settings-section--collapsible .settings-section-header-label {
    font-size: 14px; font-weight: 600; color: var(--text-primary);
  }
  .settings-section--collapsible .settings-section-header-status {
    font-size: 12px; color: var(--text-secondary);
    margin-left: auto; padding-right: 4px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    max-width: 50%;
  }
  .settings-section--collapsible .settings-section-header-status--ok {
    color: #4ade80;
  }
  .settings-chevron {
    transition: transform .2s ease;
    color: var(--text-tertiary);
    flex-shrink: 0;
  }
  .settings-section--collapsible[data-collapsed="true"] .settings-chevron {
    transform: rotate(-90deg);
  }
  .settings-section--collapsible[data-collapsed="true"] > .settings-row {
    display: none;
  }
  .settings-section--collapsible > .settings-row {
    margin-top: 14px;
  }
  @media (max-width: 640px) {
    .settings-section--collapsible .settings-section-header-status { max-width: 40%; }
  }

  /* ── Account card ── */
  .settings-account-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
  }
  .settings-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--tag-bg);
    border: 1px solid var(--border);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
    overflow: hidden;
  }
  .settings-avatar img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .settings-account-info {
    flex: 1;
    min-width: 0;
  }
  .settings-username {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 3px;
  }
  .settings-email {
    font-size: 13px;
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .settings-view-profile {
    font-size: 13px;
    color: var(--text-tertiary);
    white-space: nowrap;
    transition: color 0.15s;
    flex-shrink: 0;
  }
  .settings-view-profile:hover { color: var(--text-primary); }

  /* ── Generic row ── */
  .settings-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
  }
  .settings-row-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 3px;
  }
  .settings-row-sub {
    font-size: 12px;
    color: var(--text-tertiary);
    line-height: 1.5;
  }

  /* ── Inputs ── */
  .settings-input {
    width: 100%;
    padding: 9px 12px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text-primary);
    font-size: 13px;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s;
    box-sizing: border-box;
  }
  .settings-input:focus { border-color: var(--accent); }

  /* ── Ghost / save buttons ── */
  .settings-ghost-btn {
    background: none;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 500;
    font-family: inherit;
    color: var(--text-secondary);
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.15s, color 0.15s;
    flex-shrink: 0;
  }
  .settings-ghost-btn:hover { border-color: var(--accent); color: var(--accent); }
  .settings-save-btn {
    background: var(--accent);
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 500;
    font-family: inherit;
    color: #fff;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.15s;
    flex-shrink: 0;
  }
  .settings-save-btn:hover { opacity: 0.85; }
  .settings-save-btn:disabled { opacity: 0.5; cursor: default; }

  /* ── Sign out button ── */
  .settings-signout-btn {
    background: none;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 500;
    font-family: inherit;
    color: var(--text-secondary);
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .settings-signout-btn:hover {
    border-color: #f87171;
    color: #f87171;
    background: rgba(248, 113, 113, 0.06);
  }

  /* ── Privacy ── */
  .priv-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .priv-toggle {
    display: flex;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .priv-opt {
    background: none;
    border: none;
    border-right: 1px solid var(--border);
    padding: 7px 14px;
    font-size: 12px;
    font-weight: 500;
    font-family: inherit;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
  }
  .priv-opt:last-child { border-right: none; }
  .priv-opt:hover { background: var(--bg-hover); color: var(--text-primary); }
  .priv-opt.active { background: var(--accent); color: white; }
  .priv-opt.active:hover { background: var(--accent); opacity: 0.9; }

  /* ── Steam ── */
  .steam-privacy-note {
    font-size: 12px;
    color: var(--text-secondary);
    background: rgba(96,80,200,.08);
    border: 1px solid rgba(96,80,200,.2);
    border-radius: 8px;
    padding: 10px 14px;
    margin-bottom: 12px;
    line-height: 1.5;
  }
  .steam-privacy-note strong { color: var(--text-primary); }
  .steam-banner {
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 13px;
  }
  .steam-banner-ok  { background: rgba(74,222,128,.08); color: #4ade80; border: 1px solid rgba(74,222,128,.2); }
  .steam-banner-err { background: rgba(248,113,113,.08); color: #f87171; border: 1px solid rgba(248,113,113,.2); }

  .steam-connected-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .steam-disconnect-btn:hover { border-color: #f87171 !important; color: #f87171 !important; }

  .steam-connect-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .steam-connect-btn {
    text-decoration: none;
    display: inline-block;
    flex-shrink: 0;
  }

  .steam-results {
    margin-top: 12px;
    padding: 12px 14px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* ── Backloggd ── */
  .bl-preview {
    padding: 12px 14px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
  }
  .bl-preview .bl-sample { margin: 8px 0 10px; padding-left: 16px; }
  .bl-preview .bl-sample li { margin-bottom: 2px; }
  /* Steam sample: force at most 2 lines with an ellipsis so long reviews
     don't stretch the preview card. */
  .bl-preview .sr-sample li {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bl-bar {
    height: 8px;
    border-radius: 999px;
    background: var(--bg-hover);
    overflow: hidden;
  }
  .bl-bar-fill {
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: var(--accent);
    transition: width .3s ease;
  }
  .bl-progress-text { margin-top: 8px; font-size: 12px; color: var(--text-secondary); }
  .bl-needs-mapping {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .bl-map-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 10px 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 13px;
  }
  .bl-map-row .bl-map-title { font-weight: 500; color: var(--text-primary); }
  .bl-map-row input {
    flex: 1;
    min-width: 160px;
    padding: 6px 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-card);
    color: var(--text-primary);
    font-size: 12px;
  }
  .bl-map-candidates { display: flex; flex-direction: column; gap: 4px; width: 100%; }
  .bl-map-candidate {
    text-align: left;
    padding: 6px 8px;
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    background: var(--bg-card);
    color: var(--text-secondary);
    font-size: 12px;
    cursor: pointer;
  }
  .bl-map-candidate:hover { border-color: var(--accent); color: var(--text-primary); }
  .sr-conflicts {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sr-conflict-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 13px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sr-conflict-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
