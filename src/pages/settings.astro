}

function srEscapeHtml(s: string): string {
  return s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

async function srMatchAndRemove(
  row: HTMLElement,
  itemId: string,
  target: { gameId: string } | { igdbId: number },
  label: string,
) {
  try {
    const r = await mapSteamItem(itemId, target);
    row.innerHTML = `<span class="bl-map-title">${srEscapeHtml(r.game.title || label)}</span> <span style="color:var(--score-great,#4ade80)">${r.status === "drafted" ? "drafted" : r.status}</span>`;
    if (r.job) srRenderResults(r.job);
  } catch (e: any) {
    srSetMsg(e?.message ?? "Match failed.");
  }
}

async function srDiscardAndRemove(row: HTMLElement, itemId: string) {
  try {
    const r = await discardSteamItem(itemId);
    row.innerHTML = `<span class="bl-map-title" style="color:var(--text-tertiary)">Discarded</span>`;
    if (r.job) srRenderResults(r.job);
  } catch (e: any) {
    srSetMsg(e?.message ?? "Could not discard.");
  }
}

function srRenderNeedsMapping(items: any[]) {
  const box = srEl("srNeedsMapping");
  if (!box) return;
  if (!items || !items.length) {
    box.style.display = "none";
    box.innerHTML = "";
    return;
  }
  box.style.display = "flex";
  box.innerHTML = "";
  for (const item of items) {
    const row = document.createElement("div");
    row.className = "bl-map-row";
    const title = item.game_title || (item.steam_appid ? `Steam app ${item.steam_appid}` : "Untitled Steam review");
    const steamLink = item.steam_appid
      ? ` <a href="https://store.steampowered.com/app/${item.steam_appid}/" target="_blank" rel="noopener" style="color:var(--text-tertiary);font-size:11px">Steam ↗</a>`
      : "";
    row.innerHTML = `
      <div style="width:100%;display:flex;justify-content:space-between;align-items:center;gap:8px">
        <span class="bl-map-title">${srEscapeHtml(title)}${steamLink}</span>
        <button type="button" class="settings-ghost-btn sr-discard-btn" style="padding:4px 10px;font-size:12px">Discard</button>
      </div>
      <input type="text" placeholder="Search Chekpoint / IGDB…" />
      <div class="bl-map-candidates"></div>`;
    const input = row.querySelector("input") as HTMLInputElement;
    const list = row.querySelector(".bl-map-candidates") as HTMLElement;
    const discardBtn = row.querySelector(".sr-discard-btn") as HTMLButtonElement;
    if (item.game_title) input.value = item.game_title;
    discardBtn.onclick = () => srDiscardAndRemove(row, item.id);
    const search = srDebounce(async () => {
      const q = input.value.trim();
      if (q.length < 2) { list.innerHTML = ""; return; }
      try {
        const res = await fetch(`/api/games/search?q=${encodeURIComponent(q)}`);
        const results = await res.json();
        list.innerHTML = "";
        for (const g of (results ?? []).slice(0, 6)) {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "bl-map-candidate";
          const year = g.year ? ` (${g.year})` : "";
          const src = g.source === "igdb" ? " · IGDB" : "";
          btn.textContent = `${g.title}${year}${src}`;
          if (g.source === "igdb") {
            const igdbId = Number(g.igdb_id ?? g.id);
            if (!Number.isFinite(igdbId)) continue;
            btn.onclick = () => srMatchAndRemove(row, item.id, { igdbId }, g.title);
          } else {
            const gameId = String(g.id ?? "");
            if (!gameId) continue;
            btn.onclick = () => srMatchAndRemove(row, item.id, { gameId }, g.title);
          }
          list.appendChild(btn);
        }
        if (!list.children.length) {
          list.innerHTML = `<div style="font-size:12px;color:var(--text-tertiary)">No match — try a different title, or Discard.</div>`;
        }
      } catch {
        /* ignore */
      }
    }, 300);
    input.addEventListener("input", search);
    // Trigger the initial search so the user sees candidates for the pre-filled title.
    if (input.value.trim().length >= 2) search();
    box.appendChild(row);
  }
}

function srSnippet(text: string, max = 320): string {
  const t = (text ?? "").trim();
  if (t.length <= max) return t;
  return `${t.slice(0, max).trim()}…`;
}

async function srReplaceDraft(card: HTMLElement, itemId: string, gameTitle: string) {
  if (!confirm(`Replace your existing draft of ${gameTitle} with the Steam version?\n\nYour current draft will be deleted.`)) return;
  try {
    const r = await replaceDraftFromSteam(itemId);
    card.innerHTML = `<div class="sr-conflict-head"><span class="sr-conflict-title">${srEscapeHtml(gameTitle)}</span><span style="color:var(--score-great,#4ade80);font-size:12px">Replaced with Steam draft</span></div>`;
    if (r.job) srRenderResults(r.job);
  } catch (e: any) {
    srSetMsg(e?.message ?? "Replace failed.");
  }
}

async function srDismissConflict(card: HTMLElement, itemId: string) {
  // Persist the decision — next Steam import won't re-surface this appid.
  // Only remove the DOM card after the server confirms; on failure, leave
  // the card in place with an error so the user isn't quietly lied to.
  const dismissBtn = card.querySelector(".sr-dismiss-btn") as HTMLButtonElement | null;
  const replaceBtn = card.querySelector(".sr-replace-btn") as HTMLButtonElement | null;
  if (dismissBtn) dismissBtn.disabled = true;
  if (replaceBtn) replaceBtn.disabled = true;
  try {
    await dismissSteamConflict(itemId);
  } catch (e: any) {
    if (dismissBtn) dismissBtn.disabled = false;
    if (replaceBtn) replaceBtn.disabled = false;
    srSetMsg(e?.message ?? "Could not dismiss this conflict.");
    return;
  }
  card.remove();
  const wrap = srEl("srConflicts");
  // Keep the panel open as long as ANYTHING remains (e.g. the published
  // summary), not just draft cards.
  if (wrap && wrap.children.length === 0) {
    wrap.style.display = "none";
    wrap.innerHTML = "";
  }
}

function srRenderConflicts(items: SteamConflictItem[] | undefined | null) {
  const box = srEl("srConflicts");
  if (!box) return;
  if (!items || !items.length) {
    box.style.display = "none";
    box.innerHTML = "";
    return;
  }
  box.style.display = "flex";
  box.innerHTML = "";

  // Three UX shapes:
  //   - draft conflicts w/ different text: real decision (Replace vs Keep) → full compare card
  //   - published conflicts w/ different text: informational (only Dismiss/View) → summary row
  //   - identical text: user pasted their Steam review verbatim into Chekpoint —
  //     zero decision, zero surprise, just tell them it already exists → summary row
  // Type predicates so TypeScript narrows to the trimmed summary shape (no body/steam)
  // for the non-draft paths — matching the bandwidth-trimmed status.ts response.
  const drafts = items.filter((c): c is SteamDraftConflict => c.kind === "draft");
  const published = items.filter(
    (c): c is SteamSummaryConflict => c.kind === "published",
  );
  const identical = items.filter(
    (c): c is SteamSummaryConflict => c.kind === "identical",
  );

  for (const c of drafts) {
    const card = document.createElement("div");
    card.className = "sr-conflict-card";

    const gameHref = c.game.slug ? `/games/${c.game.slug}` : `#`;
    const reviewHref = `/reviews/${c.existing.id}`;

    const steamMeta = [
      c.steam.review_date ? c.steam.review_date : "",
      c.steam.hours_at_review != null ? `${Math.round(c.steam.hours_at_review)} hrs` : "",
      c.steam.appid ? `<a href="https://store.steampowered.com/app/${c.steam.appid}/" target="_blank" rel="noopener" style="color:inherit">Steam ↗</a>` : "",
    ].filter(Boolean).join(" · ");

    const existingScore = c.existing.score != null ? `${c.existing.score}/10` : "no score";
    const existingWhen = c.existing.created_at
      ? `drafted ${new Date(c.existing.created_at).toLocaleDateString()}`
      : "";
    const existingMeta = [existingScore, existingWhen].filter(Boolean).join(" · ");

    card.innerHTML = `
      <div class="sr-conflict-head">
        <span class="sr-conflict-title"><a href="${gameHref}" style="color:inherit;text-decoration:none">${srEscapeHtml(c.game.title)}</a></span>
        <span class="sr-conflict-kind">Existing draft</span>
      </div>
      <div class="sr-conflict-cols">
        <div class="sr-conflict-col">
          <h4>Your existing draft</h4>
          ${c.existing.title ? `<div style="font-weight:500;margin-bottom:4px">${srEscapeHtml(c.existing.title)}</div>` : ""}
          <div class="sr-conflict-body">${srEscapeHtml(srSnippet(c.existing.body))}</div>
          ${existingMeta ? `<div class="sr-conflict-meta">${existingMeta}</div>` : ""}
        </div>
        <div class="sr-conflict-col">
          <h4>Steam review</h4>
          <div class="sr-conflict-body">${srEscapeHtml(srSnippet(c.steam.review_text))}</div>
          ${steamMeta ? `<div class="sr-conflict-meta">${steamMeta}</div>` : ""}
        </div>
      </div>
      <div class="sr-conflict-actions">
        <button type="button" class="settings-save-btn sr-replace-btn">Replace my draft with Steam text</button>
        <a href="${reviewHref}" class="settings-ghost-btn" style="padding:6px 12px;font-size:12px;text-decoration:none">View my draft</a>
        <button type="button" class="settings-ghost-btn sr-dismiss-btn">Keep mine</button>
      </div>`;

    const replaceBtn = card.querySelector(".sr-replace-btn") as HTMLButtonElement | null;
    if (replaceBtn) replaceBtn.onclick = () => srReplaceDraft(card, c.item_id, c.game.title);

    const dismissBtn = card.querySelector(".sr-dismiss-btn") as HTMLButtonElement | null;
    if (dismissBtn) dismissBtn.onclick = () => srDismissConflict(card, c.item_id);

    box.appendChild(card);
  }

  // Identical first — most benign, least surprising to the user. Then published
  // (informational) below it. Drafts (the ones with real decisions) render
  // above these summary blocks.
  if (identical.length) {
    const n = identical.length;
    box.appendChild(
      srBuildSkippedSummary(
        identical,
        `${n} Steam review${n === 1 ? " is" : "s are"} already on Chekpoint (identical text) — skipped.`,
      ),
    );
  }
  if (published.length) {
    const n = published.length;
    box.appendChild(
      srBuildSkippedSummary(
        published,
        `${n} Steam review${n === 1 ? "" : "s"} skipped — you've already published these on Chekpoint.`,
      ),
    );
  }
}

function srBuildSkippedSummary(items: SteamSummaryConflict[], label: string): HTMLElement {
  const wrap = document.createElement("div");
  wrap.className = "sr-published-summary";
  wrap.innerHTML = `
    <div class="sr-published-head">
      <span class="sr-published-label">${label}</span>
      <button type="button" class="sr-published-toggle" aria-expanded="false">Show ▾</button>
    </div>
    <div class="sr-published-list" hidden></div>`;

  const list = wrap.querySelector(".sr-published-list") as HTMLElement;
  for (const c of items) {
    const row = document.createElement("div");
    row.className = "sr-published-row";
    const gameHref = c.game.slug ? `/games/${c.game.slug}` : `#`;
    const reviewHref = `/reviews/${c.existing.id}`;
    row.innerHTML = `
      <a class="sr-published-title" href="${gameHref}">${srEscapeHtml(c.game.title)}</a>
      <a class="sr-published-link" href="${reviewHref}">View my review →</a>`;
    list.appendChild(row);
  }

  const btn = wrap.querySelector(".sr-published-toggle") as HTMLButtonElement;
  btn.onclick = () => {
    const open = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", open ? "false" : "true");
    btn.textContent = open ? "Show ▾" : "Hide ▴";
    list.hidden = open;
  };
  return wrap;
}

async function srDrive() {
  srEl("srStartRow")!.style.display = "none";
  srEl("srPreview")!.style.display = "none";
  srActiveController?.abort();
  srActiveController = new AbortController();
  try {
    const { job } = await startAndDriveSteam({
      onProgress: srRenderProgress,
      signal: srActiveController.signal,
    });
    srRenderProgress({ phase: "done", fraction: 1, message: "Import complete" });
    try {
      const status = await fetchSteamStatus(job.id);
      srRenderResults(status.job);
      srRenderNeedsMapping(status.needs_mapping);
      srRenderConflicts(status.skipped_conflicts);
      fetch("/api/import/steam/skip-onboarding", { method: "POST" }).catch(() => {});
    } catch { /* results are best-effort */ }
  } catch (e: any) {
    if (e?.name === "AbortError") return;
    srSetMsg(e?.message ?? "Import failed.");
    srEl("srStartRow")!.style.display = "flex";
  }
}
window.srStart = srDrive;

async function srPreview() {
  const btn = srEl("srPreviewBtn") as HTMLButtonElement | null;
  const importBtn = srEl("srImportBtn") as HTMLButtonElement | null;
  if (!btn) return;
  btn.disabled = true;
  srSetMsg("Checking Steam…", true);
  try {
    const p = await previewSteamReviews();
    srSetMsg("");
    const box = srEl("srPreview")!;
    box.style.display = "block";
    // Server already caps sample at 5 items and each body at 240 chars, but a
    // 240-char blob of dense text still wraps to 4-5 lines on desktop and even
    // more on mobile. Collapse whitespace, trim to ~140 chars with an ellipsis
    // marker, and let CSS line-clamp the row at 2 lines regardless of width.
    const previewList = p.sample
      .slice(0, 5)
      .map((s: any) => {
        const hrs = s.hours_at_review ? ` — ${s.hours_at_review} hrs` : "";
        const date = s.review_date ? ` <span style="color:var(--text-tertiary)">${s.review_date}</span>` : "";
        const raw = (s.review_text || "").replace(/\s+/g, " ").trim();
        const snippet = raw.length > 140 ? `${raw.slice(0, 140).trimEnd()}…` : raw;
        return `<li>${srEscapeHtml(snippet) || "(no text)"}${hrs}${date}</li>`;
      })
      .join("");
    const more = p.totalReviews > 5 ? ` <span style="color:var(--text-tertiary);font-size:11px">(showing 5 of ${p.totalReviews})</span>` : "";
    box.innerHTML = `
      Found <strong>${p.totalReviews}</strong> Steam review${p.totalReviews === 1 ? "" : "s"}${p.totalPages > 1 ? ` across ${p.totalPages} pages` : ""}.
      All will import as drafts — you assign a score before publishing.${more}
      <ul class="bl-sample sr-sample">${previewList}</ul>`;
    if (importBtn) importBtn.style.display = "";
  } catch (e: any) {
    srSetMsg(e?.message ?? "Could not reach Steam.");
  } finally {
    btn.disabled = false;
  }
}
window.srPreview = srPreview;

// Reattach to an import that's still running (e.g. after a page reload).
// Only run when the Steam import section is actually rendered — the whole
// Steam block is conditional on profile.steam_id, so users without a
// connected account skip the /status probe entirely.
(async () => {
  if (!srEl("srPreviewBtn")) return;
  try {
    srActiveController = new AbortController();
    const resumed = await resumeActiveSteam({
      onProgress: srRenderProgress,
      signal: srActiveController.signal,
    });
    if (resumed?.job) {
      srEl("srStartRow")!.style.display = "none";
      srRenderProgress({ phase: "done", fraction: 1, message: "Import complete" });
      srRenderResults(resumed.job);
      srRenderNeedsMapping(resumed.needs_mapping);
      srRenderConflicts(resumed.skipped_conflicts);
    }
  } catch {
    /* nothing to resume */
  }
})();
</script>
