async function changeUsername() {
  const el = document.getElementById('unNew') as HTMLInputElement | null;
  const msg = document.getElementById('unMsg');
  const btn = document.getElementById('unSaveBtn') as HTMLButtonElement | null;
  if (!el || !msg || !btn) return;

  const value = el.value.trim();
  msg.textContent = '';
  if (!/^[A-Za-z0-9_]{3,20}$/.test(value)) {
    msg.textContent = '3–20 letters, numbers or underscores.';
    (msg as HTMLElement).style.color = '#f87171';
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Saving…';
  try {
    const res = await fetch('/api/profile/change-username', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username: value }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error ?? 'Something went wrong.');
    msg.textContent = 'Username updated. Reloading…';
    (msg as HTMLElement).style.color = 'var(--score-great)';
    setTimeout(() => location.reload(), 1200);
  } catch (e: any) {
    msg.textContent = e.message ?? 'Something went wrong.';
    (msg as HTMLElement).style.color = '#f87171';
    btn.disabled = false;
    btn.textContent = 'Save username';
  }
}
window.changeUsername = changeUsername;

async function steamSync() {
  const btn = document.getElementById('steamSyncBtn') as HTMLButtonElement | null;
  const msg = document.getElementById('steamSyncMsg');
  const results = document.getElementById('steamSyncResults');
  if (!btn || !msg || !results) return;

  btn.disabled = true;
  btn.textContent = 'Syncing…';
  msg.textContent = 'Fetching your Steam library…';
  results.style.display = 'none';

  const playedOnly = (document.getElementById('steamPlayedOnly') as HTMLInputElement | null)?.checked ?? false;
  try {
    const res = await fetch('/api/steam/import', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ playedOnly }),
    });
    const data = await res.json();

    if (!res.ok) {
      msg.textContent = data.error ?? 'Something went wrong.';
      (msg as HTMLElement).style.color = '#f87171';
    } else {
      msg.textContent = '';
      results.style.display = 'block';
      const removedLine = data.removed > 0 ? `<br>${data.removed} unplayed games removed` : '';
      results.innerHTML = `
        <strong>Sync complete</strong><br>
        ${data.matched} games added as Owned &nbsp;·&nbsp;
        ${data.updated} playtimes updated &nbsp;·&nbsp;
        ${data.unmatched} Steam games not yet in Chekpoint's library
        ${removedLine}
        <br><span style="color:var(--text-tertiary);font-size:11px">${data.total} total games in your Steam library</span>
      `;
    }
  } catch (e) {
    msg.textContent = 'Could not reach server. Please try again.';
    (msg as HTMLElement).style.color = '#f87171';
  } finally {
    btn.disabled = false;
    btn.textContent = 'Sync Steam library';
  }
}
window.steamSync = steamSync;

async function steamDisconnect() {
  const btn = document.getElementById('steamDisconnectBtn') as HTMLButtonElement | null;
  if (!btn) return;
  if (!confirm('Disconnect your Steam account? Your game statuses and playtimes will not be removed.')) return;

  btn.disabled = true;
  btn.textContent = 'Disconnecting…';

  try {
    const res = await fetch('/api/steam/disconnect', { method: 'POST' });
    if (res.ok) {
      window.location.reload();
    } else {
      const data = await res.json();
      alert(data.error ?? 'Failed to disconnect.');
      btn.disabled = false;
      btn.textContent = 'Disconnect';
    }
  } catch (e) {
    alert('Could not reach server. Please try again.');
    btn.disabled = false;
    btn.textContent = 'Disconnect';
  }
}
window.steamDisconnect = steamDisconnect;

