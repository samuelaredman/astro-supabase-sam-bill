async function psnSyncTrophies() {
  const btn = document.getElementById('psnTrophySyncBtn') as HTMLButtonElement | null;
  const msg = document.getElementById('psnTrophySyncMsg');
  const results = document.getElementById('psnTrophySyncResults');
  const progressBox = document.getElementById('psnTrophySyncProgress');
  const barFill = document.getElementById('psnTrophyBarFill');
  const progressText = document.getElementById('psnTrophyProgressText');
  if (!btn || !msg || !results || !progressBox || !barFill || !progressText) return;

  btn.disabled = true;
  btn.textContent = 'Syncing…';
  msg.textContent = 'Starting trophy sync…';
  (msg as HTMLElement).style.color = 'var(--text-secondary)';
  results.style.display = 'none';
  progressBox.style.display = 'block';

  let totalSynced = 0;
  let hitTrophies = 0;
  let emptyResponses = 0;
  let everSynced = false;
  let cursor: string | null = null;

  try {
    // Drive the cursor-based endpoint in a loop until done. Netlify caps each
    // call at 10s; the server returns partial progress + nextCursor.
    // Small hard cap on batches so a stuck sync can't loop forever.
    for (let batch = 0; batch < 200; batch++) {
      const bodyPayload: Record<string, unknown> = {};
      if (cursor !== null) bodyPayload.cursor = cursor;
      const res = await fetch('/api/psn/sync-trophies', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(bodyPayload),
      });
      const data = await res.json();
      if (!res.ok) {
        msg.textContent = data.error ?? 'Something went wrong.';
        (msg as HTMLElement).style.color = '#f87171';
        if (data.needsReconnect) {
          setTimeout(() => { window.location.href = '/settings?psn=expired#psn'; }, 1500);
        }
        return;
      }
      totalSynced += data.syncedThisCall ?? 0;
      hitTrophies += data.hitTrophies ?? 0;
      emptyResponses += data.emptyResponses ?? 0;
      everSynced = data.everSynced ?? everSynced;

      const pct = data.total > 0 ? Math.round((data.processed / data.total) * 100) : 100;
      (barFill as HTMLElement).style.width = `${pct}%`;
      progressText.textContent = `${data.processed} / ${data.total} titles (${pct}%)`;

      if (data.done) {
        cursor = null;
        break;
      }
      cursor = data.nextCursor;
    }

    msg.textContent = '';
    results.style.display = 'block';
    const emptyWarning = (hitTrophies === 0 && emptyResponses > 0 && !everSynced)
      ? `<br><span style="color:#f87171;font-size:12px">PlayStation returned no trophy data — check that <strong>My Trophies</strong> is set to <strong>Anyone</strong> in your PSN privacy settings.</span>`
      : '';
    results.innerHTML = `
      <strong>Trophy sync complete</strong><br>
      ${totalSynced} trophy rows written across ${hitTrophies} titles
      ${emptyWarning}
    `;
  } catch (e) {
    msg.textContent = 'Could not reach server. Please try again.';
    (msg as HTMLElement).style.color = '#f87171';
  } finally {
    btn.disabled = false;
    btn.textContent = 'Sync PlayStation trophies';
  }
}
window.psnSyncTrophies = psnSyncTrophies;

