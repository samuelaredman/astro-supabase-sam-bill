        }
        return;
      }
      totalSynced += data.syncedThisCall ?? 0;
      hitAchievements += data.hitAchievements ?? 0;
      emptyResponses += data.emptyResponses ?? 0;
      everSynced = data.everSynced ?? everSynced;

      const pct = data.total > 0 ? Math.round((data.processed / data.total) * 100) : 100;
      (barFill as HTMLElement).style.width = `${pct}%`;
      progressText.textContent = `${data.processed} / ${data.total} titles (${pct}%)`;

      if (data.done) {
        cursor = null;
        break;
      }
      cursor = data.nextCursor;
    }

    msg.textContent = '';
    results.style.display = 'block';
    const emptyWarning = (hitAchievements === 0 && emptyResponses > 0 && !everSynced)
      ? `<br><span style="color:#f87171;font-size:12px">Xbox returned no achievement data — check that your gamertag privacy allows achievements to be visible.</span>`
      : '';
    results.innerHTML = `
      <strong>Achievement sync complete</strong><br>
      ${totalSynced} achievement rows written across ${hitAchievements} titles
      ${emptyWarning}
    `;
  } catch (e) {
    msg.textContent = 'Could not reach server. Please try again.';
    (msg as HTMLElement).style.color = '#f87171';
  } finally {
    btn.disabled = false;
    btn.textContent = 'Sync Xbox achievements';
  }
}
