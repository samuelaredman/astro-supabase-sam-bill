---
export const prerender = false;
import { createSupabaseServerClientFromContext, getSupabaseAdmin } from "../utils/database";
import Layout from "../components/Layout.astro";

const serverClient = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await serverClient.auth.getUser();

if (!user) return Astro.redirect('/signin');

const db = getSupabaseAdmin() as any;
const { data: profile } = await db
  .from('profiles')
  .select('id, username, avatar_url, want_to_play_privacy, dropped_privacy, steam_id, steam_username, steam_synced_at')
  .eq('auth_user_id', user.id)
  .single();

const steamStatus = Astro.url.searchParams.get('steam'); // 'connected' | 'error' | 'cancelled' | null

if (!profile) return Astro.redirect('/signin');

function getInitials(u: string) { return u.slice(0, 2).toUpperCase(); }
---

<Layout
  title="Settings — Chekpoint"
  isLoggedIn={true}
  currentProfile={profile}
  activeNav="settings"
  variant="two-col"
>
  <main class="feed settings-main">

    <div class="settings-header">
      <h1 class="settings-title">Settings</h1>
      <div class="settings-anchors">
        <a href="#account" class="settings-anchor-link">Account</a>
        <a href="#security" class="settings-anchor-link">Security</a>
        <a href="#privacy" class="settings-anchor-link">Privacy</a>
        <a href="#steam" class="settings-anchor-link">Steam</a>
        <a href="#session" class="settings-anchor-link">Session</a>
      </div>
    </div>

    <!-- Account -->
    <section class="settings-section" id="account">
      <div class="settings-section-label">Account</div>
      <div class="settings-account-card">
        <div class="settings-avatar">
          {profile.avatar_url
            ? <img src={profile.avatar_url} alt={profile.username} />
            : <span>{getInitials(profile.username)}</span>
          }
        </div>
        <div class="settings-account-info">
          <div class="settings-username">@{profile.username}</div>
          <div class="settings-email">{user.email}</div>
        </div>
        <a href={`/reviewers/${profile.username}`} class="settings-view-profile">
          View profile →
        </a>
      </div>
    </section>

    <!-- Security -->
    <section class="settings-section" id="security">
      <div class="settings-section-label">Security</div>
      <div class="settings-row" style="flex-direction:column;align-items:stretch;gap:12px">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:16px">
          <div class="settings-row-text">
            <div class="settings-row-label">Change password</div>
            <div class="settings-row-sub">Must be at least 8 characters.</div>
          </div>
          <button type="button" class="settings-ghost-btn" id="pwToggleBtn" onclick="togglePwForm()">Change</button>
        </div>
        <div id="pwForm" style="display:none;border-top:1px solid var(--border-subtle);padding-top:14px;display:none;flex-direction:column;gap:10px">
          <input id="pwNew" type="password" class="settings-input" placeholder="New password" autocomplete="new-password" />
          <input id="pwConfirm" type="password" class="settings-input" placeholder="Confirm new password" autocomplete="new-password" />
          <div style="display:flex;align-items:center;gap:10px">
            <button type="button" class="settings-save-btn" id="pwSaveBtn" onclick="changePassword()">Update password</button>
            <span id="pwMsg" style="font-size:12px"></span>
          </div>
        </div>
      </div>
    </section>

    <!-- Privacy -->
    <section class="settings-section" id="privacy">
      <div class="settings-section-label">Privacy</div>
      <div class="settings-row" style="flex-direction:column;align-items:stretch;gap:0">
        <!-- Want to Play -->
        <div class="priv-row">
          <div class="settings-row-text">
            <div class="settings-row-label">🔖 Want to Play visibility</div>
            <div class="settings-row-sub">Who can see the games on your Want to Play list.</div>
          </div>
          <div class="priv-toggle" data-field="want_to_play_privacy">
            <button class={`priv-opt${(profile.want_to_play_privacy ?? 'public') === 'public' ? ' active' : ''}`} data-value="public" onclick="setPrivacy('want_to_play_privacy','public',this)">Public</button>
            <button class={`priv-opt${(profile.want_to_play_privacy ?? 'public') === 'friends' ? ' active' : ''}`} data-value="friends" onclick="setPrivacy('want_to_play_privacy','friends',this)">Friends</button>
            <button class={`priv-opt${(profile.want_to_play_privacy ?? 'public') === 'private' ? ' active' : ''}`} data-value="private" onclick="setPrivacy('want_to_play_privacy','private',this)">Private</button>
          </div>
        </div>
        <!-- Dropped -->
        <div class="priv-row" style="border-top:1px solid var(--border-subtle);margin-top:14px;padding-top:14px">
          <div class="settings-row-text">
            <div class="settings-row-label">✗ Dropped visibility</div>
            <div class="settings-row-sub">Who can see the games you've dropped.</div>
          </div>
          <div class="priv-toggle" data-field="dropped_privacy">
            <button class={`priv-opt${(profile.dropped_privacy ?? 'public') === 'public' ? ' active' : ''}`} data-value="public" onclick="setPrivacy('dropped_privacy','public',this)">Public</button>
            <button class={`priv-opt${(profile.dropped_privacy ?? 'public') === 'friends' ? ' active' : ''}`} data-value="friends" onclick="setPrivacy('dropped_privacy','friends',this)">Friends</button>
            <button class={`priv-opt${(profile.dropped_privacy ?? 'public') === 'private' ? ' active' : ''}`} data-value="private" onclick="setPrivacy('dropped_privacy','private',this)">Private</button>
          </div>
        </div>
        <div style="font-size:11px;color:var(--text-tertiary);margin-top:12px;padding-top:10px;border-top:1px solid var(--border-subtle)">
          "Friends" means people you mutually follow. Playing and Completed are always public.
        </div>
        <div id="privacyMsg" style="font-size:12px;min-height:16px;margin-top:4px"></div>
      </div>
    </section>

    <!-- Steam -->
    <section class="settings-section" id="steam">
      <div class="settings-section-label">Steam</div>
      <div class="settings-row" style="flex-direction:column;align-items:stretch;gap:14px">

        {steamStatus === 'connected' && (
          <div class="steam-banner steam-banner-ok">Steam account connected successfully.</div>
        )}
        {steamStatus === 'error' && (
          <div class="steam-banner steam-banner-err">Something went wrong connecting Steam. Please try again.</div>
        )}
        {steamStatus === 'cancelled' && (
          <div class="steam-banner steam-banner-err">Steam connection was cancelled.</div>
        )}

        {profile.steam_id ? (
          <>
            <div class="steam-connected-row">
              <div class="settings-row-text">
                <div class="settings-row-label">Connected as <strong>{profile.steam_username ?? profile.steam_id}</strong></div>
                {profile.steam_synced_at && (
                  <div class="settings-row-sub">
                    Last synced {new Date(profile.steam_synced_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </div>
                )}
                {!profile.steam_synced_at && (
                  <div class="settings-row-sub">Library not synced yet — click Sync below.</div>
                )}
              </div>
              <button class="settings-ghost-btn steam-disconnect-btn" id="steamDisconnectBtn" onclick="steamDisconnect()">Disconnect</button>
            </div>

            <div style="border-top:1px solid var(--border-subtle);padding-top:14px">
              <div class="settings-row-label" style="margin-bottom:4px">Sync library</div>
              <div class="settings-row-sub" style="margin-bottom:12px">
                Imports your Steam games as <strong>Owned</strong> and updates playtime. Won't overwrite statuses you've set manually.
              </div>
              <label style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--text-secondary);margin-bottom:12px;cursor:pointer">
                <input type="checkbox" id="steamPlayedOnly" style="accent-color:var(--accent)">
                Only import games I've played (Will remove games added to Chekpoint via Steam sync that have 0 playtime)
              </label>
              <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
                <button class="settings-save-btn" id="steamSyncBtn" onclick="steamSync()">Sync Steam library</button>
                <span id="steamSyncMsg" style="font-size:12px;color:var(--text-secondary)"></span>
              </div>
              <div id="steamSyncResults" class="steam-results" style="display:none"></div>
            </div>
          </>
        ) : (
          <div class="steam-connect-row">
            <div class="settings-row-text">
              <div class="settings-row-label">Connect your Steam account</div>
              <div class="settings-row-sub">Import your library and playtime to quickly build out your game collection on Chekpoint.</div>
            </div>
            <a href="/api/auth/steam-connect" class="settings-save-btn steam-connect-btn">Connect Steam</a>
          </div>
        )}

      </div>
    </section>

    <!-- Session -->
    <section class="settings-section" id="session">
      <div class="settings-section-label">Session</div>
      <div class="settings-row">
        <div class="settings-row-text">
          <div class="settings-row-label">Sign out</div>
          <div class="settings-row-sub">You'll need to sign back in to post or interact.</div>
        </div>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="settings-signout-btn">Sign out</button>
        </form>
      </div>
    </section>

  </main>
</Layout>

<style>
  .settings-main {
    min-width: 0;
    padding: 24px 24px 64px;
    max-width: 640px;
  }

  .settings-header {
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .settings-title {
    font-family: 'DM Serif Display', serif;
    font-size: 26px;
    font-weight: 400;
    color: var(--text-primary);
    margin: 0 0 12px;
  }
  .settings-anchors {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .settings-anchor-link {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-tertiary);
    background: var(--tag-bg);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 4px 12px;
    transition: color 0.15s, border-color 0.15s;
    text-decoration: none;
  }
  .settings-anchor-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ── Sections ── */
  .settings-section {
    margin-bottom: 32px;
  }
  .settings-section-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    margin-bottom: 12px;
  }

  /* ── Account card ── */
  .settings-account-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
  }
  .settings-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--tag-bg);
    border: 1px solid var(--border);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
    overflow: hidden;
  }
  .settings-avatar img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .settings-account-info {
    flex: 1;
    min-width: 0;
  }
  .settings-username {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 3px;
  }
  .settings-email {
    font-size: 13px;
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .settings-view-profile {
    font-size: 13px;
    color: var(--text-tertiary);
    white-space: nowrap;
    transition: color 0.15s;
    flex-shrink: 0;
  }
  .settings-view-profile:hover { color: var(--text-primary); }

  /* ── Generic row ── */
  .settings-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
  }
  .settings-row-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 3px;
  }
  .settings-row-sub {
    font-size: 12px;
    color: var(--text-tertiary);
    line-height: 1.5;
  }

  /* ── Inputs ── */
  .settings-input {
    width: 100%;
    padding: 9px 12px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text-primary);
    font-size: 13px;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s;
    box-sizing: border-box;
  }
  .settings-input:focus { border-color: var(--accent); }

  /* ── Ghost / save buttons ── */
  .settings-ghost-btn {
    background: none;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 500;
    font-family: inherit;
    color: var(--text-secondary);
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.15s, color 0.15s;
    flex-shrink: 0;
  }
  .settings-ghost-btn:hover { border-color: var(--accent); color: var(--accent); }
  .settings-save-btn {
    background: var(--accent);
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 500;
    font-family: inherit;
    color: #fff;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.15s;
    flex-shrink: 0;
  }
  .settings-save-btn:hover { opacity: 0.85; }
  .settings-save-btn:disabled { opacity: 0.5; cursor: default; }

  /* ── Sign out button ── */
  .settings-signout-btn {
    background: none;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 500;
    font-family: inherit;
    color: var(--text-secondary);
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .settings-signout-btn:hover {
    border-color: #f87171;
    color: #f87171;
    background: rgba(248, 113, 113, 0.06);
  }

  /* ── Privacy ── */
  .priv-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .priv-toggle {
    display: flex;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .priv-opt {
    background: none;
    border: none;
    border-right: 1px solid var(--border);
    padding: 7px 14px;
    font-size: 12px;
    font-weight: 500;
    font-family: inherit;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
  }
  .priv-opt:last-child { border-right: none; }
  .priv-opt:hover { background: var(--bg-hover); color: var(--text-primary); }
  .priv-opt.active { background: var(--accent); color: white; }
  .priv-opt.active:hover { background: var(--accent); opacity: 0.9; }

  /* ── Steam ── */
  .steam-banner {
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 13px;
  }
  .steam-banner-ok  { background: rgba(74,222,128,.08); color: #4ade80; border: 1px solid rgba(74,222,128,.2); }
  .steam-banner-err { background: rgba(248,113,113,.08); color: #f87171; border: 1px solid rgba(248,113,113,.2); }

  .steam-connected-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .steam-disconnect-btn:hover { border-color: #f87171 !important; color: #f87171 !important; }

  .steam-connect-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .steam-connect-btn {
    text-decoration: none;
    display: inline-block;
    flex-shrink: 0;
  }

  .steam-results {
    margin-top: 12px;
    padding: 12px 14px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .settings-main { padding: 16px 16px 80px; }
    .settings-account-card { flex-wrap: wrap; }
    .settings-view-profile { width: 100%; margin-top: 4px; }
    .priv-row { flex-direction: column; align-items: flex-start; }
    .steam-connect-row, .steam-connected-row { flex-direction: column; align-items: flex-start; }
    .steam-connect-btn { width: 100%; text-align: center; }
  }
</style>

<script>
declare global {
  interface Window {
    togglePwForm: () => void;
    changePassword: () => Promise<void>;
    setPrivacy: (field: string, value: string, btn: HTMLElement) => Promise<void>;
    steamSync: () => Promise<void>;
    steamDisconnect: () => Promise<void>;
  }
}

async function setPrivacy(field: string, value: string, btn: HTMLElement) {
  const toggle = btn.closest('.priv-toggle') as HTMLElement | null;
  if (!toggle) return;
  // Capture previous active button before optimistic update so we can revert on failure
  const prevActive = toggle.querySelector('.priv-opt.active') as HTMLElement | null;
  // Optimistic UI update
  toggle.querySelectorAll('.priv-opt').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const msg = document.getElementById('privacyMsg');
  if (msg) { msg.textContent = ''; }
  try {
    const res = await fetch('/api/profile/privacy', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ [field]: value }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error ?? 'Failed to save');
    if (msg) {
      msg.textContent = 'Privacy settings saved.';
      (msg as HTMLElement).style.color = 'var(--score-great, #4ade80)';
      setTimeout(() => { if (msg) msg.textContent = ''; }, 2500);
    }
  } catch (e: any) {
    // Revert optimistic update to previous active state
    toggle.querySelectorAll('.priv-opt').forEach(b => b.classList.remove('active'));
    prevActive?.classList.add('active');
    if (msg) {
      msg.textContent = e.message ?? 'Something went wrong.';
      (msg as HTMLElement).style.color = '#f87171';
    }
  }
}
window.setPrivacy = setPrivacy;

function togglePwForm() {
  const form = document.getElementById('pwForm');
  const btn = document.getElementById('pwToggleBtn');
  if (!form || !btn) return;
  const open = form.style.display === 'flex';
  form.style.display = open ? 'none' : 'flex';
  btn.textContent = open ? 'Change' : 'Cancel';
}
window.togglePwForm = togglePwForm;

async function changePassword() {
  const newPwEl = document.getElementById('pwNew') as HTMLInputElement | null;
  const confirmEl = document.getElementById('pwConfirm') as HTMLInputElement | null;
  const msg = document.getElementById('pwMsg');
  const btn = document.getElementById('pwSaveBtn') as HTMLButtonElement | null;

  if (!newPwEl || !confirmEl || !msg || !btn) return;

  const newPw = newPwEl.value;
  const confirm = confirmEl.value;

  msg.textContent = '';
  if (!newPw || newPw.length < 8) {
    msg.textContent = 'Password must be at least 8 characters.';
    (msg as HTMLElement).style.color = '#f87171';
    return;
  }
  if (newPw !== confirm) {
    msg.textContent = 'Passwords do not match.';
    (msg as HTMLElement).style.color = '#f87171';
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Updating…';
  const res = await fetch('/api/auth/update-password', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ password: newPw }),
  });
  const data = await res.json();
  btn.disabled = false;
  btn.textContent = 'Update password';

  if (res.ok) {
    msg.textContent = 'Password updated.';
    (msg as HTMLElement).style.color = 'var(--score-great)';
    newPwEl.value = '';
    confirmEl.value = '';
    setTimeout(togglePwForm, 1500);
  } else {
    msg.textContent = data.error ?? 'Something went wrong.';
    (msg as HTMLElement).style.color = '#f87171';
  }
}
window.changePassword = changePassword;

async function steamSync() {
  const btn = document.getElementById('steamSyncBtn') as HTMLButtonElement | null;
  const msg = document.getElementById('steamSyncMsg');
  const results = document.getElementById('steamSyncResults');
  if (!btn || !msg || !results) return;

  btn.disabled = true;
  btn.textContent = 'Syncing…';
  msg.textContent = 'Fetching your Steam library…';
  results.style.display = 'none';

  const playedOnly = (document.getElementById('steamPlayedOnly') as HTMLInputElement | null)?.checked ?? false;
  try {
    const res = await fetch('/api/steam/import', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ playedOnly }),
    });
    const data = await res.json();

    if (!res.ok) {
      msg.textContent = data.error ?? 'Something went wrong.';
      (msg as HTMLElement).style.color = '#f87171';
    } else {
      msg.textContent = '';
      results.style.display = 'block';
      const removedLine = data.removed > 0 ? `<br>${data.removed} unplayed games removed` : '';
      results.innerHTML = `
        <strong>Sync complete</strong><br>
        ${data.matched} games added as Owned &nbsp;·&nbsp;
        ${data.updated} playtimes updated &nbsp;·&nbsp;
        ${data.unmatched} Steam games not yet in Chekpoint's library
        ${removedLine}
        <br><span style="color:var(--text-tertiary);font-size:11px">${data.total} total games in your Steam library</span>
      `;
    }
  } catch (e) {
    msg.textContent = 'Could not reach server. Please try again.';
    (msg as HTMLElement).style.color = '#f87171';
  } finally {
    btn.disabled = false;
    btn.textContent = 'Sync Steam library';
  }
}
window.steamSync = steamSync;

async function steamDisconnect() {
  const btn = document.getElementById('steamDisconnectBtn') as HTMLButtonElement | null;
  if (!btn) return;
  if (!confirm('Disconnect your Steam account? Your game statuses and playtimes will not be removed.')) return;

  btn.disabled = true;
  btn.textContent = 'Disconnecting…';

  try {
    const res = await fetch('/api/steam/disconnect', { method: 'POST' });
    if (res.ok) {
      window.location.reload();
    } else {
      const data = await res.json();
      alert(data.error ?? 'Failed to disconnect.');
      btn.disabled = false;
      btn.textContent = 'Disconnect';
    }
  } catch (e) {
    alert('Could not reach server. Please try again.');
    btn.disabled = false;
    btn.textContent = 'Disconnect';
  }
}
window.steamDisconnect = steamDisconnect;
</script>
