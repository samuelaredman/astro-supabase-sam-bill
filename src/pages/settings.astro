// ─── Backloggd import ────────────────────────────────────────────────────────
import {
  previewBackloggd,
  startAndDrive,
  resumeActive,
  fetchStatus,
  mapItem,
  importLibraryFile,
  type ImportProgress,
} from "../utils/backloggd/importClient";

const blEl = (id: string) => document.getElementById(id);
let blActiveController: AbortController | null = null;

function blSetMsg(text: string, ok = false) {
  const m = blEl("blMsg");
  if (!m) return;
  m.textContent = text;
  m.style.color = ok ? "var(--score-great, #4ade80)" : "#f87171";
}

function blRenderProgress(p: ImportProgress) {
  const wrap = blEl("blProgress");
  const fill = blEl("blBarFill");
  const txt = blEl("blProgressText");
  if (!wrap || !fill || !txt) return;
  wrap.style.display = "block";
  fill.style.width = p.fraction == null ? "50%" : `${Math.round(p.fraction * 100)}%`;
  fill.style.opacity = p.phase === "rate-limited" ? "0.5" : "1";
  txt.textContent = p.message;
}

function blRenderResults(job: any) {
  const box = blEl("blResults");
  if (!box) return;
  box.style.display = "block";
  const parts = [
    `<strong>${job.imported_count}</strong> reviews imported`,
    job.draft_count ? `<strong>${job.draft_count}</strong> saved as drafts (no rating)` : "",
    job.skipped_count ? `<strong>${job.skipped_count}</strong> skipped (already reviewed)` : "",
    job.failed_count ? `<strong>${job.failed_count}</strong> failed` : "",
  ].filter(Boolean);
  box.innerHTML =
    parts.join("<br>") +
    (job.needs_mapping_count
      ? `<br><strong>${job.needs_mapping_count}</strong> game${job.needs_mapping_count === 1 ? "" : "s"} need matching below.`
      : "");
}

function blDebounce<T extends (...a: any[]) => void>(fn: T, ms: number) {
  let t: any;
  return (...a: Parameters<T>) => {
    clearTimeout(t);
    t = setTimeout(() => fn(...a), ms);
  };
}

async function blMatchAndRemove(row: HTMLElement, itemId: string, igdbId: number) {
  try {
    const r = await mapItem(itemId, igdbId);
    row.innerHTML = `<span class="bl-map-title">${r.game.title}</span> <span style="color:var(--score-great,#4ade80)">${r.status === "imported" || r.status === "drafted" ? "imported" : r.status}</span>`;
    if (r.job) blRenderResults(r.job);
  } catch (e: any) {
    blSetMsg(e?.message ?? "Match failed.");
  }
}

function blRenderNeedsMapping(items: any[]) {
  const box = blEl("blNeedsMapping");
  if (!box) return;
  if (!items.length) {
    box.style.display = "none";
    box.innerHTML = "";
    return;
  }
  box.style.display = "flex";
  box.innerHTML = "";
  for (const item of items) {
    const row = document.createElement("div");
    row.className = "bl-map-row";
    const yr = item.release_year ? ` (${item.release_year})` : "";
    row.innerHTML = `
      <span class="bl-map-title">${item.game_title}${yr}</span>
      <input type="text" placeholder="Search Chekpoint / IGDB…" />
      <div class="bl-map-candidates"></div>`;
    const input = row.querySelector("input") as HTMLInputElement;
    const list = row.querySelector(".bl-map-candidates") as HTMLElement;
    input.value = item.game_title;
    const search = blDebounce(async () => {
      const q = input.value.trim();
      if (q.length < 2) return;
      try {
        const res = await fetch(`/api/games/search?q=${encodeURIComponent(q)}`);
        const results = await res.json();
        list.innerHTML = "";
        for (const g of (results ?? []).slice(0, 6)) {
          const igdbId = g.igdb_id ?? g.igdbId ?? null;
          if (!igdbId) continue; // can only import via IGDB id
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "bl-map-candidate";
          btn.textContent = `${g.title}${g.year ? ` (${g.year})` : ""}`;
          btn.onclick = () => blMatchAndRemove(row, item.id, Number(igdbId));
          list.appendChild(btn);
        }
        if (!list.children.length) {
          list.innerHTML = `<div style="font-size:12px;color:var(--text-tertiary)">No IGDB match — try a different title.</div>`;
        }
      } catch {
        /* ignore */
      }
    }, 300);
    input.addEventListener("input", search);
    box.appendChild(row);
  }
}

async function blFinish(jobId: string) {
  try {
    const { job, needs_mapping } = await fetchStatus(jobId);
    blRenderResults(job);
    blRenderNeedsMapping(needs_mapping);
    // Suppress the one-time onboarding step now that they've run an import.
    fetch("/api/import/backloggd/skip-onboarding", { method: "POST" }).catch(() => {});
  } catch {
    /* results are best-effort */
  }
}

async function blDrive(start: { username: string } | { rows: unknown[] }) {
  blEl("blStartRow")!.style.display = "none";
  blEl("blPreview")!.style.display = "none";
  blActiveController?.abort();
  blActiveController = new AbortController();
  try {
    const { job } = await startAndDrive(start, {
      onProgress: blRenderProgress,
      signal: blActiveController.signal,
    });
    blRenderProgress({ phase: "done", fraction: 1, message: "Import complete" });
    await blFinish(job.id);
  } catch (e: any) {
    if (e?.name === "AbortError") return;
    blSetMsg(e?.message ?? "Import failed.");
    blEl("blStartRow")!.style.display = "flex";
  }
}

async function blPreview() {
  const input = blEl("blUsername") as HTMLInputElement | null;
  const btn = blEl("blPreviewBtn") as HTMLButtonElement | null;
  if (!input || !btn) return;
  const username = input.value.trim();
  if (!username) return blSetMsg("Enter your Backloggd username.");
  btn.disabled = true;
  blSetMsg("Checking…", true);
  try {
    const p = await previewBackloggd(username);
    blSetMsg("");
    const box = blEl("blPreview")!;
    box.style.display = "block";
    box.innerHTML = `
      Found <strong>${p.totalReviews}</strong> review${p.totalReviews === 1 ? "" : "s"} for
      <strong>${p.username}</strong>${p.totalPages > 1 ? ` across ${p.totalPages} pages` : ""}.
      <ul class="bl-sample">${p.sample
        .map(
          (s: any) =>
            `<li>${s.game_title}${s.rating ? ` — ${s.rating}&#9733;` : " — (no rating)"}</li>`,
        )
        .join("")}</ul>
      <button class="settings-save-btn" id="blGoBtn">Import ${p.totalReviews} review${p.totalReviews === 1 ? "" : "s"}</button>`;
    blEl("blGoBtn")!.addEventListener("click", () => blDrive({ username: p.username }));
  } catch (e: any) {
    blSetMsg(e?.message ?? "Could not check that username.");
  } finally {
    btn.disabled = false;
  }
}
window.blPreview = blPreview;

async function blRun(_mode: "username") {
  const input = blEl("blUsername") as HTMLInputElement | null;
  if (input?.value.trim()) blDrive({ username: input.value.trim() });
}
window.blRun = blRun;

async function blUpload() {
  const fileInput = blEl("blFile") as HTMLInputElement | null;
  const file = fileInput?.files?.[0];
  if (!file) return blSetMsg("Choose the exported .json file first.");
  try {
    const parsed = JSON.parse(await file.text());
    const rows = Array.isArray(parsed) ? parsed : parsed?.rows;
    if (!Array.isArray(rows) || !rows.length) {
      return blSetMsg("That file doesn't look like a Backloggd export.");
    }
    blSetMsg("");
    blDrive({ rows });
  } catch {
    blSetMsg("Could not read that file — is it the .json the console step downloaded?");
  }
}
window.blUpload = blUpload;

function blCopySnippet() {
  const el = blEl("blSnippet");
  if (!el) return;
  navigator.clipboard?.writeText(el.textContent ?? "").then(
    () => blSetMsg("Copied — paste it into the console on backloggd.com.", true),
    () => blSetMsg("Press Ctrl/Cmd+C to copy."),
  );
}
window.blCopySnippet = blCopySnippet;

function blCopyLibSnippet() {
  const el = blEl("blLibSnippet");
  const msg = blEl("blLibMsg");
  if (!el || !msg) return;
  navigator.clipboard?.writeText(el.textContent ?? "").then(
    () => { msg.textContent = "Copied — paste into the console on backloggd.com."; msg.style.color = "var(--score-great, #4ade80)"; },
    () => { msg.textContent = "Press Ctrl/Cmd+C to copy."; msg.style.color = "#f87171"; },
  );
}
window.blCopyLibSnippet = blCopyLibSnippet;

async function blLibImport() {
  const fileInput = blEl("blLibFile") as HTMLInputElement | null;
  const btn = blEl("blLibBtn") as HTMLButtonElement | null;
  const msg = blEl("blLibMsg");
  const results = blEl("blLibResults");
  if (!fileInput || !btn || !msg || !results) return;
  const file = fileInput.files?.[0];
  if (!file) { msg.textContent = "Choose the exported .json file first."; msg.style.color = "#f87171"; return; }

  let rows: unknown[];
  try {
    const parsed = JSON.parse(await file.text());
    rows = Array.isArray(parsed) ? parsed : parsed?.rows;
    if (!Array.isArray(rows) || !rows.length) throw new Error();
  } catch {
    msg.textContent = "That file doesn't look like a Backloggd library export.";
    msg.style.color = "#f87171";
    return;
  }

  btn.disabled = true;
  btn.textContent = "Importing…";
  msg.style.color = "var(--text-secondary)";

  try {
    const totals = await importLibraryFile(rows, {
      onProgress: (p) => { msg.textContent = p.message; },
    });
    msg.textContent = "";
    results.style.display = "block";
    const lines = [
      `<strong>${totals.applied}</strong> game${totals.applied === 1 ? "" : "s"} added to your library`,
      totals.imported ? `<strong>${totals.imported}</strong> new game${totals.imported === 1 ? "" : "s"} pulled in from IGDB` : "",
      totals.already ? `<strong>${totals.already}</strong> already had a status (left as-is)` : "",
      totals.unmatched ? `<strong>${totals.unmatched}</strong> couldn't be identified` : "",
    ].filter(Boolean);
    results.innerHTML =
      lines.join("<br>") +
      (totals.unmatchedSample.length
        ? `<br><span style="color:var(--text-tertiary);font-size:11px">e.g. ${totals.unmatchedSample.slice(0, 8).join(", ")}</span>`
        : "");
  } catch (e: any) {
    msg.textContent = e?.message ?? "Could not reach the server. Try again.";
    msg.style.color = "#f87171";
  } finally {
    btn.disabled = false;
    btn.textContent = "Import library";
  }
}
window.blLibImport = blLibImport;

// Reattach to an import that's still running (e.g. after a page reload).
(async () => {
  try {
    blActiveController = new AbortController();
    const resumed = await resumeActive({
      onProgress: blRenderProgress,
      signal: blActiveController.signal,
    });
    if (resumed?.job) {
      blEl("blStartRow")!.style.display = "none";
      blRenderProgress({ phase: "done", fraction: 1, message: "Import complete" });
      await blFinish(resumed.job.id);
    }
  } catch {
    /* nothing to resume */
  }
})();

