async function xboxSyncAchievements() {
  const btn = document.getElementById('xboxAchSyncBtn') as HTMLButtonElement | null;
  const msg = document.getElementById('xboxAchSyncMsg');
  const results = document.getElementById('xboxAchSyncResults');
