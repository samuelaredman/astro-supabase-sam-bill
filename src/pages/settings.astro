<script>
declare global {
  interface Window {
    togglePwForm: () => void;
    changePassword: () => Promise<void>;
    toggleUnForm: () => void;
    changeUsername: () => Promise<void>;
    setPrivacy: (field: string, value: string, btn: HTMLElement) => Promise<void>;
    setSearchIndexable: (value: boolean, btn: HTMLElement) => Promise<void>;
    toggleSettingsSection: (id: string) => void;
    steamSync: () => Promise<void>;
    steamDisconnect: () => Promise<void>;
    psnConnect: () => Promise<void>;
    psnConnectByUsername: () => Promise<void>;
    psnSync: () => Promise<void>;
    psnSyncTrophies: () => Promise<void>;
    psnDisconnect: () => Promise<void>;
    xboxConnect: () => void;
    xboxSync: () => Promise<void>;
    xboxSyncAchievements: () => Promise<void>;
    xboxDisconnect: () => Promise<void>;
    blPreview: () => Promise<void>;
    blRun: (mode: "username") => Promise<void>;
    blUpload: () => Promise<void>;
    blCopySnippet: () => void;
    blCopyLibSnippet: () => void;
    blLibImport: () => Promise<void>;
    srStart: () => Promise<void>;
    srPreview: () => Promise<void>;
  }
}

async function setPrivacy(field: string, value: string, btn: HTMLElement) {
  const toggle = btn.closest('.priv-toggle') as HTMLElement | null;
  if (!toggle) return;
  // Capture previous active button before optimistic update so we can revert on failure
  const prevActive = toggle.querySelector('.priv-opt.active') as HTMLElement | null;
  // Optimistic UI update
  toggle.querySelectorAll('.priv-opt').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const msg = document.getElementById('privacyMsg');
  if (msg) { msg.textContent = ''; }
  try {
    const res = await fetch('/api/profile/privacy', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ [field]: value }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error ?? 'Failed to save');
    if (msg) {
      msg.textContent = 'Privacy settings saved.';
      (msg as HTMLElement).style.color = 'var(--score-great, #4ade80)';
      setTimeout(() => { if (msg) msg.textContent = ''; }, 2500);
    }
  } catch (e: any) {
    // Revert optimistic update to previous active state
    toggle.querySelectorAll('.priv-opt').forEach(b => b.classList.remove('active'));
    prevActive?.classList.add('active');
    if (msg) {
      msg.textContent = e.message ?? 'Something went wrong.';
      (msg as HTMLElement).style.color = '#f87171';
    }
  }
}
window.setPrivacy = setPrivacy;

async function setSearchIndexable(value: boolean, btn: HTMLElement) {
  const toggle = btn.closest('.priv-toggle') as HTMLElement | null;
  if (!toggle) return;
  const prevActive = toggle.querySelector('.priv-opt.active') as HTMLElement | null;
  // Optimistic UI update
  toggle.querySelectorAll('.priv-opt').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const msg = document.getElementById('searchIndexableMsg');
  if (msg) { msg.textContent = ''; }
  try {
    const res = await fetch('/api/profile/privacy', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ search_indexable: value }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error ?? 'Failed to save');
    if (msg) {
      msg.textContent = value
        ? 'Your content can now appear in search engines. It may take days for changes to show up.'
        : 'Search engines will no longer index your content.';
      (msg as HTMLElement).style.color = 'var(--score-great, #4ade80)';
      setTimeout(() => { if (msg) msg.textContent = ''; }, 4000);
    }
  } catch (e: any) {
    // Revert optimistic update on failure
    toggle.querySelectorAll('.priv-opt').forEach(b => b.classList.remove('active'));
    prevActive?.classList.add('active');
    if (msg) {
      msg.textContent = e.message ?? 'Something went wrong.';
      (msg as HTMLElement).style.color = '#f87171';
    }
  }
}
window.setSearchIndexable = setSearchIndexable;

// ─── Collapsible sections (Steam / PSN / Backloggd) ─────────────────────────
function toggleSettingsSection(id: string) {
  const section = document.getElementById(id);
  if (!section) return;
  const collapsed = section.getAttribute('data-collapsed') === 'true';
  section.setAttribute('data-collapsed', collapsed ? 'false' : 'true');
  const header = section.querySelector('.settings-section-header');
  if (header) header.setAttribute('aria-expanded', collapsed ? 'true' : 'false');
}
window.toggleSettingsSection = toggleSettingsSection;

// Auto-expand a section if the URL points at it — either a query param from
// the Steam/PSN connect callbacks (?steam=connected, ?psn=expired) or a hash
// jump (#steam, #psn, #backloggd) from anywhere else on the site. Users
// arriving mid-flow shouldn't have to click to see what just happened.
(function autoExpandFromUrl() {
  try {
    const params = new URLSearchParams(window.location.search);
    const hash = (window.location.hash || '').replace('#', '');
    const shouldExpand = new Set<string>();
    if (params.has('steam')) shouldExpand.add('steam');
    if (params.has('psn')) shouldExpand.add('psn');
    if (params.has('xbox')) shouldExpand.add('xbox');
    if (['steam', 'psn', 'xbox', 'backloggd'].includes(hash)) shouldExpand.add(hash);
    shouldExpand.forEach((id) => {
      const section = document.getElementById(id);
      if (!section) return;
      section.setAttribute('data-collapsed', 'false');
      const header = section.querySelector('.settings-section-header');
      if (header) header.setAttribute('aria-expanded', 'true');
      // Scroll into view for hash-jumps — the page anchor would normally do
      // this, but we defer expansion so re-trigger explicitly.
      if (hash === id) section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  } catch { /* URL parsing failures are non-fatal — just leave collapsed */ }
})();

function togglePwForm() {
  const form = document.getElementById('pwForm');
  const btn = document.getElementById('pwToggleBtn');
  if (!form || !btn) return;
  const open = form.style.display === 'flex';
  form.style.display = open ? 'none' : 'flex';
  btn.textContent = open ? 'Change' : 'Cancel';
}
window.togglePwForm = togglePwForm;

async function changePassword() {
  const newPwEl = document.getElementById('pwNew') as HTMLInputElement | null;
  const confirmEl = document.getElementById('pwConfirm') as HTMLInputElement | null;
  const msg = document.getElementById('pwMsg');
  const btn = document.getElementById('pwSaveBtn') as HTMLButtonElement | null;

  if (!newPwEl || !confirmEl || !msg || !btn) return;

  const newPw = newPwEl.value;
  const confirm = confirmEl.value;

  msg.textContent = '';
  if (!newPw || newPw.length < 8) {
    msg.textContent = 'Password must be at least 8 characters.';
    (msg as HTMLElement).style.color = '#f87171';
    return;
  }
  if (newPw !== confirm) {
    msg.textContent = 'Passwords do not match.';
    (msg as HTMLElement).style.color = '#f87171';
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Updating…';
  const res = await fetch('/api/auth/update-password', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ password: newPw }),
  });
  const data = await res.json();
  btn.disabled = false;
  btn.textContent = 'Update password';

  if (res.ok) {
    msg.textContent = 'Password updated.';
    (msg as HTMLElement).style.color = 'var(--score-great)';
    newPwEl.value = '';
    confirmEl.value = '';
    setTimeout(togglePwForm, 1500);
  } else {
    msg.textContent = data.error ?? 'Something went wrong.';
    (msg as HTMLElement).style.color = '#f87171';
  }
}
window.changePassword = changePassword;

function toggleUnForm() {
  const form = document.getElementById('unForm');
