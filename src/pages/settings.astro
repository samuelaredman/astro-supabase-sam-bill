---
export const prerender = false;
import { createSupabaseServerClientFromContext, getSupabaseAdmin } from "../utils/database";
import Layout from "../components/Layout.astro";

const serverClient = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await serverClient.auth.getUser();

if (!user) return Astro.redirect('/signin');

const db = getSupabaseAdmin() as any;
const { data: profile } = await db
  .from('profiles')
  .select('id, username, avatar_url, want_to_play_privacy, dropped_privacy, search_indexable, steam_id, steam_username, steam_synced_at')
  .eq('auth_user_id', user.id)
  .single();

const steamStatus = Astro.url.searchParams.get('steam'); // 'connected' | 'error' | 'cancelled' | null

if (!profile) return Astro.redirect('/signin');

const { data: adminRow } = await db
  .from('site_admins')
  .select('profile_id')
  .eq('profile_id', profile.id)
  .maybeSingle();
const isSiteAdmin = !!adminRow;

function getInitials(u: string) { return u.slice(0, 2).toUpperCase(); }
---

<Layout
  title="Settings — Chekpoint"
  isLoggedIn={true}
  currentProfile={profile}
  activeNav="settings"
  variant="two-col"
>
  <main class="feed settings-main">

    <div class="settings-header">
      <h1 class="settings-title">Settings</h1>
    </div>

    <!-- Account -->
    <section class="settings-section" id="account">
      <div class="settings-section-label">Account</div>
      <div class="settings-account-card">
        <div class="settings-avatar">
          {profile.avatar_url
            ? <img src={profile.avatar_url} alt={profile.username} />
            : <span>{getInitials(profile.username)}</span>
          }
        </div>
        <div class="settings-account-info">
          <div class="settings-username">@{profile.username}</div>
          <div class="settings-email">{user.email}</div>
        </div>
        <a href={`/reviewers/${profile.username}`} class="settings-view-profile">
          View profile →
        </a>
      </div>
    </section>

    <!-- Security -->
    <section class="settings-section" id="security">
      <div class="settings-section-label">Security</div>
      <div class="settings-row" style="flex-direction:column;align-items:stretch;gap:12px">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:16px">
          <div class="settings-row-text">
            <div class="settings-row-label">Change password</div>
            <div class="settings-row-sub">Must be at least 8 characters.</div>
          </div>
          <button type="button" class="settings-ghost-btn" id="pwToggleBtn" onclick="togglePwForm()">Change</button>
        </div>
        <div id="pwForm" style="display:none;border-top:1px solid var(--border-subtle);padding-top:14px;display:none;flex-direction:column;gap:10px">
          <input id="pwNew" type="password" class="settings-input" placeholder="New password" autocomplete="new-password" />
          <input id="pwConfirm" type="password" class="settings-input" placeholder="Confirm new password" autocomplete="new-password" />
          <div style="display:flex;align-items:center;gap:10px">
            <button type="button" class="settings-save-btn" id="pwSaveBtn" onclick="changePassword()">Update password</button>
            <span id="pwMsg" style="font-size:12px"></span>
          </div>
        </div>
      </div>
    </section>

    <!-- Privacy -->
    <section class="settings-section" id="privacy">
      <div class="settings-section-label">Privacy</div>
      <div class="settings-row" style="flex-direction:column;align-items:stretch;gap:0">
        <!-- Want to Play -->
        <div class="priv-row">
          <div class="settings-row-text">
            <div class="settings-row-label">🔖 Want to Play visibility</div>
            <div class="settings-row-sub">Who can see the games on your Want to Play list.</div>
          </div>
          <div class="priv-toggle" data-field="want_to_play_privacy">
            <button class={`priv-opt${(profile.want_to_play_privacy ?? 'public') === 'public' ? ' active' : ''}`} data-value="public" onclick="setPrivacy('want_to_play_privacy','public',this)">Public</button>
            <button class={`priv-opt${(profile.want_to_play_privacy ?? 'public') === 'friends' ? ' active' : ''}`} data-value="friends" onclick="setPrivacy('want_to_play_privacy','friends',this)">Friends</button>
            <button class={`priv-opt${(profile.want_to_play_privacy ?? 'public') === 'private' ? ' active' : ''}`} data-value="private" onclick="setPrivacy('want_to_play_privacy','private',this)">Private</button>
          </div>
        </div>
        <!-- Dropped -->
        <div class="priv-row" style="border-top:1px solid var(--border-subtle);margin-top:14px;padding-top:14px">
          <div class="settings-row-text">
            <div class="settings-row-label">✗ Dropped visibility</div>
            <div class="settings-row-sub">Who can see the games you've dropped.</div>
          </div>
          <div class="priv-toggle" data-field="dropped_privacy">
            <button class={`priv-opt${(profile.dropped_privacy ?? 'public') === 'public' ? ' active' : ''}`} data-value="public" onclick="setPrivacy('dropped_privacy','public',this)">Public</button>
            <button class={`priv-opt${(profile.dropped_privacy ?? 'public') === 'friends' ? ' active' : ''}`} data-value="friends" onclick="setPrivacy('dropped_privacy','friends',this)">Friends</button>
            <button class={`priv-opt${(profile.dropped_privacy ?? 'public') === 'private' ? ' active' : ''}`} data-value="private" onclick="setPrivacy('dropped_privacy','private',this)">Private</button>
          </div>
        </div>
        <div style="font-size:11px;color:var(--text-tertiary);margin-top:12px;padding-top:10px;border-top:1px solid var(--border-subtle)">
          "Friends" means people you mutually follow. Playing and Completed are always public.
        </div>
        <div id="privacyMsg" style="font-size:12px;min-height:16px;margin-top:4px"></div>
      </div>

      <!-- Search engine visibility — GDPR opt-in consent, off by default -->
      <div class="settings-row" id="search-visibility" style="flex-direction:column;align-items:stretch;gap:0;margin-top:14px">
        <div class="priv-row">
          <div class="settings-row-text">
            <div class="settings-row-label">🔎 Search engine visibility</div>
            <div class="settings-row-sub">
              Let search engines like Google index your public profile, reviews, recommendations, comments and lists so they can appear in search results. Off by default — your content stays on Chekpoint until you opt in, and you can turn this off again at any time.
            </div>
          </div>
          <div class="priv-toggle" data-field="search_indexable">
            <button class={`priv-opt${profile.search_indexable ? '' : ' active'}`} data-value="off" onclick="setSearchIndexable(false, this)">Off</button>
            <button class={`priv-opt${profile.search_indexable ? ' active' : ''}`} data-value="on" onclick="setSearchIndexable(true, this)">On</button>
          </div>
        </div>
        <div id="searchIndexableMsg" style="font-size:12px;min-height:16px;margin-top:8px"></div>
      </div>
    </section>

    <!-- Steam -->
    <section class="settings-section" id="steam">
      <div class="settings-section-label">Steam</div>
      <div class="settings-row" style="flex-direction:column;align-items:stretch;gap:14px">

        {steamStatus === 'connected' && (
          <div class="steam-banner steam-banner-ok">Steam account connected successfully.</div>
        )}
        {steamStatus === 'error' && (
          <div class="steam-banner steam-banner-err">Something went wrong connecting Steam. Please try again.</div>
        )}
        {steamStatus === 'cancelled' && (
          <div class="steam-banner steam-banner-err">Steam connection was cancelled.</div>
        )}

        {profile.steam_id ? (
          <>
            <div class="steam-connected-row">
              <div class="settings-row-text">
                <div class="settings-row-label">Connected as <strong>{profile.steam_username ?? profile.steam_id}</strong></div>
                {profile.steam_synced_at && (
                  <div class="settings-row-sub">
                    Last synced {new Date(profile.steam_synced_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </div>
                )}
                {!profile.steam_synced_at && (
                  <div class="settings-row-sub">Library not synced yet — click Sync below.</div>
                )}
              </div>
              <button class="settings-ghost-btn steam-disconnect-btn" id="steamDisconnectBtn" onclick="steamDisconnect()">Disconnect</button>
            </div>

            <div style="border-top:1px solid var(--border-subtle);padding-top:14px">
              <div class="settings-row-label" style="margin-bottom:4px">Sync library</div>
              <div class="settings-row-sub" style="margin-bottom:12px">
                Imports your Steam games as <strong>Owned</strong> and updates playtime. Won't overwrite statuses you've set manually.
              </div>
              <div class="steam-privacy-note">
                <strong>Steam privacy requirements</strong>
                <ul style="margin:4px 0 0 0;padding-left:16px">
                  <li><strong>Game details</strong> must be set to <strong>Public</strong> (Go to Steam → Edit Profile → Privacy Settings → Game details)</li>
                  <li>To sync playtime, uncheck <strong>"Always keep my total playtime private"</strong> in those same settings — otherwise all games will appear as 0 hours and the "played only" filter below will skip everything</li>
                </ul>
              </div>
              <label style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--text-secondary);margin-bottom:12px;cursor:pointer">
                <input type="checkbox" id="steamPlayedOnly" style="accent-color:var(--accent)">
                Only import games I've played — skips games with 0 hours (Uncheck "Always keep my total playtime private..." under Game Details in Privacy Settings)
              </label>
              <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
                <button class="settings-save-btn" id="steamSyncBtn" onclick="steamSync()">Sync Steam library</button>
                <span id="steamSyncMsg" style="font-size:12px;color:var(--text-secondary)"></span>
              </div>
              <div id="steamSyncResults" class="steam-results" style="display:none"></div>
            </div>
          </>
        ) : (
          <div class="steam-connect-row">
            <div class="settings-row-text">
              <div class="settings-row-label">Connect your Steam account</div>
              <div class="settings-row-sub">Import your library and playtime to quickly build out your game collection on Chekpoint.</div>
            </div>
            <a href="/api/auth/steam-connect" class="settings-save-btn steam-connect-btn">Connect Steam</a>
          </div>
        )}

      </div>
    </section>

    <!-- Backloggd -->
    <section class="settings-section" id="backloggd">
      <div class="settings-section-label">Backloggd</div>
      <div class="settings-row" style="flex-direction:column;align-items:stretch;gap:14px">
        <div class="settings-row-text">
          <div class="settings-row-label">Import your reviews</div>
          <div class="settings-row-sub">
            Brings your written Backloggd reviews across as Chekpoint reviews. Ratings map
            0.5&#9733; &rarr; 1 and 5&#9733; &rarr; 10; a review with no rating comes in as a draft.
            Reviews only &mdash; not backlog or wishlist. Games you already reviewed here are skipped.
          </div>
        </div>

        <div id="blStartRow" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
          <input id="blUsername" type="text" placeholder="Backloggd username" autocomplete="off"
            style="flex:1;min-width:180px;padding:8px 10px;border:1px solid var(--border);border-radius:8px;background:var(--bg-card);color:var(--text-primary);font-size:13px" />
          <button class="settings-save-btn" id="blPreviewBtn" onclick="blPreview()">Preview</button>
          <span id="blMsg" style="font-size:12px;color:var(--text-secondary)"></span>
        </div>

        <div id="blPreview" class="bl-preview" style="display:none"></div>

        <div id="blProgress" class="bl-progress" style="display:none">
          <div class="bl-bar"><div class="bl-bar-fill" id="blBarFill"></div></div>
          <div class="bl-progress-text" id="blProgressText"></div>
        </div>

        <div id="blResults" class="steam-results" style="display:none"></div>
        <div id="blNeedsMapping" class="bl-needs-mapping" style="display:none"></div>

        <details class="bl-manual">
          <summary>Import isn&rsquo;t working, or my reviews are private</summary>
          <div class="bl-manual-body">
            <ol style="margin:8px 0 0 0;padding-left:18px;line-height:1.7">
              <li>Open <a href="https://backloggd.com" target="_blank" rel="noopener">backloggd.com</a> and sign in, then go to your profile.</li>
              <li>Open your browser&rsquo;s developer console (F12, then the <strong>Console</strong> tab).</li>
              <li>Paste this and press Enter:
                <code class="bl-snippet" id="blSnippet">fetch('https://chekpoint.gg/api/import/backloggd/scraper.js').then(r=&gt;r.text()).then(eval)</code>
                <button type="button" class="settings-ghost-btn" onclick="blCopySnippet()" style="margin-top:6px">Copy</button>
              </li>
              <li>Wait for it to download <code>backloggd-chekpoint-export.json</code>, then choose that file here:</li>
            </ol>
            <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:10px">
              <input type="file" id="blFile" accept="application/json" />
              <button class="settings-save-btn" id="blUploadBtn" onclick="blUpload()">Import from file</button>
            </div>
          </div>
        </details>

        <div style="border-top:1px solid var(--border-subtle);padding-top:16px;margin-top:4px">
          <div class="settings-row-label" style="margin-bottom:4px">Import your library &amp; statuses</div>
          <div class="settings-row-sub" style="margin-bottom:10px">
            Brings your Backloggd games across with their play state &mdash; Played &rarr; Completed,
            Playing &rarr; Playing, Backlog &amp; Wishlist &rarr; Want to play, Retired &rarr; Dropped.
            Won&rsquo;t change a status you&rsquo;ve already set. Backloggd blocks automated access to
            its library, so this uses the console step too:
          </div>
          <ol style="margin:0;padding-left:18px;line-height:1.7">
            <li>On <a href="https://backloggd.com" target="_blank" rel="noopener">backloggd.com</a> (signed in, on your profile), open the console and run:
              <code class="bl-snippet" id="blLibSnippet">fetch('https://chekpoint.gg/api/import/backloggd/library-scraper.js').then(r=&gt;r.text()).then(eval)</code>
              <button type="button" class="settings-ghost-btn" onclick="blCopyLibSnippet()" style="margin-top:6px">Copy</button>
            </li>
            <li>Upload the downloaded <code>backloggd-chekpoint-library.json</code>:</li>
          </ol>
          <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:10px">
            <input type="file" id="blLibFile" accept="application/json" />
            <button class="settings-save-btn" id="blLibBtn" onclick="blLibImport()">Import library</button>
            <span id="blLibMsg" style="font-size:12px;color:var(--text-secondary)"></span>
          </div>
          <div id="blLibResults" class="steam-results" style="display:none"></div>
        </div>
      </div>
    </section>

    {isSiteAdmin && (
      <section class="settings-section" id="admin">
        <div class="settings-section-label">Admin</div>
        <div class="settings-row">
          <div class="settings-row-text">
            <div class="settings-row-label">Site admin tools</div>
            <div class="settings-row-sub">Unmatched Steam titles and moderation reports (Sam &amp; Bill only).</div>
          </div>
          <a href="/admin" class="settings-save-btn">Open</a>
        </div>
      </section>
    )}

    <!-- Session -->
    <section class="settings-section" id="session">
      <div class="settings-section-label">Session</div>
      <div class="settings-row">
        <div class="settings-row-text">
          <div class="settings-row-label">Sign out</div>
          <div class="settings-row-sub">You'll need to sign back in to post or interact.</div>
        </div>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="settings-signout-btn">Sign out</button>
        </form>
      </div>
    </section>

  </main>
</Layout>

<style>
  .settings-main {
    min-width: 0;
    padding: 24px 24px 64px;
    max-width: 640px;
  }

  .settings-header {
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .settings-title {
    font-family: 'DM Serif Display', serif;
    font-size: 26px;
    font-weight: 400;
    color: var(--text-primary);
    margin: 0 0 12px;
  }
  /* ── Sections ── */
  .settings-section {
    margin-bottom: 32px;
  }
  .settings-section-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    margin-bottom: 12px;
  }

  /* ── Account card ── */
  .settings-account-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
  }
  .settings-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--tag-bg);
    border: 1px solid var(--border);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
    overflow: hidden;
  }
  .settings-avatar img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .settings-account-info {
    flex: 1;
    min-width: 0;
  }
  .settings-username {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 3px;
  }
  .settings-email {
    font-size: 13px;
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .settings-view-profile {
    font-size: 13px;
    color: var(--text-tertiary);
    white-space: nowrap;
    transition: color 0.15s;
    flex-shrink: 0;
  }
  .settings-view-profile:hover { color: var(--text-primary); }

  /* ── Generic row ── */
  .settings-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
  }
  .settings-row-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 3px;
  }
  .settings-row-sub {
    font-size: 12px;
    color: var(--text-tertiary);
    line-height: 1.5;
  }

  /* ── Inputs ── */
  .settings-input {
    width: 100%;
    padding: 9px 12px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text-primary);
    font-size: 13px;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s;
    box-sizing: border-box;
  }
  .settings-input:focus { border-color: var(--accent); }

  /* ── Ghost / save buttons ── */
  .settings-ghost-btn {
    background: none;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 500;
    font-family: inherit;
    color: var(--text-secondary);
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.15s, color 0.15s;
    flex-shrink: 0;
  }
  .settings-ghost-btn:hover { border-color: var(--accent); color: var(--accent); }
  .settings-save-btn {
    background: var(--accent);
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 500;
    font-family: inherit;
    color: #fff;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.15s;
    flex-shrink: 0;
  }
  .settings-save-btn:hover { opacity: 0.85; }
  .settings-save-btn:disabled { opacity: 0.5; cursor: default; }

  /* ── Sign out button ── */
  .settings-signout-btn {
    background: none;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 500;
    font-family: inherit;
    color: var(--text-secondary);
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .settings-signout-btn:hover {
    border-color: #f87171;
    color: #f87171;
    background: rgba(248, 113, 113, 0.06);
  }

  /* ── Privacy ── */
  .priv-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .priv-toggle {
    display: flex;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .priv-opt {
    background: none;
    border: none;
    border-right: 1px solid var(--border);
    padding: 7px 14px;
    font-size: 12px;
    font-weight: 500;
    font-family: inherit;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
  }
  .priv-opt:last-child { border-right: none; }
  .priv-opt:hover { background: var(--bg-hover); color: var(--text-primary); }
  .priv-opt.active { background: var(--accent); color: white; }
  .priv-opt.active:hover { background: var(--accent); opacity: 0.9; }

  /* ── Steam ── */
  .steam-privacy-note {
    font-size: 12px;
    color: var(--text-secondary);
    background: rgba(96,80,200,.08);
    border: 1px solid rgba(96,80,200,.2);
    border-radius: 8px;
    padding: 10px 14px;
    margin-bottom: 12px;
    line-height: 1.5;
  }
  .steam-privacy-note strong { color: var(--text-primary); }
  .steam-banner {
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 13px;
  }
  .steam-banner-ok  { background: rgba(74,222,128,.08); color: #4ade80; border: 1px solid rgba(74,222,128,.2); }
  .steam-banner-err { background: rgba(248,113,113,.08); color: #f87171; border: 1px solid rgba(248,113,113,.2); }

  .steam-connected-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .steam-disconnect-btn:hover { border-color: #f87171 !important; color: #f87171 !important; }

  .steam-connect-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .steam-connect-btn {
    text-decoration: none;
    display: inline-block;
    flex-shrink: 0;
  }

  .steam-results {
    margin-top: 12px;
    padding: 12px 14px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* ── Backloggd ── */
  .bl-preview {
    padding: 12px 14px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
  }
  .bl-preview .bl-sample { margin: 8px 0 10px; padding-left: 16px; }
  .bl-preview .bl-sample li { margin-bottom: 2px; }
  .bl-bar {
    height: 8px;
    border-radius: 999px;
    background: var(--bg-hover);
    overflow: hidden;
  }
  .bl-bar-fill {
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: var(--accent);
    transition: width .3s ease;
  }
  .bl-progress-text { margin-top: 8px; font-size: 12px; color: var(--text-secondary); }
  .bl-needs-mapping {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .bl-map-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 10px 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 13px;
  }
  .bl-map-row .bl-map-title { font-weight: 500; color: var(--text-primary); }
  .bl-map-row input {
    flex: 1;
    min-width: 160px;
    padding: 6px 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-card);
    color: var(--text-primary);
    font-size: 12px;
  }
  .bl-map-candidates { display: flex; flex-direction: column; gap: 4px; width: 100%; }
  .bl-map-candidate {
    text-align: left;
    padding: 6px 8px;
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    background: var(--bg-card);
    color: var(--text-secondary);
    font-size: 12px;
    cursor: pointer;
  }
  .bl-map-candidate:hover { border-color: var(--accent); color: var(--text-primary); }
  .bl-manual { margin-top: 4px; font-size: 13px; }
  .bl-manual summary { cursor: pointer; color: var(--text-secondary); }
  .bl-manual-body { margin-top: 10px; color: var(--text-secondary); line-height: 1.6; }
  .bl-snippet {
    display: block;
    margin-top: 6px;
    padding: 8px 10px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    word-break: break-all;
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .settings-main { padding: 16px 16px 80px; }
    .settings-account-card { flex-wrap: wrap; }
    .settings-view-profile { width: 100%; margin-top: 4px; }
    .priv-row { flex-direction: column; align-items: flex-start; }
    .steam-connect-row, .steam-connected-row { flex-direction: column; align-items: flex-start; }
    .steam-connect-btn { width: 100%; text-align: center; }
  }
</style>

<script>
declare global {
  interface Window {
    togglePwForm: () => void;
    changePassword: () => Promise<void>;
    setPrivacy: (field: string, value: string, btn: HTMLElement) => Promise<void>;
    setSearchIndexable: (value: boolean, btn: HTMLElement) => Promise<void>;
    steamSync: () => Promise<void>;
    steamDisconnect: () => Promise<void>;
    blPreview: () => Promise<void>;
    blRun: (mode: "username") => Promise<void>;
    blUpload: () => Promise<void>;
    blCopySnippet: () => void;
    blCopyLibSnippet: () => void;
    blLibImport: () => Promise<void>;
  }
}

async function setPrivacy(field: string, value: string, btn: HTMLElement) {
  const toggle = btn.closest('.priv-toggle') as HTMLElement | null;
  if (!toggle) return;
  // Capture previous active button before optimistic update so we can revert on failure
  const prevActive = toggle.querySelector('.priv-opt.active') as HTMLElement | null;
  // Optimistic UI update
  toggle.querySelectorAll('.priv-opt').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const msg = document.getElementById('privacyMsg');
  if (msg) { msg.textContent = ''; }
  try {
    const res = await fetch('/api/profile/privacy', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ [field]: value }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error ?? 'Failed to save');
    if (msg) {
      msg.textContent = 'Privacy settings saved.';
      (msg as HTMLElement).style.color = 'var(--score-great, #4ade80)';
      setTimeout(() => { if (msg) msg.textContent = ''; }, 2500);
    }
  } catch (e: any) {
    // Revert optimistic update to previous active state
    toggle.querySelectorAll('.priv-opt').forEach(b => b.classList.remove('active'));
    prevActive?.classList.add('active');
    if (msg) {
      msg.textContent = e.message ?? 'Something went wrong.';
      (msg as HTMLElement).style.color = '#f87171';
    }
  }
}
window.setPrivacy = setPrivacy;

async function setSearchIndexable(value: boolean, btn: HTMLElement) {
  const toggle = btn.closest('.priv-toggle') as HTMLElement | null;
  if (!toggle) return;
  const prevActive = toggle.querySelector('.priv-opt.active') as HTMLElement | null;
  // Optimistic UI update
  toggle.querySelectorAll('.priv-opt').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const msg = document.getElementById('searchIndexableMsg');
  if (msg) { msg.textContent = ''; }
  try {
    const res = await fetch('/api/profile/privacy', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ search_indexable: value }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error ?? 'Failed to save');
    if (msg) {
      msg.textContent = value
        ? 'Your content can now appear in search engines. It may take days for changes to show up.'
        : 'Search engines will no longer index your content.';
      (msg as HTMLElement).style.color = 'var(--score-great, #4ade80)';
      setTimeout(() => { if (msg) msg.textContent = ''; }, 4000);
    }
  } catch (e: any) {
    // Revert optimistic update on failure
    toggle.querySelectorAll('.priv-opt').forEach(b => b.classList.remove('active'));
    prevActive?.classList.add('active');
    if (msg) {
      msg.textContent = e.message ?? 'Something went wrong.';
      (msg as HTMLElement).style.color = '#f87171';
    }
  }
}
window.setSearchIndexable = setSearchIndexable;

function togglePwForm() {
  const form = document.getElementById('pwForm');
  const btn = document.getElementById('pwToggleBtn');
  if (!form || !btn) return;
  const open = form.style.display === 'flex';
  form.style.display = open ? 'none' : 'flex';
  btn.textContent = open ? 'Change' : 'Cancel';
}
window.togglePwForm = togglePwForm;

async function changePassword() {
  const newPwEl = document.getElementById('pwNew') as HTMLInputElement | null;
  const confirmEl = document.getElementById('pwConfirm') as HTMLInputElement | null;
  const msg = document.getElementById('pwMsg');
  const btn = document.getElementById('pwSaveBtn') as HTMLButtonElement | null;

  if (!newPwEl || !confirmEl || !msg || !btn) return;

  const newPw = newPwEl.value;
  const confirm = confirmEl.value;

  msg.textContent = '';
  if (!newPw || newPw.length < 8) {
    msg.textContent = 'Password must be at least 8 characters.';
    (msg as HTMLElement).style.color = '#f87171';
    return;
  }
  if (newPw !== confirm) {
    msg.textContent = 'Passwords do not match.';
    (msg as HTMLElement).style.color = '#f87171';
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Updating…';
  const res = await fetch('/api/auth/update-password', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ password: newPw }),
  });
  const data = await res.json();
  btn.disabled = false;
  btn.textContent = 'Update password';

  if (res.ok) {
    msg.textContent = 'Password updated.';
    (msg as HTMLElement).style.color = 'var(--score-great)';
    newPwEl.value = '';
    confirmEl.value = '';
    setTimeout(togglePwForm, 1500);
  } else {
    msg.textContent = data.error ?? 'Something went wrong.';
    (msg as HTMLElement).style.color = '#f87171';
  }
}
window.changePassword = changePassword;

async function steamSync() {
  const btn = document.getElementById('steamSyncBtn') as HTMLButtonElement | null;
  const msg = document.getElementById('steamSyncMsg');
  const results = document.getElementById('steamSyncResults');
  if (!btn || !msg || !results) return;

  btn.disabled = true;
  btn.textContent = 'Syncing…';
  msg.textContent = 'Fetching your Steam library…';
  results.style.display = 'none';

  const playedOnly = (document.getElementById('steamPlayedOnly') as HTMLInputElement | null)?.checked ?? false;
  try {
    const res = await fetch('/api/steam/import', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ playedOnly }),
    });
    const data = await res.json();

    if (!res.ok) {
      msg.textContent = data.error ?? 'Something went wrong.';
      (msg as HTMLElement).style.color = '#f87171';
    } else {
      msg.textContent = '';
      results.style.display = 'block';
      const removedLine = data.removed > 0 ? `<br>${data.removed} unplayed games removed` : '';
      results.innerHTML = `
        <strong>Sync complete</strong><br>
        ${data.matched} games added as Owned &nbsp;·&nbsp;
        ${data.updated} playtimes updated &nbsp;·&nbsp;
        ${data.unmatched} Steam games not yet in Chekpoint's library
        ${removedLine}
        <br><span style="color:var(--text-tertiary);font-size:11px">${data.total} total games in your Steam library</span>
      `;
    }
  } catch (e) {
    msg.textContent = 'Could not reach server. Please try again.';
    (msg as HTMLElement).style.color = '#f87171';
  } finally {
    btn.disabled = false;
    btn.textContent = 'Sync Steam library';
  }
}
window.steamSync = steamSync;

async function steamDisconnect() {
  const btn = document.getElementById('steamDisconnectBtn') as HTMLButtonElement | null;
  if (!btn) return;
  if (!confirm('Disconnect your Steam account? Your game statuses and playtimes will not be removed.')) return;

  btn.disabled = true;
  btn.textContent = 'Disconnecting…';

  try {
    const res = await fetch('/api/steam/disconnect', { method: 'POST' });
    if (res.ok) {
      window.location.reload();
    } else {
      const data = await res.json();
      alert(data.error ?? 'Failed to disconnect.');
      btn.disabled = false;
      btn.textContent = 'Disconnect';
    }
  } catch (e) {
    alert('Could not reach server. Please try again.');
    btn.disabled = false;
    btn.textContent = 'Disconnect';
  }
}
window.steamDisconnect = steamDisconnect;

// ─── Backloggd import ────────────────────────────────────────────────────────
import {
  previewBackloggd,
  startAndDrive,
  resumeActive,
  fetchStatus,
  mapItem,
  type ImportProgress,
} from "../utils/backloggd/importClient";

const blEl = (id: string) => document.getElementById(id);
let blActiveController: AbortController | null = null;

function blSetMsg(text: string, ok = false) {
  const m = blEl("blMsg");
  if (!m) return;
  m.textContent = text;
  m.style.color = ok ? "var(--score-great, #4ade80)" : "#f87171";
}

function blRenderProgress(p: ImportProgress) {
  const wrap = blEl("blProgress");
  const fill = blEl("blBarFill");
  const txt = blEl("blProgressText");
  if (!wrap || !fill || !txt) return;
  wrap.style.display = "block";
  fill.style.width = p.fraction == null ? "50%" : `${Math.round(p.fraction * 100)}%`;
  fill.style.opacity = p.phase === "rate-limited" ? "0.5" : "1";
  txt.textContent = p.message;
}

function blRenderResults(job: any) {
  const box = blEl("blResults");
  if (!box) return;
  box.style.display = "block";
  const parts = [
    `<strong>${job.imported_count}</strong> reviews imported`,
    job.draft_count ? `<strong>${job.draft_count}</strong> saved as drafts (no rating)` : "",
    job.skipped_count ? `<strong>${job.skipped_count}</strong> skipped (already reviewed)` : "",
    job.failed_count ? `<strong>${job.failed_count}</strong> failed` : "",
  ].filter(Boolean);
  box.innerHTML =
    parts.join("<br>") +
    (job.needs_mapping_count
      ? `<br><strong>${job.needs_mapping_count}</strong> game${job.needs_mapping_count === 1 ? "" : "s"} need matching below.`
      : "");
}

function blDebounce<T extends (...a: any[]) => void>(fn: T, ms: number) {
  let t: any;
  return (...a: Parameters<T>) => {
    clearTimeout(t);
    t = setTimeout(() => fn(...a), ms);
  };
}

async function blMatchAndRemove(row: HTMLElement, itemId: string, igdbId: number) {
  try {
    const r = await mapItem(itemId, igdbId);
    row.innerHTML = `<span class="bl-map-title">${r.game.title}</span> <span style="color:var(--score-great,#4ade80)">${r.status === "imported" || r.status === "drafted" ? "imported" : r.status}</span>`;
    if (r.job) blRenderResults(r.job);
  } catch (e: any) {
    blSetMsg(e?.message ?? "Match failed.");
  }
}

function blRenderNeedsMapping(items: any[]) {
  const box = blEl("blNeedsMapping");
  if (!box) return;
  if (!items.length) {
    box.style.display = "none";
    box.innerHTML = "";
    return;
  }
  box.style.display = "flex";
  box.innerHTML = "";
  for (const item of items) {
    const row = document.createElement("div");
    row.className = "bl-map-row";
    const yr = item.release_year ? ` (${item.release_year})` : "";
    row.innerHTML = `
      <span class="bl-map-title">${item.game_title}${yr}</span>
      <input type="text" placeholder="Search Chekpoint / IGDB…" />
      <div class="bl-map-candidates"></div>`;
    const input = row.querySelector("input") as HTMLInputElement;
    const list = row.querySelector(".bl-map-candidates") as HTMLElement;
    input.value = item.game_title;
    const search = blDebounce(async () => {
      const q = input.value.trim();
      if (q.length < 2) return;
      try {
        const res = await fetch(`/api/games/search?q=${encodeURIComponent(q)}`);
        const results = await res.json();
        list.innerHTML = "";
        for (const g of (results ?? []).slice(0, 6)) {
          const igdbId = g.igdb_id ?? g.igdbId ?? null;
          if (!igdbId) continue; // can only import via IGDB id
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "bl-map-candidate";
          btn.textContent = `${g.title}${g.year ? ` (${g.year})` : ""}`;
          btn.onclick = () => blMatchAndRemove(row, item.id, Number(igdbId));
          list.appendChild(btn);
        }
        if (!list.children.length) {
          list.innerHTML = `<div style="font-size:12px;color:var(--text-tertiary)">No IGDB match — try a different title.</div>`;
        }
      } catch {
        /* ignore */
      }
    }, 300);
    input.addEventListener("input", search);
    box.appendChild(row);
  }
}

async function blFinish(jobId: string) {
  try {
    const { job, needs_mapping } = await fetchStatus(jobId);
    blRenderResults(job);
    blRenderNeedsMapping(needs_mapping);
    // Suppress the one-time onboarding step now that they've run an import.
    fetch("/api/import/backloggd/skip-onboarding", { method: "POST" }).catch(() => {});
  } catch {
    /* results are best-effort */
  }
}

async function blDrive(start: { username: string } | { rows: unknown[] }) {
  blEl("blStartRow")!.style.display = "none";
  blEl("blPreview")!.style.display = "none";
  blActiveController?.abort();
  blActiveController = new AbortController();
  try {
    const { job } = await startAndDrive(start, {
      onProgress: blRenderProgress,
      signal: blActiveController.signal,
    });
    blRenderProgress({ phase: "done", fraction: 1, message: "Import complete" });
    await blFinish(job.id);
  } catch (e: any) {
    if (e?.name === "AbortError") return;
    blSetMsg(e?.message ?? "Import failed.");
    blEl("blStartRow")!.style.display = "flex";
  }
}

async function blPreview() {
  const input = blEl("blUsername") as HTMLInputElement | null;
  const btn = blEl("blPreviewBtn") as HTMLButtonElement | null;
  if (!input || !btn) return;
  const username = input.value.trim();
  if (!username) return blSetMsg("Enter your Backloggd username.");
  btn.disabled = true;
  blSetMsg("Checking…", true);
  try {
    const p = await previewBackloggd(username);
    blSetMsg("");
    const box = blEl("blPreview")!;
    box.style.display = "block";
    box.innerHTML = `
      Found <strong>${p.totalReviews}</strong> review${p.totalReviews === 1 ? "" : "s"} for
      <strong>${p.username}</strong>${p.totalPages > 1 ? ` across ${p.totalPages} pages` : ""}.
      <ul class="bl-sample">${p.sample
        .map(
          (s: any) =>
            `<li>${s.game_title}${s.rating ? ` — ${s.rating}&#9733;` : " — (no rating)"}</li>`,
        )
        .join("")}</ul>
      <button class="settings-save-btn" id="blGoBtn">Import ${p.totalReviews} review${p.totalReviews === 1 ? "" : "s"}</button>`;
    blEl("blGoBtn")!.addEventListener("click", () => blDrive({ username: p.username }));
  } catch (e: any) {
    blSetMsg(e?.message ?? "Could not check that username.");
  } finally {
    btn.disabled = false;
  }
}
window.blPreview = blPreview;

async function blRun(_mode: "username") {
  const input = blEl("blUsername") as HTMLInputElement | null;
  if (input?.value.trim()) blDrive({ username: input.value.trim() });
}
window.blRun = blRun;

async function blUpload() {
  const fileInput = blEl("blFile") as HTMLInputElement | null;
  const file = fileInput?.files?.[0];
  if (!file) return blSetMsg("Choose the exported .json file first.");
  try {
    const parsed = JSON.parse(await file.text());
    const rows = Array.isArray(parsed) ? parsed : parsed?.rows;
    if (!Array.isArray(rows) || !rows.length) {
      return blSetMsg("That file doesn't look like a Backloggd export.");
    }
    blSetMsg("");
    blDrive({ rows });
  } catch {
    blSetMsg("Could not read that file — is it the .json the console step downloaded?");
  }
}
window.blUpload = blUpload;

function blCopySnippet() {
  const el = blEl("blSnippet");
  if (!el) return;
  navigator.clipboard?.writeText(el.textContent ?? "").then(
    () => blSetMsg("Copied — paste it into the console on backloggd.com.", true),
    () => blSetMsg("Press Ctrl/Cmd+C to copy."),
  );
}
window.blCopySnippet = blCopySnippet;

function blCopyLibSnippet() {
  const el = blEl("blLibSnippet");
  const msg = blEl("blLibMsg");
  if (!el || !msg) return;
  navigator.clipboard?.writeText(el.textContent ?? "").then(
    () => { msg.textContent = "Copied — paste into the console on backloggd.com."; msg.style.color = "var(--score-great, #4ade80)"; },
    () => { msg.textContent = "Press Ctrl/Cmd+C to copy."; msg.style.color = "#f87171"; },
  );
}
window.blCopyLibSnippet = blCopyLibSnippet;

async function blLibImport() {
  const fileInput = blEl("blLibFile") as HTMLInputElement | null;
  const btn = blEl("blLibBtn") as HTMLButtonElement | null;
  const msg = blEl("blLibMsg");
  const results = blEl("blLibResults");
  if (!fileInput || !btn || !msg || !results) return;
  const file = fileInput.files?.[0];
  if (!file) { msg.textContent = "Choose the exported .json file first."; msg.style.color = "#f87171"; return; }

  let rows: unknown[];
  try {
    const parsed = JSON.parse(await file.text());
    rows = Array.isArray(parsed) ? parsed : parsed?.rows;
    if (!Array.isArray(rows) || !rows.length) throw new Error();
  } catch {
    msg.textContent = "That file doesn't look like a Backloggd library export.";
    msg.style.color = "#f87171";
    return;
  }

  btn.disabled = true;
  btn.textContent = "Importing…";
  msg.style.color = "var(--text-secondary)";

  const totals = { applied: 0, already: 0, unmatched: 0, imported: 0 };
  const unmatchedSample: string[] = [];
  let cursor: number | null = 0;
  try {
    while (cursor != null) {
      const res: Response = await fetch("/api/import/backloggd/library", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ rows, cursor }),
      });
      const data: any = await res.json();
      if (!res.ok) {
        if (res.status === 429 && data.retry_after) {
          msg.textContent = `Rate-limited — retrying in ${data.retry_after}s…`;
          await new Promise((r) => setTimeout(r, (data.retry_after + 1) * 1000));
          continue;
        }
        msg.textContent = data.error ?? "Import failed.";
        msg.style.color = "#f87171";
        return;
      }
      totals.applied += data.applied ?? 0;
      totals.already += data.already ?? 0;
      totals.unmatched += data.unmatched ?? 0;
      totals.imported += data.imported_from_igdb ?? 0;
      for (const t of data.unmatched_sample ?? []) if (unmatchedSample.length < 12) unmatchedSample.push(t);
      const doneCount = data.done ? data.total : data.next_cursor;
      msg.textContent = `Matching games… ${doneCount} / ${data.total}`;
      cursor = data.done ? null : data.next_cursor;
    }

    msg.textContent = "";
    results.style.display = "block";
    const lines = [
      `<strong>${totals.applied}</strong> game${totals.applied === 1 ? "" : "s"} added to your library`,
      totals.imported ? `<strong>${totals.imported}</strong> new game${totals.imported === 1 ? "" : "s"} pulled in from IGDB` : "",
      totals.already ? `<strong>${totals.already}</strong> already had a status (left as-is)` : "",
      totals.unmatched ? `<strong>${totals.unmatched}</strong> couldn't be identified` : "",
    ].filter(Boolean);
    results.innerHTML =
      lines.join("<br>") +
      (unmatchedSample.length
        ? `<br><span style="color:var(--text-tertiary);font-size:11px">e.g. ${unmatchedSample.slice(0, 8).join(", ")}</span>`
        : "");
  } catch {
    msg.textContent = "Could not reach the server. Try again.";
    msg.style.color = "#f87171";
  } finally {
    btn.disabled = false;
    btn.textContent = "Import library";
  }
}
window.blLibImport = blLibImport;

// Reattach to an import that's still running (e.g. after a page reload).
(async () => {
  try {
    blActiveController = new AbortController();
    const resumed = await resumeActive({
      onProgress: blRenderProgress,
      signal: blActiveController.signal,
    });
    if (resumed?.job) {
      blEl("blStartRow")!.style.display = "none";
      blRenderProgress({ phase: "done", fraction: 1, message: "Import complete" });
      await blFinish(resumed.job.id);
    }
  } catch {
    /* nothing to resume */
  }
})();
</script>
