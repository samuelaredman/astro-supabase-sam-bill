---
export const prerender = false;
import { getSupabase, getSupabaseAdmin } from '../../utils/database'
import { igdbFetch } from '../../utils/igdb'
import { igdbImage } from '../../utils/format'
import { isAllowedGameCategory } from '../../utils/games'
import DetailNav from '../../components/DetailNav.astro'
import { setPageCacheHeaders } from '../../utils/cache';
import { getPageUser } from '../../utils/pageAuth';
import { hubStatsFor, avgScore, reviewCount, pooled, type HubStatRow } from '../../utils/hubStats'
import { fetchAll } from '../../utils/fetchAll'

const supabase = getSupabase()
const _studioUser = await getPageUser(Astro);
const isLoggedIn = !!_studioUser;

let currentProfile: { id: string; username: string; avatar_url: string | null } | null = null;
if (_studioUser) {
  const { data: cp } = await (supabase as any)
    .from('profiles').select('id, username, avatar_url').eq('auth_user_id', _studioUser.id).single();
  currentProfile = cp ?? null;
}

const { slug = '' } = Astro.params;

const { data: studio } = await supabase
  .from('developers')
  .select(`
    id, name, slug, country, description,
    website_url, logo_url, founded_year, igdb_id
  `)
  .eq('slug', slug)
  .single()

if (!studio) return Astro.redirect('/404')

// Authoritative indexability gate: does ANY of this studio's games have a
// published review? Runs against the full company↔game↔review relationship (not
// the category-filtered display list), matching the sitemap's inclusion rule.
// Admin client — under RLS the anon client silently drops the nested review rows.
const { data: reviewedInStudio } = await (getSupabaseAdmin() as any)
  .from('game_companies')
  .select('company_id, games!inner(reviews!inner(id))')
  .eq('company_id', studio.id)
  .eq('games.reviews.status', 'published')
  .limit(1)
const hasReviewedGame = (reviewedInStudio?.length ?? 0) > 0

// This studio's games (any role) and, in parallel, the review count + score sum
// of the reviewed ones — aggregated in Postgres (hub_game_review_stats) rather
// than an `.in()` of every game id followed by every review row.
const [developedRaw, hubStatRows] = await Promise.all([
  // Paged: a prolific studio (EA, Konami, Nintendo) can hold several thousand
  // games, and PostgREST truncates a single response at 1000 rows regardless of
  // `.limit()`. Truncation here used to make recent-year counts look near-empty.
  fetchAll<{ role: string; games: any }>((from, to) => supabase
    .from('game_companies')
    .select(`
      role,
      games(id, title, slug, cover_img_url, date_released, igdb_id, igdb_category)
    `)
    .eq('company_id', studio.id)
    .order('game_id')
    .range(from, to)),
  // Server-only RPC (service role). Paged: a big hub can pass 1000 reviewed games.
  fetchAll<HubStatRow>((from, to) => (getSupabaseAdmin() as any)
    .rpc('hub_game_review_stats', { p_company_id: studio.id }).order('game_id').range(from, to)),
])

const allEntries = developedRaw

const developedGames = allEntries
  .filter((e: any) => e.role === 'developer')
  .map((e: any) => e.games)
  .filter(Boolean)
  .filter((g: any) => isAllowedGameCategory(g.igdb_category, g.title))
  .sort((a: any, b: any) =>
    new Date(b.date_released ?? 0).getTime() - new Date(a.date_released ?? 0).getTime()
  )

const publishedGames = allEntries
  .filter((e: any) => e.role === 'publisher')
  .map((e: any) => e.games)
  .filter(Boolean)
  .filter((g: any) => isAllowedGameCategory(g.igdb_category, g.title))
  .sort((a: any, b: any) =>
    new Date(b.date_released ?? 0).getTime() - new Date(a.date_released ?? 0).getTime()
  )

const publishedOnly = publishedGames.filter(
  (pg: any) => !developedGames.find((dg: any) => dg.id === pg.id)
)

const allGameIds = [...new Set(allEntries.map((e: any) => e.games?.id).filter(Boolean))]

const reviewStats = hubStatsFor(hubStatRows, allGameIds as string[])

function gameAvgScore(gameId: string): string | null {
  return avgScore(reviewStats, gameId)
}

function gameReviewCount(gameId: string): number {
  return reviewCount(reviewStats, gameId)
}

// review-weighted avg across all games
const overallTotals = pooled(reviewStats)
const overallAvg = overallTotals.count > 0
  ? (overallTotals.sum / overallTotals.count).toFixed(1)
  : null

const totalReviews = overallTotals.count
const totalGames = new Set([
  ...developedGames.map((g: any) => g.id),
  ...publishedOnly.map((g: any) => g.id)
]).size

// Per-game avg distribution for the score-hero card — one entry per bucket 1..10
const gameAvgScoresList: number[] = (allGameIds as string[])
  .filter((id: string) => reviewStats[id] && reviewStats[id].count > 0)
  .map((id: string) => reviewStats[id].sum / reviewStats[id].count)
const gameScoreDist: number[] = Array.from({ length: 10 }, (_, i) => {
  if (i === 9) return gameAvgScoresList.filter(avg => avg >= 9.5).length
  return gameAvgScoresList.filter(avg => avg >= i + 0.5 && avg < i + 1.5).length
})

// Avg score per release year for the trend sparkline
const yearAvgScoresMap: Record<number, number | null> = {}
{
  const yearTotals: Record<number, { sum: number; count: number }> = {}
  for (const g of [...developedGames, ...publishedOnly] as any[]) {
    if (!g.date_released) continue
    const year = new Date(g.date_released).getFullYear()
    const stat = reviewStats[g.id]
    if (!stat || stat.count === 0) continue
    yearTotals[year] = yearTotals[year] ?? { sum: 0, count: 0 }
    yearTotals[year].sum += stat.sum
    yearTotals[year].count += stat.count
  }
  for (const [y, { sum, count }] of Object.entries(yearTotals)) {
    yearAvgScoresMap[Number(y)] = count > 0 ? Math.round((sum / count) * 10) / 10 : null
  }
}

// fetch IGDB company details
let igdbData: any = null
if (studio.igdb_id) {
  const [igdbCompany] = await igdbFetch('companies',
    `fields name, description, country, start_date, logo.url, url;
     where id = ${studio.igdb_id};`)
  igdbData = igdbCompany ?? null
}


function scoreClass(score: number): string {
  if (score === 10) return 'perfect'
  if (score >= 9)   return 'great'
  if (score >= 8)   return 'teal'
  if (score >= 7)   return 'good'
  if (score >= 5)   return 'mid'
  if (score >= 3)   return 'orange'
  return 'low'
}

function releaseYear(dateStr: string | null): string | null {
  if (!dateStr) return null
  return String(new Date(dateStr).getFullYear())
}

function countryName(code: string | null): string | null {
  if (!code) return null
  try {
    return new Intl.DisplayNames(['en'], { type: 'region' }).of(code) ?? null
  } catch { return null }
}

const overallScoreClass = overallAvg ? scoreClass(parseFloat(overallAvg)) : null
const coverUrls = developedGames
  .slice(0, 12)
  .map((g: any) => igdbImage(g.cover_img_url))
  .filter(Boolean)
const coverUrlsJson = JSON.stringify(coverUrls)

// CDN cache — anonymous visitors share a cached response; auth users get a fresh render
setPageCacheHeaders(Astro.response.headers, isLoggedIn);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Runs synchronously before CSS is applied — prevents dark mode flash -->
  <script is:inline>
    (function() {
      var t = localStorage.getItem('theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', t);
      var m = document.getElementById('meta-theme-color');
      if (m) m.content = t === 'dark' ? '#0f0f0e' : '#f9f8f6';
    })();
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" id="meta-theme-color" content="#f9f8f6" />
  <title>{studio.name} — Checkpoint</title>
  <meta name="description" content={studio.description?.slice(0, 160) ?? `${studio.name} games and reviews on Checkpoint.`} />
  {!hasReviewedGame && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:title" content={`${studio.name} — Checkpoint`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />
  <style>
    :root[data-theme="light"] {
      --bg: #f5f4f2; --bg-card: #ffffff; --bg-hover: #f4f3f0;
      --border: #e8e6e1; --border-subtle: #f0ede8;
      --text-primary: #141412; --text-secondary: #6b6860; --text-tertiary: #a09d98;
      --tag-bg: #f0ede8; --tag-text: #6b6860;
      --shadow: 0 1px 3px rgba(0,0,0,0.06); --shadow-md: 0 4px 16px rgba(0,0,0,0.1);
      --score-great: #1a6b3c; --score-great-bg: #eaf5ee;
      --score-good: #1a4a6b;  --score-good-bg: #eaf0f5;
      --score-mid: #6b5a1a;   --score-mid-bg: #f5f0ea;
      --score-low: #6b1a1a;   --score-low-bg: #f5eaea;
      --game-accent: #4a3a8a; --game-accent-subtle: rgba(74,58,138,0.06);
      --hero-overlay: linear-gradient(to bottom, rgba(245,244,242,0.05) 0%, rgba(245,244,242,0.2) 40%, rgba(245,244,242,0.85) 75%, rgba(245,244,242,1) 100%);
      --hero-side: linear-gradient(to right, rgba(245,244,242,0.4) 0%, transparent 40%);
    }
    :root[data-theme="dark"] {
      --bg: #09090a; --bg-card: #131314; --bg-hover: #1c1c1e;
      --border: #222224; --border-subtle: #191919;
      --text-primary: #f0ede8; --text-secondary: #908d87; --text-tertiary: #484644;
      --tag-bg: #1c1c1e; --tag-text: #6a6866;
      --shadow: 0 1px 3px rgba(0,0,0,0.5); --shadow-md: 0 4px 16px rgba(0,0,0,0.7);
      --score-great: #4ade80; --score-great-bg: #112e1c;
      --score-teal: #2dd4bf;  --score-teal-bg: #082d2a;
      --score-good: #60a5fa;  --score-good-bg: #0e2240;
      --score-mid: #fbbf24;   --score-mid-bg: #271e00;
      --score-orange: #fb923c; --score-orange-bg: #2c160a;
      --score-low: #f87171;   --score-low-bg: #300e0e;
      --score-perfect: #ffffff; --score-perfect-bg: #22223a;
      --game-accent: #6050c8; --game-accent-subtle: rgba(96,80,200,0.09);
      --hero-overlay: linear-gradient(to bottom, rgba(9,9,10,0.05) 0%, rgba(9,9,10,0.2) 40%, rgba(9,9,10,0.8) 75%, rgba(9,9,10,1) 100%);
      --hero-side: linear-gradient(to right, rgba(9,9,10,0.5) 0%, transparent 40%);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text-primary); min-height: 100vh; -webkit-font-smoothing: antialiased; }
    a { color: inherit; text-decoration: none; }


    .jump-nav { position: sticky; top: 53px; z-index: 20; background: rgba(9,9,10,0.72); border-bottom: 1px solid var(--border); backdrop-filter: blur(16px); display: flex; overflow-x: auto; scrollbar-width: none; }
    .jump-nav::-webkit-scrollbar { display: none; }
    [data-theme="light"] .jump-nav { background: rgba(245,244,242,0.82); }
    .jump-link { font-size: 11px; font-weight: 500; color: var(--text-tertiary); padding: 10px 20px; letter-spacing: 0.08em; text-transform: uppercase; transition: color 0.15s, border-color 0.15s; border-bottom: 2px solid transparent; white-space: nowrap; flex-shrink: 0; }
    .jump-link:hover { color: var(--text-primary); }
    .jump-link.active { color: var(--text-primary); border-color: var(--game-accent); }

    .hero { position: relative; width: 100%; height: 400px; overflow: hidden; background: #04040a; }
    .hero-mosaic { position: absolute; inset: -40px; display: flex; flex-wrap: wrap; filter: blur(28px) saturate(1.6) brightness(0.5); transform: scale(1.15); }
    .hero-mosaic-tile { flex: 1 1 90px; min-width: 90px; min-height: 160px; background-size: cover; background-position: center; }
    .hero-side-fade { position: absolute; inset: 0; background: var(--hero-side); }
    .hero-overlay { position: absolute; inset: 0; background: var(--hero-overlay); }

    .page { max-width: 980px; margin: 0 auto; padding: 0 28px 100px; }

    .studio-header { display: flex; gap: 24px; align-items: flex-end; margin-top: -100px; margin-bottom: 28px; position: relative; z-index: 2; }
    .studio-logo-wrap { flex-shrink: 0; width: 120px; height: 120px; border-radius: 20px; background: var(--bg-card); border: 1px solid rgba(96,80,200,0.3); box-shadow: 0 12px 40px rgba(0,0,0,0.7), 0 0 30px rgba(96,80,200,0.15); display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .studio-logo { width: 100%; height: 100%; object-fit: contain; padding: 12px; }
    .studio-logo-placeholder { font-size: 52px; }
    .studio-info { flex: 1; min-width: 0; padding-bottom: 4px; }
    .studio-name { font-family: 'Cinzel', serif; font-size: 34px; line-height: 1.1; letter-spacing: 0.04em; margin-bottom: 8px; font-weight: 600; text-shadow: 0 2px 24px rgba(0,0,0,0.6); }
    .studio-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .studio-meta-item { font-size: 13px; color: var(--text-secondary); }
    .studio-meta-sep { color: var(--text-tertiary); font-size: 10px; }
    .studio-website { font-size: 13px; color: var(--game-accent); transition: opacity 0.15s; display: flex; align-items: center; gap: 4px; }
    .studio-website:hover { opacity: 0.7; }

    /* ── SCORE HERO ── */
    .score-hero { display: flex; align-items: flex-start; gap: 24px; padding: 20px 24px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; margin-bottom: 16px; position: relative; overflow: hidden; }
    .score-hero::before { content: ''; position: absolute; inset: 0; background: var(--game-accent-subtle); pointer-events: none; }
    .score-hero::after { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(to right, transparent, var(--game-accent), transparent); opacity: 0.6; }
    [data-theme="light"] .score-hero { background: #14121e; border-color: rgba(96,80,200,0.3); --score-perfect: #ffffff; --score-great: #4ade80; --score-teal: #2dd4bf; --score-good: #60a5fa; --score-mid: #fbbf24; --score-orange: #fb923c; --score-low: #f87171; }
    [data-theme="light"] .score-hero .score-label { color: rgba(255,255,255,0.42); }
    [data-theme="light"] .score-hero .review-count-label { color: rgba(255,255,255,0.55); }
    [data-theme="light"] .score-hero .score-divider { background: rgba(255,255,255,0.1); }
    [data-theme="light"] .score-hero .dist-label { color: rgba(255,255,255,0.32); }
    .avg-score-num { font-family: 'Century Schoolbook', 'New Century Schoolbook', Georgia, serif; font-size: 72px; line-height: 1; font-weight: 700; position: relative; z-index: 1; letter-spacing: -3px; padding-top: 8px; }
    .avg-score-num.score-perfect-color { color: #fff; text-shadow: 0 0 20px rgba(255,255,255,0.7), 0 0 40px rgba(255,255,255,0.3); }
    .avg-score-num.score-great-color { color: var(--score-great); }
    .avg-score-num.score-teal-color { color: var(--score-teal); }
    .avg-score-num.score-good-color { color: var(--score-good); }
    .avg-score-num.score-mid-color { color: var(--score-mid); }
    .avg-score-num.score-orange-color { color: var(--score-orange); }
    .avg-score-num.score-low-color { color: var(--score-low); }
    .avg-score-num.score-none-color { color: rgba(255,255,255,0.3); font-size: 48px; padding-top: 16px; }
    .score-divider { width: 1px; height: 56px; background: var(--border); flex-shrink: 0; margin-top: 8px; }
    .score-meta { flex: 1; position: relative; z-index: 1; min-width: 0; }
    .score-label { font-size: 11px; font-weight: 500; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 3px; }
    .review-count-label { font-size: 13px; color: var(--text-secondary); margin-bottom: 12px; }
    .score-dist { display: flex; gap: 4px; align-items: flex-end; height: 56px; margin-top: 8px; }
    .dist-bar-wrap { display: flex; flex-direction: column; align-items: center; gap: 3px; flex: 1; }
    .dist-bar { width: 100%; border-radius: 4px 4px 0 0; min-height: 4px; transition: opacity 0.15s, transform 0.15s; }
    .dist-bar-wrap:hover .dist-bar { opacity: 1 !important; transform: scaleY(1.06); transform-origin: bottom; }
    .dist-label { font-size: 9px; color: var(--text-tertiary); font-weight: 500; margin-top: 2px; }

    /* SCORE TREND — line chart of avg per release year */
    .trend-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; padding: 18px 22px 14px; margin-bottom: 16px; }
    .trend-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 10px; }
    .trend-title { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: var(--text-tertiary); }
    .trend-sub { font-size: 11px; color: var(--text-tertiary); }
    .trend-svg { display: block; width: 100%; height: 100px; overflow: visible; }
    .trend-grid { stroke: var(--border-subtle); stroke-width: 1; stroke-dasharray: 2 4; }
    .trend-area { fill: var(--game-accent); opacity: 0.08; }
    .trend-line { fill: none; stroke: var(--game-accent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; opacity: 0.75; }
    .trend-dot { stroke: var(--bg-card); stroke-width: 1.5; cursor: pointer; }
    .trend-dot-perfect { fill: #fff; }
    .trend-dot-great { fill: var(--score-great); }
    .trend-dot-teal { fill: var(--score-teal); }
    .trend-dot-good { fill: var(--score-good); }
    .trend-dot-mid { fill: var(--score-mid); }
    .trend-dot-orange { fill: var(--score-orange); }
    .trend-dot-low { fill: var(--score-low); }
    .trend-xaxis { position: relative; height: 14px; margin-top: 4px; }
    .trend-xlabel { position: absolute; top: 0; transform: translateX(-50%); font-size: 10px; color: var(--text-tertiary); white-space: nowrap; }

    .stats-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 28px; }
    .stat-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; padding: 22px 20px 18px; }
    .stat-card.score-card-great { border-bottom: 2px solid var(--score-great); }
    .stat-card.score-card-good  { border-bottom: 2px solid var(--score-good); }
    .stat-card.score-card-mid   { border-bottom: 2px solid var(--score-mid); }
    .stat-card.score-card-low   { border-bottom: 2px solid var(--score-low); }
    .stat-num { font-family: 'Century Schoolbook', 'New Century Schoolbook', Georgia, serif; font-size: 36px; font-weight: 400; line-height: 1; letter-spacing: -1px; margin-bottom: 6px; color: var(--text-primary); background: none; }
    .stat-num.great { color: var(--score-great); background: none; }
    .stat-num.good  { color: var(--score-good);  background: none; }
    .stat-num.mid   { color: var(--score-mid);   background: none; }
    .stat-num.low   { color: var(--score-low);   background: none; }
    .stat-label { font-size: 11px; font-weight: 500; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.08em; }
    .stat-sub { font-size: 11px; color: var(--text-tertiary); margin-top: 3px; }

    .about-grid { display: grid; grid-template-columns: 1fr 260px; gap: 24px; margin-bottom: 40px; }
    @media (max-width: 720px) { .about-grid { grid-template-columns: 1fr; } }
    .description { font-size: 14px; line-height: 1.8; color: var(--text-secondary); }
    .description.collapsed { display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
    .read-more-btn { background: none; border: none; font-family: inherit; font-size: 12px; color: var(--game-accent); cursor: pointer; padding: 8px 0 0; transition: opacity 0.15s; display: block; }
    .read-more-btn:hover { opacity: 0.7; }
    .details-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; padding: 4px 18px; height: fit-content; }
    .detail-row { display: flex; gap: 12px; padding: 11px 0; border-bottom: 1px solid var(--border-subtle); font-size: 12px; }
    .detail-row:last-child { border-bottom: none; }
    .detail-label { flex-shrink: 0; width: 80px; color: var(--text-tertiary); padding-top: 2px; text-transform: uppercase; letter-spacing: 0.06em; font-size: 10px; font-weight: 500; }
    .detail-value { color: var(--text-secondary); line-height: 1.5; }
    .detail-link { color: var(--game-accent); transition: opacity 0.15s; }
    .detail-link:hover { opacity: 0.7; }

    .section { margin-bottom: 48px; }
    .section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
    .section-title { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: var(--text-tertiary); }
    .section-count { font-size: 12px; color: var(--text-tertiary); }

    .games-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: 8px; }
    @media (max-width: 460px) { .games-grid { grid-template-columns: repeat(4, 1fr); gap: 6px; } }
    .game-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; transition: transform 0.15s, border-color 0.15s; display: block; position: relative; }
    .game-card:hover { transform: translateY(-3px); border-color: rgba(96,80,200,0.35); }
    .game-cover { aspect-ratio: 3/4; background: var(--tag-bg); overflow: hidden; position: relative; display: flex; align-items: center; justify-content: center; font-size: 24px; }
    .game-cover img { width: 100%; height: 100%; object-fit: cover; }
    .game-cover-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 24px; }
    .game-score-badge { position: absolute; bottom: 5px; right: 5px; min-width: 26px; height: 20px; padding: 0 5px; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; font-family: 'DM Serif Display', serif; backdrop-filter: blur(6px); }
    .badge-perfect { color: #09090a; background: #ffffff; border: 1px solid rgba(255,255,255,0.8); box-shadow: 0 0 10px rgba(255,255,255,0.9), 0 0 24px rgba(255,255,255,0.6), 0 0 48px rgba(255,255,255,0.3); }
    [data-theme="light"] .badge-perfect { color: #ffffff; background: #1a1a2e; border: 1px solid rgba(30,26,60,0.3); box-shadow: 0 0 8px rgba(30,26,60,0.4); }
    .badge-great   { color: var(--score-great);   background: var(--score-great-bg);   border: 1px solid rgba(74,222,128,0.3); }
    .badge-teal    { color: var(--score-teal);    background: var(--score-teal-bg);    border: 1px solid rgba(45,212,191,0.3); }
    .badge-good    { color: var(--score-good);    background: var(--score-good-bg);    border: 1px solid rgba(96,165,250,0.3); }
    .badge-mid     { color: var(--score-mid);     background: var(--score-mid-bg);     border: 1px solid rgba(251,191,36,0.3); }
    .badge-orange  { color: var(--score-orange);  background: var(--score-orange-bg);  border: 1px solid rgba(251,146,60,0.3); }
    .badge-low     { color: var(--score-low);     background: var(--score-low-bg);     border: 1px solid rgba(248,113,113,0.3); }
    .game-info { padding: 6px 8px 8px; }
    .game-title-text { font-size: 10px; font-weight: 500; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: var(--text-secondary); }
    .game-year { display: none; }
    .game-review-count { display: none; }

    .empty-state { padding: 40px 0; text-align: center; color: var(--text-tertiary); }
    .empty-title { font-family: 'DM Serif Display', serif; font-size: 18px; color: var(--text-secondary); margin-bottom: 6px; }

    @media (max-width: 600px) {
      .hero { height: 260px; }
      .score-hero { flex-direction: column; gap: 12px; padding: 16px 18px; }
      .score-divider { display: none; }
      .avg-score-num { font-size: 56px; padding-top: 0; }
      .studio-header { flex-direction: column; align-items: flex-start; margin-top: -60px; }
      .studio-name { font-size: 26px; }
      .hero { height: 220px; }
      .stats-row { gap: 8px; }
      .stat-num { font-size: 30px; }
      .games-grid { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 12px; }
      .jump-nav { display: none; }
    }
    /* ── Mobile bottom nav ── */
    @media (max-width: 768px) {
      body { padding-bottom: calc(56px + env(safe-area-inset-bottom, 0px)); }
    }
  </style>
</head>

<body>
  <DetailNav isLoggedIn={isLoggedIn} currentProfile={currentProfile} />

  <nav class="jump-nav">
    <a href="#overview" class="jump-link active">Overview</a>
    {developedGames.length > 0 && <a href="#developed" class="jump-link">Developed</a>}
    {publishedOnly.length > 0 && <a href="#published" class="jump-link">Published</a>}
  </nav>

  <div class="hero">
    <div class="hero-mosaic" id="heroMosaic"></div>
    <div class="hero-side-fade"></div>
    <div class="hero-overlay"></div>
  </div>

  <div class="page">

    <div class="studio-header" id="overview">
      <div class="studio-logo-wrap">
        {studio.logo_url
          ? <img class="studio-logo" src={igdbImage(studio.logo_url, 't_logo_med') ?? ''} alt={studio.name} />
          : <span class="studio-logo-placeholder">🎮</span>
        }
      </div>
      <div class="studio-info">
        <h1 class="studio-name">{studio.name}</h1>
        <div class="studio-meta">
          {studio.founded_year && <span class="studio-meta-item">Est. {studio.founded_year}</span>}
          {studio.founded_year && studio.country && <span class="studio-meta-sep">•</span>}
          {studio.country && <span class="studio-meta-item">{countryName(studio.country) ?? String(studio.country)}</span>}
          {studio.website_url && (
            <>
              <span class="studio-meta-sep">•</span>
              <a href={studio.website_url} target="_blank" rel="noopener" class="studio-website">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6"/><path d="M8 2c0 0-3 2-3 6s3 6 3 6M8 2c0 0 3 2 3 6s-3 6-3 6M2 8h12"/></svg>
                {studio.website_url.replace(/^https?:\/\//, '').replace(/\/$/, '')}
              </a>
            </>
          )}
        </div>
      </div>
    </div>

    <div class="score-hero">
      <div class={`avg-score-num ${overallScoreClass ? `score-${overallScoreClass}-color` : 'score-none-color'}`}>
        {overallAvg ?? '—'}
      </div>
      <div class="score-divider"></div>
      <div class="score-meta">
        <div class="score-label">Average game score</div>
        <div class="review-count-label">
          {totalReviews > 0
            ? `${totalReviews.toLocaleString()} ${totalReviews === 1 ? 'review' : 'reviews'} across ${totalGames.toLocaleString()} games`
            : `${totalGames.toLocaleString()} games · no reviews yet`}
        </div>
        {gameScoreDist.some((v: number) => v > 0) && (
          <div class="score-dist">
            {gameScoreDist.map((count: number, i: number) => {
              const score = i + 1
              const max = Math.max(...gameScoreDist, 1)
              // sqrt scaling so small buckets stay visible when one bucket dominates
              const h = count > 0 ? Math.max(25, Math.sqrt(count / max) * 100) : 6
              const tier = score === 10 ? 'perfect' : score >= 9 ? 'great' : score >= 8 ? 'teal' : score >= 7 ? 'good' : score >= 5 ? 'mid' : score >= 3 ? 'orange' : 'low'
              return (
                <div class="dist-bar-wrap" title={`${count} game${count === 1 ? '' : 's'} averaging ${score}`}>
                  <div class="dist-bar" style={`height:${h}%;background:var(--score-${tier});opacity:${count > 0 ? 0.85 : 0.15}`}></div>
                  <div class="dist-label">{score}</div>
                </div>
              )
            })}
          </div>
        )}
      </div>
    </div>

    {(() => {
      const points = Object.entries(yearAvgScoresMap)
        .map(([y, s]) => ({ year: Number(y), score: s as number | null }))
        .filter(p => p.score !== null)
        .sort((a, b) => a.year - b.year)
      if (points.length < 2) return null
      const minY = points[0].year, maxY = points[points.length - 1].year
      const w = 1000, h = 100, padX = 10, padT = 10, padB = 20
      const xAt = (y: number) => padX + ((y - minY) / Math.max(1, maxY - minY)) * (w - 2*padX)
      const yAt = (s: number) => padT + (1 - (s - 1) / 9) * (h - padT - padB)
      const linePath = points.map((p, i) => `${i === 0 ? 'M' : 'L'}${xAt(p.year).toFixed(1)},${yAt(p.score!).toFixed(1)}`).join(' ')
      const areaPath = `${linePath} L${xAt(maxY).toFixed(1)},${h - padB} L${xAt(minY).toFixed(1)},${h - padB} Z`
      const tier = (s: number) => s === 10 ? 'perfect' : s >= 9 ? 'great' : s >= 8 ? 'teal' : s >= 7 ? 'good' : s >= 5 ? 'mid' : s >= 3 ? 'orange' : 'low'
      const labelStep = Math.max(1, Math.floor(points.length / 6))
      const labelPoints = points.filter((_, i) => i % labelStep === 0 || i === points.length - 1)
      return (
        <div class="trend-card">
          <div class="trend-header">
            <span class="trend-title">Score trend</span>
            <span class="trend-sub">{minY} – {maxY}</span>
          </div>
          <svg class="trend-svg" viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="none">
            {[2, 5, 8].map(s => <line x1={padX} y1={yAt(s)} x2={w - padX} y2={yAt(s)} class="trend-grid" />)}
            <path d={areaPath} class="trend-area" />
            <path d={linePath} class="trend-line" />
            {points.map(p => (
              <circle cx={xAt(p.year)} cy={yAt(p.score!)} r="3.5" class={`trend-dot trend-dot-${tier(p.score!)}`}>
                <title>{p.year}: {p.score!.toFixed(1)}</title>
              </circle>
            ))}
          </svg>
          <div class="trend-xaxis">
            {labelPoints.map(p => (
              <span class="trend-xlabel" style={`left:${((p.year - minY) / Math.max(1, maxY - minY)) * 100}%`}>{p.year}</span>
            ))}
          </div>
        </div>
      )
    })()}


    {(studio.description || studio.founded_year || studio.country || studio.website_url) && (
      <div class="about-grid">
        <div>
          {studio.description && (
            <>
              <p class="description collapsed" id="desc">{studio.description}</p>
              <button class="read-more-btn" id="readMoreBtn" onclick="toggleDesc()">Read more →</button>
            </>
          )}
        </div>
        <div class="details-card">
          {studio.founded_year && (
            <div class="detail-row">
              <span class="detail-label">Founded</span>
              <span class="detail-value">{studio.founded_year}</span>
            </div>
          )}
          {studio.country && (
            <div class="detail-row">
              <span class="detail-label">Country</span>
              <span class="detail-value">{countryName(studio.country) ?? String(studio.country)}</span>
            </div>
          )}
          {studio.website_url && (
            <div class="detail-row">
              <span class="detail-label">Website</span>
              <a href={studio.website_url} target="_blank" rel="noopener" class="detail-value detail-link">
                {studio.website_url.replace(/^https?:\/\//, '').replace(/\/$/, '')}
              </a>
            </div>
          )}
          <div class="detail-row">
            <span class="detail-label">Games</span>
            <span class="detail-value">{totalGames} total</span>
          </div>
          {totalReviews > 0 && (
            <div class="detail-row">
              <span class="detail-label">Reviews</span>
              <span class="detail-value">{totalReviews.toLocaleString()} across all games</span>
            </div>
          )}
        </div>
      </div>
    )}

    {developedGames.length > 0 && (
      <div class="section" id="developed">
        <div class="section-header">
          <span class="section-title">Developed</span>
          <span class="section-count">{developedGames.length} {developedGames.length === 1 ? 'game' : 'games'}</span>
        </div>
        <div class="games-grid">
          {developedGames.map((g: any) => {
            const avg = gameAvgScore(g.id)
            const count = gameReviewCount(g.id)
            const sc = avg ? scoreClass(parseFloat(avg)) : null
            return (
              <a href={`/games/${g.slug}`} class="game-card">
                <div class="game-cover">
                  {g.cover_img_url
                    ? <img src={igdbImage(g.cover_img_url) ?? ''} alt={g.title} loading="lazy" />
                    : <div class="game-cover-placeholder">🎮</div>
                  }
                </div>
                {avg && <div class={`game-score-badge badge-${sc}`}>{avg}</div>}
                <div class="game-info">
                  <div class="game-title-text">{g.title}</div>
                  {releaseYear(g.date_released) && <div class="game-year">{releaseYear(g.date_released)}</div>}
                  {count > 0 && <div class="game-review-count">{count} {count === 1 ? 'review' : 'reviews'}</div>}
                </div>
              </a>
            )
          })}
        </div>
      </div>
    )}

    {publishedOnly.length > 0 && (
      <div class="section" id="published">
        <div class="section-header">
          <span class="section-title">Published</span>
          <span class="section-count">{publishedOnly.length} {publishedOnly.length === 1 ? 'game' : 'games'}</span>
        </div>
        <div class="games-grid">
          {publishedOnly.map((g: any) => {
            const avg = gameAvgScore(g.id)
            const count = gameReviewCount(g.id)
            const sc = avg ? scoreClass(parseFloat(avg)) : null
            return (
              <a href={`/games/${g.slug}`} class="game-card">
                <div class="game-cover">
                  {g.cover_img_url
                    ? <img src={igdbImage(g.cover_img_url) ?? ''} alt={g.title} loading="lazy" />
                    : <div class="game-cover-placeholder">🎮</div>
                  }
                </div>
                {avg && <div class={`game-score-badge badge-${sc}`}>{avg}</div>}
                <div class="game-info">
                  <div class="game-title-text">{g.title}</div>
                  {releaseYear(g.date_released) && <div class="game-year">{releaseYear(g.date_released)}</div>}
                  {count > 0 && <div class="game-review-count">{count} {count === 1 ? 'review' : 'reviews'}</div>}
                </div>
              </a>
            )
          })}
        </div>
      </div>
    )}

    {totalGames === 0 && (
      <div class="empty-state">
        <div class="empty-title">No games yet</div>
        <p>We don't have any games listed for {studio.name} yet.</p>
      </div>
    )}

  </div>

  <script define:vars={{ coverUrlsJson }}>
    const coverUrls = JSON.parse(coverUrlsJson)

    const mosaic = document.getElementById('heroMosaic')
    if (mosaic && coverUrls.length > 0) {
      const tiles = [...coverUrls, ...coverUrls, ...coverUrls].slice(0, 24)
      tiles.forEach(url => {
        const tile = document.createElement('div')
        tile.className = 'hero-mosaic-tile'
        tile.style.backgroundImage = `url(${url})`
        mosaic.appendChild(tile)
      })
    }

    function toggleDesc() {
      const desc = document.getElementById('desc')
      const btn = document.getElementById('readMoreBtn')
      if (!desc || !btn) return
      desc.classList.toggle('collapsed')
      btn.textContent = desc.classList.contains('collapsed') ? 'Read more →' : 'Read less ↑'
    }
    window.toggleDesc = toggleDesc

    const sections = ['overview', 'developed', 'published']
    const jumpLinks = document.querySelectorAll('.jump-link')
    window.addEventListener('scroll', () => {
      let current = 'overview'
      sections.forEach(id => {
        const el = document.getElementById(id)
        if (el && window.scrollY >= el.offsetTop - 120) current = id
      })
      jumpLinks.forEach(l => l.classList.toggle('active', l.getAttribute('href') === `#${current}`))
    })

    function toggleTheme() {
      const h = document.documentElement
      const n = h.getAttribute('data-theme') === 'light' ? 'dark' : 'light'
      h.setAttribute('data-theme', n)
      localStorage.setItem('theme', n)
      updateIcon(n)
    }
    function updateIcon(t) {
      const i = document.getElementById('themeIcon')
      if (!i) return
      i.innerHTML = t === 'dark'
        ? '<path d="M15 10.5A7 7 0 016.5 3a7 7 0 100 12 7 7 0 008.5-4.5z"/>'
        : '<circle cx="9" cy="9" r="3.5"/><path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.22 3.22l1.42 1.42M13.36 13.36l1.42 1.42M13.36 4.64l1.42-1.42M3.22 14.78l1.42-1.42"/>'
    }
    window.toggleTheme = function(t) {
      toggleTheme(t);
      var m = document.getElementById('meta-theme-color');
      if (m) m.content = t === 'dark' ? '#0f0f0e' : '#f9f8f6';
    }

    const saved = document.documentElement.getAttribute('data-theme') || 'light'
    updateIcon(saved)
  </script>

</body>
</html>
