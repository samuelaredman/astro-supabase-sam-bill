---
export const prerender = false;
import { getSupabase, getSupabaseAdmin } from '../../utils/database'
import { igdbFetch } from '../../utils/igdb'
import { igdbImage, timeAgo, formatScore } from '../../utils/format'
import { isAllowedGameCategory } from '../../utils/games'
import DetailNav from '../../components/DetailNav.astro'
import { setPageCacheHeaders } from '../../utils/cache';
import { getPageUser } from '../../utils/pageAuth';
import { hubStatsFor, avgScore, reviewCount, pooled, type HubStatRow } from '../../utils/hubStats'
import { fetchAll } from '../../utils/fetchAll'
import { countryName } from '../../utils/country'

const supabase = getSupabase()
const _studioUser = await getPageUser(Astro);
const isLoggedIn = !!_studioUser;

let currentProfile: { id: string; username: string; avatar_url: string | null } | null = null;
if (_studioUser) {
  const { data: cp } = await (supabase as any)
    .from('profiles').select('id, username, avatar_url').eq('auth_user_id', _studioUser.id).single();
  currentProfile = cp ?? null;
}

const { slug = '' } = Astro.params;

const { data: studio } = await supabase
  .from('developers')
  .select(`
    id, name, slug, country, description,
    website_url, logo_url, founded_year, igdb_id, canonical_developer_id
  `)
  .eq('slug', slug)
  .single()

if (!studio) return Astro.redirect('/404')

// A duplicate IGDB entry merged into its main studio (merge_developer()) owns no
// games of its own. Permanent-redirect so old links and Google land on the main page.
if (studio.canonical_developer_id) {
  const { data: canon } = await supabase
    .from('developers').select('slug').eq('id', studio.canonical_developer_id).maybeSingle()
  if (canon?.slug) return Astro.redirect(`/studios/${canon.slug}`, 301)
}

// Authoritative indexability gate: does ANY of this studio's games have a
// published review? Runs against the full company↔game↔review relationship (not
// the category-filtered display list), matching the sitemap's inclusion rule.
// Admin client — under RLS the anon client silently drops the nested review rows.
const { data: reviewedInStudio } = await (getSupabaseAdmin() as any)
  .from('game_companies')
  .select('company_id, games!inner(reviews!inner(id))')
  .eq('company_id', studio.id)
  .eq('games.reviews.status', 'published')
  .limit(1)
const hasReviewedGame = (reviewedInStudio?.length ?? 0) > 0

// This studio's games (any role) and, in parallel, the review count + score sum
// of the reviewed ones — aggregated in Postgres (hub_game_review_stats) rather
// than an `.in()` of every game id followed by every review row.
const [developedRaw, hubStatRows, aliasRows] = await Promise.all([
  // Paged: a prolific studio (EA, Konami, Nintendo) can hold several thousand
  // games, and PostgREST truncates a single response at 1000 rows regardless of
  // `.limit()`. Truncation here used to make recent-year counts look near-empty.
  fetchAll<{ role: string; games: any }>((from, to) => supabase
    .from('game_companies')
    .select(`
      role,
      games(id, title, slug, cover_img_url, date_released, igdb_id, igdb_category, canonical_game_id)
    `)
    .eq('company_id', studio.id)
    .order('game_id')
    .range(from, to)),
  // Server-only RPC (service role). Paged: a big hub can pass 1000 reviewed games.
  fetchAll<HubStatRow>((from, to) => (getSupabaseAdmin() as any)
    .rpc('hub_game_review_stats', { p_company_id: studio.id }).order('game_id').range(from, to)),
  // Names of duplicates merged into this studio, shown as "Also known as".
  supabase.from('developers').select('name').eq('canonical_developer_id', studio.id).order('name'),
])

const alsoKnownAs = (aliasRows.data ?? []).map((r) => r.name).filter((n) => n !== studio.name)

const allEntries = developedRaw

const developedGames = allEntries
  .filter((e: any) => e.role === 'developer')
  .map((e: any) => e.games)
  .filter(Boolean)
  .filter((g: any) => g.canonical_game_id == null && isAllowedGameCategory(g.igdb_category, g.title))
  .sort((a: any, b: any) =>
    new Date(b.date_released ?? 0).getTime() - new Date(a.date_released ?? 0).getTime()
  )

const publishedGames = allEntries
  .filter((e: any) => e.role === 'publisher')
  .map((e: any) => e.games)
  .filter(Boolean)
  .filter((g: any) => g.canonical_game_id == null && isAllowedGameCategory(g.igdb_category, g.title))
  .sort((a: any, b: any) =>
    new Date(b.date_released ?? 0).getTime() - new Date(a.date_released ?? 0).getTime()
  )

const publishedOnly = publishedGames.filter(
  (pg: any) => !developedGames.find((dg: any) => dg.id === pg.id)
)

const allGameIds = [...new Set(allEntries.map((e: any) => e.games?.id).filter(Boolean))]

const reviewStats = hubStatsFor(hubStatRows, allGameIds as string[])

function gameAvgScore(gameId: string): string | null {
  return avgScore(reviewStats, gameId)
}

function gameReviewCount(gameId: string): number {
  return reviewCount(reviewStats, gameId)
}

// review-weighted avg across all games
const overallTotals = pooled(reviewStats)
const overallAvg = overallTotals.count > 0
  ? (overallTotals.sum / overallTotals.count).toFixed(1)
  : null

const totalReviews = overallTotals.count
const totalGames = new Set([
  ...developedGames.map((g: any) => g.id),
  ...publishedOnly.map((g: any) => g.id)
]).size

// Recent reviews of this studio's games, so the page leads somewhere. Only the
// reviewed games the page lists, most-reviewed first, capped so the `.in()`
// stays well inside PostgREST's URL limit.
const reviewedGameIds = [...developedGames, ...publishedOnly]
  .filter((g: any) => gameReviewCount(g.id) > 0)
  .sort((a: any, b: any) => gameReviewCount(b.id) - gameReviewCount(a.id))
  .slice(0, 150)
  .map((g: any) => g.id as string)

const REVIEWS_SHOWN = 6
let recentReviews: any[] = []
if (reviewedGameIds.length > 0) {
  const { data: recentReviewRows, error: recentReviewsError } = await supabase
    .from('reviews')
    .select('id, score, title, body, contains_spoilers, published_at, created_at, games(title, slug, cover_img_url), profiles(username, avatar_url)')
    .in('game_id', reviewedGameIds)
    .eq('status', 'published')
    .order('published_at', { ascending: false, nullsFirst: false })
    .limit(30)
  if (recentReviewsError) console.error('[studios/slug] recent reviews error:', JSON.stringify(recentReviewsError))
  recentReviews = recentReviewRows ?? []
}

// fetch IGDB company details
let igdbData: any = null
if (studio.igdb_id) {
  const [igdbCompany] = await igdbFetch('companies',
    `fields name, description, country, start_date, logo.url, url;
     where id = ${studio.igdb_id};`)
  igdbData = igdbCompany ?? null
}


function scoreClass(score: number): string {
  if (score === 10) return 'perfect'
  if (score >= 9)   return 'great'
  if (score >= 8)   return 'teal'
  if (score >= 7)   return 'good'
  if (score >= 5)   return 'mid'
  if (score >= 3)   return 'orange'
  return 'low'
}

function releaseYear(dateStr: string | null): string | null {
  if (!dateStr) return null
  return String(new Date(dateStr).getFullYear())
}

const studioCountry = countryName(studio.country)

// IGDB fills website_url with its own company page (every studio, as of
// 2026-10-31), not the studio's site. Show only a real website.
const studioWebsite = studio.website_url && !/(^|[./])igdb\.com\b/i.test(studio.website_url) ? studio.website_url : null

// Search snippet. Studio-name searches ("bloober team", "bloober team country",
// "what is cognosphere") want facts, so the title and description lead with the
// game count, origin and community scores instead of IGDB's blurb, which
// Wikipedia already shows.
const reviewedGames = [...developedGames, ...publishedOnly]
  .map((g: any) => ({ title: g.title as string, avg: gameAvgScore(g.id), count: gameReviewCount(g.id) }))
  .filter((g) => g.avg != null)
  .sort((a, b) => parseFloat(b.avg!) - parseFloat(a.avg!) || b.count - a.count)
const topGame = reviewedGames[0] ?? null

const seoTitle = totalGames > 0
  ? `${studio.name}: ${totalGames} Game${totalGames === 1 ? '' : 's'} & Player Scores | Chekpoint`
  : `${studio.name} | Chekpoint`

function clampDescription(text: string, max = 160): string {
  if (text.length <= max) return text
  const cut = text.slice(0, max - 1)
  return cut.slice(0, cut.lastIndexOf(' ')).replace(/[\s,.;:]+$/, '') + '…'
}

const seoDescription = clampDescription([
  studioCountry || studio.founded_year
    ? `Game company${studioCountry ? ` from ${/^(United|Netherlands|Philippines|Cayman)/.test(studioCountry) ? 'the ' : ''}${studioCountry}` : ''}${studio.founded_year ? `, founded ${studio.founded_year}` : ''}.`
    : null,
  totalGames > 0 ? `${totalGames} game${totalGames === 1 ? '' : 's'} on Chekpoint.` : null,
  topGame ? `Top rated: ${topGame.title} (${topGame.avg}/10).` : null,
  overallAvg ? `Community average ${overallAvg} from ${totalReviews} review${totalReviews === 1 ? '' : 's'}.` : null,
  studio.description,
].filter(Boolean).join(' '))

const canonicalUrl = new URL(`/studios/${studio.slug}`, Astro.site ?? Astro.url.origin).toString()

const overallScoreClass = overallAvg ? scoreClass(parseFloat(overallAvg)) : null

// Game sections, laid out like the genre page: Top Rated and Most Reviewed rows,
// then Developed / Published by release year. Every card is rendered here (the
// script only pages them) so all of the studio's game links stay in the HTML.
const PAGE_SIZE = 5
const SCORE_BORDER: Record<string, string> = {
  perfect: '#ffffff', great: '#4ade80', teal: '#2dd4bf', good: '#60a5fa',
  mid: '#fbbf24', orange: '#fb923c', low: '#f87171',
}
type GameCard = { slug: string; title: string; cover: string | null; avg: string | null; sc: string | null; count: number; year: string | null }
type GameGroup = { key: string; label: string; cards: GameCard[]; dot: string }
type GameSection = { id: string; title: string; count: number; byYear: boolean; ranked: boolean; groups: GameGroup[] }

function toCard(g: any): GameCard {
  const avg = gameAvgScore(g.id)
  return {
    slug: g.slug, title: g.title, cover: igdbImage(g.cover_img_url),
    avg, sc: avg ? scoreClass(parseFloat(avg)) : null,
    count: gameReviewCount(g.id), year: releaseYear(g.date_released),
  }
}

const byScore = (a: any, b: any) =>
  parseFloat(gameAvgScore(b.id) ?? '-1') - parseFloat(gameAvgScore(a.id) ?? '-1')
const byReviews = (a: any, b: any) => gameReviewCount(b.id) - gameReviewCount(a.id)
const listedGames = [...developedGames, ...publishedOnly]

const topRated = listedGames
  .filter((g: any) => gameReviewCount(g.id) >= 3)
  .sort((a: any, b: any) => byScore(a, b) || byReviews(a, b))
  .slice(0, 25)
const mostReviewed = listedGames
  .filter((g: any) => gameReviewCount(g.id) > 0)
  .sort((a: any, b: any) => byReviews(a, b) || byScore(a, b))
  .slice(0, 25)

// Same pill colours as the genre page's year strip.
function yearDot(avg: number | null): string {
  if (avg == null) return '#71717a'
  return avg >= 8 ? '#22c55e' : avg >= 6 ? '#3b82f6' : avg >= 4 ? '#f59e0b' : '#ef4444'
}

// Newest year first; games with no release date last. Every game is kept —
// these sections replace the full Developed / Published grids.
function groupByYear(games: any[]): GameGroup[] {
  const groups = new Map<string, any[]>()
  for (const g of games) {
    const key = releaseYear(g.date_released) ?? 'none'
    groups.set(key, [...(groups.get(key) ?? []), g])
  }
  return [...groups.entries()]
    .sort(([a], [b]) => (a === 'none' ? 1 : b === 'none' ? -1 : Number(b) - Number(a)))
    .map(([key, list]) => {
      const totals = pooled(reviewStats, list.map((g: any) => g.id))
      return {
        key,
        label: key === 'none' ? 'No date' : key,
        cards: list.sort((a: any, b: any) => byScore(a, b) || a.title.localeCompare(b.title)).map(toCard),
        dot: yearDot(totals.count > 0 ? totals.sum / totals.count : null),
      }
    })
}

const gameSections: GameSection[] = ([
  { id: 'top-rated', title: 'Top Rated', count: topRated.length, byYear: false, ranked: true,
    groups: [{ key: 'all', label: '', cards: topRated.map(toCard), dot: '' }] },
  { id: 'most-reviewed', title: 'Most Reviewed', count: mostReviewed.length, byYear: false, ranked: false,
    groups: [{ key: 'all', label: '', cards: mostReviewed.map(toCard), dot: '' }] },
  { id: 'developed', title: 'Developed', count: developedGames.length, byYear: true, ranked: false,
    groups: groupByYear(developedGames) },
  { id: 'published', title: 'Published', count: publishedOnly.length, byYear: true, ranked: false,
    groups: groupByYear(publishedOnly) },
] as GameSection[]).filter((sec) => sec.count > 0)
const coverUrls = developedGames
  .slice(0, 12)
  .map((g: any) => igdbImage(g.cover_img_url))
  .filter(Boolean)
const coverUrlsJson = JSON.stringify(coverUrls)

// CDN cache — anonymous visitors share a cached response; auth users get a fresh render
setPageCacheHeaders(Astro.response.headers, isLoggedIn);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Runs synchronously before CSS is applied — prevents dark mode flash -->
  <script is:inline>
    (function() {
      var t = localStorage.getItem('theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', t);
      var m = document.getElementById('meta-theme-color');
      if (m) m.content = t === 'dark' ? '#0f0f0e' : '#f9f8f6';
    })();
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" id="meta-theme-color" content="#f9f8f6" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=2" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png?v=2" />
  <link rel="apple-touch-icon" href="/favicon.svg" />
  <title>{seoTitle}</title>
  <meta name="description" content={seoDescription} />
  {!hasReviewedGame && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:site_name" content="Chekpoint" />
  <meta property="og:title" content={seoTitle} />
  <meta property="og:description" content={seoDescription} />
  <meta property="og:url" content={canonicalUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />
  <style>
    :root[data-theme="light"] {
      --bg: #f5f4f2; --bg-card: #ffffff; --bg-hover: #f4f3f0;
      --border: #e8e6e1; --border-subtle: #f0ede8;
      --text-primary: #141412; --text-secondary: #6b6860; --text-tertiary: #a09d98;
      --tag-bg: #f0ede8; --tag-text: #6b6860;
      --shadow: 0 1px 3px rgba(0,0,0,0.06); --shadow-md: 0 4px 16px rgba(0,0,0,0.1);
      --score-great: #1a6b3c; --score-great-bg: #eaf5ee;
      --score-good: #1a4a6b;  --score-good-bg: #eaf0f5;
      --score-mid: #6b5a1a;   --score-mid-bg: #f5f0ea;
      --score-low: #6b1a1a;   --score-low-bg: #f5eaea;
      --game-accent: #4a3a8a; --game-accent-subtle: rgba(74,58,138,0.06);
      --hero-overlay: linear-gradient(to bottom, rgba(245,244,242,0.0) 0%, rgba(245,244,242,0.5) 60%, rgba(245,244,242,1) 100%);
    }
    :root[data-theme="dark"] {
      --bg: #09090a; --bg-card: #131314; --bg-hover: #1c1c1e;
      --border: #222224; --border-subtle: #191919;
      --text-primary: #f0ede8; --text-secondary: #908d87; --text-tertiary: #484644;
      --tag-bg: #1c1c1e; --tag-text: #6a6866;
      --shadow: 0 1px 3px rgba(0,0,0,0.5); --shadow-md: 0 4px 16px rgba(0,0,0,0.7);
      --score-great: #4ade80; --score-great-bg: #112e1c;
      --score-teal: #2dd4bf;  --score-teal-bg: #082d2a;
      --score-good: #60a5fa;  --score-good-bg: #0e2240;
      --score-mid: #fbbf24;   --score-mid-bg: #271e00;
      --score-orange: #fb923c; --score-orange-bg: #2c160a;
      --score-low: #f87171;   --score-low-bg: #300e0e;
      --score-perfect: #ffffff; --score-perfect-bg: #22223a;
      --game-accent: #6050c8; --game-accent-subtle: rgba(96,80,200,0.09);
      --hero-overlay: linear-gradient(to bottom, rgba(9,9,10,0.0) 0%, rgba(9,9,10,0.55) 60%, rgba(9,9,10,1) 100%);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text-primary); min-height: 100vh; -webkit-font-smoothing: antialiased; }
    a { color: inherit; text-decoration: none; }


    .jump-nav { position: sticky; top: 53px; z-index: 20; background: rgba(9,9,10,0.72); border-bottom: 1px solid var(--border); backdrop-filter: blur(16px); display: flex; overflow-x: auto; scrollbar-width: none; }
    .jump-nav::-webkit-scrollbar { display: none; }
    [data-theme="light"] .jump-nav { background: rgba(245,244,242,0.82); }
    .jump-link { font-size: 11px; font-weight: 500; color: var(--text-tertiary); padding: 10px 20px; letter-spacing: 0.08em; text-transform: uppercase; transition: color 0.15s, border-color 0.15s; border-bottom: 2px solid transparent; white-space: nowrap; flex-shrink: 0; }
    .jump-link:hover { color: var(--text-primary); }
    .jump-link.active { color: var(--text-primary); border-color: var(--game-accent); }

    .hero { position: relative; width: 100%; height: 320px; overflow: hidden; background: #04040a; }
    .hero-mosaic { position: absolute; inset: -20px; display: flex; flex-wrap: wrap; filter: blur(18px) saturate(1.5) brightness(0.38); transform: scale(1.08); }
    .hero-mosaic-tile { flex: 1 1 90px; min-width: 90px; min-height: 160px; background-size: cover; background-position: center; }
    .hero-overlay { position: absolute; inset: 0; background: var(--hero-overlay); }

    .page { max-width: 900px; margin: 0 auto; padding: 0 28px 100px; }

    .studio-header { display: flex; gap: 28px; align-items: flex-end; margin-top: -80px; margin-bottom: 32px; position: relative; z-index: 2; }
    .studio-logo-wrap { flex-shrink: 0; width: 120px; height: 120px; border-radius: 20px; background: var(--bg-card); border: 1px solid rgba(96,80,200,0.3); box-shadow: 0 12px 40px rgba(0,0,0,0.7), 0 0 30px rgba(96,80,200,0.15); display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .studio-logo { width: 100%; height: 100%; object-fit: contain; padding: 12px; }
    .studio-logo-placeholder { font-size: 52px; }
    .studio-info { flex: 1; min-width: 0; padding-bottom: 4px; }
    .studio-name { font-family: 'Cinzel', serif; font-size: 34px; line-height: 1.1; letter-spacing: 0.04em; margin-bottom: 8px; font-weight: 600; text-shadow: 0 2px 24px rgba(0,0,0,0.6); }
    .studio-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .studio-meta-item { font-size: 13px; color: var(--text-secondary); }
    .studio-meta-sep { color: var(--text-tertiary); font-size: 10px; }
    .studio-website { font-size: 13px; color: var(--game-accent); transition: opacity 0.15s; display: flex; align-items: center; gap: 4px; }
    .studio-website:hover { opacity: 0.7; }

    .stats-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 28px; }
    .stat-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; padding: 22px 20px 18px; }
    .stat-card.score-card-great { border-bottom: 2px solid var(--score-great); }
    .stat-card.score-card-good  { border-bottom: 2px solid var(--score-good); }
    .stat-card.score-card-mid   { border-bottom: 2px solid var(--score-mid); }
    .stat-card.score-card-low   { border-bottom: 2px solid var(--score-low); }
    .stat-num { font-family: 'Century Schoolbook', 'New Century Schoolbook', Georgia, serif; font-size: 36px; font-weight: 400; line-height: 1; letter-spacing: -1px; margin-bottom: 6px; color: var(--text-primary); background: none; }
    .stat-num.great { color: var(--score-great); background: none; }
    .stat-num.good  { color: var(--score-good);  background: none; }
    .stat-num.mid   { color: var(--score-mid);   background: none; }
    .stat-num.low   { color: var(--score-low);   background: none; }
    .stat-label { font-size: 11px; font-weight: 500; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.08em; }
    .stat-sub { font-size: 11px; color: var(--text-tertiary); margin-top: 3px; }

    .about-grid { display: grid; grid-template-columns: 1fr 260px; gap: 24px; margin-bottom: 40px; }
    @media (max-width: 720px) { .about-grid { grid-template-columns: 1fr; } }
    .description { font-size: 14px; line-height: 1.8; color: var(--text-secondary); }
    .description.collapsed { display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
    .read-more-btn { background: none; border: none; font-family: inherit; font-size: 12px; color: var(--game-accent); cursor: pointer; padding: 8px 0 0; transition: opacity 0.15s; display: block; }
    .read-more-btn:hover { opacity: 0.7; }
    .details-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; padding: 4px 18px; height: fit-content; }
    .detail-row { display: flex; gap: 12px; padding: 11px 0; border-bottom: 1px solid var(--border-subtle); font-size: 12px; }
    .detail-row:last-child { border-bottom: none; }
    .detail-label { flex-shrink: 0; width: 80px; color: var(--text-tertiary); padding-top: 2px; text-transform: uppercase; letter-spacing: 0.06em; font-size: 10px; font-weight: 500; }
    .detail-value { color: var(--text-secondary); line-height: 1.5; min-width: 0; overflow-wrap: anywhere; }
    .detail-link { color: var(--game-accent); transition: opacity 0.15s; }
    .detail-link:hover { opacity: 0.7; }

    .section { margin-bottom: 48px; }
    .section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
    .section-title { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: var(--text-tertiary); }
    .section-count { font-size: 12px; color: var(--text-tertiary); }

    .game-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }
    @media (max-width: 700px) { .game-row { grid-template-columns: repeat(3, 1fr); gap: 12px; } }
    .game-card[hidden], .year-panel[hidden] { display: none; }
    .rank-badge { position: absolute; top: 6px; left: 6px; background: rgba(0,0,0,0.6); color: #fff; font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px; line-height: 1.4; backdrop-filter: blur(4px); }
    .row-nav { display: flex; align-items: center; gap: 8px; margin-top: 14px; }
    .row-nav-info { font-size: 12px; color: var(--text-tertiary); }
    .row-arrow, .strip-arrow { background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.15s; color: var(--text-secondary); flex-shrink: 0; }
    .strip-arrow { width: 28px; height: 28px; }
    .row-arrow:hover, .strip-arrow:hover { border-color: var(--game-accent); color: var(--game-accent); }
    .row-arrow:disabled, .strip-arrow:disabled { opacity: 0.25; cursor: default; pointer-events: none; }
    .pill-strip-wrap { display: flex; align-items: center; gap: 6px; margin-bottom: 14px; }
    .year-pill-strip { position: relative; display: flex; gap: 6px; overflow-x: auto; padding-bottom: 4px; scroll-snap-type: x mandatory; scrollbar-width: none; flex: 1; min-width: 0; }
    .year-pill-strip::-webkit-scrollbar { display: none; }
    .year-pill { display: inline-flex; align-items: center; gap: 5px; padding: 5px 10px; border-radius: 20px; border: 1px solid var(--border); background: var(--bg-card); cursor: pointer; white-space: nowrap; scroll-snap-align: start; transition: border-color 0.15s, background 0.15s; font-family: inherit; flex-shrink: 0; }
    .year-pill:hover { border-color: rgba(96,80,200,0.4); }
    .year-pill.active { border-color: var(--game-accent); background: rgba(96,80,200,0.08); }
    .year-pill-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
    .year-pill-label { font-size: 12px; font-weight: 600; color: var(--text-primary); }
    .year-pill-count { font-size: 11px; color: var(--text-tertiary); }
    .year-panel-header { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; padding-bottom: 10px; border-bottom: 1px solid var(--border); }
    .year-panel-label { font-family: 'DM Serif Display', serif; font-size: 22px; letter-spacing: -0.3px; }
    .year-panel-count { font-size: 12px; color: var(--text-tertiary); }
    .game-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s; display: block; position: relative; }
    .game-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: rgba(96,80,200,0.3); }
    .game-cover { aspect-ratio: 3/4; background: var(--tag-bg); overflow: hidden; position: relative; }
    .game-cover img { width: 100%; height: 100%; object-fit: cover; }
    .game-cover-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 36px; }
    .game-score-badge { position: absolute; top: 8px; right: 8px; width: 30px; height: 30px; border-radius: 7px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; font-family: 'Century Schoolbook', Georgia, serif; }
    .badge-perfect { color: #09090a; background: #ffffff; border: 1px solid rgba(255,255,255,0.8); box-shadow: 0 0 10px rgba(255,255,255,0.9), 0 0 24px rgba(255,255,255,0.6), 0 0 48px rgba(255,255,255,0.3); }
    [data-theme="light"] .badge-perfect { color: #ffffff; background: #1a1a2e; border: 1px solid rgba(30,26,60,0.3); box-shadow: 0 0 8px rgba(30,26,60,0.4); }
    .badge-great   { color: var(--score-great);   background: var(--score-great-bg);   border: 1px solid rgba(74,222,128,0.3); }
    .badge-teal    { color: var(--score-teal);    background: var(--score-teal-bg);    border: 1px solid rgba(45,212,191,0.3); }
    .badge-good    { color: var(--score-good);    background: var(--score-good-bg);    border: 1px solid rgba(96,165,250,0.3); }
    .badge-mid     { color: var(--score-mid);     background: var(--score-mid-bg);     border: 1px solid rgba(251,191,36,0.3); }
    .badge-orange  { color: var(--score-orange);  background: var(--score-orange-bg);  border: 1px solid rgba(251,146,60,0.3); }
    .badge-low     { color: var(--score-low);     background: var(--score-low-bg);     border: 1px solid rgba(248,113,113,0.3); }
    .game-info { padding: 10px 12px 12px; }
    .game-title-text { font-size: 12px; font-weight: 500; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 3px; }
    .game-year { font-size: 11px; color: var(--text-tertiary); }
    .game-review-count { font-size: 10px; color: var(--text-tertiary); margin-top: 2px; }

    a.stat-card { display: block; transition: border-color 0.15s; }
    a.stat-card:hover { border-color: rgba(96,80,200,0.4); }
    .stat-link { font-size: 11px; color: var(--game-accent); margin-top: 3px; }

    .review-list { display: flex; flex-direction: column; gap: 12px; }
    .review-item { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; display: flex; gap: 14px; transition: border-color 0.15s; }
    .review-item:hover { border-color: rgba(96,80,200,0.3); }
    .review-item[hidden] { display: none; }
    .review-cover { flex-shrink: 0; width: 46px; height: 61px; border-radius: 6px; overflow: hidden; background: var(--tag-bg); display: flex; align-items: center; justify-content: center; font-size: 18px; }
    .review-cover img { width: 100%; height: 100%; object-fit: cover; }
    .review-main { flex: 1; min-width: 0; }
    .review-head { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 6px; }
    .review-head-text { flex: 1; min-width: 0; }
    .review-game { font-size: 13px; font-weight: 500; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .review-game:hover { color: var(--text-secondary); }
    .review-byline { font-size: 11px; color: var(--text-tertiary); display: flex; align-items: center; gap: 6px; margin-top: 3px; }
    .review-avatar { width: 16px; height: 16px; border-radius: 50%; object-fit: cover; }
    .review-byline a:hover { color: var(--text-secondary); }
    .review-score { position: static; flex-shrink: 0; width: 34px; height: 34px; font-size: 13px; }
    .review-title { font-family: 'DM Serif Display', serif; font-size: 16px; line-height: 1.3; margin-bottom: 4px; }
    .review-body { font-size: 13px; line-height: 1.65; color: var(--text-secondary); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; }
    .review-spoiler { font-size: 12px; color: var(--text-tertiary); font-style: italic; }
    .review-read { display: inline-block; font-size: 12px; color: var(--game-accent); margin-top: 8px; font-weight: 500; }
    .review-read:hover { opacity: 0.7; }
    .show-more-btn { display: block; margin: 14px auto 0; background: var(--tag-bg); color: var(--text-secondary); border: 1px solid var(--border); border-radius: 20px; padding: 7px 18px; font-family: inherit; font-size: 12px; font-weight: 500; cursor: pointer; transition: border-color 0.15s; }
    .show-more-btn:hover { border-color: rgba(96,80,200,0.4); }

    .empty-state { padding: 40px 0; text-align: center; color: var(--text-tertiary); }
    .empty-title { font-family: 'DM Serif Display', serif; font-size: 18px; color: var(--text-secondary); margin-bottom: 6px; }

    @media (max-width: 600px) {
      .studio-header { flex-direction: column; align-items: flex-start; margin-top: -50px; }
      .studio-name { font-size: 26px; }
      .hero { height: 220px; }
      .stats-row { gap: 8px; }
      .stat-num { font-size: 30px; }
      .jump-nav { display: none; }
    }
    /* ── Mobile bottom nav ── */
    @media (max-width: 768px) {
      body { padding-bottom: calc(56px + env(safe-area-inset-bottom, 0px)); }
    }
  </style>
</head>

<body>
  <DetailNav isLoggedIn={isLoggedIn} currentProfile={currentProfile} />

  <nav class="jump-nav">
    <a href="#overview" class="jump-link active">Overview</a>
    {recentReviews.length > 0 && <a href="#reviews" class="jump-link">Reviews</a>}
    {gameSections.map((sec) => <a href={`#${sec.id}`} class="jump-link">{sec.title}</a>)}
  </nav>

  <div class="hero">
    <div class="hero-mosaic" id="heroMosaic"></div>
    <div class="hero-overlay"></div>
  </div>

  <div class="page">

    <div class="studio-header" id="overview">
      <div class="studio-logo-wrap">
        {studio.logo_url
          ? <img class="studio-logo" src={igdbImage(studio.logo_url, 't_logo_med') ?? ''} alt={studio.name} />
          : <span class="studio-logo-placeholder">🎮</span>
        }
      </div>
      <div class="studio-info">
        <h1 class="studio-name">{studio.name}</h1>
        <div class="studio-meta">
          {studio.founded_year && <span class="studio-meta-item">Est. {studio.founded_year}</span>}
          {studio.founded_year && studioCountry && <span class="studio-meta-sep">•</span>}
          {studioCountry && <span class="studio-meta-item">{studioCountry}</span>}
          {studioWebsite && (
            <>
              <span class="studio-meta-sep">•</span>
              <a href={studioWebsite} target="_blank" rel="noopener" class="studio-website">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6"/><path d="M8 2c0 0-3 2-3 6s3 6 3 6M8 2c0 0 3 2 3 6s-3 6-3 6M2 8h12"/></svg>
                {studioWebsite.replace(/^https?:\/\//, '').replace(/\/$/, '')}
              </a>
            </>
          )}
        </div>
      </div>
    </div>

    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-num">{totalGames}</div>
        <div class="stat-label">Games</div>
      </div>
      {recentReviews.length > 0 ? (
        <a href="#reviews" class="stat-card">
          <div class="stat-num">{totalReviews.toLocaleString()}</div>
          <div class="stat-label">Reviews</div>
          <div class="stat-link">Read them ↓</div>
        </a>
      ) : (
        <div class="stat-card">
          <div class="stat-num">{totalReviews.toLocaleString()}</div>
          <div class="stat-label">Reviews</div>
          <div class="stat-sub">across all games</div>
        </div>
      )}
      <div class={`stat-card ${overallScoreClass ? `score-card-${overallScoreClass}` : ''}`}>
        {overallAvg
          ? <div class={`stat-num ${overallScoreClass}`}>{overallAvg}</div>
          : <div class="stat-num" style="color:var(--text-tertiary)">—</div>
        }
        <div class="stat-label">Avg score</div>
      </div>
    </div>

    {(studio.description || studio.founded_year || studioCountry || studioWebsite || alsoKnownAs.length > 0) && (
      <div class="about-grid">
        <div>
          {studio.description && (
            <>
              <p class="description collapsed" id="desc">{studio.description}</p>
              <button class="read-more-btn" id="readMoreBtn" onclick="toggleDesc()">Read more →</button>
            </>
          )}
        </div>
        <div class="details-card">
          {alsoKnownAs.length > 0 && (
            <div class="detail-row">
              <span class="detail-label">Also known as</span>
              <span class="detail-value">{alsoKnownAs.join(', ')}</span>
            </div>
          )}
          {studio.founded_year && (
            <div class="detail-row">
              <span class="detail-label">Founded</span>
              <span class="detail-value">{studio.founded_year}</span>
            </div>
          )}
          {studioCountry && (
            <div class="detail-row">
              <span class="detail-label">Country</span>
              <span class="detail-value">{studioCountry}</span>
            </div>
          )}
          {studioWebsite && (
            <div class="detail-row">
              <span class="detail-label">Website</span>
              <a href={studioWebsite} target="_blank" rel="noopener" class="detail-value detail-link">
                {studioWebsite.replace(/^https?:\/\//, '').replace(/\/$/, '')}
              </a>
            </div>
          )}
          <div class="detail-row">
            <span class="detail-label">Games</span>
            <span class="detail-value">{totalGames} total</span>
          </div>
          {totalReviews > 0 && (
            <div class="detail-row">
              <span class="detail-label">Reviews</span>
              <span class="detail-value">{totalReviews.toLocaleString()} across all games</span>
            </div>
          )}
        </div>
      </div>
    )}

    {recentReviews.length > 0 && (
      <div class="section" id="reviews">
        <div class="section-header">
          <span class="section-title">Recent reviews</span>
          <span class="section-count">{totalReviews.toLocaleString()} {totalReviews === 1 ? 'review' : 'reviews'} of {studio.name} games</span>
        </div>
        <div class="review-list" id="reviewList">
          {recentReviews.map((r: any, i: number) => {
            const score = r.score == null ? null : parseFloat(r.score)
            const sc = score == null ? null : scoreClass(score)
            return (
              <div class="review-item" hidden={i >= REVIEWS_SHOWN}>
                <a href={`/games/${r.games?.slug}`} class="review-cover" aria-hidden="true" tabindex="-1">
                  {r.games?.cover_img_url
                    ? <img src={igdbImage(r.games.cover_img_url, 't_cover_small') ?? ''} alt="" loading="lazy" />
                    : '🎮'}
                </a>
                <div class="review-main">
                  <div class="review-head">
                    <div class="review-head-text">
                      <a href={`/games/${r.games?.slug}`} class="review-game">{r.games?.title}</a>
                      <div class="review-byline">
                        {r.profiles?.avatar_url && <img class="review-avatar" src={r.profiles.avatar_url} alt="" loading="lazy" />}
                        <a href={`/reviewers/${r.profiles?.username}`}>@{r.profiles?.username ?? 'unknown'}</a>
                        <span>·</span>
                        <span>{timeAgo(r.published_at ?? r.created_at)}</span>
                      </div>
                    </div>
                    {sc && <div class={`game-score-badge review-score badge-${sc}`}>{formatScore(score)}</div>}
                  </div>
                  {r.title && <div class="review-title">{r.title}</div>}
                  {r.contains_spoilers
                    ? <div class="review-spoiler">Contains spoilers — open the review to read it.</div>
                    : r.body && <div class="review-body">{r.body}</div>}
                  <a href={`/reviews/${r.id}`} class="review-read">Read full review →</a>
                </div>
              </div>
            )
          })}
        </div>
        {recentReviews.length > REVIEWS_SHOWN && (
          <button class="show-more-btn" id="showMoreReviews" type="button">Show more reviews</button>
        )}
      </div>
    )}

    {gameSections.map((sec) => (
      <div class="section year-section" id={sec.id}>
        <div class="section-header">
          <span class="section-title">{sec.title}</span>
          <span class="section-count">{sec.count} {sec.count === 1 ? 'game' : 'games'}</span>
        </div>
        {sec.byYear && sec.groups.length > 1 && (
          <div class="pill-strip-wrap">
            <button type="button" class="strip-arrow" data-strip="-1" aria-label="Earlier in the list" disabled><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12L6 8l4-4"/></svg></button>
            <div class="year-pill-strip">
              {sec.groups.map((grp, i) => (
                <button type="button" class={`year-pill${i === 0 ? ' active' : ''}`} data-year={grp.key}>
                  <span class="year-pill-dot" style={`background:${grp.dot}`}></span>
                  <span class="year-pill-label">{grp.label}</span>
                  <span class="year-pill-count">{grp.cards.length}</span>
                </button>
              ))}
            </div>
            <button type="button" class="strip-arrow" data-strip="1" aria-label="Later in the list"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 12l4-4-4-4"/></svg></button>
          </div>
        )}
        {sec.groups.map((grp, gi) => (
          <div class="year-panel" data-year={grp.key} hidden={gi > 0}>
            {sec.byYear && (
              <div class="year-panel-header">
                <span class="year-panel-label">{grp.label}</span>
                <span class="year-panel-count">{grp.cards.length} {grp.cards.length === 1 ? 'game' : 'games'}</span>
              </div>
            )}
            <div class="paged" data-size={PAGE_SIZE}>
              <div class="game-row">
                {grp.cards.map((g, i) => (
                  <a href={`/games/${g.slug}`} class="game-card" hidden={i >= PAGE_SIZE}
                     style={g.sc ? `border-bottom:2px solid ${SCORE_BORDER[g.sc]}` : undefined}>
                    <div class="game-cover">
                      {g.cover
                        ? <img src={g.cover} alt={g.title} loading="lazy" />
                        : <div class="game-cover-placeholder">🎮</div>
                      }
                      {sec.ranked && <div class="rank-badge">#{i + 1}</div>}
                    </div>
                    {g.avg && <div class={`game-score-badge badge-${g.sc}`}>{g.avg}</div>}
                    <div class="game-info">
                      <div class="game-title-text">{g.title}</div>
                      {!sec.byYear && g.year && <div class="game-year">{g.year}</div>}
                      {g.count > 0 && <div class="game-review-count">{g.count} {g.count === 1 ? 'review' : 'reviews'}</div>}
                    </div>
                  </a>
                ))}
              </div>
              {grp.cards.length > PAGE_SIZE && (
                <div class="row-nav">
                  <button type="button" class="row-arrow" data-dir="-1" aria-label="Previous games" disabled><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12L6 8l4-4"/></svg></button>
                  <button type="button" class="row-arrow" data-dir="1" aria-label="More games"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 12l4-4-4-4"/></svg></button>
                  <span class="row-nav-info">1 / {Math.ceil(grp.cards.length / PAGE_SIZE)}</span>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    ))}

    {totalGames === 0 && (
      <div class="empty-state">
        <div class="empty-title">No games yet</div>
        <p>We don't have any games listed for {studio.name} yet.</p>
      </div>
    )}

  </div>

  <script define:vars={{ coverUrlsJson }}>
    const coverUrls = JSON.parse(coverUrlsJson)

    const mosaic = document.getElementById('heroMosaic')
    if (mosaic && coverUrls.length > 0) {
      const tiles = [...coverUrls, ...coverUrls, ...coverUrls].slice(0, 24)
      tiles.forEach(url => {
        const tile = document.createElement('div')
        tile.className = 'hero-mosaic-tile'
        tile.style.backgroundImage = `url(${url})`
        mosaic.appendChild(tile)
      })
    }

    function toggleDesc() {
      const desc = document.getElementById('desc')
      const btn = document.getElementById('readMoreBtn')
      if (!desc || !btn) return
      desc.classList.toggle('collapsed')
      btn.textContent = desc.classList.contains('collapsed') ? 'Read more →' : 'Read less ↑'
    }
    window.toggleDesc = toggleDesc

    const showMoreReviews = document.getElementById('showMoreReviews')
    showMoreReviews?.addEventListener('click', () => {
      document.querySelectorAll('#reviewList .review-item[hidden]').forEach(el => el.removeAttribute('hidden'))
      showMoreReviews.remove()
    })

    // Paged game rows: show PAGE_SIZE cards at a time.
    document.querySelectorAll('.paged').forEach(paged => {
      const prev = paged.querySelector('[data-dir="-1"]')
      const next = paged.querySelector('[data-dir="1"]')
      const info = paged.querySelector('.row-nav-info')
      if (!prev || !next) return
      const cards = [...paged.querySelectorAll('.game-card')]
      const size = Number(paged.dataset.size)
      const pages = Math.ceil(cards.length / size)
      let page = 0
      const show = () => {
        cards.forEach((c, i) => { c.hidden = Math.floor(i / size) !== page })
        prev.disabled = page === 0
        next.disabled = page >= pages - 1
        if (info) info.textContent = `${page + 1} / ${pages}`
      }
      prev.addEventListener('click', () => { page = Math.max(0, page - 1); show() })
      next.addEventListener('click', () => { page = Math.min(pages - 1, page + 1); show() })
    })

    // Year strips: a pill shows that year's panel.
    document.querySelectorAll('.year-section').forEach(section => {
      const strip = section.querySelector('.year-pill-strip')
      if (!strip) return
      const [stripPrev, stripNext] = section.querySelectorAll('.strip-arrow')
      const updateArrows = () => {
        stripPrev.disabled = strip.scrollLeft <= 0
        stripNext.disabled = strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 1
      }
      stripPrev.addEventListener('click', () => strip.scrollBy({ left: -200, behavior: 'smooth' }))
      stripNext.addEventListener('click', () => strip.scrollBy({ left: 200, behavior: 'smooth' }))
      strip.addEventListener('scroll', updateArrows)
      updateArrows()
      const pills = strip.querySelectorAll('.year-pill')
      pills.forEach(pill => pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.toggle('active', p === pill))
        section.querySelectorAll('.year-panel').forEach(panel => { panel.hidden = panel.dataset.year !== pill.dataset.year })
        strip.scrollTo({ left: Math.max(0, pill.offsetLeft - strip.clientWidth / 2 + pill.offsetWidth / 2), behavior: 'smooth' })
      }))
    })

    const sections = ['overview', 'reviews', 'top-rated', 'most-reviewed', 'developed', 'published']
    const jumpLinks = document.querySelectorAll('.jump-link')
    window.addEventListener('scroll', () => {
      let current = 'overview'
      sections.forEach(id => {
        const el = document.getElementById(id)
        if (el && window.scrollY >= el.offsetTop - 120) current = id
      })
      jumpLinks.forEach(l => l.classList.toggle('active', l.getAttribute('href') === `#${current}`))
    })

    function toggleTheme() {
      const h = document.documentElement
      const n = h.getAttribute('data-theme') === 'light' ? 'dark' : 'light'
      h.setAttribute('data-theme', n)
      localStorage.setItem('theme', n)
      updateIcon(n)
    }
    function updateIcon(t) {
      const i = document.getElementById('themeIcon')
      if (!i) return
      i.innerHTML = t === 'dark'
        ? '<path d="M15 10.5A7 7 0 016.5 3a7 7 0 100 12 7 7 0 008.5-4.5z"/>'
        : '<circle cx="9" cy="9" r="3.5"/><path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.22 3.22l1.42 1.42M13.36 13.36l1.42 1.42M13.36 4.64l1.42-1.42M3.22 14.78l1.42-1.42"/>'
    }
    window.toggleTheme = function(t) {
      toggleTheme(t);
      var m = document.getElementById('meta-theme-color');
      if (m) m.content = t === 'dark' ? '#0f0f0e' : '#f9f8f6';
    }

    const saved = document.documentElement.getAttribute('data-theme') || 'light'
    updateIcon(saved)
  </script>

</body>
</html>
