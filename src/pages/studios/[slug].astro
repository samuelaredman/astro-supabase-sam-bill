---
export const prerender = false;
import { getSupabase, getSupabaseAdmin, createSupabaseServerClientFromContext } from '../../utils/database'
import { igdbFetch } from '../../utils/igdb'
import { igdbImage, scoreClass } from '../../utils/format'
import { isAllowedGameCategory } from '../../utils/games'
import Layout from '../../components/Layout.astro'

const supabase = getSupabase()
const { data: { user: _studioUser } } = await createSupabaseServerClientFromContext(Astro).auth.getUser();
const isLoggedIn = !!_studioUser;

const { slug = '' } = Astro.params;
const activeTab = Astro.url.searchParams.get('tab') || 'overview'

const { data: studio } = await supabase
  .from('developers')
  .select(`
    id, name, slug, country, description,
    website_url, logo_url, founded_year, igdb_id
  `)
  .eq('slug', slug)
  .single()

if (!studio) return Astro.redirect('/404')

// Authoritative indexability gate: does ANY of this studio's games have a
// published review? Runs against the full company↔game↔review relationship (not
// the category-filtered display list), matching the sitemap's inclusion rule.
// Admin client — under RLS the anon client silently drops the nested review rows.
const { data: reviewedInStudio } = await (getSupabaseAdmin() as any)
  .from('game_companies')
  .select('company_id, games!inner(reviews!inner(id))')
  .eq('company_id', studio.id)
  .eq('games.reviews.status', 'published')
  .limit(1)
const hasReviewedGame = (reviewedInStudio?.length ?? 0) > 0

const { data: developedRaw } = await supabase
  .from('game_companies')
  .select(`
    role,
    games(id, title, slug, cover_img_url, date_released, igdb_id, igdb_category)
  `)
  .eq('company_id', studio.id)

const allEntries = developedRaw ?? []

const developedGames = allEntries
  .filter((e: any) => e.role === 'developer')
  .map((e: any) => e.games)
  .filter(Boolean)
  .filter((g: any) => isAllowedGameCategory(g.igdb_category, g.title))
  .sort((a: any, b: any) =>
    new Date(b.date_released ?? 0).getTime() - new Date(a.date_released ?? 0).getTime()
  )

const publishedGames = allEntries
  .filter((e: any) => e.role === 'publisher')
  .map((e: any) => e.games)
  .filter(Boolean)
  .filter((g: any) => isAllowedGameCategory(g.igdb_category, g.title))
  .sort((a: any, b: any) =>
    new Date(b.date_released ?? 0).getTime() - new Date(a.date_released ?? 0).getTime()
  )

const publishedOnly = publishedGames.filter(
  (pg: any) => !developedGames.find((dg: any) => dg.id === pg.id)
)

const combinedGames = [...developedGames, ...publishedOnly]

const allGameIds = [...new Set(allEntries.map((e: any) => e.games?.id).filter(Boolean))]

const { data: reviewScores } = await supabase
  .from('reviews')
  .select('game_id, score')
  .in('game_id', allGameIds)
  .eq('status', 'published')

const reviewsByGame: Record<string, number[]> = {}
for (const r of reviewScores ?? []) {
  if (r.score == null) continue
  if (!reviewsByGame[r.game_id]) reviewsByGame[r.game_id] = []
  reviewsByGame[r.game_id].push(r.score)
}

function gameAvgScore(gameId: string): string | null {
  const scores = reviewsByGame[gameId]
  if (!scores || scores.length === 0) return null
  return (scores.reduce((a, b) => a + b, 0) / scores.length).toFixed(1)
}

function gameReviewCount(gameId: string): number {
  return reviewsByGame[gameId]?.length ?? 0
}

function releaseYear(dateStr: string | null): string | null {
  if (!dateStr) return null
  return String(new Date(dateStr).getFullYear())
}

function countryName(code: string | null): string | null {
  if (!code) return null
  try {
    return new Intl.DisplayNames(['en'], { type: 'region' }).of(code) ?? null
  } catch { return null }
}

// review-weighted avg across all games
const allScores = Object.values(reviewsByGame).flat()
const overallAvg = allScores.length > 0
  ? (allScores.reduce((a, b) => a + b, 0) / allScores.length).toFixed(1)
  : null

const totalReviews = allScores.length
const totalGames = new Set([
  ...developedGames.map((g: any) => g.id),
  ...publishedOnly.map((g: any) => g.id)
]).size

const scoreDistribution = Array.from({ length: 10 }, (_, i) =>
  allScores.filter((s: number) => Math.round(s) === i + 1).length
)
const distJson = JSON.stringify(scoreDistribution)

// Top rated games — scored games sorted highest-first, for the Overview carousel
const topRatedGames = combinedGames
  .map((g: any) => ({ game: g, avg: gameAvgScore(g.id) }))
  .filter((e: any) => e.avg !== null)
  .sort((a: any, b: any) => parseFloat(b.avg) - parseFloat(a.avg))
  .slice(0, 10)

// Recently released — most recent by date, regardless of review status
const recentGames = [...combinedGames]
  .sort((a: any, b: any) => new Date(b.date_released ?? 0).getTime() - new Date(a.date_released ?? 0).getTime())
  .slice(0, 10)

// Hero image — sharp IGDB artwork/screenshot from the studio's flagship game
// (top-rated, else most recent with an igdb_id), falling back to the blurred
// cover mosaic when no artwork/screenshot exists. Mirrors the fallback chain
// used on games/[slug].astro.
const flagshipGame = topRatedGames.find((e: any) => e.game?.igdb_id)?.game
  ?? recentGames.find((g: any) => g.igdb_id)
  ?? null

let heroArtwork: string | null = null
let heroScreenshot: string | null = null
if (flagshipGame?.igdb_id) {
  const heroResult = await igdbFetch('games',
    `fields artworks.url, screenshots.url; where id = ${flagshipGame.igdb_id};`)
  const heroGameData = heroResult?.[0] ?? null
  heroArtwork = heroGameData?.artworks?.[0]?.url ?? null
  heroScreenshot = heroGameData?.screenshots?.[0]?.url ?? null
}
const showCoverBlur = !heroArtwork && !heroScreenshot
const heroImageUrl = heroArtwork
  ? igdbImage(heroArtwork, 't_1080p_2x') ?? ''
  : heroScreenshot ? igdbImage(heroScreenshot, 't_1080p_2x') ?? '' : ''
const heroImageUrl1x = heroArtwork
  ? igdbImage(heroArtwork, 't_1080p') ?? ''
  : heroScreenshot ? igdbImage(heroScreenshot, 't_1080p') ?? '' : ''

// fetch IGDB company details
let igdbData: any = null
if (studio.igdb_id) {
  const [igdbCompany] = await igdbFetch('companies',
    `fields name, description, country, start_date, logo.url, url;
     where id = ${studio.igdb_id};`)
  igdbData = igdbCompany ?? null
}

const overallScoreClass = overallAvg ? scoreClass(parseFloat(overallAvg)) : null
const coverUrls = combinedGames
  .slice(0, 12)
  .map((g: any) => igdbImage(g.cover_img_url))
  .filter(Boolean)
const coverUrlsJson = JSON.stringify(coverUrls)

const ogImageUrl = studio.logo_url ? (igdbImage(studio.logo_url, 't_logo_med') ?? '') : ''
const studioDescription = studio.description
  ? `${studio.description.slice(0, 155)}${studio.description.length > 155 ? '…' : ''}`
  : `${studio.name} games and reviews on Chekpoint.`

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: studio.name,
  ...(studio.description ? { description: studio.description } : {}),
  ...(ogImageUrl ? { logo: ogImageUrl } : {}),
  ...(studio.website_url ? { url: studio.website_url } : {}),
  ...(studio.founded_year ? { foundingDate: String(studio.founded_year) } : {}),
}

// CDN cache — anonymous visitors share a cached response; auth users get a fresh render
if (!isLoggedIn) {
  Astro.response.headers.set('Netlify-CDN-Cache-Control', 'public, max-age=300, stale-while-revalidate=600');
  Astro.response.headers.set('Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}
Astro.response.headers.set('Netlify-Vary', 'cookie=sb-bzlwwtatoiyzwirerify-auth-token');
---

<Layout title={`${studio.name} — Chekpoint`} description={studioDescription} ogImage={ogImageUrl} variant="fullwidth" noindex={!hasReviewedGame}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet" />
  </Fragment>
<style is:global>
    :root[data-theme="light"] {
      --bg:#f5f4f2;--bg-card:#ffffff;--bg-hover:#f4f3f0;
      --score-mid:#6b5a1a;--score-mid-bg:#f5f0ea;
      --game-accent:#4a3a8a;--game-accent-subtle:rgba(74,58,138,.06);
      --hero-overlay:linear-gradient(to bottom,rgba(245,244,242,.05)0%,rgba(245,244,242,.2)40%,rgba(245,244,242,.85)75%,rgba(245,244,242,1)100%);
    }
    :root[data-theme="dark"] {
      --bg:#09090a;--bg-card:#131314;--bg-hover:#1c1c1e;
      --border:#222224;--border-subtle:#191919;
      --text-tertiary:#484644;--tag-bg:#1c1c1e;--tag-text:#6a6866;
      --shadow:0 1px 3px rgba(0,0,0,.5);--shadow-md:0 4px 16px rgba(0,0,0,.7);
      --score-great:#4ade80;--score-great-bg:#112e1c;
      --score-teal:#2dd4bf;--score-teal-bg:#082d2a;
      --score-good:#60a5fa;--score-good-bg:#0e2240;
      --score-mid:#fbbf24;--score-mid-bg:#271e00;
      --score-orange:#fb923c;--score-orange-bg:#2c160a;
      --score-low:#f87171;--score-low-bg:#300e0e;
      --score-perfect:#ffffff;--score-perfect-bg:#22223a;
      --game-accent:#6050c8;--game-accent-subtle:rgba(96,80,200,.09);
      --hero-overlay:linear-gradient(to bottom,rgba(9,9,10,.05)0%,rgba(9,9,10,.2)40%,rgba(9,9,10,.8)75%,rgba(9,9,10,1)100%);
    }
    html{scroll-behavior:smooth}

    .topnav{position:sticky;top:0;z-index:30;background:rgba(9,9,10,.82);border-bottom:1px solid var(--border);padding:13px 28px;display:flex;align-items:center;backdrop-filter:blur(20px)}
    [data-theme="light"] .topnav{background:rgba(245,244,242,.82)}
    .back-btn{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--text-tertiary);transition:color .15s;background:none;border:none;cursor:pointer;font-family:inherit;padding:0}
    .back-btn:hover{color:var(--text-primary)}
    .logo{font-family:'Press Start 2P',monospace;font-size:13px;letter-spacing:-.3px;line-height:1;display:flex;align-items:center;gap:7px;margin-left:auto}
    .logo-dot{width:6px;height:6px;background:var(--game-accent);border-radius:50%;box-shadow:0 0 10px var(--game-accent)}
    .theme-btn{background:none;border:none;cursor:pointer;color:var(--text-tertiary);padding:6px;display:flex;align-items:center;transition:color .15s;margin-left:8px}
    .theme-btn:hover{color:var(--text-primary)}

    /* TAB NAV */
    .tab-nav{display:flex;gap:4px;margin-bottom:28px;background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:4px}
    .tab-link{padding:8px 18px;border-radius:7px;font-size:13px;font-weight:600;color:var(--text-secondary);text-decoration:none;transition:all .15s;white-space:nowrap;display:flex;align-items:center;gap:6px}
    .tab-link:hover{color:var(--text-primary);background:var(--bg-hover)}
    .tab-link.active{background:var(--game-accent);color:#fff}
    .tab-count{font-size:11px;font-weight:700;background:rgba(255,255,255,.15);border-radius:10px;padding:1px 6px;line-height:1.5}
    .tab-link:not(.active) .tab-count{background:var(--bg-hover);color:var(--text-tertiary)}

    .hero{position:relative;width:100%;height:400px;overflow:hidden;background:#04040a}
    .hero-artwork{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%}
    .hero-mosaic{position:absolute;inset:-20px;display:flex;flex-wrap:wrap;filter:blur(18px) saturate(1.5) brightness(.38);transform:scale(1.08)}
    .hero-mosaic-tile{flex:1 1 90px;min-width:90px;min-height:160px;background-size:cover;background-position:center}
    .hero-overlay{position:absolute;inset:0;background:var(--hero-overlay)}

    .page{max-width:980px;margin:0 auto;padding:0 28px 100px}

    .studio-header{display:flex;gap:24px;align-items:flex-end;margin-top:-100px;margin-bottom:28px;position:relative;z-index:2}
    .studio-logo-wrap{flex-shrink:0;width:130px;height:130px;border-radius:14px;background:var(--bg-card);border:1px solid rgba(96,80,200,.4);box-shadow:0 12px 40px rgba(0,0,0,.8),0 0 32px rgba(96,80,200,.2);display:flex;align-items:center;justify-content:center;overflow:hidden}
    .studio-logo{width:100%;height:100%;object-fit:contain;padding:14px}
    .studio-logo-placeholder{font-size:48px}
    .studio-info{flex:1;min-width:0;padding-bottom:4px}
    .studio-name{font-family:'Cinzel',serif;font-size:32px;line-height:1.1;letter-spacing:.04em;margin-bottom:8px;font-weight:600;text-shadow:0 2px 20px rgba(0,0,0,.6)}
    .meta-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .meta-tag{font-size:13px;color:var(--text-secondary)}
    .meta-sep{color:var(--text-tertiary);font-size:10px}
    .meta-link{font-size:13px;color:var(--game-accent);transition:opacity .15s;display:inline-flex;align-items:center;gap:4px}
    .meta-link:hover{opacity:.7}

    .score-hero{display:flex;align-items:flex-start;gap:24px;padding:20px 24px;background:var(--bg-card);border:1px solid var(--border);border-radius:16px;margin-bottom:28px;position:relative;overflow:hidden}
    .score-hero::before{content:'';position:absolute;inset:0;background:var(--game-accent-subtle);pointer-events:none}
    .score-hero::after{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(to right,transparent,var(--game-accent),transparent);opacity:.6}
    .avg-score-num{font-family:'Century Schoolbook','New Century Schoolbook',Georgia,serif;font-size:72px;line-height:1;font-weight:700;position:relative;z-index:1;letter-spacing:-3px;padding-top:8px}
    .score-perfect-color{color:#ffffff;text-shadow:0 0 20px rgba(255,255,255,.7),0 0 40px rgba(255,255,255,.3)}
    .score-great-color{color:var(--score-great)}
    .score-teal-color{color:var(--score-teal)}
    .score-good-color{color:var(--score-good)}
    .score-mid-color{color:var(--score-mid)}
    .score-orange-color{color:var(--score-orange)}
    .score-low-color{color:var(--score-low)}
    .score-divider{width:1px;height:56px;background:var(--border);flex-shrink:0;margin-top:8px}
    .score-meta{flex:1;position:relative;z-index:1}
    .score-label{font-size:11px;font-weight:500;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:.1em;margin-bottom:3px}
    .review-count-label{font-size:13px;color:var(--text-secondary);margin-bottom:12px}
    .score-dist{display:flex;gap:4px;align-items:flex-end;height:44px;margin-top:8px}
    .dist-bar-wrap{display:flex;flex-direction:column;align-items:center;gap:3px;flex:1;cursor:pointer}
    .dist-bar{width:100%;border-radius:4px 4px 0 0;min-height:4px;transition:opacity .15s,transform .15s}
    .dist-bar-wrap:hover .dist-bar{opacity:1!important;transform:scaleY(1.06);transform-origin:bottom}
    .dist-label{font-size:9px;color:var(--text-tertiary);font-weight:500;margin-top:2px}

    .tab-panel{display:none}
    .tab-panel.active{display:block}

    /* TWO COLUMN — OVERVIEW */
    .two-col{display:grid;grid-template-columns:1fr 300px;gap:24px;align-items:start}
    @media(max-width:720px){.two-col{grid-template-columns:1fr}}
    .main-col{min-width:0}
    .sidebar-col{position:sticky;top:20px;display:flex;flex-direction:column;gap:14px}
    .section{margin-bottom:32px}
    .section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
    .section-title{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.12em;color:var(--text-tertiary)}
    .section-count{font-size:12px;color:var(--text-tertiary)}

    .similar-scroll{display:flex;gap:10px;overflow-x:auto;padding-bottom:4px;scrollbar-width:thin}
    .similar-card{flex-shrink:0;width:110px;background:var(--bg-card);border:1px solid var(--border);border-radius:10px;overflow:hidden;transition:transform .15s;display:block}
    .similar-card:hover{transform:translateY(-3px)}
    .similar-cover{aspect-ratio:3/4;background:var(--tag-bg);overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:24px;position:relative}
    .similar-cover img{width:100%;height:100%;object-fit:cover}
    .similar-score-badge{position:absolute;bottom:5px;right:5px;min-width:26px;height:20px;padding:0 5px;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;font-family:'DM Serif Display',serif;backdrop-filter:blur(6px)}
    .similar-score-badge.score-perfect{background:rgba(255,255,255,.95);color:#09090a;box-shadow:0 0 8px rgba(255,255,255,.6);border:1px solid rgba(255,255,255,.9)}
    .similar-score-badge.score-great{background:rgba(17,46,28,.9);color:#4ade80;border:1px solid rgba(74,222,128,.5)}
    .similar-score-badge.score-teal{background:rgba(8,45,42,.9);color:#2dd4bf;border:1px solid rgba(45,212,191,.5)}
    .similar-score-badge.score-good{background:rgba(14,34,64,.88);color:#60a5fa;border:1px solid rgba(96,165,250,.4)}
    .similar-score-badge.score-mid{background:rgba(39,30,0,.88);color:#fbbf24;border:1px solid rgba(251,191,36,.4)}
    .similar-score-badge.score-orange{background:rgba(44,22,10,.88);color:#fb923c;border:1px solid rgba(251,146,60,.4)}
    .similar-score-badge.score-low{background:rgba(48,14,14,.88);color:#f87171;border:1px solid rgba(248,113,113,.4)}
    .similar-info{padding:6px 8px 8px}
    .similar-title{font-size:10px;font-weight:500;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;color:var(--text-secondary)}

    /* SIDEBAR */
    .desc-card{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:16px}
    .desc-text{font-size:13px;line-height:1.75;color:var(--text-secondary);display:-webkit-box;-webkit-line-clamp:6;-webkit-box-orient:vertical;overflow:hidden}
    .desc-text.expanded{display:block}
    .read-more-btn{background:none;border:none;font-family:inherit;font-size:12px;color:var(--game-accent);cursor:pointer;padding:8px 0 0;display:block;font-weight:500}
    .details-card{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:4px 16px}
    .detail-row{display:flex;gap:10px;padding:10px 0;border-bottom:1px solid var(--border-subtle);font-size:12px}
    .detail-row:last-child{border-bottom:none}
    .detail-label{flex-shrink:0;width:76px;color:var(--text-tertiary);padding-top:1px;text-transform:uppercase;letter-spacing:.06em;font-size:10px;font-weight:500}
    .detail-value{color:var(--text-secondary);line-height:1.5;flex:1}
    .detail-link{color:var(--game-accent);transition:opacity .15s}
    .detail-link:hover{opacity:.7}

    /* GAMES GRID (Developed / Published tabs) */
    .games-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:16px}
    .game-card{background:var(--bg-card);border:1px solid var(--border);border-radius:12px;overflow:hidden;transition:transform .15s,box-shadow .15s,border-color .15s;display:block;position:relative}
    .game-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-md);border-color:rgba(96,80,200,.3)}
    .game-cover{aspect-ratio:3/4;background:var(--tag-bg);overflow:hidden;position:relative}
    .game-cover img{width:100%;height:100%;object-fit:cover}
    .game-cover-placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:36px}
    .game-score-badge{position:absolute;top:8px;right:8px;width:30px;height:30px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;font-family:'Century Schoolbook',Georgia,serif}
    .badge-score-perfect{color:#09090a;background:#ffffff;border:1px solid rgba(255,255,255,.8);box-shadow:0 0 10px rgba(255,255,255,.9),0 0 24px rgba(255,255,255,.6),0 0 48px rgba(255,255,255,.3)}
    [data-theme="light"] .badge-score-perfect{color:#ffffff;background:#1a1a2e;border:1px solid rgba(30,26,60,.3);box-shadow:0 0 8px rgba(30,26,60,.4)}
    .badge-score-great{color:var(--score-great);background:var(--score-great-bg);border:1px solid rgba(74,222,128,.3)}
    .badge-score-teal{color:var(--score-teal);background:var(--score-teal-bg);border:1px solid rgba(45,212,191,.3)}
    .badge-score-good{color:var(--score-good);background:var(--score-good-bg);border:1px solid rgba(96,165,250,.3)}
    .badge-score-mid{color:var(--score-mid);background:var(--score-mid-bg);border:1px solid rgba(251,191,36,.3)}
    .badge-score-orange{color:var(--score-orange);background:var(--score-orange-bg);border:1px solid rgba(251,146,60,.3)}
    .badge-score-low{color:var(--score-low);background:var(--score-low-bg);border:1px solid rgba(248,113,113,.3)}
    .game-info{padding:10px 12px 12px}
    .game-title-text{font-size:12px;font-weight:500;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:3px}
    .game-year{font-size:11px;color:var(--text-tertiary)}
    .game-review-count{font-size:10px;color:var(--text-tertiary);margin-top:2px}

    /* STATS TAB */
    .stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:28px}
    .stat-card{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:22px 20px 18px}
    .stat-card.score-card-score-great{border-bottom:2px solid var(--score-great)}
    .stat-card.score-card-score-teal{border-bottom:2px solid var(--score-teal)}
    .stat-card.score-card-score-good{border-bottom:2px solid var(--score-good)}
    .stat-card.score-card-score-mid{border-bottom:2px solid var(--score-mid)}
    .stat-card.score-card-score-orange{border-bottom:2px solid var(--score-orange)}
    .stat-card.score-card-score-low{border-bottom:2px solid var(--score-low)}
    .stat-num{font-family:'Century Schoolbook','New Century Schoolbook',Georgia,serif;font-size:36px;font-weight:400;line-height:1;letter-spacing:-1px;margin-bottom:6px;color:var(--text-primary)}
    .stat-num.score-great{color:var(--score-great)}
    .stat-num.score-teal{color:var(--score-teal)}
    .stat-num.score-good{color:var(--score-good)}
    .stat-num.score-mid{color:var(--score-mid)}
    .stat-num.score-orange{color:var(--score-orange)}
    .stat-num.score-low{color:var(--score-low)}
    .stat-label{font-size:11px;font-weight:500;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:.08em}
    .stat-sub{font-size:11px;color:var(--text-tertiary);margin-top:3px}
    .stats-dist-card{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:20px 24px}
    .stats-dist-card .score-dist{height:90px}
    .stats-dist-card .dist-bar-wrap{gap:5px}

    .empty-state{padding:60px 0;text-align:center;color:var(--text-tertiary)}
    .empty-title{font-family:'DM Serif Display',serif;font-size:20px;color:var(--text-secondary);margin-bottom:8px}

    @media(max-width:600px){
      .studio-header{flex-direction:column;align-items:flex-start;margin-top:-60px}
      .studio-name{font-size:26px}
      .hero{height:260px}
      .score-hero{flex-wrap:wrap;gap:16px}
      .avg-score-num{font-size:56px}
      .tab-nav{flex-wrap:wrap}
      .games-grid{grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:12px}
      .stats-row{gap:8px}
      .stat-num{font-size:30px}
    }
  </style>

  <nav class="topnav">
    <button class="back-btn" onclick="(function(){var r=document.referrer;try{var u=new URL(r);if(u.hostname===location.hostname&&u.pathname!==location.pathname){window.location.assign(r);return}}catch(e){}window.location.href='/'})()">
      <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12L6 8L10 4"/></svg>
      Back
    </button>
    <a href="/" class="logo"><span class="logo-dot"></span>Chekpoint</a>
    <button class="theme-btn" onclick="toggleTheme()">
      <svg id="studioThemeIcon" width="17" height="17" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="9" r="3.5"/>
        <path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.22 3.22l1.42 1.42M13.36 13.36l1.42 1.42M13.36 4.64l1.42-1.42M3.22 14.78l1.42-1.42"/>
      </svg>
    </button>
  </nav>

  <div class="hero">
    {!showCoverBlur && heroImageUrl ? (
      <img class="hero-artwork" src={heroImageUrl1x}
        srcset={`${heroImageUrl1x} 1920w, ${heroImageUrl} 3840w`} sizes="100vw"
        alt="" loading="eager"
        onerror="this.style.display='none';var m=document.getElementById('heroMosaic');if(m)m.style.display='flex'" />
    ) : null}
    <div class="hero-mosaic" id="heroMosaic" style={showCoverBlur ? '' : 'display:none'}></div>
    <div class="hero-overlay"></div>
  </div>

  <div class="page">

    <div class="studio-header">
      <div class="studio-logo-wrap">
        {studio.logo_url
          ? <img class="studio-logo" src={igdbImage(studio.logo_url, 't_logo_med') ?? ''} alt={studio.name} loading="eager" />
          : <span class="studio-logo-placeholder">🎮</span>
        }
      </div>
      <div class="studio-info">
        <h1 class="studio-name">{studio.name}</h1>
        <div class="meta-row">
          {studio.founded_year && <span class="meta-tag">Est. {studio.founded_year}</span>}
          {studio.founded_year && studio.country && <span class="meta-sep">•</span>}
          {studio.country && <span class="meta-tag">{countryName(studio.country) ?? String(studio.country)}</span>}
          {studio.website_url && (
            <>
              <span class="meta-sep">•</span>
              <a href={studio.website_url} target="_blank" rel="noopener" class="meta-link">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6"/><path d="M8 2c0 0-3 2-3 6s3 6 3 6M8 2c0 0 3 2 3 6s-3 6-3 6M2 8h12"/></svg>
                {studio.website_url.replace(/^https?:\/\//, '').replace(/\/$/, '')}
              </a>
            </>
          )}
        </div>
      </div>
    </div>

    {overallAvg ? (
      <div class="score-hero">
        <div class={`avg-score-num ${overallScoreClass}-color`}>{overallAvg}</div>
        <div class="score-divider"></div>
        <div class="score-meta">
          <div class="score-label">Chekpoint Score</div>
          <div class="review-count-label">from {totalReviews.toLocaleString()} {totalReviews === 1 ? 'review' : 'reviews'} across {totalGames} {totalGames === 1 ? 'game' : 'games'}</div>
          <div class="score-dist" id="scoreDist"></div>
        </div>
      </div>
    ) : (
      <div class="score-hero">
        <div class="score-meta">
          <div class="score-label">No reviews yet</div>
          <div class="review-count-label">{totalGames} {totalGames === 1 ? 'game' : 'games'} on Chekpoint — none reviewed yet</div>
        </div>
      </div>
    )}

    <!-- TAB BUTTONS -->
    <nav class="tab-nav">
      <a href={`/studios/${studio.slug}?tab=overview`} class={`tab-link ${activeTab === 'overview' ? 'active' : ''}`} data-tab="overview">Overview</a>
      <a href={`/studios/${studio.slug}?tab=developed`} class={`tab-link ${activeTab === 'developed' ? 'active' : ''}`} data-tab="developed">Developed {developedGames.length > 0 && <span class="tab-count">{developedGames.length}</span>}</a>
      <a href={`/studios/${studio.slug}?tab=published`} class={`tab-link ${activeTab === 'published' ? 'active' : ''}`} data-tab="published">Published {publishedOnly.length > 0 && <span class="tab-count">{publishedOnly.length}</span>}</a>
      <a href={`/studios/${studio.slug}?tab=stats`} class={`tab-link ${activeTab === 'stats' ? 'active' : ''}`} data-tab="stats">Stats</a>
    </nav>

    <!-- ── OVERVIEW TAB ── -->
    <div class={`tab-panel ${activeTab === 'overview' ? 'active' : ''}`} data-tab="overview">
      <div class="two-col">
        <div class="main-col">
          {topRatedGames.length > 0 && (
            <div class="section">
              <div class="section-header"><span class="section-title">Top rated</span></div>
              <div class="similar-scroll">
                {topRatedGames.map(({ game: g, avg }: any) => (
                  <a href={`/games/${g.slug}`} class="similar-card">
                    <div class="similar-cover">
                      {g.cover_img_url ? <img src={igdbImage(g.cover_img_url) ?? ''} alt={g.title} loading="lazy" /> : '🎮'}
                      <div class={`similar-score-badge ${scoreClass(parseFloat(avg))}`}>{avg}</div>
                    </div>
                    <div class="similar-info"><div class="similar-title">{g.title}</div></div>
                  </a>
                ))}
              </div>
            </div>
          )}
          {recentGames.length > 0 && (
            <div class="section">
              <div class="section-header"><span class="section-title">Recently released</span></div>
              <div class="similar-scroll">
                {recentGames.map((g: any) => {
                  const avg = gameAvgScore(g.id)
                  return (
                    <a href={`/games/${g.slug}`} class="similar-card">
                      <div class="similar-cover">
                        {g.cover_img_url ? <img src={igdbImage(g.cover_img_url) ?? ''} alt={g.title} loading="lazy" /> : '🎮'}
                        {avg && <div class={`similar-score-badge ${scoreClass(parseFloat(avg))}`}>{avg}</div>}
                      </div>
                      <div class="similar-info"><div class="similar-title">{g.title}</div></div>
                    </a>
                  )
                })}
              </div>
            </div>
          )}
          {combinedGames.length === 0 && (
            <div class="empty-state">
              <div class="empty-title">No games yet</div>
              <p>We don't have any games listed for {studio.name} yet.</p>
            </div>
          )}
        </div>

        <div class="sidebar-col">
          {studio.description && (
            <div class="desc-card">
              <p class="desc-text" id="desc">{studio.description}</p>
              <button class="read-more-btn" id="readMoreBtn" onclick="toggleDesc()">Read more →</button>
            </div>
          )}
          <div class="details-card">
            {studio.founded_year && (<div class="detail-row"><span class="detail-label">Founded</span><span class="detail-value">{studio.founded_year}</span></div>)}
            {studio.country && (<div class="detail-row"><span class="detail-label">Country</span><span class="detail-value">{countryName(studio.country) ?? String(studio.country)}</span></div>)}
            {studio.website_url && (
              <div class="detail-row">
                <span class="detail-label">Website</span>
                <a href={studio.website_url} target="_blank" rel="noopener" class="detail-value detail-link">
                  {studio.website_url.replace(/^https?:\/\//, '').replace(/\/$/, '')}
                </a>
              </div>
            )}
            <div class="detail-row"><span class="detail-label">Games</span><span class="detail-value">{totalGames} total</span></div>
            {totalReviews > 0 && (<div class="detail-row"><span class="detail-label">Reviews</span><span class="detail-value">{totalReviews.toLocaleString()} across all games</span></div>)}
          </div>
        </div>
      </div>
    </div>

    <!-- ── DEVELOPED TAB ── -->
    <div class={`tab-panel ${activeTab === 'developed' ? 'active' : ''}`} data-tab="developed">
      {developedGames.length === 0 ? (
        <div class="empty-state">
          <div class="empty-title">No developed games</div>
          <p style="font-size:14px;color:var(--text-tertiary)">We don't have any games developed by {studio.name} listed yet.</p>
        </div>
      ) : (
        <div class="games-grid">
          {developedGames.map((g: any) => {
            const avg = gameAvgScore(g.id)
            const count = gameReviewCount(g.id)
            const sc = avg ? scoreClass(parseFloat(avg)) : null
            return (
              <a href={`/games/${g.slug}`} class="game-card">
                <div class="game-cover">
                  {g.cover_img_url
                    ? <img src={igdbImage(g.cover_img_url) ?? ''} alt={g.title} loading="lazy" />
                    : <div class="game-cover-placeholder">🎮</div>
                  }
                </div>
                {avg && <div class={`game-score-badge badge-${sc}`}>{avg}</div>}
                <div class="game-info">
                  <div class="game-title-text">{g.title}</div>
                  {releaseYear(g.date_released) && <div class="game-year">{releaseYear(g.date_released)}</div>}
                  {count > 0 && <div class="game-review-count">{count} {count === 1 ? 'review' : 'reviews'}</div>}
                </div>
              </a>
            )
          })}
        </div>
      )}
    </div>

    <!-- ── PUBLISHED TAB ── -->
    <div class={`tab-panel ${activeTab === 'published' ? 'active' : ''}`} data-tab="published">
      {publishedOnly.length === 0 ? (
        <div class="empty-state">
          <div class="empty-title">No published games</div>
          <p style="font-size:14px;color:var(--text-tertiary)">We don't have any games published by {studio.name} listed yet.</p>
        </div>
      ) : (
        <div class="games-grid">
          {publishedOnly.map((g: any) => {
            const avg = gameAvgScore(g.id)
            const count = gameReviewCount(g.id)
            const sc = avg ? scoreClass(parseFloat(avg)) : null
            return (
              <a href={`/games/${g.slug}`} class="game-card">
                <div class="game-cover">
                  {g.cover_img_url
                    ? <img src={igdbImage(g.cover_img_url) ?? ''} alt={g.title} loading="lazy" />
                    : <div class="game-cover-placeholder">🎮</div>
                  }
                </div>
                {avg && <div class={`game-score-badge badge-${sc}`}>{avg}</div>}
                <div class="game-info">
                  <div class="game-title-text">{g.title}</div>
                  {releaseYear(g.date_released) && <div class="game-year">{releaseYear(g.date_released)}</div>}
                  {count > 0 && <div class="game-review-count">{count} {count === 1 ? 'review' : 'reviews'}</div>}
                </div>
              </a>
            )
          })}
        </div>
      )}
    </div>

    <!-- ── STATS TAB ── -->
    <div class={`tab-panel ${activeTab === 'stats' ? 'active' : ''}`} data-tab="stats">
      {totalReviews === 0 ? (
        <div class="empty-state">
          <div class="empty-title">No stats yet</div>
          <p style="font-size:14px;color:var(--text-tertiary)">Stats will appear once {studio.name}'s games are reviewed.</p>
        </div>
      ) : (
        <>
          <div class="stats-row">
            <div class="stat-card">
              <div class="stat-num">{totalGames}</div>
              <div class="stat-label">Games</div>
            </div>
            <div class="stat-card">
              <div class="stat-num">{totalReviews.toLocaleString()}</div>
              <div class="stat-label">Reviews</div>
              <div class="stat-sub">across all games</div>
            </div>
            <div class={`stat-card ${overallScoreClass ? `score-card-${overallScoreClass}` : ''}`}>
              <div class={`stat-num ${overallScoreClass ?? ''}`}>{overallAvg}</div>
              <div class="stat-label">Avg score</div>
            </div>
          </div>
          <div class="stats-dist-card">
            <div class="section-title" style="margin-bottom:14px">Score distribution</div>
            <div class="score-dist" id="statsScoreDist"></div>
          </div>
        </>
      )}
    </div>

  </div>

  <script define:vars={{ coverUrlsJson, distJson }}>
    const coverUrls = JSON.parse(coverUrlsJson)

    const mosaic = document.getElementById('heroMosaic')
    if (mosaic && coverUrls.length > 0) {
      const tiles = [...coverUrls, ...coverUrls, ...coverUrls].slice(0, 24)
      tiles.forEach(url => {
        const tile = document.createElement('div')
        tile.className = 'hero-mosaic-tile'
        tile.style.backgroundImage = `url(${url})`
        mosaic.appendChild(tile)
      })
    }

    function toggleDesc() {
      const desc = document.getElementById('desc')
      const btn = document.getElementById('readMoreBtn')
      if (!desc || !btn) return
      desc.classList.toggle('expanded')
      btn.textContent = desc.classList.contains('expanded') ? 'Read less ↑' : 'Read more →'
    }
    window.toggleDesc = toggleDesc

    // ── CLIENT-SIDE TAB SWITCHING ──
    document.querySelectorAll('.tab-link').forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault()
        var tab = new URL(link.href, location.origin).searchParams.get('tab') || 'overview'
        document.querySelectorAll('.tab-link').forEach(function(l) { l.classList.remove('active') })
        link.classList.add('active')
        document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active') })
        var panel = document.querySelector('.tab-panel[data-tab="' + tab + '"]')
        if (panel) panel.classList.add('active')
        history.replaceState({}, '', '?tab=' + tab)
      })
    })

    window.addEventListener('popstate', function() {
      var tab = new URLSearchParams(location.search).get('tab') || 'overview'
      document.querySelectorAll('.tab-link').forEach(function(l) { l.classList.remove('active') })
      var link = document.querySelector('.tab-link[href*="tab=' + tab + '"]')
      if (link) link.classList.add('active')
      document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active') })
      var panel = document.querySelector('.tab-panel[data-tab="' + tab + '"]')
      if (panel) panel.classList.add('active')
    })

    // score distribution bars — rendered into both the score-hero mini chart
    // and the (taller) Stats tab chart
    var dist = JSON.parse(distJson)
    var maxVal = Math.max.apply(null, dist.concat([1]))
    var barColors = ['#f87171','#f87171','#fb923c','#fb923c','#fbbf24','#fbbf24','#60a5fa','#2dd4bf','#4ade80','#ffffff']
    function buildDist(containerId, maxHeight) {
      var container = document.getElementById(containerId)
      if (!container) return
      dist.forEach(function(count, i) {
        var wrap = document.createElement('div'); wrap.className = 'dist-bar-wrap'
        wrap.title = 'Score ' + (i+1) + ': ' + count + ' reviews'
        var bar = document.createElement('div'); bar.className = 'dist-bar'
        bar.style.height = Math.max(4,(count/maxVal)*maxHeight)+'px'
        bar.style.background = barColors[i]; bar.style.opacity = '0.65'
        var label = document.createElement('div'); label.className = 'dist-label'
        label.textContent = String(i+1)
        wrap.appendChild(bar); wrap.appendChild(label); container.appendChild(wrap)
      })
    }
    buildDist('scoreDist', 40)
    buildDist('statsScoreDist', 84)

    function toggleTheme() {
      const h = document.documentElement
      const n = h.getAttribute('data-theme') === 'light' ? 'dark' : 'light'
      h.setAttribute('data-theme', n)
      localStorage.setItem('theme', n)
      updateIcon(n)
      const m = document.getElementById('meta-theme-color')
      if (m) m.content = n === 'dark' ? '#0f0f0e' : '#f9f8f6'
    }
    window.toggleTheme = toggleTheme
    function updateIcon(t) {
      const i = document.getElementById('studioThemeIcon')
      if (!i) return
      i.innerHTML = t === 'dark'
        ? '<path d="M15 10.5A7 7 0 016.5 3a7 7 0 100 12 7 7 0 008.5-4.5z"/>'
        : '<circle cx="9" cy="9" r="3.5"/><path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.22 3.22l1.42 1.42M13.36 13.36l1.42 1.42M13.36 4.64l1.42-1.42M3.22 14.78l1.42-1.42"/>'
    }

    const saved = document.documentElement.getAttribute('data-theme') || 'light'
    updateIcon(saved)
  </script>
</Layout>
