---
export const prerender = false;
import Layout from '../../components/Layout.astro';
import PostComposer from '../../components/updates/PostComposer.astro';
import CommentThread from '../../components/CommentThread.astro';
import { getSupabaseAdmin, createSupabaseServerClientFromContext } from '../../utils/database';
import { IMAGE_EMOTE_MAP, IMAGE_EMOTES } from '../../utils/reactions';
import { setPageCacheHeaders } from '../../utils/cache';
import { getPageUser } from '../../utils/pageAuth';
import type { CommentData } from '../../utils/comments';

const { id } = Astro.params;

const serverClient = createSupabaseServerClientFromContext(Astro);
const user = await getPageUser(Astro, serverClient);
const isLoggedIn = !!user;

const db = getSupabaseAdmin() as any;

const { data: post } = await db
  .from('forum_posts')
  .select('id, title, body, category, pinned, is_locked, created_at, updated_at, profiles ( id, username, avatar_url )')
  .eq('id', id)
  .maybeSingle();

let currentProfile: { id: string; username: string; avatar_url: string | null } | null = null;
let isAdmin = false;
if (user) {
  const { data: cp } = await db.from('profiles').select('id, username, avatar_url').eq('auth_user_id', user.id).single();
  currentProfile = cp ?? null;
  if (cp) {
    const { data: adminRow } = await db.from('site_admins').select('profile_id').eq('profile_id', cp.id).maybeSingle();
    isAdmin = !!adminRow;
  }
}

// Votes + reactions
const [votesRes, reactionsRes, myVoteRes] = await Promise.all([
  db.from('forum_post_votes').select('vote').eq('post_id', id),
  db.from('forum_post_reactions').select('reaction_type, profile_id').eq('post_id', id),
  currentProfile
    ? db.from('forum_post_votes').select('vote').eq('post_id', id).eq('profile_id', currentProfile.id).maybeSingle()
    : Promise.resolve({ data: null }),
]);

const votes = votesRes.data ?? [];
const upVotes   = votes.filter((v: any) => v.vote === 1).length;
const downVotes = votes.filter((v: any) => v.vote === -1).length;
const myVote    = (myVoteRes.data as any)?.vote ?? 0;

const reactions = reactionsRes.data ?? [];
const reactionCountMap: Record<string, { count: number; active: boolean }> = {};
for (const r of reactions as any[]) {
  if (!reactionCountMap[r.reaction_type]) reactionCountMap[r.reaction_type] = { count: 0, active: false };
  reactionCountMap[r.reaction_type].count++;
  if (currentProfile && r.profile_id === currentProfile.id) reactionCountMap[r.reaction_type].active = true;
}
const displayReactions = Object.entries(reactionCountMap).map(([type, info]) => ({
  type,
  isImage: !!IMAGE_EMOTE_MAP[type],
  path: IMAGE_EMOTE_MAP[type] ?? null,
  count: info.count,
  active: info.active,
}));

if (!post) return Astro.redirect('/404');

const { data: commentsRaw } = await db
  .from('forum_comments')
  .select('id, body, created_at, parent_id, profiles ( id, username, avatar_url )')
  .eq('post_id', id)
  .order('created_at', { ascending: true });
const allComments = commentsRaw ?? [];

// Flatten to a 2-level thread: every comment is grouped under its top-level
// ancestor, so a reply-to-a-reply still shows in the right conversation.
const byId: Record<string, any> = {};
for (const c of allComments) byId[c.id] = c;
function topAncestor(c: any): any {
  let cur = c;
  while (cur.parent_id && byId[cur.parent_id]) cur = byId[cur.parent_id];
  return cur;
}
const topLevel = allComments.filter((c: any) => !c.parent_id);
const repliesByTop: Record<string, any[]> = {};
for (const c of allComments) {
  if (!c.parent_id) continue;
  const anc = topAncestor(c);
  if (anc.id === c.id) continue;
  (repliesByTop[anc.id] ||= []).push(c);
}

function esc(text: string): string {
  return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
function renderBody(text: string): string {
  const escaped = esc(text);
  const withMentions = escaped.replace(/(^|\s)(@([\w]+))/g, '$1<a class="mention" href="/reviewers/$3">$2</a>');
  return withMentions
    .replace(/:([A-Za-z0-9_]+):/g, (_m, key) => {
      const path = IMAGE_EMOTE_MAP[key];
      return path ? `<img src="${path}" class="comment-emote" alt=":${key}:" title=":${key}:">` : `:${key}:`;
    })
    .replace(/\n/g, '<br>');
}

// New posts are stored as HTML from Tiptap. Detect by looking for block-level tags.
// Legacy plain-text posts fall back to the escaped renderer above.
function renderPostBody(body: string): string {
  if (/<(p|h[1-6]|ul|ol|li|img|figure|blockquote|iframe|div)[\s>/]/i.test(body)) {
    return body; // Already HTML — render as-is
  }
  return renderBody(body); // Legacy plain text
}
function fmtDate(s: string): string {
  return new Date(s).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

const commentCount = allComments.length;

// Shape forum_comments rows into CommentData[] for the shared CommentThread.
// Forum comments currently have no votes / reactions / edit API — props on
// the component below gate the UI, and the shared script's routes already
// return no-op URLs for the actions we don't support here.
const threadComments: CommentData[] = topLevel.map((c: any) => ({
  id: c.id,
  author: {
    id: c.profiles?.id ?? '',
    username: c.profiles?.username ?? 'unknown',
    avatarUrl: c.profiles?.avatar_url ?? null,
  },
  body: c.body,
  createdAt: c.created_at,
  upvotes: 0,
  canEdit: false,
  canDelete: isAdmin || (!!currentProfile && c.profiles?.id === currentProfile.id),
  canReport: false,
  replies: (repliesByTop[c.id] ?? []).map((r: any) => ({
    id: r.id,
    author: {
      id: r.profiles?.id ?? '',
      username: r.profiles?.username ?? 'unknown',
      avatarUrl: r.profiles?.avatar_url ?? null,
    },
    body: r.body,
    createdAt: r.created_at,
    upvotes: 0,
    canDelete: isAdmin || (!!currentProfile && r.profiles?.id === currentProfile.id),
  })),
}));

// Only the post's author can edit it, and only while they're a site_admin
// (the update API enforces the same: requireAdmin + profile_id match).
const canEdit = isAdmin && !!currentProfile && post.profiles?.id === currentProfile.id;

setPageCacheHeaders(Astro.response.headers, isLoggedIn, 120);
---

<Layout title={`${post.title} — Updates — Chekpoint`} description={post.body.replace(/\s+/g, ' ').trim().slice(0, 160)} isLoggedIn={isLoggedIn} currentProfile={currentProfile} activeNav="updates" variant="two-col">
  <main class="feed">
    <a class="back" href="/updates">← Updates</a>

    <article class="post" data-post-id={post.id}>
      <div class="post-meta">
        {post.pinned && <span class="badge pinned">📌 Pinned</span>}
        <span class="badge category">{post.category}</span>
        {post.is_locked && <span class="badge locked" id="lock-badge">🔒 Locked</span>}
      </div>
      <h1 class="post-title" data-edit-hide>{post.title}</h1>
      <div class="post-byline">
        <span>{post.profiles?.username ?? 'Chekpoint'}</span>
        <span>·</span>
        <span>{fmtDate(post.created_at)}</span>
        {post.updated_at && <span class="edited">(edited)</span>}
      </div>
      <div class="post-body" data-edit-hide set:html={renderPostBody(post.body)} />
      {canEdit && <PostComposer mode="edit" postId={post.id} title={post.title} body={post.body} />}

      <!-- Vote + reaction bar -->
      <div class="post-interact" data-post-id={post.id}>
        <button
          class={`pv-btn${myVote === 1 ? ' pv-up-active' : ''}`}
          data-post-id={post.id} data-vote="1"
          data-logged-in={isLoggedIn ? 'true' : 'false'}
        >▲ {upVotes}</button>
        <button
          class={`pv-btn${myVote === -1 ? ' pv-down-active' : ''}`}
          data-post-id={post.id} data-vote="-1"
          data-logged-in={isLoggedIn ? 'true' : 'false'}
        >▼ {downVotes}</button>

        <span class="pv-sep"></span>

        <div class="pv-reaction-wrap" data-post-id={post.id}>
          {displayReactions.map(r => (
            <button
              class={`pv-reaction-btn${r.active ? ' pv-reaction-active' : ''}`}
              data-post-id={post.id}
              data-reaction={r.type}
              data-reacted={r.active ? 'true' : 'false'}
              data-count={r.count}
              data-logged-in={isLoggedIn ? 'true' : 'false'}
              data-is-image={r.isImage ? 'true' : 'false'}
            >
              {r.isImage
                ? <><img src={r.path!} class="pv-emote-img" alt={r.type} loading="lazy" /> {r.count}</>
                : <>{r.type} {r.count}</>
              }
            </button>
          ))}
          <button class="pv-react-toggle" data-post-id={post.id} data-logged-in={isLoggedIn ? 'true' : 'false'} title="React">+</button>
        </div>
      </div>

      {isAdmin && (
        <div class="admin-bar">
          {canEdit && <button id="post-edit-open">Edit post</button>}
          <button data-action="toggle-lock">{post.is_locked ? 'Unlock comments' : 'Lock comments'}</button>
          <button data-action="toggle-pin">{post.pinned ? 'Unpin' : 'Pin'}</button>
          <button data-action="delete-post" class="danger">Delete post</button>
        </div>
      )}
    </article>

    <section class="comments" id="forum-comments">
      <h2 class="comments-title">
        Comments
        {commentCount > 0 && <span class="comments-count">{commentCount}</span>}
      </h2>

      {post.is_locked && (
        <p class="locked-note">🔒 Commenting is closed on this post.</p>
      )}

      <CommentThread
        comments={threadComments}
        currentUser={currentProfile ? { id: currentProfile.id, username: currentProfile.username, avatarUrl: currentProfile.avatar_url } : null}
        target={{ type: 'forum_post_comment', id: post.id }}
        canCompose={!post.is_locked && isLoggedIn}
        showVotes={false}
        showReactions={false}
        maxLength={2000}
        isModerator={isAdmin}
        signinReturnTo={Astro.url.pathname + Astro.url.search}
      />
    </section>
  </main>
</Layout>

<script is:inline define:vars={{ postId: post.id }}>
  // Comments are rendered by the shared CommentThread component and handled by
  // src/scripts/comment-thread.ts. This small block only covers admin actions
  // on the post itself (delete, toggle lock, toggle pin).
  (function () {
    function post(url, payload) {
      return fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      }).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); });
    }
    document.addEventListener('click', function (e) {
      var t = e.target;
      if (!t || t.tagName !== 'BUTTON') return;
      var action = t.getAttribute('data-action');

      if (action === 'delete-post') {
        if (!confirm('Delete this post and all its comments?')) return;
        post('/api/forum/posts/delete', { post_id: postId }).then(function (res) {
          if (res.ok) window.location.href = '/updates';
          else alert((res.d && res.d.error) || 'Failed to delete.');
        });
        return;
      }

      if (action === 'toggle-lock' || action === 'toggle-pin') {
        var field = action === 'toggle-lock' ? 'is_locked' : 'pinned';
        var makeTrue = action === 'toggle-lock' ? t.textContent.indexOf('Lock ') === 0 : t.textContent === 'Pin';
        var payload = { post_id: postId }; payload[field] = makeTrue;
        t.disabled = true;
        post('/api/forum/posts/update', payload).then(function (res) {
          if (res.ok) window.location.reload();
          else { alert((res.d && res.d.error) || 'Failed.'); t.disabled = false; }
        });
        return;
      }
    });
  })();
</script>

<script is:inline define:vars={{ _pvImageEmotes: IMAGE_EMOTES, _pvImageEmoteMap: IMAGE_EMOTE_MAP }}>
if (!window.__pvInit) {
  window.__pvInit = true;

  // ── Emoji picker ─────────────────────────────────────────────────────────
  var picker = document.createElement('div');
  picker.id = 'pv-emoji-picker';
  picker.style.cssText = 'display:none;position:fixed;z-index:1000';
  var ph = '<input type="text" id="pv-emote-search" class="pv-emote-search" placeholder="Search emotes…" autocomplete="off">';
  ph += '<div class="pv-emoji-grid" id="pv-emote-grid">';
  _pvImageEmotes.forEach(function(e) {
    ph += '<button class="pv-emoji-pick" data-emoji="' + e.key + '" title="' + e.key + '"><img data-src="' + e.path + '" class="pv-emote-picker-img" alt="' + e.key + '"></button>';
  });
  ph += '</div>';
  picker.innerHTML = ph;
  document.body.appendChild(picker);

  // Bandwidth: data-src withheld until picker opens. Uses IntersectionObserver
  // with root=picker (the scrollable container) so only the visible section of
  // the grid loads initially. rootMargin pre-fetches 80px ahead to prevent
  // blank images while scrolling. Unlike loading="lazy" (viewport-based),
  // this correctly tracks intersection within the picker's own scroll area.
  var pvObserver = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        var img = entry.target;
        if (img.dataset.src) { img.src = img.dataset.src; img.removeAttribute('data-src'); }
        pvObserver.unobserve(img);
      }
    });
  }, { root: picker, rootMargin: '80px 0px', threshold: 0 });
  picker.querySelectorAll('.pv-emote-picker-img').forEach(function(im) { pvObserver.observe(im); });

  document.getElementById('pv-emote-search').addEventListener('input', function() {
    var q = this.value.toLowerCase();
    document.querySelectorAll('#pv-emote-grid .pv-emoji-pick').forEach(function(btn) {
      btn.style.display = btn.dataset.emoji.toLowerCase().includes(q) ? '' : 'none';
    });
  });

  function closePvPicker() {
    picker.style.display = 'none';
    var s = document.getElementById('pv-emote-search'); if (s) { s.value = ''; document.querySelectorAll('#pv-emote-grid .pv-emoji-pick').forEach(function(b){b.style.display='';}); }
  }

  function applyReaction(postId, type, reacted, count) {
    var isImg = !!_pvImageEmoteMap[type];
    var updated = false;
    document.querySelectorAll('.pv-reaction-btn[data-post-id="' + postId + '"][data-reaction="' + type + '"]').forEach(function(btn) {
      btn.dataset.reacted = reacted ? 'true' : 'false';
      btn.dataset.count = String(count);
      btn.innerHTML = isImg ? '<img src="' + _pvImageEmoteMap[type] + '" class="pv-emote-img" alt="' + type + '"> ' + count : type + ' ' + count;
      btn.classList.toggle('pv-reaction-active', reacted);
      btn.style.display = count > 0 ? '' : 'none';
      updated = true;
    });
    if (!updated && count > 0) {
      var wrap = document.querySelector('.pv-reaction-wrap[data-post-id="' + postId + '"]');
      if (wrap) {
        var toggle = wrap.querySelector('.pv-react-toggle');
        var nb = document.createElement('button');
        nb.className = 'pv-reaction-btn' + (reacted ? ' pv-reaction-active' : '');
        nb.dataset.postId = postId; nb.dataset.reaction = type;
        nb.dataset.reacted = reacted ? 'true' : 'false'; nb.dataset.count = String(count);
        nb.dataset.loggedIn = 'true'; nb.dataset.isImage = isImg ? 'true' : 'false';
        nb.innerHTML = isImg ? '<img src="' + _pvImageEmoteMap[type] + '" class="pv-emote-img" alt="' + type + '"> ' + count : type + ' ' + count;
        wrap.insertBefore(nb, toggle);
      }
    }
  }

  function paintPostVote(postId, my, up, down) {
    document.querySelectorAll('.pv-btn[data-post-id="' + postId + '"]').forEach(function(b) {
      var bv = parseInt(b.dataset.vote);
      b.textContent = (bv === 1 ? '▲ ' : '▼ ') + (bv === 1 ? up : down);
      b.classList.toggle('pv-up-active',   bv === 1  && my === 1);
      b.classList.toggle('pv-down-active', bv === -1 && my === -1);
    });
  }

  document.addEventListener('click', async function(e) {
    // Vote button — optimistic: repaint immediately, reconcile with the
    // server's authoritative counts, revert on failure.
    var voteBtn = e.target.closest('.pv-btn');
    if (voteBtn) {
      var loggedIn = voteBtn.dataset.loggedIn === 'true';
      if (!loggedIn) { window.location.href = '/signin'; return; }
      var postId = voteBtn.dataset.postId;
      var vote = parseInt(voteBtn.dataset.vote);
      var sel = '.pv-btn[data-post-id="' + postId + '"]';
      var upBtn = document.querySelector(sel + '[data-vote="1"]');
      var downBtn = document.querySelector(sel + '[data-vote="-1"]');
      var num = function(el) { return el ? (parseInt((el.textContent.match(/\d+/) || ['0'])[0]) || 0) : 0; };
      var prevUp = num(upBtn), prevDown = num(downBtn);
      var prevMy = upBtn && upBtn.classList.contains('pv-up-active') ? 1
                 : downBtn && downBtn.classList.contains('pv-down-active') ? -1 : 0;

      var nextMy = prevMy === vote ? 0 : vote;
      var up = prevUp, down = prevDown;
      if (prevMy === 1) up = Math.max(0, up - 1);
      if (prevMy === -1) down = Math.max(0, down - 1);
      if (nextMy === 1) up += 1;
      if (nextMy === -1) down += 1;
      paintPostVote(postId, nextMy, up, down);

      fetch('/api/forum/posts/vote', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ post_id: postId, vote }) })
        .then(function(res) {
          if (res.status === 401) { window.location.href = '/signin'; return null; }
          if (!res.ok) { paintPostVote(postId, prevMy, prevUp, prevDown); return null; }
          return res.json();
        })
        .then(function(data) {
          if (!data) return;
          paintPostVote(postId, data.vote || 0, data.up, data.down);
        })
        .catch(function() { paintPostVote(postId, prevMy, prevUp, prevDown); });
      return;
    }

    // Inline reaction button
    var rxBtn = e.target.closest('.pv-reaction-btn');
    if (rxBtn) {
      if (rxBtn.dataset.loggedIn !== 'true') { window.location.href = '/signin'; return; }
      var postId = rxBtn.dataset.postId, type = rxBtn.dataset.reaction;
      var reacted = rxBtn.dataset.reacted === 'true', count = parseInt(rxBtn.dataset.count) || 0;
      applyReaction(postId, type, !reacted, reacted ? Math.max(0, count - 1) : count + 1);
      fetch('/api/forum/posts/react', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ post_id: postId, reaction_type: type }) })
        .then(function(r) { return r.json(); })
        .then(function(d) { if (d) applyReaction(postId, type, d.reacted, d.count); })
        .catch(function() { applyReaction(postId, type, reacted, count); });
      return;
    }

    // React toggle (+)
    var toggle = e.target.closest('.pv-react-toggle');
    if (toggle) {
      if (toggle.dataset.loggedIn !== 'true') { window.location.href = '/signin'; return; }
      var postId = toggle.dataset.postId;
      var isOpen = picker.style.display !== 'none' && picker.dataset.activePostId === postId;
      closePvPicker();
      if (!isOpen) {
        picker.dataset.activePostId = postId;
        picker.style.display = 'block';
        requestAnimationFrame(function() {
          var rect = toggle.getBoundingClientRect(), pRect = picker.getBoundingClientRect();
          var top = rect.top - pRect.height - 8; if (top < 8) top = rect.bottom + 8;
          var left = rect.left; if (left + pRect.width > window.innerWidth - 8) left = window.innerWidth - pRect.width - 8;
          picker.style.top = top + 'px'; picker.style.left = left + 'px';
        });
      }
      return;
    }

    // Pick emoji
    var emojiBtn = e.target.closest('.pv-emoji-pick');
    if (emojiBtn) {
      var postId = picker.dataset.activePostId; if (!postId) return;
      var emoji = emojiBtn.dataset.emoji;
      var existing = document.querySelector('.pv-reaction-btn[data-post-id="' + postId + '"][data-reaction="' + emoji + '"]');
      var reacted = existing ? existing.dataset.reacted === 'true' : false;
      var count = existing ? (parseInt(existing.dataset.count) || 0) : 0;
      applyReaction(postId, emoji, !reacted, reacted ? Math.max(0, count - 1) : count + 1);
      closePvPicker();
      fetch('/api/forum/posts/react', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ post_id: postId, reaction_type: emoji }) })
        .then(function(r) { return r.json(); })
        .then(function(d) { if (d) applyReaction(postId, emoji, d.reacted, d.count); })
        .catch(function() { applyReaction(postId, emoji, reacted, count); });
      return;
    }

    if (!e.target.closest('.pv-reaction-wrap') && !e.target.closest('#pv-emoji-picker')) closePvPicker();
  });
}
</script>

<style>
  .feed { min-width: 0; padding: 20px; max-width: 720px; }
  .back { display: inline-block; font-size: 13px; color: var(--text-tertiary); margin-bottom: 16px; }
  .back:hover { color: var(--text-primary); }

  .post { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; padding: 24px; }
  .post-meta { display: flex; gap: 6px; margin-bottom: 12px; flex-wrap: wrap; }
  .badge { font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 999px; text-transform: capitalize; }
  .badge.category { background: var(--bg-hover); color: var(--text-secondary); }
  .badge.pinned { background: color-mix(in srgb, var(--accent) 18%, transparent); color: var(--accent); }
  .badge.locked { background: var(--bg-hover); color: var(--text-tertiary); }
  .post-title { font-family: 'DM Serif Display', serif; font-size: 28px; font-weight: 400; color: var(--text-primary); margin: 0 0 8px; }
  .post-byline { display: flex; gap: 8px; font-size: 13px; color: var(--text-tertiary); margin-bottom: 16px; }
  .post-body { font-size: 15px; color: var(--text-primary); line-height: 1.75; }
  .post-body :global(.mention) { color: var(--accent); }
  .post-body :global(h2) { font-size: 22px; font-weight: 700; margin: 24px 0 10px; color: var(--text-primary); }
  .post-body :global(h3) { font-size: 18px; font-weight: 600; margin: 20px 0 8px; color: var(--text-primary); }
  .post-body :global(p)  { margin: 0 0 12px; }
  .post-body :global(ul), .post-body :global(ol) { padding-left: 24px; margin: 0 0 12px; }
  .post-body :global(li) { margin-bottom: 4px; }
  .post-body :global(blockquote) {
    border-left: 3px solid var(--accent); margin: 0 0 12px;
    padding: 4px 14px; color: var(--text-secondary); font-style: italic;
  }
  .post-body :global(img) { max-width: 100%; border-radius: 10px; display: block; margin: 14px 0; }
  .post-body :global(iframe) { width: 100%; aspect-ratio: 16/9; border-radius: 10px; border: none; display: block; margin: 14px 0; }
  .post-body :global(div[data-youtube-video]) { margin: 14px 0; }
  .post-body :global(div[data-youtube-video] iframe) { width: 100%; aspect-ratio: 16/9; border-radius: 10px; border: none; }
  .post-body :global(.comment-emote) { height: 20px; vertical-align: middle; }

  /* ── Vote + reaction bar ── */
  .post-interact { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin: 18px 0 0; padding-top: 16px; border-top: 1px solid var(--border-subtle, var(--border)); }
