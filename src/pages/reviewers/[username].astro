  </div>

  <!-- ── LIBRARY TAB ── -->
  <div class={`tab-panel ${activeTab === 'library' ? 'active' : ''}`} data-tab="library">

    {/* Steam CTA / sync bar */}
    {isOwnProfile && (
      <>
        {!reviewer.steam_id ? (
          <div class="steam-cta">
            <div class="steam-cta-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.297-.254-1.9-.049l1.522.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.031zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.252 0-2.265-1.014-2.265-2.265z"/></svg>
            </div>
            <div class="steam-cta-body">
              <div class="steam-cta-title">Import your Steam library</div>
              <div class="steam-cta-desc">Connect Steam to automatically add your owned games and playtime.</div>
            </div>
            <a href={`/api/auth/steam-connect?from=${encodeURIComponent(`/reviewers/${reviewer.username}?tab=library`)}`} class="steam-cta-btn">Connect Steam</a>
          </div>
        ) : (
          <div class="steam-sync-bar">
            <span class="steam-sync-info">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="color:#60a5fa;flex-shrink:0"><path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.297-.254-1.9-.049l1.522.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.031zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.252 0-2.265-1.014-2.265-2.265z"/></svg>
              {reviewer.steam_username ? `Connected as ${reviewer.steam_username}` : 'Steam connected'}
              {reviewer.steam_synced_at && (
                <span style="color:var(--text-tertiary)"> · Last synced {timeAgo(reviewer.steam_synced_at)}</span>
              )}
            </span>
            <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-tertiary);cursor:pointer;white-space:nowrap">
              <input type="checkbox" id="profilePlayedOnly" style="accent-color:var(--accent)">
              Played only
            </label>
            <button class="steam-sync-btn" id="profileSyncBtn" data-username={reviewer.username} onclick="profileSteamSync()">Sync now</button>
          </div>
        )}
      </>
    )}
    <div id="profileSyncStatus" class="steam-sync-status" style="display:none"></div>

    {libraryIsPrivate && (
      <div class="empty-state" style="margin-top:16px">
        <div class="empty-title">Library is private</div>
        <p style="font-size:14px;color:var(--text-tertiary)">@{reviewer.username} has set their library to private.</p>
      </div>
    )}

    {/* Library controls — search, sort, edit (rendered by JS from libraryJson) */}
    <div id="libControls" style="display:none">
      <div class="lib-controls-row">
        <input id="libSearch" class="lib-search" type="search" placeholder="Search by title or genre…" autocomplete="off" />
        <select id="libSort" class="lib-sort">
          <option value="alpha">A – Z</option>
          <option value="recent">Recently added</option>
          <option value="review">Has review first</option>
          <option value="hours">Most hours played</option>
        </select>
        {isOwnProfile && (
          <button id="libGearBtn" class="lib-gear-btn" title="Library settings" onclick="toggleLibGear()">
            <svg width="15" height="15" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="9" r="2.5"/>
              <path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.22 3.22l1.42 1.42M13.36 13.36l1.42 1.42M13.36 4.64l1.42-1.42M3.22 14.78l1.42-1.42"/>
            </svg>
          </button>
        )}
        {isOwnProfile && (
          <button id="libEditBtn" class="lib-edit-btn" onclick="toggleLibEdit()">Edit library</button>
        )}
      </div>
      <div class="lib-filter-row" id="libFilterRow"></div>
    </div>

    {isOwnProfile && (
      <div class="lib-gear-panel" id="libGearPanel">
        <div class="lib-gear-tabs">
          <button class="lib-gear-tab active" data-tab="settings" onclick="switchGearTab('settings',this)">Main Settings</button>
          <button class="lib-gear-tab" data-tab="hidden" onclick="switchGearTab('hidden',this)">Hidden Games</button>
        </div>

        {/* ── Main Settings tab ── */}
        <div class="lib-gear-tab-content" id="libGearTabSettings">
          <div class="lib-gear-section">
            <div class="lib-gear-section-title">Library Visibility</div>
            <div class="lib-gear-radio-group" id="libVisibilityGroup">
              <label class="lib-gear-radio">
                <input type="radio" name="libVisibility" value="public" />
                <span class="lib-gear-radio-label"><strong>Public</strong> — anyone can see your library</span>
              </label>
              <label class="lib-gear-radio">
                <input type="radio" name="libVisibility" value="private" />
                <span class="lib-gear-radio-label"><strong>Private</strong> — only you can see your library</span>
              </label>
            </div>
          </div>
          <div class="lib-gear-section">
            <div class="lib-gear-section-title">Hours Played</div>
            <label class="lib-gear-toggle-row" id="libShowHoursRow">
              <span style="font-size:13px;color:var(--text-secondary)">Show hours played on cards</span>
              <button class="lib-gear-toggle" id="libShowHoursBtn" onclick="toggleLibShowHours()"></button>
            </label>
          </div>
          <div class="lib-gear-section" style="margin-bottom:0">
            <div class="lib-gear-section-title">Visible Status Tabs</div>
            <div style="font-size:12px;color:var(--text-tertiary);margin-bottom:8px">Choose which filter tabs are visible to others on your profile.</div>
            <div id="libTabToggles"></div>
          </div>
        </div>

        {/* ── Hidden Games tab ── */}
        <div class="lib-gear-tab-content" id="libGearTabHidden" style="display:none">
          <div class="lib-gear-section">
            <div class="lib-gear-section-title">Hidden Games</div>
            <div id="libHiddenList"></div>
          </div>
          <div class="lib-gear-section" style="margin-bottom:0">
            <div class="lib-gear-section-title">Hide a game</div>
            <input class="lib-hide-search" id="libHideSearch" type="search" placeholder="Search your library…" autocomplete="off" />
            <div class="lib-hide-results" id="libHideResults"></div>
          </div>
        </div>
      </div>
    )}

    {/* Bulk edit action bar */}
    {isOwnProfile && (
      <div id="libEditBar" style="display:none">
        <span id="libEditCount" class="lib-edit-count">0 selected</span>
        <select id="libBulkStatus" class="lib-sort" style="font-size:12px">
          <option value="">Change status…</option>
          <option value="playing">🎮 Playing</option>
          <option value="want_to_play">🔖 Want to Play</option>
          <option value="owned">📦 Owned</option>
          <option value="completed">✓ Completed</option>
          <option value="hundred_percent">💯 100%</option>
          <option value="dropped">✗ Dropped</option>
        </select>
        <button class="lib-bulk-apply" onclick="applyBulkStatus()">Apply</button>
        <button class="lib-bulk-delete" onclick="applyBulkDelete()">Remove</button>
        <button class="lib-edit-cancel" onclick="toggleLibEdit()">Done</button>
      </div>
    )}

    {/* Grid — rendered entirely by JS so sort/search/edit all work off one source of truth */}
    <div id="libEmpty" style="display:none">
      <div class="empty-state">
        <div class="empty-title">{allLibraryItems.length === 0 ? 'No games tracked yet' : 'No games match'}</div>
        <p style="font-size:14px;color:var(--text-tertiary)">
          {allLibraryItems.length === 0
            ? (isOwnProfile
                ? 'Track your games from any game page, or connect Steam above to import your library automatically.'
                : `@${reviewer.username} hasn't tracked any games yet.`)
            : 'Try a different search or filter.'
          }
        </p>
      </div>
    </div>
    <div class="lib-check-row" id="libCheckboxes" style="display:none">
      <label class="lib-check-item" id="libReviewedItem">
        <div class="lib-check-box"></div>
        <span>Reviewed</span>
      </label>
      <label class="lib-check-item" id="libUnreviewedItem">
        <div class="lib-check-box"></div>
        <span>Unreviewed</span>
      </label>
      <label class="lib-check-item" id="libUnplayedItem">
        <div class="lib-check-box"></div>
        <span>Unplayed</span>
      </label>
      {isOwnProfile && (
        <label class="lib-check-item" id="libHiddenItem">
          <div class="lib-check-box"></div>
          <span>Hidden</span>
        </label>
      )}
    </div>
    <div class="lib-grid" id="libGrid"></div>

  </div>

  <!-- ── STATS TAB ── -->
  <div class={`tab-panel ${activeTab === 'stats' ? 'active' : ''}`} data-tab="stats">
    {publishedReviews.length === 0 ? (
      <div class="empty-state">
        <div class="empty-title">No stats yet</div>
        <p style="font-size:14px;color:var(--text-tertiary)">Stats appear once reviews are posted.</p>
      </div>
    ) : (
      <div id="statsContent"></div>
    )}
  </div>

  <!-- ── ACHIEVEMENTS TAB ── -->
  {(showAchievementsTab) && (
  <div class={`tab-panel ${activeTab === 'achievements' ? 'active' : ''}`} data-tab="achievements">

    {/* These render unconditionally so client-side tab switching shows them immediately */}

    {isOwnProfile && !hasSteam && (
      <div class="empty-state">
        <div class="empty-title">Connect your Steam account</div>
        <p style="font-size:14px;color:var(--text-tertiary)">Link your Steam account in settings, then come back to sync your achievements.</p>
        <a href="/settings" class="write-btn-empty" style="display:inline-block;margin-top:16px">Go to Settings</a>
      </div>
    )}

    {isOwnProfile && hasSteam && (
      <div class="ach-sync-bar">
        <div>
          <div class="ach-sync-title">Steam Achievements</div>
          <div class="ach-sync-sub">Import your achievement progress from Steam</div>
        </div>
        <button class="ach-sync-btn" id="achSyncBtn">Sync Achievements</button>
      </div>
    )}

    {/* Data is only rendered on a full load with ?tab=achievements.
        After syncing the JS prompts a reload, so the feed shows correctly. */}
    {activeTab === 'achievements' && (
      <>
        {totalAchievements === 0 && hasSteam && (
          <div class="empty-state">
            <div class="empty-title">No achievements synced yet</div>
            <p style="font-size:14px;color:var(--text-tertiary)">
              {isOwnProfile
                ? 'Click "Sync Achievements" above to import your Steam achievement progress.'
                : `@${reviewer.username} hasn't synced their achievements yet.`}
            </p>
          </div>
        )}

        {totalAchievements > 0 && (
          <>
            {/* Summary bar */}
            <div class="ach-summary">
              <div class="ach-summary-stat">
                <span class="ach-summary-num">{unlockedAchievements.toLocaleString()}</span>
                <span class="ach-summary-label">Unlocked</span>
              </div>
              <div class="ach-summary-stat">
                <span class="ach-summary-num">{avgCompletion.toFixed(1)}%</span>
                <span class="ach-summary-label">Avg Completion</span>
              </div>
              <div class="ach-summary-stat">
                <span class="ach-summary-num">{perfectGames.toLocaleString()}</span>
                <span class="ach-summary-label">Perfect Games</span>
              </div>
            </div>

            {/* Filter bar — navigates via URL so filters + pagination are SSR */}
            <div class="ach-filter-bar">
              <input type="search" id="achSearch" class="ach-search" placeholder="Search achievements…" autocomplete="off" value={achQ} />
              <select id="achSortSelect" class="ach-date-select">
                <option value="recent"    selected={achSort === 'recent'}>Recent</option>
                <option value="oldest"    selected={achSort === 'oldest'}>Oldest</option>
                <option value="rarest"    selected={achSort === 'rarest'}>Rarity: Rarest first</option>
                <option value="least-rare" selected={achSort === 'least-rare'}>Rarity: Common first</option>
                <option value="az"        selected={achSort === 'az'}>A–Z</option>
                <option value="za"        selected={achSort === 'za'}>Z–A</option>
              </select>
              <select id="achDateFilter" class="ach-date-select">
                <option value="0"   selected={achDays === 0}>All time</option>
                <option value="7"   selected={achDays === 7}>Last 7 days</option>
                <option value="30"  selected={achDays === 30}>Last 30 days</option>
                <option value="180" selected={achDays === 180}>Last 6 months</option>
                <option value="365" selected={achDays === 365}>Last year</option>
              </select>
            </div>

            {/* Chronological feed — grouped by date, SSR-rendered */}
            {achByDate.length > 0 ? (
              <div class="ach-feed">
                {achByDate.map(({ label, items }) => (
                  <div class="ach-day">
                    {label && <div class="ach-day-date">{label}</div>}
                    <div class="ach-feed-grid">
                      {items.map((a: any) => {
                        const isRare = a.global_percent != null && a.global_percent < 10;
                        const unlockDate = a.unlock_time
                          ? new Date(a.unlock_time).toLocaleString('en-GB', {
                              day: 'numeric', month: 'short', year: 'numeric',
                              hour: '2-digit', minute: '2-digit', timeZone: 'UTC',
                            })
                          : null;
                        return (
                          <div class={`ach-feed-card${isRare ? ' ach-feed-card--rare' : ''}`}>
                            <div class={`ach-feed-icon-wrap${isRare ? ' ach-feed-icon-wrap--rare' : ''}`}>
                              {a.icon_url
                                ? <img src={a.icon_url} alt={a.display_name ?? ''} class={`ach-feed-icon${isRare ? ' ach-feed-icon--rare' : ''}`} loading="lazy" />
                                : <div class={`ach-feed-icon ach-feed-icon-ph${isRare ? ' ach-feed-icon--rare' : ''}`}>🏆</div>
                              }
                            </div>
                            <div class="ach-feed-info">
                              <div class="ach-feed-name">{a.display_name ?? a.api_name}</div>
                              {a.description && <div class="ach-feed-desc">{a.description}</div>}
                              <div class="ach-feed-game">{a.games?.title ?? `App ${a.steam_appid}`}</div>
                              <div class="ach-feed-footer">
                                {unlockDate && <span class="ach-feed-time">Unlocked on {unlockDate}</span>}
                                {a.global_percent != null && (
                                  <span class={`ach-feed-pct${isRare ? ' ach-feed-pct--rare' : ''}`}>
                                    {a.global_percent.toFixed(1)}% of players
                                  </span>
                                )}
                              </div>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div class="empty-state">
                <div class="empty-title">No achievements match</div>
                <p style="font-size:14px;color:var(--text-tertiary)">Try adjusting your search or filters.</p>
              </div>
            )}

            {/* SSR pagination */}
            {achTotalPages > 1 && (
              <div class="ach-pagination">
                {achPage > 1 && <a href={achUrl(achPage - 1)} class="ach-pag-btn">‹</a>}
                {achPageItems.map(p =>
                  p === '…'
                    ? <span class="ach-pag-dots">…</span>
                    : <a href={achUrl(p as number)} class={`ach-pag-btn${p === achPage ? ' active' : ''}`}>{p}</a>
                )}
                {achPage < achTotalPages && <a href={achUrl(achPage + 1)} class="ach-pag-btn">›</a>}
              </div>
            )}
          </>
        )}
      </>
    )}
  </div>
  )}

  <div class={`tab-panel ${activeTab === 'followers' ? 'active' : ''}`} data-tab="followers">
    {followersList.length === 0 ? (
      <div class="empty-state">
        <div class="empty-title">No followers yet</div>
        <p style="font-size:14px;color:var(--text-tertiary)">When someone follows @{reviewer.username}, they'll appear here.</p>
      </div>
    ) : (
      <div class="follow-grid">
        {followersList.map((u) => (
          <a href={`/reviewers/${u.username}`} class="follow-card">
            {u.avatar_url
              ? <img src={u.avatar_url} alt={u.username} class="follow-avatar" />
              : <div class="follow-avatar follow-avatar-placeholder">{u.username.slice(0,2).toUpperCase()}</div>
            }
            <span class="follow-username">@{u.username}</span>
          </a>
        ))}
      </div>
    )}
  </div>

  <div class={`tab-panel ${activeTab === 'following' ? 'active' : ''}`} data-tab="following">
    {followingList.length === 0 ? (
      <div class="empty-state">
        <div class="empty-title">Not following anyone yet</div>
        <p style="font-size:14px;color:var(--text-tertiary)">When @{reviewer.username} follows someone, they'll appear here.</p>
      </div>
    ) : (
      <div class="follow-grid">
        {followingList.map((u) => (
          <a href={`/reviewers/${u.username}`} class="follow-card">
            {u.avatar_url
              ? <img src={u.avatar_url} alt={u.username} class="follow-avatar" />
              : <div class="follow-avatar follow-avatar-placeholder">{u.username.slice(0,2).toUpperCase()}</div>
            }
            <span class="follow-username">@{u.username}</span>
          </a>
        ))}
      </div>
    )}
  </div>

  <!-- ── LISTS TAB ── -->
  <div class={`tab-panel ${activeTab === 'lists' ? 'active' : ''}`} data-tab="lists">

    <!-- Section switcher (only shown when saved lists exist) -->
    {(savedLists.length > 0 || isOwnProfile) && (
      <div class="sort-tabs" style="margin-bottom: 20px">
        <button class="sort-tab list-filter-tab active" onclick="switchListsSection('my', this)">
          {isOwnProfile ? 'My Lists' : `${reviewer.username}'s Lists`}
        </button>
        <button class="sort-tab list-filter-tab" onclick="switchListsSection('saved', this)">
          Saved {savedLists.length > 0 && <span style="opacity:.6">({savedLists.length})</span>}
        </button>
      </div>
    )}

    <!-- ── MY LISTS SECTION ── -->
    <div id="lists-my-section">
      {profileLists.length === 0 ? (
        <div class="empty-state-tab">
          <div class="empty-title">{isOwnProfile ? "You haven't created any lists yet" : `@${reviewer.username} hasn't created any lists yet`}</div>
          {isOwnProfile && (
            <button class="btn-create-list" onclick="createNewList(this)">+ Create your first list</button>
          )}
        </div>
      ) : (
        <>
          <!-- Filter bar -->
          <div class="lf-bar">
            <input class="lf-search" type="text" placeholder="Search lists…" oninput="searchLists('my',this.value)" />
            <select class="lf-select" onchange="setListSort('my',this.value)">
              <option value="recent">Recent</option>
              <option value="oldest">Oldest</option>
              <option value="az">A–Z</option>
              <option value="most-games">Most Games</option>
              <option value="highest-rated">Highest Rated</option>
              <option value="lowest-rated">Lowest Rated</option>
              <option value="most-hours">Most Hours</option>
            </select>
            {myGenres.length > 0 && (
              <select class="lf-select" onchange="setListFilter('my','genre',this.value,this)">
                <option value="">All Genres</option>
                {myGenres.map((g: string) => <option value={g}>{g}</option>)}
              </select>
            )}
            {myPlatforms.length > 0 && (
              <select class="lf-select" onchange="setListFilter('my','platform',this.value,this)">
                <option value="">All Platforms</option>
                {myPlatforms.map((p: string) => <option value={p}>{p}</option>)}
              </select>
            )}
            {myDevs.length > 0 && (
              <select class="lf-select" onchange="setListFilter('my','dev',this.value,this)">
                <option value="">All Devs</option>
                {myDevs.map((d: string) => <option value={d}>{d}</option>)}
              </select>
            )}
            <label class="lf-checkbox">
              <input type="checkbox" onchange="setListCheckboxFilter('my','ranked',this.checked)" /> Ranked
            </label>
            {isOwnProfile && (
              <label class="lf-checkbox">
                <input type="checkbox" onchange="setListCheckboxFilter('my','private',this.checked)" /> Private
              </label>
            )}
          </div>

          <div class="lists-grid" id="my-lists-grid">
            {profileLists.map((list: any) => (
              <div class="list-card-wrapper"
                data-title={list.title}
                data-updated={list.updated_at}
                data-count={list.entryCount}
                data-genres={(list.genres ?? []).join(',')}
                data-platforms={(list.platforms ?? []).join(',')}
                data-devs={(list.devs ?? []).join(',')}
                data-min-year={list.minYear ?? ''}
                data-avg-score={list.avgScore != null ? list.avgScore.toFixed(2) : ''}
                data-total-hours={list.totalHours ?? 0}
                data-ranked={list.is_ranked ? 'true' : 'false'}
                data-visibility={list.visibility}
              >
                <ListCard
                  id={list.id}
                  title={list.title}
                  isRanked={list.is_ranked}
                  visibility={list.visibility}
                  entryCount={list.entryCount}
                  coverUrls={list.coverUrls}
                  coverImageUrl={list.cover_image_url}
                  showOwner={false}
                  showActions={true}
                  ownerId={reviewer.id}
                  isLoggedIn={!!user}
                  currentProfileId={currentProfile?.id ?? null}
                />
              </div>
            ))}
          </div>
          <div class="list-no-results" id="my-no-results" style="display:none">No lists match these filters.</div>
          {isOwnProfile && (
            <div style="margin-top: 20px">
              <button class="btn-create-list" onclick="createNewList(this)">+ New list</button>
            </div>
          )}
        </>
      )}
    </div>

    <!-- ── SAVED LISTS SECTION ── -->
    <div id="lists-saved-section" style="display: none">
      {savedLists.length === 0 ? (
        <div class="empty-state-tab">
          <div class="empty-title">{isOwnProfile ? "No saved lists yet" : `@${reviewer.username} hasn't saved any public lists yet`}</div>
          {isOwnProfile && <p style="font-size: 13px; color: var(--text-tertiary); margin-top: 8px">Browse public lists and hit "Save list" to bookmark them here</p>}
        </div>
      ) : (
        <>
          <!-- Filter bar + settings button -->
          <div class="lf-bar">
            <input class="lf-search" type="text" placeholder="Search lists…" oninput="searchLists('saved',this.value)" />
            <select class="lf-select" onchange="setListSort('saved',this.value)">
              <option value="recent">Recent</option>
              <option value="oldest">Oldest</option>
              <option value="az">A–Z</option>
              <option value="most-games">Most Games</option>
              <option value="highest-rated">Highest Rated</option>
              <option value="lowest-rated">Lowest Rated</option>
              <option value="most-hours">Most Hours</option>
            </select>
            {savedGenres.length > 0 && (
              <select class="lf-select" onchange="setListFilter('saved','genre',this.value,this)">
                <option value="">All Genres</option>
                {savedGenres.map((g: string) => <option value={g}>{g}</option>)}
              </select>
            )}
            {savedPlatforms.length > 0 && (
              <select class="lf-select" onchange="setListFilter('saved','platform',this.value,this)">
                <option value="">All Platforms</option>
                {savedPlatforms.map((p: string) => <option value={p}>{p}</option>)}
              </select>
            )}
            {savedDevs.length > 0 && (
              <select class="lf-select" onchange="setListFilter('saved','dev',this.value,this)">
                <option value="">All Devs</option>
                {savedDevs.map((d: string) => <option value={d}>{d}</option>)}
              </select>
            )}
            <label class="lf-checkbox">
              <input type="checkbox" onchange="setListCheckboxFilter('saved','ranked',this.checked)" /> Ranked
            </label>
            {isOwnProfile && (
              <label class="lf-checkbox">
                <input type="checkbox" onchange="setListCheckboxFilter('saved','hidden',this.checked)" /> Hidden
              </label>
            )}
            {isOwnProfile && (
              <button id="saved-settings-btn" class="list-settings-btn" style="margin-left:auto" onclick="toggleSavedEditMode(this)" title="Manage saved list visibility">
                ⚙ Manage
              </button>
            )}
          </div>

          <div class="lists-grid" id="saved-lists-grid">
            {savedLists.map((list: any) => (
              <div class={`list-card-wrapper saved-list-wrap${list.isHidden ? ' is-hidden' : ''}`}
                data-title={list.title}
                data-updated={list.updated_at}
                data-count={list.entryCount}
                data-genres={(list.genres ?? []).join(',')}
                data-platforms={(list.platforms ?? []).join(',')}
                data-devs={(list.devs ?? []).join(',')}
                data-min-year={list.minYear ?? ''}
                data-avg-score={list.avgScore != null ? list.avgScore.toFixed(2) : ''}
                data-total-hours={list.totalHours ?? 0}
                data-ranked={list.is_ranked ? 'true' : 'false'}
                data-hidden={list.isHidden ? 'true' : 'false'}
              >
                <ListCard
                  id={list.id}
                  title={list.title}
                  isRanked={list.is_ranked}
                  visibility={list.visibility}
                  entryCount={list.entryCount}
                  coverUrls={list.coverUrls}
                  coverImageUrl={list.cover_image_url}
                  ownerUsername={list.ownerUsername}
                  ownerAvatar={list.ownerAvatar}
                  showOwner={true}
                  showActions={true}
                  ownerId={list.ownerId}
                  isLoggedIn={!!user}
                  currentProfileId={currentProfile?.id ?? null}
                />
                {isOwnProfile && (
                  <button
                    class="saved-hide-btn"
                    data-list-id={list.id}
                    data-hidden={String(list.isHidden)}
                    onclick="toggleSaveHidden(this)"
                    title={list.isHidden ? 'Show on profile' : 'Hide from profile'}
                  >{list.isHidden ? '👁' : '🫥'}</button>
                )}
              </div>
            ))}
          </div>
          <div class="list-no-results" id="saved-no-results" style="display:none">No lists match these filters.</div>
        </>
      )}
    </div>
  </div>

</div>

<!-- GAME PICKER MODAL -->
<div class="modal-backdrop" id="gamePickerModal" onclick="closePickerOnBackdrop(event)">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title" id="pickerTitle">Pick a game</div>
      <button class="modal-close" onclick="closePicker()">×</button>
    </div>
    <div class="modal-search">
      <input
        type="text"
        class="modal-search-input"
        id="pickerSearch"
        placeholder="Search games…"
        oninput="debouncedSearch(this.value)"
        autocomplete="off"
      />
    </div>
    <div class="modal-results" id="pickerResults">
      <div class="modal-empty">Start typing to search games…</div>
    </div>
  </div>
</div>

<!-- ACHIEVEMENT PICKER MODAL -->
<div class="modal-backdrop" id="achPickerModal" onclick="closeAchPickerOnBackdrop(event)">
  <div class="modal ach-picker-modal">
    <div class="modal-header">
      <div class="modal-title">Add to achievement showcase</div>
      <button class="modal-close" onclick="closeAchPicker()">×</button>
    </div>
    <div class="ach-picker-bar">
      <select id="achPickerGame" class="ach-picker-game-sel">
        <option value="">All games</option>
      </select>
      <input type="search" id="achPickerSearch" class="ach-picker-search" placeholder="Search achievements…" autocomplete="off" />
    </div>
    <div class="ach-picker-body" id="achPickerList">
      <div class="modal-empty">Loading…</div>
    </div>
  </div>
</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

</div><!-- /#accentScope -->

<script define:vars={{ distJson, statsJson, activeTab, isOwnProfile: isOwnProfileJson, reviewerUsername: reviewer.username, showcaseJson, showcaseAchievementsJson, achProfileId, libraryJson, libraryIsOwn, librarySettingsJson, socialIconsJson, socialLabelsJson, hasAccentColor }}>

  var s = JSON.parse(statsJson)
  var ownProfile = JSON.parse(isOwnProfile)

  // ── TOAST ──
  function showToast(msg, type) {
    var t = document.getElementById('toast')
    t.textContent = msg
    t.className = 'toast show ' + (type || '')
    clearTimeout(t._timer)
    t._timer = setTimeout(function() { t.className = 'toast' }, 2500)
  }

  // ── EDIT MODE ──
  var _pendingAvatarFile = null
  var _pendingBannerFile = null
  var _pendingBannerPosition = null
  var _origBioValue = ''
  var _origSocialValues = {}
  var _origAccentValue = ''
  var _origAccentCleared = false
  var _hasCustomAccent = hasAccentColor
  var SOCIAL_KEYS = ['twitch_url', 'youtube_url', 'twitter_url', 'discord_url', 'website_url']
  var SOCIAL_ICONS = JSON.parse(socialIconsJson)
  var SOCIAL_LABELS = JSON.parse(socialLabelsJson)

  function defaultAccentColor() {
    return document.documentElement.getAttribute('data-theme') === 'light' ? '#4a3a8a' : '#6050c8'
  }
  function escAttr(s) {
    return String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
  }
  function resetAccentColor() {
    var accentInput = document.getElementById('accentColorInput')
    if (accentInput) { accentInput.value = defaultAccentColor(); accentInput.dataset.cleared = 'true' }
  }
  window.resetAccentColor = resetAccentColor

  function enterEditMode() {
    document.body.classList.add('editing-profile')
    document.getElementById('editModeBar').classList.add('visible')
    document.getElementById('editProfileBtn').style.display = 'none'
    // show bio textarea
    var bioDisplay = document.getElementById('bioDisplay')
    var bioTextarea = document.getElementById('bioTextarea')
    if (bioDisplay) bioDisplay.style.display = 'none'
    if (bioTextarea) {
      _origBioValue = bioTextarea.value
      bioTextarea.style.display = 'block'
      bioTextarea.focus()
    }
    // show social links + accent color edit form
    var socialRow = document.getElementById('socialLinksRow')
    var socialEdit = document.getElementById('socialLinksEdit')
    if (socialRow) socialRow.style.display = 'none'
    if (socialEdit) socialEdit.style.display = 'flex'
    SOCIAL_KEYS.forEach(function(key) {
      var input = document.getElementById('social-' + key)
      if (input) _origSocialValues[key] = input.value
    })
    var accentInput = document.getElementById('accentColorInput')
    if (accentInput) {
      _origAccentValue = accentInput.value
      _origAccentCleared = accentInput.dataset.cleared === 'true'
      if (!_hasCustomAccent) { accentInput.value = defaultAccentColor(); accentInput.dataset.cleared = 'true' }
    }
  }

  function cancelEditMode() {
    document.body.classList.remove('editing-profile')
    document.getElementById('editModeBar').classList.remove('visible')
    document.getElementById('editProfileBtn').style.display = ''
    // restore bio
    var bioDisplay = document.getElementById('bioDisplay')
    var bioTextarea = document.getElementById('bioTextarea')
    if (bioTextarea) { bioTextarea.value = _origBioValue; bioTextarea.style.display = 'none' }
    if (bioDisplay) bioDisplay.style.display = ''
    // restore social links + accent color
    var socialRow = document.getElementById('socialLinksRow')
    var socialEdit = document.getElementById('socialLinksEdit')
    if (socialEdit) socialEdit.style.display = 'none'
    if (socialRow && socialRow.children.length > 0) socialRow.style.display = ''
    SOCIAL_KEYS.forEach(function(key) {
      var input = document.getElementById('social-' + key)
      if (input && key in _origSocialValues) input.value = _origSocialValues[key]
    })
    var accentInput = document.getElementById('accentColorInput')
    if (accentInput) {
      accentInput.value = _origAccentValue
      if (_origAccentCleared) accentInput.dataset.cleared = 'true'; else delete accentInput.dataset.cleared
    }
    // clear pending files
    _pendingAvatarFile = null
    _pendingBannerFile = null
    var avatarInput = document.getElementById('avatarInput')
    var bannerInput = document.getElementById('bannerInput')
    if (avatarInput) avatarInput.value = ''
    if (bannerInput) bannerInput.value = ''
  }
  window.enterEditMode = enterEditMode
  window.cancelEditMode = cancelEditMode

  // color input: any manual pick clears the "reset to default" intent
  var _accentColorInputEl = document.getElementById('accentColorInput')
  if (_accentColorInputEl) {
    _accentColorInputEl.addEventListener('input', function() { delete _accentColorInputEl.dataset.cleared })
  }

  async function saveProfile() {
    var saveBtn = document.getElementById('saveProfileBtn')
    saveBtn.disabled = true
    saveBtn.textContent = 'Saving…'
    var errors = []

    // 1. Upload avatar if pending
    if (_pendingAvatarFile) {
      var form = new FormData()
      form.append('avatar', _pendingAvatarFile)
      try {
        var res = await fetch('/api/profile/avatar', { method: 'POST', body: form })
        if (!res.ok) { var errText = await res.text(); throw new Error('Avatar upload failed: ' + res.status + ' ' + errText) }
        var data = await res.json()
        var img = document.getElementById('avatarImg')
        if (img) { img.src = data.url + '?t=' + Date.now() }
        else {
          var el = document.getElementById('avatarEl')
          if (el) el.innerHTML = '<img id="avatarImg" src="' + data.url + '?t=' + Date.now() + '" alt="" style="width:100%;height:100%;object-fit:cover" />'
        }
      } catch(e) { errors.push('Avatar: ' + (e?.message || 'upload failed')) }
    }

    // 2. Upload banner if pending
    if (_pendingBannerFile) {
      try {
        var presignRes = await fetch('/api/profile/banner-presign', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ fileType: _pendingBannerFile.type, fileSize: _pendingBannerFile.size })
        })
        var presignData = await presignRes.json()
        if (!presignRes.ok) throw new Error(presignData.error || 'Presign failed')
        var uploadForm = new FormData()
        uploadForm.append('cacheControl', '3600')
        uploadForm.append('', _pendingBannerFile)
        var uploadRes = await fetch(presignData.signedUrl, {
          method: 'PUT',
          body: uploadForm,
          headers: { 'x-upsert': 'true' }
        })
        if (!uploadRes.ok) { var errText = await uploadRes.text(); throw new Error('Storage upload failed: ' + uploadRes.status + ' — ' + errText) }
        var saveRes = await fetch('/api/profile/banner-save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ path: presignData.path, banner_position: _pendingBannerPosition || 'center' })
        })
        var bdata = await saveRes.json()
        if (!saveRes.ok) throw new Error(bdata.error || 'Save failed')
        var banner = document.getElementById('profileBanner')
        if (banner) {
          banner.style.backgroundImage = 'url(\'' + bdata.url + '\')'
          banner.style.backgroundSize = 'cover'
          banner.style.backgroundPosition = _pendingBannerPosition || 'center'
          banner.querySelectorAll('.banner-glow,.banner-glow2').forEach(function(el){ el.style.display='none' })
        }
      } catch(e) { errors.push('Banner: ' + (e?.message || 'upload failed')) }
    }

    // 3. Save bio + social links + accent color (one combined request)
    var bioTextarea = document.getElementById('bioTextarea')
    var accentInput = document.getElementById('accentColorInput')
    var accentCleared = accentInput ? accentInput.dataset.cleared === 'true' : false
    var payload = {}
    if (bioTextarea) payload.bio = bioTextarea.value.trim()
    SOCIAL_KEYS.forEach(function(key) {
      var input = document.getElementById('social-' + key)
      if (input) payload[key] = input.value.trim()
    })
    if (accentInput) payload.accent_color = accentCleared ? '' : accentInput.value

    if (Object.keys(payload).length > 0) {
      try {
        var bres2 = await fetch('/api/profile/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })
        var respData = await bres2.json().catch(function() { return {} })
        if (!bres2.ok) throw new Error(respData.error || 'Profile save failed')

        // update bio display
        if (bioTextarea) {
          var bioDisplay = document.getElementById('bioDisplay')
          if (bioDisplay) {
            bioDisplay.textContent = payload.bio
            if (!payload.bio) bioDisplay.innerHTML = '<span style="font-size:14px;color:var(--text-tertiary);font-style:italic">Add a bio…</span>'
          }
        }

        // update social links row
        var socialRow = document.getElementById('socialLinksRow')
        if (socialRow) {
          var pills = ''
          SOCIAL_KEYS.forEach(function(key) {
            var val = payload[key]
            if (!val) return
            pills += '<a href="' + escAttr(val) + '" target="_blank" rel="noopener" class="social-link-pill" data-social-key="' + key + '">' + SOCIAL_ICONS[key] + '<span>' + SOCIAL_LABELS[key] + '</span></a>'
          })
          socialRow.innerHTML = pills
          socialRow.style.display = pills ? '' : 'none'
        }

        // update accent color live, scoped to #accentScope (never the topnav)
        var scope = document.getElementById('accentScope')
        if (accentCleared) {
          if (scope) scope.style.removeProperty('--accent')
          _hasCustomAccent = false
          if (accentInput) accentInput.dataset.cleared = 'true'
        } else {
          if (scope) scope.style.setProperty('--accent', payload.accent_color)
          _hasCustomAccent = true
          if (accentInput) delete accentInput.dataset.cleared
        }
      } catch(e) { errors.push(e && e.message ? e.message : 'Profile save failed') }
    }

    saveBtn.disabled = false
    saveBtn.textContent = 'Save changes'

    if (errors.length) {
      showToast(errors.join(' · '), 'error')
    } else {
      showToast('Profile saved', 'success')
      // exit edit mode
      document.body.classList.remove('editing-profile')
      document.getElementById('editModeBar').classList.remove('visible')
      document.getElementById('editProfileBtn').style.display = ''
      var bioTextarea2 = document.getElementById('bioTextarea')
      var bioDisplay2 = document.getElementById('bioDisplay')
      if (bioTextarea2) bioTextarea2.style.display = 'none'
      if (bioDisplay2) bioDisplay2.style.display = ''
      var socialEdit2 = document.getElementById('socialLinksEdit')
      var socialRow2 = document.getElementById('socialLinksRow')
      if (socialEdit2) socialEdit2.style.display = 'none'
      if (socialRow2 && socialRow2.children.length > 0) socialRow2.style.display = ''
      _pendingAvatarFile = null
      _pendingBannerFile = null
      _pendingBannerPosition = null
    }
  }
  window.saveProfile = saveProfile

  // ── AVATAR — crop, stage, show preview ──
  var avatarInput = document.getElementById('avatarInput')
  if (avatarInput) {
    avatarInput.addEventListener('change', async function() {
      var file = avatarInput.files[0]
      if (!file) return
      if (file.size > 5 * 1024 * 1024) { showToast('Image must be under 5MB', 'error'); avatarInput.value = ''; return }
      var blob
      try {
        blob = await window.openImageCropper(file, { aspectRatio: 1, minWidth: 200, minHeight: 200, title: 'Crop Avatar' })
      } catch(e) { avatarInput.value = ''; return }
      var croppedFile = new File([blob], 'avatar.' + (blob.type === 'image/png' ? 'png' : 'jpg'), { type: blob.type })
      _pendingAvatarFile = croppedFile
      var reader = new FileReader()
      reader.onload = function(ev) {
        var img = document.getElementById('avatarImg')
        if (img) { img.src = ev.target.result }
        else {
          var el = document.getElementById('avatarEl')
          if (el) el.innerHTML = '<img id="avatarImg" src="' + ev.target.result + '" alt="" style="width:100%;height:100%;object-fit:cover" />'
        }
      }
      reader.readAsDataURL(croppedFile)
      showToast('Avatar ready — click Save to apply', 'success')
      avatarInput.value = ''
    })
  }

  // ── BANNER — crop, stage, show preview ──
  var bannerInput = document.getElementById('bannerInput')
  if (bannerInput) {
    bannerInput.addEventListener('change', async function() {
      var file = bannerInput.files[0]
      if (!file) return
      if (file.size > 15 * 1024 * 1024) { showToast('Banner must be under 15MB', 'error'); bannerInput.value = ''; return }
      var uploadFile = file
      var pendingPosition = 'center'
      if (file.type === 'image/gif') {
        var valid = await new Promise(function(res) {
          var img = new Image(), url = URL.createObjectURL(file)
          img.onload = function() { URL.revokeObjectURL(url); res(img.width >= 1200 && img.height >= 300) }
          img.onerror = function() { URL.revokeObjectURL(url); res(false) }
          img.src = url
        })
        if (!valid) { showToast('Banner must be at least 1200 × 300 px', 'error'); bannerInput.value = ''; return }
        var bannerEl2 = document.getElementById('profileBanner')
        var bannerAspect2 = bannerEl2 ? bannerEl2.offsetWidth / bannerEl2.offsetHeight : window.innerWidth / 280
        try {
          pendingPosition = await window.openGifPositioner(file, { aspectRatio: bannerAspect2, title: 'Position GIF' })
        } catch(e) { bannerInput.value = ''; return }
      } else {
        var blob
        try {
          var bannerEl = document.getElementById('profileBanner')
          var bannerAspect = bannerEl ? bannerEl.offsetWidth / bannerEl.offsetHeight : window.innerWidth / 280
          blob = await window.openImageCropper(file, { aspectRatio: bannerAspect, minWidth: 1200, minHeight: 300, title: 'Crop Banner' })
        } catch(e) { bannerInput.value = ''; return }
        uploadFile = new File([blob], 'banner.' + (blob.type === 'image/png' ? 'png' : 'jpg'), { type: blob.type })
      }
      _pendingBannerFile = uploadFile
      _pendingBannerPosition = pendingPosition
      var previewReader = new FileReader()
      previewReader.onload = function(ev) {
        var banner = document.getElementById('profileBanner')
        if (banner) {
          banner.style.backgroundImage = 'url(\'' + ev.target.result + '\')'
          banner.style.backgroundSize = 'cover'
          banner.style.backgroundPosition = pendingPosition
          banner.querySelectorAll('.banner-glow,.banner-glow2').forEach(function(el){ el.style.display='none' })
        }
      }
      previewReader.readAsDataURL(uploadFile)
      showToast('Banner ready — click Save to apply', 'success')
      bannerInput.value = ''
    })
  }

  // ── GAME PICKER MODAL ──


  var _pickerMode = 'favorite'
  var _pickerSlot = 0
  var _searchTimer = null

  function openGamePicker(mode, slot) {
    _pickerMode = mode
    _pickerSlot = slot ?? 0
    document.getElementById('pickerTitle').textContent = mode === 'favorite' ? 'Set favorite game' : 'Add to showcase'
    document.getElementById('pickerSearch').value = ''
    document.getElementById('pickerResults').innerHTML = '<div class="modal-empty">Start typing to search games…</div>'
    document.getElementById('gamePickerModal').classList.add('open')
    setTimeout(function() { document.getElementById('pickerSearch').focus() }, 100)
  }
  function closePicker() { document.getElementById('gamePickerModal').classList.remove('open') }
  function closePickerOnBackdrop(e) { if (e.target === document.getElementById('gamePickerModal')) closePicker() }
  window.openGamePicker = openGamePicker
  window.closePicker = closePicker
  window.closePickerOnBackdrop = closePickerOnBackdrop

  function debouncedSearch(q) {
    clearTimeout(_searchTimer)
    if (!q.trim()) { document.getElementById('pickerResults').innerHTML = '<div class="modal-empty">Start typing to search games…</div>'; return }
    _searchTimer = setTimeout(function() { searchGames(q) }, 300)
  }
  window.debouncedSearch = debouncedSearch

  async function searchGames(q) {
    var resultsEl = document.getElementById('pickerResults')
    resultsEl.innerHTML = '<div class="modal-loading"><div class="spinner" style="width:18px;height:18px;border-width:2px"></div> Searching…</div>'
    try {
      var res = await fetch('/api/games/search?q=' + encodeURIComponent(q) + '&limit=10')
      if (!res.ok) throw new Error()
      var games = await res.json()
      if (!games.length) { resultsEl.innerHTML = '<div class="modal-empty">No games found for "' + q + '"</div>'; return }
      resultsEl.innerHTML = ''
      games.forEach(function(game) {
        var item = document.createElement('div')
        item.className = 'modal-result'
        var coverUrl = game.cover_img_url ? game.cover_img_url.replace(/t_[a-z0-9_]+/, 't_cover_big') : null
        item.innerHTML = '<div class="modal-result-cover">' + (coverUrl ? '<img src="' + coverUrl + '" alt="" />' : '🎮') + '</div>'
          + '<div><div class="modal-result-title">' + game.title + '</div>'
          + '<div class="modal-result-meta">' + (game.date_released ? new Date(game.date_released).getFullYear() : '') + '</div></div>'
        item.onclick = function() { selectGame(game) }
        resultsEl.appendChild(item)
      })
    } catch(e) { resultsEl.innerHTML = '<div class="modal-empty">Search failed — try again</div>' }
  }

  async function selectGame(game) {
    closePicker()
    if (_pickerMode === 'favorite') {
      try {
        var res = await fetch('/api/profile/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ favorite_game_id: game.id })
        })
        if (!res.ok) throw new Error()
        // Update the favorite game card in-place without reloading
        updateFavGameCard(game)
        showToast('Favorite game saved', 'success')
      } catch(e) { showToast('Failed to save — try again', 'error') }
    } else {
      var showcase = currentShowcase.slice()
      while (showcase.length < 3) showcase.push(null)
      showcase[_pickerSlot] = { id: game.id, title: game.title, cover_img_url: game.cover_img_url, slug: game.slug }
      try {
        var sres = await fetch('/api/profile/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ showcase_games: showcase.filter(Boolean) })
        })
        if (!sres.ok) throw new Error()
        currentShowcase = showcase.slice()
        renderShowcase(currentShowcase)
        showToast('Showcase updated', 'success')
      } catch(e) { showToast('Failed to save showcase — try again', 'error') }
    }
  }

  function updateFavGameCard(game) {
