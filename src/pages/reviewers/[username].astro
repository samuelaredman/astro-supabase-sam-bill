<!-- SEARCH VISIBILITY NUDGE — hidden by default; shown by script when not snoozed -->
{showSearchNudge && (
  <div class="search-nudge" id="searchNudge" style="display:none">
    <div class="search-nudge-text">
      <div class="search-nudge-title">🌱 Help us grow Chekpoint</div>
      <div class="search-nudge-sub">Every reviewer who lets us index their posts makes Chekpoint more visible across the internet — more players discovering the site, and more reviews for everyone. Flip on search visibility to let your profile and reviews show up in Google. It's off by default and you can turn it back off anytime in <a href="/settings#search-visibility" style="text-decoration:underline">settings</a>.</div>
    </div>
    <div class="search-nudge-actions">
      <button class="search-nudge-enable" id="searchNudgeEnable">Count me in!</button>
      <button class="search-nudge-dismiss" id="searchNudgeDismiss">Maybe later</button>
    </div>
  </div>
)}

{showSearchNudge && (
  <script is:inline define:vars={{ reviewerId: reviewer.id }}>
    // Search-visibility nudge — snoozed rather than permanently dismissed, so it
    // re-presents the opt-in after a while instead of nagging every visit.
    // Keyed per-profile so one account's snooze/opt-in on a shared browser
    // doesn't suppress the nudge for other accounts viewed there afterward.
    (function() {
      var nudge = document.getElementById('searchNudge');
      if (!nudge) return;
      var SNOOZE_KEY = 'search-nudge-snooze-until:' + reviewerId;
      var SNOOZE_MS = 14 * 24 * 60 * 60 * 1000; // re-present after 14 days
      var DONE_MS = 3650 * 24 * 60 * 60 * 1000;  // effectively permanent once enabled
      var until = parseInt(localStorage.getItem(SNOOZE_KEY) || '0', 10);
      if (until && Date.now() < until) return; // still snoozed — leave hidden
      nudge.style.display = 'flex';
      var enableBtn = document.getElementById('searchNudgeEnable');
      var dismissBtn = document.getElementById('searchNudgeDismiss');
      dismissBtn.addEventListener('click', function() {
        localStorage.setItem(SNOOZE_KEY, String(Date.now() + SNOOZE_MS));
        nudge.style.display = 'none';
      });
      enableBtn.addEventListener('click', async function() {
        enableBtn.disabled = true;
        enableBtn.textContent = 'Enabling…';
        try {
          var res = await fetch('/api/profile/privacy', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ search_indexable: true }),
          });
          if (!res.ok) throw new Error('failed');
          nudge.innerHTML = '<div class="search-nudge-text"><div class="search-nudge-title">🎉 Thank you — you\'re helping us grow!</div><div class="search-nudge-sub">Your profile and reviews can now appear in search engines. It can take a few days for them to show up. You can turn it off anytime in settings.</div></div>';
          localStorage.setItem(SNOOZE_KEY, String(Date.now() + DONE_MS));
        } catch (e) {
          enableBtn.disabled = false;
          enableBtn.textContent = 'Count me in!';
          alert('Something went wrong. Please try again, or use the toggle in Settings.');
        }
      });
    })();
  </script>
)}

