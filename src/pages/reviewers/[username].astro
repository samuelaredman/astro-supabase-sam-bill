---
export const prerender = false;
import { createSupabaseServerClientFromContext, getSupabaseAdmin } from '../../utils/database';
import Layout from '../../components/Layout.astro';
import DetailNav from '../../components/DetailNav.astro';
import { timeAgo, scoreClass, getVoteCounts, igdbImage as igdbCover } from '../../utils/format';
import ReportModal from '../../components/ReportModal.astro';
import EditModal from '../../components/EditModal.astro';
import CropModal from '../../components/CropModal.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import ListCard from '../../components/ListCard.astro';
import ShareButton from '../../components/ShareButton.astro';
import RecommendationFeedCard from '../../components/RecommendationFeedCard.astro';
import RecommendationComposer from '../../components/RecommendationComposer.astro';
import { REC_SELECT, shapeRec } from '../../utils/recommendationsFeed';

const supabase = createSupabaseServerClientFromContext(Astro);
const { username } = Astro.params;
const activeTab = Astro.url.searchParams.get('tab') || 'profile'

const { data: { user } } = await supabase.auth.getUser();

const { data: reviewer, error: reviewerError } = await (supabase as any)
  .from('profiles')
  .select(`
    id, username, avatar_url, bio, banner_url, banner_position, created_at, is_active,
    favorite_game_id, showcase_games, want_to_play_privacy, dropped_privacy, search_indexable,
    steam_id, steam_username, steam_synced_at,
    twitch_url, youtube_url, twitter_url, discord_url, website_url, accent_color,
    favorite_game:games!favorite_game_id (
      id, title, slug, cover_img_url
    ),
    reviews (
      id, score, title, body, published_at, created_at,
      contains_spoilers, play_time_hours, status,
      played_on:platform_played_on ( id, name, slug ),
      games ( id, title, slug, cover_img_url, date_released, game_genres(genres(id, name, slug)) ),
      review_votes ( vote, profile_id ),
      review_reactions( reaction_type, profile_id ),
      review_comments( id )
    )
  `)
  .eq('username', username)
  .single();

if (reviewerError || !reviewer || !reviewer.is_active) {
  if (reviewerError) console.error('[reviewers] query error:', JSON.stringify(reviewerError));
  return Astro.redirect('/404');
}

// Fetch showcase_achievements separately so a missing migration can't 404 the profile
const { data: _showcaseAchData } = await (getSupabaseAdmin() as any)
  .from('profiles')
  .select('showcase_achievements')
  .eq('id', (reviewer as any).id)
  .maybeSingle();
(reviewer as any).showcase_achievements = (_showcaseAchData as any)?.showcase_achievements ?? null;

const publishedReviews = (reviewer.reviews ?? [])
  .filter((r: any) => r.status === 'published')
  .sort((a: any, b: any) =>
    new Date(b.published_at ?? b.created_at).getTime() -
    new Date(a.published_at ?? a.created_at).getTime()
  );

const avgScore = publishedReviews.length > 0
  ? (publishedReviews.reduce((sum: number, r: any) => sum + r.score, 0) / publishedReviews.length).toFixed(1)
  : null;

const totalHours = publishedReviews.reduce((sum: number, r: any) => sum + (r.play_time_hours ?? 0), 0)
const avgHours = publishedReviews.length > 0 ? Math.round(totalHours / publishedReviews.length) : null

// Tally upvotes + downvotes received on reviews
let totalUpvotes = 0, totalDownvotes = 0
for (const r of publishedReviews) {
  const votes = Array.isArray(r.review_votes) ? r.review_votes : r.review_votes ? [r.review_votes] : []
  for (const v of votes as any[]) {
    if (v.vote === 1) totalUpvotes++
    else if (v.vote === -1) totalDownvotes++
  }
}
// Tally votes received on the reviewer's own comments (reviews, lists, recommendations)
const [
  { data: reviewerComments },
  { data: reviewerLists },
  { data: reviewerListComments },
  { data: reviewerRecsForVotes },
  { data: reviewerRecComments },
] = await Promise.all([
  (supabase as any).from('review_comments').select('comment_votes(vote)').eq('profile_id', reviewer.id),
  (supabase as any).from('lists').select('list_votes(vote)').eq('profile_id', reviewer.id),
  (supabase as any).from('list_comments').select('list_comment_votes(vote)').eq('profile_id', reviewer.id),
  (supabase as any).from('recommendations').select('recommendation_votes(vote)').eq('profile_id', reviewer.id),
  (supabase as any).from('recommendation_comments').select('recommendation_comment_votes(vote)').eq('profile_id', reviewer.id),
])
const voteBuckets = [
  ...(reviewerComments ?? []).map((c: any) => c.comment_votes),
  ...(reviewerLists ?? []).map((l: any) => l.list_votes),
  ...(reviewerListComments ?? []).map((c: any) => c.list_comment_votes),
  ...(reviewerRecsForVotes ?? []).map((r: any) => r.recommendation_votes),
  ...(reviewerRecComments ?? []).map((c: any) => c.recommendation_comment_votes),
]
for (const votes of voteBuckets) {
  for (const v of (votes ?? []) as any[]) {
    if (v.vote === 1) totalUpvotes++
    else if (v.vote === -1) totalDownvotes++
  }
}

const memberSince = reviewer.created_at
  ? new Date(reviewer.created_at).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
  : null;

const { count: followerCount } = await (supabase as any)
  .from('follows').select('*', { count: 'exact', head: true }).eq('following_id', reviewer.id);

const { count: followingCount } = await (supabase as any)
  .from('follows').select('*', { count: 'exact', head: true }).eq('follower_id', reviewer.id);

const { data: followersData } = await (supabase as any)
  .from('follows')
  .select('follower:profiles!follower_id(id, username, avatar_url)')
  .eq('following_id', reviewer.id);

const { data: followingData } = await (supabase as any)
  .from('follows')
  .select('following:profiles!following_id(id, username, avatar_url)')
  .eq('follower_id', reviewer.id);

const followersList: Array<{ id: string; username: string; avatar_url: string | null }> =
  (followersData ?? []).map((r: any) => r.follower).filter(Boolean);
const followingList: Array<{ id: string; username: string; avatar_url: string | null }> =
  (followingData ?? []).map((r: any) => r.following).filter(Boolean);

let currentProfile: any = null;
let isFollowing = false;
let isNotifying = false;
let isOwnProfile = false;

if (user) {
  const { data: cp } = await (supabase as any)
    .from('profiles').select('id, username, avatar_url').eq('auth_user_id', user.id).single();
  currentProfile = cp;
  if (currentProfile) {
    isOwnProfile = currentProfile.id === reviewer.id;
    if (!isOwnProfile) {
      const { data: followRow } = await (supabase as any)
        .from('follows').select('id, notify')
        .eq('follower_id', currentProfile.id).eq('following_id', reviewer.id).maybeSingle();
      isFollowing = !!followRow;
      isNotifying = followRow?.notify ?? false;
    }
  }
}

// Contextual nudge: prompt logged-in users who have content but haven't opted
// into search indexing to turn it on. GDPR-clean — separate, specific, opt-in,
// and only shown to someone who actually has content to surface. This is the
// page people actually land on for their own profile (Layout's nav points
// here, not at /profile), so the nudge belongs here rather than there.
const showSearchNudge = isOwnProfile && !reviewer.search_indexable && publishedReviews.length > 0;

// ── LISTS ──
const { data: profileListsRaw } = await (supabase as any)
  .from('lists')
  .select('id, title, is_ranked, visibility, cover_image_url, updated_at')
  .eq('profile_id', reviewer.id)
  .order('updated_at', { ascending: false });

const profileListIds = (profileListsRaw ?? []).map((l: any) => l.id);

const [{ data: coverEntriesRaw }, { data: allEntriesRaw }] = profileListIds.length > 0
  ? await Promise.all([
      (supabase as any)
        .from('list_entries')
        .select('list_id, games(id, cover_img_url, date_released)')
        .in('list_id', profileListIds)
        .order('position', { ascending: true, nullsFirst: false })
        .order('added_at', { ascending: true }),
      (supabase as any)
        .from('list_entries')
        .select('list_id')
        .in('list_id', profileListIds),
    ])
  : [{ data: [] }, { data: [] }];

const coversByListId: Record<string, string[]> = {};
const gameIdsByListId: Record<string, string[]> = {};
const yearsByListId: Record<string, number[]> = {};
for (const e of coverEntriesRaw ?? []) {
  const cover = igdbCover(e.games?.cover_img_url, 't_cover_big');
  if (cover) {
    if (!coversByListId[e.list_id]) coversByListId[e.list_id] = [];
    if (coversByListId[e.list_id].length < 4) coversByListId[e.list_id].push(cover);
  }
  if (e.games?.id) {
    if (!gameIdsByListId[e.list_id]) gameIdsByListId[e.list_id] = [];
    gameIdsByListId[e.list_id].push(e.games.id);
  }
  if (e.games?.date_released) {
    const yr = new Date(e.games.date_released).getFullYear();
    if (!yearsByListId[e.list_id]) yearsByListId[e.list_id] = [];
    yearsByListId[e.list_id].push(yr);
  }
}
const entryCountByListId: Record<string, number> = {};
for (const e of allEntriesRaw ?? []) {
  entryCountByListId[e.list_id] = (entryCountByListId[e.list_id] ?? 0) + 1;
}
let profileLists = (profileListsRaw ?? []).map((l: any) => ({
  ...l,
  coverUrls: coversByListId[l.id] ?? [],
  entryCount: entryCountByListId[l.id] ?? 0,
}));

// ── SAVED LISTS ──
let savedLists: any[] = []
const savedGameIdsByListId: Record<string, string[]> = {};
const savedYearsByListId: Record<string, number[]> = {};
{
  const { data: savedRaw } = await (supabase as any)
    .from('list_saves')
    .select('list_id, is_hidden, lists(id, title, is_ranked, visibility, cover_image_url, updated_at, profiles(id, username, avatar_url))')
    .eq('profile_id', reviewer.id)
    .order('created_at', { ascending: false })

  // Owners see all saves; others only see non-hidden ones
  const rawSavedLists = (savedRaw ?? [])
    .filter((s: any) => s.lists && (isOwnProfile || !s.is_hidden))
    .map((s: any) => ({ ...s.lists, isHidden: s.is_hidden ?? false }))

  if (rawSavedLists.length > 0) {
    const savedListIds = rawSavedLists.map((l: any) => l.id)
    const [{ data: savedCoversRaw }, { data: savedEntriesRaw }] = await Promise.all([
      (supabase as any)
        .from('list_entries')
        .select('list_id, games(id, cover_img_url, date_released)')
        .in('list_id', savedListIds)
        .order('position', { ascending: true, nullsFirst: false })
        .order('added_at', { ascending: true }),
      (supabase as any)
        .from('list_entries')
        .select('list_id')
        .in('list_id', savedListIds),
    ])
    const savedCoversByListId: Record<string, string[]> = {}
    for (const e of savedCoversRaw ?? []) {
      const cover = igdbCover(e.games?.cover_img_url, 't_cover_big')
      if (cover) {
        if (!savedCoversByListId[e.list_id]) savedCoversByListId[e.list_id] = []
        if (savedCoversByListId[e.list_id].length < 4) savedCoversByListId[e.list_id].push(cover)
      }
      if (e.games?.id) {
        if (!savedGameIdsByListId[e.list_id]) savedGameIdsByListId[e.list_id] = [];
        savedGameIdsByListId[e.list_id].push(e.games.id);
      }
      if (e.games?.date_released) {
        const yr = new Date(e.games.date_released).getFullYear();
        if (!savedYearsByListId[e.list_id]) savedYearsByListId[e.list_id] = [];
        savedYearsByListId[e.list_id].push(yr);
      }
    }
    const savedEntryCountByListId: Record<string, number> = {}
    for (const e of savedEntriesRaw ?? []) {
      savedEntryCountByListId[e.list_id] = (savedEntryCountByListId[e.list_id] ?? 0) + 1
    }
    savedLists = rawSavedLists.map((l: any) => ({
      ...l,
      ownerId: l.profiles?.id ?? null,
      ownerUsername: l.profiles?.username,
      ownerAvatar: l.profiles?.avatar_url,
      coverUrls: savedCoversByListId[l.id] ?? [],
      entryCount: savedEntryCountByListId[l.id] ?? 0,
    }))
  }
}

// ── LIST METADATA for genre/platform/dev filters ──
{
  const allGameIds = [...new Set([
    ...Object.values(gameIdsByListId).flat(),
    ...Object.values(savedGameIdsByListId).flat(),
  ])];
  if (allGameIds.length > 0) {
    const [{ data: genreRows }, { data: platformRows }, { data: companyRows }] = await Promise.all([
      (supabase as any).from('game_genres').select('game_id, genres(name)').in('game_id', allGameIds),
      (supabase as any).from('game_platforms').select('game_id, platforms(name)').in('game_id', allGameIds),
      (supabase as any).from('game_companies').select('game_id, role, developers(name)').eq('role', 'developer').in('game_id', allGameIds),
    ]);
    const genresByGameId: Record<string, string[]> = {};
    const platformsByGameId: Record<string, string[]> = {};
    const devsByGameId: Record<string, string[]> = {};
    for (const row of genreRows ?? []) {
      if (row.genres?.name) { if (!genresByGameId[row.game_id]) genresByGameId[row.game_id] = []; genresByGameId[row.game_id].push(row.genres.name); }
    }
    for (const row of platformRows ?? []) {
      if (row.platforms?.name) { if (!platformsByGameId[row.game_id]) platformsByGameId[row.game_id] = []; platformsByGameId[row.game_id].push(row.platforms.name); }
    }
    for (const row of companyRows ?? []) {
      if (row.developers?.name) { if (!devsByGameId[row.game_id]) devsByGameId[row.game_id] = []; devsByGameId[row.game_id].push(row.developers.name); }
    }
    function buildListMeta(listId: string, gids: Record<string, string[]>, yrs: Record<string, number[]>) {
      const ids = gids[listId] ?? [];
      const genres = [...new Set(ids.flatMap((id: string) => genresByGameId[id] ?? []))].sort();
      const platforms = [...new Set(ids.flatMap((id: string) => platformsByGameId[id] ?? []))].sort();
      const devs = [...new Set(ids.flatMap((id: string) => devsByGameId[id] ?? []))].sort();
      const years = yrs[listId] ?? [];
      return { genres, platforms, devs, minYear: years.length ? Math.min(...years) : null, maxYear: years.length ? Math.max(...years) : null };
    }
    profileLists = profileLists.map((l: any) => ({ ...l, ...buildListMeta(l.id, gameIdsByListId, yearsByListId) }));
    savedLists = savedLists.map((l: any) => ({ ...l, ...buildListMeta(l.id, savedGameIdsByListId, savedYearsByListId) }));
  }
}

// Per-list review metrics (avg score + total hours from user's own reviews)
{
  const reviewByGameId: Record<string, { score: number; hours: number }> = {};
  for (const r of publishedReviews) {
    if ((r as any).games?.id) {
      reviewByGameId[(r as any).games.id] = { score: (r as any).score, hours: (r as any).play_time_hours ?? 0 };
    }
  }
  function buildListReviewMeta(gameIds: string[]) {
    const reviews = gameIds.map(id => reviewByGameId[id]).filter(Boolean);
    const avgScore = reviews.length > 0
      ? reviews.reduce((s: number, r: any) => s + r.score, 0) / reviews.length
      : null;
    const totalHours = reviews.reduce((s: number, r: any) => s + r.hours, 0);
    return { avgScore, totalHours };
  }
  profileLists = profileLists.map((l: any) => ({ ...l, ...buildListReviewMeta(gameIdsByListId[l.id] ?? []) }));
  savedLists = savedLists.map((l: any) => ({ ...l, ...buildListReviewMeta(savedGameIdsByListId[l.id] ?? []) }));
}

const myGenres = [...new Set(profileLists.flatMap((l: any) => l.genres ?? []))].sort() as string[];
const myPlatforms = [...new Set(profileLists.flatMap((l: any) => l.platforms ?? []))].sort() as string[];
const myDevs = [...new Set(profileLists.flatMap((l: any) => l.devs ?? []))].sort() as string[];
const savedGenres = [...new Set(savedLists.flatMap((l: any) => l.genres ?? []))].sort() as string[];
const savedPlatforms = [...new Set(savedLists.flatMap((l: any) => l.platforms ?? []))].sort() as string[];
const savedDevs = [...new Set(savedLists.flatMap((l: any) => l.devs ?? []))].sort() as string[];

// favorite game — find reviewer's own review of it
const favGame = reviewer.favorite_game ?? null
const favReview = favGame
  ? publishedReviews.find((r: any) => r.games?.id === favGame.id) ?? null
  : null

// stats
const scoreDistribution = Array.from({ length: 10 }, (_, i) =>
  publishedReviews.filter((r: any) => Math.round(r.score) === i + 1).length
)
const platCounts: Record<string, number> = {}
for (const r of publishedReviews) {
  const name = (r as any).played_on?.name ?? 'Unknown'
  platCounts[name] = (platCounts[name] ?? 0) + 1
}
const platformBreakdown = Object.entries(platCounts)
  .sort((a, b) => b[1] - a[1]).slice(0, 5)
  .map(([name, count]) => ({ name, count, pct: Math.round((count / publishedReviews.length) * 100) }))

const genreCounts: Record<string, number> = {}
for (const r of publishedReviews) {
  const genres = (r as any).games?.game_genres ?? []
  for (const gg of genres) {
    const name = gg.genres?.name
    if (name) genreCounts[name] = (genreCounts[name] ?? 0) + 1
  }
}
const genreBreakdown = Object.entries(genreCounts)
  .sort((a, b) => b[1] - a[1]).slice(0, 6)
  .map(([name, count]) => ({ name, count, pct: Math.round((count / publishedReviews.length) * 100) }))

const monthlyActivity: Record<string, number> = {}
for (const r of publishedReviews) {
  const d = new Date((r as any).published_at ?? (r as any).created_at)
  const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`
  monthlyActivity[key] = (monthlyActivity[key] ?? 0) + 1
}
const monthLabels: string[] = []
const monthCounts: number[] = []
for (let i = 11; i >= 0; i--) {
  const d = new Date()
  d.setMonth(d.getMonth() - i)
  const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`
  monthLabels.push(d.toLocaleDateString('en-US', { month: 'short' }))
  monthCounts.push(monthlyActivity[key] ?? 0)
}

const recommendedCount = publishedReviews.filter((r: any) => r.score >= 7).length
const recommendedRate = publishedReviews.length > 0 ? Math.round((recommendedCount / publishedReviews.length) * 100) : 0

// score delta vs community — fetch avg score for each reviewed game
const reviewedGameIds = [...new Set(publishedReviews.map((r: any) => r.games?.id).filter(Boolean))]
let scoreDelta: number | null = null
if (reviewedGameIds.length > 0) {
  const { data: communityScores } = await (supabase as any)
    .from('reviews')
    .select('game_id, score')
    .in('game_id', reviewedGameIds)
    .eq('status', 'published')

  if (communityScores && communityScores.length > 0) {
    // build game avg map
    const gameScoreMap: Record<string, number[]> = {}
    for (const row of communityScores) {
      if (!gameScoreMap[row.game_id]) gameScoreMap[row.game_id] = []
      gameScoreMap[row.game_id].push(row.score)
    }
    const gameAvgMap: Record<string, number> = {}
    for (const [gid, scores] of Object.entries(gameScoreMap)) {
      gameAvgMap[gid] = (scores as number[]).reduce((a, b) => a + b, 0) / (scores as number[]).length
    }
    // compute delta per review
    const deltas: number[] = []
    for (const r of publishedReviews) {
      const gid = (r as any).games?.id
      if (gid && gameAvgMap[gid] !== undefined) {
        deltas.push((r as any).score - gameAvgMap[gid])
      }
    }
    if (deltas.length > 0) {
      scoreDelta = Math.round((deltas.reduce((a, b) => a + b, 0) / deltas.length) * 10) / 10
    }
  }
}

const recentGames = publishedReviews.slice(0, 6).map((r: any) => r.games).filter(Boolean)

// ── LIBRARY (user_game_status) ──
// Check mutual follow so we can apply 'friends' privacy level
let isMutualFollow = false;
if (currentProfile && !isOwnProfile) {
  const [{ data: fwd }, { data: rev }] = await Promise.all([
    (supabase as any).from('follows').select('id')
      .eq('follower_id', currentProfile.id).eq('following_id', reviewer.id).maybeSingle(),
    (supabase as any).from('follows').select('id')
      .eq('follower_id', reviewer.id).eq('following_id', currentProfile.id).maybeSingle(),
  ]);
  isMutualFollow = !!(fwd && rev);
}

const db = getSupabaseAdmin() as any;

// This reviewer's authored recommendations (rendered most-recent-first; re-sortable client-side)
const { data: reviewerRecsRaw } = await db
  .from('recommendations')
  .select(REC_SELECT)
  .eq('profile_id', reviewer.id)
  .eq('status', 'published')
  .order('created_at', { ascending: false })
  .limit(100);
const reviewerRecs = (reviewerRecsRaw ?? []).map((r: any) => shapeRec(r, currentProfile?.id ?? null));

// Fetch library settings with fallback in case migration hasn't run yet
let libSettingsRow: any = null;
try {
  const { data } = await db
    .from('profiles')
    .select('library_visibility, library_show_hours, library_hidden_tabs')
    .eq('id', reviewer.id)
    .maybeSingle();
  libSettingsRow = data;
} catch (_) { /* columns not yet available, use defaults below */ }

// Fetch library with is_hidden/is_owned; fall back to query without them if columns missing
let libraryData: any[] | null = null;
try {
  const { data, error } = await db
    .from('user_game_status')
    .select('status, is_hidden, is_owned, updated_at, steam_playtime_minutes, games(id, title, slug, cover_img_url, game_genres(genres(name, slug)))')
    .eq('profile_id', reviewer.id)
    .order('updated_at', { ascending: false });
  if (!error) {
    libraryData = data;
  } else {
    const { data: fallback } = await db
      .from('user_game_status')
      .select('status, updated_at, steam_playtime_minutes, games(id, title, slug, cover_img_url, game_genres(genres(name, slug)))')
      .eq('profile_id', reviewer.id)
      .order('updated_at', { ascending: false });
    libraryData = fallback;
  }
} catch (_) {
  libraryData = [];
}

// Which games has this reviewer published a review for?
const { data: reviewedRows } = await db
  .from('reviews')
  .select('game_id')
  .eq('profile_id', reviewer.id)
  .eq('status', 'published');
const reviewedGameIdsSet: Set<string> = new Set((reviewedRows ?? []).map((r: any) => r.game_id));

// Library settings from profile (with defaults for old rows or pre-migration)
const libraryVisibility: string = libSettingsRow?.library_visibility ?? 'public'
const libraryShowHours: boolean = libSettingsRow?.library_show_hours ?? true
const libraryHiddenTabs: string[] = libSettingsRow?.library_hidden_tabs ?? []
const libraryIsPrivate = libraryVisibility === 'private' && !isOwnProfile

// Apply privacy filtering
const canSeeWantToPlay = isOwnProfile
  || !(reviewer.want_to_play_privacy === 'private'
       || (reviewer.want_to_play_privacy === 'friends' && !isMutualFollow));
const canSeeDropped = isOwnProfile
  || !(reviewer.dropped_privacy === 'private'
       || (reviewer.dropped_privacy === 'friends' && !isMutualFollow));

const allLibraryItems = libraryIsPrivate ? [] : (libraryData ?? []).filter((item: any) => {
  if (item.is_hidden && !isOwnProfile) return false;  // hidden games owner-only
  if (item.status === 'want_to_play') return canSeeWantToPlay;
  if (item.status === 'dropped') return canSeeDropped;
  return true;
});

// Group by status for filter pills
const libraryByStatus: Record<string, any[]> = { playing: [], want_to_play: [], owned: [], completed: [], hundred_percent: [], dropped: [] };
for (const item of allLibraryItems) {
  if (libraryByStatus[item.status]) libraryByStatus[item.status].push(item.games);
}

// ── CHART DATA ──
// We reuse communityScores fetched above — build gameAvgMap here for chart use too
const _reviewedGameIds2 = [...new Set(publishedReviews.map((r: any) => r.games?.id).filter(Boolean))]
const _gameAvgMap2: Record<string, number> = {}
const _gameAvgHoursMap2: Record<string, number> = {}
if (_reviewedGameIds2.length > 0) {
  const { data: _cs2 } = await (supabase as any)
    .from('reviews').select('game_id, score, play_time_hours').in('game_id', _reviewedGameIds2).eq('status', 'published')
  if (_cs2) {
    const _m: Record<string, number[]> = {}
    const _mh: Record<string, number[]> = {}
    for (const row of _cs2) {
      if (!_m[row.game_id]) _m[row.game_id] = []
      _m[row.game_id].push(row.score)
      if (row.play_time_hours != null && row.play_time_hours > 0) {
        if (!_mh[row.game_id]) _mh[row.game_id] = []
        _mh[row.game_id].push(row.play_time_hours)
      }
    }
    for (const [gid, sc] of Object.entries(_m)) {
      _gameAvgMap2[gid] = (sc as number[]).reduce((a,b)=>a+b,0) / (sc as number[]).length
    }
    for (const [gid, hrs] of Object.entries(_mh)) {
      _gameAvgHoursMap2[gid] = Math.round((hrs as number[]).reduce((a,b)=>a+b,0) / (hrs as number[]).length)
    }
  }
}

// 1. Games & Hours by Genre
const _genreGameMap: Record<string, { games: number, hours: number }> = {}
for (const r of publishedReviews) {
  const genres = (r as any).games?.game_genres ?? []
  for (const gg of genres) {
    const name = gg.genres?.name; if (!name) continue
    if (!_genreGameMap[name]) _genreGameMap[name] = { games: 0, hours: 0 }
    _genreGameMap[name].games++
    _genreGameMap[name].hours += (r as any).play_time_hours ?? 0
  }
}
const genreActivityData = Object.entries(_genreGameMap)
  .sort((a,b) => b[1].games - a[1].games)
  .map(([name, d]) => ({ name, games: d.games, hours: d.hours }))

// 2. Ratings by Genre (user avg vs community avg)
const _genreUserScores: Record<string, number[]> = {}
const _genreCommScores: Record<string, number[]> = {}
for (const r of publishedReviews) {
  const genres = (r as any).games?.game_genres ?? []
  const gid = (r as any).games?.id
  for (const gg of genres) {
    const name = gg.genres?.name; if (!name) continue
    if (!_genreUserScores[name]) _genreUserScores[name] = []
    _genreUserScores[name].push((r as any).score)
    if (gid && _gameAvgMap2[gid] !== undefined) {
      if (!_genreCommScores[name]) _genreCommScores[name] = []
      _genreCommScores[name].push(_gameAvgMap2[gid])
    }
  }
}
const genreRatingData = Object.entries(_genreUserScores)
  .sort((a,b) => b[1].length - a[1].length)
  .map(([name, scores]) => ({
    name,
    userAvg: Math.round((scores.reduce((a,b)=>a+b,0)/scores.length)*10)/10,
    commAvg: _genreCommScores[name]?.length
      ? Math.round((_genreCommScores[name].reduce((a,b)=>a+b,0)/_genreCommScores[name].length)*10)/10
      : null
  }))

// 3. Ratings by Year (user avg vs community avg)
const _yearUserScores: Record<string, number[]> = {}
const _yearCommScores: Record<string, number[]> = {}
for (const r of publishedReviews) {
  const yr = (r as any).games?.date_released
    ? String(new Date((r as any).games.date_released).getFullYear()) : null
  const gid = (r as any).games?.id
  if (!yr) continue
  if (!_yearUserScores[yr]) _yearUserScores[yr] = []
  _yearUserScores[yr].push((r as any).score)
  if (gid && _gameAvgMap2[gid] !== undefined) {
    if (!_yearCommScores[yr]) _yearCommScores[yr] = []
    _yearCommScores[yr].push(_gameAvgMap2[gid])
  }
}
const yearRatingData = Object.entries(_yearUserScores)
  .sort((a,b) => parseInt(b[0]) - parseInt(a[0])).slice(0, 10)
  .map(([year, scores]) => ({
    year,
    userAvg: Math.round((scores.reduce((a,b)=>a+b,0)/scores.length)*10)/10,
    commAvg: _yearCommScores[year]?.length
      ? Math.round((_yearCommScores[year].reduce((a,b)=>a+b,0)/_yearCommScores[year].length)*10)/10
      : null
  }))

function getInitials(u: string): string { return u.slice(0, 2).toUpperCase() }

const bannerStyle = reviewer.banner_url
  ? `background-image:url('${reviewer.banner_url}');background-size:cover;background-position:${reviewer.banner_position ?? 'center'}`
  : ''

// Scoped to a wrapper below the topnav so a visitor's own site chrome (logo dot)
// never changes color when viewing someone else's profile.
const accentStyle = reviewer.accent_color && /^#[0-9a-f]{6}$/i.test(reviewer.accent_color)
  ? `--accent:${reviewer.accent_color}`
  : undefined

const SOCIAL_PLATFORMS = [
  { key: 'twitch_url', label: 'Twitch' },
  { key: 'youtube_url', label: 'YouTube' },
  { key: 'twitter_url', label: 'Twitter/X' },
  { key: 'discord_url', label: 'Discord' },
  { key: 'website_url', label: 'Website' },
] as const
const socialLinks = SOCIAL_PLATFORMS
  .map(p => ({ ...p, url: reviewer[p.key] as string | null }))
  .filter(p => !!p.url)

// Small generic, self-drawn glyphs (not exact trademarked logos) matching the
// site's existing inline-SVG stroke-icon convention. Always paired with a text
// label in the pill, so icon fidelity doesn't need to carry meaning alone.
const SOCIAL_ICON_SVG: Record<string, string> = {
  twitch_url: '<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2h11v8l-3 3h-3l-2 2v-2H3V2z"/><path d="M8 5v3M11 5v3"/></svg>',
  youtube_url: '<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1.5" y="3.5" width="13" height="9" rx="2.5"/><path d="M6.5 6l4 2-4 2V6z" fill="currentColor" stroke="none"/></svg>',
  twitter_url: '<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M2.5 2.5l11 11M13.5 2.5l-11 11"/></svg>',
  discord_url: '<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="12" height="7" rx="3.5"/><path d="M5.5 8.5v.01M10.5 8.5v.01" stroke-width="2"/></svg>',
  website_url: '<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6"/><path d="M8 2c0 0-3 2-3 6s3 6 3 6M8 2c0 0 3 2 3 6s-3 6-3 6M2 8h12"/></svg>',
}
const hasAccentColor = !!accentStyle
const initialAccentColorValue = hasAccentColor ? (reviewer.accent_color as string) : '#6050c8'
const socialIconsJson = JSON.stringify(SOCIAL_ICON_SVG)
const socialLabelsJson = JSON.stringify(Object.fromEntries(SOCIAL_PLATFORMS.map(p => [p.key, p.label])))

// Per-game scatter + hot takes
const perGameData = publishedReviews
  .map((r: any) => {
    const gid = (r as any).games?.id
    if (!gid || _gameAvgMap2[gid] === undefined) return null
    const commAvg = Math.round(_gameAvgMap2[gid] * 10) / 10
    return {
      title: (r as any).games?.title ?? '',
      slug: (r as any).games?.slug ?? '',
      userScore: (r as any).score as number,
      commAvg,
      delta: Math.round(((r as any).score - commAvg) * 10) / 10,
      userHours: (r as any).play_time_hours ?? null,
      commAvgHours: _gameAvgHoursMap2[gid] ?? null,
    }
  })
  .filter(Boolean) as { title: string; slug: string; userScore: number; commAvg: number; delta: number; userHours: number | null; commAvgHours: number | null }[]

const hotTakes = [...perGameData]
  .sort((a, b) => Math.abs(b.delta) - Math.abs(a.delta))
  .slice(0, 5)

// ── VOLUME PERCENTILE — how this reviewer's review count ranks against every other reviewer ──
// Reviews is unbounded, so page through in batches (same pattern used for the all-time score
// rank on games/[slug].astro) rather than a single capped query.
let volumePercentile: number | null = null
{
  const profileReviewCounts: Record<string, number> = {}
  const PAGE_SIZE = 1000
  let from = 0
  while (true) {
    const { data: page } = await (supabase as any)
      .from('reviews').select('profile_id').eq('status', 'published')
      .range(from, from + PAGE_SIZE - 1)
    if (!page || page.length === 0) break
    for (const row of page) {
      profileReviewCounts[row.profile_id] = (profileReviewCounts[row.profile_id] ?? 0) + 1
    }
    if (page.length < PAGE_SIZE) break
    from += PAGE_SIZE
  }
  const allCounts = Object.values(profileReviewCounts)
  const myCount = publishedReviews.length
  const fewerThanMe = allCounts.filter((c) => c < myCount).length
  const totalOtherReviewers = allCounts.length - 1 // exclude self
  volumePercentile = totalOtherReviewers > 0 ? Math.round((fewerThanMe / totalOtherReviewers) * 100) : null
}

const distJson = JSON.stringify(scoreDistribution)
const statsJson = JSON.stringify({
  reviewCount: publishedReviews.length,
  avgScore, avgHours, totalHours, recommendedRate, scoreDelta, volumePercentile,
  platformBreakdown, genreBreakdown,
  genreActivityData, genreRatingData, yearRatingData,
  monthLabels, monthCounts, scoreDistribution,
  perGameData, hotTakes,
})
const isOwnProfileJson = JSON.stringify(isOwnProfile)
const showcaseJson = JSON.stringify(
  Array.isArray(reviewer.showcase_games) ? reviewer.showcase_games : []
)
const showcaseAchievementsJson = JSON.stringify(
  Array.isArray((reviewer as any).showcase_achievements) ? (reviewer as any).showcase_achievements : []
)
const achProfileId = reviewer.id
const reviewScoreByGameId: Record<string, number> = {}
const reviewHoursByGameId: Record<string, number> = {}
for (const r of publishedReviews) {
  const gid = (r as any).games?.id
  if (!gid) continue
  reviewScoreByGameId[gid] = (r as any).score
  if ((r as any).play_time_hours != null) reviewHoursByGameId[gid] = (r as any).play_time_hours
}

const libraryJson = JSON.stringify(allLibraryItems.map((item: any) => ({
  gameId:   item.games?.id ?? '',
  title:    item.games?.title ?? '',
  slug:     item.games?.slug ?? '',
  cover:    item.games?.cover_img_url ?? null,
  status:   item.status,
  owned:    item.is_owned ?? false,
  isHidden: item.is_hidden ?? false,
  updatedAt: item.updated_at ?? '',
  // Steam-imported minutes take priority; fall back to hours logged on the
  // reviewer's own review when Steam hasn't supplied playtime for this game.
  playtime: item.steam_playtime_minutes ?? null,
  reviewHours: reviewHoursByGameId[item.games?.id] ?? null,
  hasReview: reviewedGameIdsSet.has(item.games?.id),
  reviewScore: reviewScoreByGameId[item.games?.id] ?? null,
  genres:   (item.games?.game_genres ?? []).map((gg: any) => gg.genres?.name).filter(Boolean),
})))
const libraryIsOwn = JSON.stringify(isOwnProfile)
const librarySettingsJson = JSON.stringify({
  visibility: libraryVisibility,
  showHours: libraryShowHours,
  hiddenTabs: libraryHiddenTabs,
  isPrivate: libraryIsPrivate,
})

// vote counting logic for reviews
// CDN cache — anonymous visitors share a cached response; auth users get a fresh render
if (!user) {
  Astro.response.headers.set('Netlify-CDN-Cache-Control', 'public, max-age=300, stale-while-revalidate=600');
  Astro.response.headers.set('Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}
Astro.response.headers.set('Netlify-Vary', 'cookie=sb-bzlwwtatoiyzwirerify-auth-token');

// ── Achievements ──
const adminDb = getSupabaseAdmin() as any;

// Fast count so the tab appears for logged-out visitors (hasSteam relies on the
// anon client which may not return steam_id without a JWT).
const { count: _achCount } = await adminDb
  .from('user_achievements')
  .select('*', { count: 'exact', head: true })
  .eq('profile_id', reviewer.id);

const hasAchievements = activeTab === 'achievements';
const _ACH_PER_PAGE = 50;
const achPage = hasAchievements ? Math.max(1, parseInt(Astro.url.searchParams.get('achpage') ?? '1') || 1) : 1;
const achQ    = hasAchievements ? (Astro.url.searchParams.get('q') ?? '').trim() : '';
const achSort = hasAchievements ? (Astro.url.searchParams.get('sort') ?? 'recent') : 'recent';
const achDays = hasAchievements ? (parseInt(Astro.url.searchParams.get('days') ?? '0') || 0) : 0;

const [achievementSummary, achievementsRaw] = hasAchievements
  ? await Promise.all([
      adminDb.from('user_achievements')
        .select('steam_appid, unlocked', { count: 'exact' })
        .eq('profile_id', reviewer.id),
      (() => {
        let q = adminDb.from('user_achievements')
          .select('display_name, description, icon_url, global_percent, unlock_time, steam_appid, api_name, games(title)', { count: 'exact' })
          .eq('profile_id', reviewer.id)
          .eq('unlocked', true)
          .not('unlock_time', 'is', null);
        if (achQ)     q = q.ilike('display_name', `%${achQ}%`);
        if (achDays > 0) q = q.gte('unlock_time', new Date(Date.now() - achDays * 86400000).toISOString());
        if (achSort === 'oldest')    q = q.order('unlock_time', { ascending: true });
        else if (achSort === 'rarest')    q = q.order('global_percent', { ascending: true, nullsFirst: false });
        else if (achSort === 'least-rare') q = q.order('global_percent', { ascending: false, nullsFirst: false });
        else if (achSort === 'az')        q = q.order('display_name', { ascending: true, nullsFirst: false });
        else if (achSort === 'za')        q = q.order('display_name', { ascending: false, nullsFirst: false });
        else                              q = q.order('unlock_time', { ascending: false }); // recent (default)
        return q.range((achPage - 1) * _ACH_PER_PAGE, achPage * _ACH_PER_PAGE - 1);
      })(),
    ])
  : [{ data: null, count: null }, { data: [], count: 0 }];

const totalAchievements = achievementSummary.count ?? 0;
const unlockedAchievements = (achievementSummary.data ?? []).filter((a: any) => a.unlocked).length;

const _byGame = new Map<number, { total: number; unlocked: number }>();
for (const a of (achievementSummary.data ?? []) as any[]) {
  const g = _byGame.get(a.steam_appid) ?? { total: 0, unlocked: 0 };
  g.total++;
  if (a.unlocked) g.unlocked++;
  _byGame.set(a.steam_appid, g);
}
const _gamesWithAchs = [..._byGame.values()].filter(g => g.total > 0);
const avgCompletion = _gamesWithAchs.length > 0
  ? _gamesWithAchs.reduce((sum, g) => sum + g.unlocked / g.total, 0) / _gamesWithAchs.length * 100
  : 0;
const perfectGames = _gamesWithAchs.filter(g => g.unlocked === g.total).length;

// Group by date only for time-based sorts; otherwise use a single group
const _achNow = new Date();
const achByDate: Array<{ label: string; items: any[] }> = [];
const _achGroupByDate = achSort === 'recent' || achSort === 'oldest';
if (_achGroupByDate) {
  const achDateMap = new Map<string, any[]>();
  for (const a of (achievementsRaw.data ?? []) as any[]) {
    const d = new Date(a.unlock_time);
    const isCurrentYear = d.getUTCFullYear() === _achNow.getUTCFullYear();
    const label = d.toLocaleDateString('en-US', {
      month: 'long', day: 'numeric',
      ...(!isCurrentYear ? { year: 'numeric' } : {}),
      timeZone: 'UTC',
    }).toUpperCase();
    if (!achDateMap.has(label)) { achDateMap.set(label, []); achByDate.push({ label, items: achDateMap.get(label)! }); }
    achDateMap.get(label)!.push(a);
  }
} else {
  if ((achievementsRaw.data ?? []).length > 0) achByDate.push({ label: '', items: achievementsRaw.data as any[] });
}
const achTotalFiltered = (achievementsRaw as any).count ?? 0;
const achTotalPages = Math.max(1, Math.ceil(achTotalFiltered / _ACH_PER_PAGE));

function achUrl(page: number, overrides: { q?: string; sort?: string; days?: string } = {}) {
  const p = new URLSearchParams({ tab: 'achievements' });
  if (page > 1) p.set('achpage', String(page));
  const q = overrides.q !== undefined ? overrides.q : achQ;
  if (q) p.set('q', q);
  const sort = overrides.sort !== undefined ? overrides.sort : achSort;
  if (sort && sort !== 'recent') p.set('sort', sort);
  const days = overrides.days !== undefined ? overrides.days : (achDays > 0 ? String(achDays) : '');
  if (days) p.set('days', days);
  return `/reviewers/${reviewer.username}?${p.toString()}`;
}

// Build the page-number list for SSR pagination (numbers + '…' gaps)
const achPageItems: (number | string)[] = [];
if (achTotalPages > 1) {
  const _pages = Array.from({ length: achTotalPages }, (_, i) => i + 1)
    .filter(p => p === 1 || p === achTotalPages || Math.abs(p - achPage) <= 2);
  for (let i = 0; i < _pages.length; i++) {
    if (i > 0 && _pages[i] - _pages[i - 1] > 1) achPageItems.push('…');
    achPageItems.push(_pages[i]);
  }
}

// Check if this reviewer has Steam connected (for showing sync button to owner)
const hasSteam = !!(reviewer as any).steam_id;
const showAchievementsTab = hasSteam || isOwnProfile || (_achCount ?? 0) > 0;

// ── SEO ──
const reviewerDescription = reviewer.bio
  ? reviewer.bio
  : publishedReviews.length > 0
  ? `@${reviewer.username} has reviewed ${publishedReviews.length} game${publishedReviews.length !== 1 ? 's' : ''} on Chekpoint with an average score of ${avgScore}/10.`
  : `@${reviewer.username}'s game reviews on Chekpoint.`
// Self-referential (not Astro.site) so preview/branch deploys render an image
// pointing at the host actually serving the request — same reasoning as the
// review/list OG image URLs.
const reviewerOgImage = new URL(`/og/profiles/${reviewer.username}.jpg`, Astro.url.origin).toString()

const reviewerBreadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',      item: 'https://chekpoint.gg' },
    { '@type': 'ListItem', position: 2, name: 'Reviewers', item: 'https://chekpoint.gg/reviewers' },
    { '@type': 'ListItem', position: 3, name: `@${reviewer.username}`, item: `https://chekpoint.gg/reviewers/${reviewer.username}` },
  ],
};
---

<Layout title={`@${reviewer.username} — Chekpoint`} description={reviewerDescription} ogImage={reviewerOgImage} variant="fullwidth" isLoggedIn={!!user} currentProfile={currentProfile} noindex={!reviewer.search_indexable}>
  <Fragment slot="head">
    <!-- Profiles are indexed only when the user opts in (settings → search engine visibility) -->
    <script type="application/ld+json" set:html={JSON.stringify(reviewerBreadcrumbJsonLd)} />
