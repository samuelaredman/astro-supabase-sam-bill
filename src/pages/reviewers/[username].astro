    btn.classList.add('active')
    var mySection = document.getElementById('lists-my-section')
    var savedSection = document.getElementById('lists-saved-section')
    if (mySection) mySection.style.display = type === 'my' ? '' : 'none'
    if (savedSection) savedSection.style.display = type === 'saved' ? '' : 'none'
  }
  window.switchListsSection = switchListsSection

  // ── LIST FILTER STATE ──
  var _listState = {
    my:    { sort: 'recent', genre: '', platform: '', dev: '', search: '', ranked: false, private: false },
    saved: { sort: 'recent', genre: '', platform: '', dev: '', search: '', ranked: false, hidden: false },
  }

  function applyListFilters(section) {
    var grid = document.getElementById(section + '-lists-grid')
    var noResults = document.getElementById(section + '-no-results')
    if (!grid) return
    var state = _listState[section]
    var items = Array.from(grid.querySelectorAll('.list-card-wrapper'))

    // filter
    items.forEach(function(item) {
      var show = true
      if (state.search) {
        var q = state.search.toLowerCase()
        if ((item.dataset.title || '').toLowerCase().indexOf(q) === -1) show = false
      }
      if (show && state.genre) {
        var genres = (item.dataset.genres || '').split(',')
        if (genres.indexOf(state.genre) === -1) show = false
      }
      if (show && state.platform) {
        var platforms = (item.dataset.platforms || '').split(',')
        if (platforms.indexOf(state.platform) === -1) show = false
      }
      if (show && state.dev) {
        var devs = (item.dataset.devs || '').split(',')
        if (devs.indexOf(state.dev) === -1) show = false
      }
      if (show && state.ranked && item.dataset.ranked !== 'true') show = false
      if (show && state.private && item.dataset.visibility !== 'private') show = false
      if (show && state.hidden && item.dataset.hidden !== 'true') show = false
      item.style.display = show ? '' : 'none'
    })

    // sort visible
    var visible = items.filter(function(i) { return i.style.display !== 'none' })
    visible.sort(function(a, b) {
      if (state.sort === 'oldest') return new Date(a.dataset.updated) - new Date(b.dataset.updated)
      if (state.sort === 'az') return (a.dataset.title || '').localeCompare(b.dataset.title || '')
      if (state.sort === 'most-games') return parseInt(b.dataset.count || '0') - parseInt(a.dataset.count || '0')
      if (state.sort === 'highest-rated') {
        var as = parseFloat(a.dataset.avgScore || '-1'), bs = parseFloat(b.dataset.avgScore || '-1')
        if (as < 0 && bs < 0) return 0
        if (as < 0) return 1
        if (bs < 0) return -1
        return bs - as
      }
      if (state.sort === 'lowest-rated') {
        var as = parseFloat(a.dataset.avgScore || '-1'), bs = parseFloat(b.dataset.avgScore || '-1')
        if (as < 0 && bs < 0) return 0
        if (as < 0) return 1
        if (bs < 0) return -1
        return as - bs
      }
      if (state.sort === 'most-hours') return parseInt(b.dataset.totalHours || '0') - parseInt(a.dataset.totalHours || '0')
      return new Date(b.dataset.updated) - new Date(a.dataset.updated) // recent default
    })
    visible.forEach(function(i) { grid.appendChild(i) })

    if (noResults) noResults.style.display = visible.length === 0 ? '' : 'none'
  }

  window.setListSort = function(section, sortKey) {
    _listState[section].sort = sortKey
    applyListFilters(section)
  }

  window.setListFilter = function(section, type, value, selectEl) {
    _listState[section][type] = value
    if (selectEl) selectEl.classList.toggle('has-value', !!value)
    applyListFilters(section)
  }

  window.searchLists = function(section, value) {
    _listState[section].search = value.trim()
    applyListFilters(section)
  }

  window.setListCheckboxFilter = function(section, type, checked) {
    _listState[section][type] = checked
    applyListFilters(section)
  }

  window.toggleSavedEditMode = function(btn) {
    var grid = document.getElementById('saved-lists-grid')
    if (!grid) return
    var active = grid.classList.toggle('saved-edit-mode')
    btn.textContent = active ? '✓ Done' : '⚙ Manage'
    btn.classList.toggle('active', active)
  }

  // ── TOGGLE SAVED LIST HIDDEN ──
  window.toggleSaveHidden = async function(btn) {
    var listId = btn.dataset.listId
    var isHidden = btn.dataset.hidden === 'true'
    var newHidden = !isHidden
    btn.disabled = true
    try {
      var res = await fetch('/api/lists/toggle-save-hidden', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ list_id: listId, hidden: newHidden })
      })
      if (!res.ok) { var d = await res.json(); throw new Error(d.error || 'Failed') }
      btn.dataset.hidden = newHidden ? 'true' : 'false'
      btn.title = newHidden ? 'Show on profile' : 'Hide from profile'
      btn.textContent = newHidden ? '👁' : '🫥'
      var wrap = btn.closest('.saved-list-wrap')
      if (wrap) {
        wrap.classList.toggle('is-hidden', newHidden)
        wrap.dataset.hidden = newHidden ? 'true' : 'false'
        if (_listState.saved.hidden) applyListFilters('saved')
      }
    } catch(e) { console.error('[toggle-save-hidden]', e) }
    btn.disabled = false
  }

  // ── LIBRARY ──
  var _libItems = JSON.parse(libraryJson)
  // Steam-imported hours take priority; fall back to hours logged on the
  // reviewer's own review when Steam hasn't supplied playtime for this game.
  _libItems.forEach(function(it) {
    it.displayHours = it.playtime != null ? Math.round(it.playtime / 60)
      : it.reviewHours != null ? Math.round(it.reviewHours)
      : null
  })
  var _libIsOwn = JSON.parse(libraryIsOwn)
  var _libSettings = JSON.parse(librarySettingsJson)
  var _libFilter = 'all'
  var _libSort = 'alpha'
  var _libSearch = ''
  var _libEditMode = false
  var _libSelected = new Set()
  var _filterReviewed = false
  var _filterUnreviewed = false
  var _filterUnplayed = false
  var _filterHidden = false

  var STATUS_META = {
    playing:         { icon: '🎮', label: 'Playing',      dot: '#60a5fa' },
    completed:       { icon: '✓',  label: 'Completed',    dot: '#4ade80' },
    hundred_percent: { icon: '💯', label: '100%',         dot: '#fbbf24' },
    want_to_play:    { icon: '🔖', label: 'Want to Play', dot: '#f59e0b' },
    owned:           { icon: '📦', label: 'Owned',        dot: '#94a3b8' },
    dropped:         { icon: '✗',  label: 'Dropped',      dot: '#f87171' },
  }

  function _getVisible() {
    var q = _libSearch.toLowerCase().trim()
    var items = _libItems.filter(function(it) {
      // Hidden checkbox isolates: checked shows ONLY hidden games, unchecked shows only non-hidden
      if (_filterHidden) {
        if (!it.isHidden) return false
      } else {
        if (it.isHidden) return false
      }
      if (_libFilter !== 'all') {
        if (_libFilter === 'owned') {
          // Owned is an independent flag, not tied to a single status
          if (!it.owned) return false
        } else if (_libFilter === 'completed') {
          if (it.status !== 'completed' && it.status !== 'hundred_percent') return false
        } else {
          if (it.status !== _libFilter) return false
        }
      }
      if (_filterReviewed && !it.hasReview) return false
      if (_filterUnreviewed && it.hasReview) return false
      if (_filterUnplayed && (it.playtime > 0 || it.hasReview)) return false
      if (q) {
        var inTitle = it.title.toLowerCase().includes(q)
        var inGenre = it.genres.some(function(g) { return g.toLowerCase().includes(q) })
        if (!inTitle && !inGenre) return false
      }
      return true
    })
    // sort
    items = items.slice().sort(function(a, b) {
      if (_libSort === 'alpha')   return a.title.localeCompare(b.title)
      if (_libSort === 'recent')  return (b.updatedAt || '').localeCompare(a.updatedAt || '')
      if (_libSort === 'review')  return (b.hasReview ? 1 : 0) - (a.hasReview ? 1 : 0)
      if (_libSort === 'hours')   return (b.displayHours || 0) - (a.displayHours || 0)
      return 0
    })
    return items
  }

  function _renderGrid() {
    var grid = document.getElementById('libGrid')
    var empty = document.getElementById('libEmpty')
    var checkboxes = document.getElementById('libCheckboxes')
    if (!grid) return
    var items = _getVisible()
    if (items.length === 0) {
      grid.innerHTML = ''
      if (empty) empty.style.display = ''
      if (checkboxes) checkboxes.style.display = 'none'
      return
    }
    if (empty) empty.style.display = 'none'
    if (checkboxes) checkboxes.style.display = ''
    grid.innerHTML = items.map(function(it) {
      var coverUrl = it.cover
        ? it.cover.replace(/^\/\//, 'https://').replace(/t_[a-z0-9_]+/, 't_cover_big')
        : null
      var checked = _libSelected.has(it.gameId)
      var scoreHtml = it.reviewScore != null
        ? '<div class="lib-score-badge ' + libScoreClass(it.reviewScore) + '">' + it.reviewScore + '</div>'
        : ''
      var showHrs = _libIsOwn || _libSettings.showHours
      var hrs = showHrs ? it.displayHours : null
      var hoursHtml = hrs != null && hrs > 0
        ? '<div class="lib-hours-badge">' + hrs + 'h</div>'
        : ''
      var hiddenBadge = (it.isHidden && _libIsOwn)
        ? '<div class="lib-hidden-badge" title="Hidden from others">🫥</div>'
        : ''
      return '<' + 'a href="/games/' + it.slug + '" class="lib-item' + (_libEditMode ? ' lib-edit-active' : '') + (it.isHidden && _libIsOwn ? ' lib-item-hidden' : '') + '" data-status="' + it.status + '" data-game-id="' + it.gameId + '">' +
        '<div class="lib-cover">' +
        (coverUrl ? '<img src="' + coverUrl + '" alt="" loading="lazy"/>' : '<span>🎮</span>') +
        hoursHtml +
        hiddenBadge +
        scoreHtml +
        (_libEditMode ? '<div class="lib-checkbox' + (checked ? ' checked' : '') + '"><div class="lib-check-inner"></div></div>' : '') +
        '</div>' +
        '<div class="lib-title">' + it.title.replace(/</g,'&lt;') + '</div>' +
        '</' + 'a>'
    }).join('')

    // click handler
    grid.querySelectorAll('.lib-item').forEach(function(el) {
      el.addEventListener('click', function(e) {
        if (!_libEditMode) return // normal navigation
        e.preventDefault()
        var gid = el.dataset.gameId
        if (_libSelected.has(gid)) _libSelected.delete(gid)
        else _libSelected.add(gid)
        _renderGrid()
        _updateEditBar()
      })
    })
  }

  function _renderFilterPills() {
    var row = document.getElementById('libFilterRow')
    if (!row) return
    var counts = {}
    _libItems.forEach(function(it) { counts[it.status] = (counts[it.status] || 0) + 1 })
    var ownedCount = _libItems.filter(function(it) { return it.owned }).length
    var total = _libItems.length
    var pills = [{ key: 'all', label: 'All', count: total }]
    var order = ['playing','completed','hundred_percent','want_to_play','owned','dropped']
    var hiddenTabsSet = new Set(_libIsOwn ? [] : (_libSettings.hiddenTabs || []))
    order.forEach(function(s) {
      var count = s === 'owned' ? ownedCount
        : s === 'completed' ? (counts['completed'] || 0) + (counts['hundred_percent'] || 0)
        : counts[s]
      if (!count) return
      if (!_libIsOwn && hiddenTabsSet.has(s)) return  // hidden from public view
      pills.push({ key: s, label: (STATUS_META[s]?.icon || '') + ' ' + STATUS_META[s]?.label, count: count })
    })
    var pillsHtml = pills.map(function(p) {
      var isActive = _libFilter === p.key
      return '<button class="lib-pill' + (isActive ? ' active' : '') + '" data-filter="' + p.key + '">' +
        p.label + ' <span class="pill-count">' + p.count + '</span></button>'
    }).join('')
    row.innerHTML = pillsHtml
    row.querySelectorAll('.lib-pill').forEach(function(btn) {
      btn.addEventListener('click', function() {
        _libFilter = btn.dataset.filter
        _renderFilterPills()
        _renderGrid()
      })
    })
  }

  function _updateEditBar() {
    var bar = document.getElementById('libEditBar')
    var countEl = document.getElementById('libEditCount')
    if (!bar) return
    if (countEl) countEl.textContent = _libSelected.size + ' selected'
    bar.style.display = _libEditMode ? 'flex' : 'none'
  }

  function toggleLibEdit() {
    _libEditMode = !_libEditMode
    _libSelected.clear()
    var btn = document.getElementById('libEditBtn')
    if (btn) btn.textContent = _libEditMode ? 'Cancel' : 'Edit library'
    _renderGrid()
    _updateEditBar()
  }
  window.toggleLibEdit = toggleLibEdit

  async function applyBulkStatus() {
    var sel = document.getElementById('libBulkStatus')
    var status = sel ? sel.value : ''
    if (!status || _libSelected.size === 0) return
    var ids = Array.from(_libSelected)
    var res = await fetch('/api/user-game-status/bulk-update', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ game_ids: ids, action: 'set_status', status }),
    })
    if (res.ok) {
      ids.forEach(function(gid) {
        var it = _libItems.find(function(x) { return x.gameId === gid })
        if (it) { it.status = status; it.owned = status !== 'want_to_play' }
      })
      _libSelected.clear()
      if (sel) sel.value = ''
      _renderFilterPills()
      _renderGrid()
      _updateEditBar()
    }
  }
  window.applyBulkStatus = applyBulkStatus

  async function applyBulkDelete() {
    if (_libSelected.size === 0) return
    var ids = Array.from(_libSelected)
    var res = await fetch('/api/user-game-status/bulk-update', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ game_ids: ids, action: 'delete' }),
    })
    if (res.ok) {
      _libItems = _libItems.filter(function(it) { return !_libSelected.has(it.gameId) })
      _libSelected.clear()
      _renderFilterPills()
      _renderGrid()
      _updateEditBar()
    }
  }
  window.applyBulkDelete = applyBulkDelete

  // Init library
  ;(function() {
    if (_libSettings.isPrivate) return  // private library: Astro shows the message above
    if (_libItems.length === 0 && !_libIsOwn) {
      // show static empty state, controls hidden
      var empty = document.getElementById('libEmpty')
      if (empty) empty.style.display = ''
      return
    }
    var controls = document.getElementById('libControls')
    if (controls) controls.style.display = ''
    var search = document.getElementById('libSearch')
    var sort = document.getElementById('libSort')
    if (search) search.addEventListener('input', function() { _libSearch = search.value; _renderGrid() })
    if (sort) sort.addEventListener('change', function() { _libSort = sort.value; _renderGrid() })
    _renderFilterPills()
    _renderGrid()

    // wire up reviewed / unreviewed / unplayed checkboxes
    var reviewedItem   = document.getElementById('libReviewedItem')
    var unreviewedItem = document.getElementById('libUnreviewedItem')
    var unplayedItem   = document.getElementById('libUnplayedItem')
    var hiddenItem     = document.getElementById('libHiddenItem')

    function _syncCheckboxUI() {
      if (reviewedItem)   reviewedItem.classList.toggle('active', _filterReviewed)
      if (unreviewedItem) unreviewedItem.classList.toggle('active', _filterUnreviewed)
      if (unplayedItem)   unplayedItem.classList.toggle('active', _filterUnplayed)
      if (hiddenItem)     hiddenItem.classList.toggle('active', _filterHidden)
      _renderGrid()
    }

    if (reviewedItem) reviewedItem.addEventListener('click', function() {
      _filterReviewed = !_filterReviewed
      if (_filterReviewed) { _filterUnreviewed = false; _filterUnplayed = false }
      _syncCheckboxUI()
    })
    if (unreviewedItem) unreviewedItem.addEventListener('click', function() {
      _filterUnreviewed = !_filterUnreviewed
      if (_filterUnreviewed) _filterReviewed = false
      _syncCheckboxUI()
    })
    if (unplayedItem) unplayedItem.addEventListener('click', function() {
      _filterUnplayed = !_filterUnplayed
      if (_filterUnplayed) _filterReviewed = false
      _syncCheckboxUI()
    })
    if (hiddenItem) hiddenItem.addEventListener('click', function() {
      _filterHidden = !_filterHidden
      _syncCheckboxUI()
    })

    // ── GEAR PANEL ──
    function _coverThumb(url) {
      if (!url) return null
      return url.replace(/^\/\//, 'https://').replace(/t_[a-z0-9_]+/, 't_thumb')
    }

    function _renderHiddenList() {
      var el = document.getElementById('libHiddenList')
      if (!el) return
      var hidden = _libItems.filter(function(it) { return it.isHidden })
      if (!hidden.length) {
        el.innerHTML = '<div style="font-size:13px;color:var(--text-tertiary);padding:4px 0">No hidden games.</div>'
        return
      }
      el.innerHTML = hidden.map(function(it) {
        var img = _coverThumb(it.cover)
        return '<div class="lib-hidden-row" data-game-id="' + it.gameId + '">' +
          (img ? '<img class="lib-hidden-cover" src="' + img + '" alt="" />' : '<div class="lib-hidden-cover" style="display:flex;align-items:center;justify-content:center;font-size:18px">🎮</div>') +
          '<span class="lib-hidden-title">' + it.title.replace(/</g,'&lt;') + '</span>' +
          '<button class="lib-unhide-btn" onclick="libUnhide(\'' + it.gameId + '\')">Unhide</button>' +
          '</div>'
      }).join('')
    }

    function _renderHideResults(q) {
      var el = document.getElementById('libHideResults')
      if (!el) return
      var results = _libItems.filter(function(it) {
        if (it.isHidden) return false
        if (!q) return true
        return it.title.toLowerCase().includes(q.toLowerCase())
      }).slice(0, 30)
      if (!results.length) {
        el.innerHTML = '<div style="font-size:13px;color:var(--text-tertiary);padding:4px 0">' + (q ? 'No matches.' : 'Type to search your library.') + '</div>'
        return
      }
      el.innerHTML = results.map(function(it) {
        var img = _coverThumb(it.cover)
        return '<div class="lib-hide-row" data-game-id="' + it.gameId + '">' +
          (img ? '<img class="lib-hidden-cover" src="' + img + '" alt="" />' : '<div class="lib-hidden-cover" style="display:flex;align-items:center;justify-content:center;font-size:18px">🎮</div>') +
          '<span class="lib-hidden-title">' + it.title.replace(/</g,'&lt;') + '</span>' +
          '<button class="lib-hide-btn" onclick="libHide(\'' + it.gameId + '\')">Hide</button>' +
          '</div>'
      }).join('')
    }

    window.toggleLibGear = function() {
      var panel = document.getElementById('libGearPanel')
      var btn = document.getElementById('libGearBtn')
      if (!panel) return
      var open = panel.classList.toggle('open')
      if (btn) btn.classList.toggle('open', open)
      if (open) { _renderGearSettings(); _renderHiddenList(); _renderHideResults('') }
    }

    window.switchGearTab = function(tab, el) {
      document.querySelectorAll('.lib-gear-tab').forEach(function(t) { t.classList.remove('active') })
      if (el) el.classList.add('active')
      document.getElementById('libGearTabSettings').style.display = tab === 'settings' ? '' : 'none'
      document.getElementById('libGearTabHidden').style.display = tab === 'hidden' ? '' : 'none'
    }

    // ── Settings rendering ──
    function _renderGearSettings() {
      // Visibility radios
      var radios = document.querySelectorAll('input[name="libVisibility"]')
      radios.forEach(function(r) { r.checked = (r.value === _libSettings.visibility) })
      radios.forEach(function(r) {
        r.addEventListener('change', async function() {
          if (!r.checked) return
          _libSettings.visibility = r.value
          await fetch('/api/profile/library-settings', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ library_visibility: r.value })
          })
        })
      })
      // Hours toggle
      var hoursBtn = document.getElementById('libShowHoursBtn')
      if (hoursBtn) {
        hoursBtn.classList.toggle('on', _libSettings.showHours)
        hoursBtn.onclick = async function() {
          _libSettings.showHours = !_libSettings.showHours
          hoursBtn.classList.toggle('on', _libSettings.showHours)
          await fetch('/api/profile/library-settings', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ library_show_hours: _libSettings.showHours })
          })
          _renderGrid()
        }
      }
      // Tab visibility toggles
      var tabTogglesEl = document.getElementById('libTabToggles')
      if (tabTogglesEl) {
        var tabOrder = [
          { key: 'playing', label: '🎮 Playing' },
          { key: 'completed', label: '✓ Completed' },
          { key: 'hundred_percent', label: '💯 100%' },
          { key: 'want_to_play', label: '🔖 Want to Play' },
          { key: 'owned', label: '📦 Owned' },
          { key: 'dropped', label: '✗ Dropped' },
        ]
        var hiddenSet = new Set(_libSettings.hiddenTabs || [])
        tabTogglesEl.innerHTML = '<div class="lib-gear-tab-toggles">' + tabOrder.map(function(t) {
          var isOn = !hiddenSet.has(t.key)
          return '<div class="lib-gear-tab-toggle-row">' +
            '<span style="font-size:13px;color:var(--text-secondary)">' + t.label + '</span>' +
            '<button class="lib-gear-toggle' + (isOn ? ' on' : '') + '" data-tabkey="' + t.key + '" onclick="toggleLibTab(\'' + t.key + '\',this)"></button>' +
            '</div>'
        }).join('') + '</div>'
      }
    }

    window.toggleLibShowHours = function() {} // handled inline above

    window.toggleLibTab = async function(key, btn) {
      var hiddenSet = new Set(_libSettings.hiddenTabs || [])
      if (hiddenSet.has(key)) hiddenSet.delete(key)
      else hiddenSet.add(key)
      _libSettings.hiddenTabs = Array.from(hiddenSet)
      btn.classList.toggle('on', !hiddenSet.has(key))
      await fetch('/api/profile/library-settings', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ library_hidden_tabs: _libSettings.hiddenTabs })
      })
    }

    var hideSearch = document.getElementById('libHideSearch')
    if (hideSearch) hideSearch.addEventListener('input', function() { _renderHideResults(hideSearch.value) })

    window.libUnhide = async function(gameId) {
      var it = _libItems.find(function(x) { return x.gameId === gameId })
      var res = await fetch('/api/user-game-status/toggle-hidden', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ game_id: gameId, hidden: false })
      })
      if (!res.ok) return
      if (it) it.isHidden = false
      _renderHiddenList()
      _renderHideResults(hideSearch ? hideSearch.value : '')
      _renderFilterPills()
      _renderGrid()
    }

    window.libHide = async function(gameId) {
      var it = _libItems.find(function(x) { return x.gameId === gameId })
      var res = await fetch('/api/user-game-status/toggle-hidden', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ game_id: gameId, hidden: true })
      })
      if (!res.ok) return
      if (it) it.isHidden = true
      _renderHiddenList()
      _renderHideResults(hideSearch ? hideSearch.value : '')
      _renderFilterPills()
      _renderGrid()
    }
  })()


  // ── STATS TAB ──
  function scoreCol(score) {
    var isLight = document.documentElement.getAttribute('data-theme') === 'light'
    if (isLight) {
      if (score === 10) return '#1a1a2e'
      if (score >= 9)  return '#166534'
      if (score >= 8)  return '#0f766e'
      if (score >= 7)  return '#1e40af'
      if (score >= 5)  return '#854d0e'
      if (score >= 3)  return '#9a3412'
      return '#991b1b'
    }
    if (score === 10) return '#ffffff'
    if (score >= 9) return '#4ade80'
    if (score >= 8) return '#2dd4bf'
    if (score >= 7) return '#60a5fa'
    if (score >= 5) return '#fbbf24'
    if (score >= 3) return '#fb923c'
    return '#f87171'
  }

  function libScoreClass(score) {
    if (score === 10) return 'score-perfect'
    if (score >= 9)   return 'score-great'
    if (score >= 8)   return 'score-teal'
    if (score >= 7)   return 'score-good'
    if (score >= 5)   return 'score-mid'
    if (score >= 3)   return 'score-orange'
    return 'score-low'
  }

  function buildStats() {
    var el = document.getElementById('statsContent')
    if (!el || !s.reviewCount) return
    var pieColors = ['#6050c8','#60a5fa','#4ade80','#fbbf24','#f87171']
    var html = ''
    var deltaVal = s.scoreDelta !== null && s.scoreDelta !== undefined ? s.scoreDelta : null
    var deltaColor = deltaVal === null ? '#908d87' : deltaVal > 0 ? '#4ade80' : deltaVal < 0 ? '#f87171' : '#908d87'
    var deltaStr = deltaVal === null ? '—' : (deltaVal > 0 ? '+' : '') + deltaVal.toFixed(1)
    var volPct = s.volumePercentile !== null && s.volumePercentile !== undefined ? s.volumePercentile : null
    var volTopPct = volPct !== null ? Math.max(1, 100 - volPct) : null
    html += '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:8px;margin-bottom:10px">'
    var heroStats = [
      { lbl: 'Reviews written', val: s.reviewCount, color: '#6050c8' },
      { lbl: 'Avg score given', val: s.avgScore || '—', color: scoreCol(parseFloat(s.avgScore||'0')) },
      { lbl: 'Avg hours played', val: s.avgHours ? s.avgHours+'h' : '—', color: '#fbbf24' },
      { lbl: 'vs. community', val: deltaStr, color: deltaColor, sub: deltaVal === null ? 'no data' : deltaVal > 0 ? 'rates higher than avg' : deltaVal < 0 ? 'rates lower than avg' : 'rates same as avg' },
      { lbl: 'Review volume', val: volTopPct !== null ? 'Top '+volTopPct+'%' : '—', color: '#a78bfa', sub: volPct !== null ? 'more reviews than '+volPct+'% of reviewers' : 'not enough data' },
    ]
    heroStats.forEach(function(hs) {
      html += '<div style="background:var(--bg-card);border:1px solid '+hs.color+'33;border-radius:12px;padding:12px 14px;position:relative;overflow:hidden">'
      html += '<div style="position:absolute;inset:0;background:linear-gradient(135deg,'+hs.color+'0d 0%,transparent 70%);pointer-events:none"></div>'
      html += '<div style="font-size:10px;font-weight:700;color:'+hs.color+';text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px;position:relative">'+hs.lbl+'</div>'
