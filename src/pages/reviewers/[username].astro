                  <div style="flex:0 0 60px;height:5px;background:var(--tag-bg);border-radius:3px;overflow:hidden">
                    <div style={`height:100%;width:${g.pct}%;background:linear-gradient(to right,${c}88,${c});border-radius:3px`}></div>
                  </div>
                  <span style={`font-size:13px;color:${c};font-weight:600;width:20px;text-align:right`}>{g.count}</span>
