    el.innerHTML = html

    // ── SCATTER PLOTS ──
    ;(function() {
      var ns = 'http://www.w3.org/2000/svg'
      var L=42, T=10, cW=202, cH=150
      function mkEl(tag, a) {
        var e = document.createElementNS(ns, tag)
        for (var k in a) e.setAttribute(k, a[k])
        return e
      }
      function axTitles(el, xLabel, yLabel) {
        var xa = mkEl('text',{x:L+cW/2,y:T+cH+27,'text-anchor':'middle','font-size':'8',fill:'var(--text-secondary)','font-family':'DM Sans,sans-serif'})
        xa.textContent = xLabel; el.appendChild(xa)
        var ya = mkEl('text',{x:8,y:T+cH/2,'text-anchor':'middle','font-size':'8',fill:'var(--text-secondary)','font-family':'DM Sans,sans-serif',transform:'rotate(-90,8,'+(T+cH/2)+')'})
        ya.textContent = yLabel; el.appendChild(ya)
      }

      // ── Score scatter ──
      var scEl = document.getElementById('scatterSvg')
      if (scEl && s.perGameData && s.perGameData.length >= 3) {
        var scx = function(v) { return L + (v-0.5)/10*cW }
        var scy = function(v) { return T + (10.5-v)/10*cH }
        for (var vi=1; vi<=10; vi++) {
          scEl.appendChild(mkEl('line',{x1:scx(vi),y1:T,x2:scx(vi),y2:T+cH,stroke:'var(--border-subtle)','stroke-width':'0.4'}))
          scEl.appendChild(mkEl('line',{x1:L,y1:scy(vi),x2:L+cW,y2:scy(vi),stroke:'var(--border-subtle)','stroke-width':'0.4'}))
          var sxt = mkEl('text',{x:scx(vi),y:T+cH+12,'text-anchor':'middle','font-size':'7',fill:'var(--text-tertiary)','font-family':'DM Sans,sans-serif'})
          sxt.textContent = vi; scEl.appendChild(sxt)
          var syt = mkEl('text',{x:L-5,y:scy(vi)+2.5,'text-anchor':'end','font-size':'7',fill:'var(--text-tertiary)','font-family':'DM Sans,sans-serif'})
          syt.textContent = vi; scEl.appendChild(syt)
        }
        axTitles(scEl, 'Community avg', 'Your score')
        scEl.appendChild(mkEl('line',{x1:scx(0.5),y1:scy(0.5),x2:scx(10.5),y2:scy(10.5),stroke:'var(--text-tertiary)','stroke-width':'0.8','stroke-dasharray':'3 3',opacity:'0.4'}))
        s.perGameData.forEach(function(d) {
          var col = d.delta > 0.5 ? '#4ade80' : d.delta < -0.5 ? '#f87171' : '#60a5fa'
          var c = mkEl('circle',{cx:scx(d.commAvg),cy:scy(d.userScore),r:'3',fill:col,opacity:'0.85',style:'cursor:pointer'})
          var tip = document.createElementNS(ns,'title')
          tip.textContent = d.title+'\nYou: '+d.userScore+'  Community: '+d.commAvg+'  ('+(d.delta>0?'+':'')+d.delta+')'
          c.appendChild(tip); scEl.appendChild(c)
        })
      }

      // ── Hours scatter ──
      var hrEl = document.getElementById('scatterSvgHours')
      if (hrEl) {
        var hData = (s.perGameData || []).filter(function(d) {
          return d.userHours != null && d.userHours > 0 && d.commAvgHours != null && d.commAvgHours > 0
        })
        if (hData.length < 3) {
          var wrap = document.getElementById('hoursScatterWrap')
          if (wrap) wrap.style.display = 'none'
          var grid = document.getElementById('scatterGrid')
          if (grid) grid.style.gridTemplateColumns = '1fr'
        } else {
          var allH = hData.map(function(d) { return Math.max(d.userHours, d.commAvgHours) })
          var rawMax = Math.max.apply(null, allH)
          var rough = rawMax / 5
          var mag = Math.pow(10, Math.floor(Math.log10(Math.max(rough, 1))))
          var nr = rough / mag
          var niceS = nr < 1.5 ? mag : nr < 3 ? mag*2 : nr < 7 ? mag*5 : mag*10
          var niceMax = Math.ceil(rawMax / niceS) * niceS
          var hTicks = []
          for (var ti=0; ti <= niceMax + niceS*0.001; ti += niceS) hTicks.push(Math.round(ti))
          var hx = function(v) { return L + v/niceMax*cW }
          var hy = function(v) { return T + (1 - v/niceMax)*cH }
          hTicks.forEach(function(v) {
            hrEl.appendChild(mkEl('line',{x1:hx(v),y1:T,x2:hx(v),y2:T+cH,stroke:'var(--border-subtle)','stroke-width':'0.4'}))
            hrEl.appendChild(mkEl('line',{x1:L,y1:hy(v),x2:L+cW,y2:hy(v),stroke:'var(--border-subtle)','stroke-width':'0.4'}))
            var hlbl = v >= 1000 ? (v/1000)+'k' : String(v)
            var hxt = mkEl('text',{x:hx(v),y:T+cH+12,'text-anchor':'middle','font-size':'7',fill:'var(--text-tertiary)','font-family':'DM Sans,sans-serif'})
            hxt.textContent = hlbl; hrEl.appendChild(hxt)
            var hyt = mkEl('text',{x:L-5,y:hy(v)+2.5,'text-anchor':'end','font-size':'7',fill:'var(--text-tertiary)','font-family':'DM Sans,sans-serif'})
            hyt.textContent = hlbl; hrEl.appendChild(hyt)
          })
          axTitles(hrEl, 'Community avg hours', 'Your hours')
          hrEl.appendChild(mkEl('line',{x1:hx(0),y1:hy(0),x2:hx(niceMax),y2:hy(niceMax),stroke:'var(--text-tertiary)','stroke-width':'0.8','stroke-dasharray':'3 3',opacity:'0.4'}))
          hData.forEach(function(d) {
            var diff = d.userHours - d.commAvgHours
            var col = diff > 5 ? '#a78bfa' : diff < -5 ? '#fbbf24' : '#2dd4bf'
            var c = mkEl('circle',{cx:hx(d.commAvgHours),cy:hy(d.userHours),r:'3',fill:col,opacity:'0.85',style:'cursor:pointer'})
            var tip = document.createElementNS(ns,'title')
            tip.textContent = d.title+'\nYou: '+d.userHours+'h  Community: '+d.commAvgHours+'h  ('+(diff>0?'+':'')+Math.round(diff)+'h)'
            c.appendChild(tip); hrEl.appendChild(c)
          })
        }
      }
    })()

    // ── RENDER DOUBLE BAR ──
    function renderDoubleBar(view) {
      var container = document.getElementById('doubleBarChart')
      var legendA = document.getElementById('legendA')
      var legendB = document.getElementById('legendB')
      if (!container) return
      container.innerHTML = ''

      var data, labelKey, barAKey, barBKey, barAColor, barBColor, maxA, maxB, labelA, labelB, isCounts

      var genreColors
      if (view === 'genreActivity') {
        // warm palette: teal games bar, amber hours bar, each genre gets its own teal shade
        data = s.genreActivityData || []
        labelKey = 'name'; barAKey = 'games'; barBKey = 'hours'
        genreColors = ['#2dd4bf','#34d399','#4ade80','#a3e635','#facc15','#fb923c','#f87171','#f472b6']
        barAColor = '#2dd4bf'; barBColor = '#f59e0b'
        labelA = 'Games reviewed'; labelB = 'Hours played'
        maxA = Math.max.apply(null, data.map(function(d){return d[barAKey]}).concat([1]))
        maxB = Math.max.apply(null, data.map(function(d){return d[barBKey]}).concat([1]))
        isCounts = true
      } else if (view === 'genreRating') {
        // cool rose/pink palette: user coral, community muted rose
        data = s.genreRatingData || []
        labelKey = 'name'; barAKey = 'userAvg'; barBKey = 'commAvg'
        genreColors = ['#f43f5e','#fb7185','#e879f9','#c084fc','#a78bfa','#818cf8','#60a5fa','#38bdf8']
        barAColor = '#f43f5e'; barBColor = '#4a2030'
        labelA = 'Your avg'; labelB = 'Community avg'
        maxA = 10; maxB = 10; isCounts = false
      } else {
        // golden/amber palette: user gold, community muted dark gold
        data = s.yearRatingData || []
        labelKey = 'year'; barAKey = 'userAvg'; barBKey = 'commAvg'
        genreColors = null
        barAColor = '#f59e0b'; barBColor = '#3d2e00'
        labelA = 'Your avg'; labelB = 'Community avg'
        maxA = 10; maxB = 10; isCounts = false
      }

      if (legendA) legendA.textContent = labelA
      if (legendB) legendB.textContent = labelB
      var legendADot = document.getElementById('legendADot')
      if (legendADot) legendADot.style.background = barAColor
      var legendBDot = document.getElementById('legendBDot')
      if (legendBDot) legendBDot.style.background = barBColor

      if (!data || data.length === 0) {
        container.innerHTML = '<div style="padding:24px;text-align:center;color:var(--text-tertiary);font-size:13px">No data yet</div>'
        return
      }

      var chartH = 220
      var padTop = 28
      var padL = 40
      var padBottom = 64
      var n = data.length
      // fill the container width — compute from actual rendered width
      var containerW = container.getBoundingClientRect().width || 800
      var availW = containerW - padL - 16
      var groupSlot = Math.floor(availW / n)
      var barW = Math.max(22, Math.min(44, Math.floor(groupSlot * 0.42)))
      var gap = Math.max(4, Math.floor(barW * 0.25))
      var barGroupW = barW * 2 + gap
      var groupPad = Math.floor((groupSlot - barGroupW) / 2)
      var totalW = containerW

      var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg')
      svg.setAttribute('width', totalW)
      svg.setAttribute('height', chartH + padBottom + padTop)
      svg.style.display = 'block'
      svg.style.width = '100%'

      // y-axis gridlines + labels
      var ySteps = isCounts ? 4 : 5
      for (var yi = 0; yi <= ySteps; yi++) {
        var yVal = isCounts ? Math.round((yi/ySteps) * maxA) : (yi/ySteps) * 10
        var yPos = padTop + chartH - (yVal / (isCounts ? maxA : 10)) * chartH
        var gl = document.createElementNS('http://www.w3.org/2000/svg', 'line')
        gl.setAttribute('x1', padL); gl.setAttribute('x2', totalW - 4)
        gl.setAttribute('y1', yPos); gl.setAttribute('y2', yPos)
        gl.setAttribute('stroke', 'var(--border)'); gl.setAttribute('stroke-width', '1')
        gl.setAttribute('opacity', yi === 0 ? '0.6' : '0.25')
        svg.appendChild(gl)
        var yt = document.createElementNS('http://www.w3.org/2000/svg', 'text')
        yt.setAttribute('x', padL - 4); yt.setAttribute('y', yPos + 4)
        yt.setAttribute('text-anchor', 'end'); yt.setAttribute('font-size', '10')
        yt.setAttribute('fill', 'var(--text-secondary)'); yt.setAttribute('font-family', 'DM Sans,sans-serif')
        yt.textContent = isCounts ? yVal : yVal.toFixed(1)
        svg.appendChild(yt)
      }

      data.forEach(function(d, i) {
        var x = padL + i * groupSlot + groupPad

        var valA = d[barAKey] != null ? d[barAKey] : 0
        var valB = d[barBKey] != null ? d[barBKey] : 0
        var hA = Math.max(2, (valA / (isCounts ? maxA : 10)) * chartH)
        var hB = Math.max(2, (valB / (isCounts ? maxB : 10)) * chartH)

        // bar A — use per-bar color for activity view
        var thisBarAColor = genreColors ? genreColors[i % genreColors.length] : barAColor
        var rA = document.createElementNS('http://www.w3.org/2000/svg', 'rect')
        rA.setAttribute('x', x); rA.setAttribute('y', padTop + chartH - hA)
        rA.setAttribute('width', barW); rA.setAttribute('height', hA)
        rA.setAttribute('rx', '3'); rA.setAttribute('fill', thisBarAColor); rA.setAttribute('opacity', '0.85')
        rA.style.transition = 'opacity .15s'; rA.style.cursor = 'default'
        rA.addEventListener('mouseenter', function() { this.setAttribute('opacity','1') })
        rA.addEventListener('mouseleave', function() { this.setAttribute('opacity','0.85') })
        svg.appendChild(rA)

        // value label A
        var tA = document.createElementNS('http://www.w3.org/2000/svg', 'text')
        tA.setAttribute('x', x + barW/2); tA.setAttribute('y', padTop + chartH - hA - 5)
        tA.setAttribute('text-anchor', 'middle'); tA.setAttribute('font-size', '10')
        tA.setAttribute('fill', thisBarAColor); tA.setAttribute('font-weight', '600')
        tA.setAttribute('font-family', 'DM Sans,sans-serif')
        tA.textContent = isCounts ? valA : valA.toFixed(1)
        svg.appendChild(tA)

        // bar B (only if has data)
        if (d[barBKey] != null) {
          var rB = document.createElementNS('http://www.w3.org/2000/svg', 'rect')
          rB.setAttribute('x', x + barW + gap); rB.setAttribute('y', padTop + chartH - hB)
          rB.setAttribute('width', barW); rB.setAttribute('height', hB)
          rB.setAttribute('rx', '3'); rB.setAttribute('fill', barBColor); rB.setAttribute('opacity', '1')
          rB.style.transition = 'opacity .15s'; rB.style.cursor = 'default'
          rB.addEventListener('mouseenter', function() { this.setAttribute('opacity','0.9') })
          rB.addEventListener('mouseleave', function() { this.setAttribute('opacity','0.6') })
          svg.appendChild(rB)

          var tB = document.createElementNS('http://www.w3.org/2000/svg', 'text')
          tB.setAttribute('x', x + barW + gap + barW/2); tB.setAttribute('y', padTop + chartH - hB - 5)
          tB.setAttribute('text-anchor', 'middle'); tB.setAttribute('font-size', '10')
          tB.setAttribute('fill', barBColor); tB.setAttribute('font-weight', '600')
          tB.setAttribute('font-family', 'DM Sans,sans-serif')
          tB.textContent = isCounts ? valB : valB.toFixed(1)
          svg.appendChild(tB)
        }

        // x label (wrap long names)
        var labelText = String(d[labelKey])
        var words = labelText.split(' ')
        var line1 = words.slice(0, Math.ceil(words.length/2)).join(' ')
        var line2 = words.slice(Math.ceil(words.length/2)).join(' ')
        var xl = document.createElementNS('http://www.w3.org/2000/svg', 'text')
        xl.setAttribute('x', x + barW + gap/2); xl.setAttribute('y', padTop + chartH + 16)
        xl.setAttribute('text-anchor', 'middle'); xl.setAttribute('font-size', '10')
        xl.setAttribute('fill', 'var(--text-secondary)'); xl.setAttribute('font-family', 'DM Sans,sans-serif')
        if (line2) {
          var t1 = document.createElementNS('http://www.w3.org/2000/svg', 'tspan')
          t1.setAttribute('x', x + barW + gap/2); t1.setAttribute('dy', '0'); t1.textContent = line1
          var t2 = document.createElementNS('http://www.w3.org/2000/svg', 'tspan')
          t2.setAttribute('x', x + barW + gap/2); t2.setAttribute('dy', '14'); t2.textContent = line2
          xl.appendChild(t1); xl.appendChild(t2)
        } else {
          xl.textContent = line1
        }
        svg.appendChild(xl)

        // delta indicator for rating views — only show if meaningful difference
        if (!isCounts && d[barBKey] != null) {
          var delta = valA - valB
          if (Math.abs(delta) >= 0.1) {
            var dCol = delta > 0 ? '#4ade80' : '#f87171'
            var dStr = (delta > 0 ? '+' : '') + delta.toFixed(1)
            var dt = document.createElementNS('http://www.w3.org/2000/svg', 'text')
            dt.setAttribute('x', x + barW + gap/2); dt.setAttribute('y', padTop + chartH + (line2 ? 46 : 32))
            dt.setAttribute('text-anchor', 'middle'); dt.setAttribute('font-size', '10')
            dt.setAttribute('fill', dCol); dt.setAttribute('font-weight', '700')
            dt.setAttribute('font-family', 'DM Sans,sans-serif')
            dt.textContent = dStr; svg.appendChild(dt)
          }
        }
      })

      container.appendChild(svg)
    }

    // initial render — defer so container has measured width
    setTimeout(function() { renderDoubleBar('genreActivity') }, 30)
    window.renderDoubleBar = function(view) {
      // slight delay on dropdown change too so paint is complete
      setTimeout(function() { renderDoubleBar(view) }, 10)
    }

    var distRow = document.getElementById('statsDistRow')
    if (distRow && s.scoreDistribution) {
      var maxVal = Math.max.apply(null, s.scoreDistribution.concat([1]))
      var sBarsRow = document.createElement('div')
      sBarsRow.style.cssText = 'display:flex;gap:4px;align-items:flex-end;height:52px'
      var sLabelsRow = document.createElement('div')
      sLabelsRow.style.cssText = 'display:flex;gap:4px;margin-top:4px'
      s.scoreDistribution.forEach(function(count, i) {
        var bar = document.createElement('div')
        bar.style.cssText = 'flex:1;border-radius:3px 3px 0 0;min-height:3px;opacity:.75;background:'+barColors[i]+';height:'+Math.max(3,(count/maxVal)*52)+'px;transition:opacity .15s;cursor:default'
