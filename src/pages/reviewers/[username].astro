<script is:inline>
  (function () {
    var list = document.getElementById('profRecsList');
    var overview = document.getElementById('profRecsOverviewList');
    if (!list) return;
    var btns = document.querySelectorAll('.prof-rec-sort');
    function sortBy(mode) {
      if (mode === 'all') {
        list.style.display = 'none';
        if (overview) overview.style.display = '';
        return;
      }
      list.style.display = '';
      if (overview) overview.style.display = 'none';
      var items = Array.prototype.slice.call(list.querySelectorAll('.prof-rec-item'));
      items.sort(function (a, b) {
        var ca = new Date(a.dataset.created).getTime();
        var cb = new Date(b.dataset.created).getTime();
        var na = parseInt(a.dataset.net, 10);
        var nb = parseInt(b.dataset.net, 10);
        if (mode === 'recent') return cb - ca;
        if (mode === 'oldest') return ca - cb;
        if (mode === 'most_up') return (nb - na) || (cb - ca);
        if (mode === 'least_up') return (na - nb) || (cb - ca);
        return 0;
      });
      items.forEach(function (it) { list.appendChild(it); });
    }
    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        btns.forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        sortBy(btn.dataset.sort);
      });
    });
  })();
</script>


