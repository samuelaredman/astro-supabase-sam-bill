<script is:inline>
(function () {
  var btn = document.getElementById('achSyncBtn');
  if (!btn) return;

  var cursor = 0;
  var total = 0;
  var done = false;

  async function runBatch() {
    btn.disabled = true;
    btn.textContent = 'Syncing…';
    try {
      var res = await fetch('/api/steam/sync-achievements', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ cursor }),
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      var data = await res.json();
      total = data.total || total;
      cursor = data.nextCursor || cursor;
      done = data.done;

      if (!done && data.nextCursor) {
        var processed = cursor;
        btn.textContent = 'Syncing… ' + Math.round((processed / total) * 100) + '%';
        runBatch();
      } else {
        if (total === 0) {
          btn.textContent = 'No Steam games found — sync your library first';
        } else {
          btn.textContent = 'Done! Reload to see achievements';
        }
        btn.disabled = false;
      }
    } catch (e) {
      btn.textContent = 'Sync failed — try again';
      btn.disabled = false;
    }
  }

  btn.addEventListener('click', function () {
    cursor = 0;
    done = false;
    runBatch();
  });
})();
</script>
