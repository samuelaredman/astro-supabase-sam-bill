      })
      distRow.appendChild(sBarsRow)
      distRow.appendChild(sLabelsRow)
    }

    var lineEl = document.getElementById('statsLineChart')
    if (lineEl && s.monthLabels && s.monthCounts) {
      setTimeout(function() {
        var w = lineEl.getBoundingClientRect().width || 400
        var chartH = 72, padL = 4, padR = 4
        var pts = s.monthCounts, n = pts.length
        var step = (w-padL-padR)/(n-1)
        var maxM = Math.max.apply(null, pts.concat([1]))
        var coords = pts.map(function(v,i){return [padL+i*step, chartH-(v/maxM)*chartH*0.82-4]})
        for (var gi=0;gi<=2;gi++) {
          var gy = chartH-(gi/2)*chartH
          var gl = document.createElementNS('http://www.w3.org/2000/svg','line')
          gl.setAttribute('x1',padL);gl.setAttribute('x2',w-padR);gl.setAttribute('y1',gy);gl.setAttribute('y2',gy)
          gl.setAttribute('stroke','var(--border)');gl.setAttribute('stroke-width','1')
          lineEl.appendChild(gl)
        }
        var aPath = 'M'+coords[0][0]+','+chartH+coords.map(function(c){return ' L'+c[0]+','+c[1]}).join('')+' L'+coords[n-1][0]+','+chartH+' Z'
        var area = document.createElementNS('http://www.w3.org/2000/svg','path')
        area.setAttribute('d',aPath);area.setAttribute('fill','#6050c8');area.setAttribute('opacity','0.12')
        lineEl.appendChild(area)
        var lPath = 'M'+coords[0][0]+','+coords[0][1]+coords.slice(1).map(function(c){return ' L'+c[0]+','+c[1]}).join('')
        var line2 = document.createElementNS('http://www.w3.org/2000/svg','path')
        line2.setAttribute('d',lPath);line2.setAttribute('fill','none')
        line2.setAttribute('stroke','#6050c8');line2.setAttribute('stroke-width','2')
        line2.setAttribute('stroke-linecap','round');line2.setAttribute('stroke-linejoin','round')
        lineEl.appendChild(line2)
        coords.forEach(function(c,i) {
          var dot = document.createElementNS('http://www.w3.org/2000/svg','circle')
          dot.setAttribute('cx',c[0]);dot.setAttribute('cy',c[1])
          dot.setAttribute('r',pts[i]>0?'4':'2')
          dot.setAttribute('fill',pts[i]>0?'#6050c8':'var(--border)')
          dot.setAttribute('stroke','var(--bg-card)');dot.setAttribute('stroke-width','2')
          lineEl.appendChild(dot)
          if (pts[i]>0) {
            var txt = document.createElementNS('http://www.w3.org/2000/svg','text')
            txt.setAttribute('x',c[0]);txt.setAttribute('y',c[1]-8)
            txt.setAttribute('text-anchor','middle');txt.setAttribute('font-size','9')
            txt.setAttribute('fill','#6050c8');txt.setAttribute('font-family','DM Sans,sans-serif');txt.setAttribute('font-weight','600')
            txt.textContent = pts[i]; lineEl.appendChild(txt)
          }
          if (i % 2 === 0 || i === n-1) {
            var mlbl = document.createElementNS('http://www.w3.org/2000/svg','text')
            mlbl.setAttribute('x',c[0]);mlbl.setAttribute('y',chartH+16)
            mlbl.setAttribute('text-anchor','middle');mlbl.setAttribute('font-size','8')
            mlbl.setAttribute('fill','var(--text-secondary)');mlbl.setAttribute('font-family','DM Sans,sans-serif')
            mlbl.textContent = s.monthLabels[i]; lineEl.appendChild(mlbl)
          }
        })
      }, 60)
    }

    if (s.platformBreakdown && s.platformBreakdown.length > 0) {
      var pieSvg = document.getElementById('statsPieSvg')
      var pieLegend = document.getElementById('statsPieLegend')
      if (pieSvg && pieLegend) {
        var total = s.platformBreakdown.reduce(function(a,b){return a+b.count},0)
        var startAngle = -Math.PI/2, cx=40, cy=40, r=37
        s.platformBreakdown.forEach(function(p,i) {
          var angle=(p.count/total)*Math.PI*2, endAngle=startAngle+angle
          var x1=cx+r*Math.cos(startAngle),y1=cy+r*Math.sin(startAngle)
          var x2=cx+r*Math.cos(endAngle),y2=cy+r*Math.sin(endAngle)
          var path=document.createElementNS('http://www.w3.org/2000/svg','path')
          path.setAttribute('d','M'+cx+','+cy+' L'+x1+','+y1+' A'+r+','+r+' 0 '+(angle>Math.PI?1:0)+',1 '+x2+','+y2+' Z')
          path.setAttribute('fill',pieColors[i%pieColors.length]);path.setAttribute('opacity','0.85')
          pieSvg.appendChild(path); startAngle=endAngle
          var item=document.createElement('div')
          item.style.cssText='display:flex;align-items:center;gap:7px;min-width:0'
          item.innerHTML='<div style="width:8px;height:8px;border-radius:2px;flex-shrink:0;background:'+pieColors[i%pieColors.length]+'"></div>'
            +'<span style="font-size:12px;color:var(--text-primary);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+p.name+'</span>'
            +'<span style="font-size:12px;color:var(--text-secondary);font-weight:600">'+p.pct+'%</span>'
          pieLegend.appendChild(item)
        })
        var hole=document.createElementNS('http://www.w3.org/2000/svg','circle')
        hole.setAttribute('cx',cx);hole.setAttribute('cy',cy);hole.setAttribute('r',r*0.42)
        hole.setAttribute('fill','var(--bg-card)'); pieSvg.appendChild(hole)
      }
    }
  }

  if (activeTab === 'stats') buildStats()


  // ── THEME ──
  function toggleTheme() {
    var html = document.documentElement
    var next = html.getAttribute('data-theme') === 'light' ? 'dark' : 'light'
    html.setAttribute('data-theme', next)
    localStorage.setItem('theme', next)
    updateIcon(next)
    if (activeTab === 'stats') { var el = document.getElementById('statsContent'); if (el) { el.innerHTML = ''; buildStats() } }
  }
  function updateIcon(theme) {
    var icon = document.getElementById('revThemeIcon')
    if (!icon) return
    icon.innerHTML = theme === 'dark'
      ? '<path d="M15 10.5A7 7 0 016.5 3a7 7 0 100 12 7 7 0 008.5-4.5z"/>'
      : '<circle cx="9" cy="9" r="3.5"/><path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.22 3.22l1.42 1.42M13.36 13.36l1.42 1.42M13.36 4.64l1.42-1.42M3.22 14.78l1.42-1.42"/>'
  }
  window.toggleTheme = toggleTheme
  // Theme is already set by the inline <head> script — just sync the icon
  updateIcon(document.documentElement.getAttribute('data-theme') || 'dark')

  // ── FOLLOW ──
  // ── NOTIFY BELL — extracted so it can be attached to both server-rendered
  //    and dynamically created buttons ──────────────────────────────────────
  function attachNotifyListener(btn) {
    btn.addEventListener('click', async function() {
      var reviewerId = btn.dataset.reviewerId
      var notifying  = btn.dataset.notifying === 'true'
      var newNotifying = !notifying
      // Optimistic
      btn.dataset.notifying = newNotifying ? 'true' : 'false'
      btn.classList.toggle('notifying', newNotifying)
      btn.querySelector('svg').setAttribute('fill', newNotifying ? 'currentColor' : 'none')
      btn.title = newNotifying ? 'Turn off notifications' : 'Get notified when they post'
      try {
        var res = await fetch('/api/follows/notify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ following_id: reviewerId }),
        })
        var data = await res.json()
        if (!res.ok) throw new Error()
        btn.dataset.notifying = data.notify ? 'true' : 'false'
        btn.classList.toggle('notifying', data.notify)
        btn.querySelector('svg').setAttribute('fill', data.notify ? 'currentColor' : 'none')
        btn.title = data.notify ? 'Turn off notifications' : 'Get notified when they post'
      } catch(e) {
        // Revert on failure
        btn.dataset.notifying = notifying ? 'true' : 'false'
        btn.classList.toggle('notifying', notifying)
        btn.querySelector('svg').setAttribute('fill', notifying ? 'currentColor' : 'none')
      }
    })
  }

  // Attach to server-rendered bell (only present when already following on load)
  var existingNotifyBtn = document.getElementById('notifyBtn')
  if (existingNotifyBtn) attachNotifyListener(existingNotifyBtn)

  var followBtn = document.getElementById('followBtn')
  if (followBtn) {
    followBtn.addEventListener('mouseenter', function() {
      if (followBtn.dataset.following === 'true') followBtn.textContent = 'Unfollow'
    })
    followBtn.addEventListener('mouseleave', function() {
      if (followBtn.dataset.following === 'true') followBtn.textContent = 'Following'
    })
    followBtn.addEventListener('click', async function() {
      var reviewerId = followBtn.dataset.reviewerId
      var currentlyFollowing = followBtn.dataset.following === 'true'
      followBtn.disabled = true
      var res = await fetch('/api/follows/toggle', {
        method: currentlyFollowing ? 'DELETE' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ following_id: reviewerId }),
      })
      if (res.ok) {
        var nowFollowing = !currentlyFollowing
        followBtn.dataset.following = nowFollowing ? 'true' : 'false'
        followBtn.textContent = nowFollowing ? 'Following' : '+ Follow'
        followBtn.className = 'follow-btn ' + (nowFollowing ? 'following' : 'not-following')
        var countEl = document.getElementById('followerCount')
        if (countEl) countEl.textContent = String(parseInt(countEl.textContent) + (nowFollowing ? 1 : -1))

        if (nowFollowing) {
          // Inject the notify bell — it was never in the DOM since isFollowing was false at render
          var newNotifyBtn = document.createElement('button')
          newNotifyBtn.id = 'notifyBtn'
          newNotifyBtn.className = 'notify-btn'
          newNotifyBtn.dataset.reviewerId = reviewerId
          newNotifyBtn.dataset.notifying = 'false'
          newNotifyBtn.title = 'Get notified when they post'
          newNotifyBtn.innerHTML = '<svg width="15" height="15" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 6a4.5 4.5 0 0 0-9 0c0 5-2 6.5-2 6.5h13s-2-1.5-2-6.5"/><path d="M10.3 15a1.5 1.5 0 0 1-2.6 0"/></svg>'
          followBtn.parentNode.appendChild(newNotifyBtn)
          attachNotifyListener(newNotifyBtn)
        } else {
          // Remove the bell when unfollowing
          var bellBtn = document.getElementById('notifyBtn')
          if (bellBtn) bellBtn.remove()
        }

        if (typeof gtag === 'function' && nowFollowing) {
          gtag('event', 'follow_user', { reviewer_id: reviewerId });
        }
      }
      followBtn.disabled = false
    })
  }

  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closePicker() })

  // ── CLIENT-SIDE TAB SWITCHING ──
  // All tab content is server-rendered and already in the DOM.
  // Intercept clicks and toggle classes instead of doing a full page reload.
  var _statsBuilt = (activeTab === 'stats')
  document.querySelectorAll('.tab-link').forEach(function(link) {
    link.addEventListener('click', function(e) {
      e.preventDefault()
      var tab = new URL(link.href, location.origin).searchParams.get('tab') || 'overview'
      document.querySelectorAll('.tab-link').forEach(function(l) { l.classList.remove('active') })
      link.classList.add('active')
      document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active') })
      var panel = document.querySelector('.tab-panel[data-tab="' + tab + '"]')
      if (panel) panel.classList.add('active')
      history.pushState({}, '', '?tab=' + tab)
      if (tab === 'stats' && !_statsBuilt) { buildStats(); _statsBuilt = true }
    })
  })

  window.addEventListener('popstate', function() {
    var tab = new URLSearchParams(location.search).get('tab') || 'overview'
    document.querySelectorAll('.tab-link').forEach(function(l) { l.classList.remove('active') })
    var link = document.querySelector('.tab-link[href*="tab=' + tab + '"]')
    if (link) link.classList.add('active')
    document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active') })
    var panel = document.querySelector('.tab-panel[data-tab="' + tab + '"]')
    if (panel) panel.classList.add('active')
    if (tab === 'stats' && !_statsBuilt) { buildStats(); _statsBuilt = true }
  })
</script>
<ReportModal />
<EditModal />
<CropModal />
</Layout>
