---
export const prerender = false;
import { createSupabaseServerClientFromContext } from '../../utils/database';
import Layout from '../../components/Layout.astro';
import ReportModal from '../../components/ReportModal.astro';
import EditModal from '../../components/EditModal.astro';
import CropModal from '../../components/CropModal.astro';
import ReviewCard from '../../components/ReviewCard.astro';

const supabase = createSupabaseServerClientFromContext(Astro);
const { username } = Astro.params;
const activeTab = Astro.url.searchParams.get('tab') || 'overview'

const { data: { user } } = await supabase.auth.getUser();

const { data: reviewer, error: reviewerError } = await (supabase as any)
  .from('profiles')
  .select(`
    id, username, avatar_url, bio, banner_url, banner_position, created_at, is_active,
    favorite_game_id, showcase_games,
    favorite_game:games!favorite_game_id (
      id, title, slug, cover_img_url
    ),
    reviews (
      id, score, title, body, published_at, created_at,
      contains_spoilers, play_time_hours, status,
      played_on:platform_played_on ( id, name, slug ),
      games ( id, title, slug, cover_img_url, date_released, game_genres(genres(id, name, slug)) ),
      review_votes ( vote, profile_id ),
      review_reactions( reaction_type, profile_id ),
      review_comments( id )
    )
  `)
  .eq('username', username)
  .single();

if (reviewerError || !reviewer || !reviewer.is_active) return Astro.redirect('/404');

const publishedReviews = (reviewer.reviews ?? [])
  .filter((r: any) => r.status === 'published')
  .sort((a: any, b: any) =>
    new Date(b.published_at ?? b.created_at).getTime() -
    new Date(a.published_at ?? a.created_at).getTime()
  );

const avgScore = publishedReviews.length > 0
  ? (publishedReviews.reduce((sum: number, r: any) => sum + r.score, 0) / publishedReviews.length).toFixed(1)
  : null;

const totalHours = publishedReviews.reduce((sum: number, r: any) => sum + (r.play_time_hours ?? 0), 0)
const avgHours = publishedReviews.length > 0 ? Math.round(totalHours / publishedReviews.length) : null

const memberSince = reviewer.created_at
  ? new Date(reviewer.created_at).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
  : null;

const { count: followerCount } = await (supabase as any)
  .from('follows').select('*', { count: 'exact', head: true }).eq('following_id', reviewer.id);

const { count: followingCount } = await (supabase as any)
  .from('follows').select('*', { count: 'exact', head: true }).eq('follower_id', reviewer.id);

let currentProfile: any = null;
let isFollowing = false;
let isNotifying = false;
let isOwnProfile = false;

if (user) {
  const { data: cp } = await (supabase as any)
    .from('profiles').select('id').eq('auth_user_id', user.id).single();
  currentProfile = cp;
  if (currentProfile) {
    isOwnProfile = currentProfile.id === reviewer.id;
    if (!isOwnProfile) {
      const { data: followRow } = await (supabase as any)
        .from('follows').select('id, notify')
        .eq('follower_id', currentProfile.id).eq('following_id', reviewer.id).maybeSingle();
      isFollowing = !!followRow;
      isNotifying = followRow?.notify ?? false;
    }
  }
}

// favorite game — find reviewer's own review of it
const favGame = reviewer.favorite_game ?? null
const favReview = favGame
  ? publishedReviews.find((r: any) => r.games?.id === favGame.id) ?? null
  : null

// stats
const scoreDistribution = Array.from({ length: 10 }, (_, i) =>
  publishedReviews.filter((r: any) => Math.round(r.score) === i + 1).length
)
const platCounts: Record<string, number> = {}
for (const r of publishedReviews) {
  const name = (r as any).played_on?.name ?? 'Unknown'
  platCounts[name] = (platCounts[name] ?? 0) + 1
}
const platformBreakdown = Object.entries(platCounts)
  .sort((a, b) => b[1] - a[1]).slice(0, 5)
  .map(([name, count]) => ({ name, count, pct: Math.round((count / publishedReviews.length) * 100) }))

const genreCounts: Record<string, number> = {}
for (const r of publishedReviews) {
  const genres = (r as any).games?.game_genres ?? []
  for (const gg of genres) {
    const name = gg.genres?.name
    if (name) genreCounts[name] = (genreCounts[name] ?? 0) + 1
  }
}
const genreBreakdown = Object.entries(genreCounts)
  .sort((a, b) => b[1] - a[1]).slice(0, 6)
  .map(([name, count]) => ({ name, count, pct: Math.round((count / publishedReviews.length) * 100) }))

const monthlyActivity: Record<string, number> = {}
for (const r of publishedReviews) {
  const d = new Date((r as any).published_at ?? (r as any).created_at)
  const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`
  monthlyActivity[key] = (monthlyActivity[key] ?? 0) + 1
}
const monthLabels: string[] = []
const monthCounts: number[] = []
for (let i = 11; i >= 0; i--) {
  const d = new Date()
  d.setMonth(d.getMonth() - i)
  const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`
  monthLabels.push(d.toLocaleDateString('en-US', { month: 'short' }))
  monthCounts.push(monthlyActivity[key] ?? 0)
}

const recommendedCount = publishedReviews.filter((r: any) => r.score >= 7).length
const recommendedRate = publishedReviews.length > 0 ? Math.round((recommendedCount / publishedReviews.length) * 100) : 0

// score delta vs community — fetch avg score for each reviewed game
const reviewedGameIds = [...new Set(publishedReviews.map((r: any) => r.games?.id).filter(Boolean))]
let scoreDelta: number | null = null
if (reviewedGameIds.length > 0) {
  const { data: communityScores } = await (supabase as any)
    .from('reviews')
    .select('game_id, score')
    .in('game_id', reviewedGameIds)
    .eq('status', 'published')

  if (communityScores && communityScores.length > 0) {
    // build game avg map
    const gameScoreMap: Record<string, number[]> = {}
    for (const row of communityScores) {
      if (!gameScoreMap[row.game_id]) gameScoreMap[row.game_id] = []
      gameScoreMap[row.game_id].push(row.score)
    }
    const gameAvgMap: Record<string, number> = {}
    for (const [gid, scores] of Object.entries(gameScoreMap)) {
      gameAvgMap[gid] = (scores as number[]).reduce((a, b) => a + b, 0) / (scores as number[]).length
    }
    // compute delta per review
    const deltas: number[] = []
    for (const r of publishedReviews) {
      const gid = (r as any).games?.id
      if (gid && gameAvgMap[gid] !== undefined) {
        deltas.push((r as any).score - gameAvgMap[gid])
      }
    }
    if (deltas.length > 0) {
      scoreDelta = Math.round((deltas.reduce((a, b) => a + b, 0) / deltas.length) * 10) / 10
    }
  }
}

const recentGames = publishedReviews.slice(0, 6).map((r: any) => r.games).filter(Boolean)

// ── WATCHLIST ──
const { data: watchlistData } = await (supabase as any)
  .from('watchlist')
  .select('game_id, games(id, title, slug, cover_img_url)')
  .eq('profile_id', reviewer.id)
  .order('created_at', { ascending: false });
const watchlistGames = (watchlistData ?? []).map((w: any) => w.games).filter(Boolean);

// ── CHART DATA ──
// We reuse communityScores fetched above — build gameAvgMap here for chart use too
const _reviewedGameIds2 = [...new Set(publishedReviews.map((r: any) => r.games?.id).filter(Boolean))]
const _gameAvgMap2: Record<string, number> = {}
const _gameAvgHoursMap2: Record<string, number> = {}
if (_reviewedGameIds2.length > 0) {
  const { data: _cs2 } = await (supabase as any)
    .from('reviews').select('game_id, score, play_time_hours').in('game_id', _reviewedGameIds2).eq('status', 'published')
  if (_cs2) {
    const _m: Record<string, number[]> = {}
    const _mh: Record<string, number[]> = {}
    for (const row of _cs2) {
      if (!_m[row.game_id]) _m[row.game_id] = []
      _m[row.game_id].push(row.score)
      if (row.play_time_hours != null && row.play_time_hours > 0) {
        if (!_mh[row.game_id]) _mh[row.game_id] = []
        _mh[row.game_id].push(row.play_time_hours)
      }
    }
    for (const [gid, sc] of Object.entries(_m)) {
      _gameAvgMap2[gid] = (sc as number[]).reduce((a,b)=>a+b,0) / (sc as number[]).length
    }
    for (const [gid, hrs] of Object.entries(_mh)) {
      _gameAvgHoursMap2[gid] = Math.round((hrs as number[]).reduce((a,b)=>a+b,0) / (hrs as number[]).length)
    }
  }
}

// 1. Games & Hours by Genre
const _genreGameMap: Record<string, { games: number, hours: number }> = {}
for (const r of publishedReviews) {
  const genres = (r as any).games?.game_genres ?? []
  for (const gg of genres) {
    const name = gg.genres?.name; if (!name) continue
    if (!_genreGameMap[name]) _genreGameMap[name] = { games: 0, hours: 0 }
    _genreGameMap[name].games++
    _genreGameMap[name].hours += (r as any).play_time_hours ?? 0
  }
}
const genreActivityData = Object.entries(_genreGameMap)
  .sort((a,b) => b[1].games - a[1].games).slice(0, 8)
  .map(([name, d]) => ({ name, games: d.games, hours: d.hours }))

// 2. Ratings by Genre (user avg vs community avg)
const _genreUserScores: Record<string, number[]> = {}
const _genreCommScores: Record<string, number[]> = {}
for (const r of publishedReviews) {
  const genres = (r as any).games?.game_genres ?? []
  const gid = (r as any).games?.id
  for (const gg of genres) {
    const name = gg.genres?.name; if (!name) continue
    if (!_genreUserScores[name]) _genreUserScores[name] = []
    _genreUserScores[name].push((r as any).score)
    if (gid && _gameAvgMap2[gid] !== undefined) {
      if (!_genreCommScores[name]) _genreCommScores[name] = []
      _genreCommScores[name].push(_gameAvgMap2[gid])
    }
  }
}
const genreRatingData = Object.entries(_genreUserScores)
  .sort((a,b) => b[1].length - a[1].length).slice(0, 8)
  .map(([name, scores]) => ({
    name,
    userAvg: Math.round((scores.reduce((a,b)=>a+b,0)/scores.length)*10)/10,
    commAvg: _genreCommScores[name]?.length
      ? Math.round((_genreCommScores[name].reduce((a,b)=>a+b,0)/_genreCommScores[name].length)*10)/10
      : null
  }))

// 3. Ratings by Year (user avg vs community avg)
const _yearUserScores: Record<string, number[]> = {}
const _yearCommScores: Record<string, number[]> = {}
for (const r of publishedReviews) {
  const yr = (r as any).games?.date_released
    ? String(new Date((r as any).games.date_released).getFullYear()) : null
  const gid = (r as any).games?.id
  if (!yr) continue
  if (!_yearUserScores[yr]) _yearUserScores[yr] = []
  _yearUserScores[yr].push((r as any).score)
  if (gid && _gameAvgMap2[gid] !== undefined) {
    if (!_yearCommScores[yr]) _yearCommScores[yr] = []
    _yearCommScores[yr].push(_gameAvgMap2[gid])
  }
}
const yearRatingData = Object.entries(_yearUserScores)
  .sort((a,b) => parseInt(b[0]) - parseInt(a[0])).slice(0, 10)
  .map(([year, scores]) => ({
    year,
    userAvg: Math.round((scores.reduce((a,b)=>a+b,0)/scores.length)*10)/10,
    commAvg: _yearCommScores[year]?.length
      ? Math.round((_yearCommScores[year].reduce((a,b)=>a+b,0)/_yearCommScores[year].length)*10)/10
      : null
  }))

function igdbCover(url: string | null, size = 't_cover_big') {
  if (!url) return null
  const clean = url.startsWith('//') ? `https:${url}` : url
  return clean.replace(/t_[a-z0-9_]+/, size)
}
function timeAgo(dateStr: string): string {
  const diff = Math.floor((Date.now() - new Date(dateStr).getTime()) / 1000);
  if (diff < 60) return `${diff}s`;
  if (diff < 3600) return `${Math.floor(diff / 60)}m`;
  if (diff < 86400) return `${Math.floor(diff / 3600)}h`;
  if (diff < 604800) return `${Math.floor(diff / 86400)}d`;
  return `${Math.floor(diff / 604800)}w`;
}
function scoreClass(score: number): string {
  if (score === 10) return 'score-perfect'
  if (score >= 9) return 'score-great'
  if (score >= 8) return 'score-teal'
  if (score >= 7) return 'score-good'
  if (score >= 5) return 'score-mid'
  if (score >= 3) return 'score-orange'
  return 'score-low'
}
function getInitials(u: string): string { return u.slice(0, 2).toUpperCase() }

const bannerStyle = reviewer.banner_url
  ? `background-image:url('${reviewer.banner_url}');background-size:cover;background-position:${reviewer.banner_position ?? 'center'}`
  : ''

// Per-game scatter + hot takes
const perGameData = publishedReviews
  .map((r: any) => {
    const gid = (r as any).games?.id
    if (!gid || _gameAvgMap2[gid] === undefined) return null
    const commAvg = Math.round(_gameAvgMap2[gid] * 10) / 10
    return {
      title: (r as any).games?.title ?? '',
      slug: (r as any).games?.slug ?? '',
      userScore: (r as any).score as number,
      commAvg,
      delta: Math.round(((r as any).score - commAvg) * 10) / 10,
      userHours: (r as any).play_time_hours ?? null,
      commAvgHours: _gameAvgHoursMap2[gid] ?? null,
    }
  })
  .filter(Boolean) as { title: string; slug: string; userScore: number; commAvg: number; delta: number; userHours: number | null; commAvgHours: number | null }[]

const hotTakes = [...perGameData]
  .sort((a, b) => Math.abs(b.delta) - Math.abs(a.delta))
  .slice(0, 5)

const distJson = JSON.stringify(scoreDistribution)
const statsJson = JSON.stringify({
  reviewCount: publishedReviews.length,
  avgScore, avgHours, totalHours, recommendedRate, scoreDelta,
  platformBreakdown, genreBreakdown,
  genreActivityData, genreRatingData, yearRatingData,
  monthLabels, monthCounts, scoreDistribution,
  perGameData, hotTakes,
})
const isOwnProfileJson = JSON.stringify(isOwnProfile)
const showcaseJson = JSON.stringify(
  Array.isArray(reviewer.showcase_games) ? reviewer.showcase_games : []
)

// vote counting logic for reviews
function getVoteCounts(votes: any) {
  const arr = Array.isArray(votes) ? votes : votes ? [votes] : [];
  const up = arr.filter((v: any) => v.vote === 1).length;
  const down = arr.filter((v: any) => v.vote === -1).length;
  return { up, down };
}

// CDN cache — anonymous visitors share a cached response; auth users get a fresh render
if (!user) {
  Astro.response.headers.set('Netlify-CDN-Cache-Control', 'public, max-age=300, stale-while-revalidate=600');
  Astro.response.headers.set('Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}
Astro.response.headers.set('Netlify-Vary', 'cookie=sb-bzlwwtatoiyzwirerify-auth-token');

// ── SEO ──
const reviewerDescription = publishedReviews.length > 0
  ? `@${reviewer.username} has reviewed ${publishedReviews.length} game${publishedReviews.length !== 1 ? 's' : ''} on Chekpoint with an average score of ${avgScore}/10.${reviewer.bio ? ' ' + reviewer.bio.slice(0, 80) + '…' : ''}`
  : `@${reviewer.username}'s game reviews on Chekpoint.${reviewer.bio ? ' ' + reviewer.bio.slice(0, 100) + '…' : ''}`
const reviewerOgImage = reviewer.avatar_url ?? undefined
---

<Layout title={`@${reviewer.username} — Chekpoint`} description={reviewerDescription} ogImage={reviewerOgImage} variant="fullwidth">
  <Fragment slot="head">
    <!-- Profiles are not indexed until users explicitly consent to search-engine discovery -->
    <meta name="robots" content="noindex, nofollow" />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet" />
  </Fragment>
<style is:global>
    :root[data-theme="light"] {
      --bg:#f5f4f2;--bg-card:#ffffff;--bg-hover:#f4f3f0;
      --accent:#4a3a8a;--accent-sub:rgba(74,58,138,.06);
    }
    :root[data-theme="dark"] {
      --bg:#09090a;--bg-card:#131314;--bg-hover:#1c1c1e;
      --border:#222224;--border-subtle:#191919;
      --text-tertiary:#484644;--tag-bg:#1c1c1e;--tag-text:#6a6866;
      --shadow:0 1px 3px rgba(0,0,0,.5);--shadow-md:0 4px 16px rgba(0,0,0,.7);
      --score-perfect:#ffffff;--score-perfect-bg:#09090a;
      --score-great:#4ade80;--score-great-bg:#0b2016;
      --score-teal:#2dd4bf;--score-teal-bg:#0b1e1c;
      --score-good:#60a5fa;--score-good-bg:#0b1828;
      --score-mid:#fbbf24;--score-mid-bg:#1a1400;
      --score-orange:#fb923c;--score-orange-bg:#1f1008;
      --score-low:#f87171;--score-low-bg:#200808;
      --accent:#6050c8;--accent-sub:rgba(96,80,200,.09);
    }
    html{scroll-behavior:smooth}

    .topnav{position:sticky;top:0;z-index:30;background:rgba(9,9,10,.85);border-bottom:1px solid var(--border);padding:13px 28px;display:flex;align-items:center;gap:16px;backdrop-filter:blur(20px)}
    [data-theme="light"] .topnav{background:rgba(245,244,242,.85)}
    .back-btn{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--text-tertiary);transition:color .15s;background:none;border:none;cursor:pointer;font-family:inherit;padding:0}
    .back-btn:hover{color:var(--text-primary)}
    .logo{font-family:'Press Start 2P',monospace;font-size:13px;display:flex;align-items:center;gap:7px;margin-left:auto}
    .logo-dot{width:6px;height:6px;background:var(--accent);border-radius:50%;box-shadow:0 0 10px var(--accent)}
    .theme-btn{background:none;border:none;cursor:pointer;color:var(--text-tertiary);padding:6px;display:flex;margin-left:8px;transition:color .15s}

    /* BANNER */
    .profile-banner{width:100%;height:280px;background:linear-gradient(135deg,#1a1030 0%,#0d1a2e 40%,#0a1a1a 100%);position:relative;overflow:hidden}
    [data-theme="light"] .profile-banner{background:linear-gradient(135deg,#e8e4f8 0%,#dce8f5 40%,#daf0f0 100%)}
    .banner-glow{position:absolute;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,var(--accent) 0%,transparent 70%);opacity:.15;top:-120px;right:5%}
    .banner-glow2{position:absolute;width:200px;height:200px;border-radius:50%;background:radial-gradient(circle,#60a5fa 0%,transparent 70%);opacity:.1;top:-60px;left:20%}
    .banner-edit-btn{position:absolute;bottom:12px;right:16px;display:flex;align-items:center;gap:7px;background:rgba(0,0,0,.55);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.2);color:white;font-size:12px;font-weight:500;font-family:'DM Sans',sans-serif;padding:7px 14px;border-radius:20px;cursor:pointer;transition:background .15s;z-index:2}
    .banner-edit-btn:hover{background:rgba(0,0,0,.75)}
    .banner-uploading{position:absolute;inset:0;background:rgba(0,0,0,.5);display:none;align-items:center;justify-content:center;gap:10px;z-index:3}

    /* AVATAR */
    .profile-header{max-width:980px;margin:0 auto;padding:0 28px;position:relative}
    .avatar-wrap{position:absolute;top:-52px;left:28px}
    .avatar-container{position:relative;width:104px;height:104px;border-radius:50%}
    .avatar-lg{width:104px;height:104px;border-radius:50%;background:var(--bg-card);border:4px solid var(--bg);display:flex;align-items:center;justify-content:center;font-family:'DM Serif Display',serif;font-size:36px;color:var(--text-secondary);overflow:hidden;box-shadow:0 0 0 2px var(--accent)}
    .avatar-lg img{width:100%;height:100%;object-fit:cover}
    .avatar-edit-overlay{position:absolute;inset:0;border-radius:50%;background:rgba(0,0,0,.55);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;opacity:0;transition:opacity .2s;cursor:pointer;border:4px solid transparent}
    .avatar-container:hover .avatar-edit-overlay{opacity:1}
    .avatar-edit-overlay span{font-size:10px;font-weight:600;color:white;text-transform:uppercase;letter-spacing:.08em}
    .avatar-uploading{position:absolute;inset:0;border-radius:50%;background:rgba(0,0,0,.7);display:flex;align-items:center;justify-content:center;display:none}
    .spinner{width:24px;height:24px;border:2px solid rgba(255,255,255,.3);border-top-color:white;border-radius:50%;animation:spin .7s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}

    /* PROFILE INFO */
    .profile-info-row{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding-top:62px;padding-bottom:20px}
    .profile-left{flex:1;min-width:0}
    .profile-username{font-family:'Cinzel',serif;font-size:28px;font-weight:600;letter-spacing:.04em;margin-bottom:6px}
    .profile-bio-wrap{margin-bottom:10px;max-width:480px}
    .profile-bio{font-size:14px;color:var(--text-secondary);line-height:1.6;cursor:text;border-radius:6px;padding:4px 6px;transition:background .15s;margin:-4px -6px}
    .profile-bio:hover{background:var(--tag-bg)}
    .profile-bio.editing{display:none}
    .bio-textarea{width:100%;font-family:'DM Sans',sans-serif;font-size:14px;line-height:1.6;color:var(--text-primary);background:var(--bg-hover);border:1px solid var(--accent);border-radius:8px;padding:8px 10px;resize:none;outline:none;display:none}
    .bio-textarea.editing{display:block}
    .bio-actions{display:none;gap:8px;margin-top:6px}
    .bio-actions.editing{display:flex}
    .bio-empty{font-size:14px;color:var(--text-tertiary);font-style:italic;cursor:text;padding:4px 6px;border-radius:6px;transition:background .15s;display:inline-block}
    .bio-empty:hover{background:var(--tag-bg);color:var(--text-secondary)}
    .btn-sm{padding:5px 12px;border-radius:8px;font-size:12px;font-weight:500;font-family:inherit;cursor:pointer;border:none;transition:opacity .15s}
    .btn-sm-primary{background:var(--accent);color:white}
    .btn-sm-ghost{background:var(--tag-bg);color:var(--text-secondary)}
    .profile-stats-row{display:flex;align-items:center;gap:20px;flex-wrap:wrap}
    .profile-stat{display:flex;flex-direction:column;gap:2px}
    .pstat-val{font-family:'DM Serif Display',serif;font-size:20px;letter-spacing:-.3px;line-height:1}
    .pstat-lbl{font-size:11px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.08em}
    .profile-since{font-size:13px;color:var(--text-secondary);align-self:center}
    .follow-btn{padding:9px 22px;border-radius:22px;font-size:13px;font-weight:500;font-family:inherit;cursor:pointer;transition:all .15s;border:none}
    .follow-btn.not-following{background:var(--accent);color:white;box-shadow:0 4px 16px rgba(96,80,200,.35)}
    .follow-btn.not-following:hover{opacity:.88;transform:translateY(-1px)}
    .follow-btn.following{background:var(--tag-bg);color:var(--text-secondary);border:1px solid var(--border)}
    .follow-btn.following:hover{border-color:#c0392b;color:#c0392b}
    .notify-btn{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;border:1.5px solid var(--border);background:var(--bg-card);color:var(--text-tertiary);cursor:pointer;transition:all .15s;flex-shrink:0}
    .notify-btn:hover{border-color:var(--text-tertiary);color:var(--text-secondary)}
    .notify-btn.notifying{border-color:#f59e0b;color:#f59e0b;background:rgba(245,158,11,.08)}

    /* EDIT MODE */
    .edit-profile-btn{padding:8px 18px;border-radius:22px;font-size:13px;font-weight:500;font-family:inherit;cursor:pointer;border:1px solid var(--border);background:var(--bg-card);color:var(--text-secondary);transition:all .15s;display:flex;align-items:center;gap:7px}
    .edit-profile-btn:hover{border-color:var(--accent);color:var(--accent)}
    .edit-mode-bar{display:none;position:sticky;top:54px;z-index:25;background:var(--bg-card);border-bottom:1px solid var(--border);padding:10px 28px;align-items:center;justify-content:space-between;gap:12px;backdrop-filter:blur(12px)}
    .edit-mode-bar.visible{display:flex}
    .edit-mode-label{font-size:13px;font-weight:600;color:var(--accent);display:flex;align-items:center;gap:8px}
    .edit-mode-dot{width:7px;height:7px;border-radius:50%;background:var(--accent);animation:pulse2 1.5s infinite}
    @keyframes pulse2{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(.85)}}
    .edit-save-btn{padding:7px 18px;border-radius:20px;font-size:13px;font-weight:600;font-family:inherit;cursor:pointer;border:none;background:var(--accent);color:white;transition:opacity .15s}
    .edit-save-btn:hover{opacity:.88}
    .edit-save-btn:disabled{opacity:.5;cursor:not-allowed}
    .edit-cancel-btn{padding:7px 14px;border-radius:20px;font-size:13px;font-weight:500;font-family:inherit;cursor:pointer;border:1px solid var(--border);background:none;color:var(--text-secondary);transition:all .15s}
    .edit-cancel-btn:hover{border-color:var(--text-tertiary)}
    /* avatar only clickable in edit mode */
    .avatar-edit-overlay{display:none}
    body.editing-profile .avatar-edit-overlay{display:flex}
    body.editing-profile .avatar-container{cursor:pointer}
    /* banner edit only in edit mode */
    .banner-edit-btn{display:none}
    body.editing-profile .banner-edit-btn{display:flex}
    /* bio textarea only in edit mode */
    .profile-bio{cursor:default}
    body.editing-profile .profile-bio{display:none}
    body.editing-profile .bio-textarea{display:block}

    /* TABS */
    .page{max-width:980px;margin:0 auto;padding:20px 28px 80px}
    .tab-nav{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:24px}
    .tab-link{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:14px 12px;background:var(--bg-card);border:1px solid var(--border);border-radius:14px;cursor:pointer;transition:all .2s;position:relative;overflow:hidden;text-decoration:none}
    .tab-link::before{content:'';position:absolute;inset:0;background:var(--accent-sub);opacity:0;transition:opacity .2s}
    .tab-link:hover::before,.tab-link.active::before{opacity:1}
    .tab-link:hover{border-color:rgba(96,80,200,.35);transform:translateY(-2px);box-shadow:var(--shadow-md)}
    .tab-link.active{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent),0 4px 20px rgba(96,80,200,.15)}
    .tab-link.active::after{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--accent)}
    .tab-icon{width:28px;height:28px;border-radius:8px;background:var(--tag-bg);display:flex;align-items:center;justify-content:center}
    .tab-link.active .tab-icon,.tab-link:hover .tab-icon{background:var(--accent-sub)}
    .tab-link.active .tab-icon svg,.tab-link:hover .tab-icon svg{stroke:var(--accent)}
    .tab-label{font-size:13px;font-weight:600;color:var(--text-secondary);position:relative;z-index:1;transition:color .2s}
    .tab-link.active .tab-label,.tab-link:hover .tab-label{color:var(--text-primary)}
    .tab-meta{font-size:12px;color:var(--text-secondary);position:relative;z-index:1}
    .tab-link.active .tab-meta{color:var(--accent)}
    .tab-badge{background:var(--accent);color:white;font-size:10px;font-weight:700;padding:1px 7px;border-radius:10px;position:absolute;top:8px;right:8px;z-index:2}
    .tab-panel{display:none}
    .tab-panel.active{display:block}
    #reviewsList .rc{padding-left:0;padding-right:0}

    /* OVERVIEW */
    .two-col{display:grid;grid-template-columns:1fr 280px;gap:20px;align-items:start}
    @media(max-width:700px){.two-col{grid-template-columns:1fr}}
    .sidebar{display:flex;flex-direction:column;gap:14px}
    .card{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:16px;margin-bottom:14px}
    .card:last-child{margin-bottom:0}
    .card-title{font-size:11px;font-weight:700;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.1em;margin-bottom:12px}

    /* FAVORITE GAME */
    .fav-game-card{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;overflow:hidden;margin-bottom:14px;position:relative;height:160px}
    .fav-game-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 20%;display:block;opacity:.45}
    .fav-game-overlay{position:absolute;inset:0;background:linear-gradient(to bottom,transparent 20%,rgba(13,13,15,.96) 75%)}
    .fav-game-content{position:absolute;bottom:0;left:0;right:0;padding:16px;display:flex;gap:14px;align-items:flex-end}
    .fav-cover{width:56px;height:75px;border-radius:8px;object-fit:cover;border:1px solid rgba(96,80,200,.4);box-shadow:0 4px 20px rgba(0,0,0,.8);flex-shrink:0}
    .fav-info{flex:1;min-width:0}
    .fav-label{font-size:9px;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:.14em;margin-bottom:4px;opacity:.85}
    .fav-title{font-family:'Cinzel',serif;font-size:17px;font-weight:600;letter-spacing:.04em;margin-bottom:4px;line-height:1.1;color:#f0ede8}
    .fav-review-blurb{font-size:12px;color:rgba(240,237,232,.6);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .fav-score{flex-shrink:0;width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700;font-family:'Century Schoolbook',Georgia,serif}
    .fav-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px;text-align:center;gap:10px;cursor:pointer;transition:background .15s;border-radius:14px}
    .fav-empty:hover{background:var(--bg-hover)}
    .fav-empty-icon{width:44px;height:44px;border-radius:12px;background:var(--tag-bg);border:1px dashed var(--border);display:flex;align-items:center;justify-content:center;font-size:20px;transition:border-color .15s}
    .fav-empty:hover .fav-empty-icon{border-color:var(--accent)}

    /* SHOWCASE */
    .showcase-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
    .showcase-item{aspect-ratio:3/4;border-radius:10px;overflow:hidden;border:1px solid var(--border);position:relative;transition:transform .2s,border-color .2s;cursor:pointer}
    .showcase-item:hover{transform:translateY(-3px);border-color:rgba(96,80,200,.5)}
    .showcase-item img{width:100%;height:100%;object-fit:cover;display:block}
    .showcase-remove{position:absolute;top:6px;right:6px;width:22px;height:22px;background:rgba(0,0,0,.7);border-radius:50%;display:none;align-items:center;justify-content:center;cursor:pointer;color:white;font-size:14px;line-height:1}
    .showcase-item:hover .showcase-remove{display:flex}
    .showcase-empty{background:var(--tag-bg);border:1px dashed var(--border);border-radius:10px;aspect-ratio:3/4;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;transition:border-color .15s,background .15s;gap:8px;position:relative}
    .showcase-empty:hover{border-color:var(--accent);background:var(--bg-hover)}
    .showcase-empty span{font-size:10px;color:var(--text-tertiary)}

    /* RECENT */
    .recent-game{display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid var(--border-subtle)}
    .recent-game:last-child{border-bottom:none}
    .mini-cover{width:34px;height:45px;border-radius:5px;background:var(--tag-bg);overflow:hidden;flex-shrink:0;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:14px}
    .mini-cover img{width:100%;height:100%;object-fit:cover}
    .mini-score{flex-shrink:0;width:26px;height:26px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;font-family:'Century Schoolbook',Georgia,serif}
    .sidebar-list-btn{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;padding:10px 8px;border-radius:10px;border:1px solid var(--border);background:var(--bg-card);color:var(--text-secondary);font-size:11px;font-weight:500;transition:border-color .15s,color .15s;text-decoration:none;text-align:center}
    .sidebar-list-btn:hover{border-color:var(--accent);color:var(--accent)}
    .sidebar-list-btn svg{opacity:.6}
    .sidebar-list-btn:hover svg{opacity:1}
    .sidebar-list-count{font-size:12px;font-weight:700;color:var(--text-primary)}
    .dist-mini{margin-top:4px}
    .dist-bars-row{display:flex;gap:4px;align-items:flex-end;height:40px}
    .dist-labels-row{display:flex;gap:4px;margin-top:3px}
    .dist-bar{flex:1;border-radius:3px 3px 0 0;min-height:3px;opacity:.75}
    .dist-num{flex:1;text-align:center;font-size:10px;color:var(--text-secondary);font-weight:500}

    /* REVIEWS */
    .sort-tabs{display:flex;gap:6px;margin-bottom:16px}
    .sort-tab{background:var(--tag-bg);color:var(--text-secondary);border:1px solid var(--border);border-radius:20px;padding:5px 14px;font-size:12px;font-weight:500;font-family:inherit;cursor:pointer;transition:all .15s;text-transform:uppercase;letter-spacing:.04em}
    .sort-tab.active{background:var(--accent);color:white;border-color:transparent}
    .spoiler-pill{display:inline-flex;align-items:center;gap:4px;background:rgba(251,191,36,.08);color:#fbbf24;font-size:10px;font-weight:600;padding:2px 8px;border-radius:4px;margin-bottom:6px;text-transform:uppercase;letter-spacing:.06em;border:1px solid rgba(251,191,36,.2)}
    .expand-btn{font-size:11px;color:var(--accent);margin-left:auto;cursor:pointer;background:none;border:none;font-family:inherit;padding:0;font-weight:500}
    .empty-state{padding:60px 0;text-align:center;color:var(--text-tertiary)}
    .empty-title{font-family:'DM Serif Display',serif;font-size:20px;color:var(--text-secondary);margin-bottom:8px}
    .watchlist-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(90px,1fr));gap:14px;padding:20px 0}
    .watchlist-card{display:block;text-decoration:none}
    .watchlist-cover{width:100%;aspect-ratio:3/4;border-radius:8px;overflow:hidden;background:var(--tag-bg);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:24px;transition:transform .15s,box-shadow .15s;box-shadow:0 2px 8px rgba(0,0,0,.15)}
    .watchlist-card:hover .watchlist-cover{transform:translateY(-3px);box-shadow:0 8px 20px rgba(0,0,0,.3)}
    .watchlist-cover img{width:100%;height:100%;object-fit:cover;display:block}
    .watchlist-title{font-size:11px;font-weight:500;color:var(--text-secondary);margin-top:6px;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}

    /* VOTES FOR REVIEWS */
    .vote-row { display: flex; align-items: center; gap: 6px; margin-top: 8px; }
    .vote-btn { display: flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 20px; border: 1px solid var(--border); background: none; font-size: 12px; font-family: inherit; color: var(--text-secondary); cursor: pointer; transition: all 0.15s; }
    .vote-btn:hover { border-color: var(--text-secondary); color: var(--text-primary); }
    .vote-btn.active-up { background: var(--score-great-bg); color: var(--score-great); border-color: var(--score-great); }
    .vote-btn.active-down { background: var(--score-low-bg); color: var(--score-low); border-color: var(--score-low); }
    .rev-report-btn { margin-left: auto; font-size: 11px; color: var(--text-tertiary); background: none; border: none; cursor: pointer; font-family: inherit; padding: 2px 6px; border-radius: 6px; transition: color 0.15s, background 0.15s; }
    .rev-report-btn:hover { color: #f87171; background: rgba(248,113,113,.08); }
    .review-body.spoiler-hidden { filter: blur(4px); user-select: none; cursor: pointer; transition: filter 0.2s; }
    .review-body.spoiler-hidden:hover { filter: blur(3px); }

    /* GAME PICKER MODAL */
    .modal-backdrop{display:none;position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.7);backdrop-filter:blur(8px);align-items:center;justify-content:center;padding:20px}
    .modal-backdrop.open{display:flex}
    .modal{background:var(--bg-card);border:1px solid var(--border);border-radius:20px;width:100%;max-width:520px;max-height:80vh;display:flex;flex-direction:column;box-shadow:0 24px 80px rgba(0,0,0,.8)}
    .modal-header{padding:20px 20px 0;display:flex;align-items:center;justify-content:space-between}
    .modal-title{font-family:'DM Serif Display',serif;font-size:20px;letter-spacing:-.2px}
    .modal-close{background:none;border:none;cursor:pointer;color:var(--text-tertiary);padding:6px;display:flex;transition:color .15s;font-size:20px;line-height:1}
    .modal-close:hover{color:var(--text-primary)}
    .modal-search{padding:16px 20px}
    .modal-search-input{width:100%;background:var(--bg-hover);border:1px solid var(--border);border-radius:10px;padding:10px 14px;font-size:14px;font-family:inherit;color:var(--text-primary);outline:none;transition:border-color .15s}
    .modal-search-input:focus{border-color:var(--accent)}
    .modal-search-input::placeholder{color:var(--text-tertiary)}
    .modal-results{flex:1;overflow-y:auto;padding:0 20px 20px;scrollbar-width:thin}
    .modal-result{display:flex;align-items:center;gap:12px;padding:10px;border-radius:10px;cursor:pointer;transition:background .15s}
    .modal-result:hover{background:var(--bg-hover)}
    .modal-result-cover{width:38px;height:50px;border-radius:6px;object-fit:cover;border:1px solid var(--border);flex-shrink:0;background:var(--tag-bg);display:flex;align-items:center;justify-content:center;font-size:16px;overflow:hidden}
    .modal-result-cover img{width:100%;height:100%;object-fit:cover}
    .modal-result-title{font-size:14px;font-weight:500;margin-bottom:2px}
    .modal-result-meta{font-size:12px;color:var(--text-tertiary)}
    .modal-empty{padding:32px;text-align:center;color:var(--text-tertiary);font-size:14px}
    .modal-loading{padding:32px;text-align:center;color:var(--text-tertiary);display:flex;align-items:center;justify-content:center;gap:10px}

    /* TOAST */
    .toast{position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:10px 18px;font-size:13px;font-weight:500;box-shadow:var(--shadow-md);z-index:200;opacity:0;transition:all .3s;pointer-events:none;white-space:nowrap}
    .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
    .toast.success{border-color:rgba(74,222,128,.4);color:var(--score-great)}
    .toast.error{border-color:rgba(248,113,113,.4);color:var(--score-low)}

    @media(max-width:600px){
      .profile-username{font-size:22px}
      .page{padding:16px 16px 60px}
      .profile-header{padding:0 16px}
      .avatar-wrap{left:16px}
      .tab-nav{grid-template-columns:1fr}
    }
  </style>

<nav class="topnav">
  <button class="back-btn" onclick="history.length > 1 ? history.back() : (window.location.href='/')">
    <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12L6 8L10 4"/></svg>
    Back
  </button>
  <a href="/" class="logo"><span class="logo-dot"></span>Chekpoint</a>
  <button class="theme-btn" onclick="toggleTheme()">
    <svg id="revThemeIcon" width="17" height="17" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="9" cy="9" r="3.5"/>
      <path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.22 3.22l1.42 1.42M13.36 13.36l1.42 1.42M13.36 4.64l1.42-1.42M3.22 14.78l1.42-1.42"/>
    </svg>
  </button>
</nav>

<div class="profile-banner" id="profileBanner" style={bannerStyle}>
  {!reviewer.banner_url && <div class="banner-glow"></div>}
  {!reviewer.banner_url && <div class="banner-glow2"></div>}
  {isOwnProfile && (
    <div class="banner-edit-btn" onclick="document.getElementById('bannerInput').click()">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>
      Change banner
    </div>
  )}
  {isOwnProfile && (
    <div id="bannerUploading" style="display:none;position:absolute;inset:0;background:rgba(0,0,0,.5);align-items:center;justify-content:center;gap:10px;z-index:3">
      <div class="spinner" style="width:20px;height:20px;border-width:2px;border-color:rgba(255,255,255,.3);border-top-color:white"></div>
      <span style="font-size:13px;color:white;font-weight:500">Uploading…</span>
    </div>
  )}
  {isOwnProfile && <input type="file" id="bannerInput" accept="image/jpeg,image/png,image/webp,image/gif" style="display:none" />}
</div>

<div class="profile-header">
  <div class="avatar-wrap">
    <div class="avatar-container" id="avatarContainer">
      <div class="avatar-lg" id="avatarEl">
        {reviewer.avatar_url
          ? <img src={reviewer.avatar_url} alt={reviewer.username} id="avatarImg" />
          : <span id="avatarInitials">{getInitials(reviewer.username)}</span>
        }
      </div>
      {isOwnProfile && (
        <>
          <div class="avatar-edit-overlay" id="avatarOverlay" onclick="document.getElementById('avatarInput').click()">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>
            <span>Change</span>
          </div>
          <div class="avatar-uploading" id="avatarUploading">
            <div class="spinner"></div>
          </div>
          <input type="file" id="avatarInput" accept="image/*" style="display:none" />
        </>
      )}
    </div>
  </div>

  <div class="profile-info-row">
    <div class="profile-left">
      <h1 class="profile-username">
        <span style="font-family:'DM Sans',sans-serif;font-weight:300;opacity:.6;font-size:.8em;letter-spacing:0">@</span>{reviewer.username}
      </h1>

      <div class="profile-bio-wrap">
        {isOwnProfile ? (
          <>
            <div class="profile-bio" id="bioDisplay">
              {reviewer.bio || <span class="bio-empty" style="font-size:14px;color:var(--text-tertiary);font-style:italic">Add a bio…</span>}
            </div>
            <textarea
              class="bio-textarea"
              id="bioTextarea"
              rows={3}
              maxlength={300}
              placeholder="Tell people about yourself…"
              style="display:none;width:100%;font-family:'DM Sans',sans-serif;font-size:14px;line-height:1.6;color:var(--text-primary);background:var(--bg-hover);border:1px solid var(--accent);border-radius:8px;padding:8px 10px;resize:none;outline:none"
            >{reviewer.bio ?? ''}</textarea>
          </>
        ) : (
          reviewer.bio && <p class="profile-bio">{reviewer.bio}</p>
        )}
      </div>

      <div class="profile-stats-row">
        <div class="profile-stat">
          <span class="pstat-val">{publishedReviews.length}</span>
          <span class="pstat-lbl">Reviews</span>
        </div>
        {avgScore && (
          <div class="profile-stat">
            <span class="pstat-val">{avgScore}</span>
            <span class="pstat-lbl">Avg score</span>
          </div>
        )}
        <div class="profile-stat">
          <span class="pstat-val" id="followerCount">{followerCount ?? 0}</span>
          <span class="pstat-lbl">Followers</span>
        </div>
        <div class="profile-stat">
          <span class="pstat-val">{followingCount ?? 0}</span>
          <span class="pstat-lbl">Following</span>
        </div>
        {totalHours > 0 && (
          <div class="profile-stat">
            <span class="pstat-val">{totalHours}h</span>
            <span class="pstat-lbl">Hours logged</span>
          </div>
        )}
        {memberSince && <div class="profile-since">Since {memberSince}</div>}
      </div>
    </div>

    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:10px">
      {isOwnProfile && (
        <button class="edit-profile-btn" id="editProfileBtn" onclick="enterEditMode()">
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11.5 2.5a2.121 2.121 0 013 3L5 15l-4 1 1-4 9.5-9.5z"/></svg>
          Edit profile
        </button>
      )}
      {!isOwnProfile && user && (
        <div style="display:flex;align-items:center;gap:8px">
          <button
            class={`follow-btn ${isFollowing ? 'following' : 'not-following'}`}
            id="followBtn"
            data-reviewer-id={reviewer.id}
            data-following={isFollowing ? 'true' : 'false'}
          >
            {isFollowing ? 'Following' : '+ Follow'}
          </button>
          {isFollowing && (
            <button
              class={`notify-btn${isNotifying ? ' notifying' : ''}`}
              id="notifyBtn"
              data-reviewer-id={reviewer.id}
              data-notifying={isNotifying ? 'true' : 'false'}
              title={isNotifying ? 'Turn off notifications' : 'Get notified when they post'}
            >
              <svg width="15" height="15" viewBox="0 0 18 18" fill={isNotifying ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M13.5 6a4.5 4.5 0 0 0-9 0c0 5-2 6.5-2 6.5h13s-2-1.5-2-6.5"/>
                <path d="M10.3 15a1.5 1.5 0 0 1-2.6 0"/>
              </svg>
            </button>
          )}
        </div>
      )}
      {!isOwnProfile && !user && (
        <a href="/signin" class="follow-btn not-following">+ Follow</a>
      )}
    </div>
  </div>
</div>

