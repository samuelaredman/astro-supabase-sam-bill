    }

    el.innerHTML = html

    // ── SCATTER PLOTS ──
    ;(function() {
      var ns = 'http://www.w3.org/2000/svg'
      var L=42, T=10, cW=202, cH=150
      function mkEl(tag, a) {
        var e = document.createElementNS(ns, tag)
        for (var k in a) e.setAttribute(k, a[k])
        return e
      }
      function axTitles(el, xLabel, yLabel) {
        var xa = mkEl('text',{x:L+cW/2,y:T+cH+27,'text-anchor':'middle','font-size':'8',fill:'var(--text-secondary)','font-family':'DM Sans,sans-serif'})
        xa.textContent = xLabel; el.appendChild(xa)
        var ya = mkEl('text',{x:8,y:T+cH/2,'text-anchor':'middle','font-size':'8',fill:'var(--text-secondary)','font-family':'DM Sans,sans-serif',transform:'rotate(-90,8,'+(T+cH/2)+')'})
        ya.textContent = yLabel; el.appendChild(ya)
      }

      // ── Score scatter ──
      var scEl = document.getElementById('scatterSvg')
      if (scEl && s.perGameData && s.perGameData.length >= 3) {
        var scx = function(v) { return L + (v-0.5)/10*cW }
        var scy = function(v) { return T + (10.5-v)/10*cH }
        for (var vi=1; vi<=10; vi++) {
          scEl.appendChild(mkEl('line',{x1:scx(vi),y1:T,x2:scx(vi),y2:T+cH,stroke:'var(--border-subtle)','stroke-width':'0.4'}))
          scEl.appendChild(mkEl('line',{x1:L,y1:scy(vi),x2:L+cW,y2:scy(vi),stroke:'var(--border-subtle)','stroke-width':'0.4'}))
          var sxt = mkEl('text',{x:scx(vi),y:T+cH+12,'text-anchor':'middle','font-size':'7',fill:'var(--text-tertiary)','font-family':'DM Sans,sans-serif'})
          sxt.textContent = vi; scEl.appendChild(sxt)
          var syt = mkEl('text',{x:L-5,y:scy(vi)+2.5,'text-anchor':'end','font-size':'7',fill:'var(--text-tertiary)','font-family':'DM Sans,sans-serif'})
          syt.textContent = vi; scEl.appendChild(syt)
        }
        axTitles(scEl, 'Community avg', 'Your score')
        scEl.appendChild(mkEl('line',{x1:scx(0.5),y1:scy(0.5),x2:scx(10.5),y2:scy(10.5),stroke:'var(--text-tertiary)','stroke-width':'0.8','stroke-dasharray':'3 3',opacity:'0.4'}))
        s.perGameData.forEach(function(d) {
          var col = d.delta > 0.5 ? '#4ade80' : d.delta < -0.5 ? '#f87171' : '#60a5fa'
          var c = mkEl('circle',{cx:scx(d.commAvg),cy:scy(d.userScore),r:'3',fill:col,opacity:'0.85',style:'cursor:pointer'})
          var tip = document.createElementNS(ns,'title')
          tip.textContent = d.title+'\nYou: '+d.userScore+'  Community: '+d.commAvg+'  ('+(d.delta>0?'+':'')+d.delta+')'
          c.appendChild(tip); scEl.appendChild(c)
        })
      }

      // ── Hours scatter ──
      var hrEl = document.getElementById('scatterSvgHours')
      if (hrEl) {
        var hData = (s.perGameData || []).filter(function(d) {
          return d.userHours != null && d.userHours > 0 && d.commAvgHours != null && d.commAvgHours > 0
        })
        if (hData.length < 3) {
          var wrap = document.getElementById('hoursScatterWrap')
          if (wrap) wrap.style.display = 'none'
          var grid = document.getElementById('scatterGrid')
          if (grid) grid.style.gridTemplateColumns = '1fr'
        } else {
          var allH = hData.map(function(d) { return Math.max(d.userHours, d.commAvgHours) })
          var rawMax = Math.max.apply(null, allH)
          var rough = rawMax / 5
          var mag = Math.pow(10, Math.floor(Math.log10(Math.max(rough, 1))))
          var nr = rough / mag
          var niceS = nr < 1.5 ? mag : nr < 3 ? mag*2 : nr < 7 ? mag*5 : mag*10
          var niceMax = Math.ceil(rawMax / niceS) * niceS
          var hTicks = []
          for (var ti=0; ti <= niceMax + niceS*0.001; ti += niceS) hTicks.push(Math.round(ti))
          var hx = function(v) { return L + v/niceMax*cW }
          var hy = function(v) { return T + (1 - v/niceMax)*cH }
          hTicks.forEach(function(v) {
            hrEl.appendChild(mkEl('line',{x1:hx(v),y1:T,x2:hx(v),y2:T+cH,stroke:'var(--border-subtle)','stroke-width':'0.4'}))
            hrEl.appendChild(mkEl('line',{x1:L,y1:hy(v),x2:L+cW,y2:hy(v),stroke:'var(--border-subtle)','stroke-width':'0.4'}))
            var hlbl = v >= 1000 ? (v/1000)+'k' : String(v)
            var hxt = mkEl('text',{x:hx(v),y:T+cH+12,'text-anchor':'middle','font-size':'7',fill:'var(--text-tertiary)','font-family':'DM Sans,sans-serif'})
            hxt.textContent = hlbl; hrEl.appendChild(hxt)
            var hyt = mkEl('text',{x:L-5,y:hy(v)+2.5,'text-anchor':'end','font-size':'7',fill:'var(--text-tertiary)','font-family':'DM Sans,sans-serif'})
            hyt.textContent = hlbl; hrEl.appendChild(hyt)
          })
          axTitles(hrEl, 'Community avg hours', 'Your hours')
          hrEl.appendChild(mkEl('line',{x1:hx(0),y1:hy(0),x2:hx(niceMax),y2:hy(niceMax),stroke:'var(--text-tertiary)','stroke-width':'0.8','stroke-dasharray':'3 3',opacity:'0.4'}))
          hData.forEach(function(d) {
            var diff = d.userHours - d.commAvgHours
            var col = diff > 5 ? '#a78bfa' : diff < -5 ? '#fbbf24' : '#2dd4bf'
            var c = mkEl('circle',{cx:hx(d.commAvgHours),cy:hy(d.userHours),r:'3',fill:col,opacity:'0.85',style:'cursor:pointer'})
            var tip = document.createElementNS(ns,'title')
            tip.textContent = d.title+'\nYou: '+d.userHours+'h  Community: '+d.commAvgHours+'h  ('+(diff>0?'+':'')+Math.round(diff)+'h)'
            c.appendChild(tip); hrEl.appendChild(c)
          })
        }
      }
    })()

    // ── RENDER SINGLE BAR (genre charts) ──
    function renderSingleBar(key) {
      var container = document.getElementById('doubleBarChart')
      if (!container) return
      container.innerHTML = ''
      var data = s.genreActivityData || []
      if (!data.length) {
        container.innerHTML = '<div style="padding:24px;text-align:center;color:var(--text-tertiary);font-size:13px">No data yet</div>'
        return
      }
      var isHours = key === 'hours'
      var colors = isHours
        ? ['#a78bfa','#818cf8','#60a5fa','#38bdf8','#34d399','#4ade80','#fbbf24','#fb923c']
        : ['#2dd4bf','#34d399','#4ade80','#a3e635','#facc15','#fb923c','#f87171','#f472b6']
      // update legend for single-bar views
      var legendADot = document.getElementById('legendADot')
      var legendA = document.getElementById('legendA')
      var legendBItem = document.getElementById('legendBItem')
      if (legendADot) legendADot.style.background = isHours ? '#a78bfa' : '#2dd4bf'
      if (legendA) legendA.textContent = isHours ? 'Hours played' : 'Games reviewed'
      if (legendBItem) legendBItem.style.display = 'none'
      var maxVal = Math.max.apply(null, data.map(function(d){ return d[key] != null ? d[key] : 0 }).concat([1]))
      var chartH = 200, padTop = 24, padL = 36, padBottom = 52
      var n = data.length
      var containerW = container.getBoundingClientRect().width || 400
      var availW = containerW - padL - 8
      var groupSlot = Math.floor(availW / n)
      var barW = Math.max(14, Math.min(40, Math.floor(groupSlot * 0.65)))
      var groupPad = Math.floor((groupSlot - barW) / 2)
      var totalW = containerW
      var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg')
      svg.setAttribute('width', totalW)
      svg.setAttribute('height', chartH + padBottom + padTop)
      svg.style.display = 'block'; svg.style.width = '100%'
      for (var yi = 0; yi <= 4; yi++) {
        var yVal = Math.round((yi / 4) * maxVal)
        var yPos = padTop + chartH - (yVal / maxVal) * chartH
        var gl = document.createElementNS('http://www.w3.org/2000/svg', 'line')
        gl.setAttribute('x1', padL); gl.setAttribute('x2', totalW - 4)
        gl.setAttribute('y1', yPos); gl.setAttribute('y2', yPos)
        gl.setAttribute('stroke', 'var(--border)'); gl.setAttribute('stroke-width', '1')
        gl.setAttribute('opacity', yi === 0 ? '0.6' : '0.25')
        svg.appendChild(gl)
        var yt = document.createElementNS('http://www.w3.org/2000/svg', 'text')
        yt.setAttribute('x', padL - 4); yt.setAttribute('y', yPos + 4)
        yt.setAttribute('text-anchor', 'end'); yt.setAttribute('font-size', '10')
        yt.setAttribute('fill', 'var(--text-secondary)'); yt.setAttribute('font-family', 'DM Sans,sans-serif')
        yt.textContent = yVal
        svg.appendChild(yt)
      }
      data.forEach(function(d, i) {
        var x = padL + i * groupSlot + groupPad
        var val = d[key] != null ? d[key] : 0
        var h = Math.max(2, (val / maxVal) * chartH)
        var col = colors[i % colors.length]
        var r = document.createElementNS('http://www.w3.org/2000/svg', 'rect')
        r.setAttribute('x', x); r.setAttribute('y', padTop + chartH - h)
        r.setAttribute('width', barW); r.setAttribute('height', h)
        r.setAttribute('rx', '3'); r.setAttribute('fill', col); r.setAttribute('opacity', '0.85')
        r.style.transition = 'opacity .15s'
        r.addEventListener('mouseenter', function(){ this.setAttribute('opacity','1') })
        r.addEventListener('mouseleave', function(){ this.setAttribute('opacity','0.85') })
        svg.appendChild(r)
        var tv = document.createElementNS('http://www.w3.org/2000/svg', 'text')
        tv.setAttribute('x', x + barW / 2); tv.setAttribute('y', padTop + chartH - h - 4)
        tv.setAttribute('text-anchor', 'middle'); tv.setAttribute('font-size', '10')
        tv.setAttribute('fill', col); tv.setAttribute('font-weight', '600')
        tv.setAttribute('font-family', 'DM Sans,sans-serif')
        tv.textContent = isHours ? val + 'h' : val
        svg.appendChild(tv)
        var words = String(d.name).split(' ')
        var line1 = words.slice(0, Math.ceil(words.length / 2)).join(' ')
        var line2 = words.slice(Math.ceil(words.length / 2)).join(' ')
        var xl = document.createElementNS('http://www.w3.org/2000/svg', 'text')
        xl.setAttribute('x', x + barW / 2); xl.setAttribute('y', padTop + chartH + 14)
        xl.setAttribute('text-anchor', 'middle'); xl.setAttribute('font-size', '10')
        xl.setAttribute('fill', 'var(--text-secondary)'); xl.setAttribute('font-family', 'DM Sans,sans-serif')
        if (line2) {
          var t1 = document.createElementNS('http://www.w3.org/2000/svg', 'tspan')
          t1.setAttribute('x', x + barW / 2); t1.setAttribute('dy', '0'); t1.textContent = line1
          var t2 = document.createElementNS('http://www.w3.org/2000/svg', 'tspan')
          t2.setAttribute('x', x + barW / 2); t2.setAttribute('dy', '13'); t2.textContent = line2
          xl.appendChild(t1); xl.appendChild(t2)
        } else {
          xl.textContent = line1
        }
        svg.appendChild(xl)
      })
      container.appendChild(svg)
    }

    // ── RENDER DOUBLE BAR ──
    function renderDoubleBar(view) {
      var container = document.getElementById('doubleBarChart')
      var legendA = document.getElementById('legendA')
      var legendB = document.getElementById('legendB')
      if (!container) return
      container.innerHTML = ''

      var data, labelKey, barAKey, barBKey, barAColor, barBColor, maxA, maxB, labelA, labelB, isCounts

      var genreColors
      if (view === 'genreRating') {
        // cool rose/pink palette: user coral, community muted rose
        data = s.genreRatingData || []
        labelKey = 'name'; barAKey = 'userAvg'; barBKey = 'commAvg'
        genreColors = ['#f43f5e','#fb7185','#e879f9','#c084fc','#a78bfa','#818cf8','#60a5fa','#38bdf8']
        barAColor = '#f43f5e'; barBColor = '#4a2030'
        labelA = 'Your avg'; labelB = 'Community avg'
        maxA = 10; maxB = 10; isCounts = false
      } else {
        // golden/amber palette: user gold, community muted dark gold
        data = s.yearRatingData || []
        labelKey = 'year'; barAKey = 'userAvg'; barBKey = 'commAvg'
        genreColors = null
        barAColor = '#f59e0b'; barBColor = '#3d2e00'
        labelA = 'Your avg'; labelB = 'Community avg'
        maxA = 10; maxB = 10; isCounts = false
      }

      if (legendA) legendA.textContent = labelA
      if (legendB) legendB.textContent = labelB
      var legendADot = document.getElementById('legendADot')
      if (legendADot) legendADot.style.background = barAColor
      var legendBDot = document.getElementById('legendBDot')
      if (legendBDot) legendBDot.style.background = barBColor
      var legendBItem = document.getElementById('legendBItem')
      if (legendBItem) legendBItem.style.display = ''

      if (!data || data.length === 0) {
        container.innerHTML = '<div style="padding:24px;text-align:center;color:var(--text-tertiary);font-size:13px">No data yet</div>'
        return
      }

      var chartH = 220
      var padTop = 28
      var padL = 40
      var padBottom = 64
      var n = data.length
      // fill the container width — compute from actual rendered width
      var containerW = container.getBoundingClientRect().width || 800
      var availW = containerW - padL - 16
      var groupSlot = Math.floor(availW / n)
      var barW = Math.max(22, Math.min(44, Math.floor(groupSlot * 0.42)))
      var gap = Math.max(4, Math.floor(barW * 0.25))
      var barGroupW = barW * 2 + gap
      var groupPad = Math.floor((groupSlot - barGroupW) / 2)
      var totalW = containerW

      var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg')
      svg.setAttribute('width', totalW)
      svg.setAttribute('height', chartH + padBottom + padTop)
      svg.style.display = 'block'
      svg.style.width = '100%'

      // y-axis gridlines + labels
      var ySteps = isCounts ? 4 : 5
      for (var yi = 0; yi <= ySteps; yi++) {
        var yVal = isCounts ? Math.round((yi/ySteps) * maxA) : (yi/ySteps) * 10
        var yPos = padTop + chartH - (yVal / (isCounts ? maxA : 10)) * chartH
        var gl = document.createElementNS('http://www.w3.org/2000/svg', 'line')
        gl.setAttribute('x1', padL); gl.setAttribute('x2', totalW - 4)
        gl.setAttribute('y1', yPos); gl.setAttribute('y2', yPos)
        gl.setAttribute('stroke', 'var(--border)'); gl.setAttribute('stroke-width', '1')
        gl.setAttribute('opacity', yi === 0 ? '0.6' : '0.25')
        svg.appendChild(gl)
        var yt = document.createElementNS('http://www.w3.org/2000/svg', 'text')
        yt.setAttribute('x', padL - 4); yt.setAttribute('y', yPos + 4)
        yt.setAttribute('text-anchor', 'end'); yt.setAttribute('font-size', '10')
        yt.setAttribute('fill', 'var(--text-secondary)'); yt.setAttribute('font-family', 'DM Sans,sans-serif')
        yt.textContent = isCounts ? yVal : yVal.toFixed(1)
        svg.appendChild(yt)
      }

      data.forEach(function(d, i) {
        var x = padL + i * groupSlot + groupPad

        var valA = d[barAKey] != null ? d[barAKey] : 0
        var valB = d[barBKey] != null ? d[barBKey] : 0
        var hA = Math.max(2, (valA / (isCounts ? maxA : 10)) * chartH)
        var hB = Math.max(2, (valB / (isCounts ? maxB : 10)) * chartH)

        // bar A — use per-bar color for activity view
        var thisBarAColor = genreColors ? genreColors[i % genreColors.length] : barAColor
        var rA = document.createElementNS('http://www.w3.org/2000/svg', 'rect')
        rA.setAttribute('x', x); rA.setAttribute('y', padTop + chartH - hA)
        rA.setAttribute('width', barW); rA.setAttribute('height', hA)
        rA.setAttribute('rx', '3'); rA.setAttribute('fill', thisBarAColor); rA.setAttribute('opacity', '0.85')
        rA.style.transition = 'opacity .15s'; rA.style.cursor = 'default'
        rA.addEventListener('mouseenter', function() { this.setAttribute('opacity','1') })
        rA.addEventListener('mouseleave', function() { this.setAttribute('opacity','0.85') })
        svg.appendChild(rA)

        // value label A
        var tA = document.createElementNS('http://www.w3.org/2000/svg', 'text')
        tA.setAttribute('x', x + barW/2); tA.setAttribute('y', padTop + chartH - hA - 5)
        tA.setAttribute('text-anchor', 'middle'); tA.setAttribute('font-size', '10')
        tA.setAttribute('fill', thisBarAColor); tA.setAttribute('font-weight', '600')
        tA.setAttribute('font-family', 'DM Sans,sans-serif')
        tA.textContent = isCounts ? valA : valA.toFixed(1)
        svg.appendChild(tA)

        // bar B (only if has data)
        if (d[barBKey] != null) {
          var rB = document.createElementNS('http://www.w3.org/2000/svg', 'rect')
          rB.setAttribute('x', x + barW + gap); rB.setAttribute('y', padTop + chartH - hB)
          rB.setAttribute('width', barW); rB.setAttribute('height', hB)
          rB.setAttribute('rx', '3'); rB.setAttribute('fill', barBColor); rB.setAttribute('opacity', '1')
          rB.style.transition = 'opacity .15s'; rB.style.cursor = 'default'
          rB.addEventListener('mouseenter', function() { this.setAttribute('opacity','0.9') })
          rB.addEventListener('mouseleave', function() { this.setAttribute('opacity','0.6') })
          svg.appendChild(rB)

          var tB = document.createElementNS('http://www.w3.org/2000/svg', 'text')
          tB.setAttribute('x', x + barW + gap + barW/2); tB.setAttribute('y', padTop + chartH - hB - 5)
          tB.setAttribute('text-anchor', 'middle'); tB.setAttribute('font-size', '10')
          tB.setAttribute('fill', barBColor); tB.setAttribute('font-weight', '600')
          tB.setAttribute('font-family', 'DM Sans,sans-serif')
          tB.textContent = isCounts ? valB : valB.toFixed(1)
          svg.appendChild(tB)
        }

        // x label (wrap long names)
        var labelText = String(d[labelKey])
        var words = labelText.split(' ')
        var line1 = words.slice(0, Math.ceil(words.length/2)).join(' ')
        var line2 = words.slice(Math.ceil(words.length/2)).join(' ')
        var xl = document.createElementNS('http://www.w3.org/2000/svg', 'text')
        xl.setAttribute('x', x + barW + gap/2); xl.setAttribute('y', padTop + chartH + 16)
        xl.setAttribute('text-anchor', 'middle'); xl.setAttribute('font-size', '10')
        xl.setAttribute('fill', 'var(--text-secondary)'); xl.setAttribute('font-family', 'DM Sans,sans-serif')
        if (line2) {
          var t1 = document.createElementNS('http://www.w3.org/2000/svg', 'tspan')
          t1.setAttribute('x', x + barW + gap/2); t1.setAttribute('dy', '0'); t1.textContent = line1
          var t2 = document.createElementNS('http://www.w3.org/2000/svg', 'tspan')
          t2.setAttribute('x', x + barW + gap/2); t2.setAttribute('dy', '14'); t2.textContent = line2
          xl.appendChild(t1); xl.appendChild(t2)
        } else {
          xl.textContent = line1
        }
        svg.appendChild(xl)

        // delta indicator for rating views — only show if meaningful difference
        if (!isCounts && d[barBKey] != null) {
          var delta = valA - valB
          if (Math.abs(delta) >= 0.1) {
            var dCol = delta > 0 ? '#4ade80' : '#f87171'
            var dStr = (delta > 0 ? '+' : '') + delta.toFixed(1)
            var dt = document.createElementNS('http://www.w3.org/2000/svg', 'text')
            dt.setAttribute('x', x + barW + gap/2); dt.setAttribute('y', padTop + chartH + (line2 ? 46 : 32))
            dt.setAttribute('text-anchor', 'middle'); dt.setAttribute('font-size', '10')
            dt.setAttribute('fill', dCol); dt.setAttribute('font-weight', '700')
            dt.setAttribute('font-family', 'DM Sans,sans-serif')
            dt.textContent = dStr; svg.appendChild(dt)
          }
        }
      })

      container.appendChild(svg)
    }

    function renderChart(view) {
      setTimeout(function() {
        if (view === 'gamesGenre') renderSingleBar('games')
        else if (view === 'hoursGenre') renderSingleBar('hours')
        else renderDoubleBar(view)
      }, 10)
    }
    window.renderChart = renderChart

    // initial render — defer so container has measured width
    setTimeout(function() { renderSingleBar('games') }, 30)

    var distRow = document.getElementById('statsDistRow')
    if (distRow && s.scoreDistribution) {
      var maxVal = Math.max.apply(null, s.scoreDistribution.concat([1]))
      var sBarsRow = document.createElement('div')
      sBarsRow.style.cssText = 'display:flex;gap:4px;align-items:flex-end;height:52px'
      var sLabelsRow = document.createElement('div')
      sLabelsRow.style.cssText = 'display:flex;gap:4px;margin-top:4px'
      s.scoreDistribution.forEach(function(count, i) {
        var bar = document.createElement('div')
        bar.style.cssText = 'flex:1;border-radius:3px 3px 0 0;min-height:3px;opacity:.75;background:'+scoreCol(i+1)+';height:'+Math.max(3,(count/maxVal)*52)+'px;transition:opacity .15s;cursor:default'
        bar.title = 'Score '+(i+1)+': '+count+' review'+(count!==1?'s':'')
        bar.onmouseenter = function(){this.style.opacity='1'}
        bar.onmouseleave = function(){this.style.opacity='.75'}
        sBarsRow.appendChild(bar)
        var lbl = document.createElement('div')
        lbl.style.cssText = 'flex:1;text-align:center;font-size:10px;color:var(--text-secondary);font-weight:500'
        lbl.textContent = i+1
        sLabelsRow.appendChild(lbl)
      })
      distRow.appendChild(sBarsRow)
      distRow.appendChild(sLabelsRow)
    }

    var lineEl = document.getElementById('statsLineChart')
    if (lineEl && s.monthLabels && s.monthCounts) {
      setTimeout(function() {
        var w = lineEl.getBoundingClientRect().width || 400
        var chartH = 72, padL = 4, padR = 4
        var pts = s.monthCounts, n = pts.length
        var step = (w-padL-padR)/(n-1)
        var maxM = Math.max.apply(null, pts.concat([1]))
        var coords = pts.map(function(v,i){return [padL+i*step, chartH-(v/maxM)*chartH*0.82-4]})
        for (var gi=0;gi<=2;gi++) {
          var gy = chartH-(gi/2)*chartH
          var gl = document.createElementNS('http://www.w3.org/2000/svg','line')
          gl.setAttribute('x1',padL);gl.setAttribute('x2',w-padR);gl.setAttribute('y1',gy);gl.setAttribute('y2',gy)
          gl.setAttribute('stroke','var(--border)');gl.setAttribute('stroke-width','1')
          lineEl.appendChild(gl)
        }
        var aPath = 'M'+coords[0][0]+','+chartH+coords.map(function(c){return ' L'+c[0]+','+c[1]}).join('')+' L'+coords[n-1][0]+','+chartH+' Z'
        var area = document.createElementNS('http://www.w3.org/2000/svg','path')
        area.setAttribute('d',aPath);area.setAttribute('fill','#6050c8');area.setAttribute('opacity','0.12')
        lineEl.appendChild(area)
        var lPath = 'M'+coords[0][0]+','+coords[0][1]+coords.slice(1).map(function(c){return ' L'+c[0]+','+c[1]}).join('')
        var line2 = document.createElementNS('http://www.w3.org/2000/svg','path')
        line2.setAttribute('d',lPath);line2.setAttribute('fill','none')
        line2.setAttribute('stroke','#6050c8');line2.setAttribute('stroke-width','2')
        line2.setAttribute('stroke-linecap','round');line2.setAttribute('stroke-linejoin','round')
        lineEl.appendChild(line2)
        coords.forEach(function(c,i) {
          var dot = document.createElementNS('http://www.w3.org/2000/svg','circle')
          dot.setAttribute('cx',c[0]);dot.setAttribute('cy',c[1])
          dot.setAttribute('r',pts[i]>0?'4':'2')
          dot.setAttribute('fill',pts[i]>0?'#6050c8':'var(--border)')
          dot.setAttribute('stroke','var(--bg-card)');dot.setAttribute('stroke-width','2')
          lineEl.appendChild(dot)
          if (pts[i]>0) {
            var txt = document.createElementNS('http://www.w3.org/2000/svg','text')
            txt.setAttribute('x',c[0]);txt.setAttribute('y',c[1]-8)
            txt.setAttribute('text-anchor','middle');txt.setAttribute('font-size','9')
            txt.setAttribute('fill','#6050c8');txt.setAttribute('font-family','DM Sans,sans-serif');txt.setAttribute('font-weight','600')
            txt.textContent = pts[i]; lineEl.appendChild(txt)
          }
          if (i % 2 === 0 || i === n-1) {
            var mlbl = document.createElementNS('http://www.w3.org/2000/svg','text')
            mlbl.setAttribute('x',c[0]);mlbl.setAttribute('y',chartH+16)
            mlbl.setAttribute('text-anchor','middle');mlbl.setAttribute('font-size','8')
            mlbl.setAttribute('fill','var(--text-secondary)');mlbl.setAttribute('font-family','DM Sans,sans-serif')
            mlbl.textContent = s.monthLabels[i]; lineEl.appendChild(mlbl)
          }
        })
      }, 60)
    }

    if (s.platformBreakdown && s.platformBreakdown.length > 0) {
      var pieSvg = document.getElementById('statsPieSvg')
      var pieLegend = document.getElementById('statsPieLegend')
      if (pieSvg && pieLegend) {
        var total = s.platformBreakdown.reduce(function(a,b){return a+b.count},0)
        var startAngle = -Math.PI/2, cx=40, cy=40, r=37
        s.platformBreakdown.forEach(function(p,i) {
          var angle=(p.count/total)*Math.PI*2, endAngle=startAngle+angle
          var x1=cx+r*Math.cos(startAngle),y1=cy+r*Math.sin(startAngle)
          var x2=cx+r*Math.cos(endAngle),y2=cy+r*Math.sin(endAngle)
          var path=document.createElementNS('http://www.w3.org/2000/svg','path')
          path.setAttribute('d','M'+cx+','+cy+' L'+x1+','+y1+' A'+r+','+r+' 0 '+(angle>Math.PI?1:0)+',1 '+x2+','+y2+' Z')
          path.setAttribute('fill',pieColors[i%pieColors.length]);path.setAttribute('opacity','0.85')
          pieSvg.appendChild(path); startAngle=endAngle
          var item=document.createElement('div')
          item.style.cssText='display:flex;align-items:center;gap:7px;min-width:0'
          item.innerHTML='<div style="width:8px;height:8px;border-radius:2px;flex-shrink:0;background:'+pieColors[i%pieColors.length]+'"></div>'
            +'<span style="font-size:12px;color:var(--text-primary);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+p.name+'</span>'
            +'<span style="font-size:12px;color:var(--text-secondary);font-weight:600">'+p.pct+'%</span>'
          pieLegend.appendChild(item)
        })
        var hole=document.createElementNS('http://www.w3.org/2000/svg','circle')
        hole.setAttribute('cx',cx);hole.setAttribute('cy',cy);hole.setAttribute('r',r*0.42)
        hole.setAttribute('fill','var(--bg-card)'); pieSvg.appendChild(hole)
      }
    }
  }

  if (activeTab === 'stats') buildStats()

  // ── RECOMMENDATIONS ── (window.loadRecommendations is defined by the
  // module script below, shared with the global /recommendations page)

  // ── THEME ──
  function toggleTheme() {
    var html = document.documentElement
    var next = html.getAttribute('data-theme') === 'light' ? 'dark' : 'light'
    html.setAttribute('data-theme', next)
    localStorage.setItem('theme', next)
    updateIcon(next)
    if (activeTab === 'stats') { var el = document.getElementById('statsContent'); if (el) { el.innerHTML = ''; buildStats() } }
  }
  function updateIcon(theme) {
    var icon = document.getElementById('themeIcon')
    if (!icon) return
    icon.innerHTML = theme === 'dark'
      ? '<path d="M15 10.5A7 7 0 016.5 3a7 7 0 100 12 7 7 0 008.5-4.5z"/>'
      : '<circle cx="9" cy="9" r="3.5"/><path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.22 3.22l1.42 1.42M13.36 13.36l1.42 1.42M13.36 4.64l1.42-1.42M3.22 14.78l1.42-1.42"/>'
  }
  window.toggleTheme = toggleTheme
  // Theme is already set by the inline <head> script — just sync the icon
  updateIcon(document.documentElement.getAttribute('data-theme') || 'dark')

  // ── FOLLOW ──
  // ── NOTIFY BELL — extracted so it can be attached to both server-rendered
  //    and dynamically created buttons ──────────────────────────────────────
  function attachNotifyListener(btn) {
    btn.addEventListener('click', async function() {
      var reviewerId = btn.dataset.reviewerId
      var notifying  = btn.dataset.notifying === 'true'
      var newNotifying = !notifying
      // Optimistic
      btn.dataset.notifying = newNotifying ? 'true' : 'false'
      btn.classList.toggle('notifying', newNotifying)
      btn.querySelector('svg').setAttribute('fill', newNotifying ? 'currentColor' : 'none')
      btn.title = newNotifying ? 'Turn off notifications' : 'Get notified when they post'
      try {
        var res = await fetch('/api/follows/notify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ following_id: reviewerId }),
        })
        var data = await res.json()
        if (!res.ok) throw new Error()
        btn.dataset.notifying = data.notify ? 'true' : 'false'
        btn.classList.toggle('notifying', data.notify)
        btn.querySelector('svg').setAttribute('fill', data.notify ? 'currentColor' : 'none')
        btn.title = data.notify ? 'Turn off notifications' : 'Get notified when they post'
      } catch(e) {
        // Revert on failure
        btn.dataset.notifying = notifying ? 'true' : 'false'
        btn.classList.toggle('notifying', notifying)
        btn.querySelector('svg').setAttribute('fill', notifying ? 'currentColor' : 'none')
      }
    })
  }

  // Attach to server-rendered bell (only present when already following on load)
  var existingNotifyBtn = document.getElementById('notifyBtn')
  if (existingNotifyBtn) attachNotifyListener(existingNotifyBtn)

  var followBtn = document.getElementById('followBtn')
  if (followBtn) {
    followBtn.addEventListener('mouseenter', function() {
      if (followBtn.dataset.following === 'true') followBtn.textContent = 'Unfollow'
    })
    followBtn.addEventListener('mouseleave', function() {
      if (followBtn.dataset.following === 'true') followBtn.textContent = 'Following'
    })
    followBtn.addEventListener('click', async function() {
      var reviewerId = followBtn.dataset.reviewerId
      var currentlyFollowing = followBtn.dataset.following === 'true'
      followBtn.disabled = true
      var res = await fetch('/api/follows/toggle', {
        method: currentlyFollowing ? 'DELETE' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ following_id: reviewerId }),
      })
      if (res.ok) {
        var nowFollowing = !currentlyFollowing
        followBtn.dataset.following = nowFollowing ? 'true' : 'false'
        followBtn.textContent = nowFollowing ? 'Following' : '+ Follow'
        followBtn.className = 'follow-btn ' + (nowFollowing ? 'following' : 'not-following')
        var countEl = document.getElementById('followerCount')
        if (countEl) countEl.textContent = String(parseInt(countEl.textContent) + (nowFollowing ? 1 : -1))

        if (nowFollowing) {
          // Inject the notify bell — it was never in the DOM since isFollowing was false at render
          var newNotifyBtn = document.createElement('button')
          newNotifyBtn.id = 'notifyBtn'
          newNotifyBtn.className = 'notify-btn'
          newNotifyBtn.dataset.reviewerId = reviewerId
          newNotifyBtn.dataset.notifying = 'false'
          newNotifyBtn.title = 'Get notified when they post'
          newNotifyBtn.innerHTML = '<svg width="15" height="15" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 6a4.5 4.5 0 0 0-9 0c0 5-2 6.5-2 6.5h13s-2-1.5-2-6.5"/><path d="M10.3 15a1.5 1.5 0 0 1-2.6 0"/></svg>'
          followBtn.parentNode.appendChild(newNotifyBtn)
          attachNotifyListener(newNotifyBtn)
        } else {
          // Remove the bell when unfollowing
          var bellBtn = document.getElementById('notifyBtn')
          if (bellBtn) bellBtn.remove()
        }

        if (typeof gtag === 'function' && nowFollowing) {
          gtag('event', 'follow_user', { reviewer_id: reviewerId });
        }
      }
      followBtn.disabled = false
    })
  }

  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closePicker() })

  // ── CLIENT-SIDE TAB SWITCHING ──
  // All tab content is server-rendered and already in the DOM.
  // Intercept clicks and toggle classes instead of doing a full page reload.
  var _statsBuilt = (activeTab === 'stats')
  document.querySelectorAll('.tab-link').forEach(function(link) {
    link.addEventListener('click', function(e) {
      var tab = new URL(link.href, location.origin).searchParams.get('tab') || 'overview'
      if (tab === 'achievements') return; // needs SSR data, let browser navigate
      e.preventDefault()
      document.querySelectorAll('.tab-link').forEach(function(l) { l.classList.remove('active') })
      link.classList.add('active')
      document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active') })
      var panel = document.querySelector('.tab-panel[data-tab="' + tab + '"]')
      if (panel) panel.classList.add('active')
      history.replaceState({}, '', '?tab=' + tab)
      if (tab === 'stats' && !_statsBuilt) { buildStats(); _statsBuilt = true }
    })
  })

  window.addEventListener('popstate', function() {
    var tab = new URLSearchParams(location.search).get('tab') || 'overview'
    document.querySelectorAll('.tab-link').forEach(function(l) { l.classList.remove('active') })
    var link = document.querySelector('.tab-link[href*="tab=' + tab + '"]')
    if (link) link.classList.add('active')
    document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active') })
    var panel = document.querySelector('.tab-panel[data-tab="' + tab + '"]')
    if (panel) panel.classList.add('active')
    if (tab === 'stats' && !_statsBuilt) { buildStats(); _statsBuilt = true }
  })
</script>
<script>
  // Strip ?steam= param left by the OAuth callback — no auto-action, user syncs manually
  (function() {
    var sp = new URLSearchParams(window.location.search);
    if (!sp.has('steam')) return;
    sp.delete('steam');
    var q = sp.toString();
    history.replaceState(null, '', window.location.pathname + (q ? '?' + q : '') + window.location.hash);
  })();

  (window as any).profileSteamSync = async function profileSteamSync() {
    var btn = document.getElementById('profileSyncBtn') as HTMLButtonElement | null;
    var statusEl = document.getElementById('profileSyncStatus') as HTMLElement | null;
    if (!btn || btn.disabled) return;
    var username = btn.dataset.username ?? '';
    var playedOnly = !!(document.getElementById('profilePlayedOnly') as HTMLInputElement | null)?.checked;
    btn.disabled = true;
    btn.textContent = 'Syncing…';
    if (statusEl) { statusEl.textContent = ''; statusEl.style.display = 'none'; statusEl.style.color = 'var(--text-tertiary)'; }
    try {
      var res = await fetch('/api/steam/import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ playedOnly }),
      });
      var data = await res.json();
      if (!res.ok) {
        if (statusEl) { statusEl.textContent = data.error || 'Sync failed.'; statusEl.style.color = '#f87171'; statusEl.style.display = 'block'; }
      } else {
        var parts = [data.matched + ' new', data.updated + ' updated'];
        if (data.removed > 0) parts.push(data.removed + ' removed');
        if (statusEl) {
          statusEl.textContent = 'Synced — ' + parts.join(', ') + '. Reloading…';
          statusEl.style.display = 'block';
        }
        setTimeout(function() {
          window.location.assign('/reviewers/' + username + '?tab=library');
        }, 1500);
      }
    } catch (e) {
      if (statusEl) { statusEl.textContent = 'Network error.'; statusEl.style.color = '#f87171'; statusEl.style.display = 'block'; }
    } finally {
      btn.disabled = false;
      btn.textContent = 'Sync now';
    }
  };
</script>

<script is:inline>
async function createNewList(btn) {
  btn.disabled = true;
  btn.textContent = 'Creating…';
  try {
    var res = await fetch('/api/lists/create', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ title: 'Untitled List', visibility: 'public', shared_to_feed: true }),
    });
    var data = await res.json();
    if (res.ok && data.list_id) {
      window.location.href = '/lists/' + data.list_id + '/edit';
    } else {
      btn.disabled = false;
      btn.textContent = btn.dataset.label || '+ New list';
    }
  } catch (e) {
    btn.disabled = false;
    btn.textContent = btn.dataset.label || '+ New list';
  }
}
</script>
