        html += '<div style="flex:0 0 140px;height:8px;background:var(--tag-bg);border-radius:4px;overflow:hidden"><div style="height:100%;border-radius:4px;background:linear-gradient(to right,'+col+'99,'+col+');width:'+g.pct+'%"></div></div>'
        html += '<span style="font-size:13px;font-weight:700;color:'+col+';width:24px;text-align:right">'+g.count+'</span></div>'
      })
      html += '</div>'
    }

    // ── SCATTER PLOTS ──
    if (s.perGameData && s.perGameData.length >= 3) {
