<!-- TOAST -->
<div class="toast" id="toast"></div>

<script define:vars={{ distJson, statsJson, activeTab, isOwnProfile: isOwnProfileJson, reviewerUsername: reviewer.username, showcaseJson }}>

  var barColors = ['#f87171','#f87171','#fb923c','#fb923c','#fbbf24','#fbbf24','#60a5fa','#2dd4bf','#4ade80','#ffffff']
  var s = JSON.parse(statsJson)
  var ownProfile = JSON.parse(isOwnProfile)

  // ── TOAST ──
  function showToast(msg, type) {
    var t = document.getElementById('toast')
    t.textContent = msg
    t.className = 'toast show ' + (type || '')
    clearTimeout(t._timer)
    t._timer = setTimeout(function() { t.className = 'toast' }, 2500)
  }

  // ── EDIT MODE ──
  var _pendingAvatarFile = null
  var _pendingBannerFile = null
  var _pendingBannerPosition = null
  var _origBioValue = ''

  function enterEditMode() {
    document.body.classList.add('editing-profile')
    document.getElementById('editModeBar').classList.add('visible')
    document.getElementById('editProfileBtn').style.display = 'none'
    // show bio textarea
    var bioDisplay = document.getElementById('bioDisplay')
    var bioTextarea = document.getElementById('bioTextarea')
    if (bioDisplay) bioDisplay.style.display = 'none'
    if (bioTextarea) {
      _origBioValue = bioTextarea.value
      bioTextarea.style.display = 'block'
      bioTextarea.focus()
    }
  }

  function cancelEditMode() {
    document.body.classList.remove('editing-profile')
    document.getElementById('editModeBar').classList.remove('visible')
    document.getElementById('editProfileBtn').style.display = ''
    // restore bio
    var bioDisplay = document.getElementById('bioDisplay')
    var bioTextarea = document.getElementById('bioTextarea')
    if (bioTextarea) { bioTextarea.value = _origBioValue; bioTextarea.style.display = 'none' }
    if (bioDisplay) bioDisplay.style.display = ''
    // clear pending files
    _pendingAvatarFile = null
    _pendingBannerFile = null
    var avatarInput = document.getElementById('avatarInput')
    var bannerInput = document.getElementById('bannerInput')
    if (avatarInput) avatarInput.value = ''
    if (bannerInput) bannerInput.value = ''
  }
  window.enterEditMode = enterEditMode
  window.cancelEditMode = cancelEditMode

  async function saveProfile() {
    var saveBtn = document.getElementById('saveProfileBtn')
    saveBtn.disabled = true
    saveBtn.textContent = 'Saving…'
    var errors = []

    // 1. Upload avatar if pending
    if (_pendingAvatarFile) {
      var form = new FormData()
      form.append('avatar', _pendingAvatarFile)
      try {
        var res = await fetch('/api/profile/avatar', { method: 'POST', body: form })
        if (!res.ok) { var errText = await res.text(); throw new Error('Avatar upload failed: ' + res.status + ' ' + errText) }
        var data = await res.json()
        var img = document.getElementById('avatarImg')
        if (img) { img.src = data.url + '?t=' + Date.now() }
        else {
          var el = document.getElementById('avatarEl')
          if (el) el.innerHTML = '<img id="avatarImg" src="' + data.url + '?t=' + Date.now() + '" alt="" style="width:100%;height:100%;object-fit:cover" />'
        }
      } catch(e) { errors.push('Avatar: ' + (e?.message || 'upload failed')) }
    }

    // 2. Upload banner if pending
    if (_pendingBannerFile) {
      try {
        var presignRes = await fetch('/api/profile/banner-presign', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ fileType: _pendingBannerFile.type, fileSize: _pendingBannerFile.size })
        })
        var presignData = await presignRes.json()
        if (!presignRes.ok) throw new Error(presignData.error || 'Presign failed')
        var uploadForm = new FormData()
        uploadForm.append('cacheControl', '3600')
        uploadForm.append('', _pendingBannerFile)
        var uploadRes = await fetch(presignData.signedUrl, {
          method: 'PUT',
          body: uploadForm,
          headers: { 'x-upsert': 'true' }
        })
        if (!uploadRes.ok) { var errText = await uploadRes.text(); throw new Error('Storage upload failed: ' + uploadRes.status + ' — ' + errText) }
        var saveRes = await fetch('/api/profile/banner-save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ path: presignData.path, banner_position: _pendingBannerPosition || 'center' })
        })
        var bdata = await saveRes.json()
        if (!saveRes.ok) throw new Error(bdata.error || 'Save failed')
        var banner = document.getElementById('profileBanner')
        if (banner) {
          banner.style.backgroundImage = 'url(\'' + bdata.url + '\')'
          banner.style.backgroundSize = 'cover'
          banner.style.backgroundPosition = _pendingBannerPosition || 'center'
          banner.querySelectorAll('.banner-glow,.banner-glow2').forEach(function(el){ el.style.display='none' })
        }
      } catch(e) { errors.push('Banner: ' + (e?.message || 'upload failed')) }
    }

    // 3. Save bio
    var bioTextarea = document.getElementById('bioTextarea')
    if (bioTextarea) {
      var newBio = bioTextarea.value.trim()
      try {
        var bres2 = await fetch('/api/profile/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ bio: newBio })
        })
        if (!bres2.ok) throw new Error()
        // update display
        var bioDisplay = document.getElementById('bioDisplay')
        if (bioDisplay) {
          bioDisplay.textContent = newBio
          if (!newBio) bioDisplay.innerHTML = '<span style="font-size:14px;color:var(--text-tertiary);font-style:italic">Add a bio…</span>'
        }
      } catch(e) { errors.push('Bio save failed') }
    }

    saveBtn.disabled = false
    saveBtn.textContent = 'Save changes'

    if (errors.length) {
      showToast(errors.join(' · '), 'error')
    } else {
      showToast('Profile saved', 'success')
      // exit edit mode
      document.body.classList.remove('editing-profile')
      document.getElementById('editModeBar').classList.remove('visible')
      document.getElementById('editProfileBtn').style.display = ''
      var bioTextarea2 = document.getElementById('bioTextarea')
      var bioDisplay2 = document.getElementById('bioDisplay')
      if (bioTextarea2) bioTextarea2.style.display = 'none'
      if (bioDisplay2) bioDisplay2.style.display = ''
      _pendingAvatarFile = null
      _pendingBannerFile = null
      _pendingBannerPosition = null
    }
  }
  window.saveProfile = saveProfile

  // ── AVATAR — crop, stage, show preview ──
  var avatarInput = document.getElementById('avatarInput')
  if (avatarInput) {
    avatarInput.addEventListener('change', async function() {
      var file = avatarInput.files[0]
      if (!file) return
      if (file.size > 5 * 1024 * 1024) { showToast('Image must be under 5MB', 'error'); avatarInput.value = ''; return }
      var blob
      try {
        blob = await window.openImageCropper(file, { aspectRatio: 1, minWidth: 200, minHeight: 200, title: 'Crop Avatar' })
      } catch(e) { avatarInput.value = ''; return }
      var croppedFile = new File([blob], 'avatar.' + (blob.type === 'image/png' ? 'png' : 'jpg'), { type: blob.type })
      _pendingAvatarFile = croppedFile
      var reader = new FileReader()
      reader.onload = function(ev) {
        var img = document.getElementById('avatarImg')
        if (img) { img.src = ev.target.result }
        else {
          var el = document.getElementById('avatarEl')
          if (el) el.innerHTML = '<img id="avatarImg" src="' + ev.target.result + '" alt="" style="width:100%;height:100%;object-fit:cover" />'
        }
      }
      reader.readAsDataURL(croppedFile)
      showToast('Avatar ready — click Save to apply', 'success')
      avatarInput.value = ''
    })
  }

  // ── BANNER — crop, stage, show preview ──
  var bannerInput = document.getElementById('bannerInput')
  if (bannerInput) {
    bannerInput.addEventListener('change', async function() {
      var file = bannerInput.files[0]
      if (!file) return
      if (file.size > 15 * 1024 * 1024) { showToast('Banner must be under 15MB', 'error'); bannerInput.value = ''; return }
      var uploadFile = file
      var pendingPosition = 'center'
      if (file.type === 'image/gif') {
        var valid = await new Promise(function(res) {
          var img = new Image(), url = URL.createObjectURL(file)
          img.onload = function() { URL.revokeObjectURL(url); res(img.width >= 1200 && img.height >= 300) }
          img.onerror = function() { URL.revokeObjectURL(url); res(false) }
          img.src = url
        })
        if (!valid) { showToast('Banner must be at least 1200 × 300 px', 'error'); bannerInput.value = ''; return }
        var bannerEl2 = document.getElementById('profileBanner')
        var bannerAspect2 = bannerEl2 ? bannerEl2.offsetWidth / bannerEl2.offsetHeight : window.innerWidth / 280
        try {
          pendingPosition = await window.openGifPositioner(file, { aspectRatio: bannerAspect2, title: 'Position GIF' })
        } catch(e) { bannerInput.value = ''; return }
      } else {
        var blob
        try {
          var bannerEl = document.getElementById('profileBanner')
          var bannerAspect = bannerEl ? bannerEl.offsetWidth / bannerEl.offsetHeight : window.innerWidth / 280
          blob = await window.openImageCropper(file, { aspectRatio: bannerAspect, minWidth: 1200, minHeight: 300, title: 'Crop Banner' })
        } catch(e) { bannerInput.value = ''; return }
        uploadFile = new File([blob], 'banner.' + (blob.type === 'image/png' ? 'png' : 'jpg'), { type: blob.type })
      }
      _pendingBannerFile = uploadFile
      _pendingBannerPosition = pendingPosition
      var previewReader = new FileReader()
      previewReader.onload = function(ev) {
        var banner = document.getElementById('profileBanner')
        if (banner) {
          banner.style.backgroundImage = 'url(\'' + ev.target.result + '\')'
          banner.style.backgroundSize = 'cover'
          banner.style.backgroundPosition = pendingPosition
          banner.querySelectorAll('.banner-glow,.banner-glow2').forEach(function(el){ el.style.display='none' })
        }
      }
      previewReader.readAsDataURL(uploadFile)
      showToast('Banner ready — click Save to apply', 'success')
      bannerInput.value = ''
    })
  }

  // ── GAME PICKER MODAL ──


  var _pickerMode = 'favorite'
  var _pickerSlot = 0
  var _searchTimer = null

  function openGamePicker(mode, slot) {
    _pickerMode = mode
    _pickerSlot = slot ?? 0
    document.getElementById('pickerTitle').textContent = mode === 'favorite' ? 'Set favorite game' : 'Add to showcase'
    document.getElementById('pickerSearch').value = ''
    document.getElementById('pickerResults').innerHTML = '<div class="modal-empty">Start typing to search games…</div>'
    document.getElementById('gamePickerModal').classList.add('open')
    setTimeout(function() { document.getElementById('pickerSearch').focus() }, 100)
  }
  function closePicker() { document.getElementById('gamePickerModal').classList.remove('open') }
  function closePickerOnBackdrop(e) { if (e.target === document.getElementById('gamePickerModal')) closePicker() }
  window.openGamePicker = openGamePicker
  window.closePicker = closePicker
  window.closePickerOnBackdrop = closePickerOnBackdrop

  function debouncedSearch(q) {
    clearTimeout(_searchTimer)
    if (!q.trim()) { document.getElementById('pickerResults').innerHTML = '<div class="modal-empty">Start typing to search games…</div>'; return }
    _searchTimer = setTimeout(function() { searchGames(q) }, 300)
  }
  window.debouncedSearch = debouncedSearch

  async function searchGames(q) {
    var resultsEl = document.getElementById('pickerResults')
    resultsEl.innerHTML = '<div class="modal-loading"><div class="spinner" style="width:18px;height:18px;border-width:2px"></div> Searching…</div>'
    try {
      var res = await fetch('/api/games/search?q=' + encodeURIComponent(q) + '&limit=10')
      if (!res.ok) throw new Error()
      var games = await res.json()
      if (!games.length) { resultsEl.innerHTML = '<div class="modal-empty">No games found for "' + q + '"</div>'; return }
      resultsEl.innerHTML = ''
      games.forEach(function(game) {
        var item = document.createElement('div')
        item.className = 'modal-result'
        var coverUrl = game.cover_img_url ? game.cover_img_url.replace(/t_[a-z0-9_]+/, 't_cover_big') : null
        item.innerHTML = '<div class="modal-result-cover">' + (coverUrl ? '<img src="' + coverUrl + '" alt="" />' : '🎮') + '</div>'
          + '<div><div class="modal-result-title">' + game.title + '</div>'
          + '<div class="modal-result-meta">' + (game.date_released ? new Date(game.date_released).getFullYear() : '') + '</div></div>'
        item.onclick = function() { selectGame(game) }
        resultsEl.appendChild(item)
      })
    } catch(e) { resultsEl.innerHTML = '<div class="modal-empty">Search failed — try again</div>' }
  }

  async function selectGame(game) {
    closePicker()
    if (_pickerMode === 'favorite') {
      try {
        var res = await fetch('/api/profile/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ favorite_game_id: game.id })
        })
        if (!res.ok) throw new Error()
        // Update the favorite game card in-place without reloading
        updateFavGameCard(game)
        showToast('Favorite game saved', 'success')
      } catch(e) { showToast('Failed to save — try again', 'error') }
    } else {
      var showcase = currentShowcase.slice()
      while (showcase.length < 3) showcase.push(null)
      showcase[_pickerSlot] = { id: game.id, title: game.title, cover_img_url: game.cover_img_url, slug: game.slug }
      try {
        var sres = await fetch('/api/profile/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ showcase_games: showcase.filter(Boolean) })
        })
        if (!sres.ok) throw new Error()
        currentShowcase = showcase.slice()
        renderShowcase(currentShowcase)
        showToast('Showcase updated', 'success')
      } catch(e) { showToast('Failed to save showcase — try again', 'error') }
    }
  }

  function updateFavGameCard(game) {
    var container = document.getElementById('favGameCard')
    if (!container) {
      var emptyCard = document.querySelector('.fav-game-card')
      if (emptyCard) container = emptyCard
    }
    if (!container) return

    var coverUrl = game.cover_img_url
      ? game.cover_img_url.replace(/t_[a-z0-9_]+/, 't_cover_big') : null
    var bgUrl = game.cover_img_url
      ? game.cover_img_url.replace(/t_[a-z0-9_]+/, 't_screenshot_big') : null

    container.id = 'favGameCard'
    container.className = 'fav-game-card'
    container.removeAttribute('style')  // clear any inline styles so CSS class takes over fully
    var html = ''
    if (bgUrl) html += '<img class="fav-game-bg" src="' + bgUrl + '" alt="" />'
    html += '<div class="fav-game-overlay"></div>'
    html += '<div class="fav-game-content">'
    html += '<a href="/games/' + game.slug + '">'
    if (coverUrl) {
      html += '<img class="fav-cover" src="' + coverUrl + '" alt="' + game.title + '" />'
    } else {
      html += '<div class="fav-cover" style="width:56px;height:75px;background:var(--tag-bg);display:flex;align-items:center;justify-content:center;font-size:24px;border-radius:8px">🎮</div>'
    }
    html += '</a>'
    html += '<div class="fav-info">'
    html += '<div class="fav-label">⭐ Favorite game</div>'
    html += '<a href="/games/' + game.slug + '" class="fav-title">' + game.title + '</a>'
    html += '</div>'
    html += '</div>'
    html += '<button onclick="openGamePicker(&quot;favorite&quot;)" style="position:absolute;top:10px;right:10px;background:rgba(0,0,0,.6);border:none;color:white;font-size:11px;font-family:inherit;padding:4px 10px;border-radius:8px;cursor:pointer;backdrop-filter:blur(4px)">Change</button>'
    container.innerHTML = html
  }

  function renderShowcase(showcase) {
    var grid = document.getElementById('showcaseGrid')
    if (!grid) return
    grid.innerHTML = ''
    for (var i = 0; i < 3; i++) {
      var game = showcase[i] ?? null
      var slot = document.createElement('div')
      if (game) {
        var coverUrl = game.cover_img_url ? game.cover_img_url.replace(/t_[a-z0-9_]+/, 't_cover_big') : null
        // always use showcase-item so dimensions never change
        slot.className = 'showcase-item'
        // cover image fills slot
        var img = document.createElement('img')
        if (coverUrl) {
          img.src = coverUrl
          img.alt = game.title
          img.style.cssText = 'width:100%;height:100%;object-fit:cover;display:block'
          slot.appendChild(img)
        } else {
          var placeholder = document.createElement('div')
          placeholder.style.cssText = 'position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:28px;background:var(--tag-bg)'
          placeholder.textContent = '🎮'
          slot.appendChild(placeholder)
        }
        // title tooltip
        var titleTag = document.createElement('div')
        titleTag.style.cssText = 'position:absolute;bottom:0;left:0;right:0;padding:8px;background:linear-gradient(transparent,rgba(0,0,0,.8));font-size:10px;font-weight:600;color:white;opacity:0;transition:opacity .2s;pointer-events:none;line-height:1.3'
        titleTag.textContent = game.title
        slot.appendChild(titleTag)
        slot.addEventListener('mouseenter', function() {
          var t = this.querySelector('div:last-child'); if (t) t.style.opacity = '1'
        })
        slot.addEventListener('mouseleave', function() {
          var t = this.querySelector('div:last-child'); if (t) t.style.opacity = '0'
        })
        if (ownProfile) {
          var removeBtn = document.createElement('div')
          removeBtn.className = 'showcase-remove'
          removeBtn.innerHTML = '×'
          removeBtn.title = 'Remove'
          ;(function(idx) {
            removeBtn.onclick = async function(e) {
              e.stopPropagation()
              e.preventDefault()
              this.style.pointerEvents = 'none'
              this.innerHTML = '…'
              var sc = currentShowcase.slice()
              while (sc.length < 3) sc.push(null)
              sc[idx] = null
              var toSave = sc.filter(Boolean)
              try {
                var rres = await fetch('/api/profile/update', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ showcase_games: toSave })
                })
                var rbody = await rres.json()
                if (!rres.ok) throw new Error(rbody.error || 'Failed')
                currentShowcase = sc.slice()
                renderShowcase(currentShowcase)
                showToast('Game removed', 'success')
              } catch(err) {
                showToast('Failed to remove: ' + (err.message || 'try again'), 'error')
                this.style.pointerEvents = ''
                this.innerHTML = '×'
              }
            }
          })(i)
          slot.appendChild(removeBtn)
          ;(function(idx) {
            slot.onclick = function(e) {
              if (e.target.closest('.showcase-remove')) return
              openGamePicker('showcase', idx)
            }
          })(i)
        } else {
          // non-owner: wrap image in a link, don't make whole slot clickable
          var gameLink = document.createElement('a')
          gameLink.href = '/games/' + game.slug
          gameLink.style.cssText = 'display:block;width:100%;height:100%'
          // move the img inside the link
          if (img && img.parentNode === slot) {
            slot.removeChild(img)
            gameLink.appendChild(img)
          }
          slot.insertBefore(gameLink, slot.firstChild)
        }
      } else {
        // empty slot — same class and size as filled, just different interior
        slot.className = 'showcase-empty'
        var plus = document.createElement('span')
        plus.style.cssText = 'font-size:26px;opacity:.35;line-height:1'
        plus.textContent = '+'
        var label = document.createElement('span')
        label.style.cssText = 'font-size:11px;color:var(--text-tertiary);font-weight:500'
        label.textContent = 'Add game'
        slot.appendChild(plus)
        slot.appendChild(label)
        if (ownProfile) {
          ;(function(idx) { slot.onclick = function() { openGamePicker('showcase', idx) } })(i)
        } else {
          slot.style.visibility = 'hidden'  // hide but keep space so grid stays stable
        }
      }
      grid.appendChild(slot)
    }
  }

  // init showcase from server DB data
  var currentShowcase = JSON.parse(showcaseJson)
  if (currentShowcase.length > 0) {
    var padded = currentShowcase.slice()
    while (padded.length < 3) padded.push(null)
    currentShowcase = padded
    renderShowcase(currentShowcase)
  } else if (!ownProfile) {
    // non-owner, no showcase set — hide the card entirely
    var grid = document.getElementById('showcaseGrid')
    if (grid) { var card = grid.closest('.card'); if (card) card.style.display = 'none' }
  } else {
    // own profile, empty showcase — render 3 empty slots
    currentShowcase = [null, null, null]
    renderShowcase(currentShowcase)
  }

  // ── SCORE DIST MINI BARS ──
  var dist = JSON.parse(distJson)
  var maxD = Math.max.apply(null, dist.concat([1]))
  var distEl = document.getElementById('distMini')
  if (distEl) {
    var barsRow = document.createElement('div'); barsRow.className = 'dist-bars-row'
    var labelsRow = document.createElement('div'); labelsRow.className = 'dist-labels-row'
    dist.forEach(function(count, i) {
      var bar = document.createElement('div'); bar.className = 'dist-bar'
      bar.style.height = Math.max(3, (count/maxD)*40)+'px'
      bar.style.background = barColors[i]
      bar.title = 'Score '+(i+1)+': '+count+' review'+(count!==1?'s':'')
      barsRow.appendChild(bar)
      var num = document.createElement('div'); num.className = 'dist-num'
      num.textContent = i+1
      labelsRow.appendChild(num)
    })
    distEl.appendChild(barsRow)
    distEl.appendChild(labelsRow)
  }

  // ── ACTIVITY LINE CHART ──
  var actEl = document.getElementById('activityChart')
  if (actEl && s.monthLabels && s.monthCounts) {
    setTimeout(function() {
      var w = actEl.getBoundingClientRect().width || 500
      var chartH = 48, padL = 4, padR = 4
      var pts = s.monthCounts, n = pts.length
      var step = (w-padL-padR)/(n-1)
      var maxM = Math.max.apply(null, pts.concat([1]))
      var coords = pts.map(function(v,i){return [padL+i*step, chartH-(v/maxM)*chartH*0.85-4]})
      var aPath = 'M'+coords[0][0]+','+chartH+coords.map(function(c){return ' L'+c[0]+','+c[1]}).join('')+' L'+coords[n-1][0]+','+chartH+' Z'
      var area = document.createElementNS('http://www.w3.org/2000/svg','path')
      area.setAttribute('d',aPath); area.setAttribute('fill','var(--accent)'); area.setAttribute('opacity','0.1')
      actEl.appendChild(area)
      var lPath = 'M'+coords[0][0]+','+coords[0][1]+coords.slice(1).map(function(c){return ' L'+c[0]+','+c[1]}).join('')
      var line = document.createElementNS('http://www.w3.org/2000/svg','path')
      line.setAttribute('d',lPath); line.setAttribute('fill','none')
      line.setAttribute('stroke','var(--accent)'); line.setAttribute('stroke-width','2')
      line.setAttribute('stroke-linecap','round'); line.setAttribute('stroke-linejoin','round')
      actEl.appendChild(line)
      coords.forEach(function(c,i){
        var dot = document.createElementNS('http://www.w3.org/2000/svg','circle')
        dot.setAttribute('cx',c[0]); dot.setAttribute('cy',c[1])
        dot.setAttribute('r', pts[i]>0?'4':'2')
        dot.setAttribute('fill', pts[i]>0?'var(--accent)':'var(--border)')
        dot.setAttribute('stroke','var(--bg-card)'); dot.setAttribute('stroke-width','2')
        actEl.appendChild(dot)
        if (i % 3 === 0 || i === n-1) {
          var lbl = document.createElementNS('http://www.w3.org/2000/svg','text')
          lbl.setAttribute('x',c[0]); lbl.setAttribute('y',chartH+14)
          lbl.setAttribute('text-anchor','middle'); lbl.setAttribute('font-size','9')
          lbl.setAttribute('fill','var(--text-secondary)'); lbl.setAttribute('font-family','DM Sans,sans-serif')
          lbl.textContent = s.monthLabels[i]; actEl.appendChild(lbl)
        }
      })
    }, 50)
  }

  // ── SORT REVIEWS ──
  function sortReviews(type, btn) {
  document.querySelectorAll('.sort-tab').forEach(function(b) { b.classList.remove('active') })
  btn.classList.add('active')
  var list = document.getElementById('reviewsList')
  if (!list) return
  var cards = Array.from(list.querySelectorAll('.rc'))
  cards.sort(function(a, b) {
    if (type === 'highest') return parseInt(b.dataset.score) - parseInt(a.dataset.score)
    if (type === 'lowest') return parseInt(a.dataset.score) - parseInt(b.dataset.score)
    if (type === 'most_upvoted') return parseInt(b.dataset.upvotes) - parseInt(a.dataset.upvotes)
    if (type === 'most_downvoted') return parseInt(b.dataset.downvotes) - parseInt(a.dataset.downvotes)
    return new Date(b.dataset.date).getTime() - new Date(a.dataset.date).getTime()
  })
  cards.forEach(function(card) { list.appendChild(card) })
}
  window.sortReviews = sortReviews

  // ── STATS TAB ──
  function scoreCol(score) {
    var isLight = document.documentElement.getAttribute('data-theme') === 'light'
    if (isLight) {
      if (score === 10) return '#1a1a2e'
      if (score >= 9)  return '#166534'
      if (score >= 8)  return '#0f766e'
      if (score >= 7)  return '#1e40af'
      if (score >= 5)  return '#854d0e'
      if (score >= 3)  return '#9a3412'
      return '#991b1b'
    }
    if (score === 10) return '#ffffff'
    if (score >= 9) return '#4ade80'
    if (score >= 8) return '#2dd4bf'
    if (score >= 7) return '#60a5fa'
    if (score >= 5) return '#fbbf24'
    if (score >= 3) return '#fb923c'
    return '#f87171'
  }

  function buildStats() {
    var el = document.getElementById('statsContent')
    if (!el || !s.reviewCount) return
    var pieColors = ['#6050c8','#60a5fa','#4ade80','#fbbf24','#f87171']
    var html = ''
    var deltaVal = s.scoreDelta !== null && s.scoreDelta !== undefined ? s.scoreDelta : null
    var deltaColor = deltaVal === null ? '#908d87' : deltaVal > 0 ? '#4ade80' : deltaVal < 0 ? '#f87171' : '#908d87'
    var deltaStr = deltaVal === null ? '—' : (deltaVal > 0 ? '+' : '') + deltaVal.toFixed(1)
    html += '<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:10px">'
    var heroStats = [
      { lbl: 'Reviews written', val: s.reviewCount, color: '#6050c8' },
      { lbl: 'Avg score given', val: s.avgScore || '—', color: scoreCol(parseFloat(s.avgScore||'0')) },
      { lbl: 'Avg hours played', val: s.avgHours ? s.avgHours+'h' : '—', color: '#fbbf24' },
      { lbl: 'vs. community', val: deltaStr, color: deltaColor, sub: deltaVal === null ? 'no data' : deltaVal > 0 ? 'rates higher than avg' : deltaVal < 0 ? 'rates lower than avg' : 'rates same as avg' },
    ]
    heroStats.forEach(function(hs) {
      html += '<div style="background:var(--bg-card);border:1px solid '+hs.color+'33;border-radius:12px;padding:12px 14px;position:relative;overflow:hidden">'
      html += '<div style="position:absolute;inset:0;background:linear-gradient(135deg,'+hs.color+'0d 0%,transparent 70%);pointer-events:none"></div>'
      html += '<div style="font-size:10px;font-weight:700;color:'+hs.color+';text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px;position:relative">'+hs.lbl+'</div>'
      html += '<div style="font-family:\'DM Serif Display\',serif;font-size:28px;letter-spacing:-.5px;line-height:1;color:'+hs.color+';position:relative;margin-bottom:3px">'+hs.val+'</div>'
      if (hs.sub) html += '<div style="font-size:9px;color:'+hs.color+';opacity:.6;position:relative">'+hs.sub+'</div>'
      html += '</div>'
    })
    html += '</div>'

    // ── DOUBLE BAR CHART BLOCK ──
    html += '<div style="background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:20px 20px 24px;margin-bottom:10px">'
    html += '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;gap:12px;flex-wrap:wrap">'
    html += '<div style="font-size:11px;font-weight:700;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.08em">Breakdown</div>'
    html += '<select id="chartViewSelect" onchange="renderDoubleBar(this.value)" style="background:var(--bg-hover);border:1px solid var(--border);border-radius:8px;padding:5px 10px;font-size:12px;font-family:DM Sans,sans-serif;color:var(--text-primary);cursor:pointer;outline:none">'
    html += '<option value="genreActivity">Games &amp; Hours by Genre</option>'
    html += '<option value="genreRating">Ratings by Genre vs. Community</option>'
    html += '<option value="yearRating">Ratings by Year vs. Community</option>'
    html += '</select></div>'
    // legend
    html += '<div style="display:flex;gap:16px;margin-bottom:14px" id="chartLegend">'
    html += '<div style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-primary);font-weight:500"><div id="legendADot" style="width:10px;height:10px;border-radius:2px;background:#2dd4bf"></div><span id="legendA">Games reviewed</span></div>'
    html += '<div style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-primary);font-weight:500"><div id="legendBDot" style="width:10px;height:10px;border-radius:2px;background:#60a5fa"></div><span id="legendB">Hours played</span></div>'
    html += '</div>'
    html += '<div id="doubleBarChart" style="width:100%;overflow-x:auto;min-height:280px"></div>'
    html += '</div>'

    html += '<div style="background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:14px;margin-bottom:10px">'
    html += '<div style="font-size:11px;font-weight:700;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.08em;margin-bottom:12px">Score distribution</div>'
    html += '<div id="statsDistRow"></div>'
    html += '</div>'
    html += '<div style="display:grid;grid-template-columns:3fr 2fr;gap:10px;margin-bottom:10px">'
    html += '<div style="background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:14px">'
    html += '<div style="font-size:11px;font-weight:700;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.08em;margin-bottom:10px">Reviews over time — last 12 months</div>'
    html += '<svg id="statsLineChart" height="90" style="width:100%;overflow:visible;display:block"></svg>'
    html += '</div>'
    if (s.platformBreakdown && s.platformBreakdown.length > 0) {
      html += '<div style="background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:14px;display:flex;flex-direction:column">'
      html += '<div style="font-size:11px;font-weight:700;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.08em;margin-bottom:10px">Platforms played</div>'
