            <div class="card-title">Genres reviewed</div>
            {genreBreakdown.map((g, i) => {
              const genreColors = ['#6050c8','#3b82f6','#10b981','#f59e0b','#ec4899','#06b6d4']
              const c = genreColors[i % genreColors.length]
              return (
