---
export const prerender = false;
import { createSupabaseServerClientFromContext } from '../../../utils/database';
import Layout from '../../../components/Layout.astro';
import ShareButton from '../../../components/ShareButton.astro';
import { scoreClass } from '../../../utils/format';

const supabase = createSupabaseServerClientFromContext(Astro);
const { username } = Astro.params;

const { data: reviewer, error } = await (supabase as any)
  .from('profiles')
  .select(`
    id, username, avatar_url, is_active, search_indexable,
    reviews (
      id, score, title, published_at, created_at, status,
      games ( id, title, slug, cover_img_url )
    )
  `)
  .eq('username', username)
  .single();

if (error || !reviewer || !reviewer.is_active) return Astro.redirect('/404');

const reviews = (reviewer.reviews ?? [])
  .filter((r: any) => r.status === 'published' && r.games)
  .sort((a: any, b: any) =>
    new Date(b.published_at ?? b.created_at).getTime() -
    new Date(a.published_at ?? a.created_at).getTime()
  );

function igdbCover(url: string | null, size = 't_thumb') {
  if (!url) return null;
  const clean = url.startsWith('//') ? `https:${url}` : url;
  return clean.replace(/t_[a-z0-9_]+/, size);
}

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<Layout
  title={`Games reviewed by @${reviewer.username} — Chekpoint`}
  description={`${reviews.length} game${reviews.length === 1 ? '' : 's'} reviewed by @${reviewer.username} on Chekpoint.`}
  ogImage={reviewer.avatar_url ?? undefined}
  variant="centered"
  noindex={!reviewer.search_indexable}
>
  <div class="page">

    <div class="page-header">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px">
        <a href={`/reviewers/${reviewer.username}`} class="back-link">
          <svg width="14" height="14" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 14l-5-5 5-5"/></svg>
          @{reviewer.username}
        </a>
        <ShareButton url={`/reviewers/${reviewer.username}/games`} />
      </div>
      <h1 class="page-title">Games reviewed</h1>
      <div class="page-count">{reviews.length} {reviews.length === 1 ? 'game' : 'games'}</div>
    </div>

    <div class="search-wrap">
      <svg class="search-icon" width="15" height="15" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="7.5" cy="7.5" r="5"/><path d="M16 16l-3.5-3.5"/>
      </svg>
      <input
        type="text"
        id="searchInput"
        class="search-input"
        placeholder="Search games…"
        autocomplete="off"
        spellcheck="false"
      />
      <span id="searchClear" class="search-clear" style="display:none">×</span>
    </div>

    {reviews.length === 0 ? (
      <div class="empty">
        <div class="empty-title">No reviews yet</div>
        <p>@{reviewer.username} hasn't posted any reviews.</p>
      </div>
    ) : (
      <ul class="game-list" id="gameList">
        {reviews.map((review: any) => {
          const ts = review.published_at ?? review.created_at;
          return (
            <li class="game-row" data-title={review.games.title.toLowerCase()}>
              <a href={`/games/${review.games.slug}`} class="cover-link">
                {igdbCover(review.games.cover_img_url)
                  ? <img class="cover" src={igdbCover(review.games.cover_img_url) ?? ''} alt={review.games.title} loading="lazy" />
                  : <span class="cover cover-placeholder">🎮</span>
                }
              </a>
              <div class="row-body">
                <a href={`/games/${review.games.slug}`} class="game-title">{review.games.title}</a>
                {review.title && <div class="review-title">"{review.title}"</div>}
              </div>
              <div class="row-meta">
                <div class={`score-badge ${scoreClass(review.score)}`}>{review.score}</div>
                <div class="review-date">{formatDate(ts)}</div>
              </div>
            </li>
          );
        })}
      </ul>
    )}

    <div class="no-results" id="noResults" style="display:none">
      <div class="empty-title">No matches</div>
      <p>No games match your search.</p>
    </div>

  </div>
</Layout>

<script is:inline>
  var input = document.getElementById('searchInput');
  var clear = document.getElementById('searchClear');
  var list  = document.getElementById('gameList');
  var noRes = document.getElementById('noResults');

  if (input && list) {
    input.addEventListener('input', function() {
      var q = input.value.trim().toLowerCase();
      clear.style.display = q ? '' : 'none';
      var rows = list.querySelectorAll('.game-row');
      var visible = 0;
      rows.forEach(function(row) {
        var match = row.dataset.title.includes(q);
        row.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      noRes.style.display = visible === 0 ? '' : 'none';
    });

    clear.addEventListener('click', function() {
      input.value = '';
      input.dispatchEvent(new Event('input'));
      input.focus();
    });
  }
</script>

<style>
  .page {
    max-width: 680px;
    margin: 0 auto;
    padding: 32px 20px 60px;
  }

  .page-header {
    margin-bottom: 24px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    color: var(--text-tertiary);
    text-decoration: none;
    margin-bottom: 12px;
    transition: color 0.15s;
  }
  .back-link:hover { color: var(--text-secondary); }

  .page-title {
    font-family: 'DM Serif Display', serif;
    font-size: 26px;
    font-weight: 400;
    letter-spacing: -0.3px;
    color: var(--text-primary);
    margin: 0 0 4px;
  }

  .page-count {
    font-size: 13px;
    color: var(--text-tertiary);
  }

  /* ── Search ── */
  .search-wrap {
    position: relative;
    margin-bottom: 20px;
  }
  .search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-tertiary);
    pointer-events: none;
  }
  .search-input {
    width: 100%;
    box-sizing: border-box;
    padding: 11px 40px 11px 40px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text-primary);
    font-size: 14px;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s;
  }
  .search-input:focus { border-color: var(--accent); }
  .search-input::placeholder { color: var(--text-tertiary); }
  .search-clear {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 18px;
    line-height: 1;
    color: var(--text-tertiary);
    cursor: pointer;
    padding: 2px 4px;
    transition: color 0.15s;
  }
  .search-clear:hover { color: var(--text-primary); }

  /* ── List ── */
  .game-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border-subtle);
  }

  .game-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .cover-link { flex-shrink: 0; }
  .cover {
    width: 40px;
    height: 54px;
    border-radius: 6px;
    object-fit: cover;
    display: block;
    border: 1px solid var(--border);
    background: var(--tag-bg);
  }
  .cover-placeholder {
    width: 40px;
    height: 54px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--tag-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
  }

  .row-body {
    flex: 1;
    min-width: 0;
  }

  .game-title {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    letter-spacing: -0.1px;
    transition: color 0.15s;
  }
  .game-title:hover { color: var(--accent); }

  .review-title {
    font-size: 12px;
    color: var(--text-tertiary);
    margin-top: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-style: italic;
  }

  .row-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 5px;
    flex-shrink: 0;
  }

  .review-date {
    font-size: 11px;
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  /* Score badge — inherits from shared.css */
  .score-badge {
    min-width: 28px;
    height: 22px;
    padding: 0 6px;
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
    font-family: 'DM Serif Display', serif;
  }

  /* ── Empty / no results ── */
  .empty, .no-results {
    padding: 60px 0;
    text-align: center;
    color: var(--text-tertiary);
  }
  .empty-title {
    font-family: 'DM Serif Display', serif;
    font-size: 20px;
    color: var(--text-secondary);
    margin-bottom: 8px;
  }
</style>
