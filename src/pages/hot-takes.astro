---
import { getSupabase, createSupabaseServerClientFromContext } from "../utils/database";
import Layout from "../components/Layout.astro";
import ReviewCard from "../components/ReviewCard.astro";
import ReportModal from "../components/ReportModal.astro";

const supabase = getSupabase();
const serverClient = createSupabaseServerClientFromContext(Astro);

const { data: { user } } = await serverClient.auth.getUser();
const isLoggedIn = !!user;

const db = supabase as any;

// Pull current profile for ownership checks
let currentProfile: { id: string; username: string; avatar_url: string | null } | null = null;
if (user) {
  const { data: cp } = await db
    .from('profiles').select('id, username, avatar_url').eq('auth_user_id', user.id).single();
  currentProfile = cp ?? null;
}

// Fetch all published reviews with scores so we can compute per-game averages
const REVIEW_FIELDS = `
  id, score, title, body, play_time_hours,
  contains_spoilers, status, published_at, created_at,
  game_id,
  played_on:platform_played_on ( id, name, slug ),
  games ( id, title, slug, cover_img_url ),
  profiles ( id, username, avatar_url ),
  review_votes( vote, profile_id ),
  review_reactions( reaction_type, profile_id ),
  review_comments( id )
`;

const { data: allReviewsRaw } = await db
  .from('reviews')
  .select(REVIEW_FIELDS)
  .eq('status', 'published')
  .order('published_at', { ascending: false })
  .limit(500);

const allReviews: any[] = allReviewsRaw ?? [];

// ── Build per-game average map (only games with ≥ 2 reviews qualify) ──────────
const gameScores: Record<string, number[]> = {};
for (const r of allReviews) {
  if (r.game_id == null || r.score == null) continue;
  if (!gameScores[r.game_id]) gameScores[r.game_id] = [];
  gameScores[r.game_id].push(r.score);
}

const gameAvg: Record<string, number> = {};
for (const [id, scores] of Object.entries(gameScores)) {
  if (scores.length >= 2) {
    gameAvg[id] = scores.reduce((a: number, b: number) => a + b, 0) / scores.length;
  }
}

// ── Find hot takes: deviation ≥ 2.5 from consensus ───────────────────────────
const MIN_DEVIATION = 2.5;

type HotTake = {
  review: any;
  gameAvg: number;
  deviation: number;         // signed: positive = above avg, negative = below
  absDeviation: number;
  reviewCount: number;
};

const hotTakes: HotTake[] = allReviews
  .filter(r => r.game_id != null && gameAvg[r.game_id] !== undefined)
  .map(r => ({
    review: r,
    gameAvg: gameAvg[r.game_id],
    deviation: r.score - gameAvg[r.game_id],
    absDeviation: Math.abs(r.score - gameAvg[r.game_id]),
    reviewCount: gameScores[r.game_id].length,
  }))
  .filter(h => h.absDeviation >= MIN_DEVIATION)
  .sort((a, b) => b.absDeviation - a.absDeviation)
  .slice(0, 30);

function fmt(n: number): string {
  return n.toFixed(1);
}

// CDN cache — anonymous visitors share a cached response; auth users get a fresh render
if (!isLoggedIn) {
  Astro.response.headers.set('Netlify-CDN-Cache-Control', 'public, max-age=300, stale-while-revalidate=600');
  Astro.response.headers.set('Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}
Astro.response.headers.set('Netlify-Vary', 'cookie=sb-bzlwwtatoiyzwirerify-auth-token');
---

<Layout
  title="Hot Takes — Chekpoint"
  description="The most divisive game opinions on Chekpoint. See which games divide gamers the most with the lowest and highest scores."
  isLoggedIn={isLoggedIn}
  currentProfile={currentProfile}
  activeNav="hot-takes"
  variant="two-col"
>
  <main class="ht-main">

    <div class="ht-header">
      <div class="ht-header-text">
        <h1 class="ht-title">Hot Takes</h1>
        <p class="ht-subtitle">
          Some people just don't get the hype. Or maybe they saw something everyone else missed. These are those reviews.
        </p>
      </div>
      <div class="ht-legend">
        <span class="ht-legend-item contrarian">▼ Below consensus</span>
        <span class="ht-legend-item hype">▲ Above consensus</span>
      </div>
    </div>

    {hotTakes.length === 0 ? (
      <div class="ht-empty">
        <div class="ht-empty-icon">🤝</div>
        <div class="ht-empty-title">Everybody agrees… for now.</div>
        <p class="ht-empty-body">
          No reviews yet diverge far enough from the consensus to qualify.
          Once more games have multiple reviews, the disagreements will start showing up here.
        </p>
      </div>
    ) : (
      <div class="ht-feed">
        {hotTakes.map(({ review, gameAvg, deviation, absDeviation, reviewCount }) => (
          <div class="ht-item">
            <div class={`ht-badge ${deviation > 0 ? 'ht-badge-up' : 'ht-badge-down'}`}>
              <div class="ht-badge-delta">
                {deviation > 0 ? '▲' : '▼'} {fmt(absDeviation)} pts
              </div>
              <div class="ht-badge-avg">
                avg <strong>{fmt(gameAvg)}</strong> across {reviewCount} reviews
              </div>
            </div>
            <ReviewCard
              review={review}
              isLoggedIn={isLoggedIn}
              isOwnProfile={!!(currentProfile && review.profiles?.id === currentProfile.id)}
              showGame={true}
              showReviewer={true}
              showVotes={true}
              currentProfileId={currentProfile?.id ?? null}
            />
          </div>
        ))}
      </div>
    )}
  </main>

  <ReportModal />
</Layout>

<style>
  .ht-main {
    min-width: 0;
    padding: 24px 24px 48px;
  }

  /* ── Header ── */
  .ht-header {
    padding: 0 0 20px;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 8px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .ht-header-text { flex: 1; min-width: 0; }
  .ht-title {
    font-family: 'DM Serif Display', serif;
    font-size: 26px;
    font-weight: 400;
    color: var(--text-primary);
    margin: 0 0 6px;
    line-height: 1.2;
  }
  .ht-subtitle {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
    max-width: 480px;
  }

  .ht-legend {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex-shrink: 0;
    padding-top: 4px;
  }
  .ht-legend-item {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 6px;
    letter-spacing: 0.03em;
  }
  .ht-legend-item.contrarian {
    background: rgba(248, 113, 113, 0.1);
    color: #f87171;
    border: 1px solid rgba(248, 113, 113, 0.2);
  }
  .ht-legend-item.hype {
    background: rgba(52, 211, 153, 0.1);
    color: #34d399;
    border: 1px solid rgba(52, 211, 153, 0.2);
  }

  /* ── Empty state ── */
  .ht-empty {
    text-align: center;
    padding: 64px 24px;
  }
  .ht-empty-icon { font-size: 40px; margin-bottom: 16px; }
  .ht-empty-title {
    font-family: 'DM Serif Display', serif;
    font-size: 20px;
    color: var(--text-primary);
    margin-bottom: 10px;
  }
  .ht-empty-body {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 380px;
    margin: 0 auto;
  }

  /* ── Feed ── */
  .ht-feed {
    display: flex;
    flex-direction: column;
  }

  .ht-item {
    border-bottom: 1px solid var(--border-subtle);
  }
  .ht-item:last-child { border-bottom: none; }

  /* Deviation badge sits flush above the ReviewCard */
  .ht-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 20px 0;
  }
  .ht-badge-delta {
    font-size: 12px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 20px;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }
  .ht-badge-avg {
    font-size: 11px;
    color: var(--text-tertiary);
  }
  .ht-badge-avg strong {
    color: var(--text-secondary);
    font-weight: 600;
  }

  /* Colour variants */
  .ht-badge-down .ht-badge-delta {
    background: rgba(248, 113, 113, 0.12);
    color: #f87171;
    border: 1px solid rgba(248, 113, 113, 0.25);
  }
  .ht-badge-up .ht-badge-delta {
    background: rgba(52, 211, 153, 0.12);
    color: #34d399;
    border: 1px solid rgba(52, 211, 153, 0.2);
  }
</style>
