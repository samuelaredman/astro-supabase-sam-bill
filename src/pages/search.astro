  .filter-select {
    background: var(--bg); border: 1px solid var(--border); border-radius: 8px;
    padding: 6px 28px 6px 10px; font-size: 13px; font-family: inherit;
    color: var(--text-secondary); outline: none; cursor: pointer; transition: border-color 0.15s;
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%23a09d98' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat; background-position: right 8px center;
  }
  .filter-select:focus { border-color: var(--text-secondary); }
  .filter-select.active { border-color: var(--text-primary); color: var(--text-primary); }
  .clear-link { font-size: 12px; color: var(--text-tertiary); text-decoration: none; padding: 4px 8px; border-radius: 6px; transition: color 0.15s; }
  .clear-link:hover { color: var(--text-primary); }

  .results { padding: 20px; }
  .results-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 16px; flex-wrap: wrap; gap: 8px; }
  .results-title { font-family: 'DM Serif Display', serif; font-size: 20px; letter-spacing: -0.3px; }
  .results-count { font-size: 12px; color: var(--text-tertiary); }
  .section-title { font-size: 13px; font-weight: 500; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px; margin-top: 24px; }
  .section-title:first-child { margin-top: 0; }

  .game-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 14px; margin-bottom: 8px; }
  .game-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; transition: box-shadow 0.15s, transform 0.15s; cursor: pointer; display: block; }
  .game-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .game-cover { width: 100%; aspect-ratio: 3/4; background: var(--tag-bg); display: flex; align-items: center; justify-content: center; font-size: 32px; overflow: hidden; }
  .game-cover img { width: 100%; height: 100%; object-fit: cover; }
  .game-card-info { padding: 10px; }
  .game-card-title { font-size: 13px; font-weight: 500; line-height: 1.3; margin-bottom: 4px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .game-card-meta { display: flex; align-items: center; gap: 6px; margin-top: 4px; }
  .game-card-year { font-size: 12px; color: var(--text-tertiary); }
  .game-card-stats { font-size: 11px; color: var(--text-tertiary); margin-top: 3px; }
  .score-pill { margin-left: auto; font-size: 11px; font-weight: 600; padding: 2px 7px; border-radius: 6px; font-family: 'DM Serif Display', serif; white-space: nowrap; }
  .score-pill.score-perfect { color: var(--score-perfect); background: var(--score-perfect-bg); }
  .score-pill.score-great   { color: var(--score-great);   background: var(--score-great-bg); }
  .score-pill.score-teal    { color: var(--score-teal);    background: var(--score-teal-bg); }
  .score-pill.score-good    { color: var(--score-good);    background: var(--score-good-bg); }
  .score-pill.score-mid     { color: var(--score-mid);     background: var(--score-mid-bg); }
  .score-pill.score-orange  { color: var(--score-orange);  background: var(--score-orange-bg); }
  .score-pill.score-low     { color: var(--score-low);     background: var(--score-low-bg); }
  .game-card-tags { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px; }
  .tag { background: var(--tag-bg); color: var(--tag-text); font-size: 11px; padding: 2px 7px; border-radius: 4px; }

  .igdb-label { display: inline-flex; align-items: center; gap: 4px; background: var(--tag-bg); color: var(--tag-text); font-size: 11px; font-weight: 500; padding: 2px 8px; border-radius: 20px; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.3px; }
  .add-pill { font-size: 11px; color: var(--text-tertiary); margin-top: 3px; }
  .import-label { color: var(--accent, #7c3aed); font-weight: 600; }

  .igdb-import-form .game-card { position: relative; overflow: hidden; }
  .igdb-import-btn:hover .game-card { border-color: var(--accent, #7c3aed); }

  .import-loading-overlay {
    display: none;
    position: absolute;
    inset: 0;
    background: rgba(15,15,15,0.82);
    backdrop-filter: blur(2px);
    border-radius: inherit;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #fff;
    font-size: 13px;
    font-weight: 500;
  }
  .import-loading-overlay.active { display: flex; }

  .import-spinner {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(255,255,255,0.2);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .profile-list { display: flex; flex-direction: column; gap: 2px; }
  .profile-item { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 10px; transition: background 0.15s; }
  .profile-item:hover { background: var(--bg-hover); }
  .srch-avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--tag-bg); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 500; color: var(--text-secondary); overflow: hidden; flex-shrink: 0; }
  .srch-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .profile-username { font-size: 14px; font-weight: 500; }
  .profile-sub { font-size: 12px; color: var(--text-tertiary); margin-top: 1px; }

  .company-list { display: flex; flex-direction: column; gap: 2px; }
  .company-item { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 10px; transition: background 0.15s; }
  .company-item:hover { background: var(--bg-hover); }
  .company-icon { width: 40px; height: 40px; border-radius: 10px; background: var(--tag-bg); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
  .company-name { font-size: 14px; font-weight: 500; }
  .company-sub { font-size: 12px; color: var(--text-tertiary); margin-top: 1px; }

  .active-filters { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
  .active-filter-pill { display: inline-flex; align-items: center; gap: 6px; background: var(--accent); color: var(--accent-text); font-size: 12px; font-weight: 500; padding: 4px 10px; border-radius: 20px; }
  .active-filter-pill a { color: inherit; opacity: 0.7; font-size: 14px; line-height: 1; }
  .active-filter-pill a:hover { opacity: 1; }

  .genre-chip-list { display: flex; flex-wrap: wrap; gap: 6px; }
  .genre-chip { background: var(--tag-bg); color: var(--tag-text); font-size: 12px; padding: 4px 10px; border-radius: 20px; cursor: pointer; transition: all 0.15s; text-decoration: none; display: inline-block; }
  .genre-chip:hover { background: var(--bg-hover); color: var(--text-primary); }
  .genre-chip.active { background: var(--accent); color: var(--accent-text); }
</style>

<script is:inline define:vars={{ searchIsLoggedIn: isLoggedIn }}>
  // define:vars compiles to a `const` scoped to this script tag only — the
  // igdb-import-btn handler below lives in a separate <script> and needs
  // this on window to see it.
  window.searchIsLoggedIn = searchIsLoggedIn;
  var mainSearchInput = document.getElementById('mainSearchInput');
  var searchDropdown  = document.getElementById('searchDropdown');
  var sdTimeout;

  function closeDropdown() {
    searchDropdown.classList.remove('open');
    searchDropdown.innerHTML = '';
  }

  mainSearchInput.addEventListener('input', function() {
    clearTimeout(sdTimeout);
    var q = this.value.trim();
    if (q.length < 2) { closeDropdown(); return; }
    sdTimeout = setTimeout(function() { fetchSuggestions(q); }, 180);
  });

  mainSearchInput.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeDropdown();
  });

  document.addEventListener('click', function(e) {
    if (!e.target.closest('.search-input-wrap')) closeDropdown();
  });

  function makeSuggestionItem(game) {
    var item = document.createElement('div');
    item.className = 'sd-item';
    var titleHtml = '<span class="sd-title">' + game.title.replace(/</g, '&lt;') + '</span>';
    var yearHtml = game.year ? '<span class="sd-year">' + game.year + '</span>' : '';
    item.innerHTML = game.source === 'igdb'
      ? '<span class="sd-left"><span class="sd-plus">+</span>' + titleHtml + '</span>' + yearHtml
      : titleHtml + yearHtml;
    item.addEventListener('click', function() {
      closeDropdown();
      if (game.source === 'db') {
        window.location.href = '/games/' + game.slug;
        return;
      }
      // IGDB game — import then navigate
      if (!searchIsLoggedIn) {
        window.location.href = '/search?q=' + encodeURIComponent(game.title) + '&tab=games';
        return;
      }
      mainSearchInput.value = game.title;
      item.style.opacity = '0.5';
      item.style.pointerEvents = 'none';
      fetch('/api/games/import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ igdb_id: game.igdb_id }),
      }).then(function(r) { return r.json(); }).then(function(data) {
        if (data && data.slug) window.location.href = '/games/' + data.slug;
        else window.location.href = '/search?q=' + encodeURIComponent(game.title) + '&tab=games';
      }).catch(function() {
        window.location.href = '/search?q=' + encodeURIComponent(game.title) + '&tab=games';
      });
    });
    return item;
  }

  async function fetchSuggestions(q) {
    try {
      var res = await fetch('/api/games/search?q=' + encodeURIComponent(q));
      var games = await res.json();
      searchDropdown.innerHTML = '';
      if (!games.length) {
        searchDropdown.innerHTML = '<div class="sd-empty">No games found</div>';
        searchDropdown.classList.add('open');
        return;
      }
      var dbGames = games.filter(function(g) { return g.source === 'db'; });
      var igdbGames = games.filter(function(g) { return g.source === 'igdb'; });

      if (dbGames.length) {
        var dbLabel = document.createElement('div');
        dbLabel.className = 'sd-section-label';
        dbLabel.textContent = 'In Chekpoint';
        searchDropdown.appendChild(dbLabel);
        dbGames.forEach(function(game) { searchDropdown.appendChild(makeSuggestionItem(game)); });
      }
      if (igdbGames.length) {
        var igdbLabel = document.createElement('div');
        igdbLabel.className = 'sd-section-label';
        igdbLabel.textContent = 'Add from IGDB';
        searchDropdown.appendChild(igdbLabel);
        igdbGames.forEach(function(game) { searchDropdown.appendChild(makeSuggestionItem(game)); });
      }
      searchDropdown.classList.add('open');
    } catch(err) {
      console.error('[search dropdown]', err);
    }
  }
</script>

<script>
  document.querySelectorAll('.igdb-import-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var button = btn as HTMLButtonElement
      var igdbId = button.dataset.igdbId
      if (!igdbId || button.disabled) return

      if (!(window as any).searchIsLoggedIn) {
        window.location.href = '/signin'
        return
      }

      var overlay = button.querySelector('.import-loading-overlay')
      if (overlay) overlay.classList.add('active')
      button.disabled = true

      fetch('/api/games/import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ igdb_id: parseInt(igdbId, 10) }),
      }).then(function(r) { return r.json() }).then(function(data) {
        if (data && data.slug) {
          window.location.href = '/games/' + data.slug
        } else {
          var params = new URLSearchParams(window.location.search)
          params.set('error', 'import_failed')
          window.location.href = '/search?' + params.toString()
        }
      }).catch(function() {
        var params = new URLSearchParams(window.location.search)
        params.set('error', 'import_failed')
        window.location.href = '/search?' + params.toString()
      })
    })
  })
</script>
