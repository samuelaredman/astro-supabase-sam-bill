---
export const prerender = false;
// These are injected into the page so the client-side Supabase SDK can be
// initialised without an API round-trip.
const supabaseUrl     = import.meta.env.SUPABASE_DATABASE_URL as string;
const supabaseAnonKey = import.meta.env.SUPABASE_ANON_KEY     as string;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Prevent dark-mode flash -->
  <script is:inline>
    (function() {
      var t = localStorage.getItem('theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', t);
      var m = document.getElementById('meta-theme-color');
      if (m) m.content = t === 'dark' ? '#0f0f0e' : '#f9f8f6';
    })();
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <meta name="theme-color" id="meta-theme-color" content="#f9f8f6" />
  <title>Set new password — Chekpoint</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&family=Press+Start+2P&display=swap" rel="stylesheet" />
  <style>
    :root[data-theme="light"] {
      --bg: #f9f8f6; --bg-card: #ffffff; --border: #e8e6e1;
      --text-primary: #141412; --text-secondary: #6b6860; --text-tertiary: #a09d98;
      --accent: #141412; --accent-text: #ffffff; --input-bg: #ffffff;
      --error: #c0392b; --error-bg: #fdf0ee;
      --success: #1a6b3c; --success-bg: #eaf5ee;
    }
    :root[data-theme="dark"] {
      --bg: #0f0f0e; --bg-card: #1a1a18; --border: #2a2a27;
      --text-primary: #f0ede8; --text-secondary: #908d87; --text-tertiary: #5a5855;
      --accent: #f0ede8; --accent-text: #141412; --input-bg: #222220;
      --error: #f87171; --error-bg: #2b0d0d;
      --success: #4ade80; --success-bg: #0d2b1a;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text-primary); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; -webkit-font-smoothing: antialiased; }
    a { color: inherit; text-decoration: none; }

    .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; padding: 40px; width: 100%; max-width: 400px; }
    .logo { font-family: 'Press Start 2P', monospace; font-size: 13px; margin-bottom: 28px; display: flex; align-items: center; gap: 8px; }
    .logo-dot { width: 6px; height: 6px; background: #6050c8; border-radius: 50%; box-shadow: 0 0 10px #6050c8; }
    h1 { font-size: 22px; font-weight: 500; letter-spacing: -0.3px; margin-bottom: 6px; }
    .subtitle { font-size: 14px; color: var(--text-secondary); margin-bottom: 28px; line-height: 1.5; }
    .form-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
    label { font-size: 13px; font-weight: 500; color: var(--text-secondary); }
    input { background: var(--input-bg); border: 1px solid var(--border); border-radius: 8px; padding: 10px 14px; font-size: 15px; font-family: inherit; color: var(--text-primary); width: 100%; transition: border-color 0.15s; outline: none; }
    input:focus { border-color: var(--text-secondary); }
    .hint { font-size: 12px; color: var(--text-tertiary); margin-top: 2px; }
    .submit-btn { width: 100%; background: var(--accent); color: var(--accent-text); border: none; border-radius: 10px; padding: 12px; font-size: 15px; font-weight: 500; font-family: inherit; cursor: pointer; margin-top: 8px; transition: opacity 0.15s; }
    .submit-btn:hover { opacity: 0.85; }
    .submit-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .error-msg { background: var(--error-bg); color: var(--error); border-radius: 8px; padding: 10px 14px; font-size: 13px; margin-bottom: 16px; display: none; }
    .error-msg.visible { display: block; }
    .success-msg { background: var(--success-bg); color: var(--success); border-radius: 8px; padding: 14px; font-size: 14px; line-height: 1.5; display: none; }
    .success-msg.visible { display: block; }
    .footer-link { text-align: center; font-size: 13px; color: var(--text-secondary); margin-top: 24px; }
    .footer-link a { color: var(--text-primary); font-weight: 500; text-decoration: underline; text-underline-offset: 2px; }
    .loading { color: var(--text-secondary); font-size: 14px; padding: 8px 0 28px; }
  </style>
</head>
<body>
  <div class="card">
    <a href="/" class="logo"><span class="logo-dot"></span>Chekpoint</a>

    <!-- Shown while the client-side script verifies the token -->
    <div id="loadingState">
      <p class="loading">Verifying link…</p>
    </div>

    <!-- Shown when the token is missing or invalid -->
    <div id="expiredState" style="display:none">
      <h1>Link expired</h1>
      <p class="subtitle">This password reset link is invalid or has already been used. Reset links can only be used once.</p>
      <a href="/forgot-password" class="submit-btn" style="display:block;text-align:center">Request a new link</a>
      <p class="footer-link"><a href="/signin">Back to sign in</a></p>
    </div>

    <!-- Shown when the token is valid -->
    <div id="formState" style="display:none">
      <h1>Set new password</h1>
      <p class="subtitle">Choose a strong password for your account.</p>

      <div class="error-msg" id="errorMsg"></div>
      <div class="success-msg" id="successMsg"></div>

      <form id="confirmForm">
        <div class="form-group">
          <label for="password">New password</label>
          <input type="password" id="password" name="password" placeholder="••••••••" required minlength="8" />
          <span class="hint">At least 8 characters</span>
        </div>
        <div class="form-group">
          <label for="confirmPassword">Confirm password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••" required minlength="8" />
        </div>
        <button type="submit" class="submit-btn" id="submitBtn">Set new password</button>
      </form>

      <p class="footer-link"><a href="/signin">Back to sign in</a></p>
    </div>
  </div>

  <!--
    Pass server-side env vars to the client bundle via data attributes.
    The anon key and project URL are public credentials — safe in HTML.
  -->
  <div id="sb-config"
    data-url={supabaseUrl}
    data-key={supabaseAnonKey}
    style="display:none">
  </div>

  <script>
    import { createClient } from '@supabase/supabase-js';

    const cfg = document.getElementById('sb-config') as HTMLElement;
    const sbUrl = cfg.dataset.url!;
    const sbKey = cfg.dataset.key!;

    // Implicit flow — the reset link delivers the session in the URL hash,
    // so no PKCE verifier cookie is required and cross-device links work.
    const supabase = createClient(sbUrl, sbKey, {
      auth: { flowType: 'implicit' },
    });

    const loadingEl  = document.getElementById('loadingState')!;
    const expiredEl  = document.getElementById('expiredState')!;
    const formEl     = document.getElementById('formState')!;

    function showExpired() {
      loadingEl.style.display = 'none';
      expiredEl.style.display = 'block';
    }

    function showForm() {
      loadingEl.style.display = 'none';
      formEl.style.display = 'block';
      (document.getElementById('password') as HTMLInputElement).focus();
    }

    async function init() {
      // The hash fragment is never sent to the server; read it here.
      const hash   = window.location.hash.substring(1);
      const params = new URLSearchParams(hash);

      const accessToken  = params.get('access_token');
      const refreshToken = params.get('refresh_token') ?? '';
      const type         = params.get('type');

      // Wipe the tokens from the URL bar immediately
      history.replaceState(null, '', window.location.pathname);

      if (!accessToken || type !== 'recovery') {
        showExpired();
        return;
      }

      const { error } = await supabase.auth.setSession({
        access_token:  accessToken,
        refresh_token: refreshToken,
      });

      if (error) {
        showExpired();
        return;
      }

      showForm();
    }

    init();

    // ── Password form ──────────────────────────────────────────────────────
    const form      = document.getElementById('confirmForm') as HTMLFormElement;
    const errorMsg  = document.getElementById('errorMsg')!;
    const successMsg = document.getElementById('successMsg')!;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg.classList.remove('visible');
      successMsg.classList.remove('visible');

      const password        = (document.getElementById('password')        as HTMLInputElement).value;
      const confirmPassword = (document.getElementById('confirmPassword') as HTMLInputElement).value;

      if (password !== confirmPassword) {
        errorMsg.textContent = 'Passwords do not match.';
        errorMsg.classList.add('visible');
        return;
      }
      if (password.length < 8) {
        errorMsg.textContent = 'Password must be at least 8 characters.';
        errorMsg.classList.add('visible');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Saving…';

      const { error } = await supabase.auth.updateUser({ password });

      if (error) {
        errorMsg.textContent = error.message ?? 'Something went wrong.';
        errorMsg.classList.add('visible');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Set new password';
        return;
      }

      // Sign out so the user starts a fresh session with the new password
      await supabase.auth.signOut();

      form.style.display = 'none';
      successMsg.textContent = 'Password updated! Redirecting to sign in…';
      successMsg.classList.add('visible');
      setTimeout(() => { window.location.href = '/signin'; }, 2000);
    });
  </script>
</body>
</html>
