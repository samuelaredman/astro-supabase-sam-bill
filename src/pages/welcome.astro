---
export const prerender = false;
import Layout from "../components/Layout.astro";
import GettingStarted from "../components/GettingStarted.astro";
import OnboardingWizard from "../components/OnboardingWizard.astro";
import { createSupabaseServerClientFromContext } from "../utils/database";

const supabase = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await supabase.auth.getUser();

if (!user) return Astro.redirect("/signin");

const { data: profile } = await supabase
  .from("profiles")
  .select("id, username, avatar_url, bio, favorite_game_id, showcase_games, favorite_game:games!favorite_game_id (id, title, slug, cover_img_url)")
  .eq("auth_user_id", user.id)
  .single();

const username = profile?.username ?? "there";

let hasReview = false;
if (profile) {
  const { count } = await supabase
    .from("reviews")
    .select("id", { count: "exact", head: true })
    .eq("profile_id", profile.id)
    .eq("status", "published");
  hasReview = (count ?? 0) > 0;
}
const hasAvatar = !!profile?.avatar_url;
const hasBio = !!profile?.bio;
const hasFavorite = !!profile?.favorite_game_id;
const existingShowcase = (Array.isArray(profile?.showcase_games) ? profile.showcase_games : []).filter(Boolean);
const hasShowcase = existingShowcase.length >= 3;
// Supabase types this to-one embed as an array — normalize to a single object.
const favoriteGameRaw = profile?.favorite_game as any;
const existingFavorite = Array.isArray(favoriteGameRaw) ? (favoriteGameRaw[0] ?? null) : (favoriteGameRaw ?? null);
// A brand-new user is always missing all three — but a returning visitor to
// this page (e.g. re-confirming email) who already set some of them shouldn't
// be forced to redo what's already done. OnboardingWizard skips satisfied steps.
const needsOnboarding = !(hasAvatar && hasFavorite && hasShowcase);
---

<Layout title="Welcome to Chekpoint" isLoggedIn={true} currentProfile={profile}>
  {needsOnboarding && profile && (
    <OnboardingWizard
      username={username}
      hasAvatar={hasAvatar}
      hasFavorite={hasFavorite}
      hasShowcase={hasShowcase}
      existingFavorite={existingFavorite}
      existingShowcase={existingShowcase}
    />
  )}
  {!needsOnboarding && (
    <main class="welcome-wrap">
      <div class="welcome-card">
        <div class="welcome-icon">🎮</div>
        <h1>Welcome to Chekpoint, <span class="username">@{username}</span></h1>
        <p>Your email is confirmed and your account is ready. New here? Take a quick tour, or knock out your first steps below.</p>

        <button class="welcome-tour-btn" data-start-tour="site" type="button">Take a quick tour →</button>

        <div class="welcome-checklist">
          <GettingStarted variant="welcome" hasAvatar={hasAvatar} hasBio={hasBio} hasFavorite={hasFavorite} hasReview={hasReview} />
        </div>

        <a href="/settings#steam" class="welcome-secondary">Or sync your Steam library to import your games →</a>

        <a href="/" class="skip-link">Skip for now — take me to the feed</a>
      </div>
    </main>
  )}
</Layout>

<style>
  .welcome-wrap {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 16px;
  }

  .welcome-card {
    background: var(--bg-card, #1a1a1a);
    border: 1px solid var(--border, #2a2a2a);
    border-radius: 16px;
    padding: 48px 40px;
    max-width: 520px;
    width: 100%;
    text-align: center;
  }

  .welcome-icon {
    font-size: 48px;
    margin-bottom: 20px;
  }

  h1 {
    font-size: 24px;
    font-weight: 700;
    color: var(--text-primary, #ffffff);
    margin: 0 0 12px;
  }

  .username {
    color: var(--accent, #7c3aed);
  }

  p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary, #a0a0a0);
    margin: 0 0 28px;
  }

  .welcome-tour-btn {
    display: inline-block;
    background: var(--accent, #7c3aed);
    color: var(--accent-text, #fff);
    border: none;
    border-radius: 22px;
    padding: 11px 26px;
    font-size: 14px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    margin-bottom: 24px;
    transition: opacity 0.15s;
  }
  .welcome-tour-btn:hover { opacity: 0.9; }

  .welcome-checklist {
    text-align: left;
    margin-bottom: 20px;
  }

  .welcome-secondary {
    display: block;
    font-size: 13px;
    color: var(--text-secondary, #a0a0a0);
    text-decoration: none;
    margin-bottom: 18px;
  }
  .welcome-secondary:hover { color: var(--accent, #7c3aed); }

  .skip-link {
    display: block;
    font-size: 13px;
    color: var(--text-secondary, #a0a0a0);
    text-decoration: none;
  }

  .skip-link:hover {
    color: var(--text-primary, #ffffff);
    text-decoration: underline;
  }
</style>
