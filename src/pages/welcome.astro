---
export const prerender = false;
import Layout from "../components/Layout.astro";
import { createSupabaseServerClientFromContext } from "../utils/database";

const supabase = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await supabase.auth.getUser();

if (!user) return Astro.redirect("/signin");

const { data: profile } = await supabase
  .from("profiles")
  .select("username")
  .eq("auth_user_id", user.id)
  .single();

const username = profile?.username ?? "there";
---

<Layout title="Welcome to Chekpoint">
  <main class="welcome-wrap">
    <div class="welcome-card">
      <div class="welcome-icon">🎮</div>
      <h1>Welcome to Chekpoint, <span class="username">@{username}</span></h1>
      <p>Your email is confirmed and your account is ready. Start by exploring games or writing your first review.</p>

      <div class="welcome-actions">
        <a href="/" class="btn-primary">Start exploring</a>
        <a href="/settings" class="btn-secondary">Complete your profile</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .welcome-wrap {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 16px;
  }

  .welcome-card {
    background: var(--bg-card, #1a1a1a);
    border: 1px solid var(--border, #2a2a2a);
    border-radius: 16px;
    padding: 48px 40px;
    max-width: 480px;
    width: 100%;
    text-align: center;
  }

  .welcome-icon {
    font-size: 48px;
    margin-bottom: 20px;
  }

  h1 {
    font-size: 24px;
    font-weight: 700;
    color: var(--text-primary, #ffffff);
    margin: 0 0 12px;
  }

  .username {
    color: var(--accent, #7c3aed);
  }

  p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary, #a0a0a0);
    margin: 0 0 32px;
  }

  .welcome-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .btn-primary {
    display: block;
    padding: 12px 24px;
    background: var(--accent, #7c3aed);
    color: #ffffff;
    text-decoration: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    transition: opacity 0.15s;
  }

  .btn-primary:hover {
    opacity: 0.85;
  }

  .btn-secondary {
    display: block;
    padding: 12px 24px;
    background: transparent;
    color: var(--text-secondary, #a0a0a0);
    text-decoration: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 500;
    border: 1px solid var(--border, #2a2a2a);
    transition: border-color 0.15s, color 0.15s;
  }

  .btn-secondary:hover {
    border-color: var(--accent, #7c3aed);
    color: var(--text-primary, #ffffff);
  }
</style>
