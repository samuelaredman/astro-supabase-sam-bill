---
export const prerender = false;
import Layout from "../components/Layout.astro";
import { createSupabaseServerClientFromContext } from "../utils/database";

const supabase = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await supabase.auth.getUser();

if (!user) return Astro.redirect("/signin");

const { data: profile } = await supabase
  .from("profiles")
  .select("username")
  .eq("auth_user_id", user.id)
  .single();

const username = profile?.username ?? "there";
---

<Layout title="Welcome to Chekpoint">
  <main class="welcome-wrap">
    <div class="welcome-card">
      <div class="welcome-icon">🎮</div>
      <h1>Welcome to Chekpoint, <span class="username">@{username}</span></h1>
      <p>Your email is confirmed and your account is ready. Here's how to get the most out of Chekpoint:</p>

      <div class="welcome-steps">
        <a href={`/reviewers/${username}`} class="welcome-step">
          <div class="step-num">1</div>
          <div class="step-body">
            <div class="step-title">Complete your profile</div>
            <div class="step-desc">Add an avatar, bio, and favorite game so other reviewers know who you are.</div>
          </div>
          <div class="step-arrow">→</div>
        </a>

        <a href="/settings#steam" class="welcome-step">
          <div class="step-num">2</div>
          <div class="step-body">
            <div class="step-title">Sync your Steam library</div>
            <div class="step-desc">Connect Steam to import your owned games and playtime automatically.</div>
          </div>
          <div class="step-arrow">→</div>
        </a>

        <a href="/discover" class="welcome-step">
          <div class="step-num">3</div>
          <div class="step-body">
            <div class="step-title">Find games and write a review</div>
            <div class="step-desc">Score a game 1–10, share your take, and follow other reviewers you trust.</div>
          </div>
          <div class="step-arrow">→</div>
        </a>
      </div>

      <a href="/" class="skip-link">Skip for now — take me to the feed</a>
    </div>
  </main>
</Layout>

<style>
  .welcome-wrap {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 16px;
  }

  .welcome-card {
    background: var(--bg-card, #1a1a1a);
    border: 1px solid var(--border, #2a2a2a);
    border-radius: 16px;
    padding: 48px 40px;
    max-width: 520px;
    width: 100%;
    text-align: center;
  }

  .welcome-icon {
    font-size: 48px;
    margin-bottom: 20px;
  }

  h1 {
    font-size: 24px;
    font-weight: 700;
    color: var(--text-primary, #ffffff);
    margin: 0 0 12px;
  }

  .username {
    color: var(--accent, #7c3aed);
  }

  p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary, #a0a0a0);
    margin: 0 0 28px;
  }

  .welcome-steps {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 24px;
  }

  .welcome-step {
    display: flex;
    align-items: center;
    gap: 14px;
    text-align: left;
    padding: 14px 16px;
    background: var(--bg-hover, #222222);
    border: 1px solid var(--border, #2a2a2a);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .welcome-step:hover {
    border-color: var(--accent, #7c3aed);
  }

  .step-num {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--accent, #7c3aed);
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .step-body {
    flex: 1;
    min-width: 0;
  }

  .step-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary, #ffffff);
    margin-bottom: 2px;
  }

  .step-desc {
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--text-secondary, #a0a0a0);
  }

  .step-arrow {
    flex-shrink: 0;
    color: var(--text-tertiary, #6b6b6b);
    font-size: 15px;
  }

  .skip-link {
    display: block;
    font-size: 13px;
    color: var(--text-secondary, #a0a0a0);
    text-decoration: none;
  }

  .skip-link:hover {
    color: var(--text-primary, #ffffff);
    text-decoration: underline;
  }
</style>
