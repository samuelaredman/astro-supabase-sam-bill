---
export const prerender = false;
import Layout from "../components/Layout.astro";
import { createSupabaseServerClientFromContext } from "../utils/database";

const supabase = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await supabase.auth.getUser();

if (!user) return Astro.redirect("/signin");

const { data: profile } = await supabase
  .from("profiles")
  .select("id, username, avatar_url")
  .eq("auth_user_id", user.id)
  .single();

const username = profile?.username ?? "there";
// The mandatory setup wizard (photo/favorite/showcase/tour) is a site-wide
// gate mounted in Layout.astro — it'll already be covering this page for any
// profile that still needs it. Anyone who actually reaches this content has
// already been through it, so this is just a plain landing confirmation.
---

<Layout title="Welcome to Chekpoint" isLoggedIn={true} currentProfile={profile}>
  <main class="welcome-wrap">
    <div class="welcome-card">
      <div class="welcome-icon">🎮</div>
      <h1>Welcome to Chekpoint, <span class="username">@{username}</span></h1>
      <p>Your email is confirmed and your account is ready.</p>

      <a href="/" class="welcome-cta">Go to your feed →</a>

      <a href="/settings#steam" class="welcome-secondary">Sync your Steam library to import your games →</a>
    </div>
  </main>
</Layout>

<style>
  .welcome-wrap {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 16px;
  }

  .welcome-card {
    background: var(--bg-card, #1a1a1a);
    border: 1px solid var(--border, #2a2a2a);
    border-radius: 16px;
    padding: 48px 40px;
    max-width: 520px;
    width: 100%;
    text-align: center;
  }

  .welcome-icon {
    font-size: 48px;
    margin-bottom: 20px;
  }

  h1 {
    font-size: 24px;
    font-weight: 700;
    color: var(--text-primary, #ffffff);
    margin: 0 0 12px;
  }

  .username {
    color: var(--accent, #7c3aed);
  }

  p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary, #a0a0a0);
    margin: 0 0 28px;
  }

  .welcome-cta {
    display: inline-block;
    background: var(--accent, #7c3aed);
    color: var(--accent-text, #fff);
    border: none;
    border-radius: 22px;
    padding: 11px 26px;
    font-size: 14px;
    font-weight: 600;
    font-family: inherit;
    text-decoration: none;
    cursor: pointer;
    margin-bottom: 20px;
    transition: opacity 0.15s;
  }
  .welcome-cta:hover { opacity: 0.9; }

  .welcome-secondary {
    display: block;
    font-size: 13px;
    color: var(--text-secondary, #a0a0a0);
    text-decoration: none;
  }
  .welcome-secondary:hover { color: var(--accent, #7c3aed); }
</style>
