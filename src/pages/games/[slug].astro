        html += '<div class="pct-marker-anim" data-w="' + b.val + '" style="position:absolute;top:50%;transform:translate(-50%,-50%);width:14px;height:14px;border-radius:50%;background:' + b.color + ';border:2px solid var(--bg-card);left:0;transition:left 1.1s cubic-bezier(.4,0,.2,1);box-shadow:0 0 8px ' + b.color + '88"></div>'
