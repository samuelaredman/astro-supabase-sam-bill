---
export const prerender = false;

import { getSupabase, createSupabaseServerClientFromContext, getSupabaseAdmin } from '../../utils/database'
const supabase = getSupabase();
import { igdbFetch } from '../../utils/igdb'
import { igdbImage, scoreClass, timeAgo } from '../../utils/format'
import Layout from '../../components/Layout.astro'
import ReviewCard from '../../components/ReviewCard.astro'
import ReportModal from '../../components/ReportModal.astro'
import ListCard from '../../components/ListCard.astro'
import RecommendationFeedCard from '../../components/RecommendationFeedCard.astro'
import RecommendationComposer from '../../components/RecommendationComposer.astro'
import { REC_SELECT, shapeRec } from '../../utils/recommendationsFeed'

const serverClient = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await serverClient.auth.getUser();
const isLoggedIn = !!user;

const { slug } = Astro.params;
const activeTab = Astro.url.searchParams.get('tab') || 'overview'

const { data: game } = await (supabase as any)
  .from('games')
  .select(`
    id, title, slug, game_description, cover_img_url,
    date_released, igdb_id,
    game_genres(genres(id, name, slug)),
    game_platforms(platforms(id, name, slug)),
    game_companies(role, developers(id, name, slug))
  `)
  .eq('slug', slug)
  .single()

if (!game) return Astro.redirect('/404')

const { data: reviews } = await (supabase as any)
  .from('reviews')
  .select(`
    id, score, title, body, published_at, created_at,
    contains_spoilers, play_time_hours,
    played_on:platform_played_on ( id, name, slug ),
    profiles ( id, username, avatar_url ),
    review_votes ( vote, profile_id ),
    review_reactions( reaction_type, profile_id ),
    review_comments( id )
  `)
  .eq('game_id', game.id)
  .eq('status', 'published')
  .order('published_at', { ascending: false })

let currentProfileId: string | null = null;
if (user) {
  const { data: cp } = await (supabase as any)
    .from('profiles').select('id').eq('auth_user_id', user.id).single();
  currentProfileId = cp?.id ?? null;
}

// Game status counts (public) + current user's status
const db = getSupabaseAdmin() as any;

// Recommendations involving this game (as source or target), most-recent-first
const { data: gameRecsRaw } = await db
  .from('recommendations')
  .select(REC_SELECT)
  .or(`source_game_id.eq.${game.id},target_game_id.eq.${game.id}`)
  .order('created_at', { ascending: false })
  .limit(50);
const gameRecs = (gameRecsRaw ?? []).map((r: any) => shapeRec(r, currentProfileId));

const { count: wantToPlayCount } = await db
  .from('user_game_status').select('*', { count: 'exact', head: true })
  .eq('game_id', game.id).eq('status', 'want_to_play');

let currentGameStatus: string | null = null;
let currentGameOwned = false;
let currentGameHidden = false;
if (currentProfileId) {
  const { data: statusRow } = await db
    .from('user_game_status').select('status, is_owned, is_hidden')
    .eq('profile_id', currentProfileId).eq('game_id', game.id).maybeSingle();
  currentGameStatus = statusRow?.status ?? null;
  currentGameOwned = statusRow?.is_owned ?? false;
  currentGameHidden = statusRow?.is_hidden ?? false;
}

// ── SOCIAL TRACKING — people the current user follows who have tracked this game ──
type FriendStatusGroups = { playing: any[]; want_to_play: any[]; owned: any[]; completed: any[]; hundred_percent: any[]; dropped: any[] };
let friendStatusGroups: FriendStatusGroups = { playing: [], want_to_play: [], owned: [], completed: [], hundred_percent: [], dropped: [] };
// 'hidden' is never surfaced in social tracking
let hasFriendActivity = false;

if (currentProfileId) {
  // Step 1: fetch everyone who has tracked THIS game (bounded by game popularity, not follow count).
  // Exclude the viewer themselves, cap at 200 rows — more than enough to find 5 per status group.
  const { data: gameTrackers, error: trackersError } = await db
    .from('user_game_status')
    .select('status, profile_id, profiles(id, username, avatar_url, want_to_play_privacy, dropped_privacy)')
    .eq('game_id', game.id)
    .neq('profile_id', currentProfileId)
    .order('updated_at', { ascending: false })
    .limit(200);
  if (trackersError) console.error('[social-tracking] gameTrackers error:', JSON.stringify(trackersError));
  console.log('[social-tracking] viewer:', currentProfileId, 'game:', game.id, 'trackers found:', gameTrackers?.length ?? 0);

  const trackerIds: string[] = (gameTrackers ?? []).map((r: any) => r.profile_id);

  if (trackerIds.length > 0) {
    // Step 2: which of those does the current user follow? IN clause is bounded by tracker count.
    const { data: followedRows, error: followsError } = await db
      .from('follows').select('following_id')
      .eq('follower_id', currentProfileId)
      .in('following_id', trackerIds);
    if (followsError) console.error('[social-tracking] followedRows error:', JSON.stringify(followsError));
    console.log('[social-tracking] followed trackers:', followedRows?.length ?? 0, followedRows);
    const followedSet = new Set<string>((followedRows ?? []).map((r: any) => r.following_id));

    // Only keep trackers the current user follows
    const friendStatuses = (gameTrackers ?? []).filter((item: any) => followedSet.has(item.profile_id));

    if (friendStatuses.length > 0) {
      // Mutual follows — only needed to enforce 'friends' privacy tier
      const { data: followerRows } = await db
        .from('follows').select('follower_id')
        .eq('following_id', currentProfileId)
        .in('follower_id', trackerIds);
      const mutualIds = new Set<string>((followerRows ?? []).map((r: any) => r.follower_id));

      for (const item of friendStatuses) {
        const p = item.profiles;
        if (!p) continue;
        // Undefined/null privacy → treat as 'public' (default). Skip only when
        // explicitly 'private' or 'friends' without a mutual follow.
        if (item.status === 'want_to_play') {
          if (p.want_to_play_privacy === 'private') continue;
          if (p.want_to_play_privacy === 'friends' && !mutualIds.has(item.profile_id)) continue;
        }
        if (item.status === 'dropped') {
          if (p.dropped_privacy === 'private') continue;
          if (p.dropped_privacy === 'friends' && !mutualIds.has(item.profile_id)) continue;
        }
        if (item.status !== 'hidden' && friendStatusGroups[item.status as keyof FriendStatusGroups]) {
          friendStatusGroups[item.status as keyof FriendStatusGroups].push(p);
        }
      }
      hasFriendActivity = (Object.values(friendStatusGroups) as any[][]).some(arr => arr.length > 0);
    }
  }
}

// ── PUBLIC LISTS containing this game ──
const { data: containingRaw } = await db
  .from('list_entries')
  .select('list_id')
  .eq('game_id', game.id);

const containingListIds = (containingRaw ?? []).map((r: any) => r.list_id);

let gameLists: any[] = [];

if (containingListIds.length > 0) {
  const { data: listsRaw } = await db
    .from('lists')
    .select('id, title, is_ranked, visibility, updated_at, profiles(id, username, avatar_url)')
    .in('id', containingListIds)
    .eq('visibility', 'public')
    .order('updated_at', { ascending: false })
    .limit(6);

  const publicListIds = (listsRaw ?? []).map((l: any) => l.id);

  if (publicListIds.length > 0) {
    const [{ data: coverEntries }, { data: allEntries }] = await Promise.all([
      db.from('list_entries')
        .select('list_id, games(cover_img_url)')
        .in('list_id', publicListIds)
        .order('position', { ascending: true, nullsFirst: false })
        .order('added_at', { ascending: true }),
      db.from('list_entries')
        .select('list_id')
        .in('list_id', publicListIds),
    ]);

    const coversByListId: Record<string, string[]> = {};
    for (const e of coverEntries ?? []) {
      const cover = igdbImage(e.games?.cover_img_url, 't_cover_big');
      if (cover) {
        if (!coversByListId[e.list_id]) coversByListId[e.list_id] = [];
        if (coversByListId[e.list_id].length < 4) coversByListId[e.list_id].push(cover);
      }
    }
    const entryCountByListId: Record<string, number> = {};
    for (const e of allEntries ?? []) {
      entryCountByListId[e.list_id] = (entryCountByListId[e.list_id] ?? 0) + 1;
    }

    gameLists = (listsRaw ?? []).map((l: any) => ({
      ...l,
      ownerUsername: l.profiles?.username,
      ownerAvatar: l.profiles?.avatar_url,
      coverUrls: coversByListId[l.id] ?? [],
      entryCount: entryCountByListId[l.id] ?? 0,
    }));
  }
}

const SOCIAL_STATUS_META: Record<string, { label: string; color: string }> = {
  playing:        { label: '🎮 Playing',      color: '#60a5fa' },
  completed:      { label: '✓ Completed',     color: '#4ade80' },
  hundred_percent:{ label: '💯 100%',         color: '#fbbf24' },
  want_to_play:   { label: '🔖 Want to Play', color: '#f59e0b' },
  owned:          { label: '📦 Owned',        color: '#94a3b8' },
  dropped:        { label: '✗ Dropped',       color: '#f87171' },
};
const SOCIAL_STATUS_ORDER = ['playing', 'completed', 'hundred_percent', 'want_to_play', 'owned', 'dropped'] as const;

const reviewList = reviews ?? []

let igdbData: any = null
if (game.igdb_id) {
  const result = await igdbFetch('games',
    `fields summary, rating,
            artworks.url,
            screenshots.url,
            videos.video_id,
            game_modes.name,
            themes.name,
            franchises.name,
            game_engines.name,
            alternative_names.name,
            similar_games.id,
            similar_games.name,
            similar_games.slug,
            similar_games.cover.url;
     where id = ${game.igdb_id};`)
  igdbData = result?.[0] ?? null
}

const heroArtwork = igdbData?.artworks?.[0]?.url ?? null
const heroScreenshot = igdbData?.screenshots?.[0]?.url ?? null
const showCoverBlur = !heroArtwork && !heroScreenshot


const heroImageUrl = heroArtwork
  ? igdbImage(heroArtwork, 't_1080p_2x') ?? ''
  : heroScreenshot ? igdbImage(heroScreenshot, 't_1080p_2x') ?? '' : ''

const heroImageUrl1x = heroArtwork
  ? igdbImage(heroArtwork, 't_1080p') ?? ''
  : heroScreenshot ? igdbImage(heroScreenshot, 't_1080p') ?? '' : ''

const avgScore = reviewList.length > 0
  ? (reviewList.reduce((sum: number, r: any) => sum + r.score, 0) / reviewList.length).toFixed(1)
  : null

const scoreDistribution = Array.from({ length: 10 }, (_, i) =>
  reviewList.filter((r: any) => Math.round(r.score) === i + 1).length
)

const totalHours = reviewList.reduce((sum: number, r: any) => sum + (r.play_time_hours ?? 0), 0)
const avgHours = reviewList.length > 0 ? Math.round(totalHours / reviewList.length) : null

const developers = (game.game_companies ?? []).filter((c: any) => c.role === 'developer').map((c: any) => c.developers).filter(Boolean)
const publishers = (game.game_companies ?? []).filter((c: any) => c.role === 'publisher').map((c: any) => c.developers).filter(Boolean)
const genres = (game.game_genres ?? []).map((gg: any) => gg.genres).filter(Boolean)
const platforms = (game.game_platforms ?? []).map((gp: any) => gp.platforms).filter(Boolean)
const similarGames = (igdbData?.similar_games ?? []).slice(0, 8)

const releaseYear = game.date_released ? new Date(game.date_released).getFullYear() : null
const releaseDate = game.date_released
  ? new Date(game.date_released).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null
const trailerVideoId = igdbData?.videos?.[0]?.video_id ?? null

// ── STATS ──
const releaseYearStr = releaseYear ? String(releaseYear) : null
const primaryGenreId = genres[0]?.id ?? null

// Reviews is an unbounded table — Supabase caps a single query at 1000 rows,
// so this must page through in batches or scores silently go missing once
// the site passes 1000 published reviews.
const allScoreRows: { game_id: string; score: number }[] = []
{
  const PAGE_SIZE = 1000
  let from = 0
  while (true) {
    const { data: page } = await (supabase as any)
      .from('reviews').select('game_id, score').eq('status', 'published')
      .range(from, from + PAGE_SIZE - 1)
    if (!page || page.length === 0) break
    allScoreRows.push(...page)
    if (page.length < PAGE_SIZE) break
    from += PAGE_SIZE
  }
}

const gameScoreMap: Record<string, number[]> = {}
for (const r of allScoreRows) {
  if (!gameScoreMap[r.game_id]) gameScoreMap[r.game_id] = []
  gameScoreMap[r.game_id].push(r.score)
}
const gameAvgs: Record<string, number> = {}
for (const [gid, scores] of Object.entries(gameScoreMap)) {
  gameAvgs[gid] = scores.reduce((a: number, b: number) => a + b, 0) / scores.length
}

// Look up Chekpoint IDs for similar games so we can show their avg scores
const similarSlugs = similarGames.map((g: any) => g.slug).filter(Boolean)
const similarGameScores: Record<string, number> = {}
if (similarSlugs.length > 0) {
  const { data: simRows } = await (supabase as any)
    .from('games').select('id, slug').in('slug', similarSlugs)
  for (const row of simRows ?? []) {
    if (gameAvgs[row.id] != null) similarGameScores[row.slug] = gameAvgs[row.id]
  }
}

const thisAvg = avgScore ? parseFloat(avgScore) : 0
const allAvgs = Object.values(gameAvgs).sort((a, b) => b - a)
const allTimeRank = allAvgs.findIndex(v => v <= thisAvg) + 1
const allTimeTotal = allAvgs.length
const allTimePct = allTimeTotal > 0 ? Math.round(((allTimeTotal - allTimeRank) / allTimeTotal) * 100) : 0

let genreRank = 0, genreTotal = 0, genrePct = 0
if (primaryGenreId) {
  const { data: genreGameRows } = await (supabase as any).from('game_genres').select('game_id').eq('genre_id', primaryGenreId)
  const genreGameIds = new Set((genreGameRows ?? []).map((r: any) => r.game_id))
  const genreAvgsList = allAvgs.filter((_, i) => {
    const gid = Object.keys(gameAvgs).find(k => gameAvgs[k] === allAvgs[i])
    return gid && genreGameIds.has(gid)
  })
  genreTotal = genreAvgsList.length
  genreRank = genreAvgsList.filter(v => v > thisAvg).length + 1
  genrePct = genreTotal > 0 ? Math.round(((genreTotal - genreRank) / genreTotal) * 100) : 0
}

let yearRank = 0, yearTotal = 0, yearPct = 0
if (releaseYearStr) {
  const { data: yearGameRows } = await (supabase as any).from('games').select('id')
    .gte('date_released', `${releaseYearStr}-01-01`).lte('date_released', `${releaseYearStr}-12-31`)
  const yearGameIds = new Set((yearGameRows ?? []).map((r: any) => r.id))
  const yearAvgsArr = Object.entries(gameAvgs).filter(([gid]) => yearGameIds.has(gid)).map(([, avg]) => avg).sort((a, b) => b - a)
  yearTotal = yearAvgsArr.length
  yearRank = yearAvgsArr.filter(v => v > thisAvg).length + 1
  yearPct = yearTotal > 0 ? Math.round(((yearTotal - yearRank) / yearTotal) * 100) : 0
}

const platformCounts: Record<string, number> = {}
for (const r of reviewList) {
  const name = (r as any).played_on?.name ?? 'Unknown'
  platformCounts[name] = (platformCounts[name] ?? 0) + 1
}
const platformBreakdown = Object.entries(platformCounts)
  .sort((a, b) => b[1] - a[1]).slice(0, 5)
  .map(([name, count]) => ({ name, count, pct: Math.round((count / reviewList.length) * 100) }))

const recommendedCount = reviewList.filter((r: any) => r.score >= 7).length
const recommendedRate = reviewList.length > 0 ? Math.round((recommendedCount / reviewList.length) * 100) : 0

let genreAvgScore = 0
if (primaryGenreId) {
  const { data: genreGameRows2 } = await (supabase as any).from('game_genres').select('game_id').eq('genre_id', primaryGenreId)
  const genreGameIds2 = new Set((genreGameRows2 ?? []).map((r: any) => r.game_id))
  const genreScores: number[] = []
  for (const [gid, scores] of Object.entries(gameScoreMap)) {
    if (genreGameIds2.has(gid)) genreScores.push(...scores)
  }
  genreAvgScore = genreScores.length > 0
    ? Math.round((genreScores.reduce((a, b) => a + b, 0) / genreScores.length) * 10) / 10 : 0
}

// monthly reviews + avg scores — last 6 months
const monthlyReviews: Record<string, number> = {}
const monthlyScores: Record<string, number[]> = {}
for (const r of reviewList) {
  const d = new Date((r as any).published_at ?? (r as any).created_at)
  const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`
  monthlyReviews[key] = (monthlyReviews[key] ?? 0) + 1
  if (!monthlyScores[key]) monthlyScores[key] = []
  monthlyScores[key].push((r as any).score)
}
const monthLabels: string[] = []
const monthCounts: number[] = []
const monthAvgScores: (number | null)[] = []
for (let i = 5; i >= 0; i--) {
  const d = new Date()
  d.setMonth(d.getMonth() - i)
  const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`
  monthLabels.push(d.toLocaleDateString('en-US', { month: 'short' }))
  const cnt = monthlyReviews[key] ?? 0
  monthCounts.push(cnt)
  if (cnt > 0 && monthlyScores[key]) {
    const avg = monthlyScores[key].reduce((a, b) => a + b, 0) / monthlyScores[key].length
    monthAvgScores.push(Math.round(avg * 10) / 10)
  } else {
    monthAvgScores.push(null)
  }
}

// hours played distribution
const hoursBuckets = [
  { label: '0-10h', min: 0, max: 10 },
  { label: '10-25h', min: 10, max: 25 },
  { label: '25-50h', min: 25, max: 50 },
  { label: '50-100h', min: 50, max: 100 },
  { label: '100h+', min: 100, max: Infinity },
]
const hoursDistribution = hoursBuckets.map(b => ({
  label: b.label,
  count: reviewList.filter((r: any) =>
    r.play_time_hours != null && r.play_time_hours >= b.min && r.play_time_hours < b.max
  ).length
}))

// score by platform
const platScoreMap: Record<string, number[]> = {}
for (const r of reviewList) {
  const name = (r as any).played_on?.name ?? null
  if (!name) continue
  if (!platScoreMap[name]) platScoreMap[name] = []
  platScoreMap[name].push((r as any).score)
}
const platformScores = Object.entries(platScoreMap)
  .map(([name, scores]) => ({
    name,
    avg: Math.round((scores.reduce((a, b) => a + b, 0) / scores.length) * 10) / 10,
    count: scores.length
  }))
  .sort((a, b) => b.count - a.count)


const distJson = JSON.stringify(scoreDistribution)
const coverBlurUrl = igdbImage(game.cover_img_url, 't_cover_big') ?? ''

// ── SEO ──
const ogImageUrl = game.cover_img_url ? (igdbImage(game.cover_img_url, 't_cover_big') ?? '') : ''
const gameDescription = reviewList.length > 0
  ? `${game.title} holds a Chekpoint score of ${avgScore}/10 from ${reviewList.length} review${reviewList.length !== 1 ? 's' : ''}.${game.game_description ? ' ' + game.game_description.slice(0, 90) + '…' : ''}`
  : game.game_description
    ? `${game.game_description.slice(0, 155)}${game.game_description.length > 155 ? '…' : ''}`
    : `Read community reviews for ${game.title} on Chekpoint.`

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: game.title,
  ...(game.game_description ? { description: game.game_description } : {}),
  ...(ogImageUrl ? { image: ogImageUrl } : {}),
  ...(game.date_released ? { datePublished: game.date_released.slice(0, 10) } : {}),
  ...(genres.length ? { genre: genres.map((g: any) => g.name) } : {}),
  ...(platforms.length ? { gamePlatform: platforms.map((p: any) => p.name) } : {}),
  ...(developers.length ? { author: developers.map((d: any) => ({ '@type': 'Organization', name: d.name })) } : {}),
  ...(avgScore && reviewList.length > 0 ? {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: avgScore,
      bestRating: '10',
      worstRating: '1',
      ratingCount: reviewList.length,
    }
  } : {}),
}
const trailerSrc = trailerVideoId ? `https://www.youtube.com/embed/${trailerVideoId}?autoplay=1&rel=0` : ''
const statsJson = JSON.stringify({
  allTimeRank, allTimeTotal, allTimePct,
  genreRank, genreTotal, genrePct,
  yearRank, yearTotal, yearPct,
  platformBreakdown, recommendedRate,
  totalHours, avgHours,
  genreAvgScore,
  genreName: genres[0]?.name ?? 'Genre',
  releaseYear, reviewCount: reviewList.length,
  scoreDistribution, monthLabels, monthCounts, monthAvgScores,
  hoursDistribution, platformScores,
})

// CDN cache — anonymous visitors share a cached response; auth users get a fresh render
if (!isLoggedIn) {
  Astro.response.headers.set('Netlify-CDN-Cache-Control', 'public, max-age=300, stale-while-revalidate=600');
  Astro.response.headers.set('Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}
Astro.response.headers.set('Netlify-Vary', 'cookie=sb-bzlwwtatoiyzwirerify-auth-token');
---

<Layout title={`${game.title} — Chekpoint`} description={gameDescription} ogImage={ogImageUrl} variant="fullwidth" noindex={reviewList.length < 1}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet" />
  </Fragment>
<style is:global>
    :root[data-theme="light"] {
      --bg:#f5f4f2;--bg-card:#ffffff;--bg-hover:#f4f3f0;
      --score-mid:#6b5a1a;--score-mid-bg:#f5f0ea;
      --game-accent:#4a3a8a;--game-accent-subtle:rgba(74,58,138,.06);
      --hero-overlay:linear-gradient(to bottom,rgba(245,244,242,.05)0%,rgba(245,244,242,.2)40%,rgba(245,244,242,.85)75%,rgba(245,244,242,1)100%);
      --hero-side:linear-gradient(to right,rgba(245,244,242,.4)0%,transparent 40%);
    }
    /* Score-hero card stays dark in light mode so neon score colors remain readable */
    [data-theme="light"] .score-hero {
      background:#14121e;
      border-color:rgba(96,80,200,.3);
      --score-perfect:#ffffff;
      --score-great:#4ade80;
      --score-teal:#2dd4bf;
      --score-good:#60a5fa;
      --score-mid:#fbbf24;
      --score-orange:#fb923c;
      --score-low:#f87171;
    }
    [data-theme="light"] .score-hero .score-label {
      color:rgba(255,255,255,.42);
    }
    [data-theme="light"] .score-hero .review-count-label {
      color:rgba(255,255,255,.55);
    }
    [data-theme="light"] .score-hero .score-divider {
      background:rgba(255,255,255,.1);
    }
    [data-theme="light"] .score-hero .dist-label {
      color:rgba(255,255,255,.32);
    }
    :root[data-theme="dark"] {
      --bg:#09090a;--bg-card:#131314;--bg-hover:#1c1c1e;
      --border:#222224;--border-subtle:#191919;
      --text-tertiary:#484644;--tag-bg:#1c1c1e;--tag-text:#6a6866;
      --shadow:0 1px 3px rgba(0,0,0,.5);--shadow-md:0 4px 16px rgba(0,0,0,.7);
      --score-great:#4ade80;--score-great-bg:#112e1c;
      --score-teal:#2dd4bf;--score-teal-bg:#082d2a;
      --score-good:#60a5fa;--score-good-bg:#0e2240;
      --score-mid:#fbbf24;--score-mid-bg:#271e00;
      --score-orange:#fb923c;--score-orange-bg:#2c160a;
      --score-low:#f87171;--score-low-bg:#300e0e;
      --score-perfect:#ffffff;--score-perfect-bg:#22223a;
      --game-accent:#6050c8;--game-accent-subtle:rgba(96,80,200,.09);
      --hero-overlay:linear-gradient(to bottom,rgba(9,9,10,.05)0%,rgba(9,9,10,.2)40%,rgba(9,9,10,.8)75%,rgba(9,9,10,1)100%);
      --hero-side:linear-gradient(to right,rgba(9,9,10,.5)0%,transparent 40%);
    }
    html{scroll-behavior:smooth}

    .topnav{position:sticky;top:0;z-index:30;background:rgba(9,9,10,.82);border-bottom:1px solid var(--border);padding:13px 28px;display:flex;align-items:center;backdrop-filter:blur(20px)}
    [data-theme="light"] .topnav{background:rgba(245,244,242,.82)}
    .back-btn{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--text-tertiary);transition:color .15s;background:none;border:none;cursor:pointer;font-family:inherit;padding:0}
    .back-btn:hover{color:var(--text-primary)}
    .logo{font-family:'Press Start 2P',monospace;font-size:13px;letter-spacing:-.3px;line-height:1;display:flex;align-items:center;gap:7px;margin-left:auto}
    .logo-dot{width:6px;height:6px;background:var(--game-accent);border-radius:50%;box-shadow:0 0 10px var(--game-accent)}
    .theme-btn{background:none;border:none;cursor:pointer;color:var(--text-tertiary);padding:6px;display:flex;align-items:center;transition:color .15s;margin-left:8px}
    .theme-btn:hover{color:var(--text-primary)}

    /* TAB NAV */
    .tab-nav{display:flex;gap:4px;margin-bottom:28px;background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:4px}
    .tab-link{padding:8px 18px;border-radius:7px;font-size:13px;font-weight:600;color:var(--text-secondary);text-decoration:none;transition:all .15s;white-space:nowrap;display:flex;align-items:center;gap:6px}
    .tab-link:hover{color:var(--text-primary);background:var(--bg-hover)}
    .tab-link.active{background:var(--game-accent);color:#fff}
    .tab-count{font-size:11px;font-weight:700;background:rgba(255,255,255,.15);border-radius:10px;padding:1px 6px;line-height:1.5}
    .tab-link:not(.active) .tab-count{background:var(--bg-hover);color:var(--text-tertiary)}

    .hero{position:relative;width:100%;height:400px;overflow:hidden;background:#04040a}
    .hero-artwork{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%}
    .hero-cover-blur{position:absolute;inset:-40px;background-size:cover;background-position:center 20%;filter:blur(28px) saturate(1.6) brightness(.5);transform:scale(1.15);display:none}
    .hero-cover-blur.visible{display:block}
    .hero-side-fade{position:absolute;inset:0;background:var(--hero-side)}
    .hero-overlay{position:absolute;inset:0;background:var(--hero-overlay)}

    .page{max-width:980px;margin:0 auto;padding:0 28px 100px}

    .game-header{display:flex;gap:24px;align-items:flex-end;margin-top:-100px;margin-bottom:28px;position:relative;z-index:2}
    .cover-img{width:130px;height:173px;border-radius:12px;object-fit:cover;border:1px solid rgba(96,80,200,.4);box-shadow:0 12px 40px rgba(0,0,0,.8),0 0 32px rgba(96,80,200,.2);display:block;flex-shrink:0}
    .cover-placeholder{width:130px;height:173px;border-radius:12px;background:var(--bg-card);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:48px;flex-shrink:0}
    .game-info{flex:1;min-width:0;padding-bottom:4px}
    .game-title{font-family:'Cinzel',serif;font-size:32px;line-height:1.1;letter-spacing:.04em;margin-bottom:8px;font-weight:600;text-shadow:0 2px 20px rgba(0,0,0,.6)}
    .meta-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:10px}
    .meta-tag{font-size:13px;color:var(--text-secondary)}
    .meta-sep{color:var(--text-tertiary);font-size:10px}
    .meta-link{font-size:13px;color:var(--text-secondary);transition:color .15s}
    .meta-link:hover{color:var(--text-primary);text-decoration:underline;text-underline-offset:3px}
    .platform-list{display:flex;flex-wrap:wrap;gap:5px}
    .platform-tag{background:var(--tag-bg);color:var(--tag-text);font-size:11px;font-weight:500;padding:3px 10px;border-radius:6px;border:1px solid var(--border);transition:border-color .15s,color .15s,background .15s}
    .platform-tag:hover{border-color:var(--game-accent);color:var(--game-accent);background:var(--game-accent-subtle)}

    .score-hero{display:flex;align-items:flex-start;gap:24px;padding:20px 24px;background:var(--bg-card);border:1px solid var(--border);border-radius:16px;margin-bottom:28px;position:relative;overflow:hidden}
    .score-hero::before{content:'';position:absolute;inset:0;background:var(--game-accent-subtle);pointer-events:none}
    .score-hero::after{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(to right,transparent,var(--game-accent),transparent);opacity:.6}
    .avg-score-num{font-family:'Century Schoolbook','New Century Schoolbook',Georgia,serif;font-size:72px;line-height:1;font-weight:700;position:relative;z-index:1;letter-spacing:-3px;padding-top:8px}
    .score-perfect-color{color:#ffffff;text-shadow:0 0 20px rgba(255,255,255,.7),0 0 40px rgba(255,255,255,.3)}
    .score-great-color{color:var(--score-great)}
    .score-teal-color{color:var(--score-teal)}
    .score-good-color{color:var(--score-good)}
    .score-mid-color{color:var(--score-mid)}
    .score-orange-color{color:var(--score-orange)}
    .score-low-color{color:var(--score-low)}
    .score-divider{width:1px;height:56px;background:var(--border);flex-shrink:0;margin-top:8px}
    .score-meta{flex:1;position:relative;z-index:1}
    .score-label{font-size:11px;font-weight:500;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:.1em;margin-bottom:3px}
    .review-count-label{font-size:13px;color:var(--text-secondary);margin-bottom:12px}
    .score-dist{display:flex;gap:4px;align-items:flex-end;height:44px;margin-top:8px}
    .dist-bar-wrap{display:flex;flex-direction:column;align-items:center;gap:3px;flex:1;cursor:pointer}
    .dist-bar{width:100%;border-radius:4px 4px 0 0;min-height:4px;transition:opacity .15s,transform .15s}
    .dist-bar-wrap:hover .dist-bar{opacity:1!important;transform:scaleY(1.06);transform-origin:bottom}
    .dist-label{font-size:9px;color:var(--text-tertiary);font-weight:500;margin-top:2px}
    .write-review-btn{background:var(--game-accent);color:white;border:none;border-radius:22px;padding:10px 20px;font-size:13px;font-weight:500;font-family:inherit;cursor:pointer;transition:opacity .15s,transform .15s;white-space:nowrap;box-shadow:0 4px 24px rgba(96,80,200,.4);position:relative;z-index:1}
    .write-review-btn:hover{opacity:.9;transform:translateY(-1px)}
    .game-action-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
    .track-section{padding:16px 20px;background:var(--bg-card);border:1px solid var(--border);border-radius:14px}
    .track-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
    .track-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-tertiary)}
    .track-hint{font-size:11px;color:var(--text-tertiary);font-style:italic}

    /* SOCIAL TRACKING */
    .social-tracking{padding:14px 18px;background:var(--bg-card);border:1px solid var(--border);border-radius:14px}
    .social-tracking-hdr{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-tertiary);margin-bottom:10px;display:flex;align-items:center;gap:6px}
    .social-groups-scroll{max-height:180px;overflow-y:auto;scrollbar-width:thin}
    .social-group{display:flex;align-items:flex-start;gap:10px;padding:7px 0;border-bottom:1px solid var(--border-subtle)}
    .social-group:last-child{border-bottom:none;padding-bottom:0}
    .social-group:first-child{padding-top:0}
    .social-group-lbl{font-size:11px;font-weight:600;min-width:104px;flex-shrink:0;padding-top:3px}
    .social-members{display:flex;align-items:center;flex-wrap:wrap;gap:6px}
    .social-member{display:flex;align-items:center;gap:5px;text-decoration:none;background:var(--tag-bg);border:1px solid var(--border);border-radius:20px;padding:2px 8px 2px 3px;transition:border-color .15s}
    .social-member:hover{border-color:var(--game-accent)}
    .social-av{width:20px;height:20px;border-radius:50%;overflow:hidden;background:var(--bg-hover);display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:700;color:var(--text-secondary);flex-shrink:0}
    .social-av img{width:100%;height:100%;object-fit:cover;display:block}
    .social-uname{font-size:11px;font-weight:500;color:var(--text-primary)}
    .social-overflow{font-size:11px;color:var(--text-tertiary);padding:2px 6px;background:var(--tag-bg);border:1px solid var(--border);border-radius:20px}
    .track-pills{display:flex;gap:8px;flex-wrap:wrap}
    .track-pill{display:inline-flex;align-items:center;gap:5px;padding:7px 14px;border-radius:20px;font-size:12px;font-weight:500;font-family:inherit;cursor:pointer;transition:all .15s;white-space:nowrap;border:1.5px solid var(--border);background:var(--bg-card);color:var(--text-secondary)}
    .track-pill:hover{border-color:var(--text-tertiary);color:var(--text-primary)}
    .track-pill[data-status="playing"].active{background:rgba(59,130,246,.12);border-color:#3b82f6;color:#3b82f6}
    .track-pill[data-status="want_to_play"].active{background:rgba(245,158,11,.1);border-color:#f59e0b;color:#f59e0b}
    .track-pill[data-status="owned"].active{background:rgba(148,163,184,.12);border-color:#94a3b8;color:#94a3b8}
    .track-pill[data-status="completed"].active{background:rgba(34,197,94,.1);border-color:#22c55e;color:#22c55e}
    .track-pill[data-status="hundred_percent"].active{background:rgba(251,191,36,.1);border-color:#fbbf24;color:#fbbf24}
    .track-pill[data-status="dropped"].active{background:rgba(239,68,68,.08);border-color:#ef4444;color:#ef4444}
    .track-pill[data-status="hidden"].active{background:rgba(100,116,139,.12);border-color:#64748b;color:#64748b}
    .review-nudge{display:none;margin-top:12px;padding:10px 14px;background:rgba(34,197,94,.07);border:1px solid rgba(34,197,94,.2);border-radius:10px;font-size:12px;color:var(--text-secondary);display:none;align-items:center;justify-content:space-between;gap:10px}
    .review-nudge-text{line-height:1.4}
    .review-nudge-actions{display:flex;align-items:center;gap:8px;flex-shrink:0}
    .review-nudge-btn{background:var(--accent);color:#fff;border:none;padding:5px 12px;border-radius:12px;font-size:11px;font-weight:600;font-family:inherit;cursor:pointer}
    .review-nudge-dismiss{background:none;border:none;cursor:pointer;color:var(--text-tertiary);font-size:14px;padding:2px;line-height:1}

    .tab-panel{display:none}
    .tab-panel.active{display:block}
    #reviewsList .rc{padding-left:0;padding-right:0}

    /* TWO COLUMN — OVERVIEW */
    .two-col{display:grid;grid-template-columns:1fr 300px;gap:24px;align-items:start}
    @media(max-width:720px){.two-col{grid-template-columns:1fr}}
    .main-col{min-width:0}
    .sidebar-col{position:sticky;top:20px;display:flex;flex-direction:column;gap:14px}
    .game-lists-sidebar{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:14px}
    .game-lists-sidebar-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-tertiary);margin-bottom:10px}
    .game-lists-sidebar-grid{display:flex;flex-direction:column;gap:10px}
    .section{margin-bottom:32px}
    .section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
    .section-title{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.12em;color:var(--text-tertiary)}
    .section-count{font-size:12px;color:var(--text-tertiary)}

    .trailer-thumb{position:relative;width:100%;aspect-ratio:16/9;border-radius:14px;overflow:hidden;border:1px solid var(--border);cursor:pointer;background:#000}
    .trailer-bg{width:100%;height:100%;background:var(--bg-card);display:flex;align-items:center;justify-content:center;font-size:80px;opacity:.15}
    .trailer-play{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12px}
    .play-circle{width:72px;height:72px;background:rgba(96,80,200,.18);backdrop-filter:blur(8px);border-radius:50%;display:flex;align-items:center;justify-content:center;border:1px solid rgba(96,80,200,.5);transition:all .2s}
    .trailer-thumb:hover .play-circle{background:rgba(96,80,200,.32);transform:scale(1.08)}
    .play-icon{width:0;height:0;border-top:12px solid transparent;border-bottom:12px solid transparent;border-left:18px solid white;margin-left:3px}
    .trailer-label{font-size:13px;color:rgba(255,255,255,.65)}
    .trailer-iframe-wrap{display:none;width:100%;aspect-ratio:16/9;border-radius:14px;overflow:hidden;border:1px solid var(--border)}
    .trailer-iframe-wrap iframe{width:100%;height:100%;border:none}
    .screenshots-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
    .screenshot{aspect-ratio:16/9;border-radius:10px;overflow:hidden;border:1px solid var(--border);cursor:pointer;transition:transform .2s,border-color .2s}
    .screenshot:hover{transform:scale(1.03);border-color:rgba(96,80,200,.4)}
    .screenshot img{width:100%;height:100%;object-fit:cover}
    .similar-scroll{display:flex;gap:10px;overflow-x:auto;padding-bottom:4px;scrollbar-width:thin}
    .similar-card{flex-shrink:0;width:100px;background:var(--bg-card);border:1px solid var(--border);border-radius:10px;overflow:hidden;transition:transform .15s;display:block}
    .similar-card:hover{transform:translateY(-3px)}
    .similar-cover{aspect-ratio:3/4;background:var(--tag-bg);overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:24px;position:relative}
    .similar-cover img{width:100%;height:100%;object-fit:cover}
    .similar-score-badge{position:absolute;bottom:5px;right:5px;min-width:26px;height:20px;padding:0 5px;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;font-family:'DM Serif Display',serif;backdrop-filter:blur(6px)}
    .similar-score-badge.score-perfect{background:rgba(255,255,255,.95);color:#09090a;box-shadow:0 0 8px rgba(255,255,255,.6);border:1px solid rgba(255,255,255,.9)}
    .similar-score-badge.score-great{background:rgba(17,46,28,.9);color:#4ade80;border:1px solid rgba(74,222,128,.5)}
    .similar-score-badge.score-teal{background:rgba(8,45,42,.9);color:#2dd4bf;border:1px solid rgba(45,212,191,.5)}
    .similar-score-badge.score-good{background:rgba(14,34,64,.88);color:#60a5fa;border:1px solid rgba(96,165,250,.4)}
    .similar-score-badge.score-mid{background:rgba(39,30,0,.88);color:#fbbf24;border:1px solid rgba(251,191,36,.4)}
    .similar-score-badge.score-orange{background:rgba(44,22,10,.88);color:#fb923c;border:1px solid rgba(251,146,60,.4)}
    .similar-score-badge.score-low{background:rgba(48,14,14,.88);color:#f87171;border:1px solid rgba(248,113,113,.4)}
    .similar-info{padding:6px 8px 8px}
    .similar-title{font-size:10px;font-weight:500;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;color:var(--text-secondary)}

    /* SIDEBAR */
    .desc-card{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:16px}
    .desc-text{font-size:13px;line-height:1.75;color:var(--text-secondary);display:-webkit-box;-webkit-line-clamp:6;-webkit-box-orient:vertical;overflow:hidden}
    .desc-text.expanded{display:block}
    .read-more-btn{background:none;border:none;font-family:inherit;font-size:12px;color:var(--game-accent);cursor:pointer;padding:8px 0 0;display:block;font-weight:500}
    .details-card{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:4px 16px}
    .detail-row{display:flex;gap:10px;padding:10px 0;border-bottom:1px solid var(--border-subtle);font-size:12px}
    .detail-row:last-child{border-bottom:none}
    .detail-label{flex-shrink:0;width:76px;color:var(--text-tertiary);padding-top:1px;text-transform:uppercase;letter-spacing:.06em;font-size:10px;font-weight:500}
    .detail-value{color:var(--text-secondary);line-height:1.5;flex:1}
    .tag-list{display:flex;flex-wrap:wrap;gap:4px}
    .tag{background:var(--tag-bg);color:var(--tag-text);font-size:11px;padding:2px 7px;border-radius:4px;border:1px solid var(--border);transition:border-color .15s,color .15s}
    a.tag:hover{border-color:var(--game-accent);color:var(--game-accent)}

    /* REVIEWS */
    .reviews-toolbar{display:flex;gap:6px;margin-bottom:20px}
    .sort-tab{background:var(--tag-bg);color:var(--text-tertiary);border:1px solid var(--border);border-radius:20px;padding:5px 14px;font-size:11px;font-weight:500;font-family:inherit;cursor:pointer;transition:all .15s;text-transform:uppercase;letter-spacing:.04em}
    .sort-tab.active{background:var(--game-accent);color:white;border-color:transparent}
    .expand-btn{font-size:11px;color:var(--game-accent);margin-left:auto;cursor:pointer;background:none;border:none;font-family:inherit;padding:0;font-weight:500}
    .spoiler-pill{display:inline-flex;align-items:center;gap:4px;background:rgba(251,191,36,.08);color:#fbbf24;font-size:10px;font-weight:600;padding:2px 8px;border-radius:4px;margin-bottom:8px;text-transform:uppercase;letter-spacing:.06em;border:1px solid rgba(251,191,36,.2)}
    .empty-state{padding:60px 0;text-align:center;color:var(--text-tertiary)}
    .empty-title{font-family:'DM Serif Display',serif;font-size:20px;color:var(--text-secondary);margin-bottom:8px}
    .write-btn-empty{display:inline-block;margin-top:16px;background:var(--game-accent);color:white;border-radius:20px;padding:9px 20px;font-size:14px;font-weight:500;cursor:pointer;border:none;font-family:inherit;text-decoration:none}

    /* ── Composer modal ── */
    .composer-field{display:flex;flex-direction:column;gap:6px}
    .composer-row{display:flex;gap:12px;align-items:flex-end}
    .composer-label{font-size:11px;font-weight:600;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:.5px}
    .composer-input,.composer-select{background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:9px 12px;font-size:14px;font-family:inherit;color:var(--text-primary);width:100%;outline:none;transition:border-color .15s}
    .composer-input:focus,.composer-select:focus{border-color:var(--text-secondary)}
    .composer-textarea{background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:9px 12px;font-size:14px;font-family:inherit;color:var(--text-primary);width:100%;outline:none;resize:vertical;min-height:90px;transition:border-color .15s;line-height:1.5}
    .composer-textarea:focus{border-color:var(--text-secondary)}
    .composer-actions{display:flex;align-items:center;gap:12px;padding-top:4px}
    .spoiler-toggle{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--text-secondary);cursor:pointer}
    .composer-submit{padding:8px 18px;border-radius:20px;border:none;background:var(--accent);color:var(--accent-text);font-size:14px;font-weight:500;font-family:inherit;cursor:pointer;transition:opacity .15s}
    .composer-submit:hover{opacity:.85}
    .composer-submit:disabled{opacity:.45;cursor:not-allowed}
    .composer-error{font-size:13px;color:#c0392b;min-height:18px;margin-top:8px}

    @keyframes resultFadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .score-perfect-pop {
      display: inline-block;
      text-shadow: 0 0 20px currentColor, 0 0 44px currentColor, 0 0 80px currentColor;
      animation: happyBounce 1.4s ease-in-out 1;
    }
    .score-stellar {
      display: inline-block;
      text-shadow: 0 0 16px currentColor, 0 0 36px currentColor;
      animation: happyBounce 1.4s ease-in-out 1;
    }
    .score-crumble {
      display: inline-block;
      text-shadow: 0 0 12px currentColor, 0 0 28px currentColor;
      animation: stoneSad 1.2s cubic-bezier(.25,.46,.45,.94) 1 forwards;
    }
    @keyframes happyBounce {
      0%   { transform: translateY(  0)   rotate( 0.0deg) scale(1.00); }
      14%  { transform: translateY(-16px) rotate(-3.0deg) scale(1.07); }
      28%  { transform: translateY( -3px) rotate( 1.5deg) scale(0.96); }
      44%  { transform: translateY(-14px) rotate( 2.5deg) scale(1.05); }
      58%  { transform: translateY( -2px) rotate(-1.0deg) scale(0.97); }
      72%  { transform: translateY(-13px) rotate(-2.0deg) scale(1.04); }
      86%  { transform: translateY( -2px) rotate( 0.5deg) scale(0.99); }
      100% { transform: translateY(  0)   rotate( 0.0deg) scale(1.00); }
    }
    @keyframes stoneSad {
      0%   { transform: translate(0,    0)   rotate( 0.0deg); }
      10%  { transform: translate(-8px, 2px) rotate(-3.0deg); }
      22%  { transform: translate( 7px, 5px) rotate( 2.5deg); }
      34%  { transform: translate(-6px, 9px) rotate(-2.0deg); }
      46%  { transform: translate( 5px,12px) rotate( 1.5deg); }
      58%  { transform: translate(-4px,15px) rotate(-1.0deg); }
      70%  { transform: translate( 3px,17px) rotate( 0.6deg); }
      82%  { transform: translate(-2px,18px) rotate(-0.4deg); }
      92%  { transform: translate( 1px,19px) rotate( 0.1deg); }
      100% { transform: translate( 0,   5px) rotate(-1.2deg); }
    }

    .lightbox{display:none;position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.94);align-items:center;justify-content:center;backdrop-filter:blur(12px);cursor:pointer}
    .lightbox.open{display:flex}
    .lightbox-inner{border-radius:12px;overflow:hidden;box-shadow:0 24px 80px rgba(0,0,0,.9);cursor:default}
    .lightbox-inner img{display:block;max-width:90vw;max-height:90vh;width:auto;height:auto;object-fit:contain}

    @media(max-width:600px){
      .game-header{flex-direction:column;align-items:flex-start;margin-top:-60px}
      .game-title{font-size:26px}
      .hero{height:260px}
      .screenshots-grid{grid-template-columns:repeat(2,1fr)}
      .score-hero{flex-wrap:wrap;gap:16px}
      .avg-score-num{font-size:56px}
      .write-review-btn{width:100%;text-align:center}
      .tab-nav{flex-wrap:wrap}
    }
  </style>

  <nav class="topnav">
    <button class="back-btn" onclick="(function(){var r=document.referrer;try{var u=new URL(r);if(u.hostname===location.hostname&&u.pathname!==location.pathname){window.location.assign(r);return}}catch(e){}window.location.href='/'})()">
      <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12L6 8L10 4"/></svg>
      Back
    </button>
    <a href="/" class="logo"><span class="logo-dot"></span>Chekpoint</a>
    <button class="theme-btn" onclick="toggleTheme()">
      <svg id="gameThemeIcon" width="17" height="17" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="9" r="3.5"/>
        <path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.22 3.22l1.42 1.42M13.36 13.36l1.42 1.42M13.36 4.64l1.42-1.42M3.22 14.78l1.42-1.42"/>
      </svg>
    </button>
  </nav>

  <div class="hero">
    {!showCoverBlur && heroImageUrl ? (
      <img class="hero-artwork" src={heroImageUrl1x}
        srcset={`${heroImageUrl1x} 1920w, ${heroImageUrl} 3840w`} sizes="100vw"
        alt="" loading="eager"
        onerror="this.style.display='none';document.getElementById('heroCoverBlur').classList.add('visible')" />
    ) : null}
    <div class="hero-cover-blur" id="heroCoverBlur" style={showCoverBlur ? 'display:block' : ''}></div>
    <div class="hero-side-fade"></div>
    <div class="hero-overlay"></div>
  </div>

  <div class="page">

    <div class="game-header">
      {game.cover_img_url
        ? <img class="cover-img" src={igdbImage(game.cover_img_url, 't_cover_big') ?? ''} alt={game.title} loading="eager" />
        : <div class="cover-placeholder">🎮</div>
      }
      <div class="game-info">
        <h1 class="game-title">{game.title}</h1>
        <div class="meta-row">
          {releaseYear && <span class="meta-tag">{releaseYear}</span>}
          {developers.length > 0 && (<><span class="meta-sep">•</span>{developers.map((d: any) => (<a href={`/studios/${d.slug}`} class="meta-link">{d.name}</a>))}</>)}
          {genres.length > 0 && (<><span class="meta-sep">•</span><a href={`/genres/${genres[0].slug}`} class="meta-tag" style="color:var(--game-accent);transition:opacity .15s" onmouseover="this.style.opacity='.7'" onmouseout="this.style.opacity='1'">{genres[0].name}</a></>)}
        </div>
        <div class="platform-list">
          {platforms.map((p: any) => (
            <a href={`/platforms/${p.slug}`} class="platform-tag">{p.name}</a>
          ))}
        </div>
      </div>
    </div>

    {avgScore ? (
      <div class="score-hero">
        <div class={`avg-score-num ${scoreClass(parseFloat(avgScore))}-color`}>{avgScore}</div>
        <div class="score-divider"></div>
        <div class="score-meta">
          <div class="score-label">Chekpoint Score</div>
          <div class="review-count-label">from {reviewList.length} {reviewList.length === 1 ? 'review' : 'reviews'}{avgHours ? ` · avg ${avgHours}h played` : ''}</div>
          <div class="score-dist" id="scoreDist"></div>
        </div>
        <div class="game-action-row">
          <button class="write-review-btn" onclick="openGameComposer()">+ Write a review</button>
        </div>
      </div>
    ) : (
      <div class="score-hero">
        <div class="score-meta">
          <div class="score-label">No reviews yet</div>
          <div class="review-count-label">Be the first to review {game.title}</div>
        </div>
        <div class="game-action-row">
          <button class="write-review-btn" onclick="openGameComposer()">+ Write a review</button>
        </div>
      </div>
    )}

    <!-- TAB BUTTONS -->
    <nav class="tab-nav">
      <a href={`/games/${game.slug}?tab=overview`} class={`tab-link ${activeTab === 'overview' ? 'active' : ''}`} data-tab="overview">Overview</a>
      <a href={`/games/${game.slug}?tab=reviews`} class={`tab-link ${activeTab === 'reviews' ? 'active' : ''}`} data-tab="reviews">Reviews {reviewList.length > 0 && <span class="tab-count">{reviewList.length}</span>}</a>
      <a href={`/games/${game.slug}?tab=stats`} class={`tab-link ${activeTab === 'stats' ? 'active' : ''}`} data-tab="stats">Stats</a>
      <a href={`/games/${game.slug}?tab=recommendations`} class={`tab-link ${activeTab === 'recommendations' ? 'active' : ''}`} data-tab="recommendations">Recommendations {gameRecs.length > 0 && <span class="tab-count">{gameRecs.length}</span>}</a>
    </nav>

    <!-- ── OVERVIEW TAB ── -->
    <div class={`tab-panel ${activeTab === 'overview' ? 'active' : ''}`} data-tab="overview">
      <div class="two-col">
        <div class="main-col">
          {trailerVideoId && (
            <div class="section">
              <div class="section-header"><span class="section-title">Trailer</span></div>
              <div class="trailer-thumb" id="trailerThumb" onclick="loadTrailer()">
                <div class="trailer-bg">🎮</div>
                <div class="trailer-play">
                  <div class="play-circle"><div class="play-icon"></div></div>
                  <div class="trailer-label">{game.title} — Official Trailer</div>
                </div>
              </div>
              <div class="trailer-iframe-wrap" id="trailerIframe">
                <iframe id="trailerPlayer" src="" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
              </div>
            </div>
          )}
          {igdbData?.screenshots?.length > 0 && (
            <div class="section">
              <div class="section-header">
                <span class="section-title">Screenshots</span>
                <span class="section-count">{igdbData.screenshots.length} screenshots</span>
              </div>
              <div class="screenshots-grid">
                {igdbData.screenshots.slice(0, 6).map((s: any, i: number) => (
                  <div class="screenshot" onclick={`openLightbox('${igdbImage(s.url, 't_1080p_2x')}')`}>
                    <img src={igdbImage(s.url, 't_screenshot_big') ?? ''}
                      srcset={`${igdbImage(s.url, 't_screenshot_big')} 889w, ${igdbImage(s.url, 't_screenshot_huge')} 1280w`}
                      sizes="(max-width:600px) 50vw, 33vw"
                      alt={`${game.title} screenshot ${i + 1}`} loading="lazy" />
                  </div>
                ))}
              </div>
            </div>
          )}
          {similarGames.length > 0 && (
            <div class="section">
              <div class="section-header"><span class="section-title">Similar games</span></div>
              <div class="similar-scroll">
                {similarGames.map((g: any) => {
                  const simAvg = g.slug ? similarGameScores[g.slug] : undefined
                  return (
                    <a href={g.slug ? `/games/${g.slug}` : '#'} class="similar-card">
                      <div class="similar-cover">
                        {g.cover?.url ? <img src={igdbImage(g.cover.url, 't_cover_big') ?? ''} alt={g.name} loading="lazy" /> : '🎮'}
                        {simAvg != null && (
                          <div class={`similar-score-badge ${scoreClass(simAvg)}`}>{simAvg.toFixed(1)}</div>
                        )}
                      </div>
                      <div class="similar-info"><div class="similar-title">{g.name}</div></div>
                    </a>
                  )
                })}
              </div>
            </div>
          )}
        </div>

        <div class="sidebar-col">
          <!-- Track this game -->
          <div class="track-section">
            <div class="track-header">
              <span class="track-label">Track this game</span>
              {!currentGameStatus && (
                <span class="track-hint">Saves to your library</span>
              )}
            </div>
            <div class="track-pills" id="trackPills">
              {([
                { s: 'playing',         icon: '🎮', label: 'Playing',      title: "I'm actively playing this" },
                { s: 'want_to_play',    icon: '🔖', label: 'Want to Play', title: 'On my list to play someday' },
                { s: 'owned',           icon: '📦', label: 'Owned',        title: 'I own this game' },
                { s: 'completed',       icon: '✓',  label: 'Completed',    title: "I'm done with this game" },
                { s: 'hundred_percent', icon: '💯', label: '100%',         title: 'Completed everything — all achievements/trophies' },
                { s: 'dropped',         icon: '✗',  label: 'Dropped',      title: 'Started it, moved on' },
                ...(isLoggedIn ? [{ s: 'hidden' as const, icon: '🫥', label: 'Hidden', title: 'Keep this out of your public library' }] : []),
              ] as const).map(({ s, icon, label, title }) => {
                // Owned and Hidden are independent flags, not part of the
                // Playing/Want to Play/Completed/100%/Dropped exclusive-status group.
                const active = s === 'owned' ? currentGameOwned : s === 'hidden' ? currentGameHidden : currentGameStatus === s;
                return (
                  <button
                    class={`track-pill${active ? ' active' : ''}`}
                    data-status={s}
                    data-game-id={game.id}
                    data-logged-in={isLoggedIn ? 'true' : 'false'}
                    title={title}
                  >
                    {icon} {label}
                    {s === 'want_to_play' && (wantToPlayCount ?? 0) > 0 && (
                      <span style="font-size:10px;opacity:.6;margin-left:2px">{wantToPlayCount}</span>
                    )}
                  </button>
                );
              })}
            </div>
            <div class="review-nudge" id="reviewNudge">
              <span class="review-nudge-text">Nice! Want to share your thoughts on <strong>{game.title}</strong>?</span>
              <div class="review-nudge-actions">
                <button class="review-nudge-btn" onclick="openGameComposer()">Write a review</button>
                <button class="review-nudge-dismiss" onclick="document.getElementById('reviewNudge').style.display='none'" aria-label="Dismiss">✕</button>
              </div>
            </div>
          </div>

          <!-- SOCIAL TRACKING — people you follow who have tracked this game -->
          {hasFriendActivity && (
            <div class="social-tracking">
              <div class="social-tracking-hdr">
                <svg width="13" height="13" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="6" cy="5" r="2.5"/><path d="M1 16c0-3 2-4.5 5-4.5s5 1.5 5 4.5"/>
                  <circle cx="13" cy="5" r="2"/><path d="M13 11c1.7.1 3 1.2 3 3.5"/>
                </svg>
                People you follow
              </div>
              <div class="social-groups-scroll">
                {SOCIAL_STATUS_ORDER.map(status => {
                  const people = friendStatusGroups[status];
                  if (!people || people.length === 0) return null;
                  const { label, color } = SOCIAL_STATUS_META[status];
                  const visible = people.slice(0, 5);
                  const extra = people.length - visible.length;
                  return (
                    <div class="social-group">
                      <div class="social-group-lbl" style={`color:${color}`}>{label}</div>
                      <div class="social-members">
                        {visible.map((p: any) => (
                          <a href={`/reviewers/${p.username}`} class="social-member" title={`View @${p.username}'s profile`}>
                            <div class="social-av">
                              {p.avatar_url
                                ? <img src={p.avatar_url} alt={p.username} loading="lazy" />
                                : p.username.slice(0, 2).toUpperCase()
                              }
                            </div>
                            <span class="social-uname">@{p.username}</span>
                          </a>
                        ))}
                        {extra > 0 && <span class="social-overflow">+{extra} more</span>}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          {game.game_description && (
            <div class="desc-card">
              <p class="desc-text" id="desc">{game.game_description}</p>
              <button class="read-more-btn" id="readMoreBtn" onclick="toggleDesc()">Read more →</button>
            </div>
          )}
          <div class="details-card">
            {releaseDate && (<div class="detail-row"><span class="detail-label">Released</span><span class="detail-value">{releaseDate}</span></div>)}
            {developers.length > 0 && (<div class="detail-row"><span class="detail-label">Developer</span><span class="detail-value">{developers.map((d: any) => d.name).join(', ')}</span></div>)}
            {publishers.length > 0 && (<div class="detail-row"><span class="detail-label">Publisher</span><span class="detail-value">{publishers.map((p: any) => p.name).join(', ')}</span></div>)}
            {genres.length > 0 && (<div class="detail-row"><span class="detail-label">Genres</span><div class="tag-list">{genres.map((g: any) => <a href={`/genres/${g.slug}`} class="tag" style="transition:border-color .15s,color .15s">{g.name}</a>)}</div></div>)}
            {igdbData?.themes?.length > 0 && (<div class="detail-row"><span class="detail-label">Themes</span><div class="tag-list">{igdbData.themes.map((t: any) => <span class="tag">{t.name}</span>)}</div></div>)}
            {igdbData?.game_modes?.length > 0 && (<div class="detail-row"><span class="detail-label">Modes</span><div class="tag-list">{igdbData.game_modes.map((m: any) => <span class="tag">{m.name}</span>)}</div></div>)}
            {igdbData?.game_engines?.length > 0 && (<div class="detail-row"><span class="detail-label">Engine</span><span class="detail-value">{igdbData.game_engines.map((e: any) => e.name).join(', ')}</span></div>)}
            {igdbData?.franchises?.length > 0 && (<div class="detail-row"><span class="detail-label">Franchise</span><span class="detail-value">{igdbData.franchises.map((f: any) => f.name).join(', ')}</span></div>)}
            {igdbData?.alternative_names?.length > 0 && (<div class="detail-row"><span class="detail-label">Also known as</span><span class="detail-value">{igdbData.alternative_names.slice(0, 3).map((a: any) => a.name).join(', ')}</span></div>)}
          </div>
          {gameLists.length > 0 && (
            <div class="game-lists-sidebar">
              <div class="game-lists-sidebar-title">Appears in lists</div>
              <div class="game-lists-sidebar-grid">
                {gameLists.map((list: any) => (
                  <ListCard
                    id={list.id}
                    title={list.title}
                    isRanked={list.is_ranked}
                    visibility={list.visibility}
                    entryCount={list.entryCount}
                    coverUrls={list.coverUrls}
                    ownerUsername={list.ownerUsername}
                    ownerAvatar={list.ownerAvatar}
                    showOwner={true}
                    compact={true}
                  />
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- ── REVIEWS TAB ── -->
    <div class={`tab-panel ${activeTab === 'reviews' ? 'active' : ''}`} data-tab="reviews">
      {reviewList.length === 0 ? (
        <div class="empty-state">
          <div class="empty-title">No reviews yet</div>
          <p style="font-size:14px;color:var(--text-tertiary)">Be the first to review {game.title}.</p>
          {isLoggedIn
            ? <button class="write-btn-empty" onclick="openGameComposer()">+ Write a review</button>
            : <a href={`/signin?next=${encodeURIComponent(`/games/${game.slug}`)}`} class="write-btn-empty">+ Write a review</a>
          }
        </div>
      ) : (
        <>
          <div class="reviews-toolbar">
            <button class="sort-tab active" onclick="sortReviews('recent',this)">Recent</button>
            <button class="sort-tab" onclick="sortReviews('highest',this)">Highest</button>
            <button class="sort-tab" onclick="sortReviews('lowest',this)">Lowest</button>
            <button class="sort-tab" onclick="sortReviews('most_upvoted',this)">Most upvoted</button>
            <button class="sort-tab" onclick="sortReviews('most_downvoted',this)">Most downvoted</button>
          </div>
          <div id="reviewsList">
            {reviewList.map((review: any) => (
              <ReviewCard
                review={review}
                isLoggedIn={isLoggedIn}
                showGame={false}
                showReviewer={true}
                currentProfileId={currentProfileId}
                isOwnProfile={!!(currentProfileId && review.profiles?.id === currentProfileId)}
              />
            ))}
          </div>
        </>
      )}
    </div>

    <!-- ── STATS TAB ── -->
    <div class={`tab-panel ${activeTab === 'stats' ? 'active' : ''}`} data-tab="stats">
      {reviewList.length === 0 ? (
        <div class="empty-state">
          <div class="empty-title">No stats yet</div>
          <p style="font-size:14px;color:var(--text-tertiary)">Stats will appear once reviews are submitted.</p>
        </div>
      ) : (
        <div id="statsContent"></div>
      )}
    </div>

    <!-- ── RECOMMENDATIONS TAB ── -->
    <div class={`tab-panel ${activeTab === 'recommendations' ? 'active' : ''}`} data-tab="recommendations">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:4px 0 16px">
        <div>
          <div style="font-size:16px;font-weight:600;color:var(--text-primary);margin-bottom:4px">If you liked {game.title}…</div>
          <div style="font-size:13px;color:var(--text-tertiary);line-height:1.5;max-width:460px">Community picks for what to play next — and the games {game.title} gets recommended for.</div>
        </div>
        {isLoggedIn
          ? <button class="write-review-btn" onclick="openRecComposer()">+ Add a recommendation</button>
          : <a href={`/signin?next=${encodeURIComponent(`/games/${game.slug}?tab=recommendations`)}`} class="write-review-btn">+ Add a recommendation</a>
        }
      </div>
      {gameRecs.length === 0 ? (
        <div class="empty-state">
          <div class="empty-title">No recommendations yet</div>
          <p style="font-size:14px;color:var(--text-tertiary)">Be the first to suggest what fans of {game.title} should play next.</p>
        </div>
      ) : (
        <div>
          {gameRecs.map((rec: any) => (
            <RecommendationFeedCard
              id={rec.id}
              sourceGame={rec.sourceGame}
              targetGame={rec.targetGame}
              body={rec.body}
              containsSpoilers={rec.containsSpoilers}
              ownerUsername={rec.ownerUsername}
              ownerAvatar={rec.ownerAvatar}
              createdAt={rec.createdAt}
              upVotes={rec.upVotes}
              downVotes={rec.downVotes}
              myVote={rec.myVote}
              commentCount={rec.commentCount}
              reactions={rec.reactions}
              isLoggedIn={isLoggedIn}
              currentProfileId={currentProfileId}
              profileId={rec.profileId}
            />
          ))}
        </div>
      )}
    </div>

  </div>

  {isLoggedIn && <RecommendationComposer sourceGame={{ id: game.id, title: game.title, cover_img_url: game.cover_img_url }} />}

  <div class="lightbox" id="lightbox" onclick="closeLightbox()">
    <div class="lightbox-inner" onclick="event.stopPropagation()">
      <img id="lightboxImg" src="" alt="Screenshot" />
    </div>
  </div>

  <script define:vars={{ distJson, coverBlurUrl, trailerSrc, showCoverBlur, statsJson, activeTab }}>

    // ── CLIENT-SIDE TAB SWITCHING ──
    // All tab content is server-rendered and already in the DOM.
    // Intercept clicks and toggle classes instead of doing a full page reload.
    var _statsBuilt = (activeTab === 'stats')
    document.querySelectorAll('.tab-link').forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault()
        var tab = new URL(link.href, location.origin).searchParams.get('tab') || 'overview'
        document.querySelectorAll('.tab-link').forEach(function(l) { l.classList.remove('active') })
        link.classList.add('active')
        document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active') })
        var panel = document.querySelector('.tab-panel[data-tab="' + tab + '"]')
        if (panel) panel.classList.add('active')
        history.replaceState({}, '', '?tab=' + tab)
        if (tab === 'stats' && !_statsBuilt) { buildStats(); _statsBuilt = true }
      })
    })

    window.addEventListener('popstate', function() {
      var tab = new URLSearchParams(location.search).get('tab') || 'overview'
      document.querySelectorAll('.tab-link').forEach(function(l) { l.classList.remove('active') })
      var link = document.querySelector('.tab-link[href*="tab=' + tab + '"]')
      if (link) link.classList.add('active')
      document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active') })
      var panel = document.querySelector('.tab-panel[data-tab="' + tab + '"]')
      if (panel) panel.classList.add('active')
      if (tab === 'stats' && !_statsBuilt) { buildStats(); _statsBuilt = true }
    })
    // ─────────────────────────────────────────────────────────────────────────

    if (showCoverBlur) {
      var blur = document.getElementById('heroCoverBlur')
      if (blur) blur.style.backgroundImage = 'url(' + coverBlurUrl + ')'
    }

    // score dist bars
    var dist = JSON.parse(distJson)
    var maxVal = Math.max.apply(null, dist.concat([1]))
    var barColors = ['#f87171','#f87171','#fb923c','#fb923c','#fbbf24','#fbbf24','#60a5fa','#2dd4bf','#4ade80','#ffffff']
    var container = document.getElementById('scoreDist')
    if (container) {
      dist.forEach(function(count, i) {
        var wrap = document.createElement('div'); wrap.className = 'dist-bar-wrap'
        wrap.title = 'Score ' + (i+1) + ': ' + count + ' reviews'
        var bar = document.createElement('div'); bar.className = 'dist-bar'
        bar.style.height = Math.max(4,(count/maxVal)*40)+'px'
        bar.style.background = barColors[i]; bar.style.opacity = '0.65'
        var label = document.createElement('div'); label.className = 'dist-label'
        label.textContent = String(i+1)
        wrap.appendChild(bar); wrap.appendChild(label); container.appendChild(wrap)
      })
    }

    function loadTrailer() {
      var thumb = document.getElementById('trailerThumb')
      var wrap = document.getElementById('trailerIframe')
      var player = document.getElementById('trailerPlayer')
      if (thumb) thumb.style.display = 'none'
      if (wrap) wrap.style.display = 'block'
      if (player) player.src = trailerSrc
    }
    window.loadTrailer = loadTrailer

    function openLightbox(src) {
      var lb = document.getElementById('lightbox')
      var img = document.getElementById('lightboxImg')
      if (lb && img) { img.src = src; lb.classList.add('open') }
    }
    function closeLightbox() {
      var lb = document.getElementById('lightbox')
      if (lb) lb.classList.remove('open')
    }
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeLightbox() })
    window.openLightbox = openLightbox; window.closeLightbox = closeLightbox

    // ── Status pills (Track this game) ───────────────────────────────────────
    // Playing/Want to Play/Completed/100%/Dropped are mutually exclusive (status).
    // Owned and Hidden are independent flags — always clickable regardless of
    // which (if any) of the other pills is active.
    var trackPills = document.getElementById('trackPills');
    if (trackPills) {
      function otherStatusPill() {
        return trackPills.querySelector('.track-pill.active:not([data-status="owned"]):not([data-status="hidden"])');
      }

      async function handleOwnedClick(pill) {
        var wasActive = pill.classList.contains('active');
        var newOwned = !wasActive;
        var hasOtherStatus = !!otherStatusPill();

        pill.classList.toggle('active', newOwned);

        try {
          var res;
          if (!newOwned && !hasOtherStatus) {
            // Nothing else tracked — turning Owned off means untracking entirely
            res = await fetch('/api/user-game-status/set', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ game_id: pill.dataset.gameId, status: null }),
            });
            var hiddenPill = trackPills.querySelector('.track-pill[data-status="hidden"]');
            if (hiddenPill) hiddenPill.classList.remove('active');
          } else if (newOwned && !hasOtherStatus) {
            // Nothing else tracked yet — bootstrap a plain "owned" row
            res = await fetch('/api/user-game-status/set', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ game_id: pill.dataset.gameId, status: 'owned', owned: true }),
            });
            var hint = document.querySelector('.track-hint');
            if (hint) hint.remove();
          } else {
            // Some other status is active — only touch the owned flag
            res = await fetch('/api/user-game-status/set', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ game_id: pill.dataset.gameId, owned: newOwned }),
            });
          }
          if (!res.ok) throw new Error();
        } catch (e) {
          pill.classList.toggle('active', wasActive);
          alert('Could not update owned status. Please try again.');
        }
      }

      async function handleHiddenClick(pill) {
        var wasActive = pill.classList.contains('active');
        var newHidden = !wasActive;
        var wasUntracked = !trackPills.querySelector('.track-pill.active');

        pill.classList.toggle('active', newHidden);

        try {
          var res = await fetch('/api/user-game-status/toggle-hidden', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ game_id: pill.dataset.gameId, hidden: newHidden }),
          });
          if (!res.ok) throw new Error();
          // Hiding an untracked game auto-adds it to the library as "owned"
          if (newHidden && wasUntracked) {
            var ownedPill = trackPills.querySelector('.track-pill[data-status="owned"]');
            if (ownedPill) ownedPill.classList.add('active');
            var hint = document.querySelector('.track-hint');
            if (hint) hint.remove();
          }
        } catch (e) {
          pill.classList.toggle('active', wasActive);
          alert('Could not update hidden status. Please try again.');
        }
      }

      trackPills.addEventListener('click', async function(e) {
        var pill = e.target.closest('.track-pill');
        if (!pill) return;

        var loggedIn = pill.dataset.loggedIn === 'true';
        if (!loggedIn) { window.location.href = '/signin'; return; }

        var clickedStatus = pill.dataset.status;

        if (clickedStatus === 'owned') { await handleOwnedClick(pill); return; }
        if (clickedStatus === 'hidden') { await handleHiddenClick(pill); return; }

        var isActive = pill.classList.contains('active');
        // Clicking the active pill removes the status; clicking another sets it
        var newStatus = isActive ? null : clickedStatus;

        // Optimistic UI — only the exclusive-group pills get cleared
        trackPills.querySelectorAll('.track-pill:not([data-status="owned"]):not([data-status="hidden"])').forEach(function(p) {
          p.classList.remove('active');
        });
        if (newStatus) pill.classList.add('active');

        // Show review nudge when completing
        var nudge = document.getElementById('reviewNudge');
        if (nudge) nudge.style.display = (newStatus === 'completed' || newStatus === 'hundred_percent') ? 'flex' : 'none';

        // Owned is not mutually exclusive with status — every status except
        // want_to_play auto-selects it (and untracking clears it), but it can
        // still be manually unchecked afterwards (e.g. played it on a friend's console).
        var ownedPill = trackPills.querySelector('.track-pill[data-status="owned"]');
        var prevOwnedActive = ownedPill ? ownedPill.classList.contains('active') : false;
        var newOwned = newStatus ? newStatus !== 'want_to_play' : false;
        if (ownedPill) ownedPill.classList.toggle('active', newOwned);

        // Untracking the game clears hidden too — the row it lived on is gone
        var hiddenPill = trackPills.querySelector('.track-pill[data-status="hidden"]');
        var prevHiddenActive = hiddenPill ? hiddenPill.classList.contains('active') : false;
        if (!newStatus && hiddenPill) hiddenPill.classList.remove('active');

        try {
          var res = await fetch('/api/user-game-status/set', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ game_id: pill.dataset.gameId, status: newStatus, owned: newOwned }),
          });
          if (!res.ok) throw new Error();
        } catch(e) {
          // Revert on failure
          trackPills.querySelectorAll('.track-pill:not([data-status="owned"]):not([data-status="hidden"])').forEach(function(p) {
            p.classList.toggle('active', p.dataset.status === clickedStatus && isActive);
          });
          if (nudge) nudge.style.display = 'none';
          if (ownedPill) ownedPill.classList.toggle('active', prevOwnedActive);
          if (hiddenPill) hiddenPill.classList.toggle('active', prevHiddenActive);
          alert('Could not update status. Please try again.');
        }
      });
    }

    // ── Legacy watch button fallback (keeps old inline calls working) ─────────
    var watchBtn = document.getElementById('watchBtn');
    if (watchBtn) {
      watchBtn.addEventListener('click', async function() {
        var loggedIn = watchBtn.dataset.loggedIn === 'true';
        if (!loggedIn) { window.location.href = '/signin'; return; }

        var gameId   = watchBtn.dataset.gameId;
        var watching = watchBtn.dataset.watching === 'true';
        var label    = document.getElementById('watchLabel');
        var countEl  = document.getElementById('watchCount');

        var newWatching = !watching;
        watchBtn.dataset.watching = newWatching ? 'true' : 'false';
        watchBtn.classList.toggle('watching', newWatching);
        if (label) label.textContent = newWatching ? 'On list' : 'Want to play';

        try {
          var res = await fetch('/api/watchlist/toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ game_id: gameId }),
          });
          var data = await res.json();
          if (!res.ok) throw new Error();
          watchBtn.dataset.watching = data.watching ? 'true' : 'false';
          watchBtn.classList.toggle('watching', data.watching);
          if (label) label.textContent = data.watching ? 'On list' : 'Want to play';
          if (countEl) countEl.textContent = data.count > 0 ? String(data.count) : '';
        } catch(e) {
          // Revert
          watchBtn.dataset.watching = watching ? 'true' : 'false';
          watchBtn.classList.toggle('watching', watching);
          if (label) label.textContent = watching ? 'On list' : 'Want to play';
          watchBtn.querySelector('svg').setAttribute('fill', watching ? 'currentColor' : 'none');
        }
      });
    }

    function toggleDesc() {
      var desc = document.getElementById('desc')
      var btn = document.getElementById('readMoreBtn')
      if (!desc || !btn) return
      desc.classList.toggle('expanded')
      btn.textContent = desc.classList.contains('expanded') ? 'Read less ↑' : 'Read more →'
    }
    window.toggleDesc = toggleDesc

    function sortReviews(type, btn) {
      document.querySelectorAll('.sort-tab').forEach(function(b) { b.classList.remove('active') })
      btn.classList.add('active')
      var list = document.getElementById('reviewsList')
      if (!list) return
      var cards = Array.from(list.querySelectorAll('.rc'))
      cards.sort(function(a, b) {
        if (type === 'highest') return parseInt(b.dataset.score) - parseInt(a.dataset.score)
        if (type === 'lowest') return parseInt(a.dataset.score) - parseInt(b.dataset.score)
        if (type === 'most_upvoted') return parseInt(b.dataset.upvotes) - parseInt(a.dataset.upvotes)
        if (type === 'most_downvoted') return parseInt(b.dataset.downvotes) - parseInt(a.dataset.downvotes)
        return new Date(b.dataset.date).getTime() - new Date(a.dataset.date).getTime()
      })
      cards.forEach(function(card) { list.appendChild(card) })
    }
    window.sortReviews = sortReviews

