        html += '<div style="display:flex;gap:14px;margin-bottom:10px">'
        html += '<div style="display:flex;align-items:center;gap:5px;font-size:11px;color:var(--text-tertiary)"><div style="width:8px;height:8px;border-radius:2px;background:#6050c8"></div>This game</div>'
        html += '<div style="display:flex;align-items:center;gap:5px;font-size:11px;color:var(--text-tertiary)"><div style="width:8px;height:8px;border-radius:2px;background:var(--text-tertiary);opacity:.4"></div>Genre avg</div>'
        html += '</div>'
        function cmpRow(label, gamePct, avgPct, display, delta, suffix) {
          var dCls = parseFloat(delta) > 0 ? '#4ade80' : parseFloat(delta) < 0 ? '#f87171' : 'var(--text-tertiary)'
          var dStr = (parseFloat(delta) > 0 ? '+' : '') + delta + (suffix || '')
          return '<div style="display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid var(--border-subtle)">'
            + '<span style="font-size:12px;color:var(--text-secondary);width:110px;flex-shrink:0">' + label + '</span>'
            + '<div style="flex:1;position:relative;height:8px">'
            + '<div style="position:absolute;inset:0;background:var(--tag-bg);border-radius:4px"></div>'
            + '<div style="position:absolute;top:0;left:0;height:100%;border-radius:4px;background:var(--text-tertiary);opacity:.3;width:' + Math.min(100,avgPct) + '%"></div>'
            + '<div style="position:absolute;top:0;left:0;height:100%;border-radius:4px;background:#6050c8;width:' + Math.min(100,gamePct) + '%"></div>'
            + '</div>'
            + '<span style="font-size:13px;font-weight:700;width:36px;text-align:right;flex-shrink:0;color:var(--text-primary)">' + display + '</span>'
            + '<span style="font-size:12px;width:44px;text-align:right;font-weight:700;flex-shrink:0;color:' + dCls + '">' + dStr + '</span>'
            + '</div>'
        }
        html += cmpRow('Avg score', gameAvgNum/10*100, s.genreAvgScore/10*100, gameAvgNum, delta1, '')
        html += cmpRow('Recommended', s.recommendedRate, 72, s.recommendedRate+'%', delta2, '%')
        html += '</div>'
      }

            el.innerHTML = html

      // animate pct bars + markers
      setTimeout(function() {
        document.querySelectorAll('.pct-anim').forEach(function(el) { el.style.width = el.dataset.w + '%' })
        document.querySelectorAll('.pct-marker-anim').forEach(function(el) { el.style.left = 'calc(' + el.dataset.w + '% - 7px)' })
      }, 100)

      // ── DRAW SCORES OVER TIME BAR CHART ──
      var scoreBarEl = document.getElementById('scoreBarChart')
      var tooltip = document.getElementById('scoreBarTooltip')
      if (scoreBarEl && s.monthLabels && s.monthCounts && s.monthAvgScores) {
        setTimeout(function() {
          var w = scoreBarEl.getBoundingClientRect().width || 400
          var chartH = 68, padL = 4, padR = 4
          var n = s.monthLabels.length
          var barW = Math.max(4, (w - padL - padR) / n - 4)
          var step = (w - padL - padR) / n

          // grid lines
          for (var gi = 0; gi <= 4; gi++) {
            var gy = chartH - (gi/4) * chartH
            var gval = (gi/4) * 10
            var gl = document.createElementNS('http://www.w3.org/2000/svg','line')
            gl.setAttribute('x1', padL); gl.setAttribute('x2', w - padR)
            gl.setAttribute('y1', gy); gl.setAttribute('y2', gy)
            gl.setAttribute('stroke','var(--border)'); gl.setAttribute('stroke-width','1')
            if (gi === 0 || gi === 4) gl.setAttribute('stroke-opacity','0.5')
            else gl.setAttribute('stroke-opacity','0.25')
            scoreBarEl.appendChild(gl)
            if (gi > 0 && gi < 4) {
              var gtxt = document.createElementNS('http://www.w3.org/2000/svg','text')
              gtxt.setAttribute('x', padL - 2); gtxt.setAttribute('y', gy + 3)
              gtxt.setAttribute('text-anchor','end'); gtxt.setAttribute('font-size','8')
              gtxt.setAttribute('fill','var(--text-tertiary)'); gtxt.setAttribute('font-family','DM Sans,sans-serif')
              gtxt.textContent = gval; scoreBarEl.appendChild(gtxt)
            }
          }

          s.monthLabels.forEach(function(lbl, i) {
            var avg = s.monthAvgScores[i]
            var cnt = s.monthCounts[i]
            if (!cnt || !avg) {
              // empty month tick
              var etxt = document.createElementNS('http://www.w3.org/2000/svg','text')
              etxt.setAttribute('x', padL + i*step + step/2); etxt.setAttribute('y', chartH + 16)
              etxt.setAttribute('text-anchor','middle'); etxt.setAttribute('font-size','9')
              etxt.setAttribute('fill','var(--text-tertiary)'); etxt.setAttribute('font-family','DM Sans,sans-serif')
              etxt.textContent = lbl; scoreBarEl.appendChild(etxt)
              return
            }
            var col = scoreCol(avg)
            var bh = Math.max(4, (avg / 10) * chartH)
            var bx = padL + i*step + (step - barW)/2
            var by = chartH - bh

            // bar
            var rect = document.createElementNS('http://www.w3.org/2000/svg','rect')
            rect.setAttribute('x', bx); rect.setAttribute('y', by)
            rect.setAttribute('width', barW); rect.setAttribute('height', bh)
            rect.setAttribute('rx','3'); rect.setAttribute('fill', col); rect.setAttribute('opacity','0.8')
            rect.style.cursor = 'pointer'
            rect.style.transition = 'opacity .15s'
            rect.addEventListener('mouseenter', (function(lbl, avg, cnt, bx, barW) {
              return function() {
                this.setAttribute('opacity','1')
                tooltip.style.display = 'block'
                tooltip.innerHTML = '<strong style="color:' + scoreCol(avg) + '">' + avg.toFixed(1) + '</strong>'
                  + ' avg · <span style="color:var(--text-secondary)">' + cnt + ' review' + (cnt !== 1 ? 's' : '') + '</span>'
                  + '<br><span style="color:var(--text-tertiary);font-size:10px">' + lbl + '</span>'
                var wrap = document.getElementById('scoreBarWrap')
                var wRect = wrap.getBoundingClientRect()
                var tLeft = bx + barW/2 - 60
                tLeft = Math.max(0, Math.min(tLeft, wRect.width - 140))
                tooltip.style.left = tLeft + 'px'
                tooltip.style.bottom = (90 - by + 8) + 'px'
              }
            })(lbl, avg, cnt, bx, barW))
            rect.addEventListener('mouseleave', function() {
              this.setAttribute('opacity','0.8')
              tooltip.style.display = 'none'
            })
            scoreBarEl.appendChild(rect)

            // score label above bar
            var stxt = document.createElementNS('http://www.w3.org/2000/svg','text')
            stxt.setAttribute('x', bx + barW/2); stxt.setAttribute('y', by - 4)
            stxt.setAttribute('text-anchor','middle'); stxt.setAttribute('font-size','9')
            stxt.setAttribute('fill', col); stxt.setAttribute('font-weight','600')
            stxt.setAttribute('font-family','DM Sans,sans-serif')
            stxt.textContent = avg.toFixed(1); scoreBarEl.appendChild(stxt)

            // month label
            var mtxt = document.createElementNS('http://www.w3.org/2000/svg','text')
            mtxt.setAttribute('x', bx + barW/2); mtxt.setAttribute('y', chartH + 16)
            mtxt.setAttribute('text-anchor','middle'); mtxt.setAttribute('font-size','9')
            mtxt.setAttribute('fill','var(--text-tertiary)'); mtxt.setAttribute('font-family','DM Sans,sans-serif')
            mtxt.textContent = lbl; scoreBarEl.appendChild(mtxt)
          })
        }, 60)
      }

      // ── DRAW HOURS DISTRIBUTION — bubble dots ──
      var hoursEl = document.getElementById('hoursDistChart')
      if (hoursEl && s.hoursDistribution) {
        setTimeout(function() {
          var w = hoursEl.getBoundingClientRect().width || 300
          var chartH = 76
          var buckets = s.hoursDistribution
          var n = buckets.length
          var maxVal = Math.max.apply(null, buckets.map(function(b){return b.count}).concat([1]))
          var hColors = ['#60a5fa','#818cf8','#a78bfa','#c084fc','#e879f9']
          var maxR = Math.min(28, (w / n) * 0.45)
          var step = w / n
          var cy = chartH / 2

          // baseline
          var base = document.createElementNS('http://www.w3.org/2000/svg','line')
          base.setAttribute('x1',0); base.setAttribute('x2',w)
          base.setAttribute('y1',chartH); base.setAttribute('y2',chartH)
          base.setAttribute('stroke','var(--border)'); base.setAttribute('stroke-width','1')
          hoursEl.appendChild(base)

          buckets.forEach(function(b, i) {
            var cx = i * step + step / 2
            var r = b.count > 0 ? Math.max(8, (b.count / maxVal) * maxR) : 4
            var col = hColors[i % hColors.length]

            // glow circle
            if (b.count > 0) {
              var glow = document.createElementNS('http://www.w3.org/2000/svg','circle')
              glow.setAttribute('cx', cx); glow.setAttribute('cy', cy)
              glow.setAttribute('r', r + 6)
              glow.setAttribute('fill', col); glow.setAttribute('opacity','0.08')
              hoursEl.appendChild(glow)
            }

            // main bubble
            var circle = document.createElementNS('http://www.w3.org/2000/svg','circle')
            circle.setAttribute('cx', cx); circle.setAttribute('cy', cy)
            circle.setAttribute('r', r)
            circle.setAttribute('fill', b.count > 0 ? col : 'var(--tag-bg)')
            circle.setAttribute('opacity', b.count > 0 ? '0.85' : '1')
            if (b.count > 0) circle.setAttribute('stroke', col)
            else circle.setAttribute('stroke', 'var(--border)')
            circle.setAttribute('stroke-width','1')
            hoursEl.appendChild(circle)

            // count label inside bubble
            if (b.count > 0) {
              var ctxt = document.createElementNS('http://www.w3.org/2000/svg','text')
              ctxt.setAttribute('x', cx); ctxt.setAttribute('y', cy + 4)
              ctxt.setAttribute('text-anchor','middle'); ctxt.setAttribute('font-size', r > 14 ? '11' : '9')
              ctxt.setAttribute('fill','white'); ctxt.setAttribute('font-weight','700')
              ctxt.setAttribute('font-family','DM Sans,sans-serif')
              ctxt.textContent = b.count; hoursEl.appendChild(ctxt)
            }

            // label below
            var lbl = document.createElementNS('http://www.w3.org/2000/svg','text')
            lbl.setAttribute('x', cx); lbl.setAttribute('y', chartH + 13)
            lbl.setAttribute('text-anchor','middle'); lbl.setAttribute('font-size','8')
            lbl.setAttribute('fill', b.count > 0 ? col : 'var(--text-tertiary)')
            lbl.setAttribute('font-family','DM Sans,sans-serif')
            lbl.setAttribute('font-weight', b.count > 0 ? '600' : '400')
            lbl.textContent = b.label; hoursEl.appendChild(lbl)
          })
        }, 60)
      }

      // ── PIE CHART ──
      if (s.platformBreakdown && s.platformBreakdown.length > 0) {
        var pieSvg = document.getElementById('pieSvg')
        var pieLegend = document.getElementById('pieLegend')
        var total = s.platformBreakdown.reduce(function(a,b){return a+b.count},0)
        var startAngle = -Math.PI/2
        var cx=40, cy=40, r=37

        s.platformBreakdown.forEach(function(p, i) {
          var angle = (p.count/total)*Math.PI*2
          var endAngle = startAngle + angle
          var x1=cx+r*Math.cos(startAngle), y1=cy+r*Math.sin(startAngle)
          var x2=cx+r*Math.cos(endAngle), y2=cy+r*Math.sin(endAngle)
          var large = angle>Math.PI?1:0
          var path = document.createElementNS('http://www.w3.org/2000/svg','path')
          path.setAttribute('d','M'+cx+','+cy+' L'+x1+','+y1+' A'+r+','+r+' 0 '+large+',1 '+x2+','+y2+' Z')
          path.setAttribute('fill', pieColors[i%pieColors.length])
          path.setAttribute('opacity','0.88')
          path.style.transition = 'opacity .15s,transform .15s'
          path.style.transformOrigin = cx+'px '+cy+'px'
          path.addEventListener('mouseenter',function(){this.setAttribute('opacity','1');this.style.transform='scale(1.04)'})
          path.addEventListener('mouseleave',function(){this.setAttribute('opacity','0.88');this.style.transform='scale(1)'})
          pieSvg.appendChild(path)
          startAngle = endAngle

          var item = document.createElement('div')
          item.style.cssText = 'display:flex;align-items:center;gap:8px;min-width:0'
          item.innerHTML = '<div style="width:10px;height:10px;border-radius:2px;flex-shrink:0;background:' + pieColors[i%pieColors.length] + '"></div>'
            + '<span style="font-size:12px;color:var(--text-secondary);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + p.name + '</span>'
            + '<span style="font-size:12px;color:var(--text-tertiary);font-weight:600;flex-shrink:0">' + p.pct + '%</span>'
          pieLegend.appendChild(item)
        })

        var hole = document.createElementNS('http://www.w3.org/2000/svg','circle')
        hole.setAttribute('cx',cx);hole.setAttribute('cy',cy);hole.setAttribute('r',r*0.42)
        hole.setAttribute('fill','var(--bg-card)')
        pieSvg.appendChild(hole)
      }
    }

        if (activeTab === 'stats') buildStats()

    function toggleTheme() {
      var html = document.documentElement
      var next = html.getAttribute('data-theme') === 'light' ? 'dark' : 'light'
      html.setAttribute('data-theme', next)
      localStorage.setItem('theme', next)
      updateIcon(next)
      if (activeTab === 'stats') {
        var el = document.getElementById('statsContent')
        if (el) { el.innerHTML = ''; buildStats() }
      }
    }
    function updateIcon(theme) {
      var icon = document.getElementById('gameThemeIcon')
      if (!icon) return
      icon.innerHTML = theme === 'dark'
        ? '<path d="M15 10.5A7 7 0 016.5 3a7 7 0 100 12 7 7 0 008.5-4.5z"/>'
        : '<circle cx="9" cy="9" r="3.5"/><path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.22 3.22l1.42 1.42M13.36 13.36l1.42 1.42M13.36 4.64l1.42-1.42M3.22 14.78l1.42-1.42"/>'
    }
    window.toggleTheme = toggleTheme

    var saved = localStorage.getItem('theme') ||
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
    document.documentElement.setAttribute('data-theme', saved)
    updateIcon(saved)

  </script>
<ReportModal />

<!-- ── Sign-in prompt ── -->
<div id="gcSignInPrompt" style="display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);width:360px;max-width:calc(100vw - 32px);background:var(--bg-card);border:1px solid var(--border);border-radius:16px;z-index:160;padding:32px 28px;text-align:center">
  <div style="font-size:17px;font-weight:600;color:var(--text-primary);margin-bottom:8px">Sign in to write a review</div>
  <p style="font-size:14px;color:var(--text-secondary);margin:0 0 24px;line-height:1.5">Join Chekpoint to share your take on <strong>{game.title}</strong>.</p>
  <div style="display:flex;flex-direction:column;gap:10px">
    <a href={`/signin?next=${encodeURIComponent(`/games/${game.slug}`)}`} style="display:block;padding:11px;background:var(--accent,#7c3aed);color:#fff;border-radius:8px;font-size:14px;font-weight:600;text-decoration:none">Sign in</a>
    <a href={`/signup?next=${encodeURIComponent(`/games/${game.slug}`)}`} style="display:block;padding:11px;background:transparent;color:var(--text-secondary);border:1px solid var(--border);border-radius:8px;font-size:14px;font-weight:500;text-decoration:none">Create an account</a>
    <button onclick="closeGameComposer()" style="background:none;border:none;color:var(--text-tertiary);font-size:13px;cursor:pointer;padding:4px;font-family:inherit">Maybe later</button>
  </div>
</div>

<!-- ── Review Composer ── -->
<div id="gameComposerOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.65);z-index:150;backdrop-filter:blur(2px)"></div>
<div id="gameComposer" style="display:none;position:fixed;top:80px;left:50%;transform:translateX(-50%);width:520px;max-width:calc(100vw - 32px);background:var(--bg-card);border:1px solid var(--border);border-radius:16px;z-index:160;padding:24px;max-height:calc(100dvh - 100px);overflow-y:auto">

  <!-- Header -->
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
    <div style="display:flex;align-items:center;gap:10px">
      {game.cover_img_url && (
        <img src={game.cover_img_url} alt={game.title} style="width:32px;height:44px;object-fit:cover;border-radius:4px;border:1px solid var(--border)" />
      )}
      <div>
        <div style="font-size:11px;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.06em;font-weight:600">Write a review</div>
        <div style="font-size:15px;font-weight:600;color:var(--text-primary)">{game.title}</div>
      </div>
    </div>
    <button onclick="closeGameComposer()" style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--text-tertiary);line-height:1;padding:4px">×</button>
  </div>

  <!-- Post-review reveal (shown after submit) -->
  <div id="gcReviewResult" style="display:none;text-align:center;padding:8px 0 20px;animation:resultFadeIn 0.3s ease">
    <div id="gcResultScoreRow" style="display:flex;align-items:center;justify-content:center;gap:0;margin-bottom:24px">
      <div style="text-align:center;padding:0 28px">
        <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-tertiary);margin-bottom:8px">Your score</div>
        <div id="gcResultUserScore" style="font-family:'DM Serif Display',serif;font-size:52px;line-height:1;color:var(--text-primary)"></div>
        <div style="font-size:12px;color:var(--text-tertiary);margin-top:5px">out of 10</div>
      </div>
      <div id="gcResultDivider" style="width:1px;height:72px;background:var(--border);flex-shrink:0"></div>
      <div id="gcResultCommunityCol" style="text-align:center;padding:0 28px">
        <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-tertiary);margin-bottom:8px">Community avg</div>
        <div id="gcResultCommunityScore" style="font-family:'DM Serif Display',serif;font-size:52px;line-height:1;color:var(--text-secondary)"></div>
        <div id="gcResultReviewCount" style="font-size:12px;color:var(--text-tertiary);margin-top:5px"></div>
      </div>
    </div>
    <div id="gcResultFirstMsg" style="display:none;font-size:14px;color:var(--text-secondary);margin-bottom:24px;line-height:1.6;padding:0 8px"></div>
    <div style="display:flex;gap:8px;justify-content:center">
      <button id="gcResultClose" onclick="closeGameComposer()" style="padding:10px 20px;border:1px solid var(--border);border-radius:10px;background:transparent;color:var(--text-secondary);font-size:14px;font-weight:500;font-family:inherit;cursor:pointer">Close</button>
      <a href={`/games/${game.slug}?tab=reviews`} style="padding:10px 20px;border-radius:10px;background:var(--game-accent);color:white;font-size:14px;font-weight:500;text-decoration:none">See all reviews →</a>
    </div>
  </div>

  <!-- Form -->
  <div id="gcFormContent">
    <div class="composer-field">
      <label class="composer-label">Score</label>
      <div style="display:flex;align-items:center;gap:8px">
        <input type="number" id="gcScore" class="composer-input" placeholder="0.0" min="0.1" max="10" step="0.1" style="width:90px" />
        <span style="font-size:15px;color:var(--text-tertiary);font-family:'DM Serif Display',serif">/ 10</span>
      </div>
    </div>
    <div class="composer-field" style="margin-top:12px">
      <label class="composer-label">Title</label>
      <input type="text" id="gcTitle" class="composer-input" placeholder="Sum it up in a line..." maxlength="120" />
    </div>
    <div class="composer-field" style="margin-top:12px">
      <label class="composer-label">Review</label>
      <textarea id="gcBody" class="composer-textarea" placeholder="Write your review..." rows="4" maxlength="5000"></textarea>
      <div style="text-align:right;font-size:11px;color:var(--text-tertiary);margin-top:4px" id="gcCharCount">0 / 5000</div>
    </div>
    <div class="composer-row" style="margin-top:12px">
      <div class="composer-field" style="flex:1">
        <label class="composer-label">Platform played on</label>
        <select id="gcPlatform" class="composer-select">
          <option value="">Select platform...</option>
          {platforms.map((p: any) => (
            <option value={p.id}>{p.name}</option>
          ))}
        </select>
      </div>
      <div class="composer-field" style="width:120px">
        <label class="composer-label">Hours played</label>
        <input type="number" id="gcHours" class="composer-input" placeholder="0" min="0" max="9999" />
      </div>
    </div>
    <div class="composer-actions" style="margin-top:14px">
      <label class="spoiler-toggle">
        <input type="checkbox" id="gcSpoilers" />
        <span>Contains spoilers</span>
      </label>
      <div style="display:flex;gap:8px;margin-left:auto">
        <button class="composer-submit" id="gcSubmit">Post review</button>
      </div>
    </div>
    <div class="composer-error" id="gcError"></div>
  </div>
</div>

<script is:inline define:vars={{ isLoggedIn, gameId: game.id, gameTitle: game.title }}>
  function openGameComposer() {
    if (!isLoggedIn) {
      document.getElementById('gcSignInPrompt').style.display = 'block'
      document.getElementById('gameComposerOverlay').style.display = 'block'
      return
    }
    document.getElementById('gameComposer').style.display = 'block'
    document.getElementById('gameComposerOverlay').style.display = 'block'
    document.getElementById('gcScore').focus()
  }

  function closeGameComposer() {
    document.getElementById('gameComposer').style.display = 'none'
    document.getElementById('gcSignInPrompt').style.display = 'none'
    document.getElementById('gameComposerOverlay').style.display = 'none'
    // reset form
    document.getElementById('gcFormContent').style.display = 'block'
    document.getElementById('gcReviewResult').style.display = 'none'
    document.getElementById('gcScore').value = ''
    document.getElementById('gcTitle').value = ''
    document.getElementById('gcBody').value = ''
    document.getElementById('gcPlatform').value = ''
    document.getElementById('gcHours').value = ''
    document.getElementById('gcSpoilers').checked = false
    document.getElementById('gcError').textContent = ''
    document.getElementById('gcCharCount').textContent = '0 / 5000'
    // reset result card state so it's clean if re-opened
    var gcScoreEl = document.getElementById('gcResultUserScore')
    gcScoreEl.style.color = ''
    gcScoreEl.classList.remove('score-perfect-pop', 'score-stellar', 'score-crumble')
    document.getElementById('gcResultDivider').style.display = ''
    document.getElementById('gcResultCommunityCol').style.display = ''
    document.getElementById('gcResultScoreRow').style.justifyContent = ''
    document.getElementById('gcResultFirstMsg').style.display = 'none'
  }

  window.openGameComposer = openGameComposer
  window.closeGameComposer = closeGameComposer

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeGameComposer()
  })

  document.getElementById('gcBody').addEventListener('input', function() {
    document.getElementById('gcCharCount').textContent = this.value.length + ' / 5000'
  })

  document.getElementById('gcSubmit').addEventListener('click', async function() {
    var btn = this
    var score = parseFloat(document.getElementById('gcScore').value)
    var title = document.getElementById('gcTitle').value.trim()
    var body = document.getElementById('gcBody').value.trim()
    var platform = document.getElementById('gcPlatform').value
    var hours = parseInt(document.getElementById('gcHours').value) || null
    var spoilers = document.getElementById('gcSpoilers').checked
    var errEl = document.getElementById('gcError')

    errEl.textContent = ''

    if (!score || score < 0.1 || score > 10) { errEl.textContent = 'Score must be between 0.1 and 10.'; return }
    if (!title) { errEl.textContent = 'Title is required.'; return }
    if (!body) { errEl.textContent = 'Review is required.'; return }

    btn.disabled = true
    btn.textContent = 'Posting…'

    try {
      var res = await fetch('/api/reviews/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          game_id: gameId,
          score,
          title,
          body,
          platform_played_on: platform || null,
          play_time_hours: hours,
          contains_spoilers: spoilers,
        })
      })
      var data = await res.json()
      if (!res.ok) { errEl.textContent = data.error || 'Failed to post review.'; return }

      // Show reveal card
      var userScore = parseFloat(score)
      document.getElementById('gcFormContent').style.display = 'none'
      document.getElementById('gcReviewResult').style.display = 'block'

      var scoreEl = document.getElementById('gcResultUserScore')
      scoreEl.textContent = userScore.toFixed(1)

      // Score color
      var scoreColorMap = {
        'score-perfect': 'var(--score-perfect)',
        'score-great':   'var(--score-great)',
        'score-teal':    'var(--score-teal)',
        'score-good':    'var(--score-good)',
        'score-mid':     'var(--score-mid)',
        'score-orange':  'var(--score-orange)',
        'score-low':     'var(--score-low)',
      }
      function clientScoreClass(s) {
        if (s === 10) return 'score-perfect'
        if (s >= 9)   return 'score-great'
        if (s >= 8)   return 'score-teal'
        if (s >= 7)   return 'score-good'
        if (s >= 5)   return 'score-mid'
        if (s >= 3)   return 'score-orange'
        return 'score-low'
      }
      scoreEl.style.color = scoreColorMap[clientScoreClass(userScore)]

      // Score-based animations
      if (userScore === 10) {
        scoreEl.classList.add('score-perfect-pop')
      } else if (userScore >= 9) {
        scoreEl.classList.add('score-stellar')
      } else if (userScore <= 3) {
        scoreEl.classList.add('score-crumble')
      }

      if (data.reviewCount > 1) {
        document.getElementById('gcResultCommunityScore').textContent = data.communityAvg.toFixed(1)
        document.getElementById('gcResultReviewCount').textContent =
          'from ' + data.reviewCount + ' review' + (data.reviewCount !== 1 ? 's' : '')
      } else {
        // First reviewer — hide comparison, show message
        document.getElementById('gcResultScoreRow').style.justifyContent = 'center'
        document.getElementById('gcResultDivider').style.display = 'none'
        document.getElementById('gcResultCommunityCol').style.display = 'none'
        document.getElementById('gcResultFirstMsg').style.display = 'block'
        var firstReviewerSuffixes = [
          { text: 'Nice.',                                               weight: 1 },
          { text: 'Achievement unlocked.',                               weight: 1 },
          { text: 'Save point established.',                             weight: 1 },
          { text: 'Pioneer behavior.',                                   weight: 1 },
          { text: 'You set the benchmark.',                              weight: 1 },
          { text: 'Someone had to go first.',                            weight: 1 },
          { text: 'History is written by the first reviewer. Probably.', weight: 1 },
          { text: 'Is anyone out there?',                                weight: 1 },
          { text: 'The record shows it.',                                weight: 1 },
          { text: 'It is written.',                                      weight: 1 },
          { text: 'Here I am. Here I remain.',                           weight: 1 },
          { text: 'The reviews must flow.',                              weight: 1 },
          { text: 'Never tell me the odds.',                             weight: 1 },
          { text: 'Stay a while and listen.',                            weight: 1 },
          { text: 'Gorp gorp gorp.',                                     weight: 1 },
          { text: 'So it begins.',                                       weight: 1 },
        ]
        function pickWeighted(items) {
          var total = items.reduce(function(sum, m) { return sum + m.weight }, 0)
          var r = Math.random() * total
          for (var i = 0; i < items.length; i++) { r -= items[i].weight; if (r <= 0) return items[i].text }
          return items[items.length - 1].text
        }
        document.getElementById('gcResultFirstMsg').textContent =
          'You\'re the first person to review ' + gameTitle + ' on Chekpoint. ' + pickWeighted(firstReviewerSuffixes)
      }

    } catch(e) {
      errEl.textContent = 'Something went wrong. Please try again.'
    } finally {
      btn.disabled = false
      btn.textContent = 'Post review'
    }
  })
</script>

</Layout>
