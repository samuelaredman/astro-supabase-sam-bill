---
// Prerendered so /404 is served as a static file. Pages answer a missing
// game/reviewer/etc. with Astro.redirect('/404'); before this file existed that
// target was rendered by the SSR function every time (~4k function runs/day,
// mostly scrapers).
export const prerender = true;
import Layout from '../components/Layout.astro';
---

<Layout title="Page not found — Chekpoint" variant="centered" noindex>
  <div class="nf">
    <h1>404</h1>
    <p>We couldn't find that page.</p>
    <div class="nf-links">
      <a href="/">Home</a>
      <a href="/search">Search games</a>
    </div>
  </div>
</Layout>

<style>
  .nf { text-align: center; padding: 80px 20px; }
  .nf h1 { font-size: 64px; margin: 0 0 8px; color: var(--accent); }
  .nf p { color: var(--text-secondary); margin: 0 0 24px; }
  .nf-links { display: flex; gap: 16px; justify-content: center; }
  .nf-links a { color: var(--accent); }
</style>
