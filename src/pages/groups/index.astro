---
export const prerender = false;
import { createSupabaseServerClientFromContext, getSupabaseAdmin } from "../../utils/database";
import Layout from "../../components/Layout.astro";
import { getPageUser } from "../../utils/pageAuth";
import { groupGradient } from "../../utils/groupTheme";
import GroupCard, { type GroupCardSummary } from "../../components/groups/GroupCard.astro";

const supabase = createSupabaseServerClientFromContext(Astro);
const user = await getPageUser(Astro, supabase);
const db = getSupabaseAdmin() as any;

// Logged-out visitors see Discover only. Everything that keys off profile.id
// (my groups, invites, pending requests) is skipped when there's no profile.
let profile: { id: string; username: string; avatar_url: string | null } | null = null;
if (user) {
  const { data } = await db
    .from("profiles").select("id, username, avatar_url").eq("auth_user_id", user.id).single();
  profile = data ?? null;
}
const isLoggedIn = !!profile;

const myMemberships = profile
  ? (await (supabase as any)
      .from("group_members")
      .select(`role, groups ( id, name, description, avatar_url, banner_url, banner_position, visibility, created_at, created_by )`)
      .eq("profile_id", profile.id)
      .order("joined_at", { ascending: false })).data
  : null;

const myGroups = (myMemberships ?? []).map((m: any) => ({ ...m.groups, role: m.role }));

// Count members for each group. Counted in Postgres: fetching one row per
// member stops at 1000, and the site group has every profile in it.
async function countMembers(ids: string[]): Promise<Record<string, number>> {
  const counts: Record<string, number> = {};
  if (ids.length === 0) return counts;
  const { data, error } = await db.from("groups").select("id, group_members ( count )").in("id", ids);
  if (error) console.error("[groups] member count error:", JSON.stringify(error));
  for (const row of data ?? []) counts[row.id] = Number(row.group_members?.[0]?.count ?? 0);
  return counts;
}

const groupIds = myGroups.map((g: any) => g.id);
const memberCounts = await countMembers(groupIds);

// Pending invites — only make sense for a signed-in profile
const pendingInvites = profile
  ? (await (supabase as any)
      .from("group_invites")
      .select(`id, group_id, groups ( id, name, description, visibility ), invited_by_profile:invited_by ( username, avatar_url )`)
      .eq("invited_profile_id", profile.id)
      .eq("status", "pending")).data
  : null;

// Discover all groups the user isn't already a member of (including private — users can apply to join)
const { data: discoverGroups } = await db
  .from("groups")
  .select("id, name, description, avatar_url, banner_url, banner_position, visibility, requires_approval, created_at, created_by")
  .in("visibility", ["public", "private"])
  .not("id", "in", `(${groupIds.length > 0 ? groupIds.join(",") : "00000000-0000-0000-0000-000000000000"})`)
  .order("created_at", { ascending: false })
  .limit(20);

const discoverMemberCounts = await countMembers((discoverGroups ?? []).map((g: any) => g.id));

// Covers, member avatars and activity for every card, in one call. A missing
// function (migration not applied yet) just leaves the cards without them.
async function loadSummaries(ids: string[]): Promise<Record<string, GroupCardSummary>> {
  const out: Record<string, GroupCardSummary> = {};
  if (ids.length === 0) return out;
  const { data, error } = await db.rpc("group_card_summaries", { p_group_ids: ids });
  if (error) console.error("[groups] card summaries error:", JSON.stringify(error));
  for (const row of data ?? []) out[row.group_id] = row;
  return out;
}
const summaries = await loadSummaries([...groupIds, ...(discoverGroups ?? []).map((g: any) => g.id)]);

// Creator byline + badges for every card
type GroupCreator = { username: string; avatar_url: string | null; badges: string[] };
async function loadCreators(ids: string[]): Promise<Record<string, GroupCreator>> {
  const out: Record<string, GroupCreator> = {};
  if (ids.length === 0) return out;
  const { data, error } = await db
    .from("profiles")
    .select("id, username, avatar_url, profile_badges!profile_badges_profile_id_fkey ( badge_slug )")
    .in("id", ids);
  if (error) console.error("[groups] creators error:", JSON.stringify(error));
  for (const row of data ?? []) {
    out[row.id] = {
      username: row.username,
      avatar_url: row.avatar_url,
      badges: (row.profile_badges ?? []).map((b: any) => b.badge_slug).filter(Boolean),
    };
  }
  return out;
}
const creatorIds = Array.from(new Set([
  ...myGroups.map((g: any) => g.created_by),
  ...(discoverGroups ?? []).map((g: any) => g.created_by),
].filter(Boolean)));
const creators = await loadCreators(creatorIds);

// Chekpoint Creator groups float to the top of Discover: a group whose owner
// holds the 'chekpoint-creator' badge is a featured community and should be
// discoverable before random user-created groups. Everything else keeps its
// created_at DESC order from the query.
const _isCreatorGroup = (g: any) => (creators[g.created_by]?.badges ?? []).includes('chekpoint-creator');
const discoverGroupsSorted = [...(discoverGroups ?? [])].sort((a, b) => {
  const aIsCreator = _isCreatorGroup(a) ? 1 : 0;
  const bIsCreator = _isCreatorGroup(b) ? 1 : 0;
  return bIsCreator - aIsCreator;
});

// User's pending join requests (so we can show status in discover)
const pendingRequests = profile
  ? (await (supabase as any)
      .from("group_join_requests")
      .select("group_id")
      .eq("profile_id", profile.id)
      .eq("status", "pending")).data
  : null;
const pendingRequestGroupIds = new Set((pendingRequests ?? []).map((r: any) => r.group_id));

function getInitials(name: string) { return name.slice(0, 2).toUpperCase(); }
---

<Layout title="Groups — Chekpoint" isLoggedIn={isLoggedIn} currentProfile={profile} activeNav="groups" variant="two-col">
<style is:global>
  .groups-header { display:flex; align-items:center; justify-content:space-between; padding:24px 28px 0; gap:16px; flex-wrap:wrap; }
  .groups-title { font-family:'DM Serif Display',serif; font-size:24px; }
  .groups-search { position:relative; flex:1; max-width:360px; min-width:220px; }
  .groups-search svg { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--text-tertiary); pointer-events:none; }
  .groups-search input { width:100%; padding:9px 14px 9px 36px; border-radius:22px; border:1px solid var(--border); background:var(--bg-card); color:var(--text-primary); font-size:13px; font-family:inherit; outline:none; transition:border-color .15s, background .15s; }
  .groups-search input:focus { border-color:var(--accent); background:var(--bg); }
  .groups-search input::placeholder { color:var(--text-tertiary); }
  .groups-empty-filtered { padding:32px 28px; text-align:center; color:var(--text-tertiary); font-size:13px; display:none; }
  @media (max-width: 640px) {
    .groups-header { padding:20px 16px 0; }
    .groups-search { max-width:none; width:100%; order:3; }
  }
  .btn-primary { background:var(--accent); color:#fff; border:none; padding:9px 20px; border-radius:22px; font-size:13px; font-weight:500; font-family:inherit; cursor:pointer; transition:opacity .15s; text-decoration:none; display:inline-flex; align-items:center; gap:7px; }
  .btn-primary:hover { opacity:.85; }
  .section-label { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--text-tertiary); padding:24px 28px 10px; }
  .group-list { display:flex; flex-direction:column; gap:1px; }
  .group-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:16px; padding:0 28px 8px; }
  @media (max-width: 640px) { .group-grid { grid-template-columns:1fr; padding:0 16px 8px; } }
  .group-avatar { width:44px; height:44px; border-radius:12px; background:var(--accent-subtle); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; font-family:'DM Serif Display',serif; font-size:16px; font-weight:600; color:var(--accent); flex-shrink:0; overflow:hidden; }
  .group-role { font-size:11px; font-weight:600; padding:2px 8px; border-radius:10px; background:var(--accent-subtle); color:var(--accent); text-transform:capitalize; }
  .visibility-badge { font-size:11px; padding:2px 8px; border-radius:10px; background:var(--tag-bg); color:var(--tag-text); }
  .empty-state { padding:40px 28px; text-align:center; color:var(--text-tertiary); font-size:14px; }
  .empty-hero { padding:48px 28px; text-align:center; }
  .empty-hero-title { font-family:'DM Serif Display',serif; font-size:22px; color:var(--text-primary); margin-bottom:8px; }
  .empty-hero-sub { font-size:14px; color:var(--text-secondary); line-height:1.6; margin-bottom:28px; max-width:340px; margin-left:auto; margin-right:auto; }
  .empty-hero-actions { display:flex; justify-content:center; gap:12px; flex-wrap:wrap; }
  .btn-secondary { background:var(--tag-bg); color:var(--text-primary); border:none; padding:9px 20px; border-radius:22px; font-size:13px; font-weight:500; font-family:inherit; cursor:pointer; text-decoration:none; display:inline-flex; align-items:center; gap:7px; transition:background .15s; }
  .btn-secondary:hover { background:var(--bg-hover); }
  .invite-card { display:flex; align-items:center; gap:14px; padding:14px 28px; background:var(--bg-card); border-bottom:1px solid var(--border-subtle); }
  .invite-info { flex:1; min-width:0; }
  .invite-group-name { font-size:14px; font-weight:600; margin-bottom:2px; }
  .invite-from { font-size:12px; color:var(--text-tertiary); }
  .invite-actions { display:flex; gap:8px; }
  .btn-accept { background:var(--accent); color:#fff; border:none; padding:7px 14px; border-radius:18px; font-size:12px; font-weight:500; font-family:inherit; cursor:pointer; }
  .btn-decline { background:var(--tag-bg); color:var(--text-secondary); border:none; padding:7px 14px; border-radius:18px; font-size:12px; font-weight:500; font-family:inherit; cursor:pointer; }
  .join-link { font-size:12px; color:var(--accent); font-weight:500; margin-left:auto; white-space:nowrap; }
  .divider { border:none; border-top:1px solid var(--border); margin:4px 0; }
  .badge-pending { font-size:11px; padding:2px 10px; border-radius:10px; background:rgba(251,191,36,0.1); color:#fbbf24; font-weight:600; margin-left:auto; white-space:nowrap; border:1px solid rgba(251,191,36,0.25); }
</style>

<div class="feed">
  <div class="groups-header">
    <h1 class="groups-title">Groups</h1>
    <div class="groups-search">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input id="groups-search-input" type="search" placeholder="Search your groups and discover…" autocomplete="off" />
    </div>
    <a href={isLoggedIn ? "/groups/create" : "/signin?next=/groups/create"} class="btn-primary">+ New Group</a>
  </div>
  <div class="groups-empty-filtered" id="groups-empty-filtered">No groups match that search.</div>

  {/* Pending invites */}
  {(pendingInvites ?? []).length > 0 && (
    <div>
      <div class="section-label">Pending Invites</div>
      <div class="group-list" id="invites-list">
        {(pendingInvites ?? []).map((inv: any) => (
          <div class="invite-card" data-invite-id={inv.id} data-group-id={inv.group_id}>
            <div class="group-avatar" style={`background:${groupGradient(inv.group_id)};color:#fff;border:none`}>{getInitials(inv.groups?.name ?? "?")}</div>
            <div class="invite-info">
              <div class="invite-group-name">{inv.groups?.name}</div>
              <div class="invite-from">Invited by @{inv.invited_by_profile?.username}</div>
            </div>
            <div class="invite-actions">
              <button class="btn-accept" onclick="respondInvite(this, 'accept')">Accept</button>
              <button class="btn-decline" onclick="respondInvite(this, 'decline')">Decline</button>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  {/* Empty state — no groups and no public groups to discover */}
  {myGroups.length === 0 && (discoverGroups ?? []).length === 0 && (
    <div class="empty-hero">
      <div class="empty-hero-title">Bring your crew together</div>
      <p class="empty-hero-sub">Create a group to track scores, log game nights, and build a shared watchlist with your friends.</p>
      <div class="empty-hero-actions">
        <a href={isLoggedIn ? "/groups/create" : "/signin?next=/groups/create"} class="btn-primary">+ Create a Group</a>
      </div>
    </div>
  )}

  {/* My groups */}
  {myGroups.length > 0 && (
    <div>
      <div class="section-label">My Groups</div>
      <div class="group-grid">
        {myGroups.map((g: any) => (
          <GroupCard group={g} memberCount={memberCounts[g.id] ?? 1} summary={summaries[g.id]} creator={creators[g.created_by]}>
            <span slot="meta" class="visibility-badge">{g.visibility}</span>
            <span slot="badge" class="group-role">{g.role}</span>
          </GroupCard>
        ))}
      </div>
    </div>
  )}

  {/* Discover public groups */}
  {discoverGroupsSorted.length > 0 && (
    <div>
      <div class="section-label">Discover Groups</div>
      <div class="group-grid">
        {discoverGroupsSorted.map((g: any) => {
          const isPending = pendingRequestGroupIds.has(g.id);
          const isPrivate = g.visibility === "private";
          const needsApproval = isPrivate || !!g.requires_approval;
          return (
            <GroupCard group={g} memberCount={discoverMemberCounts[g.id] ?? 0} summary={summaries[g.id]} isPrivate={isPrivate} creator={creators[g.created_by]}>
              {isPrivate && <span slot="meta" class="visibility-badge">Private</span>}
              {!isPrivate && g.requires_approval && <span slot="meta" class="visibility-badge">Application required</span>}
              {isPending
                ? <span slot="badge" class="badge-pending">Request pending</span>
                : <span slot="badge" class="join-link">{needsApproval ? "Request →" : "View →"}</span>
              }
            </GroupCard>
          );
        })}
      </div>
    </div>
  )}
</div>
</Layout>

<script>
async function respondInvite(btn: HTMLButtonElement, action: 'accept' | 'decline') {
  const card = btn.closest('[data-invite-id]') as HTMLElement;
  if (!card) return;
  const group_id = card.dataset.groupId;
  btn.disabled = true;
  const res = await fetch('/api/groups/invite/respond', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ group_id, action }),
  });
  if (res.ok) {
    card.remove();
    if (action === 'accept') window.location.reload();
  } else {
    const data = await res.json();
    alert(data.error ?? 'Something went wrong');
    btn.disabled = false;
  }
}
(window as any).respondInvite = respondInvite;

// Client-side search: filter the My Groups + Discover cards already on the
// page by name/description. The grid shows only the first 20 discover results,
// so this doesn't query new groups — it narrows what's visible.
(function() {
  const input = document.getElementById('groups-search-input') as HTMLInputElement | null;
  if (!input) return;
  const empty = document.getElementById('groups-empty-filtered') as HTMLElement | null;
  const cards = Array.from(document.querySelectorAll('.gcard')) as HTMLAnchorElement[];

  function apply() {
    const q = input!.value.trim().toLowerCase();
    let totalVisible = 0;
    for (const card of cards) {
      const name = card.dataset.groupName ?? '';
      const desc = card.dataset.groupDesc ?? '';
      const match = q === '' || name.includes(q) || desc.includes(q);
      card.style.display = match ? '' : 'none';
      if (match) totalVisible++;
    }
    // Hide a section-label + its grid when every card in that grid is filtered out.
    document.querySelectorAll('.section-label').forEach((label) => {
      const next = label.nextElementSibling as HTMLElement | null;
      if (!next) return;
      const sectionCards = next.querySelectorAll('.gcard');
      if (sectionCards.length === 0) return;
      const anyVisible = Array.from(sectionCards).some((c) => (c as HTMLElement).style.display !== 'none');
      (label as HTMLElement).style.display = anyVisible ? '' : 'none';
      next.style.display = anyVisible ? '' : 'none';
    });
    if (empty) empty.style.display = (q !== '' && totalVisible === 0) ? '' : 'none';
  }

  input.addEventListener('input', apply);
})();
</script>
