---
export const prerender = false;
import { createSupabaseServerClientFromContext, getSupabaseAdmin } from "../../utils/database";
import Layout from "../../components/Layout.astro";

const supabase = createSupabaseServerClientFromContext(Astro);
const { data: { user } } = await supabase.auth.getUser();
if (!user) return Astro.redirect("/signin");

const db = getSupabaseAdmin() as any;
const { data: profile } = await db
  .from("profiles").select("id").eq("auth_user_id", user.id).single();
if (!profile) return Astro.redirect("/signin");
---

<Layout title="Create Group — Chekpoint" isLoggedIn={true} currentProfile={profile} variant="centered">
<style is:global>
  .create-wrap { max-width:520px; margin:48px auto; padding:0 20px; }
  .create-title { font-family:'DM Serif Display',serif; font-size:26px; margin-bottom:6px; }
  .create-sub { font-size:14px; color:var(--text-tertiary); margin-bottom:32px; }
  .form-group { margin-bottom:20px; }
  .form-label { display:block; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:var(--text-secondary); margin-bottom:7px; }
  .form-input { width:100%; padding:10px 14px; border-radius:10px; border:1px solid var(--border); background:var(--bg-card); color:var(--text-primary); font-size:14px; font-family:inherit; outline:none; transition:border-color .15s; }
  .form-input:focus { border-color:var(--accent); }
  textarea.form-input { resize:vertical; min-height:80px; }
  .visibility-options { display:flex; gap:10px; }
  .vis-option { flex:1; border:2px solid var(--border); border-radius:12px; padding:14px; cursor:pointer; transition:border-color .15s, background .15s; }
  .vis-option.selected { border-color:var(--accent); background:var(--accent-subtle); }
  .vis-option input { display:none; }
  .vis-label { font-size:14px; font-weight:600; margin-bottom:4px; }
  .vis-desc { font-size:12px; color:var(--text-tertiary); }
  .toggle-row { display:flex; align-items:center; gap:8px; font-size:13px; cursor:pointer; padding:10px 12px; border-radius:10px; border:1px solid var(--border); background:var(--bg-card); }
  .toggle-row input { accent-color:var(--accent); width:14px; height:14px; cursor:pointer; }
  .form-actions { display:flex; gap:12px; margin-top:28px; }
  .btn-primary { background:var(--accent); color:#fff; border:none; padding:11px 28px; border-radius:22px; font-size:14px; font-weight:500; font-family:inherit; cursor:pointer; transition:opacity .15s; }
  .btn-primary:hover { opacity:.85; }
  .btn-primary:disabled { opacity:.5; cursor:not-allowed; }
  .btn-ghost { background:var(--tag-bg); color:var(--text-secondary); border:none; padding:11px 20px; border-radius:22px; font-size:14px; font-weight:500; font-family:inherit; cursor:pointer; text-decoration:none; display:inline-flex; align-items:center; }
  .form-error { color:#f87171; font-size:13px; margin-top:12px; display:none; }
</style>

<div>
  <div class="create-wrap">
    <h1 class="create-title">Create a Group</h1>
    <p class="create-sub">Bring your gaming crew together. You can create up to 10 groups.</p>

    <form id="create-form">
      <div class="form-group">
        <label class="form-label" for="name">Group Name</label>
        <input id="name" name="name" class="form-input" type="text" placeholder="e.g. Friday Night Squad" maxlength="60" required />
      </div>

      <div class="form-group">
        <label class="form-label" for="description">Description <span style="font-weight:400;color:var(--text-tertiary)">(optional)</span></label>
        <textarea id="description" name="description" class="form-input" placeholder="What does your crew play?" maxlength="300"></textarea>
      </div>

      <div class="form-group">
        <label class="form-label">Visibility</label>
        <div class="visibility-options">
          <label class="vis-option selected" id="opt-public">
            <input type="radio" name="visibility" value="public" checked />
            <div class="vis-label">Public</div>
            <div class="vis-desc">Anyone can find and join</div>
          </label>
          <label class="vis-option" id="opt-private">
            <input type="radio" name="visibility" value="private" />
            <div class="vis-label">Private</div>
            <div class="vis-desc">Members join by request or invite</div>
          </label>
        </div>
      </div>

      <div class="form-group" id="requires-approval-group">
        <label class="toggle-row">
          <input type="checkbox" id="requires-approval" name="requires_approval" />
          Require approval to join <span style="font-weight:400;color:var(--text-tertiary)">— people apply instead of joining instantly</span>
        </label>
      </div>

      <div class="form-group" id="join-prompt-group" style="display:none">
        <label class="form-label" for="join-prompt">Join request prompt <span style="font-weight:400;color:var(--text-tertiary)">(optional)</span></label>
        <textarea id="join-prompt" name="join_prompt" class="form-input" placeholder="Shown to people requesting to join, e.g. 'Tell us what you usually play'" maxlength="300"></textarea>
      </div>

      <p class="form-error" id="form-error"></p>

      <div class="form-actions">
        <button type="submit" class="btn-primary" id="submit-btn">Create Group</button>
        <a href="/groups" class="btn-ghost">Cancel</a>
      </div>
    </form>
  </div>
</div>
</Layout>

<script>
function updateVisibilityDependentFields() {
  const visibility = (document.querySelector('input[name="visibility"]:checked') as HTMLInputElement).value;
  const isPrivate = visibility === 'private';
  const requiresApproval = (document.getElementById('requires-approval') as HTMLInputElement).checked;
  (document.getElementById('requires-approval-group') as HTMLElement).style.display = isPrivate ? 'none' : 'block';
  (document.getElementById('join-prompt-group') as HTMLElement).style.display = (isPrivate || requiresApproval) ? 'block' : 'none';
}

document.querySelectorAll('.vis-option').forEach(opt => {
  opt.addEventListener('click', () => {
    document.querySelectorAll('.vis-option').forEach(o => o.classList.remove('selected'));
    opt.classList.add('selected');
    updateVisibilityDependentFields();
  });
});
document.getElementById('requires-approval')!.addEventListener('change', updateVisibilityDependentFields);

document.getElementById('create-form')!.addEventListener('submit', async (e) => {
  e.preventDefault();
  const form = e.target as HTMLFormElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const errEl = document.getElementById('form-error') as HTMLElement;
  errEl.style.display = 'none';
  btn.disabled = true;
  btn.textContent = 'Creating…';

  const name = (form.querySelector('#name') as HTMLInputElement).value;
  const description = (form.querySelector('#description') as HTMLTextAreaElement).value;
  const visibility = (form.querySelector('input[name="visibility"]:checked') as HTMLInputElement).value;
  const requires_approval = (form.querySelector('#requires-approval') as HTMLInputElement).checked;
  const join_prompt = (form.querySelector('#join-prompt') as HTMLTextAreaElement).value;

  const res = await fetch('/api/groups/create', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      name, description, visibility,
      requires_approval: visibility === 'public' ? requires_approval : undefined,
      join_prompt: (visibility === 'private' || (visibility === 'public' && requires_approval)) ? join_prompt : undefined,
    }),
  });
  const data = await res.json();
  if (!res.ok) {
    errEl.textContent = data.error ?? 'Something went wrong';
    errEl.style.display = 'block';
    btn.disabled = false;
    btn.textContent = 'Create Group';
    return;
  }
  window.location.href = `/groups/${data.id}`;
});
</script>
