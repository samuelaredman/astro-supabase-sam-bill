---
export const prerender = false;
import { createSupabaseServerClientFromContext, getSupabaseAdmin } from "../../../../utils/database";
import Layout from "../../../../components/Layout.astro";
import ProfileBadge from "../../../../components/ProfileBadge.astro";
import CommentThread from "../../../../components/CommentThread.astro";
import ReportModal from "../../../../components/ReportModal.astro";
import { readBadgeSlugs } from "../../../../utils/badges";
import { timeAgo, igdbImage as igdbCover } from "../../../../utils/format";
import { getGroupAuthority } from "../../../../utils/api";
import { getPageUser } from "../../../../utils/pageAuth";
import type { CommentData } from "../../../../utils/comments";
import "../../../../styles/forum-poll.css";
import "../../../../styles/comments.css";

const groupId = Astro.params.id;
const pollId = Astro.params.pollId;
if (!groupId || !pollId) return Astro.redirect("/groups");

const supabase = createSupabaseServerClientFromContext(Astro);
const user = await getPageUser(Astro, supabase);
const db = getSupabaseAdmin();

let currentProfile: any = null;
if (user) {
  const { data: cp } = await (supabase as any)
    .from("profiles").select("id, username, avatar_url").eq("auth_user_id", user.id).single();
  currentProfile = cp;
}

const { data: group } = await db.from("groups")
  .select("id, name, visibility, invite_code")
  .eq("id", groupId).maybeSingle();
if (!group) return Astro.redirect("/groups");

let membership: any = null;
let authority: any = null;
if (currentProfile) {
  const [{ data: m }, a] = await Promise.all([
    db.from("group_members").select("role").eq("group_id", groupId).eq("profile_id", currentProfile.id).maybeSingle(),
    getGroupAuthority(db, groupId, currentProfile.id),
  ]);
  membership = m;
  authority = a;
}
const isMember = !!membership;
const isAdminOrOwner = ["owner", "admin"].includes(authority?.role ?? "");
const joinCode = Astro.url.searchParams.get("code");
const canViewPrivate = isMember || isAdminOrOwner || (joinCode && joinCode.toUpperCase() === group.invite_code);
const canViewContent = group.visibility !== "private" || !!canViewPrivate;
if (!canViewContent) return Astro.redirect(`/groups/${groupId}`);

const { data: poll } = await db.from("group_polls")
  .select("id, group_id, question, closed, created_at, pinned, profile_id, featured_game_id, game_id, profiles ( id, username, avatar_url, profile_badges!profile_badges_profile_id_fkey ( badge_slug ) )")
  .eq("id", pollId).maybeSingle();
if (!poll || poll.group_id !== groupId) return Astro.redirect(`/groups/${groupId}?tab=forums&section=polls`);

// Resolve the game (featured or direct)
let game: any = null;
if (poll.featured_game_id) {
  const { data: fg } = await db.from("group_featured_games")
    .select("games ( id, title, slug, cover_img_url, date_released )")
    .eq("id", poll.featured_game_id).maybeSingle();
  game = (fg as any)?.games ?? null;
} else if (poll.game_id) {
  const { data: g } = await db.from("games")
    .select("id, title, slug, cover_img_url, date_released")
    .eq("id", poll.game_id).maybeSingle();
  game = g;
}

// Options, votes, voters, answers, answer-votes, replies, reactions — same
// batch pattern as the forum list; reactions keyed by answer_id so both
// top-level answers and their replies can look up their chips.
const [{ data: optionRows }, { data: voteRows }, { data: answerRows }, { data: answerVoteRows }, { data: replyRows }, answerReactionsRes] = await Promise.all([
  db.from("group_poll_options").select("id, poll_id, label, position, color")
    .eq("poll_id", pollId).order("position", { ascending: true }),
  db.from("group_poll_votes").select("poll_id, option_id, profile_id").eq("poll_id", pollId),
  db.from("group_poll_answers")
    .select("id, profile_id, body, created_at, updated_at, profiles!profile_id ( username, avatar_url )")
    .eq("poll_id", pollId)
    .order("created_at", { ascending: false }),
  db.from("group_poll_answer_votes").select("answer_id, profile_id, vote"),
  db.from("group_poll_answer_replies")
    .select("id, answer_id, profile_id, body, created_at, profiles!profile_id ( username, avatar_url )")
    .order("created_at", { ascending: true }),
  (db as any).from("group_poll_answer_reactions").select("answer_id, reply_id, profile_id, reaction_type"),
]);
const answerReactionRows: { answer_id: string | null; reply_id: string | null; profile_id: string; reaction_type: string }[] = (answerReactionsRes as any)?.data ?? [];

const voterIds = Array.from(new Set((voteRows ?? []).map((v: any) => v.profile_id).filter(Boolean)));
const { data: voterRows } = voterIds.length
  ? await db.from("profiles").select("id, username, avatar_url").in("id", voterIds)
  : { data: [] as any[] };
const voterById = new Map<string, any>();
for (const vp of voterRows ?? []) voterById.set(vp.id, vp);
const voters = (voteRows ?? []).map((v: any) => voterById.get(v.profile_id)).filter(Boolean);
const voterStrip = voters.slice(0, 12);
const extraVoters = Math.max(0, voters.length - voterStrip.length);

// Only use answer_votes/replies for THIS poll's answers (bulk fetches above read all)
const answerIds = new Set((answerRows ?? []).map((a: any) => a.id));
const relevantAnswerVotes = (answerVoteRows ?? []).filter((v: any) => answerIds.has(v.answer_id));
const relevantReplies = (replyRows ?? []).filter((r: any) => answerIds.has(r.answer_id));

const myVote = currentProfile ? (voteRows ?? []).find((v: any) => v.profile_id === currentProfile.id) : null;
const myOptionId = myVote?.option_id ?? null;
const totalVotes = (voteRows ?? []).length;
const sortedByCount = (optionRows ?? []).map((o: any) => (voteRows ?? []).filter((v: any) => v.option_id === o.id).length);
const topCount = Math.max(0, ...sortedByCount);
const winnersWithTopCount = sortedByCount.filter((c: number) => c === topCount).length;
const options = (optionRows ?? []).map((o: any) => {
  const count = (voteRows ?? []).filter((v: any) => v.option_id === o.id).length;
  return { ...o, count, isWinner: topCount > 0 && count === topCount && winnersWithTopCount === 1 };
});

const POLL_SLICE_COLORS = ['#6050c8', '#22c55e', '#f0b429', '#ef4444', '#06b6d4', '#ec4899'];
function pieSlices(opts: any[], total: number) {
  if (total === 0) return [] as any[];
  const r = 48, cx = 50, cy = 50;
  const withVotes = opts.filter((o: any) => o.count > 0);
  if (withVotes.length === 1) {
    const o = withVotes[0];
    const color = o.color || POLL_SLICE_COLORS[(o.position ?? 0) % POLL_SLICE_COLORS.length];
    return [{
      path: `M ${cx - r} ${cy} A ${r} ${r} 0 1 1 ${cx + r} ${cy} A ${r} ${r} 0 1 1 ${cx - r} ${cy} Z`,
      color, pct: 1, label: o.label, count: o.count,
    }];
  }
  let a = -Math.PI / 2;
  return withVotes.map((o: any) => {
    const pct = o.count / total;
    const b = a + pct * 2 * Math.PI;
    const sx = cx + r * Math.cos(a), sy = cy + r * Math.sin(a);
    const ex = cx + r * Math.cos(b), ey = cy + r * Math.sin(b);
    const largeArc = pct > 0.5 ? 1 : 0;
    const path = `M ${cx} ${cy} L ${sx} ${sy} A ${r} ${r} 0 ${largeArc} 1 ${ex} ${ey} Z`;
    const color = o.color || POLL_SLICE_COLORS[(o.position ?? 0) % POLL_SLICE_COLORS.length];
    a = b;
    return { path, color, pct, label: o.label, count: o.count };
  });
}
const slices = pieSlices(options, totalVotes);

// Shape poll answers into CommentData for the shared CommentThread component.
const canManagePoll = isAdminOrOwner || poll.profile_id === currentProfile?.id;

// Aggregate reactions keyed by whichever target column the row references,
// so top-level answers and replies look up through the same helper.
const reactionsByTarget = new Map<string, { type: string; count: number; mine: boolean }[]>();
for (const row of answerReactionRows) {
  const key = row.answer_id ?? row.reply_id;
  if (!key) continue;
  const bucket = reactionsByTarget.get(key) ?? [];
  const existing = bucket.find((r) => r.type === row.reaction_type);
  if (existing) {
    existing.count += 1;
    if (currentProfile && row.profile_id === currentProfile.id) existing.mine = true;
  } else {
    bucket.push({
      type: row.reaction_type,
      count: 1,
      mine: !!currentProfile && row.profile_id === currentProfile.id,
    });
  }
  reactionsByTarget.set(key, bucket);
}
const reactionsFor = (targetId: string) =>
  (reactionsByTarget.get(targetId) ?? []).sort((a, b) => b.count - a.count);
const comments: CommentData[] = (answerRows ?? [])
  .map((a: any): CommentData => {
    const votes = relevantAnswerVotes.filter((v: any) => v.answer_id === a.id);
    const upvotes = votes.filter((v: any) => (v.vote ?? 1) === 1).length;
    const downvotes = votes.filter((v: any) => v.vote === -1).length;
    const mine = currentProfile ? votes.find((v: any) => v.profile_id === currentProfile.id) : null;
    const myVote: 1 | -1 | 0 = mine ? ((mine as any).vote ?? 1) : 0;
    const isMine = currentProfile?.id === a.profile_id;
    return {
      id: a.id,
      author: {
        id: a.profile_id,
        username: a.profiles?.username ?? "unknown",
        avatarUrl: a.profiles?.avatar_url ?? null,
      },
      body: a.body,
      createdAt: a.created_at,
      updatedAt: a.updated_at,
      upvotes,
      downvotes,
      myVote,
      canEdit: isMine,
      canDelete: isMine || canManagePoll,
      canReport: !!currentProfile && !isMine,
      reactions: reactionsFor(a.id),
      replies: relevantReplies
        .filter((r: any) => r.answer_id === a.id)
        .map((r: any): CommentData => ({
          id: r.id,
          author: {
            id: r.profile_id,
            username: r.profiles?.username ?? "unknown",
            avatarUrl: r.profiles?.avatar_url ?? null,
          },
          body: r.body,
          createdAt: r.created_at,
          upvotes: 0,
          canDelete: currentProfile?.id === r.profile_id || canManagePoll,
          reactions: reactionsFor(r.id),
        })),
    };
  })
  .sort((a, b) => (b.upvotes - (b.downvotes ?? 0)) - (a.upvotes - (a.downvotes ?? 0)) || b.createdAt.localeCompare(a.createdAt));

// Author role tag
const groupRoleRow = poll.profile_id ? await db.from("group_members")
  .select("role").eq("group_id", groupId).eq("profile_id", poll.profile_id).maybeSingle() : null;
const siteAdminRow = poll.profile_id ? await db.from("site_admins")
  .select("profile_id").eq("profile_id", poll.profile_id).maybeSingle() : null;
const groupRole = (groupRoleRow as any)?.data?.role ?? null;
const isStaff = !!(siteAdminRow as any)?.data;
const authorRole = groupRole === "owner" ? "Owner"
  : groupRole === "admin" ? "Admin"
  : isStaff ? "Staff"
  : null;
const roleTagClass = authorRole === "Owner" ? "fp-poll-role-owner"
  : authorRole === "Admin" ? "fp-poll-role-admin"
  : authorRole === "Staff" ? "fp-poll-role-staff"
  : "";

const hasVoted = !!myOptionId;
const showResults = hasVoted || poll.closed;
const author: any = poll.profiles;
const gameHref = poll.featured_game_id
  ? `/groups/${groupId}?tab=games`
  : (game?.slug ? `/games/${game.slug}` : null);
const gameYear = game?.date_released ? new Date(game.date_released).getFullYear() : null;
---
<Layout title={poll.question} description={`Poll in ${group.name}`} isLoggedIn={!!user} currentProfile={currentProfile} activeNav="groups">
  <div class="poll-page">
    <nav class="poll-breadcrumbs">
      <a href={`/groups/${groupId}`}>{group.name}</a>
      <span>›</span>
      <a href={`/groups/${groupId}?tab=forums&section=polls`}>Forums</a>
    </nav>

    <article class={`fp-poll fp-poll-full${poll.pinned ? " fp-poll-pinned" : ""}${poll.closed ? " fp-poll-closed" : ""}`} data-poll-id={poll.id}>
      <header class="fp-poll-head">
        <a href={author?.username ? `/reviewers/${author.username}` : "#"} class="fp-poll-avatar">
          {author?.avatar_url ? <img src={author.avatar_url} alt="" /> : (author?.username ? author.username.slice(0, 2).toUpperCase() : "?")}
        </a>
        <a href={author?.username ? `/reviewers/${author.username}` : "#"} class="fp-poll-author">@{author?.username ?? "unknown"}</a>
        {readBadgeSlugs(author).map((slug) => <ProfileBadge slug={slug} size="sm" iconOnly={true} />)}
        {authorRole && <span class={`fp-poll-role ${roleTagClass}`}>{authorRole}</span>}
        <span class="fp-poll-time">· {timeAgo(poll.created_at)}</span>
        {poll.pinned && <span class="fp-poll-chip fp-poll-chip-pin">📌 Pinned</span>}
        {poll.closed && <span class="fp-poll-chip fp-poll-chip-closed">🔒 Closed</span>}
        {poll.featured_game_id && <span class="fp-poll-chip fp-poll-chip-featured">★ Featured</span>}
      </header>

      <h1 class="fp-poll-question">{poll.question}</h1>

      <div class="fp-poll-body">
        <div class="fp-poll-panel">
          <div class="fp-poll-panel-head">
            <span class="fp-poll-panel-status">{poll.closed ? "Poll closed" : "Open"}</span>
            <span class="fp-poll-panel-votes">{totalVotes.toLocaleString()} vote{totalVotes !== 1 ? "s" : ""}</span>
          </div>
          <div class="fp-poll-panel-body">
            <div class="fp-poll-options">
              {showResults
                ? options.map((o: any) => {
                    const pct = totalVotes > 0 ? Math.round((o.count / totalVotes) * 100) : 0;
                    const isMine = o.id === myOptionId;
                    const sliceColor = o.color || POLL_SLICE_COLORS[(o.position ?? 0) % POLL_SLICE_COLORS.length];
                    return (
                      <div class={`fp-opt-result${isMine ? " voted" : ""}${o.isWinner ? " winner" : ""}`}>
                        <span class="fp-opt-label">
                          {isMine && <span class="fp-opt-check">✓</span>}{o.label}{o.isWinner && <span class="fp-opt-crown" title="Leading option">👑</span>}
                        </span>
                        <div class="fp-opt-row">
                          <div class="fp-opt-track">
                            <div class="fp-opt-bar" style={`width:${pct}%;background:${sliceColor}`}></div>
                          </div>
                          <span class="fp-opt-count">{o.count.toLocaleString()}<span class="fp-opt-count-pct">· {pct}%</span></span>
                        </div>
                      </div>
                    );
                  })
                : options.map((o: any) => {
                    const sliceColor = o.color || POLL_SLICE_COLORS[(o.position ?? 0) % POLL_SLICE_COLORS.length];
                    return (
                      <button class="fp-opt-vote" onclick={`votePoll('${poll.id}', '${o.id}')`} disabled={poll.closed}>
                        <span class="fp-opt-dot" style={`background:${sliceColor}`}></span>{o.label}
                      </button>
                    );
                  })
              }
            </div>

            <div class="fp-pie-wrap">
              <svg class="fp-pie" viewBox="0 0 100 100">
                {slices.length === 0
                  ? <circle cx="50" cy="50" r="48" fill="none" stroke="var(--border)" stroke-width="2" stroke-dasharray="3 3" />
                  : slices.map((s: any) => (
                      <path d={s.path} fill={s.color}>
                        <title>{s.label}: {Math.round(s.pct * 100)}% ({s.count})</title>
                      </path>
                    ))
                }
                <circle cx="50" cy="50" r="22" fill="var(--bg-card)" />
                <text x="50" y="48" text-anchor="middle" font-size="15" font-weight="700" fill="var(--text-primary)" dominant-baseline="middle">{totalVotes}</text>
                <text x="50" y="62" text-anchor="middle" font-size="7" fill="var(--text-tertiary)" dominant-baseline="middle" style="text-transform:uppercase;letter-spacing:.08em;font-weight:700">vote{totalVotes !== 1 ? "s" : ""}</text>
              </svg>
            </div>

            {game && (
              <a href={gameHref ?? "#"} class="fp-poll-gamecard" title={game.title}>
                {igdbCover(game.cover_img_url, "t_cover_big")
                  ? <img src={igdbCover(game.cover_img_url, "t_cover_big")!} alt={game.title} loading="lazy" />
                  : <div class="fp-poll-gamecard-nocover">🎮</div>
                }
                <div class="fp-poll-gamecard-overlay">
                  {poll.featured_game_id && <div class="fp-poll-gamecard-kicker">Featured</div>}
                  <div class="fp-poll-gamecard-title">{game.title}</div>
                  {gameYear && <div class="fp-poll-gamecard-year">{gameYear}</div>}
                </div>
              </a>
            )}
          </div>
        </div>
      </div>

      <div class="fp-poll-actions">
        <a href="#poll-comments" class="fp-poll-action-btn" aria-label="Jump to comments">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg>
          <span>{comments.length}</span>
        </a>
        <button type="button" class="fp-poll-action-btn" data-share-url={Astro.url.href} data-share-title={poll.question}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
          <span>Share</span>
        </button>
        {voterStrip.length > 0 && (
          <div class="fp-poll-actions-voters">
            <div class="fp-voter-strip">
              {voterStrip.map((v: any) => (
                <a href={`/reviewers/${v.username}`} class="fp-voter" title={`@${v.username}`}>
                  {v.avatar_url ? <img src={v.avatar_url} alt="" loading="lazy" /> : (v.username ? v.username.slice(0, 2).toUpperCase() : "?")}
                </a>
              ))}
              {extraVoters > 0 && <span class="fp-voter fp-voter-more">+{extraVoters}</span>}
            </div>
            <span class="fp-poll-actions-voters-label">voted</span>
          </div>
        )}
      </div>
    </article>

    <section class="poll-thread" id="poll-comments">
      <h2 class="poll-thread-heading">
        Comments
        {comments.length > 0 && <span class="poll-thread-count">{comments.length}</span>}
      </h2>
      <CommentThread
        comments={comments}
        currentUser={currentProfile ? { id: currentProfile.id, username: currentProfile.username, avatarUrl: currentProfile.avatar_url } : null}
        target={{ type: "poll_answer", id: poll.id }}
        canCompose={!poll.closed && isMember}
        showDownvote={true}
        showReport={true}
        maxLength={2000}
        maxDepth={1}
        isModerator={canManagePoll}
        signinReturnTo={Astro.url.pathname + Astro.url.search}
      />
    </section>
  </div>
  <ReportModal />
</Layout>

<script is:inline>
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.fp-poll-action-btn[data-share-url]');
    if (!btn) return;
    e.preventDefault();
    const url = btn.getAttribute('data-share-url');
    const title = btn.getAttribute('data-share-title') || document.title;
    try {
      if (navigator.share) {
        await navigator.share({ title, url });
      } else {
        await navigator.clipboard.writeText(url);
        const old = btn.querySelector('span')?.textContent;
        if (old) { btn.querySelector('span').textContent = 'Copied!'; setTimeout(() => { btn.querySelector('span').textContent = old; }, 1400); }
      }
    } catch {}
  });
</script>

<style is:global>
  /* Match review-detail layout — full width within the two-col shell, same
     padding and spacing as /reviews/[id] so the two detail pages feel like
     siblings instead of one centered-narrow and one wide. */
  .poll-page{min-width:0;padding:24px 20px 60px}
  .poll-breadcrumbs{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text-tertiary);margin-bottom:14px}
  .poll-breadcrumbs a{color:inherit;text-decoration:none}
  .poll-breadcrumbs a:hover{color:var(--accent)}

  /* Full-page poll — Reddit layout. The dark panel is the visual card, so the
     outer article is borderless/padless; the header, question, panel and
     action bar stack cleanly down the column. */
  .fp-poll-full{background:transparent;border:none;padding:0;margin-bottom:16px}
  .fp-poll-full:hover{border:none}
  .fp-poll-full .fp-poll-head{margin-bottom:10px}
  .fp-poll-full .fp-poll-avatar{width:34px;height:34px;font-size:12px}
  .fp-poll-full .fp-poll-author{font-size:14px}
  .fp-poll-full .fp-poll-time{font-size:12.5px}
  .fp-poll-full .fp-poll-question{font-size:24px;line-height:1.25;margin:4px 0 14px;font-weight:800}
  .fp-poll-full .fp-poll-panel-body{align-items:center;gap:22px;padding:18px 20px}
  .fp-poll-full .fp-poll-options{flex:1 1 260px;gap:12px}
  .fp-poll-full .fp-pie-wrap{flex:0 0 160px}
  .fp-poll-full .fp-pie{width:160px;height:160px}
  .fp-poll-full .fp-poll-gamecard{width:130px;flex:0 0 130px}
  .fp-poll-full .fp-opt-vote{font-size:14px;padding:10px 16px}
  .fp-poll-full .fp-opt-label{font-size:14px}
  .fp-poll-full .fp-opt-track{height:16px}
  .fp-poll-full .fp-opt-count{font-size:13px}

  /* Reddit-style action bar — pill buttons for comments + share, voters trail at end */
  .fp-poll-actions{display:flex;align-items:center;gap:8px;margin-top:12px;flex-wrap:wrap}
  .fp-poll-action-btn{display:inline-flex;align-items:center;gap:7px;background:var(--bg-hover);border:1px solid var(--border);border-radius:999px;padding:8px 14px;font-size:13px;font-weight:600;color:var(--text-secondary);font-family:inherit;cursor:pointer;text-decoration:none;transition:background .12s,border-color .12s,color .12s}
  .fp-poll-action-btn:hover{background:var(--bg-card);border-color:var(--text-secondary);color:var(--text-primary)}
  .fp-poll-actions-voters{display:inline-flex;align-items:center;gap:8px;margin-left:auto}
  .fp-poll-actions-voters-label{font-size:12px;color:var(--text-tertiary);font-weight:600}

  /* Comments live in the same bordered card wrapper as /reviews/[id] so the
     two detail pages share identical shape. The heading, composer and list
     styles come from comments.css (CommentThread's own CSS). */
  .poll-thread{margin-top:18px;background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:24px}
  .poll-thread-heading{font-size:15px;font-weight:600;color:var(--text-primary);margin:0 0 20px;display:flex;align-items:center;gap:8px}
  .poll-thread-count{background:var(--tag-bg);color:var(--text-tertiary);font-size:11px;font-weight:600;padding:1px 7px;border-radius:10px}

  @media (max-width: 640px){
    .fp-poll-full .fp-poll-question{font-size:20px}
    .fp-poll-full .fp-pie{width:130px;height:130px}
    .fp-poll-full .fp-pie-wrap{flex:0 0 130px}
    .fp-poll-full .fp-poll-gamecard{width:110px;flex:0 0 110px}
    .fp-poll-actions-voters{margin-left:0;width:100%;justify-content:flex-start;margin-top:4px}
  }
</style>

<script is:inline>
  async function votePoll(pollId, optionId) {
    const res = await fetch('/api/groups/polls/vote', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ poll_id: pollId, option_id: optionId }),
    });
    if (res.ok) window.location.reload();
    else { const d = await res.json(); alert(d.error ?? 'Error voting'); }
  }
  window.votePoll = votePoll;
</script>

<script is:inline define:vars={{ isSignedIn: !!currentProfile }}>
  // Signed-out visitors: redirect the ONE non-comment interactive thing on this
  // page — the poll vote buttons — to /signin. CommentThread handles its own.
  if (!isSignedIn) {
    document.addEventListener('click', (e) => {
      const t = e.target instanceof HTMLElement ? e.target : null;
      const trigger = t?.closest('.fp-opt-vote');
      if (!trigger || trigger.tagName === 'A') return;
      e.preventDefault();
      e.stopImmediatePropagation();
      const returnTo = window.location.pathname + window.location.search + window.location.hash;
      window.location.href = '/signin?returnTo=' + encodeURIComponent(returnTo);
    }, true);
  }
</script>
