---
export const prerender = false;
import { createSupabaseServerClientFromContext, getSupabaseAdmin } from "../../../utils/database";
import Layout from "../../../components/Layout.astro";
import DetailNav from "../../../components/DetailNav.astro";
import { timeAgo, formatScore, scoreClass, igdbImage as igdbCover } from '../../../utils/format';
import { fetchAll } from '../../../utils/fetchAll';
import { topRatedMinReviews } from '../../../utils/groupStats';
import { getGroupAuthority, type GroupAuthority } from '../../../utils/api';
import { groupPath } from '../../../utils/groupSlug';
import {
  loadGroupVersus, type GroupVersusData,
} from '../../../utils/groupCompare';
import CompareTab from '../../../components/groups/CompareTab.astro';
import {
  loadGroupFeed, parseFeedFilter, parseFeedGame, parseFeedOffset, type GroupFeedData,
} from '../../../utils/groupFeed';
import FeedTab from '../../../components/groups/FeedTab.astro';
import GamesTab from '../../../components/groups/GamesTab.astro';
import { buildFeaturedStats, canFeatureGames, formatHours, loadGroupFeaturedGames, type FeaturedStats, type GroupGamesData } from '../../../utils/groupFeaturedGames';
import { groupOwnerYouTube, groupShowcaseLabel, readGroupShowcaseHidden, readGroupShowcaseOrder, showcaseColumn, type GroupShowcaseKey } from '../../../utils/groupShowcases';
import ShowcaseSection from '../../../components/profile/ShowcaseSection.astro';
import CropModal from "../../../components/CropModal.astro";
import ShareButton from "../../../components/ShareButton.astro";
import { getPageUser } from "../../../utils/pageAuth";

const supabase = createSupabaseServerClientFromContext(Astro);
const user = await getPageUser(Astro, supabase);
const id = Astro.params.id;
if (!id) return Astro.redirect("/groups");
// Sessions is switched off for now — flip to true to bring the tab back.
const SESSIONS_ENABLED = false;
const requestedTab = Astro.url.searchParams.get("tab");
const joinCode = Astro.url.searchParams.get("code");

let currentProfile: any = null;
if (user) {
  const { data: cp } = await (supabase as any)
    .from("profiles").select("id, username, avatar_url").eq("auth_user_id", user.id).single();
  currentProfile = cp;
}

// Use admin client for the group query so non-members can view private group info
// (needed for the join-request wall — RLS would otherwise block non-members)
const db = getSupabaseAdmin();

let { data: group, error: groupError } = await db
  .from("groups")
  .select("id, name, description, avatar_url, banner_url, banner_position, visibility, requires_approval, invite_code, slug, created_by, created_at, stats_config, join_prompt, is_site_group, overview_order, overview_hidden, showcase_video_mode, showcase_video_id")
  .eq("id", id)
  .single();

// banner_url column may not exist yet if migration hasn't been applied — fall back without it
if (!group && groupError) {
  const { data: fallback } = await db
    .from("groups")
    .select("id, name, description, avatar_url, visibility, requires_approval, invite_code, slug, created_by, created_at, stats_config, join_prompt")
    .eq("id", id)
    .single();
  if (fallback) group = {
    ...fallback, banner_url: null, banner_position: 'center', is_site_group: false,
    overview_order: [], overview_hidden: null, showcase_video_mode: null, showcase_video_id: null,
  };
}

if (!group) return Astro.redirect("/groups");

// Whether joining this group needs owner/admin approval — always true for
// private groups, optional for public ones via the requires_approval setting
const needsApproval = group.visibility === "private" || !!group.requires_approval;

let membership: any = null;
let authority: GroupAuthority | null = null;
if (currentProfile) {
  const [{ data: m }, a] = await Promise.all([
    db.from("group_members").select("role").eq("group_id", id).eq("profile_id", currentProfile.id).maybeSingle(),
    getGroupAuthority(db, id, currentProfile.id),
  ]);
  membership = m;
  authority = a;
}

const isMember = !!membership;
// Everyone lands on Overview; the Feed is a tab away (?tab=feed).
const activeTab = (!SESSIONS_ENABLED && requestedTab === "sessions" ? null : requestedTab) ?? "overview";
// Site admins get admin controls in every group without joining (getGroupAuthority)
const isAdminOrOwner = ["owner", "admin"].includes(authority?.role ?? "");
const isOwner = membership?.role === "owner";
const isSiteAdminGuest = !isMember && isAdminOrOwner;
// Announcements and polls are for members — and for site admins moderating them
const canSeeMemberContent = isMember || isAdminOrOwner;

// Private groups: non-members need a valid invite code to see the page
const canViewPrivate = canSeeMemberContent || (joinCode && joinCode.toUpperCase() === group.invite_code);
if (group.visibility === "private" && !canViewPrivate) {
  // Don't redirect — render a join-request wall below (handled in HTML)
}

// Does this user have a pending invite to this group?
let pendingInvite: any = null;
if (currentProfile && !isMember) {
  const { data: inv } = await db
    .from("group_invites")
    .select("id")
    .eq("group_id", id)
    .eq("invited_profile_id", currentProfile.id)
    .eq("status", "pending")
    .maybeSingle();
  pendingInvite = inv;
}

// Has this user already submitted a join request?
let existingJoinRequest: any = null;
if (currentProfile && !isMember && needsApproval) {
  const { data: jr } = await db
    .from("group_join_requests")
    .select("id, status")
    .eq("group_id", id)
    .eq("profile_id", currentProfile.id)
    .maybeSingle();
  existingJoinRequest = jr;
}

// Pending join requests visible to admins
let pendingJoinRequests: any[] = [];
if (isAdminOrOwner) {
  const { data: jrs } = await db
    .from("group_join_requests")
    .select("id, message, created_at, profiles:profiles!profile_id ( id, username, avatar_url )")
    .eq("group_id", id)
    .eq("status", "pending")
    .order("created_at", { ascending: true });
  pendingJoinRequests = jrs ?? [];
}

// Everything below the header is for people who can see the group: anyone for
// a public group; members or holders of the invite code for a private one.
const canViewContent = group.visibility !== "private" || !!canViewPrivate;

// Admin client: RLS shows a group's members only to its other members, so on
// the user client a visitor to a public group saw 0 members and empty stats.
const members: any[] = canViewContent
  ? await fetchAll((from, to) => db
      .from("group_members")
      .select("role, joined_at, custom_role_id, profiles ( id, username, avatar_url )")
      .eq("group_id", id)
      .order("joined_at", { ascending: true })
      .order("profile_id")
      .range(from, to))
  : [];

const memberList = members.map((m: any) => ({ ...m.profiles, role: m.role, joined_at: m.joined_at }));
const memberProfileIds = memberList.map((m: any) => m.id);
const memberById: Record<string, any> = {};
for (const m of memberList) memberById[m.id] = m;

// ── Stats config (with defaults) ──
const defaultStats = {
  show_top_games: true, show_top_rated: true, show_hot_take: true,
  show_critic_spectrum: true, show_recent_reviews: true,
  show_score_compare: true, show_sessions: true, show_watchlist: true, show_games: true,
  show_announcements: true, show_polls: true,
  show_consensus: true, show_divergent: true, show_hidden_gems: true, show_score_distribution: true,
  focus_genre_id: null as string | null, focus_platform_id: null as string | null,
};
const statsConf = { ...defaultStats, ...((group.stats_config ?? {}) as Partial<typeof defaultStats>) };
const showSessions = SESSIONS_ENABLED && statsConf.show_sessions;

// ── Games tab ──
// Shown once the group features a game, and before that only to the people who
// can feature one, so a group that doesn't use it never sees an empty tab.
const [canFeature, { count: featuredCount }] = canViewContent && statsConf.show_games
  ? await Promise.all([
      currentProfile ? canFeatureGames(db, id, currentProfile.id) : Promise.resolve(false),
      db.from("group_featured_games").select("id", { count: "exact", head: true }).eq("group_id", id),
    ])
  : [false, { count: 0 }];
const showGames = canViewContent && statsConf.show_games && ((featuredCount ?? 0) > 0 || canFeature);
// ── Overview showcases ──
// The Overview's sections, ordered and hidden like a profile's showcases
// (src/utils/groupShowcases.ts), by whoever can edit the group.
let canEditOverview = isAdminOrOwner;
if (!canEditOverview && authority?.custom_role_id) {
  const { data: cr } = await db.from("group_roles")
    .select("can_edit_group").eq("id", authority.custom_role_id).maybeSingle();
  canEditOverview = !!cr?.can_edit_group;
}
const overviewOrder = readGroupShowcaseOrder(group.overview_order);
const overviewHidden = readGroupShowcaseHidden(group.overview_hidden, group.stats_config as any);
const overviewMain = showcaseColumn(overviewOrder, "main");
const overviewSide = showcaseColumn(overviewOrder, "side");
/** Rendered for visitors when not hidden; always for editors (dimmed in Customize when hidden). */
const wantShowcase = (key: GroupShowcaseKey) => canEditOverview || !overviewHidden.has(key);
const overviewHiddenJson = JSON.stringify([...overviewHidden]);
const overviewOrderJson = JSON.stringify(overviewOrder);

// Now featuring: the group's newest featured game (Games tab), with its numbers
let nowFeaturing: { game: any; note: string | null; youtubeVideoId: string | null; stats: FeaturedStats } | null = null;
if (canViewContent && statsConf.show_games && (featuredCount ?? 0) > 0 && wantShowcase("now_featuring")) {
  const { data: nf } = await db.from("group_featured_games")
    .select("game_id, note, youtube_video_id, games ( id, title, slug, cover_img_url, date_released )")
    .eq("group_id", id).order("created_at", { ascending: false }).limit(1).maybeSingle();
  if (nf?.games) {
    const { data: nfStats } = await db.rpc("group_featured_game_stats", { p_group_id: id, p_game_ids: [nf.game_id] });
    nowFeaturing = {
      game: nf.games,
      note: nf.note,
      youtubeVideoId: nf.youtube_video_id,
      stats: buildFeaturedStats((nfStats ?? [])[0], memberList.length),
    };
  }
}

// Video: the owner's latest upload (filled in by the page from
// /api/groups/latest-video) or one featured video
const videoOwner = canViewContent && (canEditOverview || group.showcase_video_mode === "latest") && wantShowcase("video")
  ? await groupOwnerYouTube(db, id)
  : null;
const showcaseVideoMode: "latest" | "featured" | null =
  group.showcase_video_mode === "latest" && videoOwner?.youtubeUrl ? "latest"
  : group.showcase_video_mode === "featured" && group.showcase_video_id ? "featured"
  : null;
const showcaseVideoId: string | null = showcaseVideoMode === "featured" ? group.showcase_video_id : null;

// A games link from before the tab was switched off (or emptied) lands on Overview
if (activeTab === "games" && canViewContent && !showGames) return Astro.redirect(`/groups/${id}`);

// ── Announcements ──
let announcements: any[] = [];
if (canSeeMemberContent) {
  // Admin client: site admins moderating a group they haven't joined can't read these through RLS
  const { data: ann } = await db
    .from("group_announcements")
    .select("id, body, pinned, created_at, profiles ( id, username, avatar_url )")
    .eq("group_id", id)
    .order("pinned", { ascending: false })
    .order("created_at", { ascending: false })
    .limit(10);
  announcements = ann ?? [];
}

// ── Polls ──
let polls: any[] = [];
if (canSeeMemberContent) {
  const { data: pollRows } = await db
    .from("group_polls")
    .select("id, question, closed, created_at, profile_id")
    .eq("group_id", id)
    // A featured game's poll is shown on its card on the Games tab
    .is("featured_game_id", null)
    .order("created_at", { ascending: false })
    .limit(5);

  if (pollRows?.length) {
    const pollIds = pollRows.map((p: any) => p.id);
    // Votes are paged: five polls in a 250-member group can pass the 1000-row cap
    const [{ data: optionRows }, voteRows] = await Promise.all([
      db.from("group_poll_options").select("id, poll_id, label, position").in("poll_id", pollIds).order("position", { ascending: true }),
      fetchAll((from, to) => db.from("group_poll_votes").select("poll_id, option_id, profile_id")
        .in("poll_id", pollIds).order("id").range(from, to)),
    ]);
    polls = pollRows.map((p: any) => {
      const options = (optionRows ?? []).filter((o: any) => o.poll_id === p.id);
      const votes = (voteRows ?? []).filter((v: any) => v.poll_id === p.id);
      const myVote = currentProfile ? votes.find((v: any) => v.profile_id === currentProfile.id) : null;
      const totalVotes = votes.length;
      return {
        ...p,
        options: options.map((o: any) => ({
          ...o,
          count: votes.filter((v: any) => v.option_id === o.id).length,
        })),
        totalVotes,
        myOptionId: myVote?.option_id ?? null,
      };
    });
  }
}

// ── Custom roles — graceful fallback if migration not yet applied ──
let groupRoles: any[] = [];
try {
  const { data: gr } = await db.from("group_roles").select("id, name, color").eq("group_id", id);
  groupRoles = gr ?? [];
} catch { groupRoles = []; }
const roleMap: Record<string, any> = {};
for (const r of groupRoles) roleMap[r.id] = r;

// Custom role assignments per member
const memberCustomRoles: Record<string, string | null> = {};
for (const m of members) memberCustomRoles[m.profiles?.id] = m.custom_role_id ?? null;

// ── Genre / platform focus — applied inside the group stat functions ──
let focusLabel: string | null = null;
if (statsConf.focus_genre_id) {
  const { data: gn } = await db.from("genres").select("name").eq("id", statsConf.focus_genre_id).maybeSingle();
  focusLabel = gn?.name ? `${gn.name} focus` : null;
} else if (statsConf.focus_platform_id) {
  const { data: pl } = await db.from("platforms").select("name").eq("id", statsConf.focus_platform_id).maybeSingle();
  focusLabel = pl?.name ? `${pl.name} focus` : null;
}

// ── Review stats — aggregated in Postgres (group_* functions, service role).
// Reading members' review rows here was capped at 1000 rows, so totals came
// out low once a group had ~150 active reviewers.
const statArgs = {
  p_group_id: group.id as string,
  p_genre_id: statsConf.focus_genre_id ?? undefined,
  p_platform_id: statsConf.focus_genre_id ? undefined : statsConf.focus_platform_id ?? undefined,
};
const TOP_RATED_MIN_REVIEWS = topRatedMinReviews(memberList.length);
// Critic Spectrum plots the most active reviewers; The Range skips members
// with fewer than this many reviews when enough members clear it.
const SPECTRUM_MAX = 40;
const RANGE_MIN_REVIEWS = 3;
// Overview shows this many members before "See all →" to the Members tab
const MEMBERS_PREVIEW = 5;

let summary: { review_count: number; game_count: number; avg_score: number | null; hours_sum: number } | null = null;
let memberStats: { profile_id: string; review_count: number; avg_score: number }[] = [];
let topGameRows: any[] = [];
let topRatedRows: any[] = [];
let hotTakeRow: any = null;
let activityReviews: any[] = [];
let consensusRows: any[] = [];
let divergentRows: any[] = [];
let hiddenGemRows: any[] = [];
let scoreDistRows: { score: number; review_count: number }[] = [];

const OVERVIEW_LIST_LIMIT = 5;

if (canViewContent && memberProfileIds.length > 0) {
  const gameStats = () => db.rpc("group_game_review_stats", statArgs);
  const [summaryRes, memberStatsRows, topGamesRes, topRatedRes, hotTakeRes, activityRes,
         consensusRes, divergentRes, hiddenGemsRes, scoreDistRes] = await Promise.all([
    db.rpc("group_review_summary", statArgs).maybeSingle(),
    fetchAll((from, to) => db.rpc("group_member_review_stats", statArgs).order("profile_id").range(from, to)),
    gameStats().order("review_count", { ascending: false }).order("avg_score", { ascending: false }).order("game_id").limit(7),
    gameStats().gte("review_count", TOP_RATED_MIN_REVIEWS)
      .order("avg_score", { ascending: false }).order("review_count", { ascending: false }).order("game_id").limit(3),
    db.rpc("group_hot_take", statArgs).maybeSingle(),
    db.rpc("group_reviews", statArgs)
      .select("id, score, title, published_at, profile_id, games ( id, title, slug, cover_img_url ), profiles ( username, avatar_url )")
      .order("published_at", { ascending: false })
      .limit(50),
    db.rpc("group_consensus_picks", { ...statArgs, p_limit: OVERVIEW_LIST_LIMIT }),
    db.rpc("group_divergent_picks", { ...statArgs, p_limit: OVERVIEW_LIST_LIMIT }),
    db.rpc("group_hidden_gems", { ...statArgs, p_limit: OVERVIEW_LIST_LIMIT }),
    db.rpc("group_score_distribution", { p_group_id: group.id,
      p_genre_id: statArgs.p_genre_id, p_platform_id: statArgs.p_platform_id }),
  ]);
  for (const res of [summaryRes, topGamesRes, topRatedRes, hotTakeRes, activityRes,
                     consensusRes, divergentRes, hiddenGemsRes, scoreDistRes]) {
    if (res.error) console.error("[groups/[id]] stats error:", JSON.stringify(res.error));
  }
  summary = summaryRes.data ?? null;
  memberStats = memberStatsRows;
  topGameRows = topGamesRes.data ?? [];
  topRatedRows = topRatedRes.data ?? [];
  hotTakeRow = hotTakeRes.data ?? null;
  activityReviews = activityRes.data ?? [];
  consensusRows = consensusRes.data ?? [];
  divergentRows = divergentRes.data ?? [];
  hiddenGemRows = hiddenGemsRes.data ?? [];
  // group_score_distribution returns one row per (profile_id, score); the
  // group-wide row has profile_id = NULL. Sum by score across the null rows.
  const distByScore: Record<number, number> = {};
  for (const row of scoreDistRes.data ?? []) {
    if ((row as any).profile_id != null) continue;
    distByScore[(row as any).score] = ((row as any).review_count as number) ?? 0;
  }
  scoreDistRows = Array.from({ length: 10 }, (_, i) => ({ score: i + 1, review_count: distByScore[i + 1] ?? 0 }));
}

const totalReviews = summary?.review_count ?? 0;
const uniqueGamesCount = summary?.game_count ?? 0;
const groupAvgScoreAccurate = summary?.avg_score != null ? +summary.avg_score.toFixed(1) : null;
const totalHours = summary?.hours_sum ?? 0;

// Second wave: rows that name games or members the first wave only had ids for
const extraGameIds = [hotTakeRow?.game_id].filter(Boolean);
const { data: extraGames } = extraGameIds.length
  ? await db.from("games").select("id, title, slug, cover_img_url").in("id", extraGameIds)
  : { data: [] as any[] };
const extraGameById: Record<string, any> = {};
for (const g of extraGames ?? []) extraGameById[g.id] = g;

const toGame = (row: any) => ({ id: row.game_id, title: row.title, slug: row.slug, cover_img_url: row.cover_img_url });
const toGameStat = (row: any) => ({ game: toGame(row), count: row.review_count, avgScore: +row.avg_score.toFixed(1) });

const { data: watchlistData } = await (supabase as any)
  .from("group_watchlist")
  .select("id, game_id, added_at, notes, games ( id, title, slug, cover_img_url ), added_by_profile:added_by ( username )")
  .eq("group_id", id)
  .order("added_at", { ascending: false });

const { data: sessionsData } = !showSessions ? { data: [] } : await (supabase as any)
  .from("group_sessions")
  .select(`
    id, played_at, notes,
    games ( id, title, slug, cover_img_url ),
    created_by_profile:created_by ( username ),
    group_session_members ( profiles ( id, username, avatar_url ) )
  `)
  .eq("group_id", id)
  .order("played_at", { ascending: false })
  .limit(50);

const topGames = topGameRows.map(toGameStat);
const topRatedGames = topRatedRows.map(toGameStat);

// Critic spectrum — avg score per member, most active reviewers first
const memberAvgScores = memberStats
  .filter((s) => memberById[s.profile_id])
  .sort((a, b) => b.review_count - a.review_count || a.profile_id.localeCompare(b.profile_id))
  .slice(0, SPECTRUM_MAX)
  .map((s) => ({ ...memberById[s.profile_id], avgScore: +s.avg_score.toFixed(1), reviewCount: s.review_count }));

// The Range — the toughest and easiest graders in the group
let scoreRange: any = null;
const settled = memberAvgScores.filter((m: any) => m.reviewCount >= RANGE_MIN_REVIEWS);
const rangePool = settled.length >= 2 ? settled : memberAvgScores;
if (rangePool.length >= 2) {
  const sorted = [...rangePool].sort((a: any, b: any) => a.avgScore - b.avgScore);
  const toughest = sorted[0];
  const easiest = sorted[sorted.length - 1];
  if (toughest.id !== easiest.id && toughest.avgScore !== easiest.avgScore) {
    scoreRange = { toughest, easiest };
  }
}

// Hot take — group's biggest divergence from community average
const hotTake = hotTakeRow && extraGameById[hotTakeRow.game_id]
  ? (() => {
      const groupAvg = +hotTakeRow.group_avg.toFixed(1);
      const commAvg = +hotTakeRow.community_avg.toFixed(1);
      return { game: extraGameById[hotTakeRow.game_id], groupAvg, commAvg, delta: +(groupAvg - commAvg).toFixed(1) };
    })()
  : null;

// ── Feed tab ──
// Like the Stats tab, built only when it's the tab in the URL. Filter changes
// and further pages re-fetch /groups/[id]/feed, which runs the same loader and
// components (src/utils/groupFeed.ts).
let feedData: GroupFeedData | null = null;
if (canViewContent && activeTab === "feed") {
  feedData = await loadGroupFeed({
    db,
    groupId: group.id,
    genreId: statsConf.focus_genre_id,
    platformId: statsConf.focus_platform_id,
    viewerProfileId: currentProfile?.id ?? null,
    filter: parseFeedFilter(Astro.url.searchParams.get("filter"), !!currentProfile),
    gameId: parseFeedGame(Astro.url.searchParams.get("game")),
    offset: parseFeedOffset(Astro.url.searchParams.get("offset")),
  });
}

// ── Games tab ──
// Like the Stats tab, built only when it's the tab in the URL.
let gamesData: GroupGamesData | null = null;
if (showGames && activeTab === "games") {
  gamesData = await loadGroupFeaturedGames({
    db,
    groupId: group.id,
    memberCount: memberList.length,
    viewerProfileId: currentProfile?.id ?? null,
  });
}

// ── Stats tab ──
// Built only when it's the tab in the URL: the tab links are ordinary
// navigations, so an Overview visit has no use for any of this. Later changes to
// who is being compared re-fetch /groups/[id]/compare, which runs the same
// loader and component (src/utils/groupCompare.ts).
let compareData: GroupVersusData | null = null;
if (canViewContent && statsConf.show_score_compare && activeTab === "compare") {
  compareData = await loadGroupVersus({
    db,
    groupId: group.id,
    genreId: statsConf.focus_genre_id,
    platformId: statsConf.focus_platform_id,
    members: memberList,
    memberStats,
    // The site group's owner is only whoever runs it, not a creator to line up against
    ownerProfileId: group.is_site_group ? null : group.created_by,
    viewerProfileId: currentProfile?.id ?? null,
    withParam: Astro.url.searchParams.get("with"),
    scopeParam: Astro.url.searchParams.get("sc"),
    gamesFilter: Astro.url.searchParams.get("gf"),
    gamesSort: Astro.url.searchParams.get("gs"),
    gamesLimit: Astro.url.searchParams.get("gn"),
    genreParam: Astro.url.searchParams.get("gg"),
    gamesSearch: Astro.url.searchParams.get("gq"),
  });
}

function getInitials(name: string) { return (name ?? "?").slice(0, 2).toUpperCase(); }
// Query for the logged-out Sign up / Sign in buttons: signup joins the group
// after email confirmation, signin comes back here. A valid invite code rides along.
const hasPrivateInvite = group.visibility === "private" && !!joinCode && joinCode.toUpperCase() === group.invite_code;
const canJoinDirectly = !needsApproval || hasPrivateInvite;
const authQuery = `?group=${group.id}` + (hasPrivateInvite ? `&code=${encodeURIComponent(joinCode!)}` : "");

// Share and invite links use the group's custom /c/ link when it has one
const sharePath = groupPath(group);
const inviteUrl = group.invite_code
  ? `${Astro.url.origin}${sharePath}?code=${group.invite_code}`
  : null;

// The Overview sidebar's "At a glance" card. Counts get thousands separators.
const fmtCount = (n: number) => n.toLocaleString("en-US");
const glanceStats = [
  { label: "Members", value: fmtCount(memberList.length) },
  { label: "Reviews", value: fmtCount(totalReviews) },
  { label: "Avg score", value: groupAvgScoreAccurate != null ? groupAvgScoreAccurate.toFixed(1) : "—" },
  { label: "Games played", value: fmtCount(uniqueGamesCount) },
  { label: "Hours played", value: totalHours > 0 ? fmtCount(totalHours) : "—" },
];
const createdDate = new Date(group.created_at).toLocaleDateString("en-US", { month: "long", year: "numeric" });
const bannerStyle = group.banner_url
  ? `background-image:url('${group.banner_url}');background-size:cover;background-position:${group.banner_position ?? 'center'}`
  : "";

const groupDataJson = JSON.stringify({ id: group.id, memberProfileIds, isMember, isAdminOrOwner, isOwner });
const memberListJson = JSON.stringify(memberList);

const groupOgDescription = group.description
  ? group.description.slice(0, 150)
  : `${group.name} — a Chekpoint community group.`;
---

<Layout
  title={`${group.name} — Chekpoint`}
  description={groupOgDescription}
  ogImage={group.avatar_url ?? undefined}
  isLoggedIn={!!user}
  currentProfile={currentProfile}
  noindex={group.visibility === "private"}
  variant="fullwidth"
>
<style is:global>
  :root[data-theme="dark"] {
    --bg:#09090a;--bg-card:#131314;--bg-hover:#1c1c1e;
    --border:#222224;--border-subtle:#191919;
    --text-tertiary:#484644;--tag-bg:#1c1c1e;--tag-text:#6a6866;
    --shadow:0 1px 3px rgba(0,0,0,.5);--shadow-md:0 4px 16px rgba(0,0,0,.7);
    --score-perfect:#ffffff;--score-perfect-bg:#22223a;
    --score-great:#4ade80;--score-great-bg:#112e1c;
    --score-teal:#2dd4bf;--score-teal-bg:#082d2a;
    --score-good:#60a5fa;--score-good-bg:#0e2240;
    --score-mid:#fbbf24;--score-mid-bg:#271e00;
    --score-orange:#fb923c;--score-orange-bg:#2c160a;
    --score-low:#f87171;--score-low-bg:#300e0e;
  }
  html{scroll-behavior:smooth}

  /* ── Banner ── */
  .group-banner{width:100%;height:280px;background:linear-gradient(135deg,#1a1030 0%,#0d1a2e 40%,#0a1a1a 100%);position:relative;overflow:hidden}
  [data-theme="light"] .group-banner{background:linear-gradient(135deg,#e8e4f8 0%,#dce8f5 40%,#daf0f0 100%)}
  .banner-glow{position:absolute;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,var(--accent) 0%,transparent 70%);opacity:.15;top:-120px;right:5%}
  .banner-glow2{position:absolute;width:200px;height:200px;border-radius:50%;background:radial-gradient(circle,#60a5fa 0%,transparent 70%);opacity:.1;top:-60px;left:20%}
  .banner-edit-btn{position:absolute;bottom:12px;right:16px;display:none;align-items:center;gap:7px;background:rgba(0,0,0,.55);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.2);color:white;font-size:12px;font-weight:500;font-family:'DM Sans',sans-serif;padding:7px 14px;border-radius:20px;cursor:pointer;transition:background .15s;z-index:2}
  .banner-edit-btn:hover{background:rgba(0,0,0,.75)}
  body.group-admin .banner-edit-btn{display:flex}

  /* ── Avatar ── */
  .group-header{max-width:980px;margin:0 auto;padding:0 28px;position:relative}
  .group-avatar-wrap{position:absolute;top:-52px;left:28px}
  .group-avatar-container{position:relative;width:104px;height:104px;border-radius:20px}
  .group-avatar-sq{width:104px;height:104px;border-radius:20px;background:var(--bg-card);border:4px solid var(--bg);display:flex;align-items:center;justify-content:center;font-family:'DM Serif Display',serif;font-size:36px;color:var(--accent);overflow:hidden;box-shadow:0 0 0 2px var(--accent)}
  .group-avatar-sq img{width:100%;height:100%;object-fit:cover}
  .group-avatar-edit{position:absolute;inset:0;border-radius:20px;background:rgba(0,0,0,.55);display:none;flex-direction:column;align-items:center;justify-content:center;gap:4px;cursor:pointer;border:4px solid transparent}
  body.group-admin .group-avatar-container:hover .group-avatar-edit{display:flex}
  .group-avatar-edit span{font-size:10px;font-weight:600;color:white;text-transform:uppercase;letter-spacing:.08em}
  .spinner{width:24px;height:24px;border:2px solid rgba(255,255,255,.3);border-top-color:white;border-radius:50%;animation:spin .7s linear infinite}
  @keyframes spin{to{transform:rotate(360deg)}}

  /* ── Group info ── */
  .group-info-row{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding-top:62px;padding-bottom:20px}
  .group-left{flex:1;min-width:0}
  .group-name{font-family:'Cinzel',serif;font-size:28px;font-weight:600;letter-spacing:.04em;margin-bottom:6px;line-height:1.2}
  .group-desc{font-size:14px;color:var(--text-secondary);line-height:1.6;margin-bottom:10px;max-width:480px}
  .group-meta-badges{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .badge{font-size:11px;font-weight:600;padding:3px 10px;border-radius:10px;background:var(--tag-bg);color:var(--tag-text)}
  .badge-accent{background:var(--accent-subtle);color:var(--accent)}
  .glance{margin:0}
  .glance-row{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:7px 0;border-top:1px solid var(--border-subtle)}
  .glance-row:first-child{border-top:none;padding-top:0}
  .glance-row:last-child{padding-bottom:0}
  .glance dt{font-size:13px;color:var(--text-secondary)}
  .glance dd{margin:0;font-size:14px;font-weight:600;color:var(--text-primary);font-variant-numeric:tabular-nums}
  .group-since{font-size:12px;color:var(--text-tertiary)}
  .group-actions{display:flex;flex-direction:column;align-items:flex-end;gap:10px;flex-shrink:0}
  .btn-primary{background:var(--accent);color:#fff;border:none;padding:9px 22px;border-radius:22px;font-size:13px;font-weight:500;font-family:inherit;cursor:pointer;transition:opacity .15s;text-decoration:none;display:inline-flex;align-items:center;gap:6px}
  .btn-primary:hover{opacity:.85}
  .btn-ghost{background:var(--tag-bg);color:var(--text-secondary);border:1px solid var(--border);padding:9px 18px;border-radius:22px;font-size:13px;font-weight:500;font-family:inherit;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:6px}
  .btn-ghost:hover{border-color:var(--text-tertiary)}
  .btn-danger{background:#300e0e;color:#f87171;border:none;padding:8px 16px;border-radius:20px;font-size:13px;font-weight:500;font-family:inherit;cursor:pointer}
  .signin-link{font-size:12px;color:var(--text-secondary);text-decoration:none}
  .signin-link:hover{color:var(--accent)}
  .badge-pending-action{font-size:12px;padding:7px 14px;border-radius:22px;background:rgba(251,191,36,0.1);color:#fbbf24;font-weight:600;border:1px solid rgba(251,191,36,0.25);display:inline-flex;align-items:center}

  /* ── Tab nav (card style) ── */
  .page{max-width:980px;margin:0 auto;padding:20px 28px 80px}
  .tab-nav{display:flex;gap:4px;margin-bottom:24px;background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:4px}
  .tab-link{padding:8px 18px;border-radius:7px;font-size:13px;font-weight:600;color:var(--text-secondary);text-decoration:none;transition:all .15s;white-space:nowrap;display:flex;align-items:center;gap:6px}
  .tab-link:hover{color:var(--text-primary);background:var(--bg-hover)}
  .tab-link.active{background:var(--accent);color:#fff}
  .tab-count{font-size:11px;font-weight:700;background:rgba(255,255,255,.15);border-radius:10px;padding:1px 6px;line-height:1.5}
  .tab-link:not(.active) .tab-count{background:var(--bg-hover);color:var(--text-tertiary)}
  .tab-panel{display:none}
  .tab-panel.active{display:block}

  /* ── Hot Take ── */
  .hot-take-inner{display:flex;align-items:center;gap:12px;text-decoration:none;color:inherit}
  .hot-take-cover{width:52px;height:70px;border-radius:8px;object-fit:cover;flex-shrink:0;background:var(--tag-bg)}
  .hot-take-body{flex:1;min-width:0}
  .hot-take-title{font-size:13px;font-weight:600;margin-bottom:8px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
  .hot-take-scores{display:flex;align-items:center;gap:10px;margin-bottom:6px}
  .hot-take-lbl{font-size:10px;color:var(--text-tertiary);text-align:center;margin-top:3px;font-weight:600;text-transform:uppercase;letter-spacing:.06em}
  .hot-take-vs{font-size:12px;color:var(--text-tertiary)}
  .hot-take-delta{font-size:12px;font-weight:700}
  .delta-up{color:var(--score-great)}
  .delta-down{color:var(--score-low)}

  /* ── Critic Spectrum ── */
  .spectrum-wrap{padding-top:4px}
  .range-row{display:flex;gap:10px;margin-bottom:16px}
  .range-badge{flex:1;display:flex;align-items:center;gap:8px;background:var(--bg-hover);border:1px solid var(--border);border-radius:10px;padding:8px 10px}
  .range-avatar{width:28px;height:28px;border-radius:50%;background:var(--accent-subtle);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:var(--accent);overflow:hidden;flex-shrink:0}
  .range-avatar img{width:100%;height:100%;object-fit:cover}
  .range-info{min-width:0}
  .range-lbl{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--text-tertiary)}
  .range-name{font-size:12px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .spectrum-edge-labels{display:flex;justify-content:space-between;font-size:10px;color:var(--text-tertiary);font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:28px}
  .spectrum-track{position:relative;height:32px;margin-bottom:20px}
  .spectrum-bar{position:absolute;top:50%;left:0;right:0;height:3px;background:linear-gradient(to right,var(--score-low-bg),var(--score-mid-bg),var(--score-great-bg));border-radius:2px;transform:translateY(-50%)}
  .spectrum-avatar{position:absolute;top:50%;transform:translate(-50%,-50%);width:26px;height:26px;border-radius:50%;background:var(--accent-subtle);border:2px solid var(--bg-card);display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:var(--accent);overflow:hidden;box-shadow:0 0 0 1px var(--border);transition:transform .15s ease,box-shadow .15s ease;z-index:1}
  .spectrum-avatar img{width:100%;height:100%;object-fit:cover}
  .spectrum-avatar:hover{transform:translate(-50%,-50%) scale(1.4);box-shadow:0 0 0 2px var(--accent),0 4px 12px rgba(0,0,0,.35);z-index:2}
  .spectrum-avatar.is-you{box-shadow:0 0 0 2px var(--accent);z-index:3}
  .spectrum-avatar.is-you:hover{box-shadow:0 0 0 2px var(--accent),0 4px 12px rgba(0,0,0,.35)}
  .spectrum-ticks{position:absolute;bottom:-14px;left:0;right:0;pointer-events:none}
  .spectrum-ticks span{position:absolute;font-size:9px;color:var(--text-tertiary);transform:translateX(-50%)}

  /* ── Mini rank list (Consensus / Divisive / Hidden Gems) ── */
  .agreement-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
  @media(max-width:700px){.agreement-grid{grid-template-columns:1fr;gap:20px}}
  .agreement-col{min-width:0}
  .mini-card-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
  .mini-rank-list{display:flex;flex-direction:column}
  .mini-rank-item{display:flex;align-items:center;gap:10px;padding:8px;margin:0 -8px;border-radius:8px;text-decoration:none;color:inherit;border-bottom:1px solid var(--border-subtle);transition:background .15s}
  .mini-rank-item:last-child{border-bottom:none}
  .mini-rank-item:hover{background:var(--bg-hover)}
  .mini-rank-item:hover .mini-rank-title{color:var(--accent)}
  .mini-rank-num{width:22px;height:22px;display:flex;align-items:center;justify-content:center;border-radius:50%;font-size:11px;font-weight:700;flex-shrink:0;background:var(--tag-bg);color:var(--text-tertiary)}
  .mini-rank-cover{width:30px;height:40px;border-radius:5px;object-fit:cover;flex-shrink:0;display:block}
  .mini-rank-cover-placeholder{background:var(--tag-bg)}
  .mini-rank-info{flex:1;min-width:0}
  .mini-rank-title{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;transition:color .15s}
  .mini-rank-meta{font-size:11px;color:var(--text-tertiary);margin-top:2px}

  /* ── Score Distribution histogram ── */
  .hist-wrap{display:flex;align-items:flex-end;justify-content:space-between;gap:6px;height:96px;padding-bottom:18px;position:relative}
  .hist-col{flex:1;display:flex;flex-direction:column;align-items:stretch;height:100%;position:relative}
  .hist-col-fill{flex:1;display:flex;align-items:flex-end}
  .hist-bar{width:100%;min-height:0;border-radius:3px 3px 0 0;background:currentColor;transition:filter .15s,transform .15s;transform-origin:bottom}
  .hist-col:hover .hist-bar{filter:brightness(1.25);transform:scaleY(1.03)}
  .hist-lbl{position:absolute;bottom:-16px;left:0;right:0;text-align:center;font-size:10px;color:var(--text-tertiary);font-weight:600}

  /* ── Two-col layout ── */
  .two-col{display:grid;grid-template-columns:1fr 280px;gap:20px;align-items:start}
  @media(max-width:700px){.two-col{grid-template-columns:1fr}}
  .sidebar{display:flex;flex-direction:column;gap:14px}
  .card{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:16px;margin-bottom:14px}
  .card:last-child{margin-bottom:0}
  .card-title{font-size:11px;font-weight:700;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.1em;margin-bottom:12px}

  /* ── Stats ── */
  .stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px}
  .stat-card{background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:14px 16px}
  .stat-val{font-family:'DM Serif Display',serif;font-size:26px;margin-bottom:2px}
  .stat-lbl{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--text-tertiary)}

  /* ── Top games ── */
  .games-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(72px,1fr));gap:8px;margin-bottom:20px}
  .game-thumb{position:relative;display:block;text-decoration:none}
  .game-thumb img{width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:8px;display:block;transition:transform .15s}
  .game-thumb:hover img{transform:translateY(-3px)}
  .game-thumb-placeholder{width:100%;aspect-ratio:3/4;border-radius:8px;background:var(--tag-bg);display:flex;align-items:center;justify-content:center;font-size:10px;color:var(--text-tertiary);text-align:center;padding:4px}
  .game-count-badge{position:absolute;bottom:4px;right:4px;background:rgba(0,0,0,.75);color:#fff;font-size:10px;font-weight:700;padding:2px 5px;border-radius:5px}

  /* ── Score compare ── */
  .variance-tag{font-size:11px;padding:2px 8px;border-radius:8px;margin-left:auto}
  .variance-low{background:var(--score-great-bg);color:var(--score-great)}
  .variance-mid{background:var(--score-mid-bg);color:var(--score-mid)}
  .variance-high{background:var(--score-low-bg);color:var(--score-low)}

  /* ── Sessions ── */
  .session-card{background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:14px 16px;margin-bottom:10px}
  .session-header{display:flex;align-items:center;gap:10px;margin-bottom:8px}
  .session-cover{width:32px;height:42px;border-radius:6px;object-fit:cover;background:var(--tag-bg);flex-shrink:0}
  .session-game{font-size:14px;font-weight:600}
  .session-date{font-size:12px;color:var(--text-tertiary)}
  .session-notes{font-size:13px;color:var(--text-secondary);margin-bottom:8px;line-height:1.5}
  .session-attendees{display:flex;gap:6px;flex-wrap:wrap}
  .attendee-chip{font-size:11px;padding:3px 9px;border-radius:10px;background:var(--tag-bg);color:var(--tag-text)}
  .session-delete{background:none;border:none;cursor:pointer;color:var(--text-tertiary);font-size:12px;margin-left:auto;transition:color .15s}
  .session-delete:hover{color:#f87171}

  /* ── Log session form ── */
  .log-form{background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:16px;margin-bottom:20px}
  .log-form-title{font-size:13px;font-weight:600;margin-bottom:12px}
  .log-row{display:flex;gap:10px;flex-wrap:wrap}
  .log-input{flex:1;min-width:140px;padding:8px 12px;border-radius:8px;border:1px solid var(--border);background:var(--bg-card);color:var(--text-primary);font-size:13px;font-family:inherit;outline:none}
  .log-input:focus{border-color:var(--accent)}
  .log-attendees{margin-top:10px;display:flex;gap:6px;flex-wrap:wrap}
  .attendee-toggle{font-size:12px;padding:4px 10px;border-radius:10px;border:1px solid var(--border);background:var(--tag-bg);color:var(--tag-text);cursor:pointer;transition:all .12s}
  .attendee-toggle.selected{border-color:var(--accent);background:var(--accent-subtle);color:var(--accent)}

  /* ── Sidebar ── */
  .activity-item{display:flex;align-items:flex-start;gap:10px;padding:9px 0;border-bottom:1px solid var(--border-subtle)}
  .activity-item:last-child{border-bottom:none}
  .mini-cover{width:34px;height:45px;border-radius:5px;background:var(--tag-bg);overflow:hidden;flex-shrink:0;border:1px solid var(--border);display:flex;align-items:center;justify-content:center}
  .mini-cover img{width:100%;height:100%;object-fit:cover}
  .mini-score{flex-shrink:0;width:26px;height:26px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700}
  .score-badge{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:7px;font-size:12px;font-weight:700;flex-shrink:0}
  .score-perfect{background:var(--score-perfect-bg);color:var(--score-perfect)}
  .score-great{background:var(--score-great-bg);color:var(--score-great)}
  .score-teal{background:var(--score-teal-bg);color:var(--score-teal)}
  .score-good{background:var(--score-good-bg);color:var(--score-good)}
  .score-mid{background:var(--score-mid-bg);color:var(--score-mid)}
  .score-orange{background:var(--score-orange-bg);color:var(--score-orange)}
  .score-low{background:var(--score-low-bg);color:var(--score-low)}

  .wl-item{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--border-subtle)}
  .wl-item:last-child{border-bottom:none}
  .wl-cover{width:30px;height:40px;border-radius:5px;object-fit:cover;background:var(--tag-bg);flex-shrink:0}
  .wl-title{font-size:13px;font-weight:500;flex:1;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
  .wl-remove{background:none;border:none;cursor:pointer;color:var(--text-tertiary);font-size:16px;padding:2px;transition:color .15s}
  .wl-remove:hover{color:#f87171}

  /* ── Announcements ── */
  .announcement-item{padding:12px 0;border-bottom:1px solid var(--border-subtle)}
  .announcement-item:last-child{border-bottom:none}
  .announcement-head{display:flex;align-items:center;gap:8px;margin-bottom:6px}
  .announcement-avatar{width:24px;height:24px;border-radius:50%;background:var(--accent-subtle);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:var(--accent);overflow:hidden;flex-shrink:0}
  .announcement-avatar img{width:100%;height:100%;object-fit:cover}
  .announcement-author{font-size:12px;font-weight:600}
  .announcement-time{font-size:11px;color:var(--text-tertiary)}
  .announcement-pin-tag{font-size:10px;font-weight:700;color:var(--accent);background:var(--accent-subtle);padding:1px 7px;border-radius:8px;margin-left:auto}
  .announcement-body{font-size:13px;color:var(--text-secondary);line-height:1.5;white-space:pre-wrap}
  .announcement-actions{display:flex;gap:10px;margin-top:6px}
  .announcement-action{background:none;border:none;cursor:pointer;color:var(--text-tertiary);font-size:11px;font-family:inherit;padding:0;transition:color .15s}
  .announcement-action:hover{color:var(--text-primary)}
  .compose-form{background:var(--bg-hover);border:1px solid var(--border);border-radius:10px;padding:12px;margin-bottom:14px}
  .compose-input{width:100%;padding:8px 10px;border-radius:8px;border:1px solid var(--border);background:var(--bg-card);color:var(--text-primary);font-size:13px;font-family:inherit;resize:vertical;min-height:60px;outline:none;box-sizing:border-box}
  .compose-input:focus{border-color:var(--accent)}
  .compose-row{display:flex;align-items:center;gap:10px;margin-top:8px}
  .compose-check{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--text-secondary);cursor:pointer}

  /* ── Polls ── */
  .poll-item{padding:12px 0;border-bottom:1px solid var(--border-subtle)}
  .poll-item:last-child{border-bottom:none}
  .poll-question{font-size:13px;font-weight:600;margin-bottom:8px}
  .poll-option{display:block;width:100%;text-align:left;background:var(--bg-hover);border:1px solid var(--border);border-radius:8px;padding:7px 10px;font-size:12px;font-family:inherit;color:var(--text-primary);cursor:pointer;margin-bottom:6px;transition:border-color .15s}
  .poll-option:hover{border-color:var(--accent)}
  .poll-result{position:relative;border:1px solid var(--border);border-radius:8px;padding:7px 10px;font-size:12px;margin-bottom:6px;overflow:hidden}
  .poll-result-bar{position:absolute;inset:0;background:var(--accent-subtle);z-index:0}
  .poll-result-label{position:relative;z-index:1;display:flex;justify-content:space-between;gap:8px}
  .poll-result.voted{border-color:var(--accent)}
  .poll-meta{font-size:11px;color:var(--text-tertiary);display:flex;justify-content:space-between;align-items:center}
  .poll-meta-actions{display:flex;gap:10px}

  .member-item{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--border-subtle);flex-wrap:wrap}
  .member-item:last-child{border-bottom:none}
  .member-avatar{width:34px;height:34px;border-radius:50%;background:var(--accent-subtle);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;color:var(--accent);flex-shrink:0;overflow:hidden}
  .member-avatar img{width:100%;height:100%;object-fit:cover}
  .member-name{font-size:13px;font-weight:500;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .member-role-tag{font-size:10px;font-weight:700;padding:2px 7px;border-radius:8px;background:var(--accent-subtle);color:var(--accent);text-transform:capitalize;flex-shrink:0}
  .member-role-tag.owner{background:#271e00;color:#fbbf24}
  .member-actions-row{flex-basis:100%;display:flex;gap:5px;padding-left:44px}
  .btn-xs{font-size:11px;padding:3px 9px;border-radius:7px;border:none;cursor:pointer;font-family:inherit;font-weight:500}
  .btn-xs-ghost{background:var(--tag-bg);color:var(--text-secondary)}
  .btn-xs-danger{background:#300e0e;color:#f87171}

  /* ── Invite ── */
  .invite-box{background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:14px;margin-bottom:14px}
  .invite-url-row{display:flex;gap:8px}
  .invite-url-input{flex:1;padding:7px 11px;border-radius:8px;border:1px solid var(--border);background:var(--bg-hover);color:var(--text-secondary);font-size:12px;font-family:monospace;outline:none}
  .btn-copy{background:var(--accent);color:#fff;border:none;padding:7px 13px;border-radius:8px;font-size:12px;font-weight:500;font-family:inherit;cursor:pointer;white-space:nowrap}
  .invite-send-row{display:flex;gap:8px;margin-top:8px}
  .invite-user-input{flex:1;padding:7px 11px;border-radius:8px;border:1px solid var(--border);background:var(--bg-card);color:var(--text-primary);font-size:13px;font-family:inherit;outline:none}
  .invite-user-input:focus{border-color:var(--accent)}

  .stats-section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--border)}
  .stats-section-header>span:first-child{font-size:13px;font-weight:700;color:var(--text-primary)}
  .stats-section-count{font-size:12px;color:var(--text-tertiary);font-weight:500}
  .empty-tab{padding:24px 0;text-align:center;color:var(--text-tertiary);font-size:14px}
  .section-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-tertiary);margin-bottom:12px}
  .see-all-link{font-size:11px;color:var(--accent);font-weight:600;text-decoration:none}
  .see-all-link:hover{text-decoration:underline}
  .podium{display:flex;align-items:flex-end;gap:8px;margin-bottom:0}
  .podium-slot{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;text-align:center;text-decoration:none;color:inherit}
  .podium-img{border-radius:8px;object-fit:cover;display:block}
  .podium-img-lg{width:64px;height:85px}
  .podium-img-sm{width:50px;height:66px}
  .podium-placeholder{background:var(--tag-bg);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:9px;color:var(--text-tertiary);padding:4px}
  .podium-medal{font-size:18px;line-height:1}
  .podium-score{font-size:13px}
  .podium-title-text{font-size:11px;font-weight:500;color:var(--text-secondary);max-width:72px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
  .podium-stand{width:100%;display:flex;align-items:flex-start;justify-content:center;padding-top:8px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;border-radius:8px 8px 0 0}
  .podium-stand-gold{height:72px;background:rgba(251,191,36,.12);border:1px solid rgba(251,191,36,.25);border-bottom:none;color:#fbbf24}
  .podium-stand-silver{height:48px;background:rgba(148,163,184,.08);border:1px solid rgba(148,163,184,.2);border-bottom:none;color:#94a3b8}
  .podium-stand-bronze{height:32px;background:rgba(194,129,60,.08);border:1px solid rgba(194,129,60,.18);border-bottom:none;color:#c2813c}
  .podium-gold .podium-img-lg{box-shadow:0 0 0 2px rgba(251,191,36,.6)}

  @media(max-width:600px){
    .group-name{font-size:22px}
    .page{padding:16px 16px 60px}
    .group-header{padding:0 16px}
    .group-avatar-wrap{left:16px}
    .tab-nav{flex-wrap:wrap}
    .stats-row{grid-template-columns:repeat(2,1fr)}
  }

  /* ── Stats tab (src/components/groups/CompareTab.astro) ── */
  #compare-panel{transition:opacity .12s}
  #compare-panel.gv-busy{opacity:.5;pointer-events:none}
  /* Tab-wide filters, above the cards */
  .gv-filters{display:flex;align-items:center;flex-wrap:wrap;gap:8px 16px;margin-bottom:12px}
  .gv-filters-clear{font-size:12px;color:var(--text-tertiary);text-decoration:underline}
  .gv-filters-clear:hover{color:var(--text-primary)}
  /* Stat cards: subject | shared | other. The cards mirror each other so the values sit next to the middle */
  .gv-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(150px,200px) minmax(0,1fr);gap:12px;align-items:stretch;margin-bottom:18px}
  .gv-card{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:14px 16px;min-width:0;display:flex;flex-direction:column;gap:12px}
  .gv-card-l{border-top:3px solid var(--gv-l)}
  .gv-card-r{border-top:3px solid var(--gv-r)}
  .gv-card-top{display:flex;align-items:center;gap:10px;min-width:0;min-height:44px}
  .gv-card-r .gv-card-top{flex-direction:row-reverse}
  .gv-av{width:40px;height:40px;border-radius:50%;background:var(--tag-bg);color:var(--text-tertiary);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;overflow:hidden;flex-shrink:0}
  .gv-av img{width:100%;height:100%;object-fit:cover}
  /* Avatars (and your name) open that person's profile */
  .gv-profile{display:flex;align-items:center;gap:10px;min-width:0;color:inherit;text-decoration:none;border-radius:999px}
  a.gv-av,.gv-profile .gv-av{transition:box-shadow .15s,transform .15s}
  a.gv-av:hover,.gv-profile:hover .gv-av{box-shadow:0 0 0 2px var(--accent);transform:scale(1.05)}
  .gv-profile:hover .gv-name{text-decoration:underline}
  .gv-profile:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  .gv-name{font-size:15px;font-weight:700;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .gv-pick{position:relative;display:flex;flex-direction:column;align-items:flex-end;gap:2px;min-width:0}
  .gv-select.gv-pick-btn{position:relative;padding-right:30px;text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .gv-pick-btn::after{content:"";position:absolute;right:11px;top:50%;width:6px;height:6px;border-right:2px solid var(--text-tertiary);border-bottom:2px solid var(--text-tertiary);transform:translateY(-70%) rotate(45deg)}
  .gv-pick-btn[aria-expanded="true"]{border-color:var(--accent)}
  .gv-pick-pop{position:absolute;top:calc(100% + 6px);right:0;z-index:30;width:270px;max-width:calc(100vw - 32px);display:flex;flex-direction:column;background:var(--bg-card);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow-md);overflow:hidden;text-align:left}
  .gv-pick-pop[hidden]{display:none}
  .gv-pick-search{display:flex;align-items:center;gap:8px;padding:0 12px;height:40px;border-bottom:1px solid var(--border-subtle);color:var(--text-tertiary)}
  .gv-pick-search input{flex:1;min-width:0;height:100%;border:none;background:none;outline:none;font:inherit;font-size:13px;color:var(--text-primary)}
  .gv-pick-list{max-height:300px;overflow-y:auto;padding:6px}
  .gv-pick-opt{display:flex;align-items:center;gap:9px;width:100%;padding:7px 8px;border:none;border-radius:9px;background:none;font:inherit;font-size:13px;font-weight:600;color:var(--text-primary);text-align:left;cursor:pointer}
  .gv-pick-opt[hidden]{display:none}
  .gv-pick-opt:hover,.gv-pick-opt:focus-visible{background:var(--bg-hover);outline:none}
  .gv-pick-opt[aria-selected="true"]{background:var(--accent-subtle)}
  .gv-pick-opt[aria-selected="true"]::after{content:"✓";margin-left:auto;color:var(--accent);font-weight:800}
  .gv-pick-av{width:24px;height:24px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;overflow:hidden;background:var(--tag-bg);color:var(--text-tertiary);font-size:9px;font-weight:700}
  .gv-pick-av img{width:100%;height:100%;object-fit:cover}
  .gv-pick-name{min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .gv-pick-tag{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--text-tertiary);border:1px solid var(--border);border-radius:999px;padding:1px 6px;flex-shrink:0}
  .gv-pick-group{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-tertiary);padding:10px 8px 4px}
  .gv-pick-empty{font-size:12px;color:var(--text-tertiary);padding:8px}
  .gv-pick-lbl{font-size:11px;color:var(--text-tertiary)}
  .gv-select{max-width:220px;background:var(--bg-hover);border:1px solid var(--border);border-radius:9px;padding:6px 10px;font-size:14px;font-weight:600;font-family:inherit;color:var(--text-primary);cursor:pointer}
  .gv-select:hover,.gv-select:focus{border-color:var(--accent);outline:none}
  .gv-stats{display:flex;flex-direction:column;margin:0}
  .gv-stat{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 0;border-top:1px solid var(--border-subtle)}
  .gv-stat:first-child{border-top:none}
  .gv-card-r .gv-stat{flex-direction:row-reverse}
  .gv-stat dt{font-size:12px;color:var(--text-secondary);min-width:0}
  .gv-stat dd{margin:0;display:flex;flex-direction:column;align-items:flex-end;gap:1px;flex-shrink:0}
  .gv-card-r .gv-stat dd{align-items:flex-start}
  .gv-stat-val{font-size:20px;font-weight:800;line-height:1.1;color:var(--text-primary);font-variant-numeric:tabular-nums}
  .gv-stat-score{display:inline-flex;align-items:center;justify-content:center;min-width:44px;padding:3px 8px;border-radius:9px;font-size:17px}
  .gv-stat-sub{font-size:11px;color:var(--text-tertiary);white-space:nowrap}
  .gv-mid{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;text-align:center;padding:8px 0}
  .gv-vs{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--text-tertiary)}
  .gv-verdict-title{font-family:'DM Serif Display',serif;font-size:20px;line-height:1.2;color:var(--text-primary)}
  .gv-mid-facts{display:flex;flex-direction:column;gap:10px;margin:0;width:100%}
  .gv-fact{display:flex;flex-direction:column;align-items:center;background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:9px 10px;color:inherit;text-decoration:none}
  .gv-fact-lbl{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--text-tertiary)}
  .gv-fact-val{margin-top:2px;font-size:22px;font-weight:800;color:var(--text-primary);font-variant-numeric:tabular-nums}
  /* The two that open the games list: an arrow, and a lift on hover */
  .gv-fact-link{position:relative;cursor:pointer;transition:border-color .12s,background .12s,transform .12s}
  .gv-fact-link::after{content:"→";position:absolute;right:10px;top:50%;transform:translateY(-50%);font-size:13px;color:var(--text-tertiary);transition:color .12s,transform .12s}
  .gv-fact-link:hover{border-color:var(--accent);background:var(--bg-hover);transform:translateY(-1px)}
  .gv-fact-link:hover::after{color:var(--accent);transform:translate(2px,-50%)}
  .gv-fact-link:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .gv-games{scroll-margin-top:16px}
  .gv-mid-empty{font-size:13px;line-height:1.45;color:var(--text-secondary);margin:0}
  .gv-mid-focus{font-size:11px;color:var(--text-tertiary)}
  .gv-note{font-size:12px;color:var(--text-tertiary);margin:-8px 2px 14px}
  /* Tale of the tape: left side in the accent colour, right side in orange */
  /* Series colours, checked for colourblind separation and contrast against each theme's card */
  /* The two sides' colours: the viewer's pick (--gv-pick-*, set on <html> from src/utils/versusColors.ts), else purple vs orange */
  .gv-root{--gv-l:var(--gv-pick-l,#6050c8);--gv-r:var(--gv-pick-r,#d9661c)}
  :root[data-theme="dark"] .gv-root{--gv-l:var(--gv-pick-l-dark,#7b6cf0);--gv-r:var(--gv-pick-r-dark,#e0702a)}
  /* Colour picker, between the stat cards */
  .gv-colors{position:relative}
  .gv-colors summary{list-style:none;display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:600;color:var(--text-secondary);padding:5px 11px;border-radius:999px;border:1px solid var(--border);background:var(--bg-card);cursor:pointer;user-select:none}
  .gv-colors summary::-webkit-details-marker{display:none}
  .gv-colors summary:hover,.gv-colors[open] summary{border-color:var(--accent);color:var(--text-primary)}
  .gv-colors-pair{display:inline-flex}
  .gv-colors-pair .gv-dot{width:10px;height:10px;border:2px solid var(--bg-card)}
  .gv-colors-pair .gv-dot + .gv-dot{margin-left:-4px}
  .gv-colors-pop{position:absolute;top:calc(100% + 8px);left:50%;transform:translateX(-50%);z-index:20;width:280px;max-width:calc(100vw - 32px);padding:12px;border-radius:14px;background:var(--bg-card);border:1px solid var(--border);box-shadow:var(--shadow-md);text-align:left;display:flex;flex-direction:column;gap:10px}
  .gv-colors-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-tertiary)}
  .gv-colors-presets{display:flex;flex-direction:column;gap:4px}
  .gv-preset{display:flex;align-items:center;gap:10px;width:100%;padding:6px 8px;border-radius:9px;border:1px solid transparent;background:none;font:inherit;font-size:13px;color:var(--text-primary);cursor:pointer;text-align:left}
  .gv-preset:hover{background:var(--bg-hover)}
  .gv-preset[aria-pressed="true"]{border-color:var(--accent);background:var(--accent-subtle)}
  .gv-preset-swatch{width:22px;height:22px;border-radius:50%;flex-shrink:0;background:linear-gradient(90deg,var(--pl) 50%,var(--pr) 50%);box-shadow:inset 0 0 0 1px rgba(0,0,0,.12)}
  :root[data-theme="dark"] .gv-preset-swatch{background:linear-gradient(90deg,var(--pld) 50%,var(--prd) 50%)}
  .gv-colors-custom{display:flex;gap:10px;padding-top:8px;border-top:1px solid var(--border-subtle)}
  .gv-colors-custom label{flex:1;min-width:0;display:flex;align-items:center;gap:8px;font-size:12px;font-weight:600;color:var(--text-secondary);overflow:hidden;white-space:nowrap;text-overflow:ellipsis;cursor:pointer}
  .gv-colors-custom input{width:30px;height:30px;padding:0;border:1px solid var(--border);border-radius:8px;background:none;cursor:pointer;flex-shrink:0}
  .gv-colors-reset{align-self:flex-start;font:inherit;font-size:12px;color:var(--text-tertiary);background:none;border:none;padding:0;cursor:pointer;text-decoration:underline}
  .gv-colors-reset:hover{color:var(--text-primary)}
  .gv-tape{margin-bottom:18px}
  .gv-key{display:flex;gap:14px;font-size:12px;font-weight:600;color:var(--text-secondary)}
  .gv-key-item{display:inline-flex;align-items:center;gap:6px}
  .gv-dot{display:inline-block;width:8px;height:8px;border-radius:50%;flex-shrink:0}
  .gv-dot-l{background:var(--gv-l)}
  .gv-dot-r{background:var(--gv-r)}
  /* Histogram and genres side by side; anything else takes the narrow column */
  .gv-tiles{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:10px;align-items:stretch}
  .gv-tiles > :only-child{grid-column:1/-1}
  .gv-tile{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:12px 14px;display:flex;flex-direction:column;gap:8px;min-width:0}
  .gv-tile-label{display:flex;align-items:center;gap:6px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--text-tertiary)}
  .gv-tile-note{font-size:12px;line-height:1.35;color:var(--text-secondary);margin-top:auto}
  /* score distribution */
  .gv-hist-key{display:flex;flex-wrap:wrap;gap:4px 16px;font-size:12px;color:var(--text-secondary)}
  .gv-hist-key span{display:inline-flex;align-items:center;gap:6px}
  .gv-hist-key strong{color:var(--text-primary);font-weight:700}
  .gv-hist-headline{margin-left:auto;color:var(--text-tertiary)}
  /* Axis labels | plot, then the score row under the plot */
  .gv-hist{display:grid;grid-template-columns:28px 1fr;grid-template-rows:118px auto;column-gap:6px;margin-top:16px}
  .gv-hist-axis{position:relative}
  .gv-hist-axis span{position:absolute;right:0;transform:translateY(50%);font-size:10px;color:var(--text-tertiary);font-variant-numeric:tabular-nums}
  .gv-hist-plot{position:relative;display:flex;align-items:stretch;border-bottom:1px solid var(--border)}
  .gv-hist-grid{position:absolute;left:0;right:0;border-top:1px dashed var(--border-subtle);pointer-events:none}
  .gv-hist-col{position:relative;flex:1;min-width:0;display:flex;align-items:flex-end;justify-content:center;gap:3px;padding:0 4px;border-radius:6px 6px 0 0;outline:none;cursor:default}
  .gv-hist-col:hover,.gv-hist-col:focus-visible{background:var(--bg-hover)}
  .gv-hist-bar{position:relative;flex:1;max-width:30px;min-height:2px;border-radius:4px 4px 0 0;opacity:.85;transition:opacity .12s}
  .gv-hist-col:hover .gv-hist-bar,.gv-hist-col:focus .gv-hist-bar{opacity:1}
  /* Grade colours per score, as on the profile: the badge background in light, its text colour in dark */
  .gv-sc-perfect{--gv-sc:var(--score-perfect-bg)}
  .gv-sc-great{--gv-sc:var(--score-great-bg)}
  .gv-sc-teal{--gv-sc:var(--score-teal-bg)}
  .gv-sc-good{--gv-sc:var(--score-good-bg)}
  .gv-sc-mid{--gv-sc:var(--score-mid-bg)}
  .gv-sc-orange{--gv-sc:var(--score-orange-bg)}
  .gv-sc-low{--gv-sc:var(--score-low-bg)}
  :root[data-theme="dark"] .gv-sc-perfect{--gv-sc:var(--score-perfect)}
  :root[data-theme="dark"] .gv-sc-great{--gv-sc:var(--score-great)}
  :root[data-theme="dark"] .gv-sc-teal{--gv-sc:var(--score-teal)}
  :root[data-theme="dark"] .gv-sc-good{--gv-sc:var(--score-good)}
  :root[data-theme="dark"] .gv-sc-mid{--gv-sc:var(--score-mid)}
  :root[data-theme="dark"] .gv-sc-orange{--gv-sc:var(--score-orange)}
  :root[data-theme="dark"] .gv-sc-low{--gv-sc:var(--score-low)}
  /* Same colour for both sides: the subject solid, the other side striped with an outline */
  .gv-hist-l{background:var(--gv-sc)}
  .gv-hist-r{background:repeating-linear-gradient(135deg,var(--gv-sc) 0 2px,transparent 2px 5px);box-shadow:inset 0 0 0 1.5px var(--gv-sc)}
  .gv-swatch{display:inline-block;width:12px;height:10px;border-radius:2px;flex-shrink:0;--gv-sc:var(--text-secondary)}
  .gv-swatch-l{background:var(--gv-sc)}
  .gv-swatch-r{background:repeating-linear-gradient(135deg,var(--gv-sc) 0 1.5px,transparent 1.5px 3.5px);box-shadow:inset 0 0 0 1.2px var(--gv-sc)}
  .gv-hist-bar b{position:absolute;bottom:100%;left:50%;transform:translateX(-50%);padding-bottom:3px;font-size:10px;font-weight:700;color:var(--text-secondary);white-space:nowrap;font-variant-numeric:tabular-nums}
  .gv-hist-tip{position:absolute;bottom:calc(100% + 6px);left:50%;transform:translateX(-50%);z-index:2;display:none;flex-direction:column;gap:3px;min-width:max-content;padding:8px 10px;border-radius:10px;background:var(--bg-card);border:1px solid var(--border);box-shadow:0 6px 18px rgba(0,0,0,.25);font-size:12px;color:var(--text-secondary);text-align:left;pointer-events:none}
  .gv-hist-tip strong{color:var(--text-primary);font-size:12px}
  .gv-hist-tip span{display:inline-flex;align-items:center;gap:6px;font-variant-numeric:tabular-nums}
  .gv-hist-tip-start{left:0;transform:none}
  .gv-hist-tip-end{left:auto;right:0;transform:none}
  .gv-hist-col:hover .gv-hist-tip,.gv-hist-col:focus .gv-hist-tip{display:flex}
  .gv-hist-col:hover .gv-hist-bar b,.gv-hist-col:focus .gv-hist-bar b{visibility:hidden}
  .gv-hist-xs{grid-column:2;display:flex;padding-top:6px}
  .gv-hist-xs span{flex:1;display:flex;justify-content:center}
  .gv-hist-xs em{font-style:normal;font-size:11px;font-weight:700;min-width:22px;padding:2px 0;border-radius:6px;text-align:center;box-shadow:none}
  /* genre radar */
  .gv-radar{width:100%;height:auto;max-height:190px;display:block;overflow:visible;margin:auto 0}
  .gv-radar-ring{fill:none;stroke:var(--border);stroke-width:1;opacity:.7}
  .gv-radar-spoke{stroke:var(--border);stroke-width:1;opacity:.7}
  /* Soft, like a hand-drawn line: rounded joins, light fill, dots that blend into the line */
  .gv-radar-area{stroke-width:2.5;stroke-linejoin:round;stroke-linecap:round}
  .gv-radar-area.gv-radar-l{fill:var(--gv-l);fill-opacity:.16;stroke:var(--gv-l)}
  .gv-radar-area.gv-radar-r{fill:var(--gv-r);fill-opacity:.12;stroke:var(--gv-r)}
  .gv-radar-dot{stroke:none;transition:r .15s}
  .gv-radar-dot.gv-radar-l{fill:var(--gv-l);filter:drop-shadow(0 0 3px var(--gv-l))}
  .gv-radar-dot.gv-radar-r{fill:var(--gv-r);filter:drop-shadow(0 0 3px var(--gv-r))}
  .gv-radar-label{font-size:12px;font-weight:600;fill:var(--text-secondary)}
  .gv-radar-axis:hover .gv-radar-label{fill:var(--text-primary)}
  .gv-radar-axis:hover .gv-radar-dot{r:5}
  .gv-sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  /* favourite (genre, platform, studio) */
  .gv-favs{display:flex;flex-direction:column;gap:7px}
  .gv-fav{display:flex;align-items:center;gap:7px;min-width:0}
  .gv-fav-name{font-size:14px;font-weight:700;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
  .gv-fav-sub{margin-left:auto;font-size:11px;color:var(--text-tertiary);font-variant-numeric:tabular-nums;flex-shrink:0}
  .gv-fav-same{display:flex;flex-direction:column;align-items:flex-start;gap:6px}
  .gv-fav-val{font-family:'DM Serif Display',serif;font-size:22px;line-height:1.1;color:var(--text-primary);max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .gv-same{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#fff;background:linear-gradient(90deg,var(--gv-l),var(--gv-r));border-radius:999px;padding:2px 9px}
  .gv-games{margin-bottom:20px;transition:opacity .12s}
  .gv-games.gv-busy{opacity:.5;pointer-events:none}
  .gv-games-head{display:flex;align-items:center;gap:10px;padding:0 4px 8px;border-bottom:1px solid var(--border)}
  .gv-list-title{flex:1;min-width:0;font-size:13px;font-weight:700;color:var(--text-primary)}
  .gv-games-bar{display:flex;align-items:center;justify-content:flex-end;gap:10px 16px;flex-wrap:wrap;padding:12px 0 2px}
  .gv-search{flex:1 1 200px;min-width:0;max-width:300px;margin-right:auto;display:flex;align-items:center;gap:8px;padding:0 10px;height:32px;border-radius:9px;border:1px solid var(--border);background:var(--bg-hover);color:var(--text-tertiary)}
  .gv-search:focus-within{border-color:var(--accent)}
  .gv-search input{flex:1;min-width:0;height:100%;border:none;background:none;outline:none;font:inherit;font-size:13px;color:var(--text-primary)}
  .gv-search input::placeholder{color:var(--text-tertiary)}
  .gv-sort{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text-tertiary)}
  .gv-sort .gv-select{font-size:13px;padding:5px 8px}
  .gv-games-empty{font-size:13px;color:var(--text-secondary);text-align:center;padding:28px 12px;margin:10px 0 0;background:var(--bg-card);border:1px dashed var(--border);border-radius:14px}
  .gv-games-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 4px 0;font-size:12px;color:var(--text-tertiary)}
  .gv-more{font-size:13px;font-weight:700;color:var(--text-primary);text-decoration:none;padding:7px 16px;border-radius:999px;border:1px solid var(--border);background:var(--bg-card)}
  .gv-more:hover{border-color:var(--accent)}
  /* Game face-offs: your stats | cover | theirs. Each side reads outwards from the cover, score first */
  .gv-faceoffs{display:flex;flex-direction:column;gap:12px;padding-top:12px}
  /* Each face-off sits on its own cover art, blurred and veiled, with a wash of each side's colour */
  .gv-face{position:relative;isolation:isolate;overflow:hidden;display:grid;grid-template-columns:minmax(0,1fr) 130px minmax(0,1fr);grid-template-areas:"l game r";align-items:stretch;min-height:0;background:var(--bg-card);border:1px solid var(--border);border-radius:16px;color:inherit;text-decoration:none;transition:border-color .15s,transform .15s,box-shadow .15s}
  .gv-face::before{content:"";position:absolute;inset:-40px;z-index:-2;background:var(--gv-art,none) center/cover no-repeat;filter:blur(34px) saturate(1.5);opacity:.5;transform:scale(1.1)}
  .gv-face::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,color-mix(in srgb,var(--gv-l) 26%,transparent),transparent 36%,transparent 64%,color-mix(in srgb,var(--gv-r) 26%,transparent)),var(--gv-veil)}
  .gv-root{--gv-veil:rgba(255,255,255,.62)}
  :root[data-theme="dark"] .gv-root{--gv-veil:rgba(12,12,20,.58)}
  .gv-face:hover{border-color:var(--accent);transform:translateY(-1px);box-shadow:0 10px 26px rgba(0,0,0,.18)}
  .gv-face-side{display:flex;align-items:center;gap:18px;padding:12px 20px;min-width:0}
  .gv-face-l{grid-area:l;flex-direction:row-reverse}
  .gv-face-r{grid-area:r}
  .gv-face-lbl{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-secondary);white-space:nowrap}
  .gv-face-score{display:flex;flex-direction:column;align-items:center;gap:6px;flex-shrink:0;min-width:84px;text-align:center}
  .gv-face-score .score-badge{display:inline-flex;align-items:center;justify-content:center;min-width:58px;height:46px;padding:0 10px;border-radius:12px;font-size:23px;font-weight:800}
  .gv-face-score small{font-size:11px;color:var(--text-secondary);white-space:nowrap}
  .gv-face-list{flex:1;min-width:0;display:flex;flex-direction:column;gap:8px;margin:0}
  .gv-face-row{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:baseline;gap:4px 10px}
  .gv-face-row dd{margin:0;text-align:right;font-size:17px;font-weight:800;color:var(--text-primary);font-variant-numeric:tabular-nums;line-height:1.1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .gv-face-platform dd{font-size:14px;font-weight:700}
  /* The right side mirrors the left: values next to the score, labels outside */
  .gv-face-r .gv-face-row{grid-template-columns:minmax(0,1fr) auto}
  .gv-face-r .gv-face-row dt{order:2}
  .gv-face-r .gv-face-row dd{text-align:left}
  .gv-face-meter{grid-column:1/-1;order:3;height:4px;border-radius:999px;background:color-mix(in srgb,var(--text-tertiary) 25%,transparent);overflow:hidden}
  .gv-face-meter i{display:block;height:100%;border-radius:inherit}
  .gv-face-l .gv-face-meter i{background:var(--gv-l);margin-left:auto}
  .gv-face-r .gv-face-meter i{background:var(--gv-r)}
  .gv-face-game{grid-area:game;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:10px 0;text-align:center;min-width:0}
  .gv-face-cover{width:78px;height:104px;border-radius:9px;object-fit:cover;background:var(--tag-bg);box-shadow:0 8px 22px rgba(0,0,0,.35)}
  .gv-face-title{font-size:13px;font-weight:800;line-height:1.25;color:var(--text-primary);overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
  .gv-face-gap{font-size:13px;font-weight:800;font-variant-numeric:tabular-nums;padding:3px 11px;border-radius:999px;background:var(--bg-card);border:1px solid var(--border);color:var(--text-secondary)}
  /* Not the --score-* text colours: the light theme's are white, for badges */
  .gv-root{--gv-up:#15803d;--gv-down:#c2410c}
  :root[data-theme="dark"] .gv-root{--gv-up:#4ade80;--gv-down:#fb923c}
  .gv-diff-up{color:var(--gv-up)}
  .gv-diff-down{color:var(--gv-down)}
  .gv-error{font-size:12px;color:var(--score-low);margin-top:10px}
  @media (max-width:560px){
    .gv-filters{gap:8px}
    .gv-filters .gv-sort{flex:1 1 40%;min-width:0}
    .gv-filters .gv-select{flex:1;min-width:0;max-width:none}
    /* Middle on top, the two cards side by side under it, each stat stacked */
    .gv-head{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px}
    .gv-mid{grid-column:1/-1;grid-row:1;padding:0}
    .gv-mid-facts{flex-direction:row;gap:8px}
    .gv-fact{flex:1;min-width:0;padding:8px}
    .gv-fact-val{font-size:18px}
    .gv-fact-link::after{top:auto;bottom:6px;right:7px;transform:none;font-size:11px}
    .gv-fact-link:hover::after{transform:translateX(2px)}
    .gv-card{padding:12px}
    .gv-card-top{flex-direction:column;align-items:flex-start;gap:6px}
    .gv-card-r .gv-card-top{flex-direction:column;align-items:flex-end}
    .gv-av{width:32px;height:32px}
    .gv-select{max-width:100%;font-size:13px}
    .gv-stat,.gv-card-r .gv-stat{flex-direction:column;align-items:flex-start;gap:2px}
    .gv-card-r .gv-stat{align-items:flex-end}
    .gv-stat dd,.gv-card-r .gv-stat dd{align-items:inherit}
    .gv-stat-val{font-size:18px}
    .gv-tiles{grid-template-columns:1fr;gap:8px}
      /* The menus share the row equally, two to a row */
    .gv-games-bar{gap:8px}
    .gv-sort{flex:1 1 40%;min-width:0}
    .gv-search{flex:1 1 100%;max-width:none;margin-right:0}
    .gv-sort .gv-select{flex:1;min-width:0;max-width:none}
    /* Face-offs: a narrower cover, and each side stacked: score on top, the list under it */
    .gv-face{grid-template-columns:minmax(0,1fr) 76px minmax(0,1fr);min-height:0}
    .gv-face-side,.gv-face-l{flex-direction:column;align-items:stretch;gap:9px;padding:10px 10px}
    .gv-face-score{min-width:0}
    .gv-face-score .score-badge{min-width:48px;height:38px;font-size:19px;border-radius:10px}
    .gv-face-score small{font-size:10px;white-space:normal}
    .gv-face-lbl{font-size:10px;letter-spacing:.05em}
    .gv-face-list{gap:7px}
    .gv-face-row dd{font-size:15px}
    /* Platform names are long: label above, value under it */
    .gv-face-platform,.gv-face-r .gv-face-platform{grid-template-columns:1fr}
    .gv-face-platform dt,.gv-face-r .gv-face-platform dt{order:0}
    .gv-face-platform dd{font-size:13px;white-space:normal;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
    .gv-face-l .gv-face-platform{text-align:right}
    .gv-face-cover{width:60px;height:80px}
    .gv-face-game{padding:10px 0;gap:5px}
    .gv-face-title{font-size:11px}
    .gv-face-gap{font-size:12px;padding:2px 8px}
    /* Too narrow for a label on every bar: tap a score for its readout */
    .gv-hist{grid-template-rows:110px auto;grid-template-columns:26px 1fr;column-gap:4px}
    .gv-hist-bar b{display:none}
    .gv-hist-col{padding:0 2px;gap:2px}
    .gv-tile{padding:10px 11px}
  }

  /* ── Feed tab (src/components/groups/FeedTab.astro) ── */
  #feed-panel{transition:opacity .12s}
  #feed-panel.gf-busy{opacity:.5;pointer-events:none}
  .gf-game{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:10px 14px;margin-bottom:12px;border-radius:10px;background:var(--accent-subtle);border:1px solid var(--border);font-size:13px;color:var(--text-secondary)}
  .gf-game strong{color:var(--text-primary)}
  .gf-game-clear{font-size:12px;font-weight:600;color:var(--accent);text-decoration:none}
  .gf-filters{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px}
  .gf-filter{background:var(--bg-card);border:1px solid var(--border);border-radius:999px;padding:6px 14px;font-size:12px;font-weight:600;font-family:inherit;color:var(--text-secondary);cursor:pointer;transition:background .12s,color .12s,border-color .12s}
  .gf-filter:hover{background:var(--bg-hover);color:var(--text-primary)}
  .gf-filter-on{background:var(--accent);border-color:var(--accent);color:#fff}
  .gf-filter-on:hover{background:var(--accent);color:#fff}
  .gf-list{display:flex;flex-direction:column;gap:16px}
  .gf-item{display:flex;flex-direction:column;gap:0}
  /* The viewer's own score, annotating the card below it */
  .gf-compare{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:12px;color:var(--text-secondary);background:var(--bg-card);border:1px solid var(--border);border-left:3px solid var(--text-tertiary);border-bottom:none;border-radius:12px 12px 0 0;padding:8px 14px}
  .gf-compare-agree{border-left-color:var(--score-great)}
  .gf-compare-close{border-left-color:var(--score-mid)}
  .gf-compare-disagree{border-left-color:var(--score-low)}
  .gf-compare .score-badge{width:24px;height:24px;font-size:11px;border-radius:6px}
  .gf-compare-verdict{font-weight:600;color:var(--text-primary)}
  .gf-compare-disagree .gf-compare-verdict{color:var(--score-low)}
  .gf-own{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text-tertiary);background:var(--bg-card);border:1px solid var(--border);border-bottom:none;border-radius:12px 12px 0 0;padding:7px 14px}
  .gf-more{display:block;width:100%;margin-top:4px;padding:11px;border:1px solid var(--border);border-radius:10px;background:var(--bg-card);color:var(--accent);font-size:13px;font-weight:600;font-family:inherit;cursor:pointer}
  .gf-more:hover{background:var(--bg-hover)}
  .gf-error{font-size:12px;color:var(--score-low);margin-top:10px}


  /* ── Games tab (GamesTab.astro, src/scripts/group-games.ts) ── */
  .gg-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:14px}
  .gg-title{font-size:17px;font-weight:700;margin:0}
  .gg-sub{font-size:13px;color:var(--text-secondary);margin:3px 0 0}
  .gg-add-btn{flex-shrink:0;padding:8px 16px}
  .gg-form{display:flex;flex-direction:column;gap:6px}
  .gg-form[hidden],.gg-edit[hidden],.gg-poll-fields[hidden],.gg-error[hidden]{display:none}
  .gg-label{font-size:11px;font-weight:600;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:.05em;margin-top:6px}
  .gg-optional{font-weight:500;text-transform:none;letter-spacing:0}
  .compose-input.gg-input{min-height:auto}
  .gg-input[hidden]{display:none}
  /* Game search dropdown — the same as the Write a review composer's (src/pages/index.astro) */
  .autocomplete-wrap{position:relative}
  .autocomplete-results{position:absolute;top:calc(100% + 4px);left:0;right:0;background:var(--bg-card);border:1px solid var(--border);border-radius:8px;z-index:100;max-height:420px;overflow-y:auto;display:none;box-shadow:var(--shadow-md);padding:4px}
  .autocomplete-results.open{display:block}
  .autocomplete-item{padding:10px;border-radius:10px;font-size:14px;cursor:pointer;display:flex;align-items:center;gap:12px;transition:background .15s}
  .autocomplete-item:hover{background:var(--bg-hover)}
  .autocomplete-item-cover{width:38px;height:50px;flex-shrink:0;border-radius:6px;overflow:hidden;border:1px solid var(--border);background:var(--tag-bg);display:flex;align-items:center;justify-content:center;font-size:16px}
  .autocomplete-item-cover img{width:100%;height:100%;object-fit:cover;border:none;border-radius:0}
  .autocomplete-item-info{min-width:0;flex:1}
  .autocomplete-item-title{font-size:14px;font-weight:500;margin-bottom:2px;color:var(--text-primary)}
  .autocomplete-item-meta{font-size:12px;color:var(--text-tertiary)}
  .autocomplete-empty{padding:24px;font-size:14px;color:var(--text-tertiary);text-align:center}
  .gg-poll-fields{display:flex;flex-direction:column;gap:6px}
  .gg-poll-options{display:flex;flex-direction:column;gap:6px}
  .gg-small-btn{align-self:flex-start;font-size:11px;padding:5px 10px}
  .gg-add-option{align-self:flex-start}
  .gg-answer-form{margin:8px 0 6px;display:flex;flex-wrap:wrap;align-items:flex-start;gap:6px}
  .gg-answer-form .gg-answer-input{flex:1 1 160px;width:auto}
  .gg-answer-form .gg-error{flex-basis:100%}
  .compose-input.gg-answer-input{min-height:36px;max-height:140px;resize:vertical;field-sizing:content}  /* grows with its text */
  .gg-answer-actions{display:flex;align-items:center;gap:12px}
  .gg-answer-list{list-style:none;margin:0;padding:0}
  .gg-answer{display:flex;gap:10px;padding:7px 0;border-bottom:1px solid var(--border-subtle)}
  .gg-answer:last-child{border-bottom:none}
  .gg-answer-avatar.member-avatar{width:28px;height:28px;font-size:10px;text-decoration:none}
  .gg-answer-main{flex:1;min-width:0}
  .gg-answer-head{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
  .gg-answer-name{font-size:12px;font-weight:600;color:var(--text-primary);text-decoration:none}
  .gg-answer-name:hover{color:var(--accent)}
  .gg-answer-time{font-size:11px;color:var(--text-tertiary)}
  .gg-answer-remove{margin-left:auto}
  .gg-answer-body{margin:2px 0 0;font-size:13px;line-height:1.5;color:var(--text-secondary);white-space:pre-line;overflow-wrap:anywhere}
  .gg-form-actions{display:flex;align-items:center;gap:12px;margin-top:8px}
  .gg-link-btn{background:none;border:none;padding:0;color:var(--accent);font-family:inherit;font-size:12px;font-weight:600;cursor:pointer;text-decoration:none}
  .gg-link-btn:hover{text-decoration:underline}
  .gg-error{font-size:12px;color:#f87171;margin:4px 0 0}
  .gg-empty{max-width:520px;margin:0 auto;line-height:1.5}
  .gg-list{display:flex;flex-direction:column;gap:6px}
  .gg-card.card{padding:0;overflow:hidden}
  /* Header: the cover art blurred behind a big cover, the title and the creator's note */
  .gg-hero{position:relative;overflow:hidden;padding:18px 18px 14px}
  .gg-hero-art{position:absolute;inset:-40px;background-size:cover;background-position:center 30%;filter:blur(42px) saturate(1.7);opacity:.75;transform:scale(1.15)}
  .gg-hero::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(var(--bg-card-rgb),.15) 0%,rgba(var(--bg-card-rgb),.7) 60%,var(--bg-card) 100%)}
  :root[data-theme="light"] .gg-hero-art{opacity:.45}
  .gg-hero-inner{position:relative;z-index:1;display:flex;align-items:flex-end;gap:16px}
  .gg-cover{width:88px;height:118px;border-radius:9px;object-fit:cover;flex-shrink:0;background:var(--bg-hover);border:1px solid rgba(255,255,255,.08);box-shadow:0 10px 26px rgba(0,0,0,.45)}
  .gg-cover-empty{display:flex;align-items:center;justify-content:center;font-size:34px}
  .gg-hero-text{flex:1;min-width:0}
  .gg-kicker{display:flex;align-items:center;flex-wrap:wrap;gap:8px;font-size:11px;color:var(--text-secondary)}
  .gg-kicker-pill{background:var(--accent);color:#fff;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;padding:3px 8px;border-radius:999px}
  .gg-game-title{display:block;font-size:23px;font-weight:800;letter-spacing:-.4px;line-height:1.1;color:var(--text-primary);text-decoration:none;margin-top:5px}
  a.gg-game-title:hover{color:var(--accent);text-decoration:none}
  .gg-note{margin:8px 0 0;padding:1px 0 1px 10px;border-left:3px solid var(--accent);font-size:13px;line-height:1.5;color:var(--text-primary);opacity:.88;white-space:pre-line;max-width:62ch}
  .gg-hero-actions{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-top:12px}
  .gg-review-btn{padding:6px 16px;font-size:12.5px}
  .gg-ghost-btn{display:inline-flex;align-items:center;padding:5px 14px;border-radius:22px;border:1px solid var(--border);background:rgba(var(--bg-card-rgb),.55);color:var(--text-primary);font-size:12.5px;font-weight:500;text-decoration:none;transition:border-color .15s}
  .gg-ghost-btn:hover{border-color:var(--text-secondary);text-decoration:none}
  .gg-my-review{display:inline-flex;align-items:center;gap:8px;padding:5px 14px 5px 6px;border-radius:22px;background:rgba(var(--bg-card-rgb),.55);border:1px solid var(--border);font-size:13px;font-weight:600;color:var(--text-primary);text-decoration:none}
  .gg-my-review:hover{border-color:var(--text-secondary);text-decoration:none}
  .gg-my-review .score-badge{width:26px;height:26px;font-size:12px}
  .gg-manage{margin-left:auto;display:flex;gap:10px}
  .gg-btn-count{font-size:11px;font-weight:700;background:var(--tag-bg);color:var(--text-secondary);border-radius:10px;padding:1px 7px;margin-left:6px}
  /* The group's rating: the biggest thing on the card after the cover */
  .gg-score{flex-shrink:0;align-self:center;display:flex;flex-direction:column;align-items:center;gap:6px;min-width:108px;padding:10px 12px;border-radius:14px;background:rgba(var(--bg-card-rgb),.6);border:1px solid var(--border);backdrop-filter:blur(8px);text-decoration:none;color:inherit;transition:border-color .15s,transform .15s}
  .gg-score:hover{border-color:var(--text-secondary);transform:translateY(-1px);text-decoration:none}
  .gg-score-num{display:flex;align-items:center;justify-content:center;min-width:70px;height:54px;padding:0 10px;border-radius:12px;font-size:30px;font-weight:800;letter-spacing:-1.2px;line-height:1}
  .gg-score-none .gg-score-num{background:var(--tag-bg);color:var(--text-tertiary)}
  .gg-score-text{display:flex;flex-direction:column;align-items:center;text-align:center;gap:1px}
  .gg-score-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--text-primary)}
  .gg-score-sub{font-size:11px;color:var(--text-secondary)}
  .gg-body{padding:0 18px 16px;min-width:0}
  .gg-edit{margin:0 0 16px;display:flex;flex-direction:column;gap:6px}
  /* Video beside the community's numbers */
  .gg-split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px;align-items:stretch}
  .gg-split-solo{grid-template-columns:minmax(0,1fr)}
  .gg-media .rc-video.gg-video{flex-direction:column;max-width:none;margin:0;padding:0;border:none;background:none;gap:8px}
  .gg-media .gg-video .rc-video-thumb{width:100%;border-radius:12px}
  .gg-media .gg-video .rc-video-play{width:58px;height:40px;border-radius:12px}
  .gg-media .gg-video .rc-video-desc{-webkit-line-clamp:2}
  .gg-media .rc-video-player{max-width:none;margin:0;border-radius:12px}
  /* The community panel. Each stage has its own colour: played (sky), finished (gold), 100% (lavender platinum) */
  .gg-card{--c-played:#7dd3fc;--c-completed:#fcd34d;--c-full:#c4b5fd;--plat-a:#ede9fe;--plat-b:#a5b4fc}
  :root[data-theme="light"] .gg-card{--c-played:#0ea5e9;--c-completed:#f59e0b;--c-full:#8b5cf6;--plat-a:#a78bfa;--plat-b:#6366f1}
  .gg-community{display:flex;flex-direction:column;justify-content:space-between;gap:10px;background:var(--bg-hover);border:1px solid var(--border-subtle);border-radius:12px;padding:12px 14px}
  .gg-stage-played{--stage:var(--c-played)}
  .gg-stage-completed{--stage:var(--c-completed)}
  .gg-stage-full{--stage:var(--c-full)}
  .gg-plat-a{stop-color:var(--plat-a)}
  .gg-plat-b{stop-color:var(--plat-b)}
  .gg-section-label{font-size:11px;font-weight:700;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:.06em}
  .gg-section-sub{font-weight:500;text-transform:none;letter-spacing:0}
  /* Stage picker */
  .gg-stages{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}
  .gg-stage{display:flex;flex-direction:column;align-items:center;gap:1px;min-width:0;padding:6px 4px 5px;border-radius:10px;border:1px solid transparent;background:none;font-family:inherit;color:inherit;cursor:pointer;transition:background .15s,border-color .15s,transform .15s}
  .gg-stage:hover{background:color-mix(in srgb,var(--stage) 7%,transparent);transform:translateY(-1px)}
  .gg-stage[aria-selected="true"]{background:color-mix(in srgb,var(--stage) 13%,transparent);border-color:color-mix(in srgb,var(--stage) 50%,transparent)}
  .gg-stage-ring{position:relative;width:50px;height:50px}
  .gg-stage-ring svg{width:100%;height:100%;transform:rotate(-90deg)}
  .gg-stage-ring circle{fill:none;stroke-width:3.8}
  .gg-ring-track{stroke:color-mix(in srgb,var(--stage) 22%,var(--bg-hover))}
  .gg-ring-fill{stroke:var(--stage);stroke-linecap:round}
  .gg-stage[aria-selected="true"] .gg-stage-ring svg{filter:drop-shadow(0 0 6px color-mix(in srgb,var(--stage) 55%,transparent))}
  .gg-stage-pct{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:12.5px;font-weight:800;color:var(--text-primary)}
  .gg-stage-label{margin-top:3px;font-size:11.5px;font-weight:700;color:var(--text-primary);white-space:nowrap}
  .gg-stage-sub{font-size:11px;color:var(--text-tertiary);white-space:nowrap}
  .gg-stage[aria-selected="true"] .gg-stage-sub{color:var(--text-secondary)}
  /* The picked stage's people */
  .gg-stage-detail{display:none;align-items:center;gap:10px;min-height:34px;padding:5px 10px;border-radius:9px;background:color-mix(in srgb,var(--stage) 9%,transparent);border-left:3px solid var(--stage);font-size:12px;color:var(--text-secondary)}
  .gg-community[data-stage="played"] [data-gg-stage-detail="played"],
  .gg-community[data-stage="completed"] [data-gg-stage-detail="completed"],
  .gg-community[data-stage="full"] [data-gg-stage-detail="full"]{display:flex}
  .gg-stage-who{min-width:0;line-height:1.4}
  .gg-stage-who a{color:var(--text-primary);font-weight:600;text-decoration:none}
  .gg-stage-who a:hover{color:var(--stage)}
  .gg-stage-none{color:var(--text-tertiary)}
  .gg-club-avatars{display:flex;flex-shrink:0}
  .gg-club-avatar.member-avatar{width:26px;height:26px;font-size:9px;border:2px solid var(--bg-hover);margin-left:-5px;text-decoration:none}
  .gg-club-avatar:first-child{margin-left:0}
  .gg-mini-head{font-size:11px;font-weight:700;color:var(--text-secondary);margin-bottom:4px}
  .gg-mini-head span{font-weight:500;color:var(--text-tertiary);margin-left:4px}
  /* Average time to each stage — the picked one lights up */
  .gg-ladder{display:flex;flex-direction:column;gap:2px}
  .gg-ladder-row{display:grid;grid-template-columns:64px minmax(0,1fr) 42px;align-items:center;gap:8px;width:100%;padding:2px 0;background:none;border:none;font-family:inherit;color:var(--text-tertiary);cursor:pointer;text-align:left}
  .gg-ladder-label{font-size:11px;font-weight:600}
  .gg-ladder-track{height:8px;border-radius:4px;background:color-mix(in srgb,var(--stage) 14%,var(--bg-hover));overflow:hidden}
  .gg-ladder-bar{display:block;height:100%;border-radius:4px;background:var(--stage);opacity:.4;transition:opacity .15s,width .3s}
  .gg-stage-full .gg-ladder-bar{background:linear-gradient(90deg,var(--plat-a),var(--plat-b))}
  .gg-ladder-val{font-size:13px;font-weight:800;text-align:right;color:var(--text-secondary)}
  .gg-ladder-row:hover .gg-ladder-bar{opacity:.7}
  .gg-community[data-stage="played"] .gg-ladder-row.gg-stage-played,
  .gg-community[data-stage="completed"] .gg-ladder-row.gg-stage-completed,
  .gg-community[data-stage="full"] .gg-ladder-row.gg-stage-full{color:var(--text-primary)}
  .gg-community[data-stage="played"] .gg-ladder-row.gg-stage-played .gg-ladder-bar,
  .gg-community[data-stage="completed"] .gg-ladder-row.gg-stage-completed .gg-ladder-bar,
  .gg-community[data-stage="full"] .gg-ladder-row.gg-stage-full .gg-ladder-bar{opacity:1}
  .gg-community[data-stage="played"] .gg-ladder-row.gg-stage-played .gg-ladder-val,
  .gg-community[data-stage="completed"] .gg-ladder-row.gg-stage-completed .gg-ladder-val,
  .gg-community[data-stage="full"] .gg-ladder-row.gg-stage-full .gg-ladder-val{color:var(--text-primary)}
  /* Ratings 1–10 and achievements */
  .gg-bottom{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:14px;padding-top:10px;border-top:1px solid var(--border)}
  /* Under the video it's a box of its own */
  .gg-media .gg-bottom{margin-top:10px;padding:10px 12px;border:1px solid var(--border-subtle);border-radius:12px;background:var(--bg-hover)}
  .gg-media{display:flex;flex-direction:column}
  .gg-dist-bars{display:flex;align-items:flex-end;gap:3px;height:30px;padding-bottom:14px;box-sizing:content-box}
  .gg-dist-bar{position:relative;flex:1;height:var(--h);min-height:3px;border-radius:3px 3px 1px 1px;box-shadow:none;cursor:default;outline:none;transition:filter .15s}
  .gg-dist-bar:not([class*="score-"]){background:var(--border)}
  :root[data-theme="dark"] .gg-dist-bar[class*="score-"]{background:currentColor}
  .gg-dist-bar[class*="score-"]{box-shadow:none}
  .gg-dist-n{position:absolute;left:0;right:0;bottom:-14px;text-align:center;font-size:9px;font-weight:600;color:var(--text-tertiary)}
  .gg-dist-bar:hover,.gg-dist-bar:focus-visible{filter:brightness(1.25)}
  .gg-dist-bar:hover::after,.gg-dist-bar:focus-visible::after{content:attr(data-tip);position:absolute;bottom:calc(100% + 6px);left:50%;transform:translateX(-50%);white-space:nowrap;padding:4px 8px;border-radius:6px;background:var(--text-primary);color:var(--bg);font-size:11px;font-weight:600;z-index:5;pointer-events:none}
  .gg-ach-val{font-size:18px;font-weight:800;color:var(--text-primary);line-height:1.1}
  .gg-ach-val small{font-size:11px;font-weight:500;color:var(--text-tertiary);margin-left:6px}
  .gg-ach-track{height:8px;border-radius:4px;background:var(--border);overflow:hidden;margin-top:8px}
  .gg-ach-track span{display:block;height:100%;border-radius:4px;background:linear-gradient(90deg,var(--c-completed),var(--c-played))}
  /* Without a video: picker and people on the left, time and ratings on the right */
  .gg-split-solo .gg-community{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px 28px;align-items:start}
  .gg-split-solo .gg-section-label{grid-column:1/-1}
  .gg-split-solo .gg-stages{grid-column:1;grid-row:2}
  .gg-split-solo .gg-stage-detail{grid-column:1;grid-row:3}
  .gg-split-solo .gg-ladder{grid-column:2;grid-row:2;align-self:center}
  .gg-split-solo .gg-bottom{grid-column:2;grid-row:3}
  /* The question beside its top answers */
  .gg-poll{margin-top:14px;display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);border:1px solid var(--border);border-radius:12px;overflow:hidden}
  .gg-poll-ask.poll-item{padding:12px 14px;border-bottom:none;border-right:1px solid var(--border);background:var(--bg-hover)}
  .gg-poll-kicker{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--accent);margin-bottom:4px}
  .gg-poll-ask .poll-question{font-size:14px;line-height:1.35;margin-bottom:8px}
  .gg-poll-answers{padding:12px 14px;min-width:0}
  .gg-answers-empty{margin:6px 0 0;font-size:13px;color:var(--text-tertiary)}
  .gg-answer-actions-row{display:flex;align-items:center;gap:6px;margin-top:6px}
  .gg-upvote,.gg-reply-toggle{display:inline-flex;align-items:center;gap:5px;height:24px;padding:0 9px;border-radius:12px;border:1px solid var(--border);background:none;font-family:inherit;font-size:11px;font-weight:600;color:var(--text-secondary);cursor:pointer;transition:border-color .15s,color .15s,background .15s}
  .gg-upvote:hover:not(:disabled),.gg-reply-toggle:hover{border-color:var(--text-secondary);color:var(--text-primary)}
  .gg-upvote[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:#fff}
  .gg-upvote:disabled{cursor:default;opacity:.7}
  .gg-reply-toggle[aria-expanded="true"]{color:var(--text-primary);border-color:var(--text-secondary)}
  .gg-replies{margin-top:8px;padding-left:10px;border-left:2px solid var(--border)}
  .gg-replies[hidden]{display:none}
  .gg-reply-list{list-style:none;margin:0;padding:0}
  .gg-reply{display:flex;gap:8px;padding:5px 0}
  .gg-reply-avatar.member-avatar{width:22px;height:22px;font-size:9px;text-decoration:none}
  .gg-reply .gg-answer-body{font-size:12px}
  .gg-reply-form{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
  .gg-reply-form .gg-input{flex:1;min-width:0;padding:6px 10px;font-size:12px}
  .gg-reply-form .gg-error{flex-basis:100%}
  .gg-more-answers{margin-top:8px;padding:0;background:none;border:none;font-family:inherit;font-size:12px;font-weight:600;color:var(--accent);cursor:pointer}
  .gg-more-answers:hover{text-decoration:underline}
  .gg-answer-list[hidden]{display:none}
  @media (max-width:700px){
    .gg-hero{padding:14px 14px 12px}
    .gg-hero-inner{gap:14px;align-items:flex-start}
    .gg-cover{width:68px;height:91px}
    .gg-hero-text{padding-right:0}
    .gg-game-title{font-size:19px}
    .gg-hero-actions{gap:8px;margin-top:12px}
    .gg-review-btn,.gg-ghost-btn{padding:6px 12px;font-size:12px}
    .gg-game-btn{display:none}  /* the title already links to the game */
    .gg-score{order:3;width:100%;flex-direction:row;align-items:center;gap:14px;padding:10px 12px}
    .gg-score-num{min-width:56px;height:44px;font-size:23px;border-radius:10px}
    .gg-score-text{align-items:flex-start;text-align:left}
    .gg-hero-inner{flex-wrap:wrap}
    .gg-body{padding:0 14px 14px}
    .gg-split{grid-template-columns:minmax(0,1fr)}
    .gg-poll{grid-template-columns:minmax(0,1fr)}
    .gg-poll-ask.poll-item{border-right:none;border-bottom:1px solid var(--border)}
    .gg-split-solo .gg-community{display:flex}
    .gg-bottom{grid-template-columns:minmax(0,1fr)}
    .gg-head{flex-direction:column}
  }

  /* ── Overview showcases (like a profile's): Customize to reorder / hide ── */
  .ov-customize-row{display:flex;justify-content:flex-end;margin:-4px 0 10px}
  .ov-customize-btn{display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:20px;border:1px solid var(--border);background:var(--bg-card);color:var(--text-secondary);font-family:inherit;font-size:12px;font-weight:600;cursor:pointer;transition:border-color .15s,color .15s}
  .ov-customize-btn:hover{border-color:var(--accent);color:var(--accent)}
  body.editing-overview .ov-customize-row{display:none}
  .edit-mode-bar{display:none;position:sticky;top:54px;z-index:25;background:var(--bg-card);border:1px solid var(--border);border-radius:12px;margin-bottom:14px;padding:10px 16px;align-items:center;justify-content:space-between;gap:12px;backdrop-filter:blur(12px)}
  body.editing-overview .edit-mode-bar{display:flex}
  .edit-mode-label{font-size:13px;font-weight:600;color:var(--accent);display:flex;align-items:center;gap:8px}
  .edit-mode-dot{width:7px;height:7px;border-radius:50%;background:var(--accent);animation:pulse2 1.5s infinite}
  @keyframes pulse2{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(.85)}}
  .edit-save-btn{padding:7px 18px;border-radius:20px;font-size:13px;font-weight:600;font-family:inherit;cursor:pointer;border:none;background:var(--accent);color:white;transition:opacity .15s}
  .edit-save-btn:hover{opacity:.88}
  .edit-save-btn:disabled{opacity:.5;cursor:not-allowed}
  .edit-cancel-btn{padding:7px 14px;border-radius:20px;font-size:13px;font-weight:500;font-family:inherit;cursor:pointer;border:1px solid var(--border);background:none;color:var(--text-secondary);transition:all .15s}
  .edit-cancel-btn:hover{border-color:var(--text-tertiary)}
  .sc-stack{display:flex;flex-direction:column;gap:14px;margin-bottom:14px}
  .sc-stack .card{margin-bottom:0}
  /* A section with nothing to show (no data yet) takes no space outside Customize */
  body:not(.editing-overview) .sc-section:not(:has(> :not(.sc-edit-bar))){display:none}
  body.editing-overview .sc-section:not(:has(> :not(.sc-edit-bar)))::after{content:"Nothing to show yet";display:block;padding:10px 12px;border:1px dashed var(--border);border-radius:10px;font-size:12px;color:var(--text-tertiary)}
  .sc-edit-bar{display:none;align-items:center;gap:10px;padding:6px 6px 6px 12px;margin-bottom:8px;border:1px dashed color-mix(in srgb,var(--accent) 45%,var(--border));border-radius:10px;background:var(--accent-subtle)}
  body.editing-overview .sc-edit-bar{display:flex}
  .sc-edit-label{flex:1;min-width:0;display:flex;align-items:center;gap:8px;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--text-secondary)}
  .sc-hidden-badge{display:none;font-size:10px;letter-spacing:.04em;padding:2px 7px;border-radius:999px;background:var(--tag-bg);color:var(--text-tertiary)}
  .sc-edit-actions{display:flex;align-items:center;gap:4px}
  .sc-move-btn{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;padding:0;border:1px solid var(--border);border-radius:8px;background:var(--bg-card);color:var(--text-secondary);cursor:pointer;transition:color .15s,border-color .15s}
  .sc-move-btn:hover:not(:disabled){color:var(--accent);border-color:var(--accent)}
  .sc-move-btn:disabled{opacity:.35;cursor:default}
  .sc-toggle-btn{height:28px;padding:0 12px;margin-left:4px;border:1px solid var(--border);border-radius:8px;background:var(--bg-card);color:var(--text-primary);font:inherit;font-size:12px;font-weight:600;cursor:pointer;transition:border-color .15s,filter .15s}
  .sc-toggle-btn:hover{border-color:var(--text-tertiary)}
  .sc-move-btn:focus-visible,.sc-toggle-btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .sc-toggle-show{display:none}
  .sc-is-hidden .sc-toggle-hide{display:none}
  .sc-is-hidden .sc-toggle-show{display:inline}
  .sc-is-hidden .sc-toggle-btn{background:var(--accent);border-color:var(--accent);color:var(--accent-text)}
  .sc-is-hidden .sc-toggle-btn:hover{filter:brightness(1.1)}
  .sc-is-hidden .sc-hidden-badge{display:inline-block}
  .sc-section.sc-is-hidden{display:none}
  body.editing-overview .sc-section.sc-is-hidden{display:block}
  body.editing-overview .sc-is-hidden > :not(.sc-edit-bar){opacity:.4;filter:grayscale(.7);pointer-events:none;user-select:none}
  .fav-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:28px;text-align:center;gap:10px;cursor:pointer;transition:background .15s;border-radius:14px;text-decoration:none;color:inherit}
  .fav-empty:hover{background:var(--bg-hover)}
  .fav-empty-icon{width:44px;height:44px;border-radius:12px;background:var(--tag-bg);border:1px dashed var(--border);display:flex;align-items:center;justify-content:center;font-size:20px;transition:border-color .15s}
  .fav-empty:hover .fav-empty-icon{border-color:var(--accent)}
  .fg-change-btn{background:none;border:none;cursor:pointer;font-size:10px;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:.1em;font-family:inherit}
  /* Now featuring — styled like a profile's favorite game */
  .nf-card{position:relative;overflow:hidden;min-height:176px;border-radius:14px;border:1px solid var(--border);background:var(--bg-card)}
  .nf-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 20%;display:block;opacity:.45;border:none;border-radius:0}
  .nf-overlay{position:absolute;inset:0;background:linear-gradient(to bottom,transparent 10%,rgba(13,13,15,.96) 78%)}
  .nf-content{position:relative;display:flex;gap:16px;align-items:flex-end;padding:16px;min-height:176px;box-sizing:border-box}
  .nf-cover{width:68px;height:91px;border-radius:9px;object-fit:cover;border:1px solid rgba(96,80,200,.4);box-shadow:0 4px 20px rgba(0,0,0,.8);flex-shrink:0;display:block;background:var(--tag-bg)}
  .nf-info{flex:1;min-width:0}
  .nf-label{display:flex;align-items:center;gap:6px;font-size:9px;font-weight:700;color:#c4b5fd;text-transform:uppercase;letter-spacing:.14em;margin-bottom:4px}
  .nf-live-dot{width:6px;height:6px;border-radius:50%;background:#c4b5fd;box-shadow:0 0 0 3px rgba(196,181,253,.25)}
  .nf-title{display:block;font-size:20px;font-weight:800;letter-spacing:-.3px;line-height:1.15;color:#f0ede8;text-decoration:none;margin-bottom:4px}
  .nf-title:hover{color:#fff;text-decoration:none}
  .nf-blurb{font-size:12px;color:rgba(240,237,232,.7);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:6px}
  .nf-stats{display:flex;flex-wrap:wrap;gap:4px 12px;font-size:12px;color:rgba(240,237,232,.65)}
  .nf-stats strong{color:#f0ede8;font-weight:700}
  .nf-cta{display:inline-block;margin-top:8px;font-size:12px;font-weight:600;color:#c4b5fd;text-decoration:none}
  .nf-cta:hover{color:#ddd6fe;text-decoration:none}
  .nf-score{flex-shrink:0;display:flex;align-items:center;justify-content:center;min-width:52px;height:46px;padding:0 8px;border-radius:12px;font-size:21px;font-weight:800;text-decoration:none}
  @media (max-width:560px){.nf-cover{width:54px;height:72px}.nf-title{font-size:17px}.nf-score{min-width:44px;height:40px;font-size:18px}}
  /* Video showcase — the same as a profile's */
  .vs-label{display:inline-flex;align-items:center;gap:7px}
  .vs-live-dot{width:7px;height:7px;border-radius:50%;background:#ff0033;box-shadow:0 0 0 3px color-mix(in srgb,#ff0033 25%,transparent)}
  .vs-player{position:relative;display:block;width:100%;aspect-ratio:16/9;padding:0;border:0;border-radius:12px;overflow:hidden;background:var(--bg-hover);cursor:pointer}
  .vs-player img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .3s ease,filter .2s;border:none;border-radius:0}
  .vs-player:hover img{transform:scale(1.02);filter:brightness(.85)}
  .vs-player:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .vs-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:64px;height:44px;border-radius:12px;background:rgba(15,15,15,.8);color:#fff;display:flex;align-items:center;justify-content:center;transition:background .15s}
  .vs-player:hover .vs-play{background:#ff0033}
  .vs-duration{position:absolute;right:8px;bottom:8px;font-size:12px;font-weight:600;color:#fff;background:rgba(0,0,0,.8);padding:2px 6px;border-radius:4px}
  .vs-duration[hidden]{display:none}
  .vs-player--playing{cursor:default}
  .vs-player--playing iframe{width:100%;height:100%;border:0;display:block}
  .vs-body[data-state="loading"] .vs-player{animation:vs-pulse 1.4s ease-in-out infinite}
  .vs-body[data-state="loading"] .vs-play{opacity:.4}
  @keyframes vs-pulse{50%{opacity:.6}}
  .vs-info{display:flex;flex-direction:column;gap:3px;margin-top:12px;text-decoration:none;color:inherit}
  .vs-title{font-size:15px;font-weight:600;color:var(--text-primary);line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .vs-info:hover .vs-title{color:var(--accent)}
  .vs-meta{font-size:12px;color:var(--text-tertiary)}
  .vs-meta:empty{display:none}
  .vs-unavailable{font-size:13px;color:var(--text-secondary);padding:14px;background:var(--bg-hover);border:1px dashed var(--border);border-radius:12px;line-height:1.5}
  .vs-unavailable[hidden],.vs-body[hidden]{display:none}
  .vs-inline-link{background:none;border:none;padding:0;font:inherit;color:var(--accent);cursor:pointer;text-decoration:underline;text-underline-offset:2px}
  .modal-backdrop{display:none;position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.7);backdrop-filter:blur(8px);align-items:center;justify-content:center;padding:20px}
  .modal-backdrop.open{display:flex}
  .modal{background:var(--bg-card);border:1px solid var(--border);border-radius:20px;width:100%;max-width:520px;max-height:80vh;display:flex;flex-direction:column;box-shadow:0 24px 80px rgba(0,0,0,.8)}
  .modal-header{padding:20px 20px 0;display:flex;align-items:center;justify-content:space-between}
  .modal-title{font-size:19px;font-weight:700;letter-spacing:-.2px}
  .modal-close{background:none;border:none;cursor:pointer;color:var(--text-tertiary);padding:6px;display:flex;transition:color .15s;font-size:20px;line-height:1}
  .modal-close:hover{color:var(--text-primary)}
  .modal-search-input{width:100%;box-sizing:border-box;background:var(--bg-hover);border:1px solid var(--border);border-radius:10px;padding:10px 14px;font-size:14px;font-family:inherit;color:var(--text-primary);outline:none;transition:border-color .15s}
  .modal-search-input:focus{border-color:var(--accent)}
  .vsm-body{padding:8px 20px 4px;display:flex;flex-direction:column;gap:10px}
  .vsm-option{display:flex;gap:12px;align-items:flex-start;padding:14px;border:1px solid var(--border);border-radius:12px;cursor:pointer;transition:border-color .15s,background .15s}
  .vsm-option:hover{border-color:color-mix(in srgb,var(--accent) 50%,var(--border))}
  .vsm-option:has(input[type=radio]:checked){border-color:var(--accent);background:var(--accent-subtle)}
  .vsm-option input[type=radio]{accent-color:var(--accent);margin-top:3px;flex-shrink:0}
  .vsm-option--disabled{cursor:default;opacity:.75}
  .vsm-option--disabled:hover{border-color:var(--border)}
  .vsm-option-text{display:flex;flex-direction:column;gap:2px;flex:1;min-width:0}
  .vsm-option-title{font-size:14px;font-weight:600;color:var(--text-primary)}
  .vsm-option-desc{font-size:12px;color:var(--text-secondary);line-height:1.45}
  .vsm-url{margin-top:8px;font-size:13px;padding:9px 12px}
  .vsm-error{font-size:13px;color:#f87171}
  .vsm-error[hidden]{display:none}
  .vsm-footer{display:flex;justify-content:flex-end;gap:8px;padding:14px 20px 18px}
  .vsm-btn{font-family:inherit;font-size:13px;font-weight:600;padding:8px 16px;border-radius:10px;border:1px solid var(--border);background:var(--bg-card);color:var(--text-primary);cursor:pointer}
  .vsm-btn:hover{border-color:var(--accent)}
  .vsm-btn--primary{background:var(--accent);border-color:var(--accent);color:var(--accent-text)}
  .vsm-btn--primary:hover{filter:brightness(1.1)}
  .vsm-btn:disabled{opacity:.6;cursor:default}
</style>

<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet" />

<DetailNav isLoggedIn={!!user} currentProfile={currentProfile} />

<!-- Banner -->
<div class="group-banner" id="groupBanner" style={bannerStyle}>
  {!group.banner_url && <div class="banner-glow"></div>}
  {!group.banner_url && <div class="banner-glow2"></div>}
  <button class="banner-edit-btn" onclick="document.getElementById('bannerInput').click()">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>
    Change banner
  </button>
  <div id="bannerUploading" style="display:none;position:absolute;inset:0;background:rgba(0,0,0,.5);align-items:center;justify-content:center;gap:10px;z-index:3">
    <div class="spinner" style="width:20px;height:20px"></div>
    <span style="font-size:13px;color:white;font-weight:500">Uploading…</span>
  </div>
  <input type="file" id="bannerInput" accept="image/jpeg,image/png,image/webp,image/gif" style="display:none" />
</div>

<!-- Group header -->
<div class="group-header">
  <div class="group-avatar-wrap">
    <div class="group-avatar-container" id="avatarContainer">
      <div class="group-avatar-sq" id="avatarEl">
        {group.avatar_url
          ? <img src={group.avatar_url} alt={group.name} id="avatarImg" />
          : <span>{getInitials(group.name)}</span>
        }
      </div>
      <div class="group-avatar-edit" id="avatarOverlay" onclick="document.getElementById('avatarInput').click()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>
        <span>Change</span>
      </div>
      <div id="avatarUploading" style="display:none;position:absolute;inset:0;border-radius:20px;background:rgba(0,0,0,.7);align-items:center;justify-content:center">
        <div class="spinner"></div>
      </div>
      <input type="file" id="avatarInput" accept="image/jpeg,image/png,image/webp" style="display:none" />
    </div>
  </div>

  <div class="group-info-row">
    <div class="group-left">
      <h1 class="group-name">{group.name}</h1>
      {group.description && <p class="group-desc">{group.description}</p>}
      <div class="group-meta-badges">
        <span class="badge">{group.visibility}</span>
        {group.visibility === "public" && group.requires_approval && <span class="badge">Application required</span>}
        {membership && <span class="badge badge-accent">{membership.role}</span>}
        {isSiteAdminGuest && <span class="badge badge-accent">site admin</span>}
        {focusLabel && <span class="badge" style="background:rgba(96,80,200,.12);color:var(--accent)">🎯 {focusLabel}</span>}
      </div>
    </div>

    <div class="group-actions">
      <ShareButton url={sharePath} />
      {/* Not logged in — signup/signin carry the group through (utils/groupJoin) */}
      {!user && canJoinDirectly && (
        <a href={`/signup${authQuery}`} class="btn-primary">Sign up to join</a>
      )}
      {!user && !canJoinDirectly && (
        <a href={`/signup${authQuery}`} class="btn-primary">Sign up to request access</a>
      )}
      {!user && (
        <a href={`/signin${authQuery}`} class="signin-link">Have an account? Sign in</a>
      )}

      {/* Logged in, not a member */}
      {user && !isMember && pendingInvite && (
        <button class="btn-primary" id="accept-invite-btn" onclick="acceptInvite()">Accept Invite</button>
      )}
      {user && !isMember && !pendingInvite && !needsApproval && (
        <button class="btn-primary" id="join-btn" onclick="joinGroup()">Join Group</button>
      )}
      {user && !isMember && !pendingInvite && group.visibility === "private" && joinCode && (
        <button class="btn-primary" id="join-btn" onclick="joinGroupByCode()">Join via Invite</button>
      )}
      {user && !isMember && needsApproval && !joinCode && existingJoinRequest?.status === "pending" && (
        <span class="badge-pending-action">Request pending</span>
      )}
      {user && !isMember && needsApproval && !joinCode && !existingJoinRequest && (
        <button class="btn-primary" id="join-request-btn" onclick="openJoinRequestForm()">Request to Join</button>
      )}
      {user && !isMember && needsApproval && !joinCode && existingJoinRequest?.status === "rejected" && (
        <button class="btn-primary" id="join-request-btn" onclick="openJoinRequestForm()">Request Again</button>
      )}

      {/* Members */}
      {isAdminOrOwner && (
        <a href={`/groups/${group.id}/settings`} class="btn-ghost">Settings</a>
      )}
      {/* Nobody leaves the site group (src/utils/siteGroup.ts) */}
      {isMember && !isOwner && !group.is_site_group && (
        <button class="btn-ghost" id="leave-btn" onclick="leaveGroup()">Leave</button>
      )}
      {/* Same style as the "Since" date on a reviewer's profile */}
      <div class="group-since">Since {createdDate}</div>
    </div>

    {/* Join request form — shown inline below actions when opened */}
    {/* Renders for: no prior request, OR a rejected request (allowing re-application) */}
    {user && !isMember && needsApproval && !joinCode && (!existingJoinRequest || existingJoinRequest?.status === "rejected") && (
      <div id="join-request-form" style="display:none;margin-top:14px;padding:16px 20px;background:var(--bg-card);border:1px solid var(--border);border-radius:14px;max-width:420px">
        <div style="font-size:13px;font-weight:600;margin-bottom:8px">Request to join {group.name}</div>
        {group.join_prompt && (
          <div style="font-size:13px;color:var(--text-secondary);background:var(--bg-hover);padding:10px 12px;border-radius:8px;border-left:2px solid var(--accent);margin-bottom:10px;line-height:1.5">{group.join_prompt}</div>
        )}
        <textarea id="join-request-msg" placeholder={group.join_prompt ? "Your response…" : "Add a message (optional)"} style="width:100%;padding:8px 10px;border-radius:8px;border:1px solid var(--border);background:var(--bg-input,var(--bg-card));color:var(--text-primary);font-size:13px;font-family:inherit;resize:vertical;min-height:68px;outline:none" maxlength="300"></textarea>
        <div style="display:flex;gap:8px;margin-top:10px">
          <button class="btn-primary" id="submit-request-btn" onclick="submitJoinRequest()" style="font-size:13px;padding:8px 18px">Send Request</button>
          <button onclick="closeJoinRequestForm()" style="background:none;border:none;cursor:pointer;font-size:13px;color:var(--text-tertiary);font-family:inherit">Cancel</button>
        </div>
        <div id="join-request-err" style="font-size:12px;color:#f87171;margin-top:6px;display:none"></div>
      </div>
    )}
  </div>
</div>

<!-- Main content -->
<div class="page">

  {/* Private group wall for non-members without a valid invite code */}
  {group.visibility === "private" && !canViewPrivate && (
    <div style="max-width:480px;margin:48px auto;padding:0 20px;text-align:center">
      <div style="font-size:40px;margin-bottom:16px">🔒</div>
      <div style="font-family:'DM Serif Display',serif;font-size:22px;margin-bottom:8px">{group.name} is private</div>
      <p style="font-size:14px;color:var(--text-secondary);line-height:1.6;margin-bottom:0">
        {existingJoinRequest?.status === "pending"
          ? "Your join request is pending review by the group admins."
          : existingJoinRequest?.status === "rejected"
          ? "Your previous request was not approved. You can send another request."
          : "This group is invite-only. You can request to join and an admin will review your request."}
      </p>
    </div>
  )}

  {/* Full tab nav — only shown to members or non-private groups */}
  {(canSeeMemberContent || group.visibility !== "private") && (
  <nav class="tab-nav">
    <a href={`/groups/${group.id}?tab=overview`} class={`tab-link${activeTab === "overview" ? " active" : ""}`}>Overview</a>
    {statsConf.show_score_compare && (
    <a href={`/groups/${group.id}?tab=compare`} class={`tab-link${activeTab === "compare" ? " active" : ""}`}>
      Stats
    </a>
    )}
    {showGames && (
    <a href={`/groups/${group.id}?tab=games`} class={`tab-link${activeTab === "games" ? " active" : ""}`}>
      Games {(featuredCount ?? 0) > 0 && <span class="tab-count">{featuredCount}</span>}
    </a>
    )}
    <a href={`/groups/${group.id}?tab=feed`} class={`tab-link${activeTab === "feed" ? " active" : ""}`}>Feed</a>
    {showSessions && (
    <a href={`/groups/${group.id}?tab=sessions`} class={`tab-link${activeTab === "sessions" ? " active" : ""}`}>
      Sessions {(sessionsData ?? []).length > 0 && <span class="tab-count">{(sessionsData ?? []).length}</span>}
    </a>
    )}
    <a href={`/groups/${group.id}?tab=members`} class={`tab-link${activeTab === "members" ? " active" : ""}`}>
      Members {memberList.length > 0 && <span class="tab-count">{memberList.length}</span>}
    </a>
  </nav>

  <!-- Feed tab -->
  <div class={`tab-panel${activeTab === "feed" ? " active" : ""}`} id="tab-feed">
    {/* The filters and Load more swap this container — src/scripts/group-feed.ts */}
    <div id="feed-panel">
      {feedData && (
        <FeedTab data={feedData} groupId={group.id} isLoggedIn={!!user} />
      )}
    </div>
  </div>

  <!-- Overview tab -->
  <div class={`tab-panel${activeTab === "overview" ? " active" : ""}`} id="tab-overview">
    {canEditOverview && (
      <>
        <div class="ov-customize-row">
          <button type="button" class="ov-customize-btn" onclick="enterOverviewEdit()">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
            Customize
          </button>
        </div>
        <div class="edit-mode-bar" id="overviewEditBar">
          <div class="edit-mode-label">
            <div class="edit-mode-dot"></div>
            Customizing overview — move or hide sections
          </div>
          <div style="display:flex;gap:8px">
            <button class="edit-cancel-btn" onclick="cancelOverviewEdit()">Cancel</button>
            <button class="edit-save-btn" id="saveOverviewBtn" onclick="saveOverview()">Save changes</button>
          </div>
        </div>
      </>
    )}
    <div class="two-col">
      <!-- Left: top games + podium -->
      <div>
        {/* SHOWCASES — in the saved order; reordered/hidden in Customize (src/utils/groupShowcases.ts) */}
        <div class="sc-stack" id="showcaseStack">
        {overviewMain.map((key) => (
          key === "now_featuring" ? (
            <ShowcaseSection section="now_featuring" label={groupShowcaseLabel("now_featuring")} hidden={overviewHidden.has("now_featuring")} isOwner={canEditOverview}>
              {nowFeaturing ? (
                <div class="nf-card">
                  {nowFeaturing.game.cover_img_url && <img class="nf-bg" src={igdbCover(nowFeaturing.game.cover_img_url, "t_screenshot_big")!} alt="" />}
                  <div class="nf-overlay"></div>
                  <div class="nf-content">
                    <a href={`/games/${nowFeaturing.game.slug}`}>
                      {nowFeaturing.game.cover_img_url
                        ? <img class="nf-cover" src={igdbCover(nowFeaturing.game.cover_img_url)!} alt={nowFeaturing.game.title} />
                        : <div class="nf-cover" />}
                    </a>
                    <div class="nf-info">
                      <div class="nf-label"><span class="nf-live-dot" aria-hidden="true"></span>Now featuring</div>
                      <a href={`/games/${nowFeaturing.game.slug}`} class="nf-title">{nowFeaturing.game.title}</a>
                      {nowFeaturing.note && <div class="nf-blurb">"{nowFeaturing.note}"</div>}
                      <div class="nf-stats">
                        {nowFeaturing.stats.played > 0
                          ? <>
                              <span><strong>{nowFeaturing.stats.played}</strong> played</span>
                              {nowFeaturing.stats.completedPct != null && <span><strong>{nowFeaturing.stats.completedPct}%</strong> finished</span>}
                              {nowFeaturing.stats.avgHours != null && <span><strong>{formatHours(nowFeaturing.stats.avgHours)}</strong> avg</span>}
                            </>
                          : <span>Be the first in the group to play it</span>}
                      </div>
                      <a class="nf-cta" href={`/groups/${group.id}?tab=games`}>See it on the Games tab →</a>
                    </div>
                    {nowFeaturing.stats.avgScore != null && (
                      <a class={`nf-score ${scoreClass(nowFeaturing.stats.avgScore)}`} href={`/groups/${group.id}?tab=feed&game=${nowFeaturing.game.id}`}
                        title={`Community rating from ${nowFeaturing.stats.reviewCount} review${nowFeaturing.stats.reviewCount === 1 ? "" : "s"}`}>
                        {formatScore(nowFeaturing.stats.avgScore)}
                      </a>
                    )}
                  </div>
                </div>
              ) : canEditOverview && statsConf.show_games ? (
                <div class="card">
                  <div class="card-title">Now featuring</div>
                  <a class="fav-empty" href={`/groups/${group.id}?tab=games`}>
                    <div class="fav-empty-icon">🎮</div>
                    <div style="font-size:14px;font-weight:500;color:var(--text-secondary)">Feature a game</div>
                    <div style="font-size:12px;color:var(--text-tertiary)">Your latest featured game shows here, with how the group did on it</div>
                  </a>
                </div>
              ) : null}
            </ShowcaseSection>
          ) :
          key === "video" ? (
            /* VIDEO — featured: id rendered here; latest: filled by JS from /api/groups/latest-video */
            <ShowcaseSection section="video" label={groupShowcaseLabel("video")} hidden={overviewHidden.has("video")} isOwner={canEditOverview}>
              {showcaseVideoMode ? (
                <div class="card" id="videoShowcaseCard" data-mode={showcaseVideoMode} data-video-id={showcaseVideoId ?? ""} data-group-id={group.id}>
                  <div class="card-title" style="display:flex;align-items:center;justify-content:space-between">
                    <span class="vs-label">
                      {showcaseVideoMode === "latest" && <span class="vs-live-dot" aria-hidden="true"></span>}
                      {showcaseVideoMode === "latest" ? "Latest video" : "Featured video"}
                    </span>
                    {canEditOverview && <button class="fg-change-btn" onclick="openVideoShowcasePicker()">Change</button>}
                  </div>
                  <div class="vs-body" data-state={showcaseVideoMode === "featured" ? "ready" : "loading"}>
                    <button type="button" class="vs-player" aria-label="Play video" onclick="playShowcaseVideo()">
                      {showcaseVideoId && <img src={`https://i.ytimg.com/vi/${showcaseVideoId}/hqdefault.jpg`} alt="" loading="lazy" />}
                      <span class="vs-play" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                      </span>
                      <span class="vs-duration" hidden></span>
                    </button>
                    <a class="vs-info" href={showcaseVideoId ? `https://www.youtube.com/watch?v=${showcaseVideoId}` : (videoOwner?.youtubeUrl ?? "#")} target="_blank" rel="noopener noreferrer">
                      <span class="vs-title">{showcaseVideoMode === "latest" ? "Loading latest upload…" : "YouTube video"}</span>
                      <span class="vs-meta"></span>
                    </a>
                  </div>
                  <div class="vs-unavailable" hidden>
                    {canEditOverview
                      ? <>We couldn’t find any uploads on the owner’s YouTube channel. <button type="button" class="vs-inline-link" onclick="openVideoShowcasePicker()">Feature a specific video</button> instead?</>
                      : "No videos yet."}
                  </div>
                </div>
              ) : canEditOverview ? (
                <div class="card">
                  <div class="card-title">Video</div>
                  <div class="fav-empty" onclick="openVideoShowcasePicker()">
                    <div class="fav-empty-icon">🎬</div>
                    <div style="font-size:14px;font-weight:500;color:var(--text-secondary)">Showcase a video</div>
                    <div style="font-size:12px;color:var(--text-tertiary)">Feature a favorite or always show the latest upload</div>
                  </div>
                </div>
              ) : null}
            </ShowcaseSection>
          ) :
          key === "announcements" ? (
            <ShowcaseSection section="announcements" label={groupShowcaseLabel("announcements")} hidden={overviewHidden.has("announcements")} isOwner={canEditOverview}>
          {canSeeMemberContent && (
            <div class="card">
              <div class="card-title" style="display:flex;align-items:center;justify-content:space-between">
                <span>Announcements</span>
                {isAdminOrOwner && (
                  <button onclick="toggleAnnouncementForm()" style="background:none;border:none;cursor:pointer;color:var(--accent);font-size:11px;font-family:inherit;font-weight:600;padding:0">+ New</button>
                )}
              </div>

              {isAdminOrOwner && (
                <div id="announcement-form" class="compose-form" style="display:none">
