          }
          {(watchlistData ?? []).length > 8 && (
            <div style="font-size:12px;color:var(--text-tertiary);padding-top:8px;text-align:center">+{(watchlistData ?? []).length - 8} more</div>
          )}
        </div>}

        <!-- Members -->
        <div class="card">
          <div class="card-title" style="display:flex;align-items:center;justify-content:space-between">
            <span>Members</span>
            {isAdminOrOwner && (
              <button onclick="openInvitePanel()" style="background:none;border:none;cursor:pointer;color:var(--accent);font-size:11px;font-family:inherit;font-weight:600;padding:0">+ Invite</button>
            )}
