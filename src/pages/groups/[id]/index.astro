              </div>
            )}
            {(activityReviews ?? []).length > 5 && (
              <button id="see-more-reviews-btn" data-label={`See ${(activityReviews ?? []).length - 5} more`} onclick="toggleMoreReviews()" style="display:block;width:100%;margin-top:8px;padding:6px;border:none;border-radius:8px;background:var(--tag-bg);color:var(--accent);font-size:12px;font-weight:600;font-family:inherit;cursor:pointer;text-align:center">
