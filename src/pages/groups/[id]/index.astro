          {isAdminOrOwner && (
            <div id="invite-panel" style="display:none;margin-bottom:12px">
              {group.invite_code && (
                <div class="invite-url-row" style="margin-bottom:8px">
                  <input class="invite-url-input" id="invite-url-field" type="text" readonly value={inviteUrl ?? ""} />
                  <button class="btn-copy" onclick="copyInvite()" style="font-size:11px;padding:6px 10px">Copy</button>
                </div>
              )}
              <div class="invite-send-row">
                <input id="invite-username-input" class="invite-user-input" style="font-size:12px;padding:6px 10px" type="text" placeholder="@username" />
                <button id="invite-send-btn" class="btn-copy" onclick="sendInvite()" style="font-size:11px;padding:6px 10px;opacity:0.45;cursor:default" disabled>Send</button>
              </div>
              <div id="invite-msg" style="font-size:11px;color:var(--text-tertiary);margin-top:5px;"></div>
            </div>
          )}

          {/* Pending join requests — admins/owners only, private groups */}
          {isAdminOrOwner && group.visibility === "private" && pendingJoinRequests.length > 0 && (
            <div style="margin-bottom:14px;padding-bottom:14px;border-bottom:1px solid var(--border-subtle)">
              <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-tertiary);margin-bottom:8px">
                Join Requests ({pendingJoinRequests.length})
              </div>
              {pendingJoinRequests.map((jr: any) => (
                <div class="member-item" style="align-items:flex-start;gap:10px;padding:8px 0" data-jr-id={jr.id}>
                  <div class="member-avatar" style="flex-shrink:0">
                    {jr.profiles?.avatar_url
                      ? <img src={jr.profiles.avatar_url} alt={jr.profiles?.username} />
                      : getInitials(jr.profiles?.username ?? "?")}
                  </div>
                  <div style="flex:1;min-width:0">
                    <div style="font-size:13px;font-weight:600">@{jr.profiles?.username}</div>
                    {jr.message && <div style="font-size:12px;color:var(--text-secondary);margin-top:2px;line-height:1.4">{jr.message}</div>}
                  </div>
                  <div style="display:flex;gap:6px;flex-shrink:0">
                    <button onclick={`respondJoinRequest('${jr.id}', 'accept')`} style="background:var(--accent);color:#fff;border:none;padding:5px 10px;border-radius:12px;font-size:11px;font-weight:600;font-family:inherit;cursor:pointer">Accept</button>
                    <button onclick={`respondJoinRequest('${jr.id}', 'reject')`} style="background:var(--tag-bg);color:var(--text-secondary);border:none;padding:5px 10px;border-radius:12px;font-size:11px;font-weight:600;font-family:inherit;cursor:pointer">Reject</button>
                  </div>
                </div>
              ))}
            </div>
          )}

          {memberList.map((m: any) => (
            <div class="member-item" data-profile-id={m.id}>
              <div class="member-avatar">
                {m.avatar_url
                  ? <img src={m.avatar_url} alt={m.username} />
                  : getInitials(m.username)
                }
              </div>
              <a class="member-name" href={`/reviewers/${m.username}`} style="color:inherit;text-decoration:none">@{m.username}</a>
              {memberCustomRoles[m.id] && roleMap[memberCustomRoles[m.id]!]
                ? <span class="member-role-tag" style={`background:${roleMap[memberCustomRoles[m.id]!].color}22;color:${roleMap[memberCustomRoles[m.id]!].color};border:1px solid ${roleMap[memberCustomRoles[m.id]!].color}44`}>{roleMap[memberCustomRoles[m.id]!].name}</span>
                : <span class={`member-role-tag${m.role === "owner" ? " owner" : ""}`}>{m.role}</span>
              }
              {isAdminOrOwner && currentProfile && m.id !== currentProfile.id && m.role !== "owner" && (
                <div class="member-actions-row">
                  {isOwner && (
                    <button class="btn-xs btn-xs-ghost" onclick={`updateRole('${m.id}','${m.role === "admin" ? "member" : "admin"}')`}>
                      {m.role === "admin" ? "Demote" : "Admin"}
                    </button>
                  )}
                  <button class="btn-xs btn-xs-danger" onclick={`removeMember('${m.id}')`}>Remove</button>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Stats tab -->
  {statsConf.show_score_compare && <div class={`tab-panel${activeTab === "compare" ? " active" : ""}`} id="tab-compare">
    <div class="stats-section-header">
      <span>Score Comparison</span>
      <span class="stats-section-count">{sharedGames.length} shared game{sharedGames.length !== 1 ? "s" : ""}</span>
    </div>
    {sharedGames.length === 0
      ? <div class="empty-tab">No games reviewed by 2 or more members yet.</div>
      : sharedGames.map((g: any) => {
          const scores = g.reviews.map((r: any) => r.score);
          const variance = scores.length > 1 ? Math.max(...scores) - Math.min(...scores) : 0;
          const varClass = variance >= 5 ? "variance-high" : variance >= 3 ? "variance-mid" : "variance-low";
          const varLabel = variance >= 5 ? "Divisive" : variance >= 3 ? "Mixed" : "Consensus";
          return (
            <div class="compare-game">
              <div class="compare-header">
                {igdbCover(g.game.cover_img_url, "t_thumb")
                  ? <img class="compare-cover" src={igdbCover(g.game.cover_img_url, "t_thumb")!} alt={g.game.title} />
                  : <div class="compare-cover" />
                }
                <a class="compare-title" href={`/games/${g.game.slug}`} style="color:inherit">{g.game.title}</a>
                <span class={`variance-tag ${varClass}`}>{varLabel}</span>
              </div>
              <div class="compare-scores">
                {memberList.map((m: any) => {
                  const rev = g.reviews.find((r: any) => r.profile_id === m.id);
                  return (
                    <div class="compare-score-item">
                      <span class="compare-username">@{m.username}</span>
                      {rev
                        ? <div class={`score-badge ${scoreClass(rev.score)}`}>{rev.score}</div>
                        : <span style="font-size:12px;color:var(--text-tertiary);font-style:italic">—</span>
                      }
                    </div>
                  );
                })}
              </div>
            </div>
          );
        })
    }
  </div>}

  <!-- Sessions tab -->
  {statsConf.show_sessions && <div class={`tab-panel${activeTab === "sessions" ? " active" : ""}`} id="tab-sessions">
    {isMember && (
      <div class="log-form">
        <div class="log-form-title">Log a Game Night</div>
        <div class="log-row">
          <input id="session-game-input" class="log-input" type="text" placeholder="Game name…" />
          <input id="session-game-hidden" type="hidden" />
          <input id="session-date" class="log-input" type="date" value={new Date().toISOString().slice(0, 10)} style="max-width:160px" />
        </div>
        <input id="session-notes" class="log-input" type="text" placeholder="Notes (optional)" style="margin-top:8px;width:100%" />
        <div class="log-attendees" id="attendee-chips">
          {memberList.map((m: any) => (
            <button
              class={`attendee-toggle${m.id === currentProfile?.id ? " selected" : ""}`}
              data-profile-id={m.id}
              onclick="toggleAttendee(this)"
            >@{m.username}</button>
          ))}
        </div>
        <div style="margin-top:12px;display:flex;gap:8px;">
          <button class="btn-primary" onclick="logSession()" style="font-size:13px;padding:8px 16px">Log Session</button>
        </div>
        <div id="session-search-results" style="margin-top:8px;display:flex;flex-direction:column;gap:6px;"></div>
      </div>
    )}

    {(sessionsData ?? []).length === 0
      ? <div class="empty-tab">No game nights logged yet.</div>
      : (sessionsData ?? []).map((s: any) => {
          const attendees = (s.group_session_members ?? []).map((sm: any) => sm.profiles?.username).filter(Boolean);
          return (
            <div class="session-card" data-session-id={s.id}>
              <div class="session-header">
                {igdbCover(s.games?.cover_img_url, "t_thumb")
                  ? <img class="session-cover" src={igdbCover(s.games?.cover_img_url, "t_thumb")!} alt={s.games?.title} loading="lazy" />
                  : <div class="session-cover" />
                }
                <div style="flex:1;min-width:0">
                  <div class="session-game">
                    <a href={`/games/${s.games?.slug}`} style="color:inherit">{s.games?.title}</a>
                  </div>
                  <div class="session-date">{new Date(s.played_at).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</div>
                </div>
                {isMember && (
                  <button class="session-delete" onclick={`deleteSession('${s.id}')`}>Delete</button>
                )}
              </div>
              {s.notes && <div class="session-notes">{s.notes}</div>}
              <div class="session-attendees">
                {attendees.map((u: string) => <span class="attendee-chip">@{u}</span>)}
              </div>
            </div>
          );
        })
    }
  </div>}

  )} {/* end isMember || non-private tab nav */}

</div>

<script define:vars={{ groupDataJson, memberListJson, inviteUrl: isAdminOrOwner ? inviteUrl : null, isAdminOrOwner, groupId: group.id }}>
const groupData = JSON.parse(groupDataJson);
const memberList = JSON.parse(memberListJson);

// Mark body for admin-only CSS (banner/avatar edit buttons)
if (isAdminOrOwner) document.body.classList.add('group-admin');

// ── Avatar upload ──
document.getElementById('avatarInput')?.addEventListener('change', async (e) => {
  const file = e.target.files?.[0];
  if (!file) return;
  let uploadFile;
  try {
    const blob = await window.openImageCropper(file, { aspectRatio: 1, minWidth: 200, minHeight: 200, title: 'Crop Avatar' });
    uploadFile = new File([blob], 'avatar.' + (blob.type === 'image/png' ? 'png' : 'jpg'), { type: blob.type });
  } catch { e.target.value = ''; return; }
  const uploading = document.getElementById('avatarUploading');
  if (uploading) { uploading.style.display = 'flex'; }
  const form = new FormData();
  form.append('avatar', uploadFile);
  form.append('group_id', groupId);
  const res = await fetch('/api/groups/avatar', { method: 'POST', body: form });
  if (uploading) { uploading.style.display = 'none'; }
  if (res.ok) {
    const data = await res.json();
    const el = document.getElementById('avatarEl');
    if (el) el.innerHTML = `<img id="avatarImg" src="${data.url}" alt="" style="width:100%;height:100%;object-fit:cover" />`;
  }
  e.target.value = '';
});

// ── Banner upload ──
document.getElementById('bannerInput')?.addEventListener('change', async (e) => {
  const file = e.target.files?.[0];
  if (!file) return;
  if (file.size > 15 * 1024 * 1024) { alert('Banner must be under 15MB'); e.target.value = ''; return; }
  let uploadFile = file;
  let bannerPosition = 'center';
  const bannerEl = document.getElementById('groupBanner');
  const bannerAspect = bannerEl ? bannerEl.offsetWidth / bannerEl.offsetHeight : window.innerWidth / 280;
  if (file.type === 'image/gif') {
    const valid = await new Promise(res => {
      const img = new Image(), url = URL.createObjectURL(file);
      img.onload = () => { URL.revokeObjectURL(url); res(img.width >= 1200 && img.height >= 300); };
      img.onerror = () => { URL.revokeObjectURL(url); res(false); };
      img.src = url;
    });
    if (!valid) { alert('Banner must be at least 1200 × 300 px'); e.target.value = ''; return; }
    try {
      bannerPosition = await window.openGifPositioner(file, { aspectRatio: bannerAspect, title: 'Position GIF' });
    } catch { e.target.value = ''; return; }
  } else {
    try {
      const blob = await window.openImageCropper(file, { aspectRatio: bannerAspect, minWidth: 1200, minHeight: 300, title: 'Crop Banner' });
      uploadFile = new File([blob], 'banner.' + (blob.type === 'image/png' ? 'png' : 'jpg'), { type: blob.type });
    } catch { e.target.value = ''; return; }
  }
  const uploading = document.getElementById('bannerUploading');
  if (uploading) uploading.style.display = 'flex';
  try {
    const presignRes = await fetch('/api/groups/banner-presign', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ fileType: uploadFile.type, fileSize: uploadFile.size, groupId })
    });
    const presignData = await presignRes.json();
    if (!presignRes.ok) throw new Error(presignData.error ?? 'Presign failed');
    const uploadForm = new FormData();
    uploadForm.append('cacheControl', '3600');
    uploadForm.append('', uploadFile);
    const uploadRes = await fetch(presignData.signedUrl, {
      method: 'PUT',
      body: uploadForm,
      headers: { 'x-upsert': 'true' }
    });
    if (!uploadRes.ok) { const errText = await uploadRes.text(); throw new Error('Storage upload failed: ' + uploadRes.status + ' — ' + errText); }
    const saveRes = await fetch('/api/groups/banner-save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ path: presignData.path, banner_position: bannerPosition, groupId })
    });
    const data = await saveRes.json();
    if (!saveRes.ok) throw new Error(data.error ?? 'Save failed');
    const banner = document.getElementById('groupBanner');
    if (banner) {
      banner.style.backgroundImage = `url('${data.url}')`;
      banner.style.backgroundSize = 'cover';
      banner.style.backgroundPosition = bannerPosition;
      banner.querySelectorAll('.banner-glow,.banner-glow2').forEach(el => { el.style.display = 'none'; });
    }
  } catch (err) {
    alert(err?.message ?? 'Banner upload failed');
  } finally {
    if (uploading) uploading.style.display = 'none';
  }
  e.target.value = '';
});

// ── Join / Leave ──
async function acceptInvite() {
  const btn = document.getElementById('accept-invite-btn');
  if (btn) { btn.disabled = true; btn.style.opacity = '0.6'; }
  const res = await fetch('/api/groups/invite/respond', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ group_id: groupData.id, action: 'accept' }),
  });
  if (res.ok) window.location.reload();
  else { const d = await res.json(); alert(d.error ?? 'Could not accept invite'); if (btn) { btn.disabled = false; btn.style.opacity = '1'; } }
}
window.acceptInvite = acceptInvite;

async function joinGroup() {
  const btn = document.getElementById('join-btn');
  if (btn) btn.disabled = true;
  const res = await fetch('/api/groups/join', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ group_id: groupData.id }) });
  if (res.ok) window.location.reload();
  else { const d = await res.json(); alert(d.error ?? 'Could not join'); if (btn) btn.disabled = false; }
}
window.joinGroup = joinGroup;

async function joinGroupByCode() {
  const btn = document.getElementById('join-btn');
  if (btn) btn.disabled = true;
  const code = new URLSearchParams(window.location.search).get('code');
  const res = await fetch('/api/groups/join', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ invite_code: code }) });
  if (res.ok) window.location.href = `/groups/${groupData.id}`;
  else { const d = await res.json(); alert(d.error ?? 'Could not join'); if (btn) btn.disabled = false; }
}
window.joinGroupByCode = joinGroupByCode;

// ── Join request (private groups) ──
function openJoinRequestForm() {
  const form = document.getElementById('join-request-form');
  const btn = document.getElementById('join-request-btn');
  if (form) { form.style.display = 'block'; if (btn) btn.style.display = 'none'; }
}
window.openJoinRequestForm = openJoinRequestForm;

function closeJoinRequestForm() {
  const form = document.getElementById('join-request-form');
  const btn = document.getElementById('join-request-btn');
  if (form) { form.style.display = 'none'; if (btn) btn.style.display = ''; }
}
window.closeJoinRequestForm = closeJoinRequestForm;

async function submitJoinRequest() {
  const submitBtn = document.getElementById('submit-request-btn');
  const msgEl = document.getElementById('join-request-msg');
  const errEl = document.getElementById('join-request-err');
  if (submitBtn) submitBtn.disabled = true;
  if (errEl) errEl.style.display = 'none';
  const message = msgEl ? msgEl.value.trim() : '';
  const res = await fetch('/api/groups/join-request/create', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ group_id: groupData.id, message: message || null }),
  });
  const data = await res.json();
  if (res.ok) {
    // Replace the action area with a pending badge
    const form = document.getElementById('join-request-form');
    if (form) form.style.display = 'none';
    const actionsEl = document.querySelector('.group-actions');
    if (actionsEl) {
      actionsEl.innerHTML = '<span class="badge-pending-action">Request pending</span>';
    }
  } else {
    if (errEl) { errEl.textContent = data.error ?? 'Could not send request'; errEl.style.display = 'block'; }
    if (submitBtn) submitBtn.disabled = false;
  }
}
window.submitJoinRequest = submitJoinRequest;

async function respondJoinRequest(requestId, action) {
  const row = document.querySelector(`[data-jr-id="${requestId}"]`);
  if (row) { row.style.opacity = '0.5'; row.querySelectorAll('button').forEach(b => b.disabled = true); }
  const res = await fetch('/api/groups/join-request/respond', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ request_id: requestId, action }),
  });
  if (res.ok) {
    if (row) row.remove();
    // If accepted, reload so the new member appears
    if (action === 'accept') window.location.reload();
  } else {
    const d = await res.json();
    alert(d.error ?? 'Error');
    if (row) { row.style.opacity = '1'; row.querySelectorAll('button').forEach(b => b.disabled = false); }
  }
}
window.respondJoinRequest = respondJoinRequest;

async function leaveGroup() {
  if (!confirm('Leave this group?')) return;
  const res = await fetch('/api/groups/leave', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ group_id: groupData.id }) });
  if (res.ok) window.location.href = '/groups';
  else { const d = await res.json(); alert(d.error ?? 'Could not leave'); }
}
window.leaveGroup = leaveGroup;

// ── Invite panel ──
function openInvitePanel() {
  const panel = document.getElementById('invite-panel');
  if (panel) panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
}
window.openInvitePanel = openInvitePanel;

function copyInvite() {
  const field = document.getElementById('invite-url-field');
  navigator.clipboard.writeText(field.value).then(() => {
    const btn = field.nextElementSibling;
    btn.textContent = 'Copied!';
    setTimeout(() => btn.textContent = 'Copy', 2000);
  });
}
window.copyInvite = copyInvite;

async function sendInvite() {
  const input = document.getElementById('invite-username-input');
  const btn = document.getElementById('invite-send-btn');
  const msg = document.getElementById('invite-msg');
  const username = input.value.trim().replace(/^@/, '');
  if (!username) return;

  btn.disabled = true;
  btn.style.opacity = '0.5';
  btn.style.cursor = 'default';
  msg.textContent = '';

  try {
    const res = await fetch('/api/groups/invite/send', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ group_id: groupData.id, invited_username: username }),
    });
    const data = await res.json();
    if (res.ok) {
      msg.textContent = `✓ Invite sent to @${data.username}`;
      msg.style.color = '#4ade80';
      input.value = '';
      // Keep dimmed/disabled until user types a new name (syncBtn re-enables)
      btn.style.opacity = '0.45';
      btn.style.cursor = 'default';
    } else {
      msg.textContent = data.error ?? 'Something went wrong';
      msg.style.color = '#f87171';
      btn.disabled = false;
      btn.style.opacity = '1';
      btn.style.cursor = 'pointer';
    }
  } catch {
    msg.textContent = 'Network error — please try again';
    msg.style.color = '#f87171';
    btn.disabled = false;
    btn.style.opacity = '1';
    btn.style.cursor = 'pointer';
  }
}
window.sendInvite = sendInvite;
(function() {
  const inp = document.getElementById('invite-username-input');
  const btn = document.getElementById('invite-send-btn');
  if (!inp || !btn) return;
  function syncBtn() {
    const hasText = inp.value.trim().length > 0;
    btn.disabled = !hasText;
    btn.style.opacity = hasText ? '1' : '0.45';
    btn.style.cursor = hasText ? 'pointer' : 'default';
  }
  inp.addEventListener('input', syncBtn);
  inp.addEventListener('keydown', e => { if (e.key === 'Enter' && !btn.disabled) sendInvite(); });
})();

// ── Member management ──
async function removeMember(profileId) {
  if (!confirm('Remove this member?')) return;
  const res = await fetch('/api/groups/members/remove', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ group_id: groupData.id, target_profile_id: profileId }) });
  if (res.ok) document.querySelector(`[data-profile-id="${profileId}"]`)?.remove();
  else { const d = await res.json(); alert(d.error ?? 'Error'); }
}
window.removeMember = removeMember;

async function updateRole(profileId, role) {
  const res = await fetch('/api/groups/members/update-role', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ group_id: groupData.id, target_profile_id: profileId, role }) });
  if (res.ok) window.location.reload();
  else { const d = await res.json(); alert(d.error ?? 'Error'); }
}
window.updateRole = updateRole;

// ── Want to Play ──
function openWatchlistSearch() {
  const box = document.getElementById('wl-search-box');
  if (box) { box.style.display = box.style.display === 'none' ? 'block' : 'none'; }
}
window.openWatchlistSearch = openWatchlistSearch;

async function searchWatchlistGame() {
  const input = document.getElementById('wl-game-input');
  const q = input.value.trim();
  if (!q) return;
  const res = await fetch(`/api/games/search?q=${encodeURIComponent(q)}`);
  if (!res.ok) return;
  const data = await res.json();
  const container = document.getElementById('wl-search-results');
  container.innerHTML = '';
  (data.games ?? data ?? []).slice(0, 5).forEach(g => {
    const btn = document.createElement('button');
    btn.style.cssText = 'display:flex;align-items:center;gap:8px;padding:7px 10px;border-radius:8px;border:1px solid var(--border);background:var(--bg-card);cursor:pointer;text-align:left;font-family:inherit;font-size:12px;color:var(--text-primary);width:100%';
    btn.textContent = g.title ?? g.name;
    btn.onclick = async () => {
      await fetch('/api/groups/watchlist/toggle', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ group_id: groupData.id, game_id: g.id }) });
      window.location.reload();
    };
    container.appendChild(btn);
  });
}
window.searchWatchlistGame = searchWatchlistGame;
document.getElementById('wl-game-input')?.addEventListener('keydown', e => { if (e.key === 'Enter') searchWatchlistGame(); });

async function removeFromWatchlist(gameId) {
  const res = await fetch('/api/groups/watchlist/toggle', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ group_id: groupData.id, game_id: gameId }) });
  if (res.ok) document.querySelector(`[data-game-id="${gameId}"]`)?.remove();
}
window.removeFromWatchlist = removeFromWatchlist;

// ── Sessions ──
function toggleAttendee(btn) { btn.classList.toggle('selected'); }
window.toggleAttendee = toggleAttendee;

let sessionGameId = null;
const sessionInput = document.getElementById('session-game-input');
if (sessionInput) {
  sessionInput.addEventListener('input', async () => {
    const q = sessionInput.value.trim();
    const container = document.getElementById('session-search-results');
    if (!q) { container.innerHTML = ''; return; }
    const res = await fetch(`/api/games/search?q=${encodeURIComponent(q)}`);
    if (!res.ok) return;
    const data = await res.json();
    container.innerHTML = '';
    (data.games ?? data ?? []).slice(0, 5).forEach(g => {
      const btn = document.createElement('button');
      btn.style.cssText = 'display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:8px;border:1px solid var(--border);background:var(--bg-card);cursor:pointer;text-align:left;font-family:inherit;font-size:13px;color:var(--text-primary);width:100%';
      btn.textContent = g.title ?? g.name;
      btn.onclick = () => {
        sessionGameId = g.id;
        sessionInput.value = g.title ?? g.name;
        document.getElementById('session-game-hidden').value = g.id;
        container.innerHTML = '';
      };
      container.appendChild(btn);
    });
  });
}

async function logSession() {
  const gameId = document.getElementById('session-game-hidden')?.value;
  const date = document.getElementById('session-date')?.value;
  const notes = document.getElementById('session-notes')?.value;
  if (!gameId) { alert('Please select a game'); return; }
  if (!date) { alert('Please pick a date'); return; }
  const attendeeIds = Array.from(document.querySelectorAll('.attendee-toggle.selected')).map(b => b.dataset.profileId);
  const res = await fetch('/api/groups/sessions/create', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ group_id: groupData.id, game_id: gameId, played_at: date, notes, attendee_ids: attendeeIds }) });
  if (res.ok) window.location.reload();
  else { const d = await res.json(); alert(d.error ?? 'Error logging session'); }
}
window.logSession = logSession;

function toggleMoreReviews() {
  const more = document.getElementById('more-reviews');
  const btn = document.getElementById('see-more-reviews-btn');
  if (!more || !btn) return;
  const isHidden = more.style.display === 'none';
  more.style.display = isHidden ? 'block' : 'none';
  btn.textContent = isHidden ? 'See less' : (btn.dataset.label || 'See more');
}
window.toggleMoreReviews = toggleMoreReviews;

async function deleteSession(sessionId) {
  if (!confirm('Delete this session?')) return;
  const res = await fetch('/api/groups/sessions/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ session_id: sessionId }) });
  if (res.ok) document.querySelector(`[data-session-id="${sessionId}"]`)?.remove();
  else { const d = await res.json(); alert(d.error ?? 'Error'); }
}
window.deleteSession = deleteSession;
</script>
