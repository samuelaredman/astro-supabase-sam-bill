            </div>
            <div id="wl-search-results" style="margin-top:6px;display:flex;flex-direction:column;gap:4px;"></div>
          </div>
          {(watchlistData ?? []).length === 0
            ? <div style="font-size:13px;color:var(--text-tertiary);padding:8px 0">No games added yet.</div>
            : (watchlistData ?? []).slice(0, 8).map((w: any) => (
              <div class="wl-item" data-wl-id={w.id} data-game-id={w.game_id}>
                {igdbCover(w.games?.cover_img_url, "t_thumb")
                  ? <img class="wl-cover" src={igdbCover(w.games?.cover_img_url, "t_thumb")!} alt={w.games?.title} loading="lazy" />
                  : <div class="wl-cover" />
                }
                <a class="wl-title" href={`/games/${w.games?.slug}`} style="color:inherit;text-decoration:none">{w.games?.title}</a>
