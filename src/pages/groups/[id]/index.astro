        <!-- Want to Play -->
        {statsConf.show_watchlist && <div class="card">
          <div class="card-title" style="display:flex;align-items:center;justify-content:space-between">
            <span>Want to Play</span>
            {isMember && (
              <button onclick="openWatchlistSearch()" style="background:none;border:none;cursor:pointer;color:var(--accent);font-size:11px;font-family:inherit;font-weight:600;padding:0">+ Add</button>
