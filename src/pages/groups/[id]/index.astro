          </div>
          <div id="wl-search-box" style="display:none;margin-bottom:10px">
            <div style="display:flex;gap:6px">
              <input id="wl-game-input" class="invite-user-input" style="font-size:12px;padding:6px 10px" type="text" placeholder="Search for a game…" autocomplete="off" />
