<script is:inline define:vars={{ overviewHiddenJson, overviewOrderJson, overviewGroupId: group.id, canEditOverview }}>
  // ── OVERVIEW SHOWCASES: Customize (order + hiding) ──
  // Like Edit profile (see ShowcaseSection.astro): moving reorders a section
  // within its column's stack, hiding flips .sc-is-hidden. Both are staged in
  // the DOM; Save sends them, Cancel puts back what was last saved.
  var savedOverviewHidden = JSON.parse(overviewHiddenJson || '[]')
  var savedOverviewOrder = JSON.parse(overviewOrderJson || '[]')
  var OVERVIEW_STACKS = ['showcaseStack', 'showcaseStackSide']
  function stackSections(stackId) {
    var stack = document.getElementById(stackId)
    return stack ? Array.from(stack.querySelectorAll(':scope > .sc-section')) : []
  }
  function allOverviewSections() {
    return OVERVIEW_STACKS.reduce(function(all, id) { return all.concat(stackSections(id)) }, [])
  }
  function refreshShowcaseMoveButtons() {
    OVERVIEW_STACKS.forEach(function(id) {
      var els = stackSections(id)
      els.forEach(function(el, i) {
        var up = el.querySelector('.sc-move-btn[data-dir="-1"]')
        var down = el.querySelector('.sc-move-btn[data-dir="1"]')
        if (up) up.disabled = i === 0
        if (down) down.disabled = i === els.length - 1
      })
    })
  }
  function moveShowcase(key, dir) {
    var el = allOverviewSections().find(function(s) { return s.dataset.showcase === key })
    if (!el) return
    var els = Array.from(el.parentElement.querySelectorAll(':scope > .sc-section'))
    var target = els[els.indexOf(el) + dir]
    if (!target) return
    if (dir < 0) target.before(el); else target.after(el)
    refreshShowcaseMoveButtons()
    var btn = el.querySelector('.sc-move-btn[data-dir="' + dir + '"]')
    if (btn && btn.disabled) btn = el.querySelector('.sc-move-btn[data-dir="' + (-dir) + '"]')
    if (btn) btn.focus()
    el.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
  }
  function toggleShowcaseHidden(key) {
    var el = allOverviewSections().find(function(s) { return s.dataset.showcase === key })
    if (el) el.classList.toggle('sc-is-hidden')
  }
  function restoreOverview() {
    OVERVIEW_STACKS.forEach(function(id) {
      var stack = document.getElementById(id)
      if (!stack) return
      var byKey = {}
      stackSections(id).forEach(function(el) { byKey[el.dataset.showcase] = el })
      savedOverviewOrder.forEach(function(key) { if (byKey[key]) stack.appendChild(byKey[key]) })
    })
    allOverviewSections().forEach(function(el) {
      el.classList.toggle('sc-is-hidden', savedOverviewHidden.indexOf(el.dataset.showcase) !== -1)
    })
    refreshShowcaseMoveButtons()
  }
  function enterOverviewEdit() {
    document.body.classList.add('editing-overview')
    refreshShowcaseMoveButtons()
  }
  function cancelOverviewEdit() {
    restoreOverview()
    document.body.classList.remove('editing-overview')
  }
  async function saveOverview() {
    var btn = document.getElementById('saveOverviewBtn')
    var order = allOverviewSections().map(function(el) { return el.dataset.showcase })
    var hidden = allOverviewSections().filter(function(el) { return el.classList.contains('sc-is-hidden') }).map(function(el) { return el.dataset.showcase })
    btn.disabled = true
    btn.textContent = 'Saving…'
    try {
      var res = await fetch('/api/groups/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ group_id: overviewGroupId, overview_order: order, overview_hidden: hidden })
      })
      var data = await res.json().catch(function() { return {} })
      if (!res.ok) throw new Error(data.error || 'Failed to save')
      savedOverviewOrder = order
      savedOverviewHidden = hidden
      document.body.classList.remove('editing-overview')
    } catch (e) {
      alert(e && e.message ? e.message : 'Failed to save')
    } finally {
      btn.disabled = false
      btn.textContent = 'Save changes'
    }
  }
  window.moveShowcase = moveShowcase
  window.toggleShowcaseHidden = toggleShowcaseHidden
  window.enterOverviewEdit = enterOverviewEdit
  window.cancelOverviewEdit = cancelOverviewEdit
  window.saveOverview = saveOverview

  // ── VIDEO SHOWCASE ── (the same as a profile's)
  // Featured: the id is server-rendered. Latest: ask /api/groups/latest-video
  // (CDN-cached per group) for the owner's newest upload. Either way the
  // title/channel/views come from /api/youtube/meta.
  function vsAgo(iso) {
    var t = Date.parse(iso)
    if (!t) return ''
    var d = Math.floor((Date.now() - t) / 86400000)
    if (d < 1) return 'today'
    if (d < 2) return 'yesterday'
    if (d < 30) return d + ' days ago'
    if (d < 365) { var m = Math.floor(d / 30); return m + (m === 1 ? ' month ago' : ' months ago') }
    var y = Math.floor(d / 365); return y + (y === 1 ? ' year ago' : ' years ago')
  }
  function vsShow(card, id, fallbackTitle) {
    var body = card.querySelector('.vs-body')
    var player = card.querySelector('.vs-player')
    var link = card.querySelector('.vs-info')
    var title = card.querySelector('.vs-title')
    var meta = card.querySelector('.vs-meta')
    card.dataset.videoId = id
    if (!player.querySelector('img')) {
      var img = document.createElement('img')
      img.alt = ''
      player.insertBefore(img, player.firstChild)
    }
    player.querySelector('img').src = 'https://i.ytimg.com/vi/' + id + '/hqdefault.jpg'
    link.href = 'https://www.youtube.com/watch?v=' + id
    if (fallbackTitle) title.textContent = fallbackTitle
    body.dataset.state = 'ready'
    fetch('/api/youtube/meta?id=' + id)
      .then(function(r) { return r.ok ? r.json() : null })
      .then(function(m) {
        if (!m || !m.title) return
        title.textContent = m.title
        player.setAttribute('aria-label', 'Play video: ' + m.title)
        meta.textContent = [m.channel, m.views, m.published ? vsAgo(m.published) : null].filter(Boolean).join(' · ')
        var dur = card.querySelector('.vs-duration')
        if (m.duration && dur) { dur.textContent = m.duration; dur.hidden = false }
      })
      .catch(function() {})
  }
  function vsUnavailable(card) {
    if (!canEditOverview) { card.closest('.sc-section').style.display = 'none'; return }
    card.querySelector('.vs-body').hidden = true
    card.querySelector('.vs-unavailable').hidden = false
  }
  ;(function initVideoShowcase() {
    var card = document.getElementById('videoShowcaseCard')
    if (!card) return
    if (card.dataset.mode === 'featured') { if (card.dataset.videoId) vsShow(card, card.dataset.videoId); return }
    fetch('/api/groups/latest-video?g=' + encodeURIComponent(card.dataset.groupId))
      .then(function(r) { return r.ok ? r.json() : null })
      .then(function(d) {
        if (d && d.video && /^[A-Za-z0-9_-]{11}$/.test(d.video.id)) vsShow(card, d.video.id, d.video.title)
        else vsUnavailable(card)
      })
      .catch(function() { vsUnavailable(card) })
  })()
  function playShowcaseVideo() {
    var card = document.getElementById('videoShowcaseCard')
    var id = card && card.dataset.videoId
    if (!id || !/^[A-Za-z0-9_-]{11}$/.test(id)) return
    var player = card.querySelector('.vs-player')
    var frame = document.createElement('div')
    frame.className = 'vs-player vs-player--playing'
    var iframe = document.createElement('iframe')
    iframe.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0'
    iframe.title = 'YouTube video'
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
    iframe.allowFullscreen = true
    frame.appendChild(iframe)
    player.replaceWith(frame)
  }
  window.playShowcaseVideo = playShowcaseVideo

  function openVideoShowcasePicker() {
    var err = document.getElementById('vsmError')
    if (err) err.hidden = true
    document.getElementById('videoShowcaseModal').classList.add('open')
  }
  function closeVideoShowcasePicker() { document.getElementById('videoShowcaseModal').classList.remove('open') }
  function closeVideoShowcasePickerOnBackdrop(e) { if (e.target === document.getElementById('videoShowcaseModal')) closeVideoShowcasePicker() }
  ;(function wireVideoShowcaseModal() {
    var url = document.getElementById('vsmUrl')
    if (!url) return
    // Typing a link means "featured" — select it so Save does what they expect.
    url.addEventListener('focus', function() {
      var r = document.querySelector('input[name="vsmMode"][value="featured"]')
      if (r) r.checked = true
    })
    url.addEventListener('keydown', function(e) { if (e.key === 'Enter') saveVideoShowcase() })
  })()
  async function saveVideoShowcase() {
    var picked = document.querySelector('input[name="vsmMode"]:checked')
    var err = document.getElementById('vsmError')
    var btn = document.getElementById('vsmSave')
    err.hidden = true
    if (!picked) { err.textContent = 'Choose an option.'; err.hidden = false; return }
    var mode = picked.value || null
    var videoUrl = (document.getElementById('vsmUrl').value || '').trim()
    if (mode === 'featured' && !videoUrl) { err.textContent = 'Paste a YouTube link to feature.'; err.hidden = false; return }
    btn.disabled = true
    btn.textContent = 'Saving…'
    try {
      var res = await fetch('/api/groups/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ group_id: overviewGroupId, showcase_video_mode: mode, showcase_video_url: videoUrl })
      })
      var data = await res.json().catch(function() { return {} })
      if (!res.ok) throw new Error(data.error || 'Failed to save')
      location.reload()
    } catch (e) {
      err.textContent = e && e.message ? e.message : 'Failed to save'
      err.hidden = false
      btn.disabled = false
      btn.textContent = 'Save'
    }
  }
  window.openVideoShowcasePicker = openVideoShowcasePicker
  window.closeVideoShowcasePicker = closeVideoShowcasePicker
  window.closeVideoShowcasePickerOnBackdrop = closeVideoShowcasePickerOnBackdrop
  window.saveVideoShowcase = saveVideoShowcase
</script>
<CropModal />
</Layout>
