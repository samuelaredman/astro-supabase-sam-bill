---
/**
 * Shared comment thread used wherever discussion happens on the site.
 *
 * Pages adapt their own rows (review_comments, forum_post_comments,
 * group_poll_answers) into CommentData[] and pass a `target` identifying
 * the backing API. The client-side JS in src/scripts/comment-thread.ts
 * dispatches vote/reply/delete to the right endpoint based on target.type.
 */
import ProfileBadge from "./ProfileBadge.astro";
import { timeAgo } from "../utils/format";
import type { CommentData, CommentTarget } from "../utils/comments";

interface Props {
  comments: CommentData[];
  currentUser: { id: string; username: string; avatarUrl: string | null } | null;
  target: CommentTarget;
  /** Can anyone post new comments / replies? (false if the thread is locked.) */
  canCompose: boolean;
  /** Enable the downvote button alongside upvote. Default false. */
  showDownvote?: boolean;
  /** Enable the report button on others' comments. Default false. */
  showReport?: boolean;
  /** Shown next to the character counter — default 500 (matches poll answers). */
  maxLength?: number;
  /** Returned by the server endpoints as `{ body: "..." }`; shown pre-filled. */
  myDraftBody?: string | null;
  /** Marks the viewer as a moderator (shown delete on everyone's comments). */
  isModerator?: boolean;
  signinReturnTo?: string;
}

const {
  comments,
  currentUser,
  target,
  canCompose,
  showDownvote = false,
  showReport = false,
  maxLength = 500,
  myDraftBody = null,
  isModerator = false,
  signinReturnTo,
} = Astro.props as Props;

const roleClass = (tag: string | null | undefined) =>
  tag === "Owner" ? "ct-role-owner"
    : tag === "Admin" ? "ct-role-admin"
    : tag === "Staff" ? "ct-role-staff"
    : "";

const initials = (name: string) => (name ?? "?").slice(0, 2).toUpperCase();

const signinHref = `/signin?returnTo=${encodeURIComponent(signinReturnTo ?? "/")}`;
---

<div
  class="ct-thread"
  data-ct-target-type={target.type}
  data-ct-target-id={target.id}
  data-ct-max-length={maxLength}
  data-ct-show-downvote={showDownvote ? "1" : "0"}
>
  {canCompose && currentUser && (
    <form class="ct-composer" data-ct-composer>
      <div class="ct-composer-row">
        <div class="ct-composer-avatar">
          {currentUser.avatarUrl
            ? <img src={currentUser.avatarUrl} alt={currentUser.username} />
            : <span>{initials(currentUser.username)}</span>}
        </div>
        <div class="ct-composer-wrap">
          <textarea name="body" placeholder="Write a comment…" rows="3" maxlength={maxLength}>{myDraftBody ?? ""}</textarea>
          <div class="ct-composer-foot">
            <span class="ct-char-count"><span data-ct-char-count>{(myDraftBody ?? "").length}</span> / {maxLength}</span>
            <button type="submit" class="ct-submit">{myDraftBody ? "Update" : "Post comment"}</button>
          </div>
        </div>
      </div>
      <div class="ct-composer-error" data-ct-composer-err></div>
    </form>
  )}
  {canCompose && !currentUser && (
    <div class="ct-signin-prompt">
      <a href={signinHref}>Sign in</a> to leave a comment.
    </div>
  )}

  {comments.length === 0 ? (
    <div class="ct-empty">No comments yet. Be the first.</div>
  ) : (
    <ul class="ct-list">
      {comments.map((c) => (
        <li class="ct-comment" data-ct-id={c.id}>
          <a href={`/reviewers/${c.author.username}`} class="ct-avatar">
            {c.author.avatarUrl
              ? <img src={c.author.avatarUrl} alt={c.author.username} />
              : <span>{initials(c.author.username)}</span>}
          </a>
          <div class="ct-body">
            <div class="ct-meta">
              <a href={`/reviewers/${c.author.username}`} class="ct-username">@{c.author.username}</a>
              {(c.author.badges ?? []).map((slug: string) => <ProfileBadge slug={slug} size="sm" iconOnly={true} />)}
              {c.author.roleTag && <span class={`ct-role-chip ${roleClass(c.author.roleTag)}`}>{c.author.roleTag}</span>}
              <span class="ct-time">{timeAgo(c.createdAt)}</span>
              {c.updatedAt && c.updatedAt !== c.createdAt && <span class="ct-edited">(edited)</span>}
            </div>
            <p class="ct-text">{c.body}</p>
            <div class="ct-actions">
              <button
                type="button"
                class={`ct-vote-btn${c.myVote === 1 ? " active-up" : ""}`}
                data-ct-action="vote" data-ct-vote="1"
                aria-pressed={c.myVote === 1 ? "true" : "false"}
                disabled={!currentUser}
              >▲ {c.upvotes}</button>
              {showDownvote && (
                <button
                  type="button"
                  class={`ct-vote-btn${c.myVote === -1 ? " active-down" : ""}`}
                  data-ct-action="vote" data-ct-vote="-1"
                  aria-pressed={c.myVote === -1 ? "true" : "false"}
                  disabled={!currentUser}
                >▼ {c.downvotes ?? 0}</button>
              )}
              {canCompose && (
                <button
                  type="button" class="ct-reply-btn"
                  data-ct-action="toggle-reply" aria-expanded="false"
                >↩ Reply {(c.replies?.length ?? 0) > 0 && `(${c.replies!.length})`}</button>
              )}
              {c.canEdit && <button type="button" class="ct-icon-btn" data-ct-action="edit">Edit</button>}
              {c.canDelete && <button type="button" class="ct-icon-btn" data-ct-action="delete">Delete</button>}
              {showReport && c.canReport && (
                <button type="button" class="ct-icon-btn" data-ct-action="report">Report</button>
              )}
            </div>

            {canCompose && (
              <form class="ct-reply-form" data-ct-reply-form data-ct-parent-id={c.id} hidden>
                <div class="ct-composer-avatar ct-avatar-sm">
                  {currentUser?.avatarUrl
                    ? <img src={currentUser.avatarUrl} alt={currentUser.username} />
                    : <span>{currentUser ? initials(currentUser.username) : "?"}</span>}
                </div>
                <div class="ct-composer-wrap">
                  <textarea name="body" placeholder={`Reply to @${c.author.username}…`} rows="2" maxlength={maxLength}></textarea>
                  <div class="ct-composer-foot">
                    <span class="ct-char-count"><span data-ct-char-count>0</span> / {maxLength}</span>
                    <button type="submit" class="ct-submit">Reply</button>
                  </div>
                  <div class="ct-composer-error" data-ct-composer-err></div>
                </div>
              </form>
            )}

            {(c.replies ?? []).length > 0 && (
              <ul class="ct-replies" data-ct-replies-for={c.id}>
                {c.replies!.map((r) => (
                  <li class="ct-comment" data-ct-id={r.id}>
                    <a href={`/reviewers/${r.author.username}`} class="ct-avatar ct-avatar-sm">
                      {r.author.avatarUrl
                        ? <img src={r.author.avatarUrl} alt={r.author.username} />
                        : <span>{initials(r.author.username)}</span>}
                    </a>
                    <div class="ct-body">
                      <div class="ct-meta">
                        <a href={`/reviewers/${r.author.username}`} class="ct-username">@{r.author.username}</a>
                        {(r.author.badges ?? []).map((slug: string) => <ProfileBadge slug={slug} size="sm" iconOnly={true} />)}
                        {r.author.roleTag && <span class={`ct-role-chip ${roleClass(r.author.roleTag)}`}>{r.author.roleTag}</span>}
                        <span class="ct-time">{timeAgo(r.createdAt)}</span>
                      </div>
                      <p class="ct-text">{r.body}</p>
                      {r.canDelete && (
                        <div class="ct-actions">
                          <button type="button" class="ct-icon-btn" data-ct-action="delete-reply">Delete</button>
                        </div>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ul>
  )}
</div>

<script>
  import "../scripts/comment-thread";
</script>
