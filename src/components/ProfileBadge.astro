---
import { getBadge } from "../utils/badges";

interface Props {
  slug: string;
  size?: "sm" | "md";
  iconOnly?: boolean;
}

const { slug, size = "sm", iconOnly = false } = Astro.props;
const badge = getBadge(slug);
---

{badge && (
  <span
    class={`profile-badge profile-badge--${size}${iconOnly ? " profile-badge--icon-only" : ""}`}
    style={`--badge-color:${badge.color}`}
    title={badge.description}
    aria-label={badge.label}
  >
    <span class="profile-badge-icon" aria-hidden="true">{badge.icon}</span>
    {!iconOnly && <span class="profile-badge-label">{badge.label}</span>}
  </span>
)}

<style is:global>
  .profile-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 2px 7px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--badge-color, var(--accent)) 16%, transparent);
    color: var(--badge-color, var(--accent));
    border: 1px solid color-mix(in srgb, var(--badge-color, var(--accent)) 45%, transparent);
    vertical-align: middle;
    white-space: nowrap;
    line-height: 1.2;
  }
  .profile-badge--sm { font-size: 10px; padding: 2px 7px; }
  .profile-badge--md { font-size: 11.5px; padding: 3px 10px; }
  .profile-badge-icon { font-size: 1em; line-height: 1; }
  .profile-badge--icon-only {
    width: 18px; height: 18px;
    padding: 0;
    justify-content: center;
  }
  .profile-badge--icon-only .profile-badge-icon { font-size: 11px; }
</style>
