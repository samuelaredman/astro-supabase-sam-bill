---
import { igdbImage } from '../utils/format';

interface Props {
  id: string;
  title: string;
  isRanked: boolean;
  visibility: 'public' | 'private';
  entryCount: number;
  coverUrls: string[];
  ownerUsername?: string;
  ownerAvatar?: string | null;
  showOwner?: boolean;
  compact?: boolean;
}

const {
  id,
  title,
  isRanked,
  visibility,
  entryCount,
  coverUrls,
  ownerUsername,
  ownerAvatar,
  showOwner = true,
  compact = false,
} = Astro.props;

const collageCount = Math.max(1, Math.min(4, coverUrls.length));
const initials = ownerUsername ? ownerUsername.slice(0, 2).toUpperCase() : '??';
---

<a href={`/lists/${id}`} class={`list-card${compact ? ' list-card-compact' : ''}`}>
  <div class={`lc-collage lc-collage-${collageCount}`}>
    {coverUrls.length === 0
      ? <div class="lc-empty">📋</div>
      : coverUrls.map((src) => <img class="lc-cover-img" src={src} alt="" loading="lazy" />)
    }
  </div>
  <div class="lc-body">
    <div class="lc-badges">
      {isRanked && <span class="lc-badge lc-badge-ranked">Ranked</span>}
      {visibility === 'private' && <span class="lc-badge lc-badge-private">Private</span>}
    </div>
    <div class="lc-title">{title}</div>
    <div class="lc-meta">
      {showOwner && ownerUsername && (
        <span class="lc-owner">
          <span class="lc-owner-avatar">
            {ownerAvatar
              ? <img src={ownerAvatar} alt={ownerUsername} />
              : <span>{initials}</span>
            }
          </span>
          @{ownerUsername}
        </span>
      )}
      <span class="lc-count">{entryCount} {entryCount === 1 ? 'game' : 'games'}</span>
    </div>
  </div>
</a>

<style is:global>
  .list-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    transition: border-color .15s, transform .15s, box-shadow .15s;
  }
  .list-card:hover {
    border-color: rgba(96,80,200,.4);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,.15);
  }

  .lc-collage {
    display: flex;
    height: 120px;
    gap: 2px;
    background: linear-gradient(135deg, #1a1030 0%, #0d1a2e 100%);
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
  }
  [data-theme="light"] .lc-collage {
    background: linear-gradient(135deg, #e8e4f8 0%, #dce8f5 100%);
  }
  .lc-cover-img { flex: 1; min-width: 0; height: 100%; object-fit: cover; display: block; }
  .lc-empty {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 32px; opacity: .3;
  }

  .lc-body { padding: 12px 14px; flex: 1; display: flex; flex-direction: column; gap: 4px; }
  .lc-badges { display: flex; gap: 5px; flex-wrap: wrap; }
  .lc-badge {
    font-size: 10px; font-weight: 700; padding: 2px 7px;
    border-radius: 8px; background: var(--tag-bg); color: var(--tag-text);
    text-transform: uppercase; letter-spacing: .05em;
  }
  .lc-badge-ranked { background: rgba(96,80,200,.12); color: var(--accent); }
  .lc-badge-private { background: rgba(251,191,36,.08); color: #fbbf24; }
  .lc-title {
    font-size: 13px; font-weight: 600; color: var(--text-primary);
    line-height: 1.35; overflow: hidden;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  }
  .lc-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 2px; }
  .lc-owner {
    display: flex; align-items: center; gap: 5px;
    font-size: 11px; color: var(--text-tertiary);
  }
  .lc-owner-avatar {
    width: 16px; height: 16px; border-radius: 50%;
    background: var(--tag-bg); border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-size: 7px; font-weight: 700; overflow: hidden; flex-shrink: 0;
    color: var(--text-tertiary);
  }
  .lc-owner-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .lc-count { font-size: 11px; color: var(--text-tertiary); }

  /* Compact variant — used in game page sidebar */
  .list-card-compact .lc-collage { height: 80px; }
  .list-card-compact .lc-body { padding: 9px 12px; }
  .list-card-compact .lc-title { font-size: 12px; -webkit-line-clamp: 1; }
</style>
