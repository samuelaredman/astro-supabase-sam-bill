---
import { timeAgo } from '../utils/format';

interface Props {
  id: string;
  title: string;
  description?: string | null;
  isRanked: boolean;
  entryCount: number;
  coverUrls: string[];
  ownerUsername: string;
  ownerAvatar?: string | null;
  createdAt: string;
}

const {
  id, title, description, isRanked, entryCount,
  coverUrls, ownerUsername, ownerAvatar, createdAt,
} = Astro.props;

const initials = ownerUsername ? ownerUsername.slice(0, 2).toUpperCase() : '??';
---

<article class="lfc">
  <div class="lfc-reviewer">
    <a href={`/reviewers/${ownerUsername}`} class="lfc-avatar">
      {ownerAvatar
        ? <img src={ownerAvatar} alt={ownerUsername} />
        : <span>{initials}</span>
      }
    </a>
    <a href={`/reviewers/${ownerUsername}`} class="lfc-reviewer-name">@{ownerUsername}</a>
    <span class="lfc-action">shared a list</span>
    <span class="lfc-dot">·</span>
    <span class="lfc-ts">{timeAgo(createdAt)}</span>
  </div>

  <a href={`/lists/${id}`} class="lfc-body-link">
    <div class="lfc-title">{title}</div>
    {description && (
      <p class="lfc-desc">{description}</p>
    )}
  </a>

  {coverUrls.length > 0 && (
    <a href={`/lists/${id}`} class="lfc-covers" aria-label="View list">
      {coverUrls.map(src => (
        <img class="lfc-cover" src={src} alt="" loading="lazy" />
      ))}
      {entryCount > coverUrls.length && (
        <div class="lfc-cover-more">+{entryCount - coverUrls.length}</div>
      )}
    </a>
  )}

  <div class="lfc-footer">
    <div class="lfc-badges">
      {isRanked && <span class="lfc-badge-ranked">Ranked</span>}
      <span class="lfc-count">{entryCount} {entryCount === 1 ? 'game' : 'games'}</span>
    </div>
    <a href={`/lists/${id}`} class="lfc-view-btn">
      {description ? 'Read more →' : 'View list →'}
    </a>
  </div>
</article>

<style is:global>
  .lfc {
    padding: 16px 20px 14px;
    border-bottom: 1px solid var(--border-subtle);
    transition: background 0.12s;
  }
  .lfc:last-child { border-bottom: none; }

  /* ── Reviewer row ── */
  .lfc-reviewer {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .lfc-avatar {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--tag-bg);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: 700;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .lfc-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lfc-reviewer-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.12s;
  }
  .lfc-reviewer-name:hover { color: var(--accent); }
  .lfc-action { font-size: 13px; color: var(--text-tertiary); }
  .lfc-dot { font-size: 13px; color: var(--text-tertiary); }
  .lfc-ts { font-size: 12px; color: var(--text-tertiary); }

  /* ── Body ── */
  .lfc-body-link {
    display: block;
    text-decoration: none;
    margin-bottom: 10px;
  }
  .lfc-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.2px;
    line-height: 1.3;
    margin-bottom: 5px;
    transition: color 0.12s;
  }
  .lfc-body-link:hover .lfc-title { color: var(--accent); }
  .lfc-desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  /* ── Cover strip ── */
  .lfc-covers {
    display: flex;
    gap: 6px;
    margin-bottom: 10px;
    overflow-x: auto;
    scrollbar-width: none;
    text-decoration: none;
  }
  .lfc-covers::-webkit-scrollbar { display: none; }
  .lfc-cover {
    width: 46px;
    height: 62px;
    border-radius: 6px;
    object-fit: cover;
    border: 1px solid var(--border);
    flex-shrink: 0;
    display: block;
    transition: transform 0.12s, box-shadow 0.12s, opacity 0.12s;
  }
  .lfc-covers:hover .lfc-cover { opacity: 0.75; }
  .lfc-covers:hover .lfc-cover:hover {
    opacity: 1;
    transform: translateY(-3px);
    box-shadow: 0 6px 16px rgba(0,0,0,.35);
  }
  .lfc-cover-more {
    width: 46px;
    height: 62px;
    border-radius: 6px;
    background: var(--tag-bg);
    border: 1px solid var(--border);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-tertiary);
  }

  /* ── Footer ── */
  .lfc-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .lfc-badges {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .lfc-badge-ranked {
    font-size: 10px;
    font-weight: 700;
    color: var(--accent);
    background: rgba(96, 80, 200, 0.1);
    padding: 2px 8px;
    border-radius: 8px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .lfc-count {
    font-size: 12px;
    color: var(--text-tertiary);
  }
  .lfc-view-btn {
    font-size: 12px;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.12s;
    white-space: nowrap;
  }
  .lfc-view-btn:hover { opacity: 1; }
</style>
