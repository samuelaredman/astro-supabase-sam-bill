---
import { timeAgo } from '../utils/format';
import { IMAGE_EMOTE_MAP, IMAGE_EMOTES } from '../utils/reactions';

interface Props {
  id: string;
  title: string;
  description?: string | null;
  isRanked: boolean;
  entryCount: number;
  coverUrls: string[];
  ownerUsername: string;
  ownerAvatar?: string | null;
  createdAt: string;
  upVotes?: number;
  downVotes?: number;
  myVote?: number;
  commentCount?: number;
  reactions?: { reaction_type: string; profile_id: string }[];
  isLoggedIn?: boolean;
  currentProfileId?: string | null;
}

const {
  id, title, description, isRanked, entryCount,
  coverUrls, ownerUsername, ownerAvatar, createdAt,
  upVotes = 0, downVotes = 0, myVote = 0,
  commentCount = 0, reactions = [],
  isLoggedIn = false, currentProfileId = null,
} = Astro.props;

const initials = ownerUsername ? ownerUsername.slice(0, 2).toUpperCase() : '??';

// Build reaction display map
const reactionCountMap: Record<string, { count: number; active: boolean }> = {};
for (const r of reactions) {
  if (!reactionCountMap[r.reaction_type]) reactionCountMap[r.reaction_type] = { count: 0, active: false };
  reactionCountMap[r.reaction_type].count++;
  if (currentProfileId && r.profile_id === currentProfileId) reactionCountMap[r.reaction_type].active = true;
}
const displayReactions = Object.entries(reactionCountMap).map(([type, info]) => ({
  type,
  isImage: !!IMAGE_EMOTE_MAP[type],
  path: IMAGE_EMOTE_MAP[type] ?? null,
  count: info.count,
  active: info.active,
}));
---

<article class="lfc" data-list-id={id}>
  <div class="lfc-reviewer">
    <a href={`/reviewers/${ownerUsername}`} class="lfc-avatar">
      {ownerAvatar
        ? <img src={ownerAvatar} alt={ownerUsername} />
        : <span>{initials}</span>
      }
    </a>
    <a href={`/reviewers/${ownerUsername}`} class="lfc-reviewer-name">@{ownerUsername}</a>
    <span class="lfc-action">shared a list</span>
    <span class="lfc-dot">·</span>
    <span class="lfc-ts">{timeAgo(createdAt)}</span>
  </div>

  <a href={`/lists/${id}`} class="lfc-body-link">
    <div class="lfc-title">{title}</div>
    {description && (
      <p class="lfc-desc">{description}</p>
    )}
  </a>

  {coverUrls.length > 0 && (
    <a href={`/lists/${id}`} class="lfc-covers" aria-label="View list">
      {coverUrls.map(src => (
        <img class="lfc-cover" src={src} alt="" loading="lazy" />
      ))}
      {entryCount > coverUrls.length && (
        <div class="lfc-cover-more">+{entryCount - coverUrls.length}</div>
      )}
    </a>
  )}

  <div class="lfc-footer">
    <div class="lfc-badges">
      {isRanked && <span class="lfc-badge-ranked">Ranked</span>}
      <span class="lfc-count">{entryCount} {entryCount === 1 ? 'game' : 'games'}</span>
    </div>
    <a href={`/lists/${id}`} class="lfc-view-btn">
      {description ? 'Read more →' : 'View list →'}
    </a>
  </div>

  <!-- Vote / reaction / comment bar -->
  <div class="lfc-interact">
    <button
      class={`lfc-vote-btn${myVote === 1 ? ' lfc-vote-active-up' : ''}`}
      data-list-id={id}
      data-vote="1"
      data-logged-in={isLoggedIn ? 'true' : 'false'}
    >▲ {upVotes}</button>
    <button
      class={`lfc-vote-btn${myVote === -1 ? ' lfc-vote-active-down' : ''}`}
      data-list-id={id}
      data-vote="-1"
      data-logged-in={isLoggedIn ? 'true' : 'false'}
    >▼ {downVotes}</button>

    <span class="lfc-sep"></span>

    <div class="lfc-reaction-wrap" data-list-id={id}>
      {displayReactions.map(r => (
        <button
          class={`lfc-reaction-btn${r.active ? ' lfc-reaction-active' : ''}`}
          data-list-id={id}
          data-reaction={r.type}
          data-reacted={r.active ? 'true' : 'false'}
          data-count={r.count}
          data-logged-in={isLoggedIn ? 'true' : 'false'}
          data-is-image={r.isImage ? 'true' : 'false'}
        >
          {r.isImage
            ? <><img src={r.path!} class="lfc-emote-img" alt={r.type} />{' '}{r.count}</>
            : <>{r.type} {r.count}</>
          }
        </button>
      ))}
      <button class="lfc-react-toggle" data-list-id={id} data-logged-in={isLoggedIn ? 'true' : 'false'} title="React">+</button>
    </div>

    <a href={`/lists/${id}#comments`} class="lfc-comment-bubble">
      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14 10a2 2 0 0 1-2 2H5l-3 3V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v6z"/>
      </svg>
      {commentCount}
    </a>
  </div>
</article>

<script is:inline define:vars={{ _lfcImageEmotes: IMAGE_EMOTES, _lfcImageEmoteMap: IMAGE_EMOTE_MAP }}>
if (!window.__lfcPickerInit) {
  window.__lfcPickerInit = true;

  // ── Emoji picker ────────────────────────────────────────────────────────────
  var picker = document.createElement('div');
  picker.id = 'lfc-emoji-picker';
  picker.style.cssText = 'display:none;position:fixed;z-index:1000';
  var ph = '<input type="text" id="lfc-emote-search" class="lfc-emote-search" placeholder="Search emotes..." autocomplete="off">';
  ph += '<div class="lfc-emoji-grid" id="lfc-emote-grid">';
  _lfcImageEmotes.forEach(function(emote) {
    ph += '<button class="lfc-emoji-pick" data-emoji="' + emote.key + '" title="' + emote.key + '"><img src="' + emote.path + '" class="lfc-emote-picker-img" alt="' + emote.key + '"></button>';
  });
  ph += '</div>';
  picker.innerHTML = ph;
  document.body.appendChild(picker);

  document.getElementById('lfc-emote-search').addEventListener('input', function() {
    var q = this.value.toLowerCase();
    document.querySelectorAll('#lfc-emote-grid .lfc-emoji-pick').forEach(function(btn) {
      btn.style.display = btn.dataset.emoji.toLowerCase().indexOf(q) !== -1 ? '' : 'none';
    });
  });
}

if (!window.__lfcInit) {
  window.__lfcInit = true;

  function closeLfcPanels() {
    var picker = document.getElementById('lfc-emoji-picker');
    if (picker) {
      picker.style.display = 'none';
      var search = document.getElementById('lfc-emote-search');
      if (search) {
        search.value = '';
        document.querySelectorAll('#lfc-emote-grid .lfc-emoji-pick').forEach(function(btn) { btn.style.display = ''; });
      }
    }
  }

  function applyLfcReaction(listId, reactionType, reacted, count) {
    var isImage = !!_lfcImageEmoteMap[reactionType];
    var updated = false;
    document.querySelectorAll('.lfc-reaction-btn[data-list-id="' + listId + '"][data-reaction="' + reactionType + '"]').forEach(function(btn) {
      btn.dataset.reacted = reacted ? 'true' : 'false';
      btn.dataset.count = String(count);
      if (isImage) {
        btn.innerHTML = '<img src="' + _lfcImageEmoteMap[reactionType] + '" class="lfc-emote-img" alt="' + reactionType + '"> ' + count;
      } else {
        btn.textContent = reactionType + ' ' + count;
      }
      btn.classList.toggle('lfc-reaction-active', reacted);
      btn.style.display = count > 0 ? '' : 'none';
      updated = true;
    });
    if (!updated && count > 0) {
      var wrap = document.querySelector('.lfc-reaction-wrap[data-list-id="' + listId + '"]');
      if (wrap) {
        var toggle = wrap.querySelector('.lfc-react-toggle');
        var newBtn = document.createElement('button');
        newBtn.className = 'lfc-reaction-btn' + (reacted ? ' lfc-reaction-active' : '');
        newBtn.dataset.listId = listId;
        newBtn.dataset.reaction = reactionType;
        newBtn.dataset.reacted = reacted ? 'true' : 'false';
        newBtn.dataset.count = String(count);
        newBtn.dataset.loggedIn = 'true';
        newBtn.dataset.isImage = isImage ? 'true' : 'false';
        if (isImage) {
          newBtn.innerHTML = '<img src="' + _lfcImageEmoteMap[reactionType] + '" class="lfc-emote-img" alt="' + reactionType + '"> ' + count;
        } else {
          newBtn.textContent = reactionType + ' ' + count;
        }
        wrap.insertBefore(newBtn, toggle);
      }
    }
  }

  document.addEventListener('click', async function(e) {
    // Vote button
    var voteBtn = e.target.closest('.lfc-vote-btn');
    if (voteBtn) {
      if (voteBtn.disabled) return;
      var loggedIn = voteBtn.dataset.loggedIn === 'true';
      if (!loggedIn) { window.location.href = '/signin'; return; }
      voteBtn.disabled = true;
      var listId = voteBtn.dataset.listId;
      var vote = parseInt(voteBtn.dataset.vote);
      try {
        var res = await fetch('/api/lists/vote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ list_id: listId, vote }),
        });
        if (res.status === 401) { window.location.href = '/signin'; return; }
        if (!res.ok) return;
        var data = await res.json();
        document.querySelectorAll('.lfc-vote-btn[data-list-id="' + listId + '"]').forEach(function(b) {
          var bVote = parseInt(b.dataset.vote);
          var count = bVote === 1 ? data.up : data.down;
          b.textContent = (bVote === 1 ? '▲ ' : '▼ ') + count;
          b.classList.toggle('lfc-vote-active-up',   bVote === 1  && data.vote === 1);
          b.classList.toggle('lfc-vote-active-down', bVote === -1 && data.vote === -1);
        });
      } finally {
        voteBtn.disabled = false;
      }
      return;
    }

    // Inline reaction button
    var reactionBtn = e.target.closest('.lfc-reaction-btn');
    if (reactionBtn) {
      var loggedIn = reactionBtn.dataset.loggedIn === 'true';
      if (!loggedIn) { window.location.href = '/signin'; return; }
      var listId = reactionBtn.dataset.listId;
      var reaction = reactionBtn.dataset.reaction;
      var reacted = reactionBtn.dataset.reacted === 'true';
      var count = parseInt(reactionBtn.dataset.count) || 0;
      applyLfcReaction(listId, reaction, !reacted, reacted ? Math.max(0, count - 1) : count + 1);
      fetch('/api/lists/react', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ list_id: listId, reaction_type: reaction }),
      }).then(function(res) {
        if (res.status === 401) { window.location.href = '/signin'; return res.json(); }
        return res.json();
      }).then(function(data) {
        if (data) applyLfcReaction(listId, reaction, data.reacted, data.count);
      }).catch(function() {
        applyLfcReaction(listId, reaction, reacted, count);
      });
      return;
    }

    // React toggle (+) button
    var toggleBtn = e.target.closest('.lfc-react-toggle');
    if (toggleBtn) {
      var loggedIn = toggleBtn.dataset.loggedIn === 'true';
      if (!loggedIn) { window.location.href = '/signin'; return; }
      var listId = toggleBtn.dataset.listId;
      var picker = document.getElementById('lfc-emoji-picker');
      if (!picker) return;
      var isOpen = picker.style.display !== 'none' && picker.dataset.activeListId === listId;
      closeLfcPanels();
      if (!isOpen) {
        picker.dataset.activeListId = listId;
        picker.style.display = 'block';
        requestAnimationFrame(function() {
          var rect = toggleBtn.getBoundingClientRect();
          var pRect = picker.getBoundingClientRect();
          var top = rect.top - pRect.height - 8;
          if (top < 8) top = rect.bottom + 8;
          var left = rect.left;
          if (left + pRect.width > window.innerWidth - 8) left = window.innerWidth - pRect.width - 8;
          picker.style.top = top + 'px';
          picker.style.left = left + 'px';
          picker.querySelectorAll('.lfc-emoji-pick').forEach(function(btn) {
            var inlineBtn = document.querySelector('.lfc-reaction-btn[data-list-id="' + listId + '"][data-reaction="' + btn.dataset.emoji + '"]');
            btn.classList.toggle('lfc-emoji-active', !!(inlineBtn && inlineBtn.dataset.reacted === 'true'));
          });
        });
      }
      return;
    }

    // Pick from emoji picker
    var emojiBtn = e.target.closest('.lfc-emoji-pick');
    if (emojiBtn) {
      var picker = document.getElementById('lfc-emoji-picker');
      var listId = picker && picker.dataset.activeListId;
      if (!listId) return;
      var emoji = emojiBtn.dataset.emoji;
      var existing = document.querySelector('.lfc-reaction-btn[data-list-id="' + listId + '"][data-reaction="' + emoji + '"]');
      var reacted = existing ? existing.dataset.reacted === 'true' : false;
      var count = existing ? (parseInt(existing.dataset.count) || 0) : 0;
      applyLfcReaction(listId, emoji, !reacted, reacted ? Math.max(0, count - 1) : count + 1);
      closeLfcPanels();
      fetch('/api/lists/react', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ list_id: listId, reaction_type: emoji }),
      }).then(function(res) { return res.json(); })
        .then(function(data) { if (data) applyLfcReaction(listId, emoji, data.reacted, data.count); })
        .catch(function() { applyLfcReaction(listId, emoji, reacted, count); });
      return;
    }

    // Outside click
    if (!e.target.closest('.lfc-reaction-wrap') && !e.target.closest('#lfc-emoji-picker')) {
      closeLfcPanels();
    }
  });
}
</script>

<style is:global>
  .lfc {
    padding: 16px 20px 14px;
    border-bottom: 1px solid var(--border-subtle);
    transition: background 0.12s;
  }
  .lfc:last-child { border-bottom: none; }

  /* ── Reviewer row ── */
  .lfc-reviewer {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .lfc-avatar {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--tag-bg);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: 700;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .lfc-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lfc-reviewer-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.12s;
  }
  .lfc-reviewer-name:hover { color: var(--accent); }
  .lfc-action { font-size: 13px; color: var(--text-tertiary); }
  .lfc-dot { font-size: 13px; color: var(--text-tertiary); }
  .lfc-ts { font-size: 12px; color: var(--text-tertiary); }

  /* ── Body ── */
  .lfc-body-link {
    display: block;
    text-decoration: none;
    margin-bottom: 10px;
  }
  .lfc-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.2px;
    line-height: 1.3;
    margin-bottom: 5px;
    transition: color 0.12s;
  }
  .lfc-body-link:hover .lfc-title { color: var(--accent); }
  .lfc-desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  /* ── Cover strip ── */
  .lfc-covers {
    display: flex;
    gap: 6px;
    margin-bottom: 10px;
    overflow-x: auto;
    scrollbar-width: none;
    text-decoration: none;
  }
  .lfc-covers::-webkit-scrollbar { display: none; }
  .lfc-cover {
    width: 46px;
    height: 62px;
    border-radius: 6px;
    object-fit: cover;
    border: 1px solid var(--border);
    flex-shrink: 0;
    display: block;
    transition: transform 0.12s, box-shadow 0.12s, opacity 0.12s;
  }
  .lfc-covers:hover .lfc-cover { opacity: 0.75; }
  .lfc-covers:hover .lfc-cover:hover {
    opacity: 1;
    transform: translateY(-3px);
    box-shadow: 0 6px 16px rgba(0,0,0,.35);
  }
  .lfc-cover-more {
    width: 46px;
    height: 62px;
    border-radius: 6px;
    background: var(--tag-bg);
    border: 1px solid var(--border);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-tertiary);
  }

  /* ── Footer row ── */
  .lfc-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 10px;
  }
  .lfc-badges {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .lfc-badge-ranked {
    font-size: 10px;
    font-weight: 700;
    color: var(--accent);
    background: rgba(96, 80, 200, 0.1);
    padding: 2px 8px;
    border-radius: 8px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .lfc-count {
    font-size: 12px;
    color: var(--text-tertiary);
  }
  .lfc-view-btn {
    font-size: 12px;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.12s;
    white-space: nowrap;
  }
  .lfc-view-btn:hover { opacity: 1; }

  /* ── Interact bar ── */
  .lfc-interact {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
    padding-top: 6px;
    border-top: 1px solid var(--border-subtle);
  }
  .lfc-vote-btn {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 20px;
    border: 1.5px solid var(--border);
    color: var(--text-tertiary);
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s;
  }
  .lfc-vote-btn:hover:not(.lfc-vote-active-up):not(.lfc-vote-active-down) {
    border-color: var(--text-tertiary);
    color: var(--text-secondary);
    background: var(--bg-hover);
  }
  .lfc-vote-btn:disabled { opacity: 0.5; cursor: default; }
  .lfc-vote-active-up { border-color: #4ade80; color: #4ade80; background: rgba(74,222,128,.08); }
  .lfc-vote-active-down { border-color: #f87171; color: #f87171; background: rgba(248,113,113,.08); }
  .lfc-sep {
    width: 1px;
    height: 14px;
    background: var(--border);
    margin: 0 2px;
    flex-shrink: 0;
  }

  /* ── Reactions ── */
  .lfc-reaction-wrap {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    flex-wrap: wrap;
  }
  .lfc-reaction-btn {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 20px;
    border: 1.5px solid var(--border);
    color: var(--text-tertiary);
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s;
    white-space: nowrap;
    line-height: 1.5;
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }
  .lfc-reaction-btn:hover:not(.lfc-reaction-active) {
    border-color: var(--text-tertiary);
    color: var(--text-secondary);
    background: var(--bg-hover);
  }
  .lfc-reaction-active {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(99, 102, 241, 0.08);
  }
  .lfc-react-toggle {
    background: none;
    border: 1.5px solid var(--border);
    cursor: pointer;
    color: var(--text-secondary);
    font-size: 14px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 6px;
    line-height: 1.4;
    font-family: inherit;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }
  .lfc-react-toggle:hover { color: var(--text-primary); background: var(--bg-hover); border-color: var(--text-tertiary); }

  .lfc-emote-img { width: 18px; height: 18px; object-fit: contain; vertical-align: middle; }

  /* ── Comment bubble ── */
  .lfc-comment-bubble {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: var(--text-tertiary);
    background: var(--tag-bg);
    border: 1px solid var(--border);
    padding: 3px 9px;
    border-radius: 20px;
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
    margin-left: auto;
    font-weight: 500;
  }
  .lfc-comment-bubble:hover { color: var(--text-secondary); border-color: var(--text-tertiary); }

  /* ── Shared emoji picker (lfc) ── */
  #lfc-emoji-picker {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 10px 12px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.2);
    max-height: 320px;
    overflow-y: auto;
    min-width: 260px;
    max-width: 320px;
    scrollbar-width: thin;
  }
  .lfc-emote-search {
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 8px;
    padding: 5px 8px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--bg-hover);
    color: var(--text-primary);
    font-size: 12px;
    outline: none;
  }
  .lfc-emoji-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
  }
  .lfc-emoji-pick {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 6px;
    transition: background 0.1s, transform 0.1s;
    padding: 2px;
  }
  .lfc-emoji-pick:hover { background: var(--bg-hover); transform: scale(1.2); }
  .lfc-emoji-pick.lfc-emoji-active { background: rgba(96,80,200,.12); outline: 1.5px solid var(--accent); }
  .lfc-emote-picker-img { width: 28px; height: 28px; object-fit: contain; display: block; }
</style>
