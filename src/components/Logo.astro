---
// The pixel wordmark used in the sidebar, detail nav, list editor, profile,
// and auth pages. Centralised so the file path, intrinsic dimensions and
// `fetchpriority="high"` only ever live in one place — every usage is
// above the fold, so prioritising its download is always the right default.
//
// `width`/`height` match the source file's natural pixel count (689×96) so
// the aspect ratio the browser infers is exact; the caller's CSS sizes the
// element down to its display width.
interface Props {
  class?: string;
  fetchpriority?: 'high' | 'low' | 'auto';
}
const { class: className, fetchpriority = 'high' } = Astro.props;
---
<img
  src="/chekpoint-logo.webp"
  alt="Chekpoint"
  class={className}
  width="689"
  height="96"
  decoding="async"
  fetchpriority={fetchpriority}
/>
