---
/**
 * One review in the group feed, with the viewer's own score above it.
 *
 * That line is what the tab exists for: "you gave this a 10, they gave it a 3"
 * is a reply waiting to happen, and it can only be written from two scores the
 * site holds. Its own component so the first page and an appended page render
 * it from one place.
 */
import ReviewCard from "../ReviewCard.astro";
import { scoreClass } from "../../utils/format";
import { scoreComparison } from "../../utils/groupFeed";

interface Props {
  review: any;
  /** The viewer's own published score for this game, if they have one. */
  viewerScore?: number;
  viewerProfileId: string | null;
  isLoggedIn: boolean;
}
const { review, viewerScore, viewerProfileId, isLoggedIn } = Astro.props;

const isOwn = review.profiles?.id != null && review.profiles.id === viewerProfileId;
const comparison = isOwn ? null : scoreComparison(viewerScore, review.score);

const verdict = comparison && (comparison.gap === 0
  ? "you agreed"
  : `${comparison.gap} point${comparison.gap === 1 ? "" : "s"} apart — ${
      comparison.verdict === "close" ? "you were close" : "you disagreed"}`);
---

<div class="gf-item">
  {comparison && viewerScore != null && (
    <div class={`gf-compare gf-compare-${comparison.verdict}`}>
      <span class="gf-compare-label">You gave it</span>
      <span class={`score-badge ${scoreClass(viewerScore)}`}>{viewerScore}</span>
      <span class="gf-compare-verdict">{verdict}</span>
    </div>
  )}
  {isOwn && <div class="gf-own">Your review</div>}
  <ReviewCard
    review={review}
    isLoggedIn={isLoggedIn}
    isOwnProfile={isOwn}
    showGame={true}
    showReviewer={true}
    showVotes={true}
    currentProfileId={viewerProfileId}
  />
</div>
