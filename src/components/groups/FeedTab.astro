---
/**
 * The group Feed tab: what the group has been reviewing, newest first, headed by
 * the argument of the day.
 *
 * Rendered by the group page for the first page, and by the partial route
 * /groups/[id]/feed for a filter change or the next page, from the same
 * loadGroupFeed() data. `appendOnly` emits the items with no chrome around them,
 * which is what "Load more" appends to the list. Behaviour is delegated from
 * src/scripts/group-feed.ts; styles live in the group page's global block, like
 * the other group tab components.
 */
import DailyDisagreement from "./DailyDisagreement.astro";
import FeedItem from "./FeedItem.astro";
import {
  FEED_FILTERS, FEED_FILTER_EMPTY, FEED_FILTER_LABELS, type GroupFeedData,
} from "../../utils/groupFeed";

interface Props {
  data: GroupFeedData;
  groupId: string;
  isMember: boolean;
  isLoggedIn: boolean;
  /** Appending the next page: emit the items alone, no chrome. */
  appendOnly?: boolean;
}
const { data, groupId, isMember, isLoggedIn, appendOnly = false } = Astro.props;
const { reviews, viewerScores, viewerProfileId, filter, nextOffset, disagreement } = data;

const items = reviews.map((review: any) => ({
  review,
  viewerScore: review.games?.id ? viewerScores[review.games.id] : undefined,
}));
---

{appendOnly ? (
  <>
    {items.map(({ review, viewerScore }) => (
      <FeedItem review={review} viewerScore={viewerScore} viewerProfileId={viewerProfileId} isLoggedIn={isLoggedIn} />
    ))}
    {/* The button the appended page replaces, carrying the offset after it */}
    {nextOffset != null && (
      <button type="button" class="gf-more" data-gf-more={nextOffset}>Load more</button>
    )}
  </>
) : (
  <div class="gf-root" data-gf-root data-gf-group={groupId} data-gf-filter={filter}>
    {disagreement && (
      <DailyDisagreement
        disagreement={disagreement}
        groupId={groupId}
        isMember={isMember}
        isLoggedIn={isLoggedIn}
      />
    )}

    {viewerProfileId && (
      <div class="gf-filters" role="group" aria-label="Filter the feed">
        {FEED_FILTERS.map((f) => (
          <button
            type="button"
            class={`gf-filter${f === filter ? " gf-filter-on" : ""}`}
            data-gf-filter-btn={f}
            aria-pressed={f === filter ? "true" : "false"}
          >{FEED_FILTER_LABELS[f]}</button>
        ))}
      </div>
    )}

    <div class="gf-list" data-gf-list>
      {items.map(({ review, viewerScore }) => (
        <FeedItem review={review} viewerScore={viewerScore} viewerProfileId={viewerProfileId} isLoggedIn={isLoggedIn} />
      ))}
      {reviews.length === 0 && <div class="empty-tab">{FEED_FILTER_EMPTY[filter]}</div>}
      {nextOffset != null && (
        <button type="button" class="gf-more" data-gf-more={nextOffset}>Load more</button>
      )}
    </div>

    <div class="gf-error" data-gf-error hidden>Couldn't load the feed. Try again.</div>
  </div>
)}
