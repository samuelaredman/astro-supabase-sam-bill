---
/**
 * The argument of the day, at the head of the group feed: one game two members
 * scored far apart, and a side for everyone else to take.
 *
 * The pick is derived from the group and the date in group_daily_disagreement(),
 * so it's the same for everyone all day and rotates on its own. Voting is
 * delegated from src/scripts/group-feed.ts; styles live in the group page's
 * global block, like the other group tab components.
 */
import { igdbImage as igdbCover, scoreClass } from "../../utils/format";
import { votePercents, type DailyDisagreement } from "../../utils/groupFeed";

interface Props {
  disagreement: DailyDisagreement;
  groupId: string;
  isMember: boolean;
  isLoggedIn: boolean;
}
const { disagreement: d, groupId, isMember, isLoggedIn } = Astro.props;

const pct = votePercents(d.high.votes, d.low.votes);
const voted = d.myVote != null;
const initials = (name: string) => (name ?? "?").slice(0, 2).toUpperCase();
const sides = [
  { side: d.high, key: "high" as const, pct: pct.high },
  { side: d.low, key: "low" as const, pct: pct.low },
];
---

<div
  class="dd-card"
  data-dd-root
  data-dd-group={groupId}
  data-dd-day={d.day}
  data-dd-game={d.game.id}
  data-dd-voted={d.myVote ?? ""}
>
  <div class="dd-head">
    <span class="dd-kicker">Today's disagreement</span>
    <span class="dd-spread">{d.spread} points apart</span>
  </div>

  <a class="dd-game" href={`/games/${d.game.slug}`}>
    {igdbCover(d.game.cover_img_url, "t_cover_small")
      ? <img class="dd-cover" src={igdbCover(d.game.cover_img_url, "t_cover_small")!} alt="" loading="lazy" />
      : <div class="dd-cover"></div>}
    <span class="dd-game-title">{d.game.title}</span>
  </a>

  <div class="dd-sides">
    {sides.map(({ side, key, pct: share }) => (
      <div class={`dd-side dd-side-${key}${d.myVote === side.profile.id ? " dd-side-mine" : ""}`}>
        <div class="dd-side-head">
          <span class="dd-av">
            {side.profile.avatar_url
              ? <img src={side.profile.avatar_url} alt="" loading="lazy" />
              : initials(side.profile.username)}
          </span>
          <a class="dd-name" href={`/reviewers/${side.profile.username}`}>@{side.profile.username}</a>
          {side.isViewer && <span class="dd-you">you</span>}
          <span class={`score-badge ${scoreClass(side.score)}`}>{side.score}</span>
        </div>

        <a class="dd-read" href={`/reviews/${side.reviewId}`}>Read their review →</a>

        {isMember && !side.isViewer && (
          <button
            type="button"
            class={`dd-vote${d.myVote === side.profile.id ? " dd-vote-on" : ""}`}
            data-dd-vote={side.profile.id}
            data-dd-username={side.profile.username}
            aria-pressed={d.myVote === side.profile.id ? "true" : "false"}
          >
            {d.myVote === side.profile.id ? "You're with them" : `Side with @${side.profile.username}`}
          </button>
        )}
        {isMember && side.isViewer && (
          <div class="dd-own">That's your review — let them argue it out.</div>
        )}

        <div class="dd-result" data-dd-result={side.profile.id} hidden={!voted}>
          <div class="dd-bar">
            <span class="dd-bar-fill" data-dd-bar style={`width:${share}%`}></span>
          </div>
          <span class="dd-pct">
            <span data-dd-pct>{share}</span>% · <span data-dd-votes>{side.votes}</span> votes
          </span>
        </div>
      </div>
    ))}
  </div>

  <div class="dd-foot">
    {!isLoggedIn && <a href="/signup" class="dd-cta">Sign up to take a side</a>}
    {isLoggedIn && !isMember && <span class="dd-note">Join the group to take a side.</span>}
    {isMember && <span class="dd-note" data-dd-prompt hidden={voted}>Pick a side to see how the group voted.</span>}
    {isMember && (
      <span class="dd-note" data-dd-tallied hidden={!voted}>
        <span data-dd-total>{d.totalVotes}</span> voted today. New disagreement tomorrow.
      </span>
    )}
    <span class="dd-error" data-dd-error hidden>Couldn't save your vote. Try again.</span>
  </div>
</div>
