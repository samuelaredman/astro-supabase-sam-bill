---
/**
 * The group Stats tab: you vs the community, or you vs one member you pick
 * (the creator, say). A stat card for each side with what they share between
 * them, the score and genre charts, and three short lists: where you disagree
 * most, where you agree, and what they love that you haven't reviewed.
 *
 * Rendered both by the group page (first paint) and by the partial route
 * /groups/[id]/compare that the "compare with" menu re-fetches, from the same
 * loadGroupVersus() data — see src/utils/groupCompare.ts. Styles live in the
 * page's global block, like the other group tab components, so markup swapped
 * in later is styled. Behaviour is delegated from src/scripts/group-compare.ts.
 */
import { igdbImage as igdbCover, scoreClass } from "../../utils/format";
import StatRows from "./StatRows.astro";
import {
  agreementLabel,
  shortGenre,
  signedScore,
  type GroupVersusData,
  type TapeTile,
  type VersusGameRow,
  type VersusMember,
} from "../../utils/groupCompare";

interface Props {
  data: GroupVersusData;
  /** The group being compared — the menu re-fetches /groups/<id>/compare. */
  groupId: string;
  /** Shown between the stat cards when the group has a genre/platform focus. */
  focusLabel?: string | null;
}
const { data, groupId, focusLabel } = Astro.props;
const {
  subject, opponent, options, viewerIsGuest, minReviews, failed, sharedGames,
  meanAbsDiff, agreementPct, disagreements, agreements, unreviewed, card, tape,
} = data;

const initials = (name: string) => (name ?? "?").slice(0, 2).toUpperCase();
const plural = (n: number, word: string) => `${n.toLocaleString()} ${word}${n === 1 ? "" : "s"}`;

const subjectName = subject ? (subject.isViewer ? "You" : `@${subject.username}`) : "";
const otherName = opponent ? `@${opponent.username}` : "the community";
const otherShort = opponent ? `@${opponent.username}` : "Community";
const optionLabel = (m: VersusMember) => `@${m.username}${m.isOwner ? " (owner)" : ""}`;

const badge = (score: number | null) => (score != null ? scoreClass(Math.round(score)) : "");
const fmt = (score: number | null) =>
  score == null ? "—" : Number.isInteger(score) ? String(score) : score.toFixed(1);
const cover = (g: VersusGameRow) => igdbCover(g.game.cover_img_url, "t_thumb");

// ── Score histogram ──
const reviewsLabel = (n: number) => `${n.toLocaleString()} review${n === 1 ? "" : "s"}`;
const shareLabel = (share: number) => `${Math.round(share)}%`;
/** Readouts near the edges open inwards so they stay inside the card. */
const tipSide = (score: number) => (score <= 2 ? " gv-hist-tip-start" : score >= 9 ? " gv-hist-tip-end" : "");

// ── Genre radar geometry (SVG units) ──
const RADAR = { w: 300, h: 230, cx: 150, cy: 117, r: 78 };
const radarAngle = (i: number, n: number) => -Math.PI / 2 + (2 * Math.PI * i) / n;
const radarPoint = (i: number, n: number, value: number, scale: number) => {
  const a = radarAngle(i, n);
  const d = (Math.min(value, scale) / scale) * RADAR.r;
  return { x: RADAR.cx + Math.cos(a) * d, y: RADAR.cy + Math.sin(a) * d };
};
const pts = (list: { x: number; y: number }[]) => list.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(" ");
function radar(t: Extract<TapeTile, { kind: "radar" }>) {
  const n = t.axes.length;
  const rings = [1 / 3, 2 / 3, 1].map((f) => pts(t.axes.map((_, i) => radarPoint(i, n, f * t.scale, t.scale))));
  const spokes = t.axes.map((_, i) => radarPoint(i, n, t.scale, t.scale));
  const left = t.axes.map((a, i) => radarPoint(i, n, a.left, t.scale));
  const right = t.axes.map((a, i) => radarPoint(i, n, a.right, t.scale));
  const labels = t.axes.map((a, i) => {
    const ang = radarAngle(i, n);
    const cos = Math.cos(ang), sin = Math.sin(ang);
    return {
      text: shortGenre(a.genre),
      full: a.genre,
      x: RADAR.cx + cos * (RADAR.r + 12),
      y: RADAR.cy + sin * (RADAR.r + 12) + (sin > 0.5 ? 9 : sin < -0.5 ? -3 : 4),
      anchor: cos > 0.3 ? "start" : cos < -0.3 ? "end" : "middle",
    };
  });
  return { rings, spokes, left, right, labels };
}

// Possessives and "hasn't" built here rather than in the markup, where nested
// template strings with apostrophes trip the Astro parser
const subjectHasnt = subject?.isViewer ? "you haven't" : `${subjectName} hasn't`;
const subjectGames = subject?.isViewer ? "your" : `${subjectName}'s`;
const others = minReviews === 1 ? "another member" : `${minReviews}+ other members`;
const emptyMessage = !subject
  ? ""
  : failed
    ? "Stats couldn't be loaded right now. Try again in a moment."
    : subject.reviewCount === 0
    ? `${subject.isViewer ? "You haven't" : `${subjectName} hasn't`} reviewed any games in this group yet.`
    : opponent
      ? `${subjectName} and ${otherName} haven't reviewed any of the same games yet.`
      : `None of ${subjectGames} games has been reviewed by ${others} yet. Try comparing with a member instead.`;

const lists: { title: string; rows: VersusGameRow[]; showDiff: boolean; showSubject: boolean }[] = [
  { title: "Biggest disagreements", rows: disagreements, showDiff: true, showSubject: true },
  { title: "Where you agree", rows: agreements, showDiff: false, showSubject: true },
  {
    title: `${opponent ? `@${opponent.username}` : "The community"} loves, ${subjectHasnt} reviewed`,
    rows: unreviewed, showDiff: false, showSubject: false,
  },
];
---

<div class="gv-root" data-gv-group={groupId}>
  {!subject ? (
    <div class="empty-tab">Nobody in this group has reviewed a game yet.</div>
  ) : (
    <>
      {/* ── Stat cards: each side's own numbers, with what they share in the middle ── */}
      <div class="gv-head">
        <section class="gv-card gv-card-l" aria-label={`${subjectName}'s stats`}>
          <div class="gv-card-top">
            <span class="gv-av">
              {subject.avatar_url ? <img src={subject.avatar_url} alt="" loading="lazy" /> : initials(subject.username)}
            </span>
            <span class="gv-name">{subjectName}</span>
          </div>
          {card && <StatRows rows={card} side="left" />}
        </section>

        <div class="gv-mid">
          <span class="gv-vs">vs</span>
          {sharedGames === 0 ? (
            <p class="gv-mid-empty">{emptyMessage}</p>
          ) : (
            <>
              {meanAbsDiff != null && <div class="gv-verdict-title">{agreementLabel(meanAbsDiff)}</div>}
              <dl class="gv-mid-facts">
                <div><dt>Shared games</dt><dd>{sharedGames.toLocaleString()}</dd></div>
                <div><dt>Within a point</dt><dd>{agreementPct}%</dd></div>
                <div><dt>Avg gap</dt><dd>{meanAbsDiff != null ? meanAbsDiff.toFixed(1) : "—"}</dd></div>
              </dl>
            </>
          )}
          {focusLabel && <span class="gv-mid-focus">{focusLabel}</span>}
        </div>

        <section class="gv-card gv-card-r" aria-label={`${otherShort} stats`}>
          <div class="gv-card-top">
            <span class="gv-av">
              {opponent
                ? (opponent.avatar_url ? <img src={opponent.avatar_url} alt="" loading="lazy" /> : initials(opponent.username))
                : <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>}
            </span>
            <label class="gv-pick">
              <span class="gv-pick-lbl">Compare with</span>
              <select class="gv-select" data-gv-with aria-label="Compare with">
                <option value="" selected={!opponent}>The community</option>
                {options.length > 0 && (
                  <optgroup label="Members">
                    {options.map((m) => (
                      <option value={m.id} selected={opponent?.id === m.id}>{optionLabel(m)}</option>
                    ))}
                  </optgroup>
                )}
              </select>
            </label>
          </div>
          {card && <StatRows rows={card} side="right" />}
        </section>
      </div>

      {viewerIsGuest && (
        <div class="gv-note">Showing {subjectName}. Join the group and review a few games to compare yourself.</div>
      )}

      {/* ── Charts: each side's own habits, no shared games needed ── */}
      {tape.length > 0 && (
        <section class="gv-tape">
          <div class="gv-tape-head">
            <span class="gv-tape-title">How you play</span>
            <span class="gv-key">
              <span class="gv-key-item"><i class="gv-dot gv-dot-l"></i>{subjectName}</span>
              <span class="gv-key-item"><i class="gv-dot gv-dot-r"></i>{otherShort}</span>
            </span>
          </div>
          <div class="gv-tiles">
            {tape.map((t) => (
              <div class={`gv-tile gv-tile-${t.kind}`}>
                <div class="gv-tile-label"><span class="gv-tile-icon" aria-hidden="true">{t.icon}</span>{t.label}</div>

                {t.kind === "dist" && (
                  <>
                    <div class="gv-hist-key">
                      <span><i class="gv-dot gv-dot-l"></i><strong>{subjectName}</strong> avg {t.leftAvg?.toFixed(1) ?? "—"} · {reviewsLabel(t.leftTotal)}</span>
                      <span><i class="gv-dot gv-dot-r"></i><strong>{otherShort}</strong> avg {t.rightAvg?.toFixed(1) ?? "—"} · {reviewsLabel(t.rightTotal)}</span>
                    </div>
                    <div class="gv-hist">
                      <div class="gv-hist-axis" aria-hidden="true">
                        <span style="bottom:100%">{t.scale}%</span>
                        <span style="bottom:50%">{t.scale / 2}%</span>
                        <span style="bottom:0">0%</span>
                      </div>
                      <div class="gv-hist-plot">
                        <i class="gv-hist-grid" style="bottom:100%" aria-hidden="true"></i>
                        <i class="gv-hist-grid" style="bottom:50%" aria-hidden="true"></i>
                        {t.left.map((l, i) => {
                          const r = t.right[i];
                          return (
                            <div
                              class="gv-hist-col"
                              tabindex="0"
                              aria-label={`Score ${i + 1}: ${subjectName} ${shareLabel(l)} (${reviewsLabel(t.leftCounts[i])}), ${otherShort} ${shareLabel(r)} (${reviewsLabel(t.rightCounts[i])})`}
                            >
                              <div class={`gv-hist-tip${tipSide(i + 1)}`} aria-hidden="true">
                                <strong>Score {i + 1}</strong>
                                <span><i class="gv-dot gv-dot-l"></i>{subjectName} {shareLabel(l)} · {reviewsLabel(t.leftCounts[i])}</span>
                                <span><i class="gv-dot gv-dot-r"></i>{otherShort} {shareLabel(r)} · {reviewsLabel(t.rightCounts[i])}</span>
                              </div>
                              <span class="gv-hist-bar gv-hist-l" style={`height:${(l / t.scale) * 100}%`} aria-hidden="true">
                                {l >= 1 && <b>{shareLabel(l)}</b>}
                              </span>
                              <span class="gv-hist-bar gv-hist-r" style={`height:${(r / t.scale) * 100}%`} aria-hidden="true">
                                {r >= 1 && <b>{shareLabel(r)}</b>}
                              </span>
                            </div>
                          );
                        })}
                      </div>
                      <div class="gv-hist-xs" aria-hidden="true">
                        {t.left.map((_, i) => <span><em class={scoreClass(i + 1)}>{i + 1}</em></span>)}
                      </div>
                    </div>
                    <div class="gv-tile-note">Bar height is the share of each side's own reviews at that score. {t.headline}.</div>
                  </>
                )}

                {t.kind === "radar" && (() => {
                  const g = radar(t);
                  return (
                    <>
                      <svg class="gv-radar" viewBox={`0 0 ${RADAR.w} ${RADAR.h}`} role="img" aria-label={`Top genres: ${t.axes.map((a) => `${a.genre} ${subjectName} ${a.left}%, ${otherShort} ${a.right}%`).join("; ")}`}>
                        {g.rings.map((ring) => <polygon class="gv-radar-ring" points={ring} />)}
                        {g.spokes.map((p) => <line class="gv-radar-spoke" x1={RADAR.cx} y1={RADAR.cy} x2={p.x} y2={p.y} />)}
                        <polygon class="gv-radar-area gv-radar-r" points={pts(g.right)} />
                        <polygon class="gv-radar-area gv-radar-l" points={pts(g.left)} />
                        {t.axes.map((a, i) => (
                          <g class="gv-radar-axis">
                            <title>{`${a.genre}: ${subjectName} ${a.left}% · ${otherShort} ${a.right}%`}</title>
                            <circle class="gv-radar-dot gv-radar-r" cx={g.right[i].x} cy={g.right[i].y} r="3.5" />
                            <circle class="gv-radar-dot gv-radar-l" cx={g.left[i].x} cy={g.left[i].y} r="3.5" />
                            <text class="gv-radar-label" x={g.labels[i].x} y={g.labels[i].y} text-anchor={g.labels[i].anchor}>{g.labels[i].text}</text>
                          </g>
                        ))}
                      </svg>
                      <table class="gv-sr">
                        <caption>Share of each side's reviews by genre</caption>
                        <thead><tr><th>Genre</th><th>{subjectName}</th><th>{otherShort}</th></tr></thead>
                        <tbody>{t.axes.map((a) => <tr><td>{a.genre}</td><td>{a.left}%</td><td>{a.right}%</td></tr>)}</tbody>
                      </table>
                      <div class="gv-tile-note">Share of reviews in each genre · outer ring {t.scale}%</div>
                    </>
                  );
                })()}

                {t.kind === "pick" && (t.same ? (
                  <div class="gv-fav-same">
                    <span class="gv-fav-val">{t.left!.value}</span>
                    <span class="gv-same">Same pick</span>
                  </div>
                ) : (
                  <div class="gv-favs">
                    {[{ side: t.left, cls: "gv-dot-l" }, { side: t.right, cls: "gv-dot-r" }].map(({ side, cls }) => (
                      <div class="gv-fav">
                        <i class={`gv-dot ${cls}`}></i>
                        <span class="gv-fav-name">{side ? side.value : "—"}</span>
                        {side?.sub && <span class="gv-fav-sub">{side.sub}</span>}
                      </div>
                    ))}
                  </div>
                ))}

              </div>
            ))}
          </div>
        </section>
      )}

      {/* ── The lists ── */}
      {lists.filter((l) => l.rows.length > 0).map((list) => (
        <section class="gv-list">
          <div class="gv-list-head">
            <span class="gv-list-title">{list.title}</span>
            <span class="gv-cols" aria-hidden="true">
              {list.showSubject && (
                <span class="gv-col" title={subjectName}>
                  <span class="gv-col-av">{subject.avatar_url ? <img src={subject.avatar_url} alt="" loading="lazy" /> : initials(subject.username)}</span>
                </span>
              )}
              <span class="gv-col" title={opponent ? `@${opponent.username}` : "Community average"}>
                {opponent
                  ? <span class="gv-col-av">{opponent.avatar_url ? <img src={opponent.avatar_url} alt="" loading="lazy" /> : initials(opponent.username)}</span>
                  : "Avg"}
              </span>
              {list.showDiff && <span class="gv-col gv-col-diff"></span>}
            </span>
          </div>
          {list.rows.map((g) => (
            <a class="gv-row" href={`/games/${g.game.slug}`}>
              {cover(g) ? <img class="gv-cover" src={cover(g)!} alt="" loading="lazy" /> : <span class="gv-cover"></span>}
              <span class="gv-title">{g.game.title}</span>
              <span class="gv-cols">
                {list.showSubject && <span class={`score-badge ${badge(g.subjectScore)}`}>{fmt(g.subjectScore)}</span>}
                <span
                  class={`score-badge ${badge(g.otherScore)}`}
                  title={opponent ? undefined : `Average of ${plural(g.otherCount, "review")}`}
                >{fmt(g.otherScore)}</span>
                {list.showDiff && g.diff != null && (
                  <span class={`gv-diff ${g.diff > 0 ? "gv-diff-up" : "gv-diff-down"}`}>{signedScore(g.diff)}</span>
                )}
              </span>
            </a>
          ))}
        </section>
      ))}

      <div class="gv-error" data-gv-error hidden>Couldn't load that comparison. Try again.</div>
    </>
  )}
</div>
