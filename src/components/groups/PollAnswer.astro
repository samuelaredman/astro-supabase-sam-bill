---
/**
 * One written answer to a featured game's question on the Games tab
 * (GamesTab.astro): who wrote it, its upvotes, and its replies, which open under
 * it. Upvoting, replying and removing are src/scripts/group-games.ts; the CSS
 * lives in the group page's global block.
 */
import { timeAgo } from "../../utils/format";
import { POLL_REPLY_MAX, type FeaturedAnswer } from "../../utils/groupFeaturedGames";

interface Props {
  answer: FeaturedAnswer;
  viewerProfileId: string | null;
  isMember: boolean;
  /** The question is closed: no new replies. */
  closed: boolean;
  /** Can remove others' answers and replies (the question's author, admins). */
  canModerate: boolean;
}
const { answer: a, viewerProfileId, isMember, closed, canModerate } = Astro.props;
const initials = (name: string) => (name ?? "?").slice(0, 2).toUpperCase();
const isMine = a.profileId === viewerProfileId;
const canUpvote = isMember && !isMine;
---

<li class="gg-answer" data-answer-id={a.id}>
  <a class="member-avatar gg-answer-avatar" href={`/reviewers/${a.username}`}>
    {a.avatarUrl ? <img src={a.avatarUrl} alt="" loading="lazy" /> : initials(a.username)}
  </a>
  <div class="gg-answer-main">
    <div class="gg-answer-head">
      <a href={`/reviewers/${a.username}`} class="gg-answer-name">@{a.username}</a>
      <span class="gg-answer-time">{timeAgo(a.createdAt)}{a.edited ? " · edited" : ""}</span>
      {canModerate && !isMine && (
        <button type="button" class="announcement-action gg-answer-remove" data-gg-action="delete-answer" data-id={a.id}>Remove</button>
      )}
    </div>
    <p class="gg-answer-body">{a.body}</p>

    <div class="gg-answer-actions-row">
      <button type="button" class="gg-upvote" data-gg-action="upvote" data-id={a.id}
        aria-pressed={a.myUpvote ? "true" : "false"} disabled={!canUpvote}
        title={isMine ? "Your answer" : isMember ? (a.myUpvote ? "Remove your upvote" : "Upvote") : "Join the group to upvote"}>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 4l8 10h-5v6H9v-6H4z"/></svg>
        <span class="gg-upvote-count">{a.upvotes}</span>
      </button>
      <button type="button" class="gg-reply-toggle" data-gg-action="replies" data-id={a.id} aria-expanded="false">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg>
        {a.replies.length > 0 ? `${a.replies.length} ${a.replies.length === 1 ? "reply" : "replies"}` : "Reply"}
      </button>
    </div>

    <div class="gg-replies" data-gg-replies={a.id} hidden>
      {a.replies.length > 0 && (
        <ul class="gg-reply-list">
          {a.replies.map((r) => (
            <li class="gg-reply">
              <a class="member-avatar gg-reply-avatar" href={`/reviewers/${r.username}`}>
                {r.avatarUrl ? <img src={r.avatarUrl} alt="" loading="lazy" /> : initials(r.username)}
              </a>
              <div class="gg-answer-main">
                <div class="gg-answer-head">
                  <a href={`/reviewers/${r.username}`} class="gg-answer-name">@{r.username}</a>
                  <span class="gg-answer-time">{timeAgo(r.createdAt)}</span>
                  {(r.profileId === viewerProfileId || canModerate) && (
                    <button type="button" class="announcement-action gg-answer-remove" data-gg-action="delete-reply" data-id={r.id}>
                      {r.profileId === viewerProfileId ? "Delete" : "Remove"}
                    </button>
                  )}
                </div>
                <p class="gg-answer-body">{r.body}</p>
              </div>
            </li>
          ))}
        </ul>
      )}
      {isMember && !closed && (
        <form class="gg-reply-form" data-gg-reply={a.id}>
          <input class="compose-input gg-input" name="body" type="text" maxlength={POLL_REPLY_MAX} placeholder={`Reply to @${a.username}…`} />
          <button type="submit" class="btn-copy gg-small-btn">Reply</button>
          <p class="gg-error" hidden></p>
        </form>
      )}
    </div>
  </div>
</li>
