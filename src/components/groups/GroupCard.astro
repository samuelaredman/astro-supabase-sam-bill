---
/**
 * One group on the /groups list: its banner (or a gradient in the group's own
 * colour), avatar, the covers of the games it reviews most, a few members and
 * how active it is. The caller fills the "badge" slot (role, Request →, …).
 */
import { igdbImage, timeAgo } from "../../utils/format";
import { groupGradient } from "../../utils/groupTheme";

export interface GroupCardSummary {
  covers: string[];
  member_avatars: { username: string; avatar_url: string }[];
  reviews_week: number;
  last_review_at: string | null;
}

interface Props {
  group: {
    id: string;
    name: string;
    description?: string | null;
    avatar_url?: string | null;
    banner_url?: string | null;
    banner_position?: string | null;
  };
  memberCount: number;
  summary?: GroupCardSummary;
  isPrivate?: boolean;
}
const { group, memberCount, summary, isPrivate = false } = Astro.props;

const gradient = groupGradient(group.id);
const bannerStyle = group.banner_url
  ? `background-image:url('${group.banner_url}');background-position:${group.banner_position ?? "center"}`
  : `background-image:${gradient}`;

const covers = (summary?.covers ?? []).map((c) => igdbImage(c, "t_cover_small")).filter(Boolean) as string[];
const avatars = summary?.member_avatars ?? [];
const extraMembers = Math.max(0, memberCount - avatars.length);

let activity: string;
let isActive = false;
if (summary && summary.reviews_week > 0) {
  activity = `${summary.reviews_week} review${summary.reviews_week === 1 ? "" : "s"} this week`;
  isActive = true;
} else if (summary?.last_review_at) {
  activity = `Last review ${timeAgo(summary.last_review_at)} ago`;
} else {
  activity = "No reviews yet";
}
---

<a class="gcard" href={`/groups/${group.id}`}>
  <div class="gcard-banner" style={bannerStyle}></div>
  <div class="gcard-body">
    <div class="gcard-head">
      <div class="gcard-avatar" style={group.avatar_url ? undefined : `background:${gradient}`}>
        {group.avatar_url ? <img src={group.avatar_url} alt="" loading="lazy" /> : group.name.slice(0, 2).toUpperCase()}
      </div>
      <div class="gcard-badge"><slot name="badge" /></div>
    </div>

    <div class="gcard-name">
      {isPrivate && <span class="gcard-lock" aria-label="Private">🔒</span>}
      {group.name}
    </div>
    <div class="gcard-meta">
      {memberCount} member{memberCount !== 1 ? "s" : ""}
      <slot name="meta" />
    </div>
    {group.description && <p class="gcard-desc">{group.description}</p>}

    {covers.length > 0 ? (
      <div class="gcard-covers" aria-label="Most reviewed games">
        {covers.map((src) => <img src={src} alt="" loading="lazy" />)}
      </div>
    ) : (
      <div class="gcard-covers empty" aria-hidden="true">
        {[0, 1, 2, 3].map(() => <span style={`background-image:${gradient}`}></span>)}
      </div>
    )}

    <div class="gcard-foot">
      {avatars.length > 0 && (
        <div class="gcard-members">
          {avatars.map((m) => <img src={m.avatar_url} alt={`@${m.username}`} title={`@${m.username}`} loading="lazy" />)}
          {extraMembers > 0 && <span class="gcard-more">+{extraMembers > 999 ? `${Math.floor(extraMembers / 1000)}k` : extraMembers}</span>}
        </div>
      )}
      <span class:list={["gcard-activity", { active: isActive }]} title={activity}>{activity}</span>
    </div>
  </div>
</a>

<style>
  .gcard { --gcard-live:#15803d; display:flex; flex-direction:column; background:var(--bg-card); border:1px solid var(--border); border-radius:16px; overflow:hidden; text-decoration:none; color:inherit; transition:transform .15s, border-color .15s, box-shadow .15s; min-width:0; }
  .gcard:hover { transform:translateY(-2px); border-color:var(--accent); box-shadow:var(--shadow-md); }
  .gcard-banner { height:88px; background-size:cover; background-repeat:no-repeat; flex-shrink:0; }
  .gcard-body { padding:0 16px 14px; display:flex; flex-direction:column; flex:1; min-width:0; }
  .gcard-head { display:flex; align-items:flex-end; justify-content:space-between; gap:8px; margin-top:-26px; margin-bottom:10px; }
  .gcard-avatar { width:56px; height:56px; border-radius:14px; border:3px solid var(--bg-card); display:flex; align-items:center; justify-content:center; font-family:'DM Serif Display',serif; font-size:20px; color:#fff; overflow:hidden; flex-shrink:0; background:var(--bg-card); }
  .gcard-avatar img { width:100%; height:100%; object-fit:cover; }
  .gcard-badge { padding-bottom:2px; }
  .gcard-name { font-size:16px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .gcard-lock { margin-right:5px; }
  .gcard-meta { font-size:12px; color:var(--text-tertiary); display:flex; align-items:center; gap:8px; margin-top:2px; flex-wrap:wrap; }
  .gcard-desc { font-size:13px; color:var(--text-secondary); line-height:1.45; margin:8px 0 0; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .gcard-covers { display:grid; grid-template-columns:repeat(4, 1fr); gap:6px; margin-top:12px; }
  .gcard-covers img { width:100%; aspect-ratio:3/4; object-fit:cover; border-radius:6px; background:var(--tag-bg); }
  .gcard-foot { display:flex; align-items:center; gap:10px; margin-top:auto; padding-top:12px; }
  .gcard-members { display:flex; align-items:center; }
  .gcard-members img, .gcard-more { width:24px; height:24px; border-radius:50%; border:2px solid var(--bg-card); object-fit:cover; margin-left:-7px; }
  .gcard-members img:first-child { margin-left:0; }
  .gcard-more { display:inline-flex; align-items:center; justify-content:center; background:var(--tag-bg); color:var(--text-secondary); font-size:10px; font-weight:600; width:auto; min-width:24px; padding:0 5px; border-radius:12px; box-sizing:border-box; }
  .gcard-activity { font-size:12px; color:var(--text-tertiary); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .gcard-activity.active { color:var(--gcard-live); font-weight:500; }
  .gcard-activity.active::before { content:""; display:inline-block; width:6px; height:6px; border-radius:50%; background:currentColor; margin-right:6px; vertical-align:1px; }
  :global(:root[data-theme="dark"]) .gcard { --gcard-live:#4ade80; }
  .gcard-covers.empty span { aspect-ratio:3/4; border-radius:6px; background-size:cover; opacity:.18; }
</style>
