---
/**
 * One group on the /groups list: its banner (or a gradient in the group's own
 * colour) fills the card, with avatar, name, members and activity floating
 * over a scrim. The caller fills the "badge" slot (role, Request →, …).
 */
import { timeAgo } from "../../utils/format";
import { groupGradient } from "../../utils/groupTheme";

export interface GroupCardSummary {
  covers: string[];
  member_avatars: { username: string; avatar_url: string }[];
  reviews_week: number;
  last_review_at: string | null;
}

interface Props {
  group: {
    id: string;
    name: string;
    description?: string | null;
    avatar_url?: string | null;
    banner_url?: string | null;
    banner_position?: string | null;
  };
  memberCount: number;
  summary?: GroupCardSummary;
  isPrivate?: boolean;
}
const { group, memberCount, summary, isPrivate = false } = Astro.props;

const gradient = groupGradient(group.id);
const bannerStyle = group.banner_url
  ? `background-image:url('${group.banner_url}');background-position:${group.banner_position ?? "center"}`
  : `background-image:${gradient}`;

const avatars = summary?.member_avatars ?? [];
const extraMembers = Math.max(0, memberCount - avatars.length);

let activity: string;
let isActive = false;
if (summary && summary.reviews_week > 0) {
  activity = `${summary.reviews_week} review${summary.reviews_week === 1 ? "" : "s"} this week`;
  isActive = true;
} else if (summary?.last_review_at) {
  activity = `Last review ${timeAgo(summary.last_review_at)} ago`;
} else {
  activity = "No reviews yet";
}
---

<a class="gcard" href={`/groups/${group.id}`} style={bannerStyle}>
  <div class="gcard-scrim"></div>
  <div class="gcard-top">
    <div class="gcard-avatar" style={group.avatar_url ? undefined : `background:${gradient}`}>
      {group.avatar_url ? <img src={group.avatar_url} alt="" loading="lazy" /> : group.name.slice(0, 2).toUpperCase()}
    </div>
    <div class="gcard-badge"><slot name="badge" /></div>
  </div>
  <div class="gcard-body">
    <div class="gcard-name">
      {isPrivate && <span class="gcard-lock" aria-label="Private">🔒</span>}
      {group.name}
    </div>
    <div class="gcard-meta">
      <span>{memberCount} member{memberCount !== 1 ? "s" : ""}</span>
      <slot name="meta" />
    </div>
    <div class="gcard-foot">
      {avatars.length > 0 && (
        <div class="gcard-members">
          {avatars.map((m) => <img src={m.avatar_url} alt={`@${m.username}`} title={`@${m.username}`} loading="lazy" />)}
          {extraMembers > 0 && <span class="gcard-more">+{extraMembers > 999 ? `${Math.floor(extraMembers / 1000)}k` : extraMembers}</span>}
        </div>
      )}
      <span class:list={["gcard-activity", { active: isActive }]} title={activity}>{activity}</span>
    </div>
  </div>
</a>

<style>
  .gcard { --gcard-live:#4ade80; position:relative; display:flex; flex-direction:column; justify-content:space-between; min-height:200px; padding:14px; border-radius:18px; overflow:hidden; text-decoration:none; color:#fff; background-size:cover; background-position:center; isolation:isolate; transition:transform .18s ease, box-shadow .18s ease; min-width:0; }
  .gcard:hover { transform:translateY(-3px); box-shadow:0 12px 28px rgba(0,0,0,.35); }
  .gcard-scrim { position:absolute; inset:0; background:linear-gradient(180deg, rgba(0,0,0,.15) 0%, rgba(0,0,0,.25) 45%, rgba(0,0,0,.82) 100%); z-index:-1; }
  .gcard-top { display:flex; align-items:flex-start; justify-content:space-between; gap:8px; }
  .gcard-avatar { width:46px; height:46px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-family:'DM Serif Display',serif; font-size:17px; color:#fff; overflow:hidden; flex-shrink:0; background:rgba(0,0,0,.35); backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px); box-shadow:0 2px 8px rgba(0,0,0,.25); }
  .gcard-avatar img { width:100%; height:100%; object-fit:cover; }
  .gcard-badge { display:flex; align-items:center; }
  .gcard-body { display:flex; flex-direction:column; gap:4px; }
  .gcard-name { font-size:17px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; text-shadow:0 1px 3px rgba(0,0,0,.5); }
  .gcard-lock { margin-right:5px; }
  .gcard-meta { font-size:12px; color:rgba(255,255,255,.78); display:flex; align-items:center; gap:8px; flex-wrap:wrap; text-shadow:0 1px 2px rgba(0,0,0,.4); }
  .gcard-foot { display:flex; align-items:center; gap:10px; margin-top:8px; }
  .gcard-members { display:flex; align-items:center; }
  .gcard-members img, .gcard-more { width:22px; height:22px; border-radius:50%; border:2px solid rgba(0,0,0,.55); object-fit:cover; margin-left:-7px; }
  .gcard-members img:first-child { margin-left:0; }
  .gcard-more { display:inline-flex; align-items:center; justify-content:center; background:rgba(255,255,255,.18); color:#fff; font-size:10px; font-weight:600; width:auto; min-width:22px; padding:0 5px; border-radius:11px; box-sizing:border-box; backdrop-filter:blur(4px); -webkit-backdrop-filter:blur(4px); }
  .gcard-activity { font-size:11px; color:rgba(255,255,255,.7); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; text-shadow:0 1px 2px rgba(0,0,0,.4); }
  .gcard-activity.active { color:var(--gcard-live); font-weight:500; }
  .gcard-activity.active::before { content:""; display:inline-block; width:6px; height:6px; border-radius:50%; background:currentColor; margin-right:6px; vertical-align:1px; box-shadow:0 0 6px currentColor; }
</style>
