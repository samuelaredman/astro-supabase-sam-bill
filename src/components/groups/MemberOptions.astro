---
/**
 * The options in the Stats tab's "compare with" picker: the community, then
 * members. Rendered inside CompareTab, and on its own by
 * /groups/[id]/compare?part=members&q= when someone searches the picker
 * (src/scripts/group-compare.ts swaps it in).
 */
import type { VersusMember } from "../../utils/groupCompare";

interface Props {
  members: VersusMember[];
  /** The current pick; null is the community. */
  selectedId: string | null;
  /** What was searched, for the empty message; omitted for the usual list. */
  query?: string;
}
const { members, selectedId, query } = Astro.props;
const initials = (name: string) => (name ?? "?").slice(0, 2).toUpperCase();
---

<div class="gv-pick-options" data-gv-pick-options>
  <button type="button" role="option" class="gv-pick-opt" data-gv-with-id="" aria-selected={selectedId ? "false" : "true"}>
    <span class="gv-pick-av gv-pick-av-group" aria-hidden="true">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    </span>
    <span class="gv-pick-name">The community</span>
  </button>
  <div class="gv-pick-group" role="presentation">Members</div>
  {members.length === 0 ? (
    <div class="gv-pick-empty" role="presentation">{query ? `No members match “${query}”` : "No other members yet"}</div>
  ) : members.map((m) => (
    <button
      type="button"
      role="option"
      class="gv-pick-opt"
      data-gv-with-id={m.id}
      data-gv-name={m.username.toLowerCase()}
      aria-selected={m.id === selectedId ? "true" : "false"}
    >
      <span class="gv-pick-av" aria-hidden="true">{m.avatar_url ? <img src={m.avatar_url} alt="" loading="lazy" /> : initials(m.username)}</span>
      <span class="gv-pick-name">@{m.username}</span>
      {m.isOwner && <span class="gv-pick-tag">owner</span>}
    </button>
  ))}
</div>
