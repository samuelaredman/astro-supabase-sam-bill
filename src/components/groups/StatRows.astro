---
/**
 * One side's stats on the Stats tab: the rows of a stat card (buildStatCard()
 * in src/utils/groupCompare.ts). Both cards render the same rows in the same
 * order, so the two sides line up across the middle column.
 */
import { scoreClass } from "../../utils/format";
import type { StatCardRow } from "../../utils/groupCompare";

interface Props {
  rows: StatCardRow[];
  side: "left" | "right";
}
const { rows, side } = Astro.props;
---

<dl class="gv-stats">
  {rows.map((row) => {
    const v = row[side];
    const n = Number(v.value);
    return (
      <div class="gv-stat">
        <dt>{row.label}</dt>
        <dd>
          <span class={`gv-stat-val${row.score && Number.isFinite(n) ? ` gv-stat-score ${scoreClass(n)}` : ""}`}>{v.value}</span>
          {v.sub && <span class="gv-stat-sub">{v.sub}</span>}
        </dd>
      </div>
    );
  })}
</dl>
