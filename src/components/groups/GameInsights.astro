---
/**
 * A featured game's ratings (how the group's scores split across 1–10, hover a
 * bar for its count) and achievements meter, on the Games tab
 * (GamesTab.astro): under the video, or in the stats panel when there's none.
 * Styles live in the group page's global block.
 */
import { scoreClass } from "../../utils/format";
import type { FeaturedGame } from "../../utils/groupFeaturedGames";

interface Props {
  fg: FeaturedGame;
}
const { fg } = Astro.props;
const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;
const max = Math.max(...fg.scoreCounts);
---

<div class="gg-bottom">
  {/* How the group's scores split across 1–10 */}
  <div class="gg-dist">
    <div class="gg-mini-head">Ratings <span>{plural(fg.stats.reviewCount, "review")}</span></div>
    <div class="gg-dist-bars">
      {fg.scoreCounts.map((n, idx) => (
        <span class={`gg-dist-bar${n > 0 ? ` ${scoreClass(idx + 1)}` : ""}`} tabindex="0"
          data-tip={`${plural(n, "member")} gave it ${idx + 1}`}
          style={`--h:${max > 0 ? Math.max(n > 0 ? 8 : 4, (n / max) * 100) : 4}%`}>
          <span class="gg-dist-n">{idx + 1}</span>
        </span>
      ))}
    </div>
  </div>
  {/* Achievements, as a meter */}
  <div class="gg-ach">
    <div class="gg-mini-head">Achievements <span>{fg.stats.achievementCount > 0 ? `${fg.stats.achievementCount} synced` : "none synced"}</span></div>
    <div class="gg-ach-val">{fg.stats.avgAchievementPct != null ? `${fg.stats.avgAchievementPct}%` : "—"}<small>avg unlocked</small></div>
    <div class="gg-ach-track"><span style={`width:${fg.stats.avgAchievementPct ?? 0}%`}></span></div>
  </div>
</div>
