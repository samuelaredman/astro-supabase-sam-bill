<!-- Drop this component on any page where own-review editing is needed. -->
<!-- Trigger: call openEditModal(data) — see rc-edit-btn handler in ReviewCard.astro -->

<style is:global>
  .em-field   { display: flex; flex-direction: column; gap: 6px; }
  .em-row     { display: flex; gap: 12px; align-items: flex-end; }
  .em-label   { font-size: 11px; font-weight: 600; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.5px; }
  .em-input, .em-select {
    background: var(--bg); border: 1px solid var(--border); border-radius: 8px;
    padding: 9px 12px; font-size: 14px; font-family: inherit; color: var(--text-primary);
    width: 100%; outline: none; transition: border-color 0.15s;
  }
  .em-input:focus, .em-select:focus { border-color: var(--text-secondary); }
  .em-textarea {
    background: var(--bg); border: 1px solid var(--border); border-radius: 8px;
    padding: 9px 12px; font-size: 14px; font-family: inherit; color: var(--text-primary);
    width: 100%; outline: none; resize: vertical; min-height: 110px;
    transition: border-color 0.15s; line-height: 1.5;
  }
  .em-textarea:focus { border-color: var(--text-secondary); }
  .em-actions { display: flex; align-items: center; gap: 12px; padding-top: 4px; }
  .em-spoiler { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--text-secondary); cursor: pointer; }
  .em-submit  {
    padding: 8px 18px; border-radius: 20px; border: none;
    background: var(--accent); color: var(--accent-text);
    font-size: 14px; font-weight: 500; font-family: inherit;
    cursor: pointer; transition: opacity 0.15s;
  }
  .em-submit:hover    { opacity: 0.85; }
  .em-submit:disabled { opacity: 0.45; cursor: not-allowed; }
  .em-error { font-size: 13px; color: #c0392b; min-height: 18px; margin-top: 8px; }
  .em-game-locked {
    font-size: 14px; font-weight: 500; padding: 9px 12px;
    background: var(--tag-bg); border: 1px solid var(--border);
    border-radius: 8px; color: var(--text-secondary);
  }
</style>

<div id="editOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:150"></div>

<div id="editModal" style="display:none;position:fixed;top:80px;left:50%;transform:translateX(-50%);width:520px;max-width:calc(100vw - 32px);background:var(--bg-card);border:1px solid var(--border);border-radius:16px;z-index:160;padding:24px;overflow-y:auto;max-height:calc(100dvh - 100px)">

  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
    <div style="font-size:17px;font-weight:500;letter-spacing:-0.2px">Edit review</div>
    <button id="closeEditBtn" style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--text-tertiary);line-height:1;padding:4px">×</button>
  </div>

  <!-- Game (locked) -->
  <div class="em-field">
    <label class="em-label">Game</label>
    <div id="editGameName" class="em-game-locked"></div>
    <input type="hidden" id="editReviewId" />
    <input type="hidden" id="editGameId" />
  </div>

  <!-- Score -->
  <div class="em-field" style="margin-top:12px">
    <label class="em-label">Score</label>
    <div style="display:flex;align-items:center;gap:8px">
      <input type="number" id="editScore" class="em-input" placeholder="0.0" min="0.1" max="10" step="0.1" style="width:90px" />
      <span style="font-size:15px;color:var(--text-tertiary);font-family:'DM Serif Display',serif">/ 10</span>
    </div>
  </div>

  <!-- Title -->
  <div class="em-field" style="margin-top:12px">
    <label class="em-label">Title</label>
    <input type="text" id="editTitle" class="em-input" placeholder="Sum it up in a line..." maxlength="120" />
  </div>

  <!-- Body -->
  <div class="em-field" style="margin-top:12px">
    <label class="em-label">Review</label>
    <textarea id="editBody" class="em-textarea" placeholder="Write your review..." rows="5" maxlength="5000"></textarea>
    <div style="text-align:right;font-size:11px;color:var(--text-tertiary);margin-top:4px" id="editCharCount">0 / 5000</div>
  </div>

  <!-- Platform + Hours -->
  <div class="em-row" style="margin-top:12px">
    <div class="em-field" style="flex:1">
      <label class="em-label">Platform played on</label>
      <select id="editPlatform" class="em-select">
        <option value="">Select platform...</option>
      </select>
    </div>
    <div class="em-field" style="width:120px">
      <label class="em-label">Hours played</label>
      <input type="number" id="editHours" class="em-input" placeholder="0" min="0" max="9999" />
    </div>
  </div>

  <!-- Spoilers + Submit -->
  <div class="em-actions" style="margin-top:14px">
    <label class="em-spoiler">
      <input type="checkbox" id="editSpoilers" />
      <span>Contains spoilers</span>
    </label>
    <div style="display:flex;gap:8px;margin-left:auto">
      <button class="em-submit" id="saveEditBtn">Save changes</button>
    </div>
  </div>
  <div class="em-error" id="editError"></div>
</div>

<script is:inline>
  function openEditModal(data) {
    document.getElementById('editReviewId').value  = data.reviewId;
    document.getElementById('editGameId').value    = data.gameId;
    document.getElementById('editGameName').textContent = data.gameTitle;
    document.getElementById('editScore').value     = data.score;
    document.getElementById('editTitle').value     = data.title;
    document.getElementById('editBody').value      = data.body;
    document.getElementById('editHours').value     = data.hours;
    document.getElementById('editSpoilers').checked = data.spoilers;
    document.getElementById('editError').textContent = '';

    var count = (data.body || '').length;
    var charEl = document.getElementById('editCharCount');
    charEl.textContent = count + ' / 5000';
    charEl.style.color = count > 4500 ? (count >= 5000 ? '#c0392b' : '#e67e22') : 'var(--text-tertiary)';

    document.getElementById('editModal').style.display = 'block';
    document.getElementById('editOverlay').style.display = 'block';
    if (window.__lockScroll) window.__lockScroll();

    _loadEditPlatforms(data.gameId, data.platformId);
  }

  function closeEditModal() {
    document.getElementById('editModal').style.display = 'none';
    document.getElementById('editOverlay').style.display = 'none';
    if (window.__unlockScroll) window.__unlockScroll();
  }

  async function _loadEditPlatforms(gameId, selectedId) {
    var sel = document.getElementById('editPlatform');
    sel.innerHTML = '<option value="">Loading...</option>';
    try {
      var res = await fetch('/api/games/platforms?id=' + gameId);
      var platforms = await res.json();
      if (!platforms.length) {
        sel.innerHTML = '<option value="">Any platform</option>';
      } else {
        sel.innerHTML = '<option value="">Select platform...</option>' +
          platforms.map(function(p) {
            return '<option value="' + p.id + '"' + (p.id === selectedId ? ' selected' : '') + '>' + p.name + '</option>';
          }).join('');
      }
    } catch (e) {
      sel.innerHTML = '<option value="">Could not load platforms</option>';
    }
  }

  document.getElementById('closeEditBtn').addEventListener('click', closeEditModal);
  document.getElementById('editOverlay').addEventListener('click', closeEditModal);

  document.getElementById('editBody').addEventListener('input', function() {
    var count = this.value.length;
    var el = document.getElementById('editCharCount');
    el.textContent = count + ' / 5000';
    el.style.color = count > 4500 ? (count >= 5000 ? '#c0392b' : '#e67e22') : 'var(--text-tertiary)';
  });

  document.getElementById('saveEditBtn').addEventListener('click', async function() {
    var reviewId  = document.getElementById('editReviewId').value;
    var score     = document.getElementById('editScore').value;
    var title     = document.getElementById('editTitle').value.trim();
    var body      = document.getElementById('editBody').value.trim();
    var platform  = document.getElementById('editPlatform').value;
    var hours     = document.getElementById('editHours').value;
    var spoilers  = document.getElementById('editSpoilers').checked;
    var errorEl   = document.getElementById('editError');
    var btn       = document.getElementById('saveEditBtn');

    errorEl.textContent = '';
    if (!score || parseFloat(score) < 0.1 || parseFloat(score) > 10) {
      errorEl.textContent = 'Please enter a score between 0.1 and 10.'; return;
    }
    if (!title)  { errorEl.textContent = 'Please add a title.'; return; }
    if (!body)   { errorEl.textContent = 'Please write a review.'; return; }
    if (body.length > 5000) { errorEl.textContent = 'Review must be at most 5000 characters.'; return; }

    btn.disabled = true;
    btn.textContent = 'Saving...';

    try {
      var res = await fetch('/api/reviews/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          review_id: reviewId,
          score: parseFloat(score),
          title: title,
          body: body,
          platform_played_on: platform || null,
          play_time_hours: hours ? parseInt(hours) : null,
          contains_spoilers: spoilers,
        }),
      });
      var data = await res.json();
      if (!res.ok) {
        errorEl.textContent = data.error ?? 'Something went wrong.';
        btn.disabled = false;
        btn.textContent = 'Save changes';
      } else {
        closeEditModal();
        window.location.reload();
      }
    } catch (e) {
      errorEl.textContent = 'Network error. Please try again.';
      btn.disabled = false;
      btn.textContent = 'Save changes';
    }
  });
</script>
