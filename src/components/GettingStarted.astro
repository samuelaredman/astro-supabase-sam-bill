---
// "Getting started" onboarding checklist. Reflects real completion state and
// launches the per-step spotlight tour (via TourManager's window.startTour).
// Renders nothing once all three steps are done.
interface Props {
  hasAvatar: boolean;
  hasBio: boolean;
  hasFavorite: boolean;
  hasReview: boolean;
  variant?: 'sidebar' | 'welcome';
}
const { hasAvatar, hasBio, hasFavorite, hasReview, variant = 'sidebar' } = Astro.props;

const steps = [
  { key: 'avatar', label: 'Add a profile picture', done: hasAvatar },
  { key: 'bio', label: 'Write a short bio', done: hasBio },
  { key: 'favorite', label: 'Pick a favorite game', done: hasFavorite },
  { key: 'review', label: 'Write your first review', done: hasReview },
];
const doneCount = steps.filter((s) => s.done).length;
const allDone = doneCount === steps.length;
---

{!allDone && (
  <div class={`gs ${variant === 'welcome' ? 'gs-welcome' : 'gs-sidebar widget'}`}>
    <div class="gs-head">
      <div class="gs-title">Getting started</div>
      <div class="gs-progress">{doneCount}/{steps.length}</div>
    </div>
    <div class="gs-list">
      {steps.map((s) => (
        <div class={`gs-row ${s.done ? 'gs-done' : ''}`}>
          <span class="gs-check" aria-hidden="true">
            {s.done
              ? <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 4L6 12L3 9"/></svg>
              : <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6.25"/></svg>
            }
          </span>
          <span class="gs-label">{s.label}</span>
          {!s.done && <button class="gs-cta" data-start-tour={s.key} type="button">Show me how</button>}
        </div>
      ))}
    </div>
  </div>
)}

<style is:global>
  .gs-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 12px; }
  .gs-title { font-size: 14px; font-weight: 600; color: var(--text-primary); }
  .gs-progress { font-size: 12px; font-weight: 600; color: var(--accent); background: var(--accent-subtle); padding: 2px 8px; border-radius: 10px; }
  .gs-list { display: flex; flex-direction: column; gap: 2px; }
  .gs-row { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--border-subtle); }
  .gs-row:last-child { border-bottom: none; }
  .gs-check { flex-shrink: 0; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; color: var(--text-tertiary); }
  .gs-row.gs-done .gs-check { color: #4ade80; }
  .gs-label { flex: 1; font-size: 13px; color: var(--text-secondary); }
  .gs-row.gs-done .gs-label { color: var(--text-tertiary); text-decoration: line-through; }
  .gs-cta { flex-shrink: 0; font-size: 12px; font-weight: 500; font-family: inherit; color: var(--accent); background: none; border: none; cursor: pointer; padding: 3px 6px; border-radius: 6px; transition: background 0.15s; }
  .gs-cta:hover { background: var(--accent-subtle); }

  /* Welcome-page variant: larger standalone block */
  .gs-welcome {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px;
    padding: 22px 24px; box-shadow: var(--shadow);
  }
  .gs-welcome .gs-title { font-size: 16px; }
  .gs-welcome .gs-row { padding: 12px 0; }
  .gs-welcome .gs-label { font-size: 15px; color: var(--text-primary); }
  .gs-welcome .gs-cta { font-size: 13px; padding: 6px 12px; border: 1px solid var(--border); border-radius: 8px; }
  .gs-welcome .gs-cta:hover { border-color: var(--accent); }
</style>
