---
// Markup moved verbatim from src/pages/reviewers/[username].astro — the page
// renders it for the tab in the URL, /reviewers/[username]/tab/[tab] for the
// rest. Data comes from src/utils/profileTabs.ts. Styles are the page's
// is:global styles.
import ReviewCard from '../ReviewCard.astro';
import { timeAgo, scoreClass, igdbImage as igdbCover } from '../../utils/format';
import type { ReviewsTabData } from '../../utils/profileTabs';

interface Props {
  data: ReviewsTabData;
  reviewer: { username: string };
  isLoggedIn: boolean;
  isOwnProfile: boolean;
  currentProfileId: string | null;
}
const { data, reviewer, isLoggedIn, isOwnProfile, currentProfileId } = Astro.props;
const { reviewFilterItems, reviewGenres, reviewPlatforms, reviewDevs } = data;
---
  {reviewFilterItems.length === 0 ? (
    <div class="empty-state">
      <div class="empty-title">No reviews yet</div>
      <p style="font-size:14px;color:var(--text-tertiary)">@{reviewer.username} hasn't posted any reviews.</p>
      {isOwnProfile && <a class="tab-add-btn" href="/?compose=review" style="margin-top:14px">+ Write a review</a>}
    </div>
  ) : (
    <>
      <div class="sort-tabs">
        <button class="sort-tab review-view-tab active" onclick="switchReviewView('overview',this)">Overview</button>
        <button class="sort-tab review-view-tab" onclick="switchReviewView('detailed',this)">Detailed</button>
        {isOwnProfile && <a class="tab-add-btn" style="margin-left:auto" href="/?compose=review">+ Write a review</a>}
      </div>

      <div class="lf-bar">
        <input class="lf-search" type="text" placeholder="Search reviews…" oninput="searchReviews(this.value)" />
        <select class="lf-select" onchange="setReviewSort(this.value)">
          <option value="az" selected>A–Z</option>
          <option value="recent">Recent</option>
          <option value="oldest">Oldest</option>
          <option value="highest">Highest Rated</option>
          <option value="lowest">Lowest Rated</option>
          <option value="most-upvoted">Most Upvoted</option>
          <option value="most-downvoted">Most Downvoted</option>
        </select>
        {reviewGenres.length > 0 && (
          <select class="lf-select" onchange="setReviewFilter('genre',this.value,this)">
            <option value="">All Genres</option>
            {reviewGenres.map((g: string) => <option value={g}>{g}</option>)}
          </select>
        )}
        {reviewPlatforms.length > 0 && (
          <select class="lf-select" onchange="setReviewFilter('platform',this.value,this)">
            <option value="">All Platforms</option>
            {reviewPlatforms.map((p: string) => <option value={p}>{p}</option>)}
          </select>
        )}
        {reviewDevs.length > 0 && (
          <select class="lf-select" onchange="setReviewFilter('dev',this.value,this)">
            <option value="">All Devs</option>
            {reviewDevs.map((d: string) => <option value={d}>{d}</option>)}
          </select>
        )}
      </div>

      <div id="reviewsList" style="display:none">
        {reviewFilterItems.map((it: any) => (
          <div
            class="rev-filter-item"
            data-title={it.searchText}
            data-sort-title={it.sortTitle}
            data-genres={it.genres.join(',')}
            data-devs={it.devs.join(',')}
            data-platform={it.platform}
            data-score={it.score}
            data-date={it.date}
            data-upvotes={it.up}
            data-downvotes={it.down}
          >
            <ReviewCard
              review={it.review}
              isLoggedIn={isLoggedIn}
              isOwnProfile={isOwnProfile}
              showGame={true}
              showReviewer={false}
              currentProfileId={currentProfileId}
            />
          </div>
        ))}
      </div>
      <div class="list-no-results" id="reviews-dt-no-results" style="display:none">No reviews match these filters.</div>

      <div class="reviews-overview-grid" id="reviewsOverviewList">
        {reviewFilterItems.map((it: any) => {
          const review = it.review
          const cover = igdbCover(review.games?.cover_img_url, 't_thumb')
          return (
            <div
              class="rev-filter-item"
              data-title={it.searchText}
              data-sort-title={it.sortTitle}
              data-genres={it.genres.join(',')}
              data-devs={it.devs.join(',')}
              data-platform={it.platform}
              data-score={it.score}
              data-date={it.date}
              data-upvotes={it.up}
              data-downvotes={it.down}
            >
              <a href={`/reviews/${review.id}`} class={`review-overview-card rov-${scoreClass(review.score).replace('score-', '')}`}>
                {cover ? <img class="rov-cover" src={cover} alt="" loading="lazy" /> : <div class="rov-cover" />}
                <div class="rov-body">
                  <span class="rov-title">{review.games?.title ?? 'Unknown game'}</span>
                  <span class="rov-date">{timeAgo(review.published_at ?? review.created_at)}</span>
                </div>
                <span class="rov-score">{review.score}</span>
              </a>
            </div>
          )
        })}
      </div>
      <div class="list-no-results" id="reviews-ov-no-results" style="display:none">No reviews match these filters.</div>
    </>
  )}
