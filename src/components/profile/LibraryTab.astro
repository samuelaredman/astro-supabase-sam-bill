      .ach-detail-bar{flex:1;height:5px;border-radius:3px;background:var(--tag-bg);overflow:hidden}
      .ach-detail-bar-fill{height:100%;border-radius:3px;background:var(--score-great,#4ade80);transition:width .25s}
      .ach-detail-pct{font-size:13px;font-weight:600;color:var(--score-great,#4ade80);flex-shrink:0;min-width:42px;text-align:right}
      .ach-detail-rarity{display:flex;gap:10px;padding:0 20px 10px;flex-wrap:wrap}
      .ach-detail-rarity-chip{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;color:var(--text-secondary)}
      .ach-detail-rarity-dot{width:9px;height:9px;border-radius:50%;display:inline-block}
      .ach-detail-rarity-dot--platinum{background:#9b7bff}
      .ach-detail-rarity-dot--gold{background:#f5b544}
      .ach-detail-rarity-dot--silver{background:#c4c6cd}
      .ach-detail-rarity-dot--bronze{background:#cd7f32}
      .ach-detail-search-wrap{padding:4px 20px 12px}
      .ach-detail-search{width:100%;background:var(--bg-hover);border:1px solid var(--border);border-radius:10px;padding:9px 14px;font-size:13px;font-family:inherit;color:var(--text-primary);outline:none;transition:border-color .15s}
      .ach-detail-search:focus{border-color:var(--accent)}
      .ach-detail-body{flex:1;overflow-y:auto;padding:0 10px 14px;scrollbar-width:thin}
      .ach-row{display:flex;align-items:center;gap:12px;padding:10px;border-bottom:1px solid var(--border-subtle)}
      .ach-row:last-child{border-bottom:none}
      .ach-row-icon{position:relative;width:48px;height:48px;border-radius:8px;background:var(--tag-bg);border:1px solid var(--border);flex-shrink:0;overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:18px}
      .ach-row-icon img{width:100%;height:100%;object-fit:cover;display:block}
      .ach-row.locked .ach-row-icon img{filter:grayscale(1) brightness(.55);opacity:.75}
      /* Rare — < 5% global rarity. Modelled on the TF2 "Sunbeams" Unusual:
         long linear ray shafts of varying length radiating from a warm
         golden core, with sharp pointed tips and a visibly ragged outline
         (not clean petals). Built from three independent layers at
         progressively larger radii — short, mid and long — each with its
         own beam count, rotation speed and come-in / go-out fade phase.
         Shafts are near-rectangular (not bells) and keep full intensity
         along most of their length before dropping to 0 at the tip. */
      .ach-row-icon--rare{overflow:visible;border-color:rgba(234,179,8,.75);
        box-shadow:
          0 0 12px rgba(253,224,71,.55),
          0 0 26px rgba(234,179,8,.4),
          0 0 48px rgba(202,138,4,.22);
      }
      .ach-row-icon--rare img{border-radius:7px}
      .ach-row.locked .ach-row-icon--rare{
        box-shadow:
          0 0 10px rgba(234,179,8,.3),
          0 0 22px rgba(202,138,4,.15);
      }

      /* ── Layer A — short rays, 8 beams every 45°, inset -16px.
         Mask holds full opacity from 54% to 78% before dropping to 0 by 86%,
         which gives each beam a hard-edged shaft with a pointed tip. ── */
      .ach-row-icon--rare::before{
        content:'';
        position:absolute;inset:-16px;border-radius:50%;
        filter:blur(1px);
        mask:radial-gradient(circle,transparent 48%,rgba(0,0,0,1) 54%,rgba(0,0,0,1) 78%,transparent 86%);
        -webkit-mask:radial-gradient(circle,transparent 48%,rgba(0,0,0,1) 54%,rgba(0,0,0,1) 78%,transparent 86%);
        z-index:0;pointer-events:none;
        background:conic-gradient(
          from 0deg,
          rgba(253,224,71,1)   0deg,   rgba(253,224,71,0) 2deg,
          rgba(255,208,120,0)  43deg,  rgba(255,208,120,1) 45deg,  rgba(255,208,120,0) 47deg,
          rgba(253,224,71,0)   88deg,  rgba(253,224,71,1)  90deg,  rgba(253,224,71,0)  92deg,
          rgba(255,208,120,0)  133deg, rgba(255,208,120,1) 135deg, rgba(255,208,120,0) 137deg,
          rgba(253,224,71,0)   178deg, rgba(253,224,71,1)  180deg, rgba(253,224,71,0)  182deg,
          rgba(255,208,120,0)  223deg, rgba(255,208,120,1) 225deg, rgba(255,208,120,0) 227deg,
          rgba(253,224,71,0)   268deg, rgba(253,224,71,1)  270deg, rgba(253,224,71,0)  272deg,
          rgba(255,208,120,0)  313deg, rgba(255,208,120,1) 315deg, rgba(255,208,120,0) 317deg,
          rgba(253,224,71,0)   358deg, rgba(253,224,71,1)  360deg
        );
        animation:sunbeam-a 24s linear infinite, achm-pulse-a 4.2s ease-in-out infinite;
      }

      /* ── Layer B — mid rays, 6 beams every 60° offset by 15°, inset -26px.
         Longer reach than A, slightly thicker shafts. Rotates clockwise but
         slower, with a staggered fade phase so it's bright when A is dim. ── */
      .ach-row-icon--rare::after{
        content:'';
        position:absolute;inset:-26px;border-radius:50%;
        filter:blur(1.4px);
        mask:radial-gradient(circle,transparent 56%,rgba(0,0,0,1) 62%,rgba(0,0,0,1) 83%,transparent 91%);
        -webkit-mask:radial-gradient(circle,transparent 56%,rgba(0,0,0,1) 62%,rgba(0,0,0,1) 83%,transparent 91%);
        z-index:0;pointer-events:none;
        background:conic-gradient(
          from 0deg,
          rgba(234,179,8,0)  13deg,  rgba(234,179,8,.95)  15deg,  rgba(234,179,8,0)  17deg,
          rgba(253,224,71,0) 73deg,  rgba(253,224,71,.95) 75deg,  rgba(253,224,71,0) 77deg,
          rgba(234,179,8,0)  133deg, rgba(234,179,8,.95)  135deg, rgba(234,179,8,0)  137deg,
          rgba(253,224,71,0) 193deg, rgba(253,224,71,.95) 195deg, rgba(253,224,71,0) 197deg,
          rgba(234,179,8,0)  253deg, rgba(234,179,8,.95)  255deg, rgba(234,179,8,0)  257deg,
          rgba(253,224,71,0) 313deg, rgba(253,224,71,.95) 315deg, rgba(253,224,71,0) 317deg,
          transparent 360deg
        );
        animation:sunbeam-b 32s linear infinite, achm-pulse-b 5.6s ease-in-out infinite;
        animation-delay:0s, 1.4s;
      }

      /* ── Layer C — long rays, 4 beams every 90° offset by 7.5°, inset -40px.
         Reaches furthest out, rotates slowest, and runs a full come-and-go
         (0 → 1 → 0) so the longest rays visibly appear and vanish. ── */
      .ach-row-rays{position:absolute;inset:0;border-radius:inherit;pointer-events:none;z-index:0}
      .ach-row-rays::before{
        content:'';
        position:absolute;inset:-40px;border-radius:50%;
        filter:blur(2px);
        mask:radial-gradient(circle,transparent 62%,rgba(0,0,0,1) 68%,rgba(0,0,0,1) 90%,transparent 97%);
        -webkit-mask:radial-gradient(circle,transparent 62%,rgba(0,0,0,1) 68%,rgba(0,0,0,1) 90%,transparent 97%);
        background:conic-gradient(
          from 0deg,
          rgba(253,224,71,0)  5.5deg,  rgba(253,224,71,1)  7.5deg,  rgba(253,224,71,0)  9.5deg,
          rgba(234,179,8,0)   95.5deg, rgba(234,179,8,.95) 97.5deg, rgba(234,179,8,0)   99.5deg,
          rgba(253,224,71,0)  185.5deg,rgba(253,224,71,1)  187.5deg,rgba(253,224,71,0)  189.5deg,
          rgba(234,179,8,0)   275.5deg,rgba(234,179,8,.95) 277.5deg,rgba(234,179,8,0)   279.5deg,
          transparent 360deg
        );
        animation:sunbeam-a 46s linear infinite, achm-pulse-c 7.2s ease-in-out infinite;
        animation-delay:0s, 2.9s;
      }

      /* Direct children (img, emoji fallback) sit above every sunbeam layer;
         the rays wrapper is a layout-only container so its own stacking is
         kept behind. */
      .ach-row-icon--rare > :not(.ach-row-rays){position:relative;z-index:2}

      /* Locked rows: still signalled as rare, but dimmed so the celebration
         is clearly reserved for actually unlocking it. */
      .ach-row.locked .ach-row-icon--rare::before,
      .ach-row.locked .ach-row-icon--rare::after,
      .ach-row.locked .ach-row-rays::before{opacity:.4}

      .ach-row-pct-rare{color:#ca8a04}

      @keyframes sunbeam-a    { to { transform: rotate(360deg); } }
      @keyframes sunbeam-b    { to { transform: rotate(360deg); } }
      /* Each layer has its own come-in / go-out cycle at a distinct period.
         Layer C hits 0 at the extremes so the longest rays genuinely appear
         and vanish — the TF2 effect's defining shimmer. */
      @keyframes achm-pulse-a { 0%,100% { opacity: .25; } 50% { opacity: 1;   } }
      @keyframes achm-pulse-b { 0%,100% { opacity: .15; } 50% { opacity: .9;  } }
      @keyframes achm-pulse-c { 0%,100% { opacity: 0;   } 50% { opacity: 1;   } }
      .ach-row-body{flex:1;min-width:0}
      .ach-row-name{font-size:13.5px;font-weight:600;color:var(--text-primary);line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .ach-row.locked .ach-row-name{color:var(--text-secondary)}
      .ach-row-desc{font-size:12px;color:var(--text-tertiary);line-height:1.35;margin-top:2px}
      .ach-row-date{font-size:11px;color:var(--text-tertiary);margin-top:3px}
      .ach-row-meta{display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex-shrink:0;min-width:92px}
      .ach-row-global{display:inline-flex;align-items:center;gap:4px;font-size:11.5px;font-weight:600;color:var(--text-secondary)}
      .ach-row-global svg{opacity:.7}
      .ach-row-tier{font-size:10px;font-weight:700;letter-spacing:.08em;padding:2px 7px;border-radius:4px;text-transform:uppercase}
      .ach-row-tier--platinum{background:rgba(155,123,255,.18);color:#c4b1ff}
      .ach-row-tier--gold{background:rgba(245,181,68,.18);color:#f5c062}
      .ach-row-tier--silver{background:rgba(196,198,205,.2);color:#d5d7dd}
      .ach-row-tier--bronze{background:rgba(205,127,50,.18);color:#e2a06b}
      .ach-row-gs{font-size:11px;font-weight:600;color:var(--text-secondary)}
      .ach-row-earned{display:inline-flex;align-items:center;gap:3px;font-size:11px;font-weight:600;color:var(--score-great,#4ade80)}
      .ach-row-earned svg{flex-shrink:0}
      @media(max-width:560px){
        .ach-detail-modal{max-height:94vh}
        .ach-row-icon{width:40px;height:40px}
        .ach-row-meta{min-width:0}
      }
