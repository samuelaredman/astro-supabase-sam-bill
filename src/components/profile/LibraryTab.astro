---
// Markup moved verbatim from src/pages/reviewers/[username].astro — the page
// renders it for the tab in the URL, /reviewers/[username]/tab/[tab] for the
// rest. Data comes from src/utils/profileTabs.ts. Styles are the page's
// is:global styles.
import { timeAgo } from '../../utils/format';
import type { LibraryTabData } from '../../utils/profileTabs';

interface Props {
  data: LibraryTabData;
  reviewer: { username: string; steam_id?: string | null; steam_username?: string | null; steam_synced_at?: string | null };
  isOwnProfile: boolean;
}
const { data, reviewer, isOwnProfile } = Astro.props;
const { libraryIsPrivate, libCounts, libGenres, libPlatforms, libDevs, librarySettings } = data;
---
{/* Counts + settings for the library script, which reads them when this tab
    initialises (they used to be page-level define:vars). */}
<div id="libData" hidden data-counts={JSON.stringify(libCounts)} data-settings={JSON.stringify(librarySettings)}></div>

    {/* Steam CTA — only while not yet connected. The compact "connected" sync bar
        lives on the Overview/Detailed row inside #libControls below. */}
    {isOwnProfile && !reviewer.steam_id && (
      <div class="steam-cta">
        <div class="steam-cta-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.297-.254-1.9-.049l1.522.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.031zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.252 0-2.265-1.014-2.265-2.265z"/></svg>
        </div>
        <div class="steam-cta-body">
          <div class="steam-cta-title">Import your Steam library</div>
          <div class="steam-cta-desc">Connect Steam to automatically add your owned games and playtime.</div>
        </div>
        <a href={`/api/auth/steam-connect?from=${encodeURIComponent(`/reviewers/${reviewer.username}?tab=library`)}`} class="steam-cta-btn">Connect Steam</a>
      </div>
    )}

    {libraryIsPrivate && (
      <div class="empty-state" style="margin-top:16px">
        <div class="empty-title">Library is private</div>
        <p style="font-size:14px;color:var(--text-tertiary)">@{reviewer.username} has set their library to private.</p>
      </div>
    )}

    {/* Library controls — search, sort, edit (rendered by JS from libraryJson) */}
    <div id="libControls" style="display:none">
      <div class="lib-view-row">
        <div class="sort-tabs" id="libViewTabs">
          <button class="sort-tab lib-view-tab active" onclick="switchLibView('overview',this)">Overview</button>
          <button class="sort-tab lib-view-tab" onclick="switchLibView('detailed',this)">Detailed</button>
        </div>
        {isOwnProfile && reviewer.steam_id && (
          <div class="steam-sync-bar steam-sync-bar--compact">
            <span class="steam-sync-info">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" style="color:#60a5fa;flex-shrink:0"><path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.297-.254-1.9-.049l1.522.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.031zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.252 0-2.265-1.014-2.265-2.265z"/></svg>
              <span class="steam-sync-label">{reviewer.steam_username ? `Connected as ${reviewer.steam_username}` : 'Steam connected'}</span>
              {reviewer.steam_synced_at && (
                <span class="steam-sync-when"> · {timeAgo(reviewer.steam_synced_at)}</span>
              )}
            </span>
            <label class="steam-sync-played">
              <input type="checkbox" id="profilePlayedOnly" />
              Played only
            </label>
            <button class="steam-sync-btn" id="profileSyncBtn" data-username={reviewer.username} onclick="profileSteamSync()">Sync now</button>
          </div>
        )}
      </div>
      <div id="profileSyncStatus" class="steam-sync-status" style="display:none"></div>
      <div class="lib-controls-row lf-bar">
        <input id="libSearch" class="lf-search" type="search" placeholder="Search library…" autocomplete="off" />
        <select id="libSort" class="lf-select">
          <option value="alpha">A – Z</option>
          <option value="recent">Recently added</option>
          <option value="review">Has review first</option>
          <option value="hours">Most hours played</option>
          <option value="completion">Completion %</option>
        </select>
        {libGenres.length > 0 && (
          <select id="libGenre" class="lf-select" onchange="setLibDimFilter('genre',this.value,this)">
            <option value="">All Genres</option>
            {libGenres.map((g: string) => <option value={g}>{g}</option>)}
          </select>
        )}
        {libPlatforms.length > 0 && (
          <select id="libPlatform" class="lf-select" onchange="setLibDimFilter('platform',this.value,this)">
            <option value="">All Platforms</option>
            {libPlatforms.map((pl: string) => <option value={pl}>{pl}</option>)}
          </select>
        )}
        {libDevs.length > 0 && (
          <select id="libDev" class="lf-select" onchange="setLibDimFilter('dev',this.value,this)">
            <option value="">All Devs</option>
            {libDevs.map((d: string) => <option value={d}>{d}</option>)}
          </select>
        )}
        {isOwnProfile && (
          <button id="libGearBtn" class="lib-gear-btn" title="Library settings" style="margin-left:auto" onclick="toggleLibGear()">
            <svg width="15" height="15" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="9" r="2.5"/>
              <path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.22 3.22l1.42 1.42M13.36 13.36l1.42 1.42M13.36 4.64l1.42-1.42M3.22 14.78l1.42-1.42"/>
            </svg>
          </button>
        )}
        {isOwnProfile && (
          <button id="libEditBtn" class="lib-edit-btn" onclick="toggleLibEdit()">Edit library</button>
        )}
      </div>
      <div class="lib-filter-row" id="libFilterRow"></div>
    </div>

    {isOwnProfile && (
      <div class="lib-gear-panel" id="libGearPanel">
        <div class="lib-gear-tabs">
          <button class="lib-gear-tab active" data-tab="settings" onclick="switchGearTab('settings',this)">Main Settings</button>
          <button class="lib-gear-tab" data-tab="hidden" onclick="switchGearTab('hidden',this)">Hidden Games</button>
        </div>

        {/* ── Main Settings tab ── */}
        <div class="lib-gear-tab-content" id="libGearTabSettings">
          <div class="lib-gear-section">
            <div class="lib-gear-section-title">Library Visibility</div>
            <div class="lib-gear-radio-group" id="libVisibilityGroup">
              <label class="lib-gear-radio">
                <input type="radio" name="libVisibility" value="public" />
                <span class="lib-gear-radio-label"><strong>Public</strong> — anyone can see your library</span>
              </label>
              <label class="lib-gear-radio">
                <input type="radio" name="libVisibility" value="private" />
                <span class="lib-gear-radio-label"><strong>Private</strong> — only you can see your library</span>
              </label>
            </div>
          </div>
          <div class="lib-gear-section">
            <div class="lib-gear-section-title">Hours Played</div>
            <label class="lib-gear-toggle-row" id="libShowHoursRow">
              <span style="font-size:13px;color:var(--text-secondary)">Show hours played on cards</span>
              <button class="lib-gear-toggle" id="libShowHoursBtn" onclick="toggleLibShowHours()"></button>
            </label>
          </div>
          <div class="lib-gear-section" style="margin-bottom:0">
            <div class="lib-gear-section-title">Visible Status Tabs</div>
            <div style="font-size:12px;color:var(--text-tertiary);margin-bottom:8px">Choose which filter tabs are visible to others on your profile.</div>
            <div id="libTabToggles"></div>
          </div>
        </div>

        {/* ── Hidden Games tab ── */}
        <div class="lib-gear-tab-content" id="libGearTabHidden" style="display:none">
          <div class="lib-gear-section">
            <div class="lib-gear-section-title">Hidden Games</div>
            <div id="libHiddenList"></div>
          </div>
          <div class="lib-gear-section" style="margin-bottom:0">
            <div class="lib-gear-section-title">Hide a game</div>
            <input class="lib-hide-search" id="libHideSearch" type="search" placeholder="Search your library…" autocomplete="off" />
            <div class="lib-hide-results" id="libHideResults"></div>
          </div>
        </div>
      </div>
    )}

    {/* Bulk edit action bar */}
    {isOwnProfile && (
      <div id="libEditBar" style="display:none">
        <span id="libEditCount" class="lib-edit-count">0 selected</span>
        <button class="lib-select-all" id="libSelectAllBtn" onclick="toggleLibSelectAll()">Select page</button>
        <button class="lib-select-all" id="libSelectAllPagesBtn" onclick="selectAllLibPages()">Select all</button>
        <select id="libBulkStatus" class="lib-sort" style="font-size:12px">
          <option value="">Change status…</option>
          <option value="playing">🎮 Playing</option>
          <option value="want_to_play">🔖 Want to Play</option>
          <option value="owned">📦 Owned</option>
          <option value="completed">✓ Completed</option>
          <option value="hundred_percent">💯 100%</option>
          <option value="dropped">✗ Dropped</option>
        </select>
        <button class="lib-bulk-apply" onclick="applyBulkStatus()">Apply</button>
        <button class="lib-bulk-delete" onclick="applyBulkDelete()">Remove</button>
        <button class="lib-edit-cancel" onclick="toggleLibEdit()">Done</button>
      </div>
    )}

    {/* Grid — rendered entirely by JS so sort/search/edit all work off one source of truth */}
    <div id="libEmpty" style="display:none">
      <div class="empty-state">
        <div class="empty-title">{libCounts.all === 0 ? 'No games tracked yet' : 'No games match'}</div>
        <p style="font-size:14px;color:var(--text-tertiary)">
          {libCounts.all === 0
            ? (isOwnProfile
                ? 'Track your games from any game page, or connect Steam above to import your library automatically.'
                : `@${reviewer.username} hasn't tracked any games yet.`)
            : 'Try a different search or filter.'
          }
        </p>
      </div>
    </div>
    <div class="lib-check-row" id="libCheckboxes" style="display:none">
      <label class="lib-check-item" id="libReviewedItem">
        <div class="lib-check-box"></div>
        <span>Reviewed</span>
      </label>
      <label class="lib-check-item" id="libUnreviewedItem">
        <div class="lib-check-box"></div>
        <span>Unreviewed</span>
      </label>
      {isOwnProfile && (
        <label class="lib-check-item" id="libHiddenItem">
          <div class="lib-check-box"></div>
          <span>Hidden</span>
        </label>
      )}
    </div>
    <div class="lib-az" id="libAzBar" style="display:none"></div>
    <div class="lib-grid" id="libGrid"></div>
    <div class="lib-dt-list" id="libGridDetailed" style="display:none"></div>
    <div class="lib-pag" id="libPagination" style="display:none"></div>

