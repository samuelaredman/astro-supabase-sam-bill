---
// Markup moved verbatim from src/pages/reviewers/[username].astro — the page
// renders it for the tab in the URL, /reviewers/[username]/tab/[tab] for the
// rest. Data comes from src/utils/profileTabs.ts. Styles are the page's
// is:global styles.
import { timeAgo } from '../../utils/format';
import type { LibraryTabData } from '../../utils/profileTabs';

interface Props {
  data: LibraryTabData;
  reviewer: {
    username: string;
    steam_id?: string | null;
    steam_username?: string | null;
    steam_synced_at?: string | null;
    psn_account_id?: string | null;
    psn_online_id?: string | null;
    psn_synced_at?: string | null;
    xbox_xuid?: string | null;
    xbox_gamertag?: string | null;
    xbox_synced_at?: string | null;
  };
  isOwnProfile: boolean;
}
const { data, reviewer, isOwnProfile } = Astro.props;
const { libraryIsPrivate, libCounts, libGenres, libPlatforms, libDevs, librarySettings, initialLibraryPage } = data;
---
{/* Counts + settings + inlined page-1 items for the library script, which
    hydrates from these attributes when the tab initialises. Inlining page 1
    eliminates the second round-trip the client used to make on tab open. */}
<style is:global>
  /* Sync dropdown — the trigger sits in the library view-row; the menu drops
     beneath, aligned to the trigger's right edge. Co-located with the markup
     so the rules ship in the same CSS chunk as the tab HTML, whether the tab
     is SSR'd inline on ?tab=library or fetched later via innerHTML injection
     (see the tab loader in reviewers/[username].astro). Previously lived in
     the parent page's global block and could paint before that chunk settled. */
  .lib-sync{position:relative;flex-shrink:0}
  .lib-sync-trigger{
    display:inline-flex;align-items:center;gap:6px;
    background:var(--bg-card);border:1px solid var(--border);
    color:var(--text-primary);
    padding:6px 12px;border-radius:8px;
    font-size:12.5px;font-weight:500;cursor:pointer;
    transition:background .15s,border-color .15s;
  }
  .lib-sync-trigger:hover{background:var(--bg-hover);border-color:color-mix(in srgb,var(--accent) 40%,var(--border))}
  .lib-sync-trigger svg{opacity:.85;flex-shrink:0}
  .lib-sync-caret{transition:transform .2s ease}
  .lib-sync[data-open="true"] .lib-sync-caret{transform:rotate(180deg)}

  .lib-sync-menu{
    position:absolute;top:calc(100% + 6px);right:0;z-index:20;
    min-width:340px;
    background:var(--bg-card);border:1px solid var(--border);border-radius:10px;
    box-shadow:0 8px 24px rgba(0,0,0,.35);
    overflow:hidden;
  }
  .lib-sync-menu[hidden]{display:none}
  .lib-sync-row{
    display:flex;align-items:center;gap:12px;
    padding:10px 12px;
    border-bottom:1px solid var(--border-subtle);
    color:var(--text-primary);text-decoration:none;
  }
  .lib-sync-row:last-child{border-bottom:none}
  a.lib-sync-row{cursor:pointer;transition:background .12s}
  a.lib-sync-row:hover{background:var(--bg-hover)}

  /* Colored square holds the platform mark. Same 32px tile for every
     platform so rows line up; the icon itself varies (Steam 16px,
     PS 20px — user asked for a slightly larger PS mark). */
  .lib-sync-row-icon{
    width:32px;height:32px;border-radius:6px;
    display:inline-flex;align-items:center;justify-content:center;
    flex-shrink:0;
  }
  .lib-sync-row-icon--steam{background:#1b2838}
  .lib-sync-row-icon--psn{background:#003791}
  .lib-sync-row-icon--xbox{background:#107C10}

  .lib-sync-row-body{flex:1;min-width:0}
  .lib-sync-row-title{font-size:13px;font-weight:600;color:var(--text-primary);line-height:1.2}
  .lib-sync-row-sub{
    font-size:11.5px;color:var(--text-secondary);
    margin-top:2px;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  }

  .lib-sync-row-actions{display:flex;align-items:center;gap:10px;flex-shrink:0}
  .lib-sync-played{display:flex;align-items:center;gap:4px;font-size:11px;color:var(--text-tertiary);cursor:pointer;white-space:nowrap}
  .lib-sync-played input{accent-color:var(--accent)}
  .lib-sync-action{
    background:transparent;border:1px solid var(--border);
    color:var(--text-secondary);
    padding:4px 10px;border-radius:6px;
    font-size:11px;font-weight:500;cursor:pointer;text-decoration:none;
    transition:border-color .12s,color .12s;
  }
  .lib-sync-action:hover{border-color:var(--accent);color:var(--accent)}
  .lib-sync-action:disabled{opacity:.5;cursor:default}
  a.lib-sync-row:hover .lib-sync-action{border-color:var(--accent);color:var(--accent)}

  @media(max-width:560px){
    .lib-sync-menu{min-width:0;width:calc(100vw - 32px);max-width:360px}
  }
</style>

<div id="libData" hidden
  data-counts={JSON.stringify(libCounts)}
  data-settings={JSON.stringify(librarySettings)}
  data-initial-total={String(initialLibraryPage.total)}
  data-initial-page={String(initialLibraryPage.page)}
  data-initial-has-more={initialLibraryPage.hasMore ? '1' : '0'}
></div>
<script id="libInitialItems" type="application/json" set:html={JSON.stringify(initialLibraryPage.items).replace(/</g, '\\u003c')}></script>

    {/* Steam CTA — only while not yet connected. The compact "connected" sync bar
        lives on the Overview/Detailed row inside #libControls below. */}
    {isOwnProfile && !reviewer.steam_id && (
      <div class="steam-cta">
        <div class="steam-cta-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.297-.254-1.9-.049l1.522.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.031zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.252 0-2.265-1.014-2.265-2.265z"/></svg>
        </div>
        <div class="steam-cta-body">
          <div class="steam-cta-title">Import your Steam library</div>
          <div class="steam-cta-desc">Connect Steam to automatically add your owned games and playtime.</div>
        </div>
        <a href={`/api/auth/steam-connect?from=${encodeURIComponent(`/reviewers/${reviewer.username}?tab=library`)}`} class="steam-cta-btn">Connect Steam</a>
      </div>
    )}

    {libraryIsPrivate && (
      <div class="empty-state" style="margin-top:16px">
        <div class="empty-title">Library is private</div>
        <p style="font-size:14px;color:var(--text-tertiary)">@{reviewer.username} has set their library to private.</p>
      </div>
    )}

    {/* Library controls — search, sort, edit (rendered by JS from libraryJson) */}
    <div id="libControls" style="display:none">
      <div class="lib-view-row">
        <div class="sort-tabs" id="libViewTabs">
          <button class="sort-tab lib-view-tab active" onclick="switchLibView('overview',this)">Overview</button>
          <button class="sort-tab lib-view-tab" onclick="switchLibView('detailed',this)">Detailed</button>
        </div>
        {/* Unified sync dropdown — one button opens a menu with a row per
            platform. Steam syncs in place (calls profileSteamSync, which reads
            #profilePlayedOnly + #profileSyncBtn as before). PSN redirects to
            /settings#psn because the NPSSO paste flow and cursor-based trophy
            sync both live there. Xbox will slot in as a third row when we
            wire that integration up. */}
        {isOwnProfile && (
          <div class="lib-sync">
            <button
              type="button"
              class="lib-sync-trigger"
              id="libSyncTrigger"
              onclick="toggleLibSyncMenu()"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="libSyncMenu"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><polyline points="21 3 21 9 15 9"/></svg>
              <span>Sync</span>
              <svg class="lib-sync-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="lib-sync-menu" id="libSyncMenu" role="menu" hidden>

              {/* ── Steam ── */}
              <div class="lib-sync-row" role="menuitem">
                <div class="lib-sync-row-icon lib-sync-row-icon--steam">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="#fff"><path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.297-.254-1.9-.049l1.522.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.031zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.252 0-2.265-1.014-2.265-2.265z"/></svg>
                </div>
                <div class="lib-sync-row-body">
                  <div class="lib-sync-row-title">Steam</div>
                  <div class="lib-sync-row-sub">
                    {reviewer.steam_id
                      ? (reviewer.steam_username ? `Connected as ${reviewer.steam_username}` : 'Steam connected')
                      : 'Not connected'}
                    {reviewer.steam_id && reviewer.steam_synced_at && ` · ${timeAgo(reviewer.steam_synced_at)}`}
                  </div>
                </div>
                <div class="lib-sync-row-actions">
                  {reviewer.steam_id ? (
                    <>
                      <label class="lib-sync-played">
                        <input type="checkbox" id="profilePlayedOnly" />
                        Played only
                      </label>
                      <button class="lib-sync-action" id="profileSyncBtn" data-username={reviewer.username} onclick="profileSteamSync()">Sync now</button>
                    </>
                  ) : (
                    <a class="lib-sync-action" href={`/api/auth/steam-connect?from=${encodeURIComponent(`/reviewers/${reviewer.username}?tab=library`)}`}>Connect</a>
                  )}
                </div>
              </div>

              {/* ── PlayStation ── */}
              <a class="lib-sync-row" role="menuitem" href="/settings#psn">
                <div class="lib-sync-row-icon lib-sync-row-icon--psn">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="#fff"><path d="M9.5 6.5v14.72l3.03.98V9.81c0-.57.26-.95.68-.82.55.14.66.68.66 1.25v4.72c1.89.91 3.37 0 3.37-2.41 0-2.47-.87-3.57-3.44-4.45C12.76 7.75 10.9 7.29 9.5 6.5zM13.66 20.13l4.87-1.74c.55-.2.64-.48.19-.63-.45-.15-1.27-.11-1.83.09l-3.23 1.14v-1.87l.19-.06s.93-.33 2.24-.48c1.31-.14 2.92.02 4.18.5 1.42.45 1.58 1.11 1.22 1.57-.36.46-1.25.79-1.25.79l-6.58 2.36v-1.67zM2.87 19.6c-1.46-.41-1.7-1.27-1.03-1.76.61-.46 1.66-.8 1.66-.8l4.32-1.53v1.75l-3.1 1.11c-.55.2-.64.48-.19.63.45.15 1.27.11 1.83-.09l1.46-.53v1.57l-.29.05c-1.5.24-3.09.15-4.66-.4z"/></svg>
                </div>
                <div class="lib-sync-row-body">
                  <div class="lib-sync-row-title">PlayStation</div>
                  <div class="lib-sync-row-sub">
                    {reviewer.psn_account_id
                      ? (reviewer.psn_online_id ? `Connected as ${reviewer.psn_online_id}` : 'PSN connected')
                      : 'Not connected'}
                    {reviewer.psn_account_id && reviewer.psn_synced_at && ` · ${timeAgo(reviewer.psn_synced_at)}`}
                  </div>
                </div>
                <div class="lib-sync-row-actions">
                  <span class="lib-sync-action">{reviewer.psn_account_id ? 'Sync now' : 'Connect'}</span>
                </div>
              </a>

              {/* ── Xbox ── */}
              <a class="lib-sync-row" role="menuitem" href="/settings#xbox">
                <div class="lib-sync-row-icon lib-sync-row-icon--xbox">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M7.5 7.5l9 9M16.5 7.5l-9 9"/></svg>
                </div>
                <div class="lib-sync-row-body">
                  <div class="lib-sync-row-title">Xbox</div>
                  <div class="lib-sync-row-sub">
                    {reviewer.xbox_xuid
                      ? (reviewer.xbox_gamertag ? `Connected as ${reviewer.xbox_gamertag}` : 'Xbox connected')
                      : 'Not connected'}
                    {reviewer.xbox_xuid && reviewer.xbox_synced_at && ` · ${timeAgo(reviewer.xbox_synced_at)}`}
                  </div>
                </div>
                <div class="lib-sync-row-actions">
                  <span class="lib-sync-action">{reviewer.xbox_xuid ? 'Sync now' : 'Connect'}</span>
                </div>
              </a>

            </div>
          </div>
        )}
      </div>
      <div id="profileSyncStatus" class="steam-sync-status" style="display:none"></div>
      <div class="lib-controls-row lf-bar">
        <input id="libSearch" class="lf-search" type="search" placeholder="Search library…" autocomplete="off" />
        <select id="libSort" class="lf-select">
          <option value="alpha">A – Z</option>
          <option value="recent">Recently added</option>
          <option value="review">Has review first</option>
          <option value="hours">Most hours played</option>
          <option value="completion">Completion %</option>
        </select>
        {libGenres.length > 0 && (
          <select id="libGenre" class="lf-select" onchange="setLibDimFilter('genre',this.value,this)">
            <option value="">All Genres</option>
            {libGenres.map((g: string) => <option value={g}>{g}</option>)}
          </select>
        )}
        {libPlatforms.length > 0 && (
          <select id="libPlatform" class="lf-select" onchange="setLibDimFilter('platform',this.value,this)">
            <option value="">All Platforms</option>
            {libPlatforms.map((pl: string) => <option value={pl}>{pl}</option>)}
          </select>
        )}
        {libDevs.length > 0 && (
          <select id="libDev" class="lf-select" onchange="setLibDimFilter('dev',this.value,this)">
            <option value="">All Devs</option>
            {libDevs.map((d: string) => <option value={d}>{d}</option>)}
          </select>
        )}
        {isOwnProfile && (
          <button id="libGearBtn" class="lib-gear-btn" title="Library settings" style="margin-left:auto" onclick="toggleLibGear()">
            <svg width="15" height="15" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="9" r="2.5"/>
              <path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.22 3.22l1.42 1.42M13.36 13.36l1.42 1.42M13.36 4.64l1.42-1.42M3.22 14.78l1.42-1.42"/>
            </svg>
          </button>
        )}
        {isOwnProfile && (
          <button id="libEditBtn" class="lib-edit-btn" onclick="toggleLibEdit()">Edit library</button>
        )}
      </div>
      <div class="lib-filter-row" id="libFilterRow"></div>
    </div>

    {isOwnProfile && (
      <div class="lib-gear-panel" id="libGearPanel">
        <div class="lib-gear-tabs">
          <button class="lib-gear-tab active" data-tab="settings" onclick="switchGearTab('settings',this)">Main Settings</button>
          <button class="lib-gear-tab" data-tab="hidden" onclick="switchGearTab('hidden',this)">Hidden Games</button>
        </div>

        {/* ── Main Settings tab ── */}
        <div class="lib-gear-tab-content" id="libGearTabSettings">
          <div class="lib-gear-section">
            <div class="lib-gear-section-title">Library Visibility</div>
            <div class="lib-gear-radio-group" id="libVisibilityGroup">
              <label class="lib-gear-radio">
                <input type="radio" name="libVisibility" value="public" />
                <span class="lib-gear-radio-label"><strong>Public</strong> — anyone can see your library</span>
              </label>
              <label class="lib-gear-radio">
                <input type="radio" name="libVisibility" value="private" />
                <span class="lib-gear-radio-label"><strong>Private</strong> — only you can see your library</span>
              </label>
            </div>
          </div>
          <div class="lib-gear-section">
            <div class="lib-gear-section-title">Hours Played</div>
            <label class="lib-gear-toggle-row" id="libShowHoursRow">
              <span style="font-size:13px;color:var(--text-secondary)">Show hours played on cards</span>
              <button class="lib-gear-toggle" id="libShowHoursBtn" onclick="toggleLibShowHours()"></button>
            </label>
          </div>
          <div class="lib-gear-section" style="margin-bottom:0">
            <div class="lib-gear-section-title">Visible Status Tabs</div>
            <div style="font-size:12px;color:var(--text-tertiary);margin-bottom:8px">Choose which filter tabs are visible to others on your profile.</div>
            <div id="libTabToggles"></div>
          </div>
        </div>

        {/* ── Hidden Games tab ── */}
        <div class="lib-gear-tab-content" id="libGearTabHidden" style="display:none">
          <div class="lib-gear-section">
            <div class="lib-gear-section-title">Hidden Games</div>
            <div id="libHiddenList"></div>
          </div>
          <div class="lib-gear-section" style="margin-bottom:0">
            <div class="lib-gear-section-title">Hide a game</div>
            <input class="lib-hide-search" id="libHideSearch" type="search" placeholder="Search your library…" autocomplete="off" />
            <div class="lib-hide-results" id="libHideResults"></div>
          </div>
        </div>
      </div>
    )}

    {/* Bulk edit action bar */}
    {isOwnProfile && (
      <div id="libEditBar" style="display:none">
        <span id="libEditCount" class="lib-edit-count">0 selected</span>
        <button class="lib-select-all" id="libSelectAllBtn" onclick="toggleLibSelectAll()">Select page</button>
        <button class="lib-select-all" id="libSelectAllPagesBtn" onclick="selectAllLibPages()">Select all</button>
        <select id="libBulkStatus" class="lib-sort" style="font-size:12px">
          <option value="">Change status…</option>
          <option value="playing">🎮 Playing</option>
          <option value="want_to_play">🔖 Want to Play</option>
          <option value="owned">📦 Owned</option>
          <option value="completed">✓ Completed</option>
          <option value="hundred_percent">💯 100%</option>
          <option value="dropped">✗ Dropped</option>
        </select>
        <button class="lib-bulk-apply" onclick="applyBulkStatus()">Apply</button>
        <button class="lib-bulk-delete" onclick="applyBulkDelete()">Remove</button>
        <button class="lib-edit-cancel" onclick="toggleLibEdit()">Done</button>
      </div>
    )}

    {/* Grid — rendered entirely by JS so sort/search/edit all work off one source of truth */}
    <div id="libEmpty" style="display:none">
      <div class="empty-state">
        <div class="empty-title">{libCounts.all === 0 ? 'No games tracked yet' : 'No games match'}</div>
        <p style="font-size:14px;color:var(--text-tertiary)">
          {libCounts.all === 0
            ? (isOwnProfile
                ? 'Track your games from any game page, or connect Steam above to import your library automatically.'
                : `@${reviewer.username} hasn't tracked any games yet.`)
            : 'Try a different search or filter.'
          }
        </p>
      </div>
    </div>
    <div class="lib-check-row" id="libCheckboxes" style="display:none">
      <label class="lib-check-item" id="libReviewedItem">
        <div class="lib-check-box"></div>
        <span>Reviewed</span>
      </label>
      <label class="lib-check-item" id="libUnreviewedItem">
        <div class="lib-check-box"></div>
        <span>Unreviewed</span>
      </label>
      {isOwnProfile && (
        <label class="lib-check-item" id="libHiddenItem">
          <div class="lib-check-box"></div>
          <span>Hidden</span>
        </label>
      )}
    </div>
    <div class="lib-az" id="libAzBar" style="display:none"></div>
    <div class="lib-grid" id="libGrid"></div>
    <div class="lib-dt-list" id="libGridDetailed" style="display:none"></div>
    <div class="lib-pag" id="libPagination" style="display:none"></div>

    {/* Per-game achievement list modal — opened from the completion bar in the
        detailed view. Fetches /api/user-achievements/game and renders every
        achievement (unlocked + locked) with the global % and the time it was
        unlocked. Modelled on the native Steam / PS Trophies modal layout. */}
    <style is:global>
      .ach-detail-modal{max-width:640px;max-height:88vh}
      .ach-detail-head{padding:18px 20px 10px;display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
      .ach-detail-head-text{min-width:0}
      .ach-detail-title{font-family:'DM Serif Display',serif;font-size:22px;letter-spacing:-.3px;line-height:1.1;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .ach-detail-sub{font-size:12px;color:var(--text-tertiary);margin-top:3px}
