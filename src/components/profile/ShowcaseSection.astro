---
// Wraps one Overview showcase so its owner can reorder or hide it. Visitors
// never get a hidden section. The owner always gets it, plus an edit bar
// (label, move up/down, Hide/Show) that only shows in edit mode. Outside edit
// mode .sc-is-hidden is display:none; in edit mode it shows dimmed.
// Changes are staged in the DOM and saved with the rest of the profile
// (saveProfile()). Styles live in the profile page's global block.
interface Props {
  section: string;
  label: string;
  hidden: boolean;
  isOwner: boolean;
}
const { section, label, hidden, isOwner } = Astro.props;
---
{(!hidden || isOwner) && (
  <div class:list={['sc-section', { 'sc-is-hidden': hidden }]} data-showcase={section}>
    {isOwner && (
      <div class="sc-edit-bar">
        <span class="sc-edit-label">
          {label}
          <span class="sc-hidden-badge">Hidden</span>
        </span>
        <span class="sc-edit-actions">
          <button type="button" class="sc-move-btn" data-dir="-1" onclick={`moveShowcase('${section}', -1)`} aria-label={`Move ${label} up`}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
          </button>
          <button type="button" class="sc-move-btn" data-dir="1" onclick={`moveShowcase('${section}', 1)`} aria-label={`Move ${label} down`}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <button type="button" class="sc-toggle-btn" onclick={`toggleShowcaseHidden('${section}')`} aria-label={`Hide or show ${label}`}>
            <span class="sc-toggle-hide">Hide</span>
            <span class="sc-toggle-show">Show</span>
          </button>
        </span>
      </div>
    )}
    <slot />
  </div>
)}
