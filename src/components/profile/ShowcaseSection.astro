---
// Wraps one Overview showcase so its owner can hide it. Visitors never get a
// hidden section. The owner always gets it, so it can be shown again from
// Edit profile: outside edit mode .sc-is-hidden is display:none, in edit mode
// it shows dimmed under a "Hidden from your profile · Show" bar. Toggling is
// staged in the DOM and saved with the rest of the profile (saveProfile()).
// Styles live in the profile page's global block.
interface Props {
  section: string;
  label: string;
  hidden: boolean;
  isOwner: boolean;
}
const { section, label, hidden, isOwner } = Astro.props;
---
{(!hidden || isOwner) && (
  <div class:list={['sc-section', { 'sc-is-hidden': hidden }]} data-showcase={section} data-label={label}>
    {isOwner && (
      <div class="sc-hidden-bar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
          <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
          <line x1="1" y1="1" x2="23" y2="23"/>
        </svg>
        <span class="sc-hidden-text"><strong>{label}</strong> is hidden from your profile</span>
        <button type="button" class="sc-show-btn" onclick={`toggleShowcaseHidden('${section}')`}>Show</button>
      </div>
    )}
    <slot />
  </div>
)}
