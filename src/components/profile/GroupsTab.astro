---
// The Groups tab: groups this reviewer is in. The page renders it for the tab
// in the URL, /reviewers/[username]/tab/[tab] for the rest. Data comes from
// src/utils/profileTabs.ts. Styles are the page's is:global styles (.rgroup-*).
import type { GroupsTabData } from '../../utils/profileTabs';
import { groupPath } from '../../utils/groupSlug';

interface Props {
  data: GroupsTabData;
  reviewer: { id: string; username: string };
}
const { data, reviewer } = Astro.props;
const { groups } = data;
---

{groups.length === 0 ? (
  <div class="empty-state">
    <div class="empty-title">Not in any groups</div>
    <p style="font-size:14px;color:var(--text-tertiary)">When @{reviewer.username} joins a group, it'll appear here.</p>
  </div>
) : (
  <div class="rgroup-grid">
    {groups.map((g) => (
      <a href={groupPath(g)} class="rgroup-card">
        {g.avatar_url
          ? <img src={g.avatar_url} alt={g.name} class="rgroup-avatar" />
          : <div class="rgroup-avatar rgroup-avatar-placeholder">{g.name.slice(0, 2).toUpperCase()}</div>
        }
        <span class="rgroup-name">{g.name}</span>
        <span class="rgroup-meta">{g.memberCount} member{g.memberCount === 1 ? '' : 's'}</span>
      </a>
    ))}
  </div>
)}
