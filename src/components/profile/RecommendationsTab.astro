---
// Markup moved verbatim from src/pages/reviewers/[username].astro — the page
// renders it for the tab in the URL, /reviewers/[username]/tab/[tab] for the
// rest. Data comes from src/utils/profileTabs.ts. Styles are the page's
// is:global styles.
import RecommendationFeedCard from '../RecommendationFeedCard.astro';
import { igdbImage as igdbCover } from '../../utils/format';
import type { RecommendationsTabData } from '../../utils/profileTabs';

interface Props {
  data: RecommendationsTabData;
  reviewer: { username: string };
  isLoggedIn: boolean;
  isOwnProfile: boolean;
  currentProfileId: string | null;
}
const { data, reviewer, isLoggedIn, isOwnProfile, currentProfileId } = Astro.props;
const { reviewerRecs, recFilterItems, recGenres, recPlatforms, recDevs } = data;
---
    {reviewerRecs.length === 0 ? (
      <div class="prof-recs-empty">
        <div class="prof-recs-empty-title">No recommendations yet</div>
        <p>{isOwnProfile ? "Share a “if you liked X, you’ll like Y” pairing and it’ll show up here and in the feed." : `${reviewer.username} hasn’t recommended any games yet.`}</p>
        {isOwnProfile && <button class="tab-add-btn" onclick="openRecComposer()" style="margin-top:14px">+ Add a recommendation</button>}
      </div>
    ) : (
      <>
        <div class="sort-tabs">
          <button class="sort-tab rec-view-tab active" onclick="switchRecView('overview',this)">Overview</button>
          <button class="sort-tab rec-view-tab" onclick="switchRecView('detailed',this)">Detailed</button>
          {isOwnProfile && <button class="tab-add-btn" style="margin-left:auto" onclick="openRecComposer()">+ Add a recommendation</button>}
        </div>

        <div class="lf-bar">
          <input class="lf-search" type="text" placeholder="Search recommendations…" oninput="searchRecs(this.value)" />
          <select class="lf-select" onchange="setRecSort(this.value)">
            <option value="az" selected>A–Z</option>
            <option value="recent">Recent</option>
            <option value="oldest">Oldest</option>
            <option value="most-upvoted">Most Upvoted</option>
            <option value="most-downvoted">Most Downvoted</option>
          </select>
          {recGenres.length > 0 && (
            <select class="lf-select" onchange="setRecFilter('genre',this.value,this)">
              <option value="">All Genres</option>
              {recGenres.map((g: string) => <option value={g}>{g}</option>)}
            </select>
          )}
          {recPlatforms.length > 0 && (
            <select class="lf-select" onchange="setRecFilter('platform',this.value,this)">
              <option value="">All Platforms</option>
              {recPlatforms.map((p: string) => <option value={p}>{p}</option>)}
            </select>
          )}
          {recDevs.length > 0 && (
            <select class="lf-select" onchange="setRecFilter('dev',this.value,this)">
              <option value="">All Devs</option>
              {recDevs.map((d: string) => <option value={d}>{d}</option>)}
            </select>
          )}
        </div>

        <div id="profRecsList" style="display:none">
          {recFilterItems.map((it: any) => (
            <div
              class="rec-filter-item"
              data-title={it.searchText}
              data-sort-title={it.sortTitle}
              data-genres={it.genres.join(',')}
              data-devs={it.devs.join(',')}
              data-platforms={it.platforms.join(',')}
              data-date={it.date}
              data-upvotes={it.up}
              data-downvotes={it.down}
            >
              <RecommendationFeedCard
                id={it.rec.id}
                sourceGame={it.rec.sourceGame}
                targetGame={it.rec.targetGame}
                body={it.rec.body}
                containsSpoilers={it.rec.containsSpoilers}
                ownerUsername={it.rec.ownerUsername}
                ownerAvatar={it.rec.ownerAvatar}
                createdAt={it.rec.createdAt}
                upVotes={it.rec.upVotes}
                downVotes={it.rec.downVotes}
                myVote={it.rec.myVote}
                commentCount={it.rec.commentCount}
                reactions={it.rec.reactions}
                isLoggedIn={isLoggedIn}
                currentProfileId={currentProfileId}
                profileId={it.rec.profileId}
              />
            </div>
          ))}
        </div>
        <div class="list-no-results" id="recs-dt-no-results" style="display:none">No recommendations match these filters.</div>

        <div class="recs-overview-grid" id="profRecsOverviewList">
          {recFilterItems.map((it: any) => {
            const rec = it.rec
            const srcCover = igdbCover(rec.sourceGame?.cover_img_url, 't_cover_big')
            const tgtCover = igdbCover(rec.targetGame?.cover_img_url, 't_cover_big')
            return (
              <div
                class="rec-filter-item"
                data-title={it.searchText}
                data-sort-title={it.sortTitle}
                data-genres={it.genres.join(',')}
                data-devs={it.devs.join(',')}
                data-platforms={it.platforms.join(',')}
                data-date={it.date}
                data-upvotes={it.up}
                data-downvotes={it.down}
              >
                <a href={`/recommendations/${rec.id}`} class="rec-overview-tile">
                  <div class="rot-covers">
                    <div class="rot-cover">{srcCover ? <img src={srcCover} alt="" loading="lazy" /> : <span>🎮</span>}</div>
                    <span class="rot-arrow">→</span>
                    <div class="rot-cover">{tgtCover ? <img src={tgtCover} alt="" loading="lazy" /> : <span>🎮</span>}</div>
                  </div>
                  <div class="rot-titles">{rec.sourceGame?.title ?? 'Unknown'} → {rec.targetGame?.title ?? 'Unknown'}</div>
                </a>
              </div>
            )
          })}
        </div>
        <div class="list-no-results" id="recs-ov-no-results" style="display:none">No recommendations match these filters.</div>
      </>
    )}
