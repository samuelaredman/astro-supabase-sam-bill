---
// Markup moved verbatim from src/pages/reviewers/[username].astro — the page
// renders it for the tab in the URL, /reviewers/[username]/tab/[tab] for the
// rest. Data comes from src/utils/profileTabs.ts. Styles are the page's
// is:global styles.
import ListCard from '../ListCard.astro';
import type { ListsTabData } from '../../utils/profileTabs';

interface Props {
  data: ListsTabData;
  reviewer: { id: string; username: string };
  isLoggedIn: boolean;
  isOwnProfile: boolean;
  currentProfileId: string | null;
}
const { data, reviewer, isLoggedIn, isOwnProfile, currentProfileId } = Astro.props;
const { profileLists, savedLists, myGenres, myPlatforms, myDevs, savedGenres, savedPlatforms, savedDevs } = data;
---

    <!-- Section switcher (only shown when saved lists exist) -->
    {(savedLists.length > 0 || isOwnProfile) && (
      <div class="sort-tabs" style="margin-bottom: 20px">
        <button class="sort-tab list-filter-tab active" onclick="switchListsSection('my', this)">
          {isOwnProfile ? 'My Lists' : `${reviewer.username}'s Lists`}
        </button>
        <button class="sort-tab list-filter-tab" onclick="switchListsSection('saved', this)">
          Saved {savedLists.length > 0 && <span style="opacity:.6">({savedLists.length})</span>}
        </button>
        {isOwnProfile && profileLists.length > 0 && (
          <button class="tab-add-btn" style="margin-left:auto" onclick="createNewList(this)">+ New list</button>
        )}
      </div>
    )}

    <!-- ── MY LISTS SECTION ── -->
    <div id="lists-my-section">
      {profileLists.length === 0 ? (
        <div class="empty-state-tab">
          <div class="empty-title">{isOwnProfile ? "You haven't created any lists yet" : `@${reviewer.username} hasn't created any lists yet`}</div>
          {isOwnProfile && (
            <button class="tab-add-btn" onclick="createNewList(this)">+ Create your first list</button>
          )}
        </div>
      ) : (
        <>
          <!-- Filter bar -->
          <div class="lf-bar">
            <input class="lf-search" type="text" placeholder="Search lists…" oninput="searchLists('my',this.value)" />
            <select class="lf-select" onchange="setListSort('my',this.value)">
              <option value="recent">Recent</option>
              <option value="oldest">Oldest</option>
              <option value="az">A–Z</option>
              <option value="most-games">Most Games</option>
              <option value="highest-rated">Highest Rated</option>
              <option value="lowest-rated">Lowest Rated</option>
              <option value="most-hours">Most Hours</option>
            </select>
            {myGenres.length > 0 && (
              <select class="lf-select" onchange="setListFilter('my','genre',this.value,this)">
                <option value="">All Genres</option>
                {myGenres.map((g: string) => <option value={g}>{g}</option>)}
              </select>
            )}
            {myPlatforms.length > 0 && (
              <select class="lf-select" onchange="setListFilter('my','platform',this.value,this)">
                <option value="">All Platforms</option>
                {myPlatforms.map((p: string) => <option value={p}>{p}</option>)}
              </select>
            )}
            {myDevs.length > 0 && (
              <select class="lf-select" onchange="setListFilter('my','dev',this.value,this)">
                <option value="">All Devs</option>
                {myDevs.map((d: string) => <option value={d}>{d}</option>)}
              </select>
            )}
            <label class="lf-checkbox">
              <input type="checkbox" onchange="setListCheckboxFilter('my','ranked',this.checked)" /> Ranked
            </label>
            {isOwnProfile && (
              <label class="lf-checkbox">
                <input type="checkbox" onchange="setListCheckboxFilter('my','private',this.checked)" /> Private
              </label>
            )}
          </div>

          <div class="lists-grid" id="my-lists-grid">
            {profileLists.map((list: any) => (
              <div class="list-card-wrapper"
                data-title={list.title}
                data-updated={list.updated_at}
                data-count={list.entryCount}
                data-genres={(list.genres ?? []).join(',')}
                data-platforms={(list.platforms ?? []).join(',')}
                data-devs={(list.devs ?? []).join(',')}
                data-min-year={list.minYear ?? ''}
                data-avg-score={list.avgScore != null ? list.avgScore.toFixed(2) : ''}
                data-total-hours={list.totalHours ?? 0}
                data-ranked={list.is_ranked ? 'true' : 'false'}
                data-visibility={list.visibility}
              >
                <ListCard
                  id={list.id}
                  title={list.title}
                  isRanked={list.is_ranked}
                  visibility={list.visibility}
                  entryCount={list.entryCount}
                  coverUrls={list.coverUrls}
                  coverImageUrl={list.cover_image_url}
                  showOwner={false}
                  showActions={true}
                  ownerId={reviewer.id}
                  isLoggedIn={isLoggedIn}
                  currentProfileId={currentProfileId}
                />
              </div>
            ))}
          </div>
          <div class="list-no-results" id="my-no-results" style="display:none">No lists match these filters.</div>
        </>
      )}
    </div>

    <!-- ── SAVED LISTS SECTION ── -->
    <div id="lists-saved-section" style="display: none">
      {savedLists.length === 0 ? (
        <div class="empty-state-tab">
          <div class="empty-title">{isOwnProfile ? "No saved lists yet" : `@${reviewer.username} hasn't saved any public lists yet`}</div>
          {isOwnProfile && <p style="font-size: 13px; color: var(--text-tertiary); margin-top: 8px">Browse public lists and hit "Save list" to bookmark them here</p>}
        </div>
      ) : (
        <>
          <!-- Filter bar + settings button -->
          <div class="lf-bar">
            <input class="lf-search" type="text" placeholder="Search lists…" oninput="searchLists('saved',this.value)" />
            <select class="lf-select" onchange="setListSort('saved',this.value)">
              <option value="recent">Recent</option>
              <option value="oldest">Oldest</option>
              <option value="az">A–Z</option>
              <option value="most-games">Most Games</option>
              <option value="highest-rated">Highest Rated</option>
              <option value="lowest-rated">Lowest Rated</option>
              <option value="most-hours">Most Hours</option>
            </select>
            {savedGenres.length > 0 && (
              <select class="lf-select" onchange="setListFilter('saved','genre',this.value,this)">
                <option value="">All Genres</option>
                {savedGenres.map((g: string) => <option value={g}>{g}</option>)}
              </select>
            )}
            {savedPlatforms.length > 0 && (
              <select class="lf-select" onchange="setListFilter('saved','platform',this.value,this)">
                <option value="">All Platforms</option>
                {savedPlatforms.map((p: string) => <option value={p}>{p}</option>)}
              </select>
            )}
            {savedDevs.length > 0 && (
              <select class="lf-select" onchange="setListFilter('saved','dev',this.value,this)">
                <option value="">All Devs</option>
                {savedDevs.map((d: string) => <option value={d}>{d}</option>)}
              </select>
            )}
            <label class="lf-checkbox">
              <input type="checkbox" onchange="setListCheckboxFilter('saved','ranked',this.checked)" /> Ranked
            </label>
            {isOwnProfile && (
              <label class="lf-checkbox">
                <input type="checkbox" onchange="setListCheckboxFilter('saved','hidden',this.checked)" /> Hidden
              </label>
            )}
            {isOwnProfile && (
              <button id="saved-settings-btn" class="list-settings-btn" style="margin-left:auto" onclick="toggleSavedEditMode(this)" title="Manage saved list visibility">
                ⚙ Manage
              </button>
            )}
          </div>

          <div class="lists-grid" id="saved-lists-grid">
            {savedLists.map((list: any) => (
              <div class={`list-card-wrapper saved-list-wrap${list.isHidden ? ' is-hidden' : ''}`}
                data-title={list.title}
                data-updated={list.updated_at}
                data-count={list.entryCount}
                data-genres={(list.genres ?? []).join(',')}
                data-platforms={(list.platforms ?? []).join(',')}
                data-devs={(list.devs ?? []).join(',')}
                data-min-year={list.minYear ?? ''}
                data-avg-score={list.avgScore != null ? list.avgScore.toFixed(2) : ''}
                data-total-hours={list.totalHours ?? 0}
                data-ranked={list.is_ranked ? 'true' : 'false'}
                data-hidden={list.isHidden ? 'true' : 'false'}
              >
                <ListCard
                  id={list.id}
                  title={list.title}
                  isRanked={list.is_ranked}
                  visibility={list.visibility}
                  entryCount={list.entryCount}
                  coverUrls={list.coverUrls}
                  coverImageUrl={list.cover_image_url}
                  ownerUsername={list.ownerUsername}
                  ownerAvatar={list.ownerAvatar}
                  showOwner={true}
                  showActions={true}
                  ownerId={list.ownerId}
                  isLoggedIn={isLoggedIn}
                  currentProfileId={currentProfileId}
                />
                {isOwnProfile && (
                  <button
                    class="saved-hide-btn"
                    data-list-id={list.id}
                    data-hidden={String(list.isHidden)}
                    onclick="toggleSaveHidden(this)"
                    title={list.isHidden ? 'Show on profile' : 'Hide from profile'}
                  >{list.isHidden ? '👁' : '🫥'}</button>
                )}
              </div>
            ))}
          </div>
          <div class="list-no-results" id="saved-no-results" style="display:none">No lists match these filters.</div>
        </>
      )}
    </div>
