---
// Owner-only "hide this showcase" control. hideShowcase() lives in the
// profile page's script; styles (.sc-hide-btn) are in its global block.
interface Props {
  section: string;
  label: string;
  /** Dark translucent variant for buttons sitting on the favorite-game artwork. */
  onImage?: boolean;
}
const { section, label, onImage = false } = Astro.props;
---
<button
  type="button"
  class={`sc-hide-btn${onImage ? ' sc-hide-btn--on-image' : ''}`}
  onclick={`hideShowcase('${section}', this)`}
  title="Hide from profile"
  aria-label={`Hide ${label} from your profile`}
>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
    <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/>
    <line x1="1" y1="1" x2="23" y2="23"/>
  </svg>
</button>
