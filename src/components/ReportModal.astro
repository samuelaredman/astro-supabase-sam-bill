<!-- Drop this component anywhere on a page. It renders a hidden modal + the JS to open/submit it. -->
<!-- Trigger: call window.openReport(targetType, targetId) from any report button. -->

<div id="reportModal" class="report-modal-backdrop" style="display:none" role="dialog" aria-modal="true" aria-label="Report content">
  <div class="report-modal">
    <div class="report-modal-header">
      <span class="report-modal-title">Report content</span>
      <button class="report-modal-close" id="reportModalClose" aria-label="Close">✕</button>
    </div>
    <p class="report-modal-sub">Why are you reporting this?</p>
    <div class="report-reasons" id="reportReasons">
      <label class="report-reason"><input type="radio" name="reportReason" value="spam" /> Spam or misleading</label>
      <label class="report-reason"><input type="radio" name="reportReason" value="harassment" /> Harassment or hate</label>
      <label class="report-reason"><input type="radio" name="reportReason" value="spoilers" /> Unmarked spoilers</label>
      <label class="report-reason"><input type="radio" name="reportReason" value="inappropriate" /> Inappropriate content</label>
      <label class="report-reason"><input type="radio" name="reportReason" value="other" /> Other</label>
    </div>
    <textarea id="reportNotes" class="report-notes" placeholder="Additional details (optional)" maxlength="500" rows="3"></textarea>
    <div class="report-modal-error" id="reportModalError" style="display:none"></div>
    <div class="report-modal-footer">
      <button class="report-cancel-btn" id="reportCancelBtn">Cancel</button>
      <button class="report-submit-btn" id="reportSubmitBtn">Submit report</button>
    </div>
    <div class="report-success" id="reportSuccess" style="display:none">
      <span>✓ Report submitted. Thank you.</span>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var modal = document.getElementById('reportModal');
    var closeBtn = document.getElementById('reportModalClose');
    var cancelBtn = document.getElementById('reportCancelBtn');
    var submitBtn = document.getElementById('reportSubmitBtn');
    var errorEl = document.getElementById('reportModalError');
    var successEl = document.getElementById('reportSuccess');
    var notesEl = document.getElementById('reportNotes');

    var _targetType = null;
    var _targetId = null;

    window.openReport = function (targetType, targetId) {
      _targetType = targetType;
      _targetId = targetId;
      // reset state
      document.querySelectorAll('input[name="reportReason"]').forEach(function (r) { r.checked = false; });
      notesEl.value = '';
      errorEl.style.display = 'none';
      successEl.style.display = 'none';
      document.getElementById('reportReasons').style.display = '';
      notesEl.style.display = '';
      document.querySelector('.report-modal-footer').style.display = '';
      modal.style.display = 'flex';
      if (window.__lockScroll) window.__lockScroll();
    };

    function closeModal() {
      modal.style.display = 'none';
      if (window.__unlockScroll) window.__unlockScroll();
    }
    closeBtn.addEventListener('click', closeModal);
    cancelBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });

    submitBtn.addEventListener('click', async function () {
      errorEl.style.display = 'none';
      var reason = (document.querySelector('input[name="reportReason"]:checked') || {}).value;
      if (!reason) {
        errorEl.textContent = 'Please select a reason.';
        errorEl.style.display = 'block';
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting…';

      try {
        var res = await fetch('/api/reports/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ target_type: _targetType, target_id: _targetId, reason, notes: notesEl.value }),
        });
        var data = await res.json();

        if (!res.ok) {
          errorEl.textContent = data.error || 'Failed to submit report.';
          errorEl.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit report';
          return;
        }

        document.getElementById('reportReasons').style.display = 'none';
        notesEl.style.display = 'none';
        document.querySelector('.report-modal-footer').style.display = 'none';
        successEl.style.display = 'flex';
        setTimeout(closeModal, 1800);
      } catch {
        errorEl.textContent = 'Network error. Please try again.';
        errorEl.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit report';
      }
    });
  })();
</script>

<style>
  .report-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    z-index: 200;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
  }

  .report-modal {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 24px;
    width: 100%;
    max-width: 380px;
    margin: 0 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .report-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .report-modal-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .report-modal-close {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-tertiary);
    font-size: 14px;
    padding: 2px 6px;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
  }
  .report-modal-close:hover { color: var(--text-primary); background: var(--bg-hover); }

  .report-modal-sub {
    font-size: 13px;
    color: var(--text-secondary);
    margin: -6px 0;
  }

  .report-reasons {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .report-reason {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text-primary);
    cursor: pointer;
    padding: 8px 10px;
    border-radius: 8px;
    transition: background 0.12s;
  }
  .report-reason:hover { background: var(--bg-hover); }
  .report-reason input { accent-color: var(--accent); cursor: pointer; }

  .report-notes {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    color: var(--text-primary);
    background: var(--bg-hover);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 12px;
    resize: none;
    outline: none;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.15s;
    line-height: 1.5;
  }
  .report-notes:focus { border-color: var(--accent); }
  .report-notes::placeholder { color: var(--text-tertiary); }

  .report-modal-error {
    font-size: 12px;
    color: #f87171;
    background: rgba(248, 113, 113, 0.08);
    border: 1px solid rgba(248, 113, 113, 0.2);
    border-radius: 6px;
    padding: 7px 10px;
  }

  .report-modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }

  .report-cancel-btn {
    padding: 7px 16px;
    border-radius: 14px;
    font-size: 13px;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    border: 1px solid var(--border);
    background: none;
    color: var(--text-secondary);
    transition: border-color 0.15s;
  }
  .report-cancel-btn:hover { border-color: var(--text-tertiary); }

  .report-submit-btn {
    padding: 7px 16px;
    border-radius: 14px;
    font-size: 13px;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    border: none;
    background: var(--accent);
    color: white;
    transition: opacity 0.15s;
  }
  .report-submit-btn:hover { opacity: 0.88; }
  .report-submit-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .report-success {
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 500;
    color: #4ade80;
    gap: 8px;
    padding: 8px 0;
  }
</style>
