<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="footer-logo">Chekpoint</span>
      <span class="footer-copy">&copy; {new Date().getFullYear()} Chekpoint. All rights reserved.</span>
    </div>
    <nav class="footer-links">
      <a href="/about">About</a>
      <a href="/terms">Terms of Service</a>
      <a href="/privacy">Privacy Policy</a>
      <a href="/contact">Contact</a>
    </nav>
    <div class="footer-igdb">
      <a href="https://www.igdb.com" target="_blank" rel="noopener noreferrer" class="igdb-badge">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <rect width="14" height="14" rx="3" fill="#9146FF"/>
          <path d="M3 4h8v1.5H3V4zm0 2.5h6V8H3V6.5zm0 2.5h8v1.5H3V9z" fill="white"/>
        </svg>
        Powered by IGDB
      </a>
    </div>
  </div>
</footer>

<script is:inline>
  // Reserve space at the bottom of the page for the fixed footer so it never
  // covers content — set as an inline style (wins over any stylesheet,
  // including the several pages that redeclare their own plain `body{}` rule)
  // rather than a CSS var, since cascade order between those isn't reliable.
  // Below the mobile breakpoint the footer reverts to static (see its own
  // media query), so the inline override is cleared and each page's own
  // mobile bottom-nav padding applies instead.
  (function() {
    var footer = document.querySelector('.site-footer');
    if (!footer) return;
    var MOBILE_BP = 768;
    function apply() {
      if (window.innerWidth <= MOBILE_BP) {
        document.body.style.paddingBottom = '';
        document.documentElement.style.setProperty('--site-footer-h', '0px');
        return;
      }
      var h = footer.offsetHeight;
      document.body.style.paddingBottom = h + 'px';
      // Exposed for other fixed-to-bottom UI (e.g. the cookie banner) to stack
      // above the footer instead of covering it.
      document.documentElement.style.setProperty('--site-footer-h', h + 'px');
    }
    apply();
    if ('ResizeObserver' in window) new ResizeObserver(apply).observe(footer);
    window.addEventListener('resize', apply);
  })();
</script>

<style>
  .site-footer {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    border-top: 1px solid var(--border);
    background: var(--bg-sidebar);
    padding: 20px 0;
  }
  /* Mobile already has its own fixed bottom tab bar (.mobile-nav) — a second
     fixed bar stacked on top of it would eat too much of a small viewport,
     so the footer reverts to sitting in normal document flow there. */
  @media (max-width: 768px) {
    .site-footer { position: static; }
  }
  .footer-inner {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .footer-logo {
    font-family: 'Press Start 2P', monospace;
    font-size: 10px;
    color: var(--logo-color);
  }
  .footer-copy {
    font-size: 12px;
    color: var(--text-tertiary);
  }
  .footer-links {
    display: flex;
    gap: 20px;
  }
  .footer-links a {
    font-size: 12px;
    color: var(--text-tertiary);
    transition: color 0.15s;
  }
  .footer-links a:hover { color: var(--text-primary); }
  .igdb-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--text-tertiary);
    transition: color 0.15s;
  }
  .igdb-badge:hover { color: var(--text-secondary); }
  @media (max-width: 768px) {
    .footer-inner { flex-direction: column; align-items: flex-start; gap: 10px; }
    .footer-brand { flex-direction: column; align-items: flex-start; gap: 4px; }
  }
</style>
