---
interface Props {
  /** Absolute or root-relative URL to share. Defaults to the current page. */
  url?: string;
  label?: string;
  /**
   * 'pill' — full button with label (profile/review/group page headers).
   * 'icon' — small icon-only button matching edit/delete icons on flat card backgrounds.
   * 'overlay' — small icon-only button with a dark circular badge, for use atop cover images.
   */
  variant?: 'pill' | 'icon' | 'overlay';
  /**
   * When provided, the share panel also offers "Copy Image" / "Download Image"
   * for this image (fetched from this URL), and native OS share (see below)
   * shares the image file itself instead of just the link.
   */
  imageUrl?: string;
}

const { url, label = "Share", variant = 'pill', imageUrl } = Astro.props;
const shareUrl = url ?? Astro.url.pathname;
const iconOnly = variant !== 'pill';
---

<button
  class={`share-btn share-btn-${variant}`}
  type="button"
  data-share-url={shareUrl}
  data-share-title={label}
  data-share-image={imageUrl ?? ''}
  title={iconOnly ? label : undefined}
>
  {iconOnly ? (
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21C3 14.5 8.5 9 15 9V4.5L22 12L15 19.5V15C9 15 5 18 3 21Z"/></svg>
  ) : (
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21C3 14.5 8.5 9 15 9V4.5L22 12L15 19.5V15C9 15 5 18 3 21Z"/></svg>
  )}
  {variant === 'pill' && <span class="share-btn-label">{label}</span>}
  <span class="share-btn-toast">Link copied</span>
</button>

<style>
  .share-btn {
    position: relative;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 14px; border-radius: 20px;
    font-size: 13px; font-weight: 500; font-family: inherit;
    color: var(--text-secondary); background: var(--bg-card);
    border: 1px solid var(--border); cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .share-btn:hover { border-color: var(--accent); color: var(--accent); }
  .share-btn-toast {
    display: none; position: absolute; bottom: calc(100% + 6px); left: 50%;
    transform: translateX(-50%); white-space: nowrap;
    background: var(--text-primary); color: var(--bg-card);
    font-size: 11px; font-weight: 500; padding: 4px 8px; border-radius: 6px;
    z-index: 10;
  }
  .share-btn.copied .share-btn-toast { display: block; }

  /* ── icon variant — matches edit/delete icon buttons on flat card backgrounds ── */
  .share-btn.share-btn-icon {
    padding: 3px; border: none; background: none; border-radius: 5px;
    color: var(--text-tertiary);
  }
  .share-btn.share-btn-icon:hover { color: var(--accent); background: rgba(99, 102, 241, 0.08); }

  /* ── overlay variant — dark circular badge, for use atop cover images ── */
  .share-btn.share-btn-overlay {
    padding: 0; width: 22px; height: 22px;
    display: inline-flex; align-items: center; justify-content: center;
    border: none; border-radius: 6px;
    background: rgba(0, 0, 0, .55); color: #fff;
  }
  .share-btn.share-btn-overlay:hover { background: rgba(96, 80, 200, .85); color: #fff; }
</style>

<style is:global>
  #share-panel {
    flex-direction: column;
    gap: 2px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 5px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    min-width: 190px;
  }
  #share-panel button {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 7px 10px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    font-family: inherit;
    color: var(--text-secondary);
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background 0.1s, color 0.1s;
  }
  #share-panel button svg { flex-shrink: 0; }
  #share-panel button:hover:not(:disabled) {
    background: var(--bg-hover);
    color: var(--text-primary);
  }
  #share-panel button:disabled { opacity: 0.5; cursor: default; }
  #share-panel .share-panel-divider {
    height: 1px;
    background: var(--border-subtle, var(--border));
    margin: 4px 2px;
  }
</style>

<script>
  if (!(window as any).__shareBtnInit) {
    (window as any).__shareBtnInit = true;

    // ── Singleton dropdown panel — shared across every ShareButton on the page ──
    const panel = document.createElement('div');
    panel.id = 'share-panel';
    panel.style.cssText = 'display:none;position:fixed;z-index:9999';
    panel.innerHTML =
      '<button id="share-opt-native">' +
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>' +
        'Share…' +
      '</button>' +
      '<button id="share-opt-link">' +
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>' +
        'Copy link' +
      '</button>' +
      '<button id="share-opt-image">' +
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>' +
        'Copy Image' +
      '</button>' +
      '<button id="share-opt-download">' +
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>' +
        'Download Image' +
      '</button>' +
      '<div class="share-panel-divider"></div>' +
      '<button id="share-opt-reddit">' +
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="13.2" r="7.6"/><circle cx="19.2" cy="7.4" r="1.6" fill="var(--bg-card)"/><circle cx="8.6" cy="13" r="1.4" fill="var(--bg-card)"/><circle cx="15.4" cy="13" r="1.4" fill="var(--bg-card)"/><path d="M8.6 16.2c1 .9 2.2 1.3 3.4 1.3s2.4-.4 3.4-1.3" stroke="var(--bg-card)" stroke-width="1" stroke-linecap="round" fill="none"/><path d="M19.2 7.4 20.8 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><circle cx="12" cy="4" r="1" /></svg>' +
        'Share to Reddit' +
      '</button>' +
      '<button id="share-opt-discord">' +
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 8.5C8 6.8 10 6 12 6s4 .8 6 2.5c1.3 3 1.6 6.3.9 9-1.4.9-2.8 1.4-4.2 1.6l-.6-1.4c.7-.2 1.4-.5 2-.9-1.4.6-3 .9-4.6.9s-3.2-.3-4.6-.9c.6.4 1.3.7 2 .9L8.3 19c-1.4-.2-2.8-.7-4.2-1.6-.6-2.5-.4-5.9.9-8.9Z"/><circle cx="9.3" cy="13" r="1.3" fill="var(--bg-card)"/><circle cx="14.7" cy="13" r="1.3" fill="var(--bg-card)"/></svg>' +
        'Share to Discord' +
      '</button>' +
      '<button id="share-opt-steam">' +
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="9.2"/><circle cx="15" cy="9" r="2.6"/><circle cx="15" cy="9" r="0.8" fill="currentColor"/><path d="M8.6 14.4a2.4 2.4 0 1 0 2 4.3" /><path d="M9.6 14.9 12.8 11" /></svg>' +
        'Share to Steam' +
      '</button>';
    document.body.appendChild(panel);

    const nativeOpt = panel.querySelector('#share-opt-native') as HTMLButtonElement;
    const imageOptEl = panel.querySelector('#share-opt-image') as HTMLButtonElement;
    const downloadOptEl = panel.querySelector('#share-opt-download') as HTMLButtonElement;

    // Native OS share sheet (Messages/AirDrop/Mail on Mac & iOS, the Android
    // share tray, etc.) is only offered when the browser actually supports it —
    // desktop Chrome/Firefox generally don't, so we hide the entry there rather
    // than show a dead button.
    const hasNativeShare = !!(navigator as any).share;
    if (nativeOpt) nativeOpt.style.display = hasNativeShare ? '' : 'none';

    let activeBtn: HTMLButtonElement | null = null;

    function absUrl(path: string): string {
      return new URL(path, window.location.origin).href;
    }

    function closePanel() {
      panel.style.display = 'none';
      activeBtn = null;
    }

    function openPanel(btn: HTMLButtonElement) {
      activeBtn = btn;
      const hasImage = !!btn.dataset.shareImage;
      if (imageOptEl) imageOptEl.style.display = hasImage ? '' : 'none';
      if (downloadOptEl) downloadOptEl.style.display = hasImage ? '' : 'none';
      panel.style.display = 'flex';
      requestAnimationFrame(function () {
        const rect = btn.getBoundingClientRect();
        const pRect = panel.getBoundingClientRect();
        let top = rect.top - pRect.height - 8;
        if (top < 8) top = rect.bottom + 8;
        let left = rect.left;
        if (left + pRect.width > window.innerWidth - 8) left = window.innerWidth - pRect.width - 8;
        panel.style.top = top + 'px';
        panel.style.left = left + 'px';
      });
    }

    function showToast(btn: HTMLButtonElement, msg: string) {
      const toast = btn.querySelector('.share-btn-toast') as HTMLElement | null;
      if (toast) toast.textContent = msg;
      btn.classList.add('copied');
      setTimeout(function () {
        btn.classList.remove('copied');
        if (toast) toast.textContent = 'Link copied';
      }, 2000);
    }

    function copyLink(btn: HTMLButtonElement, msg: string) {
      const url = absUrl(btn.dataset.shareUrl || window.location.pathname);
      navigator.clipboard?.writeText(url).then(function () { showToast(btn, msg); });
    }

    function downloadBlob(blob: Blob, filename: string) {
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
    }

    document.addEventListener('click', function (e) {
      const target = e.target as HTMLElement;

      // ── Native OS share sheet ───────────────────────────────────────────────
      const nativeOptClicked = target.closest('#share-opt-native') as HTMLElement | null;
      if (nativeOptClicked) {
        const btn = activeBtn;
        closePanel();
        if (!btn) return;
        const url = absUrl(btn.dataset.shareUrl || window.location.pathname);
        const title = btn.dataset.shareTitle || document.title;
        const imageUrl = btn.dataset.shareImage;

        const shareUrlOnly = function () {
          (navigator as any).share({ url: url, title: title }).catch(function () {});
        };

        if (imageUrl && (navigator as any).canShare) {
          fetch(absUrl(imageUrl))
            .then(function (r) { return r.blob(); })
            .then(function (blob) {
              const file = new File([blob], 'chekpoint.jpg', { type: blob.type || 'image/jpeg' });
              if ((navigator as any).canShare({ files: [file] })) {
                (navigator as any).share({ files: [file], title: title, url: url }).catch(shareUrlOnly);
              } else {
                shareUrlOnly();
              }
            })
            .catch(shareUrlOnly);
        } else {
          shareUrlOnly();
        }
        return;
      }

      // ── Copy link option ────────────────────────────────────────────────────
      const linkOpt = target.closest('#share-opt-link') as HTMLElement | null;
      if (linkOpt) {
        const btn = activeBtn;
        closePanel();
        if (!btn) return;
        copyLink(btn, 'Link copied');
        return;
      }

      // ── Copy image option ───────────────────────────────────────────────────
      const imageOpt = target.closest('#share-opt-image') as HTMLButtonElement | null;
      if (imageOpt) {
        const btn = activeBtn;
        const imageUrl = btn?.dataset.shareImage;
        closePanel();
        if (!btn || !imageUrl) return;

        const absImgUrl = absUrl(imageUrl);
        imageOpt.textContent = 'Copying…';
        imageOpt.setAttribute('disabled', 'true');

        fetch(absImgUrl)
          .then(function (r) { return r.blob(); })
          .then(function (blob) {
            imageOpt.textContent = 'Copy Image';
            imageOpt.removeAttribute('disabled');

            if ((window as any).ClipboardItem) {
              // Chrome/Edge: convert JPEG → PNG for clipboard (only PNG is supported)
              const objUrl = URL.createObjectURL(blob);
              const img = new Image();
              img.onload = function () {
                const canvas = document.createElement('canvas');
                canvas.width = img.naturalWidth;
                canvas.height = img.naturalHeight;
                (canvas.getContext('2d') as CanvasRenderingContext2D).drawImage(img, 0, 0);
                URL.revokeObjectURL(objUrl);
                canvas.toBlob(function (png) {
                  if (!png) { downloadBlob(blob, 'chekpoint.jpg'); showToast(btn, 'Image saved'); return; }
                  navigator.clipboard.write([(new (window as any).ClipboardItem({ 'image/png': png }))])
                    .then(function () { showToast(btn, 'Image copied'); })
                    .catch(function () { downloadBlob(blob, 'chekpoint.jpg'); showToast(btn, 'Image saved'); });
                }, 'image/png');
              };
              img.onerror = function () {
                URL.revokeObjectURL(objUrl);
                downloadBlob(blob, 'chekpoint.jpg');
                showToast(btn, 'Image saved');
              };
              img.src = objUrl;
            } else {
              // Firefox / Safari fallback: download the JPEG directly
              downloadBlob(blob, 'chekpoint.jpg');
              showToast(btn, 'Image saved');
            }
          })
          .catch(function () {
            imageOpt.textContent = 'Copy Image';
            imageOpt.removeAttribute('disabled');
            window.open(absImgUrl, '_blank');
          });
        return;
      }

      // ── Download image option ───────────────────────────────────────────────
      const downloadOpt = target.closest('#share-opt-download') as HTMLButtonElement | null;
      if (downloadOpt) {
        const btn = activeBtn;
        const imageUrl = btn?.dataset.shareImage;
        closePanel();
        if (!btn || !imageUrl) return;

        const absImgUrl = absUrl(imageUrl);
        downloadOpt.textContent = 'Downloading…';
        downloadOpt.setAttribute('disabled', 'true');

        fetch(absImgUrl)
          .then(function (r) { return r.blob(); })
          .then(function (blob) {
            downloadOpt.textContent = 'Download Image';
            downloadOpt.removeAttribute('disabled');
            downloadBlob(blob, 'chekpoint.jpg');
            showToast(btn, 'Image saved');
          })
          .catch(function () {
            downloadOpt.textContent = 'Download Image';
            downloadOpt.removeAttribute('disabled');
            window.open(absImgUrl, '_blank');
          });
        return;
      }

      // ── Share to Reddit — opens Reddit's own submit page, prefilled ────────
      const redditOpt = target.closest('#share-opt-reddit') as HTMLElement | null;
      if (redditOpt) {
        const btn = activeBtn;
        closePanel();
        if (!btn) return;
        const url = absUrl(btn.dataset.shareUrl || window.location.pathname);
        const title = btn.dataset.shareTitle || document.title;
        const redditUrl = 'https://www.reddit.com/submit?url=' + encodeURIComponent(url) + '&title=' + encodeURIComponent(title);
        window.open(redditUrl, '_blank', 'noopener,noreferrer,width=880,height=740');
        return;
      }

      // ── Share to Discord / Steam — neither platform exposes a web intent for
      // posting into an arbitrary channel/chat, so the practical equivalent is
      // copying the link (pasting it into either app unfurls our OG preview). ──
      const discordOpt = target.closest('#share-opt-discord') as HTMLElement | null;
      if (discordOpt) {
        const btn = activeBtn;
        closePanel();
        if (!btn) return;
        copyLink(btn, 'Link copied — paste in Discord');
        return;
      }

      const steamOpt = target.closest('#share-opt-steam') as HTMLElement | null;
      if (steamOpt) {
        const btn = activeBtn;
        closePanel();
        if (!btn) return;
        copyLink(btn, 'Link copied — paste in Steam chat');
        return;
      }

      // ── Share button click — always opens the panel ─────────────────────────
      const btn = target.closest('.share-btn') as HTMLButtonElement | null;
      if (btn) {
        if (panel.style.display !== 'none' && activeBtn === btn) {
          closePanel();
        } else {
          closePanel();
          openPanel(btn);
        }
        return;
      }

      // ── Outside click closes panel ──────────────────────────────────────────
      if (!target.closest('#share-panel')) closePanel();
    });
  }
</script>
