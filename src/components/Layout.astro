---
import TourManager from "./TourManager.astro";
import OnboardingWizard from "./OnboardingWizard.astro";
import { createSupabaseServerClientFromContext } from "../utils/database";
import "../styles/shared.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  isLoggedIn?: boolean;
  currentProfile?: { id: string; username: string; avatar_url: string | null } | null;
  activeNav?: 'home' | 'discover' | 'rankings' | 'lists' | 'following' | 'search' | 'profile' | 'hot-takes' | 'notifications' | 'settings' | 'groups' | 'recommendations' | 'updates' | 'drafts';
  /** 'three-col' (default) | 'two-col' (no right sidebar) | 'centered' (auth/static pages) | 'fullwidth' (game/detail pages with own nav) */
  variant?: 'three-col' | 'two-col' | 'centered' | 'fullwidth';
  /** Emit <meta name="robots" content="noindex, nofollow"> — used to keep
   *  user content out of search engines until its author consents to indexing. */
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage,
  isLoggedIn = false,
  currentProfile = null,
  activeNav,
  variant = 'three-col',
  noindex = false,
} = Astro.props;

const canonicalUrl = Astro.url.href;

// Site-wide default so every page ships a sensible meta description for search
// engines (pages can still pass their own more specific `description`).
const DEFAULT_DESCRIPTION =
  "Community-driven video game reviews from players. Read honest reviews and recommendations. Discover your next game to play on Chekpoint.";
const metaDescription = description ?? DEFAULT_DESCRIPTION;

const hasSidebarRight = variant === 'three-col' && Astro.slots.has('sidebar-right');
const layoutClass = variant === 'centered' ? 'layout no-sidebar' : variant === 'two-col' ? 'layout two-col' : hasSidebarRight ? 'layout' : 'layout two-col';
const isFullwidth = variant === 'fullwidth';

function getInitials(username: string): string {
  return username.slice(0, 2).toUpperCase();
}

// Site-wide onboarding gate: only shown to new users (onboarding_completed_at IS NULL).
// Existing users are grandfathered by a one-time data migration that sets
// onboarding_completed_at on all pre-existing profiles. Queried fresh here (rather
// than trusting whatever subset of columns the calling page's own
// `currentProfile` happens to select) so this stays correct regardless of
// what any given page fetches for its own purposes.
let onboardingGate: {
  hasAvatar: boolean;
  hasFavorite: boolean;
  hasShowcase: boolean;
  hasImportedBackloggd: boolean;
  onboardingCompletedAt: string | null;
  existingFavorite: { id: string; title: string; cover_img_url?: string | null; slug?: string | null } | null;
  existingShowcase: { id: string; title: string; cover_img_url?: string | null; slug?: string | null }[];
} | null = null;

if (isLoggedIn && currentProfile) {
  const supabase = createSupabaseServerClientFromContext(Astro);
  const { data: onboardingProfile } = await supabase
    .from('profiles')
    .select('avatar_url, favorite_game_id, showcase_games, backloggd_import_done_at, onboarding_completed_at, favorite_game:games!favorite_game_id (id, title, slug, cover_img_url)')
    .eq('id', currentProfile.id)
    .maybeSingle();

  if (onboardingProfile) {
    const existingShowcase = (Array.isArray(onboardingProfile.showcase_games) ? onboardingProfile.showcase_games : []).filter(Boolean);
    // Supabase types this to-one embed as an array — normalize to a single object.
    const favoriteGameRaw = onboardingProfile.favorite_game as any;
    const existingFavorite = Array.isArray(favoriteGameRaw) ? (favoriteGameRaw[0] ?? null) : (favoriteGameRaw ?? null);
    onboardingGate = {
      hasAvatar: !!onboardingProfile.avatar_url,
      hasFavorite: !!onboardingProfile.favorite_game_id,
      hasShowcase: existingShowcase.length >= 3,
      hasImportedBackloggd: !!onboardingProfile.backloggd_import_done_at,
      onboardingCompletedAt: onboardingProfile.onboarding_completed_at ?? null,
      existingFavorite,
      existingShowcase,
    };
  }
}
const needsOnboarding = !!onboardingGate && !onboardingGate.onboardingCompletedAt;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Runs synchronously before CSS is applied — prevents dark mode flash -->
  <script is:inline>
    (function() {
      var t = localStorage.getItem('theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', t);
      var m = document.getElementById('meta-theme-color');
      if (m) m.content = t === 'dark' ? '#0f0f0e' : '#f9f8f6';
    })();
  </script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <meta name="theme-color" id="meta-theme-color" content="#f9f8f6" />
  <title>{title}</title>
  <meta name="description" content={metaDescription} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" type="application/rss+xml" title="Chekpoint — Latest Game Reviews" href="https://chekpoint.gg/rss.xml" />
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Chekpoint" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={metaDescription} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:url" content={canonicalUrl} />
  <!-- Twitter / X card -->
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={metaDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />
  <slot name="head" />
  <!-- Google Search Console verification -->
  <meta name="google-site-verification" content="l1TgpE7YMhgtwQDau-96h_eqePqIgzVJPx6cB95HDn4" />
  <!-- Google Analytics 4 with Consent Mode v2 (analytics off by default) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TFBYE9G1QW" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    // Deny analytics by default — updated to 'granted' only if user accepts
    gtag('consent', 'default', { analytics_storage: 'denied', wait_for_update: 500 });
    gtag('js', new Date());
    gtag('config', 'G-TFBYE9G1QW');
    // If user has already accepted in a previous visit, grant immediately
    if (typeof localStorage !== 'undefined' && localStorage.getItem('cookie-consent') === 'accepted') {
      gtag('consent', 'update', { analytics_storage: 'granted' });
    }
  </script>
  <link rel="manifest" href="/manifest.json" />
  <link rel="apple-touch-icon" href="/favicon.svg" />
  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function() {
        navigator.serviceWorker.register('/sw.js').catch(function() {});
      });
    }
  </script>
</head>

<body>

{isFullwidth ? (
  <slot />
) : variant === 'centered' ? (
  <div class="centered-wrap">
    <slot />
  </div>
) : (
  <div class={layoutClass}>
    <aside class="sidebar-left">
      <a href="/" class="logo"><span class="logo-dot"></span>Chekpoint</a>

      <a href="/" class={`nav-item${activeNav === 'home' ? ' active' : ''}`}>
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 7L9 2L16 7V16H11V11H7V16H2V7Z"/>
          </svg>
        </span>
        Home
      </a>

      <a href="/discover" class={`nav-item${activeNav === 'discover' ? ' active' : ''}`}>
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="9" r="7"/>
            <polygon points="12,6 7,9 9,13 14,10" fill="currentColor" stroke="none"/>
            <polygon points="6,12 11,9 9,5 4,8" opacity="0.4" fill="currentColor" stroke="none"/>
          </svg>
        </span>
        Discover
      </a>

      <a href="/rankings" class={`nav-item${activeNav === 'rankings' ? ' active' : ''}`}>
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="10" width="3" height="6" rx="1"/>
            <rect x="7.5" y="6" width="3" height="10" rx="1"/>
            <rect x="13" y="2" width="3" height="14" rx="1"/>
          </svg>
        </span>
        Rankings
      </a>

      <a href="/lists" class={`nav-item${activeNav === 'lists' ? ' active' : ''}`}>
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="2" y1="4.5" x2="16" y2="4.5"/>
            <line x1="2" y1="9" x2="16" y2="9"/>
            <line x1="2" y1="13.5" x2="10" y2="13.5"/>
          </svg>
        </span>
        Lists
      </a>

      <a href="/groups" class={`nav-item${activeNav === 'groups' ? ' active' : ''}`}>
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="6.5" cy="6" r="2.5"/>
            <path d="M2 15c0-2.49 2.01-4.5 4.5-4.5S11 12.51 11 15"/>
            <circle cx="12.5" cy="6.5" r="2"/>
            <path d="M12 10.6c1.97.28 3.5 1.97 3.5 4"/>
          </svg>
        </span>
        Groups
      </a>

      <a href="/search" class={`nav-item${activeNav === 'search' ? ' active' : ''}`}>
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="8" cy="8" r="5"/>
            <path d="M13 13l3 3"/>
          </svg>
        </span>
        Search
      </a>

      <div class="sidebar-bottom">
        <a href="/updates" class={`nav-item${activeNav === 'updates' ? ' active' : ''}`}>
          <span class="nav-icon" style="position:relative">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 7v4a1 1 0 0 0 1 1h2l4 3V3L6 6H4a1 1 0 0 0-1 1Z"/>
              <path d="M13 6.5a3 3 0 0 1 0 5"/>
            </svg>
            <span id="updatesDot" style="display:none;position:absolute;top:-3px;right:-4px;width:8px;height:8px;border-radius:50%;background:var(--accent);border:1.5px solid var(--bg)"></span>
          </span>
          Updates
        </a>

        <a href="https://discord.gg/GpxYfbDgy" target="_blank" rel="noopener noreferrer" class="nav-item">
          <span class="nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
          </span>
          Discord
        </a>

        <div class="nav-divider"></div>

        {isLoggedIn ? (
          <>
            <a href={currentProfile ? `/reviewers/${currentProfile.username}` : '/signin'} class={`nav-item${activeNav === 'profile' ? ' active' : ''}`}>
              <div class="sidebar-avatar">
                {currentProfile?.avatar_url
                  ? <img src={currentProfile.avatar_url} alt={currentProfile.username} />
                  : <span>{getInitials(currentProfile?.username ?? '?')}</span>
                }
              </div>
              My Profile
            </a>

            <a href="/notifications" class={`nav-item${activeNav === 'notifications' ? ' active' : ''}`} id="notifNavLink">
              <span class="nav-icon" style="position:relative">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M13.5 6a4.5 4.5 0 0 0-9 0c0 5-2 6.5-2 6.5h13s-2-1.5-2-6.5"/>
                  <path d="M10.3 15a1.5 1.5 0 0 1-2.6 0"/>
                </svg>
                <span class="notif-badge" id="notifBadge" style="display:none"></span>
              </span>
              Notifications
            </a>

            <a href="/following" class={`nav-item${activeNav === 'following' ? ' active' : ''}`}>
              <span class="nav-icon">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M13 14c0-2.21-1.79-4-4-4s-4 1.79-4 4"/>
                  <circle cx="9" cy="6" r="3"/>
                  <path d="M16 14c0-1.86-1.28-3.41-3-3.83"/>
                  <path d="M15 4a3 3 0 010 4"/>
                </svg>
              </span>
              Following
            </a>

            <a href="/drafts" class={`nav-item${activeNav === 'drafts' ? ' active' : ''}`}>
              <span class="nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 20h9"/>
                  <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                </svg>
              </span>
              Drafts
            </a>

            <a href="/settings" class={`nav-item${activeNav === 'settings' ? ' active' : ''}`}>
              <span class="nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="3"/>
                  <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                </svg>
              </span>
              Settings
            </a>
          </>
        ) : (
          <a href="/signin" class="nav-item">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 11v4M9 3v4M5 7h8M3 15h12"/>
              </svg>
            </span>
            Sign in / Sign up
          </a>
        )}

        <div class="nav-divider"></div>
        <button class="theme-toggle" id="themeToggle">
          <span class="nav-icon" id="themeIcon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="9" r="3.5"/>
              <path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.22 3.22l1.42 1.42M13.36 13.36l1.42 1.42M13.36 4.64l1.42-1.42M3.22 14.78l1.42-1.42"/>
            </svg>
          </span>
          <span id="themeLabel">Light mode</span>
        </button>
      </div>
    </aside>

    <slot />

    {hasSidebarRight && (
      <aside class="sidebar-right">
        <slot name="sidebar-right" />
      </aside>
    )}
  </div>
)}

{!isFullwidth && variant !== 'centered' && (
  <nav class="mobile-nav" aria-label="Mobile navigation">

    <a href="/" class={`mn-item${activeNav === 'home' ? ' active' : ''}`}>
      <span class="mn-icon">
        <svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 7L9 2L16 7V16H11V11H7V16H2V7Z"/>
        </svg>
      </span>
      <span class="mn-label">Home</span>
    </a>

    <a href="/discover" class={`mn-item${activeNav === 'discover' ? ' active' : ''}`}>
      <span class="mn-icon">
        <svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="9" r="7"/>
          <polygon points="12,6 7,9 9,13 14,10" fill="currentColor" stroke="none"/>
          <polygon points="6,12 11,9 9,5 4,8" opacity="0.4" fill="currentColor" stroke="none"/>
        </svg>
      </span>
      <span class="mn-label">Discover</span>
    </a>

    <a href="/search" class={`mn-item${activeNav === 'search' ? ' active' : ''}`}>
      <span class="mn-icon">
        <svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="8" cy="8" r="5"/><path d="M13 13l3 3"/>
        </svg>
      </span>
      <span class="mn-label">Search</span>
    </a>

    {isLoggedIn ? (
      <>
        <a href="/notifications" class={`mn-item${activeNav === 'notifications' ? ' active' : ''}`}>
          <span class="mn-icon" style="position:relative">
            <svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13.5 6a4.5 4.5 0 0 0-9 0c0 5-2 6.5-2 6.5h13s-2-1.5-2-6.5"/>
              <path d="M10.3 15a1.5 1.5 0 0 1-2.6 0"/>
            </svg>
            <span class="mn-notif-dot" id="mobileNotifDot" style="display:none"></span>
          </span>
          <span class="mn-label">Notifs</span>
        </a>
        <a href={currentProfile ? `/reviewers/${currentProfile.username}` : '/signin'} class={`mn-item${activeNav === 'profile' ? ' active' : ''}`}>
          <span class="mn-icon mn-avatar">
            {currentProfile?.avatar_url
              ? <img src={currentProfile.avatar_url} alt={currentProfile.username} />
              : <span>{getInitials(currentProfile?.username ?? '?')}</span>
            }
          </span>
          <span class="mn-label">Profile</span>
        </a>
      </>
    ) : (
      <>
        <a href="/rankings" class={`mn-item${activeNav === 'rankings' ? ' active' : ''}`}>
          <span class="mn-icon">
            <svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="10" width="3" height="6" rx="1"/>
              <rect x="7.5" y="6" width="3" height="10" rx="1"/>
              <rect x="13" y="2" width="3" height="14" rx="1"/>
            </svg>
          </span>
          <span class="mn-label">Rankings</span>
        </a>
        <a href="/signin" class="mn-item">
          <span class="mn-icon">
            <svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="7" r="3.5"/>
              <path d="M3 16c0-3.31 2.69-6 6-6s6 2.69 6 6"/>
            </svg>
          </span>
          <span class="mn-label">Sign In</span>
        </a>
      </>
    )}

  </nav>
)}

<!-- Cookie consent banner — shown only on first visit, respects theme -->
<div id="cookieBanner" role="dialog" aria-live="polite" aria-label="Cookie consent" style="display:none">
  <p class="cookie-text">
    We use analytics to understand how people use Chekpoint. No personal data is sold.
    <a href="/privacy">Privacy policy</a>
  </p>
  <div class="cookie-actions">
    <button id="cookieDecline" class="cookie-btn cookie-decline">Decline</button>
    <button id="cookieAccept" class="cookie-btn cookie-accept">Accept analytics</button>
  </div>
</div>

{isLoggedIn && currentProfile && <TourManager username={currentProfile.username} />}

{needsOnboarding && currentProfile && onboardingGate && (
  <OnboardingWizard
    username={currentProfile.username}
    hasAvatar={onboardingGate.hasAvatar}
    hasFavorite={onboardingGate.hasFavorite}
    hasShowcase={onboardingGate.hasShowcase}
    hasImportedBackloggd={onboardingGate.hasImportedBackloggd}
    existingFavorite={onboardingGate.existingFavorite}
    existingShowcase={onboardingGate.existingShowcase}
  />
)}

<script is:inline>
  function updateThemeUI(theme) {
    const label = document.getElementById('themeLabel');
    const icon = document.getElementById('themeIcon');
    if (!label || !icon) return;
    if (theme === 'dark') {
      label.textContent = 'Dark mode';
      icon.innerHTML = '<svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 10.5A7 7 0 016.5 3a7 7 0 100 12 7 7 0 008.5-4.5z"/></svg>';
    } else {
      label.textContent = 'Light mode';
      icon.innerHTML = '<svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="9" r="3.5"/><path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.22 3.22l1.42 1.42M13.36 13.36l1.42 1.42M13.36 4.64l1.42-1.42M3.22 14.78l1.42-1.42"/></svg>';
    }
  }

  const saved = localStorage.getItem('theme') ||
    (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  document.documentElement.setAttribute('data-theme', saved);
  updateThemeUI(saved);

  const toggle = document.getElementById('themeToggle');
  if (toggle) {
    toggle.addEventListener('click', () => {
      const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      updateThemeUI(next);
      const metaTheme = document.getElementById('meta-theme-color');
      if (metaTheme) metaTheme.content = next === 'dark' ? '#0f0f0e' : '#f9f8f6';
    });
  }

  // Scroll-lock utility — iOS-safe: saves position, fixes body, restores on unlock
  var __scrollLockY = 0;
  window.__lockScroll = function() {
    __scrollLockY = window.scrollY;
    document.body.style.position = 'fixed';
    document.body.style.top = '-' + __scrollLockY + 'px';
    document.body.style.width = '100%';
    document.body.style.overflow = 'hidden';
  };
  window.__unlockScroll = function() {
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.width = '';
    document.body.style.overflow = '';
    window.scrollTo(0, __scrollLockY);
  };

  // Cookie consent banner — only show if no decision has been recorded yet
  (function() {
    if (localStorage.getItem('cookie-consent')) return; // already decided
    var banner = document.getElementById('cookieBanner');
    if (!banner) return;
    banner.style.display = 'flex';

    document.getElementById('cookieAccept').addEventListener('click', function() {
      localStorage.setItem('cookie-consent', 'accepted');
      gtag('consent', 'update', { analytics_storage: 'granted' });
      banner.style.display = 'none';
    });

    document.getElementById('cookieDecline').addEventListener('click', function() {
      localStorage.setItem('cookie-consent', 'declined');
      banner.style.display = 'none';
    });
  })();

  // Notification badge — fetch unread count client-side so it doesn't slow page renders
  (function() {
    var badge = document.getElementById('notifBadge');
    var mobileDot = document.getElementById('mobileNotifDot');
    if (!badge && !mobileDot) return; // not logged in
    fetch('/api/notifications/count')
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (!d || !d.unread) return;
        if (badge) {
          badge.textContent = d.unread > 9 ? '9+' : String(d.unread);
          badge.style.display = 'flex';
        }
        if (mobileDot) mobileDot.style.display = 'block';
      })
      .catch(function() {});
  })();

  // Updates dot badge + pinned-post banner
  // Checked once per session (sessionStorage) to avoid fetching on every page.
  (function() {
    var dot = document.getElementById('updatesDot');
    var isUpdatesPage = window.location.pathname === '/updates' || window.location.pathname.startsWith('/updates/');

    // If user is on the updates page, clear the badge and record visit
    if (isUpdatesPage) {
      try { localStorage.setItem('updates_last_seen', new Date().toISOString()); } catch(e) {}
      if (dot) dot.style.display = 'none';
      return;
    }

    // Only check once per session
    var cacheKey = 'updates_latest_cache';
    var cached = null;
    try {
      var raw = sessionStorage.getItem(cacheKey);
      if (raw) cached = JSON.parse(raw);
    } catch(e) {}

    function applyUpdatesUI(data) {
      var lastSeen = null;
      try { lastSeen = localStorage.getItem('updates_last_seen'); } catch(e) {}

      // Dot badge — show if latest post is newer than last visit
      if (dot && data.latest_at) {
        var isNew = !lastSeen || new Date(data.latest_at) > new Date(lastSeen);
        if (isNew) dot.style.display = 'block';
      }

      // Pinned-post banner — show on home page only, dismiss per post ID
      if (data.pinned && window.location.pathname === '/') {
        var dismissedKey = 'updates_dismissed_' + data.pinned.id;
        var dismissed = false;
        try { dismissed = !!localStorage.getItem(dismissedKey); } catch(e) {}
        if (!dismissed) {
          var banner = document.createElement('div');
          banner.id = 'updates-banner';
          banner.innerHTML =
            '<span class="ub-icon">📌</span>' +
            '<span class="ub-text">New from the team: <a class="ub-link" href="/updates/' + data.pinned.id + '">' + data.pinned.title.replace(/</g,'&lt;') + '</a></span>' +
            '<button class="ub-dismiss" aria-label="Dismiss">×</button>';
          document.body.appendChild(banner);
          banner.querySelector('.ub-dismiss').addEventListener('click', function() {
            try { localStorage.setItem(dismissedKey, '1'); } catch(e) {}
            banner.style.opacity = '0';
            setTimeout(function() { banner.remove(); }, 250);
          });
          banner.querySelector('.ub-link').addEventListener('click', function() {
            try { localStorage.setItem(dismissedKey, '1'); } catch(e) {}
          });
        }
      }
    }

    if (cached) {
      applyUpdatesUI(cached);
    } else {
      fetch('/api/updates/latest')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          try { sessionStorage.setItem(cacheKey, JSON.stringify(data)); } catch(e) {}
          applyUpdatesUI(data);
        })
        .catch(function() {});
    }
  })();
</script>

</body>
</html>

<style is:global>
  /* ── Updates pinned-post banner ── */
  #updates-banner {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 300;
    display: flex; align-items: center; gap: 10px;
    background: var(--accent);
    color: #fff;
    padding: 10px 16px;
    font-size: 13px; font-weight: 500;
    transition: opacity 0.25s;
  }
  .ub-icon { font-size: 15px; flex-shrink: 0; }
  .ub-text { flex: 1; min-width: 0; }
  .ub-link { color: #fff; font-weight: 700; text-decoration: underline; text-underline-offset: 2px; }
  .ub-link:hover { opacity: 0.85; }
  .ub-dismiss {
    background: rgba(255,255,255,0.2); border: none; border-radius: 50%;
    color: #fff; width: 22px; height: 22px; font-size: 16px; line-height: 1;
    cursor: pointer; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
    transition: background 0.15s;
  }
  .ub-dismiss:hover { background: rgba(255,255,255,0.35); }

  /* ─── Mobile responsive: hide both sidebars, collapse grid ─────────────── */
  @media (max-width: 768px) {
    .layout .sidebar-left,
    .layout .sidebar-right {
      display: none !important;
    }
    .layout,
    .layout.two-col {
      grid-template-columns: 1fr !important;
    }
    .feed {
      border-right: none !important;
      min-width: 0;
    }
  }
</style>

<style>
