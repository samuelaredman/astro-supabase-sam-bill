    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  /* ── Cookie consent banner ── */
  #cookieBanner {
    position: fixed;
    bottom: var(--site-footer-h, 0px);
    left: 0;
    right: 0;
    z-index: 200;
    background: var(--bg-card);
    border-top: 1px solid var(--border);
    padding: 12px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--text-secondary);
  }
  /* On mobile, sit above the bottom nav */
  @media (max-width: 768px) {
    #cookieBanner {
      bottom: calc(56px + env(safe-area-inset-bottom));
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      padding: 14px 16px;
    }
  }
  .cookie-text { flex: 1; line-height: 1.5; }
  .cookie-text a { color: var(--text-primary); text-decoration: underline; text-underline-offset: 2px; }
  .cookie-actions { display: flex; gap: 8px; flex-shrink: 0; }
  .cookie-btn {
    padding: 7px 14px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    border: 1px solid var(--border);
    transition: opacity 0.15s;
  }
  .cookie-btn:hover { opacity: 0.8; }
  .cookie-decline { background: transparent; color: var(--text-secondary); }
  .cookie-accept { background: var(--accent); color: var(--accent-text); border-color: var(--accent); }

  /* ── Logo as home link ── */
  a.logo {
    text-decoration: none;
    color: inherit;
    display: flex;
    align-items: center;
  }
  a.logo:hover { opacity: 0.8; }

  .notif-badge {
    position: absolute;
    top: -4px;
    right: -5px;
    min-width: 16px;
    height: 16px;
    background: var(--accent);
    color: white;
    font-size: 9px;
    font-weight: 700;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 3px;
    line-height: 1;
    pointer-events: none;
  }
  .mn-notif-dot {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 50%;
    border: 1.5px solid var(--bg);
    pointer-events: none;
  }
</style>
