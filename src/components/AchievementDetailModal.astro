---
// Per-game achievement list modal — opened from the completion bar in the
// Library's detailed view and from a game's achievement badge in a list.
// Fetches /api/user-achievements/game and renders every achievement
// (unlocked + locked) with the global % and the time it was unlocked.
// Modelled on the native Steam / PS Trophies modal layout.
//
// Rendered as a single modal element with fixed ids (achDetailModal, …);
// the host page must not contain a second copy. The component bakes the
// target username into its script so each page using it only ever queries
// achievements for one profile; a page that needed to switch targets
// would need to extend the openAchDetail signature to take the username.
interface Props {
  username: string;
}
const { username } = Astro.props;
---
<style is:global>
  /* Base modal shell — subset of the review-picker modal styles so this
     component is self-sufficient on pages that don't already have them. */
  .modal-backdrop{display:none;position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.7);backdrop-filter:blur(8px);align-items:center;justify-content:center;padding:20px}
  .modal-backdrop.open{display:flex}
  .modal{background:var(--bg-card);border:1px solid var(--border);border-radius:20px;width:100%;max-width:520px;max-height:80vh;display:flex;flex-direction:column;box-shadow:0 24px 80px rgba(0,0,0,.8)}
  .modal-close{background:none;border:none;cursor:pointer;color:var(--text-tertiary);padding:6px;display:flex;transition:color .15s;font-size:20px;line-height:1}
  .modal-close:hover{color:var(--text-primary)}
  .modal-empty{padding:32px;text-align:center;color:var(--text-tertiary);font-size:14px}

  .ach-detail-modal{max-width:640px;max-height:88vh}
  .ach-detail-head{padding:18px 20px 10px;display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
  .ach-detail-head-text{min-width:0}
  .ach-detail-title{font-family:'DM Serif Display',serif;font-size:22px;letter-spacing:-.3px;line-height:1.1;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ach-detail-sub{font-size:12px;color:var(--text-tertiary);margin-top:3px}
  .ach-detail-progress{display:flex;align-items:center;gap:12px;padding:4px 20px 6px}
  .ach-detail-count{font-size:13px;font-weight:600;color:var(--text-primary);flex-shrink:0}
  .ach-detail-bar{flex:1;height:5px;border-radius:3px;background:var(--tag-bg);overflow:hidden}
  .ach-detail-bar-fill{height:100%;border-radius:3px;background:var(--score-great,#4ade80);transition:width .25s}
  .ach-detail-pct{font-size:13px;font-weight:600;color:var(--score-great,#4ade80);flex-shrink:0;min-width:42px;text-align:right}
  .ach-detail-rarity{display:flex;gap:10px;padding:0 20px 10px;flex-wrap:wrap}
  .ach-detail-rarity-chip{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;color:var(--text-secondary)}
  .ach-detail-rarity-dot{width:9px;height:9px;border-radius:50%;display:inline-block}
  .ach-detail-rarity-dot--platinum{background:#9b7bff}
  .ach-detail-rarity-dot--gold{background:#f5b544}
  .ach-detail-rarity-dot--silver{background:#c4c6cd}
  .ach-detail-rarity-dot--bronze{background:#cd7f32}
  .ach-detail-search-wrap{padding:4px 20px 12px}
  .ach-detail-search{width:100%;background:var(--bg-hover);border:1px solid var(--border);border-radius:10px;padding:9px 14px;font-size:13px;font-family:inherit;color:var(--text-primary);outline:none;transition:border-color .15s}
  .ach-detail-search:focus{border-color:var(--accent)}
  .ach-detail-body{flex:1;overflow-y:auto;padding:0 10px 14px;scrollbar-width:thin}
  .ach-row{display:flex;align-items:center;gap:12px;padding:10px;border-bottom:1px solid var(--border-subtle)}
  .ach-row:last-child{border-bottom:none}
  .ach-row-icon{position:relative;width:48px;height:48px;border-radius:8px;background:var(--tag-bg);border:1px solid var(--border);flex-shrink:0;overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:18px}
  .ach-row-icon img{width:100%;height:100%;object-fit:cover;display:block}
  .ach-row.locked .ach-row-icon img{filter:grayscale(1) brightness(.55);opacity:.75}
  .ach-row-icon--rare{overflow:visible;border-color:rgba(202,138,4,.6);
    box-shadow:0 0 10px rgba(202,138,4,.55),0 0 24px rgba(202,138,4,.25)}
  .ach-row-icon--rare img{border-radius:7px}
  .ach-row.locked .ach-row-icon--rare{box-shadow:0 0 8px rgba(202,138,4,.3)}
  .ach-row-icon--rare::before,
  .ach-row-icon--rare::after{
    content:'';
    position:absolute;inset:-20px;border-radius:50%;
    filter:blur(4px);
    mask:radial-gradient(circle,transparent 46%,rgba(0,0,0,.95) 53%,rgba(0,0,0,.18) 82%,transparent 100%);
    -webkit-mask:radial-gradient(circle,transparent 46%,rgba(0,0,0,.95) 53%,rgba(0,0,0,.18) 82%,transparent 100%);
    z-index:0;pointer-events:none;
  }
  .ach-row-icon--rare::before{
    background:conic-gradient(
      from 0deg,
      transparent 0deg,
      rgba(253,224,71,0) 14deg, rgba(253,224,71,.5) 17deg, rgba(253,224,71,.95) 20deg, rgba(253,224,71,.5) 23deg, rgba(253,224,71,0) 26deg,
      transparent 102deg,
      rgba(234,179,8,0) 102deg, rgba(234,179,8,.5) 105deg, rgba(234,179,8,.9) 108deg, rgba(234,179,8,.5) 111deg, rgba(234,179,8,0) 114deg,
      transparent 192deg,
      rgba(253,224,71,0) 192deg, rgba(253,224,71,.5) 195deg, rgba(253,224,71,.88) 198deg, rgba(253,224,71,.5) 201deg, rgba(253,224,71,0) 204deg,
      transparent 280deg,
      rgba(234,179,8,0) 280deg, rgba(234,179,8,.5) 283deg, rgba(234,179,8,.92) 286deg, rgba(234,179,8,.5) 289deg, rgba(234,179,8,0) 292deg,
      transparent 360deg
    );
    animation:sunbeam-a 12s linear infinite, sunbeam-fade-a 3s ease-in-out infinite alternate;
  }
  .ach-row-icon--rare::after{
    background:conic-gradient(
      from 0deg,
      transparent 0deg,
      rgba(234,179,8,0) 49deg, rgba(234,179,8,.5) 52deg, rgba(253,224,71,.8) 55deg, rgba(234,179,8,.5) 58deg, rgba(234,179,8,0) 61deg,
      transparent 126deg,
      rgba(253,224,71,0) 126deg, rgba(253,224,71,.5) 129deg, rgba(253,224,71,.8) 132deg, rgba(253,224,71,.5) 135deg, rgba(253,224,71,0) 138deg,
      transparent 204deg,
      rgba(234,179,8,0) 204deg, rgba(234,179,8,.5) 207deg, rgba(234,179,8,.82) 210deg, rgba(234,179,8,.5) 213deg, rgba(234,179,8,0) 216deg,
      transparent 289deg,
      rgba(253,224,71,0) 289deg, rgba(253,224,71,.5) 292deg, rgba(253,224,71,.7) 295deg, rgba(253,224,71,.5) 298deg, rgba(253,224,71,0) 301deg,
      transparent 344deg,
      rgba(234,179,8,0) 344deg, rgba(234,179,8,.5) 347deg, rgba(234,179,8,.75) 350deg, rgba(234,179,8,.5) 353deg, rgba(234,179,8,0) 356deg,
      transparent 360deg
    );
    animation:sunbeam-b 8s linear infinite, sunbeam-fade-b 4.5s ease-in-out infinite alternate;
  }
  .ach-row-icon--rare > *{position:relative;z-index:1}
  .ach-row.locked .ach-row-icon--rare::before,
  .ach-row.locked .ach-row-icon--rare::after{opacity:.4}
  .ach-row-pct-rare{color:#ca8a04}
  .ach-row-body{flex:1;min-width:0}
  .ach-row-name{font-size:13.5px;font-weight:600;color:var(--text-primary);line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ach-row.locked .ach-row-name{color:var(--text-secondary)}
  .ach-row-desc{font-size:12px;color:var(--text-tertiary);line-height:1.35;margin-top:2px}
  .ach-row-date{font-size:11px;color:var(--text-tertiary);margin-top:3px}
  .ach-row-meta{display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex-shrink:0;min-width:92px}
  .ach-row-global{display:inline-flex;align-items:center;gap:4px;font-size:11.5px;font-weight:600;color:var(--text-secondary)}
  .ach-row-global svg{opacity:.7}
  .ach-row-tier{font-size:10px;font-weight:700;letter-spacing:.08em;padding:2px 7px;border-radius:4px;text-transform:uppercase}
  .ach-row-tier--platinum{background:rgba(155,123,255,.18);color:#c4b1ff}
  .ach-row-tier--gold{background:rgba(245,181,68,.18);color:#f5c062}
  .ach-row-tier--silver{background:rgba(196,198,205,.2);color:#d5d7dd}
  .ach-row-tier--bronze{background:rgba(205,127,50,.18);color:#e2a06b}
  .ach-row-gs{font-size:11px;font-weight:600;color:var(--text-secondary)}
  .ach-row-earned{display:inline-flex;align-items:center;gap:3px;font-size:11px;font-weight:600;color:var(--score-great,#4ade80)}
  .ach-row-earned svg{flex-shrink:0}
  .ach-row--hidden{cursor:pointer;transition:background .15s}
  .ach-row--hidden:hover,.ach-row--hidden:focus-visible{background:var(--bg-hover)}
  .ach-row--hidden:focus-visible{outline:1px solid var(--accent);outline-offset:-1px}
  .ach-row--hidden .ach-row-icon{filter:blur(2px) grayscale(1);opacity:.55}
  .ach-row--hidden .ach-row-name{font-style:italic}
  .ach-row-reveal{display:inline-flex;align-items:center;gap:3px;font-size:10.5px;font-weight:600;letter-spacing:.03em;text-transform:uppercase;padding:2px 8px;border-radius:999px;background:var(--tag-bg);color:var(--text-secondary);border:1px solid var(--border)}
  .ach-row--hidden:hover .ach-row-reveal{color:var(--accent);border-color:var(--accent)}
  @media(max-width:560px){
    .ach-detail-modal{max-height:94vh}
    .ach-row-icon{width:40px;height:40px}
    .ach-row-meta{min-width:0}
  }
  @keyframes sunbeam-a      { to { transform: rotate(360deg); } }
  @keyframes sunbeam-b      { to { transform: rotate(360deg); } }
  @keyframes sunbeam-fade-a { from { opacity: .2;  } to { opacity: .9;  } }
  @keyframes sunbeam-fade-b { from { opacity: .15; } to { opacity: .75; } }
</style>

<div class="modal-backdrop" id="achDetailModal" onclick="closeAchDetailOnBackdrop(event)">
  <div class="modal ach-detail-modal">
    <div class="ach-detail-head">
      <div class="ach-detail-head-text">
        <div class="ach-detail-title" id="achDetailTitle">Achievements</div>
        <div class="ach-detail-sub" id="achDetailSub"></div>
      </div>
      <button class="modal-close" onclick="closeAchDetail()" aria-label="Close">×</button>
    </div>
    <div class="ach-detail-progress">
      <span class="ach-detail-count" id="achDetailCount">0 / 0</span>
      <div class="ach-detail-bar"><div class="ach-detail-bar-fill" id="achDetailBarFill" style="width:0%"></div></div>
      <span class="ach-detail-pct" id="achDetailPct">0%</span>
    </div>
    <div class="ach-detail-rarity" id="achDetailRarity"></div>
    <div class="ach-detail-search-wrap">
      <input id="achDetailSearch" class="ach-detail-search" type="search" placeholder="Search achievements…" autocomplete="off" oninput="renderAchDetailList()" />
    </div>
    <div class="ach-detail-body" id="achDetailBody">
      <div class="modal-empty">Loading…</div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ achUsername: username }}>
  // One modal per page — if a second instance of the component ever renders,
  // short-circuit the second init so handlers aren't bound twice.
  if (!window.__achDetailInit) {
    window.__achDetailInit = true
    window.__achDetailUsername = achUsername
    var _achDetailData = null
    var _achDetailLoadSeq = 0

    function _achDetailFmtDate(s) {
      if (!s) return ''
      var d = new Date(s)
      if (isNaN(d.getTime())) return ''
      try {
        return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) +
          ', ' + d.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' })
      } catch(e) { return d.toISOString().slice(0, 10) }
    }
    function _achEscape(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
    }
    var _ACH_GLOBE = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 010 18M12 3a14 14 0 000 18"/></svg>'
    var _ACH_CHECK = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>'

    function _achRowHtml(a) {
      var pct = (a.global_percent != null) ? Number(a.global_percent).toFixed(1) + '%' : '—'
      var isRare = a.global_percent != null && a.global_percent < 10
      var isMasked = a.hidden && !a.unlocked
      var icon = a.unlocked
        ? (a.icon_url || '')
        : (a.icon_gray_url || a.icon_url || '')
      var iconEl = icon
        ? '<img src="' + _achEscape(icon) + '" alt="" loading="lazy" />'
        : '<span>🏆</span>'
      var dateLine = a.unlocked && a.unlock_time
        ? '<div class="ach-row-date">' + _achEscape(_achDetailFmtDate(a.unlock_time)) + '</div>'
        : ''
      var metaParts = []
      if (a.trophy_type) {
        metaParts.push('<span class="ach-row-tier ach-row-tier--' + _achEscape(a.trophy_type) + '">' + _achEscape(a.trophy_type) + '</span>')
      }
      if (a.gamerscore != null) {
        metaParts.push('<span class="ach-row-gs">' + _achEscape(a.gamerscore) + ' G</span>')
      }
      metaParts.push('<span class="ach-row-global' + (isRare ? ' ach-row-pct-rare' : '') + '">' + _ACH_GLOBE + _achEscape(pct) + '</span>')
      if (a.unlocked) {
        metaParts.push('<span class="ach-row-earned">' + _ACH_CHECK + 'Earned</span>')
      } else if (isMasked) {
        metaParts.push('<span class="ach-row-reveal">Reveal</span>')
      }
      var displayName = isMasked ? 'Hidden achievement' : (a.name || 'Hidden achievement')
      var displayDesc = isMasked ? '' : (a.description || '')
      var realName = a.name || ''
      var realDesc = a.description || ''
      var dataAttrs = isMasked
        ? ' data-ach-hidden="1" data-ach-name="' + _achEscape(realName) + '" data-ach-desc="' + _achEscape(realDesc) + '" role="button" tabindex="0"'
        : ''
      return '<div class="ach-row ' + (a.unlocked ? 'unlocked' : 'locked') + (isRare ? ' rare' : '') + (isMasked ? ' ach-row--hidden' : '') + '"' + dataAttrs + '>' +
        '<div class="ach-row-icon' + (isRare ? ' ach-row-icon--rare' : '') + '">' + iconEl + '</div>' +
        '<div class="ach-row-body">' +
          '<div class="ach-row-name">' + _achEscape(displayName) + '</div>' +
          (displayDesc ? '<div class="ach-row-desc">' + _achEscape(displayDesc) + '</div>' : '') +
          dateLine +
        '</div>' +
        '<div class="ach-row-meta">' + metaParts.join('') + '</div>' +
      '</div>'
    }

    function _revealHiddenAchRow(row) {
      if (!row || row.dataset.achHidden !== '1') return
      var realName = row.dataset.achName || ''
      var realDesc = row.dataset.achDesc || ''
      var nameEl = row.querySelector('.ach-row-name')
      if (nameEl) nameEl.textContent = realName || 'Hidden achievement'
      if (realDesc) {
        var descEl = row.querySelector('.ach-row-desc')
        if (!descEl) {
          descEl = document.createElement('div')
          descEl.className = 'ach-row-desc'
          var bodyEl = row.querySelector('.ach-row-body')
          var dateEl = bodyEl ? bodyEl.querySelector('.ach-row-date') : null
          if (bodyEl) {
            if (dateEl) bodyEl.insertBefore(descEl, dateEl)
            else bodyEl.appendChild(descEl)
          }
        }
        descEl.textContent = realDesc
      }
      var revealChip = row.querySelector('.ach-row-reveal')
      if (revealChip) revealChip.remove()
      row.classList.remove('ach-row--hidden')
      row.dataset.achHidden = ''
      row.removeAttribute('role')
      row.removeAttribute('tabindex')
    }

    var body = document.getElementById('achDetailBody')
    if (body) {
      body.addEventListener('click', function(e) {
        var row = e.target.closest('.ach-row--hidden')
        if (row) _revealHiddenAchRow(row)
      })
      body.addEventListener('keydown', function(e) {
        if (e.key !== 'Enter' && e.key !== ' ') return
        var row = e.target.closest('.ach-row--hidden')
        if (row) { e.preventDefault(); _revealHiddenAchRow(row) }
      })
    }

    function renderAchDetailList() {
      var body = document.getElementById('achDetailBody')
      if (!body || !_achDetailData) return
      var q = (document.getElementById('achDetailSearch')?.value || '').trim().toLowerCase()
      var items = _achDetailData.achievements || []
      if (q) {
        items = items.filter(function(a) {
          return (a.name && a.name.toLowerCase().indexOf(q) !== -1) ||
                 (a.description && a.description.toLowerCase().indexOf(q) !== -1)
        })
      }
      if (items.length === 0) {
        body.innerHTML = '<div class="modal-empty">No achievements match.</div>'
        return
      }
      body.innerHTML = items.map(_achRowHtml).join('')
    }
    window.renderAchDetailList = renderAchDetailList

    function _renderAchDetailRarity(data) {
      var rarityEl = document.getElementById('achDetailRarity')
      if (!rarityEl) return
      if (data.source !== 'psn') { rarityEl.innerHTML = ''; return }
      var counts = { platinum: 0, gold: 0, silver: 0, bronze: 0 }
      for (var i = 0; i < data.achievements.length; i++) {
        var t = data.achievements[i].trophy_type
        if (t && counts.hasOwnProperty(t)) counts[t]++
      }
      var tiers = ['platinum', 'gold', 'silver', 'bronze']
      var html = ''
      for (var j = 0; j < tiers.length; j++) {
        var tier = tiers[j]
        if (!counts[tier]) continue
        html += '<span class="ach-detail-rarity-chip">' +
          '<span class="ach-detail-rarity-dot ach-detail-rarity-dot--' + tier + '"></span>' +
          counts[tier] + '</span>'
      }
      rarityEl.innerHTML = html
    }

    function openAchDetail(source, sid) {
      var modal = document.getElementById('achDetailModal')
      if (!modal) return
      modal.classList.add('open')
      document.getElementById('achDetailBody').innerHTML = '<div class="modal-empty">Loading…</div>'
      document.getElementById('achDetailTitle').textContent = 'Achievements'
      document.getElementById('achDetailSub').textContent = ''
      document.getElementById('achDetailCount').textContent = ''
      document.getElementById('achDetailPct').textContent = ''
      document.getElementById('achDetailBarFill').style.width = '0%'
      document.getElementById('achDetailRarity').innerHTML = ''
      var searchEl = document.getElementById('achDetailSearch')
      if (searchEl) searchEl.value = ''
      if (window.__lockScroll) window.__lockScroll()
      var seq = ++_achDetailLoadSeq
      var qs = 'username=' + encodeURIComponent(window.__achDetailUsername || '') +
               '&source=' + encodeURIComponent(source) +
               '&id=' + encodeURIComponent(sid)
      fetch('/api/user-achievements/game?' + qs)
        .then(function(r) { return r.json().then(function(j) { return { ok: r.ok, j: j } }) })
        .then(function(res) {
          if (seq !== _achDetailLoadSeq) return
          if (!res.ok) {
            document.getElementById('achDetailBody').innerHTML =
              '<div class="modal-empty">' + _achEscape(res.j && res.j.error || 'Failed to load.') + '</div>'
            return
          }
          _achDetailData = res.j
          document.getElementById('achDetailTitle').textContent = res.j.game_title || 'Achievements'
          document.getElementById('achDetailSub').textContent = res.j.platform_label || ''
          var total = res.j.total || 0
          var unlocked = res.j.unlocked || 0
          var pct = total ? Math.round(unlocked / total * 100) : 0
          document.getElementById('achDetailCount').textContent = unlocked + ' / ' + total
          document.getElementById('achDetailPct').textContent = pct + '%'
          document.getElementById('achDetailBarFill').style.width = pct + '%'
          _renderAchDetailRarity(res.j)
          renderAchDetailList()
        })
        .catch(function() {
          if (seq !== _achDetailLoadSeq) return
          document.getElementById('achDetailBody').innerHTML =
            '<div class="modal-empty">Failed to load achievements.</div>'
        })
    }
    function closeAchDetail() {
      var m = document.getElementById('achDetailModal')
      if (m) m.classList.remove('open')
      if (window.__unlockScroll) window.__unlockScroll()
    }
    function closeAchDetailOnBackdrop(e) {
      if (e.target === document.getElementById('achDetailModal')) closeAchDetail()
    }
    window.openAchDetail = openAchDetail
    window.closeAchDetail = closeAchDetail
    window.closeAchDetailOnBackdrop = closeAchDetailOnBackdrop

    document.addEventListener('keydown', function(e) {
      if (e.key !== 'Escape') return
      var m = document.getElementById('achDetailModal')
      if (m && m.classList.contains('open')) closeAchDetail()
    })
  } else {
    // Re-targeting on tab navigation — this instance may belong to a
    // different owner than the previous one, so point the single global
    // username at whoever's modal is now mounted.
    window.__achDetailUsername = achUsername
  }
</script>
