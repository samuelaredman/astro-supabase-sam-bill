---
// Shared top bar + mobile bottom bar for the "standalone" detail pages that
// don't go through Layout.astro's sidebar nav: games/[slug], genres/[slug],
// platforms/[slug], studios/[slug], reviewers/[username]. Each of those pages
// already defines its own `window.toggleTheme()` (some rebuild a stats tab or
// update --game-accent as a side effect) — the theme button here just calls
// into whichever one the host page defined, it doesn't own theme logic itself.
interface Props {
  isLoggedIn: boolean;
  currentProfile: { id: string; username: string; avatar_url: string | null } | null;
}

const { isLoggedIn, currentProfile } = Astro.props;

function getInitials(username: string): string {
  return username.slice(0, 2).toUpperCase();
}
---

<nav class="dtn-topnav">
  <button
    class="dtn-back"
    aria-label="Go back"
    onclick="history.length > 1 ? history.back() : (window.location.href='/')"
  >
    <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12L6 8L10 4"/></svg>
    <span class="dtn-back-label">Back</span>
  </button>

  <a href="/" class="dtn-logo"><span class="dtn-logo-dot"></span>Chekpoint</a>

  <div class="dtn-links">
    <a href="/discover" class="dtn-link">Discover</a>
    <a href="/rankings" class="dtn-link">Rankings</a>
    <a href="/lists" class="dtn-link">Lists</a>
    <a href="/groups" class="dtn-link">Groups</a>
  </div>

  <div class="dtn-actions">
    <a href="/search" class="dtn-icon-btn dtn-icon-search" aria-label="Search">
      <svg width="17" height="17" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="5"/><path d="M13 13l3 3"/></svg>
    </a>

    {isLoggedIn && (
      <a href="/notifications" class="dtn-icon-btn dtn-icon-notif" aria-label="Notifications" style="position:relative">
        <svg width="17" height="17" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13.5 6a4.5 4.5 0 0 0-9 0c0 5-2 6.5-2 6.5h13s-2-1.5-2-6.5"/><path d="M10.3 15a1.5 1.5 0 0 1-2.6 0"/></svg>
        <span class="dtn-notif-badge" id="dtnNotifBadge" style="display:none"></span>
      </a>
    )}

    <button class="dtn-icon-btn" onclick="toggleTheme()" aria-label="Toggle theme">
      <svg id="themeIcon" width="17" height="17" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="9" r="3.5"/>
        <path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.22 3.22l1.42 1.42M13.36 13.36l1.42 1.42M13.36 4.64l1.42-1.42M3.22 14.78l1.42-1.42"/>
      </svg>
    </button>

    {isLoggedIn && currentProfile ? (
      <div class="dtn-account">
        <button class="dtn-avatar-btn" id="dtnAvatarBtn" aria-haspopup="true" aria-expanded="false" aria-label="Account menu">
          {currentProfile.avatar_url
            ? <img src={currentProfile.avatar_url} alt={currentProfile.username} />
            : <span>{getInitials(currentProfile.username)}</span>
          }
        </button>
        <div class="dtn-dropdown" id="dtnDropdown">
          <a href={`/reviewers/${currentProfile.username}`}>My Profile</a>
          <a href="/following">Following</a>
          <a href="/drafts">Drafts</a>
          <a href="/updates">Updates</a>
          <a href="/settings">Settings</a>
        </div>
      </div>
    ) : (
      <a href="/signin" class="dtn-signin">Sign in</a>
    )}
  </div>
</nav>

<nav class="dtn-mobile-nav" aria-label="Mobile navigation">
  <a href="/" class="dtn-mn-item">
    <span class="dtn-mn-icon"><svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7L9 2L16 7V16H11V11H7V16H2V7Z"/></svg></span>
    <span class="dtn-mn-label">Home</span>
  </a>
  <a href="/discover" class="dtn-mn-item">
    <span class="dtn-mn-icon"><svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="9" r="7"/><polygon points="12,6 7,9 9,13 14,10" fill="currentColor" stroke="none"/><polygon points="6,12 11,9 9,5 4,8" opacity="0.4" fill="currentColor" stroke="none"/></svg></span>
    <span class="dtn-mn-label">Discover</span>
  </a>
  <a href="/search" class="dtn-mn-item">
    <span class="dtn-mn-icon"><svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="5"/><path d="M13 13l3 3"/></svg></span>
    <span class="dtn-mn-label">Search</span>
  </a>
  <a href="/groups" class="dtn-mn-item">
    <span class="dtn-mn-icon"><svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="6.5" cy="6" r="2.5"/><path d="M2 15c0-2.49 2.01-4.5 4.5-4.5S11 12.51 11 15"/><circle cx="12.5" cy="6.5" r="2"/><path d="M12 10.6c1.97.28 3.5 1.97 3.5 4"/></svg></span>
    <span class="dtn-mn-label">Groups</span>
  </a>
  {isLoggedIn ? (
    <a href={currentProfile ? `/reviewers/${currentProfile.username}` : '/signin'} class="dtn-mn-item">
      <span class="dtn-mn-icon dtn-mn-avatar">
        {currentProfile?.avatar_url
          ? <img src={currentProfile.avatar_url} alt={currentProfile.username} />
          : <span>{getInitials(currentProfile?.username ?? '?')}</span>
        }
      </span>
      <span class="dtn-mn-label">Profile</span>
    </a>
  ) : (
    <a href="/signin" class="dtn-mn-item">
      <span class="dtn-mn-icon"><svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="7" r="3.5"/><path d="M3 16c0-3.31 2.69-6 6-6s6 2.69 6 6"/></svg></span>
      <span class="dtn-mn-label">Sign In</span>
    </a>
  )}
</nav>

<script is:inline>
  (function () {
    var btn = document.getElementById('dtnAvatarBtn');
    var menu = document.getElementById('dtnDropdown');
    if (btn && menu) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = menu.classList.toggle('open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      document.addEventListener('click', function (e) {
        if (!menu.classList.contains('open')) return;
        if (menu.contains(e.target) || btn.contains(e.target)) return;
        menu.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          menu.classList.remove('open');
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    var badge = document.getElementById('dtnNotifBadge');
    if (badge) {
      fetch('/api/notifications/count')
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d || !d.unread) return;
          badge.textContent = d.unread > 9 ? '9+' : String(d.unread);
          badge.style.display = 'flex';
        })
        .catch(function () {});
    }
  })();
</script>

<style>
  .dtn-topnav {
    position: sticky; top: 0; z-index: 30;
    display: flex; align-items: center; gap: 20px;
    padding: 13px 28px;
    background: rgba(9,9,10,.82);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(20px);
  }
  [data-theme="light"] .dtn-topnav { background: rgba(245,244,242,.82); }

  .dtn-back {
    display: flex; align-items: center; gap: 6px;
    font-size: 13px; color: var(--text-tertiary);
    background: none; border: none; cursor: pointer;
    font-family: inherit; padding: 0; flex-shrink: 0;
    transition: color .15s;
  }
  .dtn-back:hover { color: var(--text-primary); }

  .dtn-logo {
    font-family: 'Press Start 2P', monospace;
    font-size: 13px; letter-spacing: -.3px; line-height: 1;
    display: flex; align-items: center; gap: 7px; flex-shrink: 0;
    color: var(--text-primary);
  }
  .dtn-logo-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--game-accent, var(--accent));
    box-shadow: 0 0 10px var(--game-accent, var(--accent));
  }

  .dtn-links { display: flex; align-items: center; gap: 4px; margin-left: 8px; }
  .dtn-link {
    font-size: 14px; font-weight: 500; color: var(--text-secondary);
    padding: 7px 12px; border-radius: 8px; transition: background .15s, color .15s;
    white-space: nowrap;
  }
  .dtn-link:hover { color: var(--text-primary); background: var(--bg-hover); }

  .dtn-actions { display: flex; align-items: center; gap: 4px; margin-left: auto; }
  .dtn-icon-btn {
    display: flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: 8px;
    background: none; border: none; cursor: pointer;
    color: var(--text-tertiary); transition: background .15s, color .15s;
  }
  .dtn-icon-btn:hover { color: var(--text-primary); background: var(--bg-hover); }

  .dtn-notif-badge {
    position: absolute; top: 2px; right: 2px;
    min-width: 15px; height: 15px; padding: 0 3px;
    background: var(--accent); color: #fff;
    font-size: 9px; font-weight: 700; line-height: 1;
    border-radius: 20px;
    display: flex; align-items: center; justify-content: center;
    pointer-events: none;
  }

  .dtn-signin {
    font-size: 13px; font-weight: 500; color: var(--accent-text, #fff);
    background: var(--accent); padding: 7px 16px; border-radius: 20px;
    white-space: nowrap; transition: opacity .15s;
  }
  .dtn-signin:hover { opacity: .88; }

  .dtn-account { position: relative; }
  .dtn-avatar-btn {
    width: 30px; height: 30px; border-radius: 50%;
    background: var(--tag-bg); border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-size: 10px; font-weight: 600; color: var(--text-secondary);
    overflow: hidden; cursor: pointer; padding: 0; margin-left: 4px;
    transition: border-color .15s;
  }
  .dtn-avatar-btn:hover { border-color: var(--text-tertiary); }
  .dtn-avatar-btn img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .dtn-dropdown {
    display: none;
    position: absolute; top: calc(100% + 10px); right: 0; z-index: 40;
    min-width: 180px;
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: 12px; box-shadow: var(--shadow-md, 0 8px 24px rgba(0,0,0,.3));
    padding: 6px; flex-direction: column;
  }
  .dtn-dropdown.open { display: flex; }
  .dtn-dropdown a {
    font-size: 13px; color: var(--text-primary); padding: 9px 12px;
    border-radius: 8px; transition: background .15s;
  }
  .dtn-dropdown a:hover { background: var(--bg-hover); }

  @media (max-width: 768px) {
    .dtn-links, .dtn-icon-search, .dtn-icon-notif, .dtn-account, .dtn-signin {
      display: none;
    }
    .dtn-topnav { padding: 12px 16px; gap: 12px; }
  }

  /* Mirrors the site-wide mobile bottom bar (Layout.astro's .mobile-nav) so
     these standalone pages get the same pattern instead of a third variant. */
  .dtn-mobile-nav { display: none; }
  @media (max-width: 768px) {
    .dtn-mobile-nav {
      display: flex; position: fixed; bottom: 0; left: 0; right: 0;
      height: calc(56px + env(safe-area-inset-bottom, 0px));
      padding-bottom: env(safe-area-inset-bottom, 0px);
      background: var(--bg-sidebar, var(--bg-card));
      border-top: 1px solid var(--border);
      z-index: 100; align-items: stretch;
    }
  }
  .dtn-mn-item {
    flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 3px; color: var(--text-tertiary); padding: 6px 2px; min-width: 0;
    -webkit-tap-highlight-color: transparent;
  }
  .dtn-mn-item:active { opacity: .65; }
  .dtn-mn-icon { width: 22px; height: 22px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .dtn-mn-avatar {
    width: 22px; height: 22px; border-radius: 50%;
    background: var(--tag-bg); border: 1.5px solid var(--border);
    overflow: hidden; font-size: 8px; font-weight: 600; color: var(--text-secondary);
  }
  .dtn-mn-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dtn-mn-label { font-size: 10px; font-weight: 500; letter-spacing: .02em; white-space: nowrap; }
</style>
