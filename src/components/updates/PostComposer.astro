---
// Rich-text composer for Updates posts (Tiptap: headings, lists, quotes,
// resizable images, video embeds). Used in two modes:
//   • create — the "new post" composer on /updates
//   • edit   — on /updates/[id], hidden until the author clicks "Edit post";
//              seeded with the post's current title + body
// Render only for site_admins — the API routes enforce it too.
interface Props {
  mode?: 'create' | 'edit';
  postId?: string;
  title?: string;
  body?: string;
}
const { mode = 'create', postId, title = '', body = '' } = Astro.props;
const isEdit = mode === 'edit';

// Posts are Tiptap HTML; legacy posts are plain text. Turn plain text into
// paragraphs so the editor keeps the line breaks.
function escHtml(t: string) {
  return t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
const isHtml = /<(p|h[1-6]|ul|ol|li|img|figure|blockquote|iframe|div)[\s>/]/i.test(body);
const initialHtml = isHtml
  ? body
  : body.split(/\n{2,}/).map((para) => `<p>${escHtml(para).replace(/\n/g, '<br>')}</p>`).join('');
---

<div class="composer" id="post-composer" data-mode={mode} data-post-id={postId} hidden={isEdit}>
  <input type="text" id="post-title" placeholder="Post title" maxlength="200" value={title} />

  <div class="editor-toolbar" id="editor-toolbar">
    <button type="button" data-action="bold" title="Bold"><strong>B</strong></button>
    <button type="button" data-action="italic" title="Italic"><em>I</em></button>
    <button type="button" data-action="h2" title="Heading 2">H2</button>
    <button type="button" data-action="h3" title="Heading 3">H3</button>
    <div class="toolbar-sep"></div>
    <button type="button" data-action="bullet" title="Bullet list">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="5" y1="4" x2="14" y2="4"/><line x1="5" y1="8" x2="14" y2="8"/><line x1="5" y1="12" x2="14" y2="12"/><circle cx="2" cy="4" r="1.2" fill="currentColor" stroke="none"/><circle cx="2" cy="8" r="1.2" fill="currentColor" stroke="none"/><circle cx="2" cy="12" r="1.2" fill="currentColor" stroke="none"/></svg>
    </button>
    <button type="button" data-action="ordered" title="Numbered list">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="6" y1="4" x2="14" y2="4"/><line x1="6" y1="8" x2="14" y2="8"/><line x1="6" y1="12" x2="14" y2="12"/><text x="1" y="5.5" font-size="4.5" fill="currentColor" stroke="none" font-family="sans-serif">1.</text><text x="1" y="9.5" font-size="4.5" fill="currentColor" stroke="none" font-family="sans-serif">2.</text><text x="1" y="13.5" font-size="4.5" fill="currentColor" stroke="none" font-family="sans-serif">3.</text></svg>
    </button>
    <button type="button" data-action="blockquote" title="Blockquote">❝</button>
    <div class="toolbar-sep"></div>
    <button type="button" data-action="image" title="Insert image">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="2" width="14" height="12" rx="2"/><circle cx="5.5" cy="6" r="1.5"/><path d="M1 11l4-4 3 3 2-2 5 5"/></svg>
      Image
    </button>
    <button type="button" data-action="youtube" title="Embed video">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="2" width="14" height="12" rx="2"/><path d="M6 5.5l5 2.5-5 2.5V5.5z" fill="currentColor" stroke="none"/></svg>
      Video
    </button>
    <input type="file" id="image-file-input" accept="image/*" style="display:none" />
  </div>

  <div id="post-editor" class="editor-body"></div>

  {/* Edit mode seeds the editor from this template (HTML can be large —
      base64 images — so it rides in the DOM rather than a data attribute). */}
  {isEdit && <template id="post-edit-body" set:html={initialHtml} />}

  <div class="composer-row">
    {isEdit ? (
      <button type="button" id="post-cancel" class="secondary">Cancel</button>
    ) : (
      <label class="pin-label"><input type="checkbox" id="post-pinned" /> Pin to top</label>
    )}
    <button type="button" id="post-submit">{isEdit ? 'Save changes' : 'Post update'}</button>
  </div>
  <div id="composer-error" class="composer-error"></div>
</div>

<script>
  // Only admins get #post-editor — skip the entire Tiptap bundle for everyone else.
  const editorEl = document.getElementById('post-editor');
  const composerEl = document.getElementById('post-composer');
  const isEdit = composerEl?.dataset.mode === 'edit';
  const editPostId = composerEl?.dataset.postId;
  if (editorEl) {
  const [{ Editor }, { default: StarterKit }, { default: TiptapImage }, { default: Youtube }, { default: Placeholder }] = await Promise.all([
    import('@tiptap/core'),
    import('@tiptap/starter-kit'),
    import('@tiptap/extension-image'),
    import('@tiptap/extension-youtube'),
    import('@tiptap/extension-placeholder'),
  ]);

  // ── Resizable image extension ─────────────────────────────────────────────
  const ResizableImage = TiptapImage.extend({
    addAttributes() {
      return {
        ...this.parent?.(),
        width: {
          default: null,
          renderHTML: (attrs) =>
            attrs.width ? { style: `width:${attrs.width};max-width:100%;height:auto` } : {},
          parseHTML: (el) => {
            const m = (el.getAttribute('style') || '').match(/width:\s*([^;]+)/);
            return m ? m[1].trim() : null;
          },
        },
      };
    },

    addNodeView() {
      return ({ node, getPos, editor: ed }) => {
        const wrap = document.createElement('span');
        wrap.className = 'img-wrap';

        const img = document.createElement('img');
        img.src = node.attrs.src ?? '';
        img.alt = node.attrs.alt ?? '';
        img.style.cssText = 'display:block;max-width:100%;height:auto;border-radius:8px;';
        if (node.attrs.width) img.style.width = node.attrs.width;

        const handle = document.createElement('span');
        handle.className = 'img-resize-handle';
        handle.title = 'Drag to resize';

        handle.addEventListener('mousedown', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const x0 = e.clientX, w0 = img.offsetWidth;
          const onMove = (ev: MouseEvent) => {
            img.style.width = Math.max(60, w0 + ev.clientX - x0) + 'px';
          };
          const onUp = () => {
            document.removeEventListener('mousemove', onMove);
            document.removeEventListener('mouseup', onUp);
            if (typeof getPos === 'function') {
              ed.commands.updateAttributes('image', { width: img.style.width });
            }
          };
          document.addEventListener('mousemove', onMove);
          document.addEventListener('mouseup', onUp);
        });

        wrap.appendChild(img);
        wrap.appendChild(handle);

        return {
          dom: wrap,
          contentDOM: null,
          update(n) {
            if (n.type.name !== 'image') return false;
            img.src = n.attrs.src ?? '';
            img.alt = n.attrs.alt ?? '';
            img.style.width = n.attrs.width ?? '';
            return true;
          },
          destroy() {},
        };
      };
    },
  });

  // ── Compress & insert ─────────────────────────────────────────────────────
  // Resizes to ≤1200px on longest side, converts to JPEG (PNG preserved for
  // transparency). Keeps images in the post body without a storage bucket.
  async function compressAndInsert(file: File) {
    const MAX = 1200;
    let bmp: ImageBitmap;
    try { bmp = await createImageBitmap(file); }
    catch { alert('Could not read that image.'); return; }
    let { width: w, height: h } = bmp;
    if (w > MAX || h > MAX) {
      if (w >= h) { h = Math.round(h * MAX / w); w = MAX; }
      else        { w = Math.round(w * MAX / h); h = MAX; }
    }
    const canvas = document.createElement('canvas');
    canvas.width = w; canvas.height = h;
    canvas.getContext('2d')!.drawImage(bmp, 0, 0, w, h);
    bmp.close();
    const isPng = file.type === 'image/png';
    const src = canvas.toDataURL(isPng ? 'image/png' : 'image/jpeg', 0.85);
    editor.chain().focus().setImage({ src }).run();
  }

  const initialBody = (document.getElementById('post-edit-body') as HTMLTemplateElement | null)?.innerHTML ?? '';
  const editor = new Editor({
    element: editorEl,
    content: isEdit ? initialBody : '',
    extensions: [
      StarterKit,
      ResizableImage.configure({ allowBase64: true, inline: false }),
      Youtube.configure({ controls: true }),
      Placeholder.configure({ placeholder: 'Share an update, idea, or question…' }),
    ],
  });

  // Paste image from clipboard
  editorEl.addEventListener('paste', (e: ClipboardEvent) => {
    const item = Array.from(e.clipboardData?.items ?? []).find(i => i.type.startsWith('image/'));
    if (item) { e.preventDefault(); e.stopPropagation(); const f = item.getAsFile(); if (f) compressAndInsert(f); }
  }, true);

  // Drop image file onto editor
  editorEl.addEventListener('drop', (e: DragEvent) => {
    const f = Array.from(e.dataTransfer?.files ?? []).find(f => f.type.startsWith('image/'));
    if (f) { e.preventDefault(); compressAndInsert(f); }
  });

  // ── Toolbar ───────────────────────────────────────────────────────────────
  document.getElementById('editor-toolbar')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-action]') as HTMLElement | null;
    if (!btn) return;
    switch (btn.dataset.action) {
      case 'bold':       editor.chain().focus().toggleBold().run(); break;
      case 'italic':     editor.chain().focus().toggleItalic().run(); break;
      case 'h2':         editor.chain().focus().toggleHeading({ level: 2 }).run(); break;
      case 'h3':         editor.chain().focus().toggleHeading({ level: 3 }).run(); break;
      case 'bullet':     editor.chain().focus().toggleBulletList().run(); break;
      case 'ordered':    editor.chain().focus().toggleOrderedList().run(); break;
      case 'blockquote': editor.chain().focus().toggleBlockquote().run(); break;
      case 'image':      document.getElementById('image-file-input')?.click(); break;
      case 'youtube': {
        const url = prompt('Paste a YouTube or Vimeo URL:');
        if (url) editor.chain().focus().setYoutubeVideo({ src: url }).run();
        break;
      }
    }
  });

  document.getElementById('image-file-input')?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) { compressAndInsert(file); (e.target as HTMLInputElement).value = ''; }
  });

  // ── Edit mode: open / cancel ──────────────────────────────────────────────
  // The post page marks its rendered title/body with [data-edit-hide]; they're
  // swapped out for the composer while editing.
  const hideWhileEditing = () => document.querySelectorAll<HTMLElement>('[data-edit-hide]');
  document.getElementById('post-edit-open')?.addEventListener('click', () => {
    if (!composerEl) return;
    composerEl.hidden = false;
    hideWhileEditing().forEach((el) => { el.hidden = true; });
    editor.commands.focus('end');
    composerEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  document.getElementById('post-cancel')?.addEventListener('click', () => {
    if (!composerEl) return;
    composerEl.hidden = true;
    hideWhileEditing().forEach((el) => { el.hidden = false; });
    // Drop unsaved changes so reopening starts from the saved post.
    editor.commands.setContent(initialBody);
    const titleEl = document.getElementById('post-title') as HTMLInputElement;
    titleEl.value = titleEl.defaultValue;
    document.getElementById('composer-error')!.textContent = '';
  });

  // ── Submit ────────────────────────────────────────────────────────────────
  document.getElementById('post-submit')?.addEventListener('click', async () => {
    const title  = (document.getElementById('post-title') as HTMLInputElement).value.trim();
    const body   = editor.getHTML();
    const errEl  = document.getElementById('composer-error')!;
    const btn    = document.getElementById('post-submit') as HTMLButtonElement;

    if (!title)         { errEl.textContent = 'Please add a title.'; return; }
    if (editor.isEmpty) { errEl.textContent = 'Please write something.'; return; }

    btn.disabled = true;
    errEl.textContent = '';
    try {
      const res = isEdit
        ? await fetch('/api/forum/posts/update', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ post_id: editPostId, title, body }),
          })
        : await fetch('/api/forum/posts/create', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              title, body,
              pinned: (document.getElementById('post-pinned') as HTMLInputElement).checked,
            }),
          });
      const data = await res.json();
      if (res.ok && isEdit) {
        window.location.reload();
      } else if (res.ok && data.post_id) {
        window.location.href = '/updates/' + data.post_id;
      } else {
        errEl.textContent = data.error || (isEdit ? 'Failed to save.' : 'Failed to post.');
        btn.disabled = false;
      }
    } catch {
      errEl.textContent = 'Network error. Try again.';
      btn.disabled = false;
    }
  });
  } // end if (editorEl)
</script>

<style>
  .composer {
    margin: 12px 20px 20px; padding: 16px; background: var(--bg-card);
    border: 1px solid var(--border); border-radius: 14px; display: flex; flex-direction: column; gap: 10px;
  }
  .composer input[type="text"] {
    width: 100%; background: var(--bg-hover); border: 1px solid var(--border); border-radius: 10px;
    padding: 10px 12px; color: var(--text-primary); font: inherit; font-size: 14px;
  }
  .composer input:focus { outline: none; border-color: var(--accent); }

  /* ── Rich text editor ── */
  .editor-toolbar {
    display: flex; align-items: center; gap: 2px; flex-wrap: wrap;
    background: var(--bg-hover); border: 1px solid var(--border);
    border-radius: 10px 10px 0 0; padding: 6px 8px;
    border-bottom: none;
  }
  .editor-toolbar button {
    display: inline-flex; align-items: center; gap: 4px;
    background: none; border: none; border-radius: 6px;
    color: var(--text-secondary); font: inherit; font-size: 13px;
    padding: 4px 8px; cursor: pointer; transition: background 0.12s, color 0.12s;
  }
  .editor-toolbar button:hover { background: var(--bg-card); color: var(--text-primary); }
  .editor-toolbar button.is-active { background: rgba(96,80,200,.12); color: var(--accent); }
  .toolbar-sep { width: 1px; height: 16px; background: var(--border); margin: 0 4px; flex-shrink: 0; }

  .editor-body {
    background: var(--bg-hover); border: 1px solid var(--border);
    border-radius: 0 0 10px 10px; min-height: 160px; cursor: text;
  }
  .editor-body :global(.ProseMirror) {
    outline: none; padding: 12px 14px; min-height: 160px;
    font-size: 14px; line-height: 1.7; color: var(--text-primary);
  }
  .editor-body :global(.ProseMirror:focus) { border-color: var(--accent); }
  .editor-body :global(.ProseMirror p.is-editor-empty:first-child::before) {
    content: attr(data-placeholder); float: left; color: var(--text-tertiary);
    pointer-events: none; height: 0;
  }
  .editor-body :global(.ProseMirror h2) { font-size: 20px; font-weight: 700; margin: 16px 0 8px; }
  .editor-body :global(.ProseMirror h3) { font-size: 17px; font-weight: 600; margin: 14px 0 6px; }
  .editor-body :global(.ProseMirror p)  { margin: 0 0 10px; }
  .editor-body :global(.ProseMirror ul), .editor-body :global(.ProseMirror ol) { padding-left: 22px; margin: 0 0 10px; }
  .editor-body :global(.ProseMirror li) { margin-bottom: 4px; }
  .editor-body :global(.ProseMirror blockquote) {
    border-left: 3px solid var(--accent); margin: 0 0 10px; padding: 4px 12px;
    color: var(--text-secondary); font-style: italic;
  }
  .editor-body :global(.ProseMirror img) {
    max-width: 100%; border-radius: 8px; display: block; margin: 10px 0;
  }
  .editor-body :global(.img-wrap) {
    display: block; position: relative; line-height: 0; margin: 10px 0;
  }
  .editor-body :global(.img-resize-handle) {
    position: absolute; bottom: 4px; right: 4px;
    width: 14px; height: 14px;
    background: var(--accent); border-radius: 3px;
    cursor: se-resize; opacity: 0; transition: opacity 0.15s;
    box-shadow: 0 0 0 2px #fff;
  }
  .editor-body :global(.img-wrap:hover .img-resize-handle) { opacity: 1; }
  .editor-body :global(.ProseMirror div[data-youtube-video]) { margin: 10px 0; }
  .editor-body :global(.ProseMirror div[data-youtube-video] iframe) {
    width: 100%; aspect-ratio: 16/9; border-radius: 8px; border: none; display: block;
  }
  .composer-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .pin-label { font-size: 13px; color: var(--text-secondary); display: flex; align-items: center; gap: 6px; }
  .composer button {
    background: var(--accent); color: #fff; border: none; border-radius: 10px; padding: 9px 16px;
    font-weight: 600; font-size: 14px; cursor: pointer;
  }
  .composer button:disabled { opacity: 0.6; cursor: default; }
  .composer-error { color: var(--score-low, #e5484d); font-size: 13px; }
  .composer[hidden] { display: none; }
  .composer button.secondary {
    background: var(--bg-hover); color: var(--text-secondary); border: 1px solid var(--border);
  }
  .composer button.secondary:hover { color: var(--text-primary); border-color: var(--accent); }
</style>
