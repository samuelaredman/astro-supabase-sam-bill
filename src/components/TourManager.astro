---
// Global onboarding tour host. Mounted once (in Layout.astro) for logged-in users.
// Exposes window.startTour(name) and auto-starts from a ?tour=<name> URL param.
// Tours are driven by driver.js. Username is passed via a data-attribute because a
// bundled module <script> (needed for `import`) can't use Astro's define:vars.
interface Props { username?: string | null }
const { username = null } = Astro.props;
---

<div id="ck-tour-root" data-username={username ?? ''} hidden></div>

<script>
  import { driver } from 'driver.js';
  import 'driver.js/dist/driver.css';

  const me = document.getElementById('ck-tour-root')?.dataset.username || '';
  const profilePath = me ? `/reviewers/${me}` : '/';

  // Each tour is an array of steps. step = { selector?, reveal?, page, popover }.
  // No selector ⇒ centered "concept" popover. `reveal` is for a target that isn't in
  // the DOM until something happens (e.g. a lazily-loaded profile tab): it runs when
  // the user clicks Next on the previous step, and the tour waits for `selector` to
  // appear before moving on.
  type Step = { selector?: string; reveal?: () => void; page: string; popover: any };
  const TOURS: Record<string, Step[]> = {
    // One guided sequence covering the whole profile setup.
    profile: [
      { selector: '#editProfileBtn', page: profilePath, popover: { title: 'Edit your profile', description: 'This is how you edit all the elements of your profile — click it to make changes, then Save when you’re done.' } },
      { selector: '.avatar-container', page: profilePath, popover: { title: 'Your profile picture', description: 'Add a photo so other reviewers recognize you — hover your avatar and click to upload and crop it.' } },
      { selector: '.profile-banner', page: profilePath, popover: { title: 'Your banner', description: 'Add a wide image up top to make your profile stand out — hover it and click to upload.' } },
      { selector: '.profile-bio-wrap', page: profilePath, popover: { title: 'Your bio', description: 'Add a line or two about the games and genres you love so people know your taste.' } },
      { selector: '.fav-empty, .fav-game-card', page: profilePath, popover: { title: 'Your favorite game', description: 'Set the game that defines your taste — click the card to search and choose it.' } },
      { selector: 'a[href$="?tab=library"]', page: profilePath, popover: { title: 'Your library', description: 'You can track and manage all the games you have played, are currently playing, and want to play — click the Library tab to check it out.' } },
      {
        selector: '.steam-cta-btn, .lib-sync-trigger',
        // Lives in the Library tab, which loads on first open — click the tab, then wait.
        reveal: () => { (document.querySelector('a[href$="?tab=library"]') as HTMLElement | null)?.click(); },
        page: profilePath,
        popover: { title: 'Import from Steam', description: 'Already have a Steam library? Click Connect Steam to automatically bring in your owned games and playtime. Before importing, make sure Profile and Game Details are set to public and "Always keep my total playtime private" is unchecked under Privacy Settings — you can switch them back right after.' },
      },
    ],
    review: [
      { selector: 'a[href="/discover"]', page: '/', popover: { title: 'Need a game to review?', description: 'Stuck on what to review? Discover surfaces games reviewed by people with similar taste — and the more you review, the sharper it gets.' } },
      { selector: '#ck-widget-lists', page: '/', popover: { title: 'Browse lists', description: 'Check out lists other players have made — anything from “my favorite games” to “ranking every Mario title.” A great way to find something to play and review.' } },
      { selector: '#ck-widget-recs', page: '/', popover: { title: 'See recommendations', description: 'Love a specific game? See what others recommend playing next — insights into similar gameplay, story, and mechanics, not just a score.' } },
      { selector: '#postMenuBtn', page: '/', popover: { title: 'Write your first review', description: 'Found one? Click here, choose “Write a review,” and score it 1–10 with your take.' } },
    ],
  };

  // Paths compare case-insensitively without a trailing slash — usernames in URLs
  // can differ in case from the stored one.
  const normPath = (p: string) => decodeURIComponent(p).toLowerCase().replace(/\/+$/, '') || '/';
  const onPage = (s: Step) => normPath(window.location.pathname) === normPath(s.page);

  // First match that's actually rendered. querySelector alone can return an element
  // that's display:none — the desktop sidebar's links on a phone, or a target inside
  // an inactive profile tab — and driver.js then anchors the popover to nothing.
  function visibleMatch(selector: string): Element | null {
    return Array.from(document.querySelectorAll(selector)).find((el) => el.getClientRects().length > 0) ?? null;
  }

  // Resolves with the first visible match once it appears, or null after `ms`.
  function waitForVisible(selector: string, ms = 5000): Promise<Element | null> {
    return new Promise((resolve) => {
      const t0 = Date.now();
      (function poll() {
        const el = visibleMatch(selector);
        if (el || Date.now() - t0 > ms) resolve(el);
        else setTimeout(poll, 100);
      })();
    });
  }

  // The onboarding wizard is a full-screen overlay; a tour driven underneath it
  // would block clicks to the wizard while highlighting elements the wizard
  // covers. The wizard removes itself and then starts the tour on completion,
  // so any tour that would start while it's still mounted is dropped.
  const onboardingOpen = () => !!document.getElementById('ck-onboarding');

  // The tour's steps that can run here. A tour only runs on its own page — the
  // profile tour's targets (avatar, banner, Library tab…) exist on every profile,
  // so without the page check it would tour someone else's profile as "yours".
  // Steps whose target isn't visible are dropped, except `reveal` steps, whose
  // target only appears once revealed.
  function existingSteps(name: string): Step[] {
    return (TOURS[name] || []).filter((s) =>
      onPage(s) && (!s.selector || s.reveal || visibleMatch(s.selector)),
    );
  }

  function drive(tourSteps: Step[], onDone?: () => void) {
    if (onboardingOpen()) return;
    if (!tourSteps.length) { onDone?.(); return; }
    // Chain to the next tour only if this one was finished, not closed early —
    // closing the profile tour shouldn't then navigate to the home page.
    let finished = false;
    const steps = tourSteps.map((s, i) => {
      const next = tourSteps[i + 1];
      const popover = { ...s.popover };
      if (next?.reveal && next.selector) {
        const sel = next.selector;
        popover.onNextClick = (_el: any, _step: any, { driver: d }: any) => {
          next.reveal!();
          waitForVisible(sel).then((el) => {
            if (el) d.moveNext();
            else if (d.hasNextStep()) d.moveTo(i + 2); // never showed up — skip it
            else { finished = true; d.destroy(); }
          });
        };
      }
      return {
        // null (target gone) makes driver.js fall back to a centered popover.
        element: s.selector ? () => visibleMatch(s.selector!) as Element : undefined,
        popover,
      };
    });
    const d = driver({
      showProgress: steps.length > 1,
      allowClose: true,
      smoothScroll: true,
      overlayColor: 'rgba(0,0,0,0.65)',
      nextBtnText: 'Next',
      prevBtnText: 'Back',
      doneBtnText: 'Done',
      steps,
      onDestroyStarted: (_el: any, _step: any, { driver: dd }: any) => {
        if (dd.isLastStep()) finished = true;
        dd.destroy();
      },
      onDestroyed: () => {
        try { localStorage.setItem('ck_tour_done', '1'); } catch (e) {}
        if (finished) onDone?.();
      },
    });
    d.drive();
  }

  // `next`, if given, is started as soon as `name` finishes (or immediately, if
  // `name`'s steps aren't on this page and it has to be skipped) — including
  // across the page navigation `startTour` does when a tour's steps live
  // elsewhere, via the `&next=` URL param handled in the auto-start block below.
  (window as any).startTour = function (name: string, next?: string) {
    const tour = TOURS[name];
    const chain = next ? () => (window as any).startTour(next) : undefined;
    if (!tour) { chain?.(); return; }
    // If any of the tour's target elements are on this page, drive it now;
    // otherwise navigate to the tour's page with ?tour= so it auto-starts there.
    const here = existingSteps(name);
    if (here.length) {
      drive(here, chain);
    } else {
      const qs = new URLSearchParams({ tour: name, ...(next ? { next } : {}) });
      window.location.href = tour[0].page + '?' + qs.toString();
    }
  };

  // Delegated launcher: any [data-start-tour="<name>"] button starts that tour.
  document.addEventListener('click', function (e) {
    const btn = (e.target as HTMLElement)?.closest?.('[data-start-tour]') as HTMLElement | null;
    if (!btn) return;
    e.preventDefault();
    (window as any).startTour(btn.dataset.startTour);
  });

  // Auto-start from ?tour= (strip the param first so refresh/back won't re-trigger).
  // ?next= carries a tour to chain afterward — see startTour above.
  const params = new URLSearchParams(window.location.search);
  const auto = params.get('tour');
  const autoNext = params.get('next');
  if (auto && TOURS[auto]) {
    params.delete('tour');
    params.delete('next');
    const qs = params.toString();
    history.replaceState(null, '', window.location.pathname + (qs ? '?' + qs : '') + window.location.hash);
    const chain = autoNext ? () => (window as any).startTour(autoNext) : undefined;
    setTimeout(() => drive(existingSteps(auto), chain), 400);
  }
</script>

<style is:global>
  /* Theme driver.js popovers to match the dark UI */
  .driver-popover {
    background: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
    /* min() keeps a comfortable 16px margin on both sides on narrow phones
       instead of a bare 320px max-width overflowing anything under ~352px. */
    max-width: min(320px, calc(100vw - 32px));
  }
  .driver-popover-title { color: var(--text-primary); font-weight: 600; font-family: inherit; font-size: 15px; }
  .driver-popover-description { color: var(--text-secondary); font-family: inherit; font-size: 13px; line-height: 1.6; }
  .driver-popover-progress-text { color: var(--text-tertiary); font-size: 11px; }
  .driver-popover-close-btn { color: var(--text-tertiary); width: 28px; height: 28px; }
  .driver-popover-close-btn:hover { color: var(--text-primary); }
  .driver-popover-footer button {
    background: var(--bg-hover);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: 8px;
    text-shadow: none;
    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    padding: 8px 14px;
    /* Meets the ~36-44px touch-target guideline the default 5px vertical
       padding fell short of. */
    min-height: 34px;
  }
  .driver-popover-footer button:hover { background: var(--accent); color: var(--accent-text); border-color: var(--accent); }
  /* Arrow follows the popover background */
  .driver-popover-arrow-side-top.driver-popover-arrow { border-top-color: var(--bg-card); }
  .driver-popover-arrow-side-bottom.driver-popover-arrow { border-bottom-color: var(--bg-card); }
  .driver-popover-arrow-side-left.driver-popover-arrow { border-left-color: var(--bg-card); }
  .driver-popover-arrow-side-right.driver-popover-arrow { border-right-color: var(--bg-card); }
</style>
