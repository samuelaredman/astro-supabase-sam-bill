# Supabase — from your project's API settings
SUPABASE_DATABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# IGDB (Twitch Developer) — https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=your-twitch-client-id
IGDB_CLIENT_SECRET=your-twitch-client-secret

# Site URL — used for auth redirect links (e.g. password reset emails)
# In development: http://localhost:4321
# In production: https://your-site.netlify.app
SITE_URL=https://your-site.netlify.app
