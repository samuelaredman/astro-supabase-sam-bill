# Supabase — from your project's API settings
SUPABASE_DATABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — used server-side only to bypass RLS for game imports.
# Find it in Supabase → Project Settings → API → service_role (secret).
# NEVER expose this to the browser or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# IGDB (Twitch Developer) — https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=your-twitch-client-id
IGDB_CLIENT_SECRET=your-twitch-client-secret

# Content moderation — OpenAI's moderation endpoint (omni-moderation-latest),
# used for review/comment text and avatar/banner image screening.
OPENAI_API_KEY=your-openai-api-key
# profiles.id of the dedicated "moderation bot" service account used as reporter_id
# on auto-filed reports. See CLAUDE.md / setup notes for how to create this account.
MODERATION_BOT_PROFILE_ID=00000000-0000-0000-0000-000000000000

# Site URL — used for auth redirect links (e.g. password reset emails)
# In development: http://localhost:4321
# In production: https://your-site.netlify.app
SITE_URL=https://your-site.netlify.app
